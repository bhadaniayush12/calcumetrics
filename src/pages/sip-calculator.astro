<script>
  import { calcSIP, calcSIPYearly, calcStepUpSIP, calcStepUpSIPYearly } from '../lib/calculators/sip';
  import { setResult } from '../lib/result-bus';
  import { validate } from '../lib/validate';
  import { restoreFromHash, serializeHash, updateHash } from '../lib/url-state';
  import { formatIndian, formatIndianCompact, formatIndianWords, formatCompactCurrency, parseSmartInput } from '../lib/formatters';
  import { getStoredCurrency, CURRENCY_CONFIG, type CurrencyCode } from '../lib/currency';

  const sipSchema = {
    monthly: { required: true, min: 500, max: 2000000, integerOnly: true, label: 'Monthly Investment' },
    rate: { required: true, min: 1, max: 30, decimal: true, label: 'Expected Return Rate' },
    years: { required: true, min: 1, max: 40, integerOnly: true, label: 'Time Period' },
    stepUpPct: { required: false, min: 1, max: 50, decimal: true, label: 'Annual Step-Up Rate' },
    stepUpFixed: { required: false, min: 100, max: 200000, integerOnly: true, label: 'Annual Step-Up Amount' },
  } as const;

  let currentCurrencyCode: CurrencyCode = getStoredCurrency();
  let currentCurrencySymbol = CURRENCY_CONFIG[currentCurrencyCode]?.symbol || '₹';
  let currentNumberLocale = CURRENCY_CONFIG[currentCurrencyCode]?.locale || 'en-IN';

  function fmtNumber(n: number): string {
    return new Intl.NumberFormat(currentNumberLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtCurrency(n: number): string {
    return currentCurrencySymbol + fmtNumber(n);
  }

  function fmtCompact(n: number): string {
    return currentCurrencyCode === 'INR'
      ? formatIndianCompact(n, currentCurrencySymbol)
      : formatCompactCurrency(n, currentCurrencyCode);
  }

  function fmtLiveIndian(raw: string | number): string {
    const num = parseSmartInput(raw, currentNumberLocale === 'de-DE' ? 'EUR' : undefined);
    if (num === null || isNaN(num)) return '';
    return new Intl.NumberFormat(currentNumberLocale, { maximumFractionDigits: 2 }).format(num);
  }

  function initSIPCalc() {
    const monthlyInput = document.getElementById('sip-monthly') as HTMLInputElement | null;
    const monthlySlider = document.getElementById('sip-monthly-slider') as HTMLInputElement | null;
    const rateInput = document.getElementById('sip-rate') as HTMLInputElement | null;
    const rateSlider = document.getElementById('sip-rate-slider') as HTMLInputElement | null;
    const yearsInput = document.getElementById('sip-years') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('sip-years-slider') as HTMLInputElement | null;

    const stepUpToggle = document.getElementById('sip-stepup-toggle') as HTMLInputElement | null;
    const stepUpPanel = document.getElementById('sip-stepup-panel');
    const tabRegular = document.getElementById('sip-mode-tab-regular');
    const tabStepUp = document.getElementById('sip-mode-tab-stepup');
    const stepUpCard = document.getElementById('sip-stepup-card');
    const stepUpToggleTrigger = document.getElementById('sip-stepup-toggle-trigger');
    const stepUpSwitchTrack = document.getElementById('sip-stepup-switch-track');
    const stepUpSwitchThumb = document.getElementById('sip-stepup-switch-thumb');
    const stepUpStatusBadge = document.getElementById('sip-stepup-status-badge');
    const stepUpInlineBadge = document.getElementById('sip-stepup-inline-badge');
    const stepUpInlineVal = document.getElementById('sip-stepup-inline-val');
    const modePctBtn = document.getElementById('sip-stepup-mode-pct');
    const modeFixedBtn = document.getElementById('sip-stepup-mode-fixed');
    const pctGroup = document.getElementById('sip-stepup-pct-group');
    const fixedGroup = document.getElementById('sip-stepup-fixed-group');
    const stepUpPctInput = document.getElementById('sip-stepup-pct') as HTMLInputElement | null;
    const stepUpPctSlider = document.getElementById('sip-stepup-pct-slider') as HTMLInputElement | null;
    const stepUpFixedInput = document.getElementById('sip-stepup-fixed') as HTMLInputElement | null;
    const stepUpFixedSlider = document.getElementById('sip-stepup-fixed-slider') as HTMLInputElement | null;
    const stepUpAdvantageRow = document.getElementById('sip-stepup-advantage-row');
    const stepUpAdvantageCompact = document.getElementById('sip-stepup-advantage-compact');
    const stepUpAdvantagePct = document.getElementById('sip-stepup-advantage-pct');

    function setStepUpState(enabled: boolean, shouldRecalc = true) {
      if (stepUpToggle) stepUpToggle.checked = enabled;
      if (stepUpToggleTrigger) stepUpToggleTrigger.setAttribute('aria-checked', String(enabled));

      if (stepUpSwitchTrack) {
        if (enabled) {
          stepUpSwitchTrack.classList.remove('bg-border');
          stepUpSwitchTrack.classList.add('bg-accent');
        } else {
          stepUpSwitchTrack.classList.remove('bg-accent');
          stepUpSwitchTrack.classList.add('bg-border');
        }
      }

      if (stepUpSwitchThumb) {
        if (enabled) {
          stepUpSwitchThumb.classList.add('translate-x-5');
        } else {
          stepUpSwitchThumb.classList.remove('translate-x-5');
        }
      }

      if (stepUpStatusBadge) {
        stepUpStatusBadge.textContent = enabled ? 'Active' : 'Optional';
        stepUpStatusBadge.className = enabled
          ? 'inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400'
          : 'inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-accent/10 text-accent';
      }

      if (tabRegular) {
        tabRegular.setAttribute('aria-selected', String(!enabled));
        if (!enabled) {
          tabRegular.classList.add('bg-surface', 'text-accent', 'shadow-xs', 'border-accent/25');
          tabRegular.classList.remove('text-text-muted', 'border-transparent');
        } else {
          tabRegular.classList.remove('bg-surface', 'text-accent', 'shadow-xs', 'border-accent/25');
          tabRegular.classList.add('text-text-muted', 'border-transparent');
        }
      }

      if (tabStepUp) {
        tabStepUp.setAttribute('aria-selected', String(enabled));
        if (enabled) {
          tabStepUp.classList.add('bg-surface', 'text-accent', 'shadow-xs', 'border-accent/25');
          tabStepUp.classList.remove('text-text-muted', 'border-transparent');
        } else {
          tabStepUp.classList.remove('bg-surface', 'text-accent', 'shadow-xs', 'border-accent/25');
          tabStepUp.classList.add('text-text-muted', 'border-transparent');
        }
      }

      if (stepUpPanel) {
        stepUpPanel.classList.toggle('hidden', !enabled);
      }

      if (shouldRecalc) {
        recalc();
      }
    }

    const copyBtn = document.getElementById('sip-copy-btn');
    const shareBtn = document.getElementById('sip-share-btn');
    const whatsappBtn = document.getElementById('sip-whatsapp-btn') as HTMLAnchorElement | null;
    const resetBtn = document.getElementById('sip-reset');
    const currencyDropdown = document.getElementById('sip-currency') as HTMLSelectElement | null;
    const errorAlert = document.getElementById('sip-error-alert');

    const resMaturityCompact = document.getElementById('sip-result-maturity-compact');
    const resMaturity = document.getElementById('sip-result-maturity');
    const resInvestedCompact = document.getElementById('sip-result-invested-compact');
    const resInvested = document.getElementById('sip-result-invested');
    const resGainCompact = document.getElementById('sip-result-gain-compact');
    const resGain = document.getElementById('sip-result-gain');
    const resGainPct = document.getElementById('sip-result-gain-pct');
    const sipPlainEl = document.getElementById('sip-plain-translation');

    const insightCompounding = document.getElementById('sip-insight-compounding');
    const insightCuriosity = document.getElementById('sip-insight-curiosity');
    const snippetAnswer = document.getElementById('sip-snippet-answer');
    const yearlyBody = document.getElementById('sip-yearly-body');

    if (!monthlyInput || !rateInput || !yearsInput) return;

    if (monthlyInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    monthlyInput.dataset.bound = 'true';

    let stepUpType: 'percentage' | 'fixed' = 'percentage';

    // Sync stored currency before initial recalc & update input prefixes
    currentCurrencyCode = getStoredCurrency();
    currentCurrencySymbol = CURRENCY_CONFIG[currentCurrencyCode]?.symbol || '₹';
    currentNumberLocale = CURRENCY_CONFIG[currentCurrencyCode]?.locale || 'en-IN';
    if (currencyDropdown && currencyDropdown.value !== currentCurrencyCode) {
      currencyDropdown.value = currentCurrencyCode;
    }
    document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
      el.textContent = currentCurrencySymbol;
    });
    updateMonthlyChips(currentCurrencySymbol, currentCurrencyCode);
    updateStepUpFixedChips(currentCurrencySymbol, currentCurrencyCode);

    function updateMonthlyChips(sym: string, code: CurrencyCode) {
      document.querySelectorAll<HTMLButtonElement>('[data-chip-monthly]').forEach((btn) => {
        if (btn.dataset.marketChipControlled === 'true') return;
        const val = btn.getAttribute('data-chip-monthly');
        if (!val) return;
        const num = parseInt(val, 10);
        if (code === 'INR') {
          if (num === 100000) btn.textContent = `${sym}1L`;
          else btn.textContent = `${sym}${num / 1000}k`;
        } else {
          if (num >= 1000) {
            btn.textContent = `${sym}${num / 1000}k`;
          } else {
            btn.textContent = `${sym}${num}`;
          }
        }
      });
    }

    function updateStepUpFixedChips(sym: string, code: CurrencyCode) {
      document.querySelectorAll<HTMLButtonElement>('[data-chip-stepup-fixed]').forEach((btn) => {
        const val = btn.getAttribute('data-chip-stepup-fixed');
        if (!val) return;
        const num = parseInt(val, 10);
        const formatted = new Intl.NumberFormat(CURRENCY_CONFIG[code]?.locale || 'en-IN').format(num);
        btn.innerHTML = `<span data-currency-prefix>${sym}</span>${formatted}`;
      });
    }

    const DEFAULTS = { monthly: 25000, rate: 12, years: 15, stepUpPct: 10, stepUpFixed: 2500 };
    let debounceTimer: ReturnType<typeof setTimeout>;

    function updateCompositionBar(pFraction: number, gFraction: number, invested: number, gain: number) {
      const wrapper = document.getElementById('sip-composition-wrapper');
      if (!wrapper) return;
      const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
      const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
      if (bar) bar.style.width = `${(pFraction * 100).toFixed(2)}%`;
      if (gainBar) gainBar.style.width = `${(gFraction * 100).toFixed(2)}%`;
      const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
      if (legendEls[0]) legendEls[0].textContent = fmtCurrency(invested);
      if (legendEls[1]) legendEls[1].textContent = fmtCurrency(gain);
    }

    function showValidationFeedback(errorMsg?: string) {
      if (errorAlert) {
        if (errorMsg) {
          errorAlert.textContent = errorMsg;
          errorAlert.classList.remove('hidden');
        } else {
          errorAlert.textContent = '';
          errorAlert.classList.add('hidden');
        }
      }
    }

    function updateYearlyTable(monthly: number, rate: number, years: number, isStepUp: boolean, sType: 'percentage' | 'fixed', sVal: number) {
      if (!yearlyBody) return;
      const schedule = isStepUp
        ? calcStepUpSIPYearly(monthly, rate, years, sType, sVal)
        : calcStepUpSIPYearly(monthly, rate, years, 'percentage', 0);
      yearlyBody.innerHTML = schedule
        .map(
          (row) => `
        <tr class="border-b border-border/50 hover:bg-canvas transition-standard">
          <td class="py-2 px-3 font-medium text-text-primary">Year ${row.year}</td>
          <td class="py-2 px-3 text-right tabular-nums text-text-muted">${fmtCurrency(row.monthlyInvestment)}</td>
          <td class="py-2 px-3 text-right tabular-nums text-text-muted">${fmtCurrency(row.invested)}</td>
          <td class="py-2 px-3 text-right tabular-nums text-text-primary font-semibold">${fmtCurrency(row.maturity)}</td>
          <td class="py-2 px-3 text-right tabular-nums text-accent font-medium">+${fmtCurrency(row.gain)}</td>
        </tr>`
        )
        .join('');
    }

    function recalc() {
      if (!monthlyInput || !rateInput || !yearsInput) return;
      const isEur = currentNumberLocale === 'de-DE';
      const numMonthly = parseSmartInput(monthlyInput.value, isEur ? 'EUR' : undefined);
      const numRate = parseSmartInput(rateInput.value, isEur ? 'EUR' : undefined);
      const numYears = parseSmartInput(yearsInput.value, isEur ? 'EUR' : undefined);

      const vMonthly = validate(numMonthly ?? monthlyInput.value, sipSchema.monthly);
      const vRate = validate(numRate ?? rateInput.value, sipSchema.rate);
      const vYears = validate(numYears ?? yearsInput.value, sipSchema.years);

      if (!vMonthly.valid) {
        showValidationFeedback(vMonthly.error.message);
        monthlyInput.setAttribute('aria-invalid', 'true');
        return;
      }
      monthlyInput.removeAttribute('aria-invalid');

      if (!vRate.valid) {
        showValidationFeedback(vRate.error.message);
        rateInput.setAttribute('aria-invalid', 'true');
        return;
      }
      rateInput.removeAttribute('aria-invalid');

      if (!vYears.valid) {
        showValidationFeedback(vYears.error.message);
        yearsInput.setAttribute('aria-invalid', 'true');
        return;
      }
      yearsInput.removeAttribute('aria-invalid');

      const isStepUp = Boolean(stepUpToggle?.checked);
      let stepUpVal = 0;
      if (isStepUp) {
        if (stepUpType === 'percentage') {
          const numStepPct = parseSmartInput(stepUpPctInput?.value || '10', isEur ? 'EUR' : undefined);
          const vStepPct = validate(numStepPct ?? stepUpPctInput?.value ?? 10, sipSchema.stepUpPct);
          if (!vStepPct.valid) {
            showValidationFeedback(vStepPct.error.message);
            stepUpPctInput?.setAttribute('aria-invalid', 'true');
            return;
          }
          stepUpPctInput?.removeAttribute('aria-invalid');
          stepUpVal = vStepPct.value ?? 10;
        } else {
          const numStepFixed = parseSmartInput(stepUpFixedInput?.value || '2500', isEur ? 'EUR' : undefined);
          const vStepFixed = validate(numStepFixed ?? stepUpFixedInput?.value ?? 2500, sipSchema.stepUpFixed);
          if (!vStepFixed.valid) {
            showValidationFeedback(vStepFixed.error.message);
            stepUpFixedInput?.setAttribute('aria-invalid', 'true');
            return;
          }
          stepUpFixedInput?.removeAttribute('aria-invalid');
          stepUpVal = vStepFixed.value ?? 2500;
        }
      }

      showValidationFeedback();

      const monthly = vMonthly.value!;
      const rate = vRate.value!;
      const years = vYears.value!;

      // Run calculation
      const rFlat = calcSIP(monthly, rate, years);
      const r = isStepUp ? calcStepUpSIP(monthly, rate, years, stepUpType, stepUpVal) : rFlat;

      // Extra 2 years curiosity calculation
      const rExtra = isStepUp
        ? calcStepUpSIP(monthly, rate, years + 2, stepUpType, stepUpVal)
        : calcSIP(monthly, rate, years + 2);
      const extraDiff = rExtra.maturity - r.maturity;

      const compMaturity = fmtCompact(r.maturity);
      const compInvested = fmtCompact(r.invested);
      const compGain = fmtCompact(r.gain);
      const compExtra = fmtCompact(extraDiff);

      // Update Output Panel with smooth count-up animation
      const anim = (window as any).__cmAnimateNumber || ((el: any, t: string) => { if (el) el.textContent = t; });
      if (resMaturityCompact) anim(resMaturityCompact, compMaturity);
      if (resMaturity) anim(resMaturity, `(${fmtCurrency(r.maturity)})`);
      if (resInvestedCompact) anim(resInvestedCompact, compInvested);
      if (resInvested) anim(resInvested, `(${fmtCurrency(r.invested)})`);
      if (resGainCompact) anim(resGainCompact, `+${compGain}`);
      if (resGain) anim(resGain, `(+${fmtCurrency(r.gain)})`);
      if (resGainPct) anim(resGainPct, r.gainPct.toFixed(1) + '%');

      // Update Step-Up Advantage Row & Inline Mobile Badge
      const diffMaturity = r.maturity - rFlat.maturity;
      const diffPct = rFlat.maturity > 0 ? ((r.maturity - rFlat.maturity) / rFlat.maturity) * 100 : 0;
      if (stepUpAdvantageRow) {
        if (isStepUp && diffMaturity > 0) {
          if (stepUpAdvantageCompact) stepUpAdvantageCompact.textContent = `+${fmtCompact(diffMaturity)}`;
          if (stepUpAdvantagePct) stepUpAdvantagePct.textContent = `(+${diffPct.toFixed(1)}%)`;
          stepUpAdvantageRow.classList.remove('hidden');
        } else {
          stepUpAdvantageRow.classList.add('hidden');
        }
      }

      if (stepUpInlineBadge && stepUpInlineVal) {
        if (isStepUp && diffMaturity > 0) {
          stepUpInlineVal.textContent = `+${fmtCompact(diffMaturity)} (+${diffPct.toFixed(1)}%)`;
          stepUpInlineBadge.classList.remove('hidden');
        } else {
          stepUpInlineBadge.classList.add('hidden');
        }
      }

      if (sipPlainEl && r.maturity > 0 && r.invested > 0) {
        const multiple = parseFloat((r.maturity / r.invested).toFixed(2));
        const stepUpLabel = isStepUp ? ' (with annual step-up)' : '';
        sipPlainEl.innerHTML = `You invest <strong class="text-dark-text">${compInvested}</strong>${stepUpLabel} and compounding adds <strong class="text-dark-accent">${compGain}</strong> more — your money grows <strong class="text-dark-text">${multiple}×</strong> its invested value`;
      }

      // Update Composition Bar
      updateCompositionBar(r.principalFraction, r.gainFraction, r.invested, r.gain);

      // Update Insights
      if (insightCompounding) {
        if (isStepUp) {
          const finalYearMonthly = stepUpType === 'percentage'
            ? monthly * Math.pow(1 + stepUpVal / 100, years - 1)
            : monthly + stepUpVal * (years - 1);
          insightCompounding.innerHTML = `Starting at ${fmtCurrency(monthly)}/mo with ${stepUpType === 'percentage' ? `${stepUpVal}%/yr` : `${fmtCurrency(stepUpVal)}/yr`} step-up over ${years} years (ending at ~${fmtCurrency(Math.round(finalYearMonthly))}/mo), you invest <strong>${compInvested}</strong> and earn <strong class="text-dark-accent">${compGain}</strong> through compounding.`;
        } else {
          insightCompounding.innerHTML = `At ${fmtCurrency(monthly)}/mo over ${years} years, you invest <strong>${compInvested}</strong> and earn <strong class="text-dark-accent">${compGain}</strong> purely through compounding.`;
        }
      }
      if (insightCuriosity) {
        insightCuriosity.innerHTML = `Investing for just 2 more years (${years + 2} yrs) adds <strong>+${compExtra}</strong> to your corpus!`;
      }
      const insightDelay = document.getElementById('sip-insight-delay');
      if (insightDelay) {
        if (years > 5) {
          const delayed = isStepUp
            ? calcStepUpSIP(monthly, rate, years - 5, stepUpType, stepUpVal)
            : calcSIP(monthly, rate, years - 5);
          const loss = r.maturity - delayed.maturity;
          insightDelay.innerHTML = `<strong>Cost of Delay:</strong> Delaying by 5 years reduces your corpus by <strong>~${fmtCompact(loss)}</strong> due to lost compounding.`;
          insightDelay.classList.remove('hidden');
        } else {
          insightDelay.classList.add('hidden');
        }
      }

      // Friendly rate reality check
      const rateWarning = document.getElementById('sip-rate-warning');
      if (rateWarning) {
        rateWarning.classList.toggle('hidden', rate <= 15);
      }

      // Update Featured Snippet Answer Box
      if (snippetAnswer) {
        if (isStepUp) {
          const stepUpStr = stepUpType === 'percentage' ? `${stepUpVal}% annual increase` : `${fmtCurrency(stepUpVal)}/year increase`;
          snippetAnswer.innerHTML = `A monthly investment starting at <strong>${fmtCurrency(monthly)}</strong> with an <strong>${stepUpStr}</strong> at an expected <strong>${rate.toFixed(1)}% annual return</strong> over <strong>${years} years</strong> generates an estimated maturity corpus of <strong>${compMaturity}</strong> (${fmtCurrency(r.maturity)}). You invest a total of <strong>${compInvested}</strong> and earn <strong>${compGain}</strong> in compounding wealth gain.`;
        } else {
          snippetAnswer.innerHTML = `A monthly investment of <strong>${fmtCurrency(monthly)}</strong> in an equity SIP at an expected <strong>${rate.toFixed(1)}% annual return</strong> over <strong>${years} years</strong> generates an estimated maturity corpus of <strong>${compMaturity}</strong> (${fmtCurrency(r.maturity)}). You invest a total of <strong>${compInvested}</strong> and earn <strong>${compGain}</strong> in compounding wealth gain.`;
        }
      }

      // Update Year-by-Year schedule
      updateYearlyTable(monthly, rate, years, isStepUp, stepUpType, stepUpVal);

      // Construct hash params
      const hashObj: Record<string, any> = { p: monthly, r: rate, y: years };
      if (isStepUp) {
        hashObj.su = stepUpVal;
        if (stepUpType === 'fixed') hashObj.sut = 'f';
      }
      const currentSerializedHash = serializeHash(hashObj);

      // Update WhatsApp Share Link
      if (whatsappBtn) {
        const stepUpNote = isStepUp
          ? `\nAnnual Step-Up: ${stepUpType === 'percentage' ? `${stepUpVal}%` : fmtCurrency(stepUpVal)}`
          : '';
        const shareMsg = encodeURIComponent(
          `Check out my SIP calculation:\nMonthly: ${fmtCurrency(monthly)}${stepUpNote}\nRate: ${rate}% p.a.\nTenure: ${years} years\nEstimated Corpus: ${compMaturity} (${fmtCurrency(r.maturity)})\nWealth Gain: +${compGain}\nCalculate on Calcumetrics: ${location.href.split('#')[0]}${currentSerializedHash}`
        );
        whatsappBtn.href = `https://api.whatsapp.com/send?text=${shareMsg}`;
      }

      // Canonical Result Bus for mobile sticky bar
      const canonicalResult = {
        heroValue: compMaturity,
        heroLabel: isStepUp ? 'Step-Up Maturity (Top-Up)' : 'Estimated Maturity',
        rows: [
          ...(isStepUp && diffMaturity > 0
            ? [{ label: 'Step-Up Extra Gain', value: `+${fmtCompact(diffMaturity)}`, variant: 'accent' as const }]
            : []),
          { label: 'Total Invested', value: compInvested },
          { label: 'Total Gain', value: compGain, variant: 'accent' as const },
          { label: 'Gain %', value: r.gainPct.toFixed(1) + '%' },
        ],
        fields: {
          'sip-result-maturity': fmtCurrency(r.maturity),
          'sip-result-invested': fmtCurrency(r.invested),
          'sip-result-gain': fmtCurrency(r.gain),
        },
        meta: {
          principalFraction: r.principalFraction,
          gainFraction: r.gainFraction,
          invested: r.invested,
          gain: r.gain,
          maturity: r.maturity,
          isStepUp,
          stepUpType,
          stepUpValue: stepUpVal,
          stepUpExtraGain: diffMaturity,
        },
      };

      setResult(canonicalResult);
      if ((window as any).__cmResultStore) {
        (window as any).__cmResultStore.setResult(canonicalResult);
      }
      window.dispatchEvent(new CustomEvent('cm:result', { detail: canonicalResult }));
    }

    function debounceRecalc() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(recalc, 60);
    }

    // ── Step-Up Mode & Toggle Handlers ──────────────────────────────────────
    tabRegular?.addEventListener('click', () => {
      setStepUpState(false);
    });

    tabStepUp?.addEventListener('click', () => {
      setStepUpState(true);
      stepUpCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    stepUpToggleTrigger?.addEventListener('click', (e) => {
      e.preventDefault();
      setStepUpState(!stepUpToggle?.checked);
    });

    stepUpToggle?.addEventListener('change', () => {
      setStepUpState(Boolean(stepUpToggle?.checked));
    });

    modePctBtn?.addEventListener('click', () => {
      stepUpType = 'percentage';
      modePctBtn.classList.add('bg-surface', 'text-accent', 'shadow-xs');
      modePctBtn.classList.remove('text-text-muted');
      modePctBtn.setAttribute('aria-pressed', 'true');
      modeFixedBtn?.classList.remove('bg-surface', 'text-accent', 'shadow-xs');
      modeFixedBtn?.classList.add('text-text-muted');
      modeFixedBtn?.setAttribute('aria-pressed', 'false');
      pctGroup?.classList.remove('hidden');
      fixedGroup?.classList.add('hidden');
      recalc();
    });

    modeFixedBtn?.addEventListener('click', () => {
      stepUpType = 'fixed';
      modeFixedBtn.classList.add('bg-surface', 'text-accent', 'shadow-xs');
      modeFixedBtn.classList.remove('text-text-muted');
      modeFixedBtn.setAttribute('aria-pressed', 'true');
      modePctBtn?.classList.remove('bg-surface', 'text-accent', 'shadow-xs');
      modePctBtn?.classList.add('text-text-muted');
      modePctBtn?.setAttribute('aria-pressed', 'false');
      fixedGroup?.classList.remove('hidden');
      pctGroup?.classList.add('hidden');
      recalc();
    });

    // ── Sliders & Inputs sync ────────────────────────────────────────────────
    function syncSlider(slider: HTMLInputElement, input: HTMLInputElement, isFormatted: boolean) {
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveIndian(slider.value) : slider.value;
        const min = parseFloat(slider.min), max = parseFloat(slider.max), val = parseFloat(slider.value);
        const pct = ((val - min) / (max - min)) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounceRecalc();
      });

      input.addEventListener('input', () => {
        const isEur = currentNumberLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        debounceRecalc();
      });

      input.addEventListener('blur', () => {
        const isEur = currentNumberLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num)) {
          input.value = isFormatted ? fmtLiveIndian(num) : String(num);
          recalc();
        }
      });
    }

    if (monthlySlider) syncSlider(monthlySlider, monthlyInput, true);
    if (rateSlider) syncSlider(rateSlider, rateInput, false);
    if (yearsSlider) syncSlider(yearsSlider, yearsInput, false);
    if (stepUpPctSlider && stepUpPctInput) syncSlider(stepUpPctSlider, stepUpPctInput, false);
    if (stepUpFixedSlider && stepUpFixedInput) syncSlider(stepUpFixedSlider, stepUpFixedInput, true);

    // Initial slider track percentages
    if (monthlySlider) {
      const min = parseFloat(monthlySlider.min), max = parseFloat(monthlySlider.max), val = parseFloat(monthlySlider.value);
      monthlySlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (rateSlider) {
      const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max), val = parseFloat(rateSlider.value);
      rateSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (yearsSlider) {
      const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max), val = parseFloat(yearsSlider.value);
      yearsSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (stepUpPctSlider) {
      const min = parseFloat(stepUpPctSlider.min), max = parseFloat(stepUpPctSlider.max), val = parseFloat(stepUpPctSlider.value);
      stepUpPctSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (stepUpFixedSlider) {
      const min = parseFloat(stepUpFixedSlider.min), max = parseFloat(stepUpFixedSlider.max), val = parseFloat(stepUpFixedSlider.value);
      stepUpFixedSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }

    // ── Preset Chips ─────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('[data-chip-monthly]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-monthly');
        if (val) {
          monthlyInput.value = fmtLiveIndian(val);
          if (monthlySlider) {
            monthlySlider.value = val;
            const min = parseFloat(monthlySlider.min), max = parseFloat(monthlySlider.max);
            monthlySlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-rate]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-rate');
        if (val) {
          rateInput.value = val;
          if (rateSlider) {
            rateSlider.value = val;
            const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max);
            rateSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-years]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-years');
        if (val) {
          yearsInput.value = val;
          if (yearsSlider) {
            yearsSlider.value = val;
            const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max);
            yearsSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-stepup-pct]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-stepup-pct');
        if (val && stepUpPctInput) {
          stepUpPctInput.value = val;
          if (stepUpPctSlider) {
            stepUpPctSlider.value = val;
            const min = parseFloat(stepUpPctSlider.min), max = parseFloat(stepUpPctSlider.max);
            stepUpPctSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-stepup-fixed]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-stepup-fixed');
        if (val && stepUpFixedInput) {
          stepUpFixedInput.value = fmtLiveIndian(val);
          if (stepUpFixedSlider) {
            stepUpFixedSlider.value = val;
            const min = parseFloat(stepUpFixedSlider.min), max = parseFloat(stepUpFixedSlider.max);
            stepUpFixedSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    // ── Reset button ─────────────────────────────────────────────────────────
    resetBtn?.addEventListener('click', () => {
      monthlyInput.value = fmtLiveIndian(DEFAULTS.monthly);
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);
      if (monthlySlider) {
        monthlySlider.value = String(DEFAULTS.monthly);
        monthlySlider.style.setProperty('--slider-pct', `${((DEFAULTS.monthly - 500) / (200000 - 500) * 100).toFixed(2)}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (30 - 1) * 100).toFixed(2)}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (40 - 1) * 100).toFixed(2)}%`);
      }

      setStepUpState(false, false);
      modePctBtn?.click();
      if (stepUpPctInput) stepUpPctInput.value = String(DEFAULTS.stepUpPct);
      if (stepUpPctSlider) {
        stepUpPctSlider.value = String(DEFAULTS.stepUpPct);
        stepUpPctSlider.style.setProperty('--slider-pct', `${((DEFAULTS.stepUpPct - 1) / (50 - 1) * 100).toFixed(2)}%`);
      }
      if (stepUpFixedInput) stepUpFixedInput.value = fmtLiveIndian(DEFAULTS.stepUpFixed);
      if (stepUpFixedSlider) {
        stepUpFixedSlider.value = String(DEFAULTS.stepUpFixed);
        stepUpFixedSlider.style.setProperty('--slider-pct', `${((DEFAULTS.stepUpFixed - 500) / (50000 - 500) * 100).toFixed(2)}%`);
      }

      showValidationFeedback();
      recalc();
      monthlyInput.focus();
    });

    function applyHashParams() {
      const hash = location.hash.toLowerCase();
      const searchParams = new URLSearchParams(location.search);
      const isStepUpQueryOrHash =
        hash.includes('stepup') ||
        hash.includes('step-up') ||
        searchParams.get('type') === 'step-up' ||
        searchParams.get('type') === 'stepup' ||
        searchParams.get('mode') === 'step-up' ||
        searchParams.get('mode') === 'stepup';

      const restored = restoreFromHash(location.hash, {
        p: sipSchema.monthly,
        r: sipSchema.rate,
        y: sipSchema.years,
        su: { min: 1, max: 200000, required: false },
        sut: { required: false },
        stepup: { min: 1, max: 200000, required: false },
      });

      if (restored.values.p !== undefined) {
        monthlyInput.value = fmtLiveIndian(restored.values.p);
        if (monthlySlider) {
          monthlySlider.value = String(Math.min(restored.values.p, 200000));
          const min = parseFloat(monthlySlider.min), max = parseFloat(monthlySlider.max);
          monthlySlider.style.setProperty('--slider-pct', `${((parseFloat(monthlySlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
        }
      }
      if (restored.values.r !== undefined) {
        rateInput.value = String(restored.values.r);
        if (rateSlider) {
          rateSlider.value = String(Math.min(restored.values.r, 30));
          const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max);
          rateSlider.style.setProperty('--slider-pct', `${((parseFloat(rateSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
        }
      }
      if (restored.values.y !== undefined) {
        yearsInput.value = String(restored.values.y);
        if (yearsSlider) {
          yearsSlider.value = String(Math.min(restored.values.y, 40));
          const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max);
          yearsSlider.style.setProperty('--slider-pct', `${((parseFloat(yearsSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
        }
      }

      const suVal = restored.values.su ?? restored.values.stepup;
      if (suVal !== undefined || isStepUpQueryOrHash) {
        setStepUpState(true, false);
        if (restored.values.sut === 'f' || restored.values.sut === 'fixed') {
          modeFixedBtn?.click();
          if (stepUpFixedInput && suVal !== undefined) stepUpFixedInput.value = fmtLiveIndian(suVal);
          if (stepUpFixedSlider && suVal !== undefined) {
            stepUpFixedSlider.value = String(Math.min(suVal, 50000));
            const min = parseFloat(stepUpFixedSlider.min), max = parseFloat(stepUpFixedSlider.max);
            stepUpFixedSlider.style.setProperty('--slider-pct', `${((parseFloat(stepUpFixedSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
          }
        } else {
          modePctBtn?.click();
          if (stepUpPctInput && suVal !== undefined) stepUpPctInput.value = String(suVal);
          if (stepUpPctSlider && suVal !== undefined) {
            stepUpPctSlider.value = String(Math.min(suVal, 50));
            const min = parseFloat(stepUpPctSlider.min), max = parseFloat(stepUpPctSlider.max);
            stepUpPctSlider.style.setProperty('--slider-pct', `${((parseFloat(stepUpPctSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
          }
        }
      } else {
        setStepUpState(false, false);
      }

      recalc();
    }

    applyHashParams();
    window.addEventListener('hashchange', applyHashParams);

    // ── Copy & Share ─────────────────────────────────────────────────────────
    async function flashBtn(btn: HTMLElement, label: string) {
      const orig = btn.textContent;
      btn.textContent = label;
      btn.setAttribute('aria-label', label);
      await new Promise((r) => setTimeout(r, 2000));
      btn.textContent = orig;
      btn.setAttribute('aria-label', orig ?? '');
    }

    copyBtn?.addEventListener('click', async () => {
      const isEur = currentNumberLocale === 'de-DE';
      const vM = validate(parseSmartInput(monthlyInput.value, isEur ? 'EUR' : undefined) ?? monthlyInput.value, sipSchema.monthly);
      const vR = validate(parseSmartInput(rateInput.value, isEur ? 'EUR' : undefined) ?? rateInput.value, sipSchema.rate);
      const vY = validate(parseSmartInput(yearsInput.value, isEur ? 'EUR' : undefined) ?? yearsInput.value, sipSchema.years);
      if (!vM.valid || !vR.valid || !vY.valid) return;

      const isStepUp = Boolean(stepUpToggle?.checked);
      let stepUpVal = 0;
      if (isStepUp) {
        stepUpVal = stepUpType === 'percentage'
          ? (parseSmartInput(stepUpPctInput?.value || '10', isEur ? 'EUR' : undefined) || 10)
          : (parseSmartInput(stepUpFixedInput?.value || '2500', isEur ? 'EUR' : undefined) || 2500);
      }
      const r = isStepUp ? calcStepUpSIP(vM.value!, vR.value!, vY.value!, stepUpType, stepUpVal) : calcSIP(vM.value!, vR.value!, vY.value!);

      const hashObj: Record<string, any> = { p: vM.value!, r: vR.value!, y: vY.value! };
      if (isStepUp) {
        hashObj.su = stepUpVal;
        if (stepUpType === 'fixed') hashObj.sut = 'f';
      }
      const stepUpText = isStepUp ? ` with ${stepUpType === 'percentage' ? `${stepUpVal}%` : fmtCurrency(stepUpVal)} annual step-up` : '';
      const text = `SIP Calculator: ${fmtCurrency(vM.value!)}/month${stepUpText} at ${vR.value!}% p.a. for ${vY.value!} years gives ${fmtCompact(r.maturity)} (${fmtCurrency(r.maturity)}). ${location.href.split('#')[0]}${serializeHash(hashObj)}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(copyBtn, 'Copied!');
      window.__cmShowToast?.({ title: 'SIP Calculator', message: 'Result summary copied to clipboard ✓' });
    });

    shareBtn?.addEventListener('click', async () => {
      const isEur = currentNumberLocale === 'de-DE';
      const vM = validate(parseSmartInput(monthlyInput.value, isEur ? 'EUR' : undefined) ?? monthlyInput.value, sipSchema.monthly);
      const vR = validate(parseSmartInput(rateInput.value, isEur ? 'EUR' : undefined) ?? rateInput.value, sipSchema.rate);
      const vY = validate(parseSmartInput(yearsInput.value, isEur ? 'EUR' : undefined) ?? yearsInput.value, sipSchema.years);
      const isStepUp = Boolean(stepUpToggle?.checked);
      let stepUpVal = 0;
      if (isStepUp) {
        stepUpVal = stepUpType === 'percentage'
          ? (parseSmartInput(stepUpPctInput?.value || '10', isEur ? 'EUR' : undefined) || 10)
          : (parseSmartInput(stepUpFixedInput?.value || '2500', isEur ? 'EUR' : undefined) || 2500);
      }
      const hashObj: Record<string, any> = { p: vM.value!, r: vR.value!, y: vY.value! };
      if (isStepUp) {
        hashObj.su = stepUpVal;
        if (stepUpType === 'fixed') hashObj.sut = 'f';
      }
      const hash = vM.valid && vR.valid && vY.valid
        ? serializeHash(hashObj)
        : location.hash;
      const url = `${location.href.split('#')[0]}${hash}`;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(shareBtn, 'Copied Link!');
      window.__cmShowToast?.({ title: 'SIP Calculator', message: 'Shareable link copied to clipboard ✓' });
    });

    // ── Currency synchronization ─────────────────────────────────────────────
    function setSIPCurrency(code: CurrencyCode, symbol: string) {
      currentCurrencyCode = code;
      currentCurrencySymbol = symbol;
      currentNumberLocale = CURRENCY_CONFIG[code]?.locale || 'en-IN';

      if (currencyDropdown && currencyDropdown.value !== code) {
        currencyDropdown.value = code;
      }
      document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
        el.textContent = symbol;
      });
      updateMonthlyChips(symbol, code);
      updateStepUpFixedChips(symbol, code);
      recalc();
    }

    currencyDropdown?.addEventListener('change', () => {
      const code = (currencyDropdown.value as CurrencyCode) || 'INR';
      const config = CURRENCY_CONFIG[code];
      const sym = config?.symbol || '₹';
      setSIPCurrency(code, sym);
      window.dispatchEvent(
        new CustomEvent('cm:currency-change', {
          detail: { code, symbol: sym, label: `${sym} ${code}` },
        })
      );
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.code && e.detail?.symbol) {
        setSIPCurrency(e.detail.code, e.detail.symbol);
      }
    });
  }

  initSIPCalc();
  document.addEventListener('astro:page-load', initSIPCalc);
</script>
