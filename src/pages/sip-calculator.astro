---
/**
 * SIP Calculator — /sip-calculator
 * Master SEO & UX Gold Standard Template
 * Live reactive calculations, preset chips, compact Indian numbers, WhatsApp sharing,
 * featured snippet answer, step-by-step worked example, formula breakdown, and 7 real FAQs.
 */

import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Alert from '../components/ui/Alert.astro';
import Tooltip from '../components/ui/Tooltip.astro';
import { calcSIP, calcSIPYearly, calcStepUpSIP, calcStepUpSIPYearly } from '../lib/calculators/sip';
import { formatCurrency, formatIndian, formatIndianCompact, formatIndianWords, formatPercent } from '../lib/formatters';
import { TOOLS } from '../config/site';

// Pre-rendered fixture: ₹25,000/month, 12% p.a., 15 yrs = ₹1,26,14,400
const DEFAULT = { monthly: 25000, rate: 12, years: 15 };
const result = calcSIP(DEFAULT.monthly, DEFAULT.rate, DEFAULT.years);
const yearly = calcSIPYearly(DEFAULT.monthly, DEFAULT.rate, DEFAULT.years);

// Extra 2 years curiosity calculation (17 yrs)
const result17 = calcSIP(DEFAULT.monthly, DEFAULT.rate, 17);
const extraGainDiff = result17.maturity - result.maturity;

const fmt = (n: number) => '₹' + formatIndian(n);
const heroExact = fmt(result.maturity);
const heroCompact = formatIndianCompact(result.maturity, '₹');
const investedExact = fmt(result.invested);
const investedCompact = formatIndianCompact(result.invested, '₹');
const gainExact = fmt(result.gain);
const gainCompact = formatIndianCompact(result.gain, '₹');
const gainPctFmt = formatPercent(result.gainPct, 1);
const initialGainWords = formatIndianWords(result.gain, '₹');
const extraGainWords = formatIndianWords(extraGainDiff, '₹');
const initialMultiple = parseFloat((result.maturity / result.invested).toFixed(2));

// Related calculators (exclude self)
const RELATED_SLUGS = ['lump-sum-calculator', 'xirr-calculator', 'cagr-calculator'];
const related = RELATED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean);

// SEO Canonical & Schema
const canonicalUrl = 'https://calcumetrics.com/sip-calculator';
const pageTitle = 'SIP Calculator: Monthly SIP Returns & Wealth Gain | Calcumetrics';
const pageDesc = 'Free SIP calculator. Use this sip investment plan calculator to compute monthly wealth gain, step up sip calculator options, formula, and returns schedule.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'SIP Calculator',
      url: canonicalUrl,
      description: pageDesc,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-24',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'SIP Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a SIP calculator and how does it work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A SIP calculator computes the estimated maturity corpus and capital gains of a Systematic Investment Plan. It applies compound interest on regular monthly contributions debited at the start of each month using the annuity-due mathematical formula.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is a 12% return realistic for mutual fund SIPs in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Historically, diversified Indian equity mutual funds (large-cap, flexi-cap, and index funds tracking Nifty 50 or Sensex) have delivered 11% to 14% CAGR over rolling 10 to 15-year periods. However, equity returns are subject to market volatility and are not guaranteed.',
          },
        },
        {
          '@type': 'Question',
          name: 'What formula does this SIP calculator use?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'This calculator uses the standard annuity-due formula: FV = P × [((1 + i)^n − 1) / i] × (1 + i), where P is the monthly investment amount, i is the monthly interest rate (annual rate / 12 / 100), and n is total months (years × 12).',
          },
        },
        {
          '@type': 'Question',
          name: 'SIP vs Lumpsum: which is better for wealth creation?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'SIP is ideal for salaried individuals as it enforces investing discipline and leverages Rupee Cost Averaging to buy more units when markets dip. Lumpsum investing can generate higher returns when markets are undervalued or at the beginning of a bull cycle, but carries higher entry timing risk.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if I miss a monthly SIP installment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If your bank account lacks sufficient balance, the fund house does not penalize or cancel your folio, though your bank may levy an auto-debit bounce charge. If three consecutive monthly debits fail, the mutual fund AMC may automatically pause the mandate.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are mutual fund SIP returns tax-free in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Under Budget 2024 tax rules, Long-Term Capital Gains (LTCG) on equity mutual funds held for more than 12 months are taxed at 12.5% on capital gains exceeding ₹1.25 lakh per financial year. Short-Term Capital Gains (STCG) on units held up to 12 months are taxed at 20%.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a Step-Up SIP?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A Step-Up (or Top-Up) SIP automatically increases your monthly installment amount periodically (typically 5% to 10% each year in line with annual salary increments). This accelerates corpus accumulation significantly over long investment horizons.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <CalculatorLayout
    toolName="SIP Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={heroExact}
    heroLabel="Estimated Maturity"
  >
    <!-- ── INPUT CARD ─────────────────────────────────────────────────────────── -->
    <Fragment slot="inputs">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          SIP Calculator
        </h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Live Reactive
        </span>
      </div>
      <p class="text-sm text-text-muted mb-6 leading-relaxed">
        Calculate your Systematic Investment Plan maturity value, invested amount, and wealth gain with monthly compounding.
      </p>

      <!-- Calculator Mode Tabs: Regular SIP vs Step-Up SIP (Mobile-first Segmented Tab Switcher) -->
      <div class="mb-5 p-1 rounded-control bg-canvas border border-border flex items-center gap-1.5" role="tablist" aria-label="SIP calculation mode">
        <button
          type="button"
          id="sip-mode-tab-regular"
          role="tab"
          aria-selected="true"
          class="flex-1 min-h-[44px] py-2 px-3 rounded-control text-xs sm:text-sm font-semibold transition-standard cursor-pointer text-center bg-surface text-accent shadow-xs border border-accent/25 flex items-center justify-center gap-1.5 active:scale-98"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span>Regular SIP</span>
        </button>
        <button
          type="button"
          id="sip-mode-tab-stepup"
          role="tab"
          aria-selected="false"
          class="flex-1 min-h-[44px] py-2 px-3 rounded-control text-xs sm:text-sm font-semibold transition-standard cursor-pointer text-center text-text-muted hover:text-text-primary hover:bg-surface/50 border border-transparent flex items-center justify-center gap-1.5 active:scale-98"
        >
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
          <span>Step-Up SIP</span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-accent/15 text-accent uppercase tracking-wider">Top-Up</span>
        </button>
      </div>

      <!-- Currency selector -->
      <div class="mb-5">
        <Dropdown
          id="sip-currency"
          label="Display Currency & Grouping"
          options={[
            { value: 'INR', label: '₹ Indian Rupee (INR) — Lakhs & Crores' },
            { value: 'USD', label: '$ US Dollar (USD)' },
            { value: 'EUR', label: '€ Euro (EUR)' },
            { value: 'GBP', label: '£ British Pound (GBP)' },
          ]}
          value="INR"
          helperText="Adjusts currency symbol and compact number notation"
        />
      </div>

      <!-- Monthly Investment Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-monthly"
          label="Monthly Investment"
          prefix="₹"
          value="25,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Amount invested at the start of each month"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-monthly-slider" min={500} max={200000} step={500} value={25000} ariaLabel="Monthly Investment slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Monthly investment presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 5000, label: '₹5k' },
            { val: 10000, label: '₹10k' },
            { val: 25000, label: '₹25k' },
            { val: 50000, label: '₹50k' },
            { val: 100000, label: '₹1L' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-monthly={chip.val}
              data-market-chip-controlled="true"
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Expected Return Rate Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-rate"
          label="Expected Annual Return"
          suffix="%"
          value="12.0"
          isNumeric={true}
          helperText="Compounded monthly (nominal rate i = r/12)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-rate-slider" min={1} max={30} step={0.5} value={12} ariaLabel="Expected return rate slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Return rate presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 10, label: '10%' },
            { val: 12, label: '12% (Equity avg)' },
            { val: 15, label: '15% (Aggressive)' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-rate={chip.val}
              data-market-chip-controlled="true"
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Time Period Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-years"
          label="Time Period"
          suffix="Yrs"
          value="15"
          isNumeric={true}
          helperText="Investment duration in years"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-years-slider" min={1} max={40} step={1} value={15} ariaLabel="Time period slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Tenure presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 5, label: '5 Yrs' },
            { val: 10, label: '10 Yrs' },
            { val: 15, label: '15 Yrs' },
            { val: 20, label: '20 Yrs' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-years={chip.val}
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Annual Step-Up (Top-Up) Feature Toggle & Inputs -->
      <div id="sip-stepup-card" class="mb-6 p-4 rounded-card border border-border bg-surface/50 transition-standard">
        <button
          type="button"
          id="sip-stepup-toggle-trigger"
          class="w-full flex items-center justify-between gap-3 text-left cursor-pointer group focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 rounded-control p-1 -m-1"
          role="switch"
          aria-checked="false"
          aria-label="Toggle Annual Step-Up SIP"
        >
          <div class="flex-1">
            <div class="flex items-center gap-1.5">
              <span class="text-xs sm:text-sm font-semibold text-text-primary group-hover:text-accent transition-standard">Annual Step-Up (Top-Up)</span>
              <span id="sip-stepup-status-badge" class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-accent/10 text-accent">Optional</span>
            </div>
            <span class="text-[11px] text-text-muted block mt-0.5">Increase monthly contribution each year in line with salary hikes</span>
          </div>
          <!-- Switch visual container with min 44px touch area -->
          <div class="relative inline-flex items-center justify-center w-12 h-11 shrink-0">
            <input type="checkbox" id="sip-stepup-toggle" class="sr-only" tabindex="-1" />
            <div id="sip-stepup-switch-track" class="w-11 h-6 bg-border rounded-full transition-colors duration-200 relative">
              <div id="sip-stepup-switch-thumb" class="w-5 h-5 bg-white rounded-full shadow-sm absolute top-0.5 left-0.5 transition-transform duration-200 pointer-events-none"></div>
            </div>
          </div>
        </button>

        <!-- Inline Live Comparison Badge (Instant mobile feedback) -->
        <div id="sip-stepup-inline-badge" class="hidden mt-3 p-2.5 rounded-control bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-between text-xs">
          <div class="flex items-center gap-1.5 text-emerald-800 dark:text-emerald-300 font-medium">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <span>Step-Up Extra Corpus:</span>
          </div>
          <span id="sip-stepup-inline-val" class="font-bold text-emerald-800 dark:text-emerald-300 tabular-nums">+₹0 (+0%)</span>
        </div>

        <div id="sip-stepup-panel" class="hidden mt-4 pt-4 border-t border-border/60 space-y-4">
          <!-- Step-Up Type Selector: Percentage vs Fixed -->
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="text-xs font-medium text-text-muted">Increment Type:</span>
            <div class="inline-flex rounded-control border border-border bg-canvas p-0.5" role="group" aria-label="Step-Up increment mode">
              <button
                type="button"
                id="sip-stepup-mode-pct"
                class="min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-control transition-standard cursor-pointer bg-surface text-accent shadow-xs active:scale-95"
                aria-pressed="true"
              >
                Percentage (%)
              </button>
              <button
                type="button"
                id="sip-stepup-mode-fixed"
                class="min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-control transition-standard cursor-pointer text-text-muted hover:text-text-primary active:scale-95"
                aria-pressed="false"
              >
                Fixed Amount (<span data-currency-prefix>₹</span>)
              </button>
            </div>
          </div>

          <!-- Step-Up Percentage Input & Slider -->
          <div id="sip-stepup-pct-group">
            <Input
              id="sip-stepup-pct"
              label="Annual Increase Rate"
              suffix="%"
              value="10"
              isNumeric={true}
              helperText="Typical increment: 5% to 15% with annual salary appraisal"
              inputmode="decimal"
            />
            <div class="mt-2">
              <Slider id="sip-stepup-pct-slider" min={1} max={50} step={1} value={10} ariaLabel="Annual step-up percentage slider" />
            </div>
            <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Step-up percentage presets">
              <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
              {[
                { val: 5, label: '5%' },
                { val: 10, label: '10% (Common)' },
                { val: 15, label: '15%' },
                { val: 20, label: '20%' },
              ].map((chip) => (
                <button
                  type="button"
                  data-chip-stepup-pct={chip.val}
                  class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
                >
                  {chip.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Step-Up Fixed Amount Input & Slider -->
          <div id="sip-stepup-fixed-group" class="hidden">
            <Input
              id="sip-stepup-fixed"
              label="Annual Increase Amount"
              prefix="₹"
              value="2,500"
              isNumeric={true}
              localeFormat="indian"
              helperText="Fixed amount added to your monthly installment every 12 months"
              inputmode="decimal"
            />
            <div class="mt-2">
              <Slider id="sip-stepup-fixed-slider" min={500} max={50000} step={500} value={2500} ariaLabel="Annual step-up fixed amount slider" />
            </div>
            <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Step-up fixed amount presets">
              <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
              {[
                { val: 1000, label: '1,000' },
                { val: 2500, label: '2,500' },
                { val: 5000, label: '5,000' },
                { val: 10000, label: '10,000' },
              ].map((chip) => (
                <button
                  type="button"
                  data-chip-stepup-fixed={chip.val}
                  class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
                >
                  <span data-currency-prefix>₹</span>{chip.label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Friendly rate reality-check alert -->
      <div id="sip-rate-warning" class="hidden text-xs text-amber-800 dark:text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded-control p-2.5 mb-4 flex items-start gap-2" role="alert">
        <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span><strong>Reality check:</strong> Expected returns above 12%–15% p.a. are historically aggressive. Broad-market equity mutual funds typically deliver ~11%–13% long-term CAGR. For prudent financial planning, consider using 10%–12%.</span>
      </div>

      <!-- Validation alert -->
      <div id="sip-error-alert" class="hidden text-xs text-error font-medium bg-error-bg border border-error-border rounded-control p-2.5 mb-4" role="alert"></div>

      <!-- Reset button -->
      <div class="flex justify-end pt-2">
        <button
          type="button"
          id="sip-reset"
          class="min-h-[44px] text-xs text-text-muted hover:text-accent font-semibold px-3 rounded hover:bg-surface transition-standard cursor-pointer inline-flex items-center"
        >
          Reset to defaults
        </button>
      </div>
    </Fragment>

    <!-- ── OUTPUT PANEL ────────────────────────────────────────────────────────── -->
    <Fragment slot="outputs">
      <!-- Hero result (Large Compact + Full Tabular) -->
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-dark-muted block mb-1">
          Estimated Total Corpus
        </span>
        <div class="flex items-baseline gap-2 flex-wrap">
          <div
            id="sip-result-maturity-compact"
            class="text-3xl sm:text-4xl font-extrabold tabular-nums text-dark-text tracking-tight"
            aria-live="polite"
            aria-atomic="true"
          >
            {heroCompact}
          </div>
          <span id="sip-result-maturity" class="text-xs sm:text-sm text-dark-muted font-mono tabular-nums">
            ({heroExact})
          </span>
        </div>
        <p id="sip-plain-translation" class="text-[11px] text-dark-muted mt-1 leading-relaxed">
          You invest <strong class="text-dark-text">{investedCompact}</strong> and compounding adds <strong class="text-dark-accent">{gainCompact}</strong> more — your money grows <strong class="text-dark-text">{initialMultiple}×</strong> its invested value
        </p>
      </div>

      <!-- Secondary metrics -->
      <div class="space-y-0 border-t border-dark-border pt-4 mb-4">
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Invested</span>
          <div class="text-right">
            <span id="sip-result-invested-compact" class="text-sm font-semibold tabular-nums text-dark-text mr-1.5">{investedCompact}</span>
            <span id="sip-result-invested" class="text-xs text-dark-muted tabular-nums font-mono">({investedExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Wealth Gain</span>
          <div class="text-right">
            <span id="sip-result-gain-compact" class="text-sm font-bold tabular-nums text-dark-accent mr-1.5">+{gainCompact}</span>
