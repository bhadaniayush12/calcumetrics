                {yearly.map((row) => (
                  <tr class="border-b border-border/50 hover:bg-canvas transition-standard">
                    <td class="py-2 px-3 font-medium text-text-primary">Year {row.year}</td>
                    <td class="py-2 px-3 text-right tabular-nums text-text-muted">{fmt(row.invested)}</td>
