---
/**
 * SIP Calculator — /sip-calculator
 * Master SEO & UX Gold Standard Template
 * Live reactive calculations, preset chips, compact Indian numbers, WhatsApp sharing,
 * featured snippet answer, step-by-step worked example, formula breakdown, and 7 real FAQs.
 */

import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Alert from '../components/ui/Alert.astro';
import Tooltip from '../components/ui/Tooltip.astro';
import { calcSIP, calcSIPYearly } from '../lib/calculators/sip';
import { formatCurrency, formatIndian, formatIndianCompact, formatIndianWords, formatPercent } from '../lib/formatters';
import { TOOLS } from '../config/site';

// Pre-rendered fixture: ₹25,000/month, 12% p.a., 15 yrs = ₹1,26,14,400
const DEFAULT = { monthly: 25000, rate: 12, years: 15 };
const result = calcSIP(DEFAULT.monthly, DEFAULT.rate, DEFAULT.years);
const yearly = calcSIPYearly(DEFAULT.monthly, DEFAULT.rate, DEFAULT.years);

// Extra 2 years curiosity calculation (17 yrs)
const result17 = calcSIP(DEFAULT.monthly, DEFAULT.rate, 17);
const extraGainDiff = result17.maturity - result.maturity;

const fmt = (n: number) => '₹' + formatIndian(n);
const heroExact = fmt(result.maturity);
const heroCompact = formatIndianCompact(result.maturity, '₹');
const investedExact = fmt(result.invested);
const investedCompact = formatIndianCompact(result.invested, '₹');
const gainExact = fmt(result.gain);
const gainCompact = formatIndianCompact(result.gain, '₹');
const gainPctFmt = formatPercent(result.gainPct, 1);
const initialGainWords = formatIndianWords(result.gain, '₹');
const extraGainWords = formatIndianWords(extraGainDiff, '₹');

// Related calculators (exclude self)
const related = TOOLS.filter(
  (t) => (t.category === 'Investments' || t.category === 'Loans') && t.slug !== 'sip-calculator' && t.status === 'published'
).slice(0, 4);

// SEO Canonical & Schema
const canonicalUrl = 'https://calcumetrics.com/sip-calculator';
const pageTitle = 'SIP Calculator: Monthly SIP Returns & Maturity Value (2026)';
const pageDesc = 'Free SIP calculator. Calculate monthly investment, expected return & wealth gain instantly with live charts, formula, worked example & year-by-year schedule.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'SIP Calculator',
      url: canonicalUrl,
      description: pageDesc,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-24',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'SIP Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a SIP calculator and how does it work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A SIP calculator computes the estimated maturity corpus and capital gains of a Systematic Investment Plan. It applies compound interest on regular monthly contributions debited at the start of each month using the annuity-due mathematical formula.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is a 12% return realistic for mutual fund SIPs in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Historically, diversified Indian equity mutual funds (large-cap, flexi-cap, and index funds tracking Nifty 50 or Sensex) have delivered 11% to 14% CAGR over rolling 10 to 15-year periods. However, equity returns are subject to market volatility and are not guaranteed.',
          },
        },
        {
          '@type': 'Question',
          name: 'What formula does this SIP calculator use?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'This calculator uses the standard annuity-due formula: FV = P × [((1 + i)^n − 1) / i] × (1 + i), where P is the monthly investment amount, i is the monthly interest rate (annual rate / 12 / 100), and n is total months (years × 12).',
          },
        },
        {
          '@type': 'Question',
          name: 'SIP vs Lumpsum: which is better for wealth creation?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'SIP is ideal for salaried individuals as it enforces investing discipline and leverages Rupee Cost Averaging to buy more units when markets dip. Lumpsum investing can generate higher returns when markets are undervalued or at the beginning of a bull cycle, but carries higher entry timing risk.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if I miss a monthly SIP installment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If your bank account lacks sufficient balance, the fund house does not penalize or cancel your folio, though your bank may levy an auto-debit bounce charge. If three consecutive monthly debits fail, the mutual fund AMC may automatically pause the mandate.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are mutual fund SIP returns tax-free in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Under Budget 2024 tax rules, Long-Term Capital Gains (LTCG) on equity mutual funds held for more than 12 months are taxed at 12.5% on capital gains exceeding ₹1.25 lakh per financial year. Short-Term Capital Gains (STCG) on units held up to 12 months are taxed at 20%.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a Step-Up SIP?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A Step-Up (or Top-Up) SIP automatically increases your monthly installment amount periodically (typically 5% to 10% each year in line with annual salary increments). This accelerates corpus accumulation significantly over long investment horizons.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <CalculatorLayout
    toolName="SIP Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={heroExact}
    heroLabel="Estimated Maturity"
  >
    <!-- ── INPUT CARD ─────────────────────────────────────────────────────────── -->
    <Fragment slot="inputs">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          SIP Calculator
        </h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Live Reactive
        </span>
      </div>
      <p class="text-sm text-text-muted mb-6 leading-relaxed">
        Calculate your Systematic Investment Plan maturity value, invested amount, and wealth gain with monthly compounding.
      </p>

      <!-- Currency selector -->
      <div class="mb-5">
        <Dropdown
          id="sip-currency"
          label="Display Currency & Grouping"
          options={[
            { value: 'INR', label: '₹ Indian Rupee (INR) — Lakhs & Crores' },
            { value: 'USD', label: '$ US Dollar (USD)' },
            { value: 'EUR', label: '€ Euro (EUR)' },
            { value: 'GBP', label: '£ British Pound (GBP)' },
          ]}
          value="INR"
          helperText="Adjusts currency symbol and compact number notation"
        />
      </div>

      <!-- Monthly Investment Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-monthly"
          label="Monthly Investment"
          prefix="₹"
          value="25,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Amount invested at the start of each month"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-monthly-slider" min={500} max={200000} step={500} value={25000} ariaLabel="Monthly Investment slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Monthly investment presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 5000, label: '₹5k' },
            { val: 10000, label: '₹10k' },
            { val: 25000, label: '₹25k' },
            { val: 50000, label: '₹50k' },
            { val: 100000, label: '₹1L' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-monthly={chip.val}
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Expected Return Rate Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-rate"
          label="Expected Annual Return"
          suffix="%"
          value="12.0"
          isNumeric={true}
          helperText="Compounded monthly (nominal rate i = r/12)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-rate-slider" min={1} max={30} step={0.5} value={12} ariaLabel="Expected return rate slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Return rate presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 10, label: '10%' },
            { val: 12, label: '12% (Equity avg)' },
            { val: 15, label: '15% (Aggressive)' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-rate={chip.val}
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Time Period Input + Presets -->
      <div class="mb-6">
        <Input
          id="sip-years"
          label="Time Period"
          suffix="Yrs"
          value="15"
          isNumeric={true}
          helperText="Investment duration in years"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="sip-years-slider" min={1} max={40} step={1} value={15} ariaLabel="Time period slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Tenure presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 5, label: '5 Yrs' },
            { val: 10, label: '10 Yrs' },
            { val: 15, label: '15 Yrs' },
            { val: 20, label: '20 Yrs' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-years={chip.val}
              class="min-h-[44px] px-3.5 py-2 rounded-control text-xs font-semibold border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer inline-flex items-center justify-center select-none active:scale-95"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Friendly rate reality-check alert -->
      <div id="sip-rate-warning" class="hidden text-xs text-amber-800 dark:text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded-control p-2.5 mb-4" role="alert">
        💡 <strong>Reality check:</strong> 12% se zyada expected return historically aggressive lagta hai. Diversified equity mutual funds long term mein ~11–13% CAGR dete hain. Realistic planning ke liye 12% consider karo.
      </div>

      <!-- Validation alert -->
      <div id="sip-error-alert" class="hidden text-xs text-error font-medium bg-error-bg border border-error-border rounded-control p-2.5 mb-4" role="alert"></div>

      <!-- Reset button -->
      <div class="flex justify-end pt-2">
        <button
          type="button"
          id="sip-reset"
          class="min-h-[44px] text-xs text-text-muted hover:text-accent font-semibold px-3 rounded hover:bg-surface transition-standard cursor-pointer inline-flex items-center"
        >
          Reset to defaults
        </button>
      </div>
    </Fragment>

    <!-- ── OUTPUT PANEL ────────────────────────────────────────────────────────── -->
    <Fragment slot="outputs">
      <!-- Hero result (Large Compact + Full Tabular) -->
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-dark-muted block mb-1">
          Estimated Total Corpus
        </span>
        <div class="flex items-baseline gap-2 flex-wrap">
          <div
            id="sip-result-maturity-compact"
            class="text-3xl sm:text-4xl font-extrabold tabular-nums text-dark-text tracking-tight"
            aria-live="polite"
            aria-atomic="true"
          >
            {heroCompact}
          </div>
          <span id="sip-result-maturity" class="text-xs sm:text-sm text-dark-muted font-mono tabular-nums">
            ({heroExact})
          </span>
        </div>
      </div>

      <!-- Secondary metrics -->
      <div class="space-y-0 border-t border-dark-border pt-4 mb-4">
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Invested</span>
          <div class="text-right">
            <span id="sip-result-invested-compact" class="text-sm font-semibold tabular-nums text-dark-text mr-1.5">{investedCompact}</span>
            <span id="sip-result-invested" class="text-xs text-dark-muted tabular-nums font-mono">({investedExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Wealth Gain</span>
          <div class="text-right">
            <span id="sip-result-gain-compact" class="text-sm font-bold tabular-nums text-dark-accent mr-1.5">+{gainCompact}</span>
            <span id="sip-result-gain" class="text-xs text-dark-accent/80 tabular-nums font-mono">(+{gainExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-xs text-dark-muted flex items-center gap-1">
            Wealth Gain %
            <Tooltip text="Cumulative gain as a percentage of total principal invested." />
          </span>
          <span id="sip-result-gain-pct" class="text-sm font-bold tabular-nums text-dark-accent">{gainPctFmt}</span>
        </div>
      </div>

      <!-- Composition bar -->
      <div class="mb-4" id="sip-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.gainFraction}
          principalLabel="Invested"
          gainLabel="Gain"
          principalValue={investedExact}
          gainValue={gainExact}
        />
      </div>

      <!-- Curiosity Gap & Emotional Insight Box -->
      <div class="p-3 rounded-control bg-dark-border/40 border border-dark-border text-xs text-dark-text mb-4 space-y-1.5">
        <p id="sip-insight-compounding" class="leading-relaxed">
          At ₹25,000/mo over 15 years, you invest <strong>{investedCompact}</strong> and earn <strong class="text-dark-accent">{gainCompact}</strong> purely through compounding.
        </p>
        <p id="sip-insight-curiosity" class="text-[11px] text-dark-accent leading-relaxed">
          Investing for just 2 more years (17 yrs) adds <strong>+{extraGainWords}</strong> to your corpus!
        </p>
        <p id="sip-insight-delay" class="text-[11px] text-amber-400/90 leading-relaxed pt-1 border-t border-dark-border/40">
          ⏳ <strong>Cost of Delay:</strong> 5 saal late shuru kiya toh corpus lagbhag ₹54 Lakh kam banega.
        </p>
      </div>

      <!-- Share Actions: WhatsApp + Copy Link + Copy Result -->
      <div class="space-y-2">
        <a
          id="sip-whatsapp-btn"
          href="https://api.whatsapp.com/send?text=Check%20out%20my%20SIP%20calculation:%20%E2%82%B925,000/month%20at%2012%25%20for%2015%20years%20yields%20%E2%82%B91.26%20Cr%20on%20Calcumetrics:%20https://calcumetrics.com/sip-calculator"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full min-h-[44px] h-11 text-xs font-semibold rounded-control bg-[#25D366] text-white hover:opacity-90 transition-standard focus-visible:outline-2 focus-visible:outline-white cursor-pointer select-none"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.782 2.791.782 3.183 0 5.769-2.587 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.362c-.896 0-1.637-.247-2.366-.679l-.17-.1-1.758.461.469-1.714-.111-.177c-.476-.757-.727-1.466-.726-2.392.001-2.483 2.022-4.503 4.506-4.503 2.481 0 4.502 2.021 4.503 4.503-.001 2.483-2.023 4.503-4.507 4.503zm2.593-3.374c-.142-.071-.84-.415-.97-.462-.13-.047-.225-.071-.32.071-.095.142-.367.462-.45.557-.083.095-.166.107-.308.036s-.601-.222-1.145-.707c-.424-.378-.71-.845-.793-.987-.083-.142-.009-.219.062-.29.064-.064.142-.166.213-.249.071-.083.095-.142.142-.237.047-.095.024-.178-.012-.249s-.32-.771-.439-1.055c-.116-.277-.234-.239-.32-.243-.083-.004-.178-.005-.273-.005s-.249.036-.379.178c-.13.142-.498.486-.498 1.185s.51 1.375.581 1.47c.071.095 1.004 1.533 2.433 2.15.34.147.606.235.813.301.341.109.652.093.898.056.274-.041.84-.344.959-.676.119-.332.119-.617.083-.676-.035-.06-.13-.095-.272-.166z"/>
          </svg>
          Share on WhatsApp
        </a>
        <div class="flex gap-2">
          <button
            type="button"
            id="sip-copy-btn"
            class="flex-1 min-h-[44px] h-11 text-xs font-semibold rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Copy Result
          </button>
          <button
            type="button"
            id="sip-share-btn"
            class="flex-1 min-h-[44px] h-11 text-xs font-semibold rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Share Link
          </button>
        </div>
      </div>

      <!-- Legal note -->
      <p class="text-[11px] text-dark-muted mt-3 leading-relaxed">
        Estimates only. Not financial advice. Mutual fund investments are subject to market risks.
      </p>
    </Fragment>

    <!-- ── BELOW THE FOLD (COMPREHENSIVE SEO RANKING SECTIONS) ───────────────────── -->
    <Fragment slot="below">

      <!-- 1. Featured Snippet Direct Answer Box -->
      <div class="p-5 bg-surface border-l-4 border-accent rounded-r-card mb-8 shadow-sm">
        <p class="text-xs font-bold text-accent uppercase tracking-wider mb-1">Quick Answer / Summary</p>
        <p class="text-sm text-text-primary leading-relaxed" id="sip-snippet-answer">
          A monthly investment of <strong>₹25,000</strong> in an equity SIP at an expected <strong>12% annual return</strong> over <strong>15 years</strong> generates an estimated maturity corpus of <strong>₹1.26 Crore</strong> (₹1,26,14,400). You invest a total of <strong>₹45.00 Lakh</strong> and earn <strong>₹81.14 Lakh</strong> in compounding wealth gain.
        </p>
      </div>

      <!-- 2. How it works & Formula -->
      <section aria-labelledby="sip-how" class="mb-10">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
          <h2 id="sip-how" class="text-xl sm:text-2xl font-bold text-text-primary">How this SIP calculator works</h2>
          <a
            href="/methodology#sip"
            class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1"
          >
            How is this calculated? Full Methodology &amp; Proof →
          </a>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          A Systematic Investment Plan (SIP) enables disciplined rupee-cost averaging by investing a fixed sum on a scheduled day every month into mutual fund units. Each installment earns compound interest over its remaining tenure. Because units are bought each month across market highs and lows, your average acquisition cost stabilizes over long horizons.
        </p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Calcumetrics computes SIP maturity using the standard <strong>annuity-due formula</strong> with monthly compounding. Annuity-due assumes installments are credited at the beginning of each month (matching the banking auto-debit schedule of Indian mutual fund AMCs):
        </p>

        <!-- Formula block with variable legend -->
        <div class="bg-surface border border-border rounded-card p-5 mb-5 overflow-x-auto">
          <div class="text-base sm:text-lg font-mono text-accent font-bold mb-3 tracking-wide">
            FV = P × [((1 + i)ⁿ − 1) / i] × (1 + i)
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-text-muted border-t border-border pt-3">
            <div><strong class="text-text-primary">FV</strong> = Future Value (estimated maturity corpus)</div>
            <div><strong class="text-text-primary">P</strong> = Monthly investment installment</div>
            <div><strong class="text-text-primary">i</strong> = Monthly interest rate = Annual Rate / 12 / 100</div>
            <div><strong class="text-text-primary">n</strong> = Total installments = Tenure in Years × 12</div>
          </div>
        </div>
      </section>

      <!-- 3. Worked numerical example -->
      <section aria-labelledby="sip-example" class="mb-10">
        <h2 id="sip-example" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">Worked mathematical example</h2>
        <p class="text-sm text-text-muted mb-4">
          Here is how the formula calculates a ₹25,000 monthly SIP at 12% p.a. over 15 years step-by-step:
        </p>
        <div class="space-y-3 bg-surface border border-border rounded-card p-5 text-xs text-text-muted">
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 1:</span>
            <span>Monthly rate: <code>i = 12 / (12 × 100) = 0.01</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 2:</span>
            <span>Total monthly installments: <code>n = 15 × 12 = 180 months</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 3:</span>
            <span>Compound factor: <code>(1 + 0.01)¹⁸⁰ − 1 = 5.995802 − 1 = 4.995802</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 4:</span>
            <span>Annuity-due multiplication: <code>25,000 × (4.995802 / 0.01) × 1.01 = ₹1,26,14,400</code></span>
          </div>
          <div class="pt-2 border-t border-border flex justify-between font-medium text-text-primary text-sm">
            <span>Total Invested: ₹45,00,000</span>
            <span class="text-accent font-bold">Wealth Gain: ₹81,14,400</span>
          </div>
        </div>
      </section>

      <!-- 4. How to use step by step -->
      <section aria-labelledby="sip-steps" class="mb-10">
        <h2 id="sip-steps" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">How to use this SIP calculator</h2>
