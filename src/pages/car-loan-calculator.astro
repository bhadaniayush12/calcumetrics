---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcEMI } from '../lib/calculators/emi';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { price: 1200000, down: 200000, rate: 9.0, years: 5 };
const initialLoan = DEFAULT.price - DEFAULT.down;
const initialResult = calcEMI(initialLoan, DEFAULT.rate, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Loans' && t.slug !== 'car-loan-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/car-loan-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Car Loan EMI Calculator',
      url: canonicalUrl,
      description: 'Calculate your auto loan monthly EMI, down payment, total interest, and total car acquisition cost.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Car Loan Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a recommended tenure for a car loan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Financial advisors generally recommend keeping auto loan tenures between 3 to 5 years (36 to 60 months). Because vehicles depreciate rapidly, extended tenures (such as 7 or 8 years) increase the risk of becoming upside down on your loan, where you owe more than the car is worth.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are car loan interest rates fixed or floating?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Unlike home loans which are predominantly floating, most vehicle loans are issued on fixed interest rates. A fixed rate locks your monthly EMI throughout the tenure, protecting against benchmark rate hikes.',
          },
        },
        {
          '@type': 'Question',
          name: 'How much down payment should I make when buying a car?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A standard financial recommendation is to put down at least 15% to 20% of the vehicle on-road price. A larger down payment reduces total interest burden, decreases monthly EMI, and protects against depreciation losses.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between ex-showroom price and on-road price?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Ex-showroom price is the dealer base cost. On-road price includes mandatory state registration and road tax (RTO), motor insurance, municipal taxes, and dealer handling charges. Lenders often finance 85% to 100% of the ex-showroom price.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I foreclose or prepay my car loan early?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, most banks permit loan foreclosure or partial prepayments after an initial lock-in period (typically 6 months). For fixed-rate car loans, check if your lender levies a foreclosure penalty (often 2% to 5% on the remaining balance).',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Car Loan EMI Calculator: Auto Loan Instalment & Cost | Calcumetrics"
  description="Calculate your auto loan monthly EMI, down payment, total interest, and total car acquisition cost. Instant, free, 100% client-side."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Car Loan EMI Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={fmt(initialResult.emiRounded)}
    heroLabel="Monthly EMI"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Car Loan EMI Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Estimate your vehicle loan EMI, down payment impact, and total interest.</p>

      <!-- Error alert -->
      <div id="cl-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="cl-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Vehicle Price -->
      <div class="mb-5">
        <Input
          id="cl-price"
          label="On-Road Vehicle Price"
          prefix="₹"
          value="12,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total purchase price including registration and insurance"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-price-slider" min={200000} max={10000000} step={25000} value={1200000} ariaLabel="Vehicle price slider" />
        </div>
      </div>

      <!-- Down Payment -->
      <div class="mb-5">
        <Input
          id="cl-down"
          label="Down Payment"
          prefix="₹"
          value="2,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Upfront payment from savings or vehicle exchange"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-down-slider" min={0} max={5000000} step={25000} value={200000} ariaLabel="Down payment slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="cl-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="9.0"
          isNumeric={true}
          helperText="Prevailing commercial vehicle finance rate"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-rate-slider" min={6} max={20} step={0.1} value={9.0} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-6">
        <Input
          id="cl-years"
          label="Loan Tenure (Years)"
          suffix="Years"
          value="5"
          isNumeric={true}
          helperText="Typical duration is 3 to 7 years"
          inputmode="numeric"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-years-slider" min={1} max={8} step={1} value={5} ariaLabel="Tenure slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="cl-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="cl-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div id="cl-result-emi" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(initialResult.emiRounded)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Loan Principal</span>
          <span id="cl-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialLoan)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Down Payment</span>
          <span id="cl-result-down" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.down)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest</span>
          <span id="cl-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(initialResult.totalInterest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Payment</span>
          <span id="cl-result-total" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.totalPayment)}</span>
        </div>
      </div>

      <div class="mb-5" id="cl-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.principalFraction}
          gainFraction={initialResult.interestFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(initialLoan)}
          gainValue={fmt(initialResult.totalInterest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cl-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cl-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="car-loan-calculator-how">
        <h2 id="car-loan-calculator-how" class="text-xl font-bold text-text-primary mb-4">How car loan EMI is computed</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Car loan EMIs follow the reducing balance method:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">EMI = [P × r × (1 + r)^n] / [(1 + r)^n − 1]</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">P</strong> — Net loan amount = On-road price − Down payment</li>
            <li><strong class="text-text-primary">r</strong> — Monthly interest rate = Annual rate / 12 / 100</li>
            <li><strong class="text-text-primary">n</strong> — Months of tenure = Years × 12</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="car-loan-calculator-faq">
        <h2 id="car-loan-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="car-loan-calculator-related">
        <h2 id="car-loan-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcEMI } from '../lib/calculators/emi';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initCLCalc() {
    if ((window as any).__cmClBound) return;
    (window as any).__cmClBound = true;

    const priceInput = document.getElementById('cl-price') as HTMLInputElement | null;
    const downInput = document.getElementById('cl-down') as HTMLInputElement | null;
    const rateInput = document.getElementById('cl-rate') as HTMLInputElement | null;
    const yearsInput = document.getElementById('cl-years') as HTMLInputElement | null;
    const priceSlider = document.getElementById('cl-price-slider') as HTMLInputElement | null;
    const downSlider = document.getElementById('cl-down-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('cl-rate-slider') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('cl-years-slider') as HTMLInputElement | null;

    const resEMI = document.getElementById('cl-result-emi');
    const resPrincipal = document.getElementById('cl-result-principal');
    const resDown = document.getElementById('cl-result-down');
    const resInterest = document.getElementById('cl-result-interest');
    const resTotal = document.getElementById('cl-result-total');

    const errAlert = document.getElementById('cl-error-alert');
    const errMsg = document.getElementById('cl-error-msg');

    if (!priceInput || !downInput || !rateInput || !yearsInput) return;

    const DEFAULTS = { price: 1200000, down: 200000, rate: 9.0, years: 5 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawPrice = priceInput!.value.replace(/[^0-9.]/g, '');
      const rawDown = downInput!.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput!.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput!.value.replace(/[^0-9.]/g, '');

      const vPrice = validate(rawPrice, { required: true, min: 50000, label: 'Vehicle Price' });
      const vDown = validate(rawDown, { required: true, min: 0, label: 'Down Payment' });
      const vRate = validate(rawRate, { required: true, min: 0.1, max: 30, decimal: true, label: 'Interest Rate' });
      const vYears = validate(rawYears, { required: true, min: 1, max: 15, integer: true, label: 'Tenure' });

      if (!vPrice.valid) { showError(vPrice.error!.message); return; }
      if (!vDown.valid) { showError(vDown.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      if (!vYears.valid) { showError(vYears.error!.message); return; }

      const price = vPrice.value!;
      const downAmt = vDown.value!;
      const rate = vRate.value!;
      const years = vYears.value!;

      if (downAmt >= price) {
        showError('Down payment cannot exceed or equal vehicle price.');
        return;
      }
      clearError();

      const loan = price - downAmt;
      const res = calcEMI(loan, rate, years);

      setResult({
        heroValue: fmtVal(res.emiRounded),
        heroLabel: 'Monthly EMI',
        rows: [
          { label: 'Loan Principal', value: fmtVal(loan) },
          { label: 'Down Payment', value: fmtVal(downAmt) },
          { label: 'Total Interest', value: fmtVal(res.totalInterest) },
          { label: 'Total Payment', value: fmtVal(res.totalPayment) },
        ],
      });

      if (resEMI) resEMI.textContent = fmtVal(res.emiRounded);
      if (resPrincipal) resPrincipal.textContent = fmtVal(loan);
      if (resDown) resDown.textContent = fmtVal(downAmt);
      if (resInterest) resInterest.textContent = fmtVal(res.totalInterest);
      if (resTotal) resTotal.textContent = fmtVal(res.totalPayment);

      const wrapper = document.getElementById('cl-composition-wrapper');
      if (wrapper && res.totalPayment > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${Math.min(100, res.principalFraction * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(loan);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalInterest);
      }

      serializeHash({ p: price, d: downAmt, r: rate, y: years });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider || !input) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(priceSlider, priceInput, true);
    sync(downSlider, downInput, true);
    sync(rateSlider, rateInput, false);
    sync(yearsSlider, yearsInput, false);

    document.getElementById('cl-calculate')?.addEventListener('click', recalc);
    document.getElementById('cl-reset')?.addEventListener('click', () => {
      priceInput.value = fmtLiveInput(String(DEFAULTS.price));
      downInput.value = fmtLiveInput(String(DEFAULTS.down));
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);
      if (priceSlider) {
        priceSlider.value = String(DEFAULTS.price);
        priceSlider.style.setProperty('--slider-pct', `${((DEFAULTS.price - 200000) / (10000000 - 200000)) * 100}%`);
      }
      if (downSlider) {
        downSlider.value = String(DEFAULTS.down);
        downSlider.style.setProperty('--slider-pct', `${((DEFAULTS.down - 0) / (5000000 - 0)) * 100}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 6) / (20 - 6)) * 100}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (8 - 1)) * 100}%`);
      }
      clearError();
      recalc();
      priceInput.focus();
    });

    [priceInput, downInput, rateInput, yearsInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('cl-copy-btn')?.addEventListener('click', async () => {
      const rawPrice = priceInput.value.replace(/[^0-9.]/g, '');
      const rawDown = downInput.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput.value.replace(/[^0-9.]/g, '');

      const vPrice = validate(rawPrice, { required: true, min: 50000, label: 'Vehicle Price' });
      const vDown = validate(rawDown, { required: true, min: 0, label: 'Down Payment' });
      const vRate = validate(rawRate, { required: true, min: 0.1, label: 'Rate' });
      const vYears = validate(rawYears, { required: true, min: 1, label: 'Tenure' });

      if (!vPrice.valid || !vDown.valid || !vRate.valid || !vYears.valid) return;
      if (vDown.value! >= vPrice.value!) return;

      const loan = vPrice.value! - vDown.value!;
      const res = calcEMI(loan, vRate.value!, vYears.value!);
      const text = `Car Loan EMI: ${fmtVal(res.emiRounded)}/month on car price of ${fmtVal(vPrice.value!)} (${fmtVal(vDown.value!)} down, ${vRate.value}% for ${vYears.value} yrs). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('cl-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cl-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('cl-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      p: { required: true, min: 50000, label: 'p' },
      d: { required: true, min: 0, label: 'd' },
      r: { required: true, min: 0.1, max: 30, decimal: true, label: 'r' },
      y: { required: true, min: 1, max: 15, integer: true, label: 'y' },
    });
    if (restored.valid && restored.values.p && restored.values.d !== undefined && restored.values.r !== undefined && restored.values.y) {
      priceInput.value = fmtLiveInput(String(restored.values.p));
      downInput.value = fmtLiveInput(String(restored.values.d));
      rateInput.value = String(restored.values.r);
      yearsInput.value = String(restored.values.y);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initCLCalc();
  document.addEventListener('astro:page-load', initCLCalc);
</script>
