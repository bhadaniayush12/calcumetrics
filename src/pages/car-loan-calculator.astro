---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcEMI } from '../lib/calculators/emi';
import { calcImpliedRate } from '../lib/finance/amortization';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { price: 1200000, down: 200000, rate: 9.0, years: 5 };
const initialLoan = DEFAULT.price - DEFAULT.down;
const initialResult = calcEMI(initialLoan, DEFAULT.rate, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(n);
// Flat-rate quote converted to the equivalent reducing-balance rate (default loan and term).
const FLAT_PCT = 5.5;
const flatEmi = (initialLoan * (1 + (FLAT_PCT / 100) * DEFAULT.years)) / (DEFAULT.years * 12);
const flatReducing = calcImpliedRate(initialLoan, flatEmi, DEFAULT.years).annualRatePct;

const downPaymentExamples = [200000, 300000, 400000].map((down) => ({
  down, ...calcEMI(DEFAULT.price - down, DEFAULT.rate, DEFAULT.years),
}));

const RELATED_SLUGS = ['emi-calculator', 'loan-affordability-calculator', 'loan-amortization-calculator'];
const related = RELATED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://calcumetrics.com/car-loan-calculator';
const faqs = [
  { question: "How is car loan EMI calculated?", answer: "Subtract your down payment from the amount being financed, then enter the annual reducing-balance rate and tenure. The calculator estimates equal monthly payments covering principal and interest. Separately paid fees are not included." },
  { question: "How does a down payment affect my car loan?", answer: "For the same car price, rate and term, a larger down payment reduces the amount borrowed, the EMI and total interest. The comparison table shows the effect of changing the down payment while holding the other inputs constant." },
  { question: "Is a longer car loan tenure better?", answer: "A longer term lowers the monthly payment for the same loan and positive rate, but increases total interest. Compare both figures with the cash you can afford each month; a lower EMI alone does not mean a cheaper loan." },
  { question: "Can I use this calculator for a used car?", answer: "Yes, if the offer has equal monthly payments and a reducing-balance interest rate. Enter the used-car price, actual down payment and the lender’s quoted rate and term. Balloon payments and irregular repayment plans are not modelled." },
  { question: "Does the car loan EMI include insurance and other fees?", answer: "Only amounts included in the entered vehicle price and financed balance affect the estimate. It does not add processing fees, registration costs, insurance or future running costs automatically. Use an itemised quote to avoid omitting or counting a cost twice." }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Car Loan Calculator',
      url: canonicalUrl,
      description: 'Estimate car loan EMI and total interest after a down payment, with a worked example and down-payment comparison.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-10-19',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Car Loan Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<Layout
  title="Car Loan Calculator: EMI, Interest & Down Payment"
  description="Estimate car loan EMI and total interest after your down payment. Compare upfront payments, see a worked example and understand the cost of financing."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Car Loan Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={fmt(initialResult.emiRounded)}
    heroLabel="Monthly EMI"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Car Loan Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Estimate your vehicle loan EMI, down payment impact, and total interest.</p>

      <!-- Error alert -->
      <div id="cl-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="cl-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Vehicle Price -->
      <div class="mb-5">
        <Input
          id="cl-price"
          label="On-Road Vehicle Price"
          prefix="₹"
          value="12,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total purchase price including registration and insurance"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-price-slider" min={200000} max={10000000} step={25000} value={1200000} ariaLabel="Vehicle price slider" />
        </div>
      </div>

      <!-- Down Payment -->
      <div class="mb-5">
        <Input
          id="cl-down"
          label="Down Payment"
          prefix="₹"
          value="2,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Upfront payment from savings or vehicle exchange"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-down-slider" min={0} max={5000000} step={25000} value={200000} ariaLabel="Down payment slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="cl-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="9.0"
          isNumeric={true}
          helperText="Prevailing commercial vehicle finance rate"
          inputmode="decimal"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-rate-slider" min={6} max={20} step={0.1} value={9.0} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-6">
        <Input
          id="cl-years"
          label="Loan Tenure (Years)"
          suffix="Years"
          value="5"
          isNumeric={true}
          helperText="Typical duration is 3 to 7 years"
          inputmode="numeric"
          aria-describedby="cl-error-msg"
        />
        <div class="mt-2">
          <Slider id="cl-years-slider" min={1} max={8} step={1} value={5} ariaLabel="Tenure slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="cl-calculate" type="button">Calculate Car Loan EMI</Button>
        <Button variant="ghost" id="cl-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div id="cl-result-emi" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(initialResult.emiRounded)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Loan Principal</span>
          <span id="cl-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialLoan)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Down Payment</span>
          <span id="cl-result-down" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.down)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest</span>
          <span id="cl-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(initialResult.totalInterest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Payment</span>
          <span id="cl-result-total" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.totalPayment)}</span>
        </div>
      </div>

      <div class="mb-5" id="cl-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.principalFraction}
          gainFraction={initialResult.interestFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(initialLoan)}
          gainValue={fmt(initialResult.totalInterest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cl-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cl-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <p class="text-sm text-text-muted leading-relaxed mb-4">A car loan calculator estimates your monthly EMI from the vehicle price, down payment, annual interest rate and repayment term. The loan amount is the price minus the down payment, and each EMI repays principal plus interest. Compare total interest alongside the monthly payment before choosing a term.</p><section aria-labelledby="car-loan-calculator-how">
        <h2 id="car-loan-calculator-how" class="text-xl font-bold text-text-primary mb-4">Car loan EMI formula</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">This calculator uses monthly reducing-balance interest:</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">EMI = P × r × (1 + r)<sup>n</sup> / ((1 + r)<sup>n</sup> − 1)</p>
          <ul class="space-y-1 text-sm text-text-muted"><li>P = Vehicle price − Down payment</li>
            <li>r = Annual interest rate / 1200</li>
            <li>n = Years × 12 monthly payments</li>
            <li>Total interest = Unrounded EMI × n − P</li></ul>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Enter the lender’s reducing-balance interest rate. APR can include charges as well as interest, so it is useful for comparing the full cost but may not reproduce the contractual EMI when entered as the interest rate. <a href="https://www.rbi.org.in/Scripts/NotificationUser.aspx?Id=12663&Mode=0" class="text-accent font-medium hover:underline">RBI’s Key Facts Statement circular</a> explains that distinction.</p>
      </section>

      <section aria-labelledby="car-loan-worked-example">
        <h2 id="car-loan-worked-example" class="text-xl font-bold text-text-primary mb-4">Worked example: price, down payment and EMI</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Suppose the vehicle costs {fmt(DEFAULT.price)} and you pay {fmt(DEFAULT.down)} upfront. That leaves {fmt(initialLoan)} to borrow at an illustrative {DEFAULT.rate}% a year for {DEFAULT.years} years. The rate is an assumption, not a bank offer.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The monthly rate is {DEFAULT.rate} / 1200 = {(DEFAULT.rate / 1200).toFixed(4)} and the term is {DEFAULT.years * 12} months. Apply the formula to get the monthly payment, then total the repayments and subtract the principal to find interest.</p>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Illustrative costs, rounded to whole rupees</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Item</th><th scope="col" class="text-left py-2.5 px-3">Amount</th></tr></thead>
          <tbody>{[
          ['Vehicle price', DEFAULT.price], ['Down payment', DEFAULT.down],
          ['Amount borrowed', initialLoan], ['Monthly EMI', initialResult.emiRounded],
          ['Total interest', initialResult.totalInterest], ['Total loan repayment', initialResult.totalPayment],
          ['Down payment plus loan repayment', DEFAULT.down + initialResult.totalPayment],
        ].map(([label, value]) => (<tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">{label}</td><td class="py-2.5 px-3 text-text-primary">{fmt(Number(value))}</td></tr>))}</tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Totals use the unrounded monthly payment internally. Multiplying the displayed rounded EMI can give a slightly different total. The acquisition-cost line excludes charges not included in the entered vehicle price.</p>
      </section>

      <section aria-labelledby="car-loan-down-payment">
        <h2 id="car-loan-down-payment" class="text-xl font-bold text-text-primary mb-4">How a larger down payment changes the EMI</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Same vehicle price, rate and term as the worked example</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Down payment</th><th scope="col" class="text-left py-2.5 px-3">Loan amount</th><th scope="col" class="text-left py-2.5 px-3">Monthly EMI</th><th scope="col" class="text-left py-2.5 px-3">Total interest</th></tr></thead>
          <tbody>{downPaymentExamples.map((row) => (<tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">{fmt(row.down)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(row.principal)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(row.emiRounded)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(row.totalInterest)}</td></tr>))}</tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The table isolates the borrowing-cost effect. A larger upfront payment also leaves less cash available for other expenses. <a href="https://www.consumerfinance.gov/ask-cfpb/how-does-a-down-payment-affect-my-auto-loan-en-773/" class="text-accent font-medium hover:underline">The CFPB explains how a down payment reduces the financed amount</a>.</p>
      </section>

      <section aria-labelledby="car-loan-interpretation">
        <h2 id="car-loan-interpretation" class="text-xl font-bold text-text-primary mb-4">Comparing dealer quotes and bank loans</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">A flat rate charges interest on the original principal for the full term. For this example’s loan, an illustrative {FLAT_PCT}% flat rate produces an EMI of {fmt(flatEmi)} and an equivalent nominal reducing-balance rate of about {flatReducing.toFixed(2)}%. That conversion excludes fees; it is not an all-in APR.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Compare the contractual interest rate, processing charges and APR in the <a href="https://www.rbi.org.in/Scripts/NotificationUser.aspx?Id=12663&Mode=0" class="text-accent font-medium hover:underline">lender’s Key Facts Statement</a>. Read <a href="/blog/flat-vs-reducing-interest-rate" class="text-accent font-medium hover:underline">how flat and reducing interest rates differ</a> before comparing two quotes stated on different bases.</p>
      </section>

      <section aria-labelledby="car-loan-assumptions">
        <h2 id="car-loan-assumptions" class="text-xl font-bold text-text-primary mb-4">New and used cars: what to include</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Use the amount being financed from the itemised quote. Registration, initial insurance and other purchase costs belong in that amount only if they are being financed. The tool does not add them automatically, and it has no separate trade-in or old-loan payoff field.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The same payment formula can model a new or used car with equal monthly instalments. It assumes a constant rate, no missed payments and no balloon balance. Budget separately for fuel, maintenance and insurance renewals; check the agreement for any prepayment conditions.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">For a repayment breakdown, open the <a href="/loan-amortization-calculator" class="text-accent font-medium hover:underline">loan amortization schedule calculator</a>. <a href="https://www.consumerfinance.gov/consumer-tools/auto-loans/answers/key-terms/" class="text-accent font-medium hover:underline">CFPB’s auto-loan glossary</a> explains why a longer term can increase total interest and leave a borrower owing more than the vehicle is worth.</p>
      </section>

      <section aria-labelledby="car-loan-calculator-faq">
        <h2 id="car-loan-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.question}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{faq.answer}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="car-loan-calculator-related">
        <h2 id="car-loan-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcEMI } from '../lib/calculators/emi';
  import { validate } from '../lib/validate';
  import { moneyRules } from '../lib/currency';
  import { parseSmartInput } from '../lib/formatters';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currentHashState: Record<string, any> = {};
  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseSmartInput(raw, currLocale === 'de-DE' ? 'EUR' : undefined);
    return num === null || isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(num));
  }

  function initCLCalc() {
    const priceInput = document.getElementById('cl-price') as HTMLInputElement | null;
    const downInput = document.getElementById('cl-down') as HTMLInputElement | null;
    const rateInput = document.getElementById('cl-rate') as HTMLInputElement | null;
    const yearsInput = document.getElementById('cl-years') as HTMLInputElement | null;
    const priceSlider = document.getElementById('cl-price-slider') as HTMLInputElement | null;
    const downSlider = document.getElementById('cl-down-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('cl-rate-slider') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('cl-years-slider') as HTMLInputElement | null;

    if (!priceInput || !downInput || !rateInput || !yearsInput) return;

    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
    document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
      el.textContent = currSym;
    });

    if (priceInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    priceInput.dataset.bound = 'true';

    const resEMI = document.getElementById('cl-result-emi');
    const resPrincipal = document.getElementById('cl-result-principal');
    const resDown = document.getElementById('cl-result-down');
    const resInterest = document.getElementById('cl-result-interest');
    const resTotal = document.getElementById('cl-result-total');

    const errAlert = document.getElementById('cl-error-alert');
    const errMsg = document.getElementById('cl-error-msg');

    const DEFAULTS = { price: 1200000, down: 200000, rate: 9.0, years: 5 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const isEur = currLocale === 'de-DE';
      const numPrice = parseSmartInput(priceInput!.value, isEur ? 'EUR' : undefined);
      const numDown = parseSmartInput(downInput!.value, isEur ? 'EUR' : undefined);
      const numRate = parseSmartInput(rateInput!.value, isEur ? 'EUR' : undefined);
      const numYears = parseSmartInput(yearsInput!.value, isEur ? 'EUR' : undefined);

      const vPrice = validate(numPrice ?? priceInput!.value, moneyRules({ required: true, min: 1000, label: 'Vehicle Price' }));
      const vDown = validate(numDown ?? downInput!.value, { required: true, min: 0, label: 'Down Payment' });
      const vRate = validate(numRate ?? rateInput!.value, { required: true, min: 0.1, max: 30, decimal: true, label: 'Interest Rate' });
      const vYears = validate(numYears ?? yearsInput!.value, { required: true, min: 1, max: 15, integer: true, label: 'Tenure' });

      if (!vPrice.valid) { showError(vPrice.error!.message); return; }
      if (!vDown.valid) { showError(vDown.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      if (!vYears.valid) { showError(vYears.error!.message); return; }

      const price = vPrice.value!;
      const downAmt = vDown.value!;
      const rate = vRate.value!;
      const years = vYears.value!;

      if (downAmt >= price) {
        showError('Down payment cannot exceed or equal vehicle price.');
        return;
      }
      clearError();

      const loan = price - downAmt;
      const res = calcEMI(loan, rate, years);

      setResult({
        heroValue: fmtVal(res.emiRounded),
        heroLabel: 'Monthly EMI',
        rows: [
          { label: 'Loan Principal', value: fmtVal(loan) },
          { label: 'Down Payment', value: fmtVal(downAmt) },
          { label: 'Total Interest', value: fmtVal(res.totalInterest) },
          { label: 'Total Payment', value: fmtVal(res.totalPayment) },
        ],
      });

      if (resEMI) resEMI.textContent = fmtVal(res.emiRounded);
      if (resPrincipal) resPrincipal.textContent = fmtVal(loan);
      if (resDown) resDown.textContent = fmtVal(downAmt);
      if (resInterest) resInterest.textContent = fmtVal(res.totalInterest);
      if (resTotal) resTotal.textContent = fmtVal(res.totalPayment);

      const wrapper = document.getElementById('cl-composition-wrapper');
      if (wrapper && res.totalPayment > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${Math.min(100, res.principalFraction * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(loan);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalInterest);
      }

      currentHashState = { p: price, d: downAmt, r: rate, y: years };
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider || !input) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        debounce();
      });
      input.addEventListener('blur', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num)) {
          input.value = isFormatted ? fmtLiveInput(String(num)) : String(num);
          recalc();
        }
      });
    }

    sync(priceSlider, priceInput, true);
    sync(downSlider, downInput, true);
    sync(rateSlider, rateInput, false);
    sync(yearsSlider, yearsInput, false);

    document.getElementById('cl-calculate')?.addEventListener('click', recalc);
    document.getElementById('cl-reset')?.addEventListener('click', () => {
      priceInput.value = fmtLiveInput(String(DEFAULTS.price));
      downInput.value = fmtLiveInput(String(DEFAULTS.down));
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);
      if (priceSlider) {
        priceSlider.value = String(DEFAULTS.price);
        priceSlider.style.setProperty('--slider-pct', `${((DEFAULTS.price - 200000) / (10000000 - 200000)) * 100}%`);
      }
      if (downSlider) {
        downSlider.value = String(DEFAULTS.down);
        downSlider.style.setProperty('--slider-pct', `${((DEFAULTS.down - 0) / (5000000 - 0)) * 100}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 6) / (20 - 6)) * 100}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (8 - 1)) * 100}%`);
      }
      clearError();
      recalc();
      priceInput.focus();
    });

    [priceInput, downInput, rateInput, yearsInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('cl-copy-btn')?.addEventListener('click', async () => {
      const isEur = currLocale === 'de-DE';
      const numPrice = parseSmartInput(priceInput.value, isEur ? 'EUR' : undefined);
      const numDown = parseSmartInput(downInput.value, isEur ? 'EUR' : undefined);
      const numRate = parseSmartInput(rateInput.value, isEur ? 'EUR' : undefined);
      const numYears = parseSmartInput(yearsInput.value, isEur ? 'EUR' : undefined);

      const vPrice = validate(numPrice ?? priceInput.value, moneyRules({ required: true, min: 1000, label: 'Vehicle Price' }));
      const vDown = validate(numDown ?? downInput.value, { required: true, min: 0, label: 'Down Payment' });
      const vRate = validate(numRate ?? rateInput.value, { required: true, min: 0.1, label: 'Rate' });
      const vYears = validate(numYears ?? yearsInput.value, { required: true, min: 1, label: 'Tenure' });

      if (!vPrice.valid || !vDown.valid || !vRate.valid || !vYears.valid) return;
      if (vDown.value! >= vPrice.value!) return;

      const loan = vPrice.value! - vDown.value!;
      const res = calcEMI(loan, vRate.value!, vYears.value!);
      const text = `Car Loan EMI: ${fmtVal(res.emiRounded)}/month on car price of ${fmtVal(vPrice.value!)} (${fmtVal(vDown.value!)} down, ${vRate.value}% for ${vYears.value} yrs). ${location.href.split('#')[0]}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cl-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cl-share-btn')?.addEventListener('click', async () => {
      const shareUrl = `${location.href.split('#')[0]}${serializeHash(currentHashState)}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cl-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    function applyHashParams() {
      const restored = restoreFromHash(readCurrentHash(), {
        p: moneyRules({ required: true, min: 1000, label: 'p' }),
        d: { required: true, min: 0, label: 'd' },
        r: { required: true, min: 0.1, max: 30, decimal: true, label: 'r' },
        y: { required: true, min: 1, max: 15, integer: true, label: 'y' },
      });
      if (restored.valid && restored.values.p && restored.values.d !== undefined && restored.values.r !== undefined && restored.values.y) {
        priceInput.value = fmtLiveInput(String(restored.values.p));
        downInput.value = fmtLiveInput(String(restored.values.d));
        rateInput.value = String(restored.values.r);
        yearsInput.value = String(restored.values.y);
      }
      recalc();
    }

    applyHashParams();
    window.addEventListener('hashchange', applyHashParams);

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
          el.textContent = currSym;
        });
        recalc();
      }
    });
  }

  initCLCalc();
  document.addEventListener('astro:page-load', initCLCalc);
</script>
