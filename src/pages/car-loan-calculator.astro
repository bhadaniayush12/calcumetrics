---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { TOOLS } from '../config/site';

const related = TOOLS.filter((t) => t.category === 'Loans' && t.slug !== 'car-loan-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/car-loan-calculator';
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'Car Loan Calculator', url: canonicalUrl, description: 'Calculate your car loan monthly payment, total cost, and interest charges for any loan amount, interest rate, and tenure.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' }, { '@type': 'ListItem', position: 3, name: 'Car Loan Calculator' }] }] };
---
<Layout title="Car Loan Calculator: Monthly Payment & Interest | Calcumetrics" description="Calculate your car loan monthly payment, total cost, and interest charges for any loan amount, interest rate, and tenure." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="Car Loan Calculator" category="Loans" categoryHref="/loans" heroValue="Calculate to see" heroLabel="Monthly EMI">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Car Loan Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate your car loan monthly payment, total cost, and interest charges for any loan amount, interest rate, and tenure.</p>
      <Alert variant="info" title="Assumption">Results are estimates for information only. Not financial advice.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" type="button">Calculate</Button><Button variant="ghost" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">Calculate to see</div>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="car-loan-calculator-how">
        <h2 id="car-loan-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Calculate your car loan monthly payment, total cost, and interest charges for any loan amount, interest rate, and tenure.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted">EMI = P × r × (1+r)^n / ((1+r)^n − 1). Car loans in India typically have 1–7 year tenures. Total cost of ownership includes on-road price plus all interest paid over the loan term.</p>
        </div>
      </section>
      <section aria-labelledby="car-loan-calculator-faq">
        <h2 id="car-loan-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is a good interest rate for a car loan?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Car loan rates in India typically range from 7% to 15% p.a. depending on the lender, your credit score, and the vehicle. New cars generally attract lower rates than used cars. A higher credit score and a larger down payment can help secure a lower rate.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Should I prepay my car loan?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Prepaying a car loan reduces total interest paid, but some lenders charge a prepayment penalty (typically 2-5% of outstanding principal). Check your loan agreement. Use our Loan Prepayment Calculator to compare the interest saved against any prepayment charge.</div></details>
        </div>
      </section>
      <section aria-labelledby="car-loan-calculator-related">
        <h2 id="car-loan-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
