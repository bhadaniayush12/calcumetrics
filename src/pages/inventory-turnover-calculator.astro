---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcInventoryTurnover } from '../lib/calculators/inventory-turnover';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { cogs: 800000, beginning: 120000, ending: 80000 };
const result = calcInventoryTurnover(DEFAULT.cogs, DEFAULT.beginning, DEFAULT.ending);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const RELATED_SLUGS = ['cogs-calculator', 'eoq-calculator', 'cash-conversion-cycle-calculator'];
const related = TOOLS.filter((t) => RELATED_SLUGS.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/inventory-turnover-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Inventory Turnover & Days (DSI/DIO) Calculator',
      url: canonicalUrl,
      description: 'Free inventory turnover ratio calculator to compute inventory turnover, Days Sales of Inventory (DSI/DIO), and stock replenishment cycles.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'Inventory Turnover Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a good inventory turnover ratio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Fast-moving consumer goods (FMCG) and grocery retailers typically turn over inventory 12 to 20 times per year (DSI of 18–30 days). Luxury retailers and heavy machinery manufacturers may turn inventory only 2 to 4 times per year (DSI of 90–180 days).',
          },
        },
        {
          '@type': 'Question',
          name: 'Why use COGS instead of Sales Revenue?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Inventory is valued at historical cost on the balance sheet. Using Sales Revenue would artificially inflate the turnover ratio with gross profit markups, creating an apples-to-oranges comparison. COGS accurately measures cost-to-cost.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the relationship between Inventory Turnover and DSI (DIO)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Days Sales of Inventory (DSI, also known as Days Inventory Outstanding or DIO) is the inverse of the turnover ratio expressed in days: DSI = 365 / Inventory Turnover Ratio. A higher turnover ratio yields a shorter DSI.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can an inventory turnover ratio be too high?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. An excessively high inventory turnover ratio may indicate inadequate stock levels, frequent stockouts, lost sales opportunities, or excessive freight costs from rushed replenishment orders.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does inventory turnover affect cash flow and working capital?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Higher inventory turnover shortens the Cash Conversion Cycle (CCC), freeing up tied-up working capital, reducing holding and storage expenses, and lowering the risk of product obsolescence.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Inventory Turnover & Days (DSI/DIO) Calculator | Calcumetrics"
  description="Free inventory turnover ratio calculator. Compute inventory turnover and Days Sales of Inventory (DSI/DIO) to measure stock velocity and working capital."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Inventory Turnover & Days (DSI)"
    category="Business"
    categoryHref="/business"
    heroValue={result.inventoryTurnoverRatio.toFixed(2) + 'x'}
    heroLabel="Inventory Turnover Ratio"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Inventory Turnover &amp; Days (DSI/DIO)</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate how quickly inventory is sold and converted into cash flow.</p>

      <!-- Error Alert -->
      <div id="it-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="it-error-msg"></span>
      </div>

      <!-- Cost of Goods Sold -->
      <div class="mb-5">
        <Input
          id="it-cogs"
          label="Annual Cost of Goods Sold (COGS)"
          prefix="₹"
          value="8,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Direct costs of producing products sold during the period"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-cogs-slider" min={50000} max={10000000} step={25000} value={800000} ariaLabel="COGS slider" />
        </div>
      </div>

      <!-- Beginning Inventory -->
      <div class="mb-5">
        <Input
          id="it-beg"
          label="Beginning Inventory (Start of Year)"
          prefix="₹"
          value="1,20,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Valuation of stock at start of measurement window"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-beg-slider" min={0} max={2500000} step={10000} value={120000} ariaLabel="Beginning inventory slider" />
        </div>
      </div>

      <!-- Ending Inventory -->
      <div class="mb-6">
        <Input
          id="it-end"
          label="Ending Inventory (End of Year)"
          prefix="₹"
          value="80,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Valuation of unsold stock at year close"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-end-slider" min={0} max={2500000} step={10000} value={80000} ariaLabel="Ending inventory slider" />
        </div>
      </div>

      <Alert variant="info" title="Supply Chain Velocity">
        A higher turnover ratio means products sell rapidly, minimizing holding costs and reducing stock obsolescence risk.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="it-calculate" type="button">Calculate Inventory Turnover</Button>
        <Button variant="ghost" id="it-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Inventory Turnover Ratio</span>
        <div id="it-result-hero" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {result.inventoryTurnoverRatio.toFixed(2)}x
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Days Sales of Inventory (DSI / DIO)</span>
          <span id="it-result-dsi" class="text-sm font-semibold tabular-nums text-dark-accent">{Math.round(result.daysSalesInventory)} Days</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Average Inventory Maintained</span>
          <span id="it-result-avg" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.averageInventory)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Annual Stock Cycles</span>
          <span id="it-result-cycles" class="text-sm font-medium tabular-nums text-dark-text">{result.inventoryTurnoverRatio.toFixed(1)} Cycles / Year</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Turnover Velocity</span>
          <span id="it-result-rating" class="text-sm font-bold tabular-nums text-dark-accent">{result.efficiencyRating}</span>
        </div>
      </div>

      <div class="mb-5" id="it-composition-wrapper">
        <CompositionBar
          principalFraction={result.averageInventory > 0 ? Math.min(1, result.averageInventory / DEFAULT.cogs) : 0.2}
          gainFraction={result.averageInventory > 0 ? Math.max(0, (DEFAULT.cogs - result.averageInventory) / DEFAULT.cogs) : 0.8}
          principalLabel="Avg Stock"
          gainLabel="COGS Cleared"
          principalValue={fmt(result.averageInventory)}
          gainValue={fmt(DEFAULT.cogs)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="it-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="it-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Key component of the Cash Conversion Cycle (CCC).</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="it-calculator-how" class="mb-8">
        <h2 id="it-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Inventory Turnover &amp; DSI (DIO) Are Calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Inventory turnover measures the operational velocity at which a business sells through and replenishes its stock over an accounting period. Rather than measuring sales revenue—which includes distortive gross profit markups—turnover compares the actual cost of merchandise cleared against the average capital tied up in warehouses.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-surface border border-border rounded-card p-4">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Step 1: Average Inventory</span>
            <div class="font-mono text-sm text-text-primary font-bold mb-2">Avg Inv = (Beg Inv + End Inv) ÷ 2</div>
            <p class="text-xs text-text-muted leading-relaxed">
              Smooths seasonal fluctuations between opening and closing warehouse balances.
            </p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Step 2: Turnover Ratio</span>
            <div class="font-mono text-sm text-text-primary font-bold mb-2">Turnover = COGS ÷ Avg Inv</div>
            <p class="text-xs text-text-muted leading-relaxed">
              Indicates how many times inventory is completely cleared and restocked annually.
            </p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Step 3: Days Sales (DSI/DIO)</span>
            <div class="font-mono text-sm text-text-primary font-bold mb-2">DSI = 365 ÷ Turnover Ratio</div>
            <p class="text-xs text-text-muted leading-relaxed">
              Expresses inventory holding duration in calendar days before being converted to sales.
            </p>
          </div>
        </div>

        <h3 class="text-base font-bold text-text-primary mb-3">Worked Example: Baseline Inventory Velocity Analysis</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider an enterprise with annual Cost of Goods Sold of ₹8,00,000, beginning inventory of ₹1,20,000, and ending inventory of ₹80,000:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-border bg-surface text-text-primary">
                <th class="py-3 px-4 font-semibold">Calculation Metric</th>
                <th class="py-3 px-4 font-semibold">Formula / Input</th>
                <th class="py-3 px-4 font-semibold">Value</th>
                <th class="py-3 px-4 font-semibold">Operational Interpretation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Cost of Goods Sold (COGS)</td>
                <td class="py-2.5 px-4 font-mono">User Input</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹8,00,000</td>
                <td class="py-2.5 px-4">Total direct manufacturing/purchasing cost of goods sold.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Beginning Inventory</td>
                <td class="py-2.5 px-4 font-mono">Balance Sheet (Jan 1)</td>
                <td class="py-2.5 px-4 font-mono">₹1,20,000</td>
                <td class="py-2.5 px-4">Warehouse valuation at start of reporting period.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Ending Inventory</td>
                <td class="py-2.5 px-4 font-mono">Balance Sheet (Dec 31)</td>
                <td class="py-2.5 px-4 font-mono">₹80,000</td>
                <td class="py-2.5 px-4">Physical count valuation at close of fiscal year.</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-text-primary">Average Inventory Maintained</td>
                <td class="py-2.5 px-4 font-mono">(₹1,20,000 + ₹80,000) ÷ 2</td>
                <td class="py-2.5 px-4 font-mono text-text-primary font-bold">₹1,00,000</td>
                <td class="py-2.5 px-4">Working capital tied up in stock across the year.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary">
                <td class="py-3 px-4">Inventory Turnover Ratio</td>
                <td class="py-3 px-4 font-mono">₹8,00,000 ÷ ₹1,00,000</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">8.00x</td>
                <td class="py-3 px-4">The company clears and turns over its inventory 8 times annually.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t border-border">
                <td class="py-3 px-4">Days Sales of Inventory (DSI / DIO)</td>
                <td class="py-3 px-4 font-mono">365 ÷ 8.00</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">45.6 Days (~46 Days)</td>
                <td class="py-3 px-4">Goods sit in the warehouse for 46 days before being converted to sales.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Industry Turnover &amp; DSI Benchmarks</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Grocery &amp; Supermarkets:</strong> 14x – 22x turnover (16–26 days DSI). Perishable goods demand rapid stock velocity to avoid spoilage.</li>
              <li><strong>Consumer Electronics:</strong> 6x – 10x turnover (36–60 days DSI). Fast technology lifecycles necessitate tight inventory controls against depreciation.</li>
              <li><strong>Apparel &amp; Fashion Retail:</strong> 4x – 6x turnover (60–90 days DSI). Driven by seasonal fashion lines; excess inventory triggers markdown discounting.</li>
              <li><strong>Automotive &amp; Heavy Industrial Machinery:</strong> 2x – 4x turnover (90–180 days DSI). High unit cost and specialized manufacturing allow longer holding windows.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">The "High Turnover Trap" vs. Sluggish Stock</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              While high turnover is generally praised, extremes reveal operational friction:
            </p>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4">
              <li><strong>Danger of Overly High Turnover (>25x):</strong> Frequent stockouts, unfulfilled customer orders, missed bulk supplier discounts, and high freight expediting fees.</li>
              <li><strong>Danger of Low Turnover (<3x):</strong> High carrying costs (insurance, warehousing, security = 15–25% of stock value), dead stock write-downs, and tied-up cash flow.</li>
              <li><strong>Impact on CCC:</strong> DSI is Days Inventory Outstanding (DIO). Every day shaved off DSI directly accelerates cash flow in the Cash Conversion Cycle (DIO + DSO − DPO).</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions &amp; Analytical Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Two-Point Average Distortion:</strong> Using only beginning and ending balances can skew ratios if a business experiences seasonal peaks (e.g., Diwali or holiday stocking) or intentionally dumps stock prior to fiscal year-end. Monthly 12-point averages provide superior accuracy.</li>
            <li><strong>Inventory Valuation Rule (FIFO vs. Weighted Average):</strong> Under inflation, FIFO produces a higher ending inventory and slightly lower turnover ratio than Weighted Average costing. (LIFO is prohibited under IFRS and Indian AS 2).</li>
            <li><strong>Product-Mix Aggregation:</strong> Blended turnover can mask critical operational imbalances where top-selling items turn 30 times a year while obsolete SKUs linger on shelves for 400 days without moving.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Optimizing inventory order sizes and holding costs?</strong>
        Read our supply chain guide on <a href="/blog/economic-order-quantity-eoq-guide" class="text-accent font-medium hover:underline">Economic Order Quantity (EOQ): Balancing Ordering vs. Carrying Costs Without Running Out of Stock</a> to align inventory turnover with batch replenishment economics.
      </div>

      <section aria-labelledby="it-calculator-faq">
        <h2 id="it-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="it-calculator-related">
        <h2 id="it-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcInventoryTurnover } from '../lib/calculators/inventory-turnover';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initITCalc() {
    if ((window as any).__cmItBound) return;
    (window as any).__cmItBound = true;

    const cogsInput = document.getElementById('it-cogs') as HTMLInputElement | null;
    const begInput = document.getElementById('it-beg') as HTMLInputElement | null;
    const endInput = document.getElementById('it-end') as HTMLInputElement | null;

    const cogsSlider = document.getElementById('it-cogs-slider') as HTMLInputElement | null;
    const begSlider = document.getElementById('it-beg-slider') as HTMLInputElement | null;
    const endSlider = document.getElementById('it-end-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('it-result-hero');
    const resDsi = document.getElementById('it-result-dsi');
    const resAvg = document.getElementById('it-result-avg');
    const resCycles = document.getElementById('it-result-cycles');
    const resRating = document.getElementById('it-result-rating');
    const mobileHero = document.getElementById('calc-mobile-hero');

    const errAlert = document.getElementById('it-error-alert');
    const errMsg = document.getElementById('it-error-msg');

    if (!cogsInput || !begInput || !endInput) return;

    const DEFAULTS = { cogs: 800000, beg: 120000, end: 80000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const rawCogs = cogsInput!.value.replace(/[^0-9.]/g, '');
      const rawBeg = begInput!.value.replace(/[^0-9.]/g, '');
      const rawEnd = endInput!.value.replace(/[^0-9.]/g, '');

      const vCogs = validate(rawCogs, { required: true, min: 1, label: 'Cost of Goods Sold (COGS)' });
      const vBeg = validate(rawBeg, { required: true, min: 0, label: 'Beginning Inventory' });
      const vEnd = validate(rawEnd, { required: true, min: 0, label: 'Ending Inventory' });

      if (!vCogs.valid) { showError(vCogs.error!.message); return; }
      if (!vBeg.valid) { showError(vBeg.error!.message); return; }
      if (!vEnd.valid) { showError(vEnd.error!.message); return; }
      clearError();

      const cogs = vCogs.value!;
      const beg = vBeg.value!;
      const end = vEnd.value!;

      const res = calcInventoryTurnover(cogs, beg, end);

      setResult({
        heroValue: res.inventoryTurnoverRatio.toFixed(2) + 'x',
        heroLabel: 'Inventory Turnover Ratio',
        rows: [
          { label: 'Days Sales of Inventory (DSI / DIO)', value: `${Math.round(res.daysSalesInventory)} Days` },
          { label: 'Average Inventory Maintained', value: fmtVal(res.averageInventory) },
          { label: 'Annual Stock Cycles', value: `${res.inventoryTurnoverRatio.toFixed(1)} Cycles / Year` },
          { label: 'Turnover Velocity', value: res.efficiencyRating },
        ],
      });

      if (resHero) resHero.textContent = res.inventoryTurnoverRatio.toFixed(2) + 'x';
      if (resDsi) resDsi.textContent = Math.round(res.daysSalesInventory) + ' Days';
      if (resAvg) resAvg.textContent = fmtVal(res.averageInventory);
      if (resCycles) resCycles.textContent = res.inventoryTurnoverRatio.toFixed(1) + ' Cycles / Year';
      if (mobileHero) mobileHero.textContent = res.inventoryTurnoverRatio.toFixed(2) + 'x';

      if (resRating) {
        resRating.textContent = res.efficiencyRating;
        resRating.className = res.efficiencyRating === 'High Velocity' ? 'text-sm font-bold tabular-nums text-dark-accent' : res.efficiencyRating === 'Slow-Moving' ? 'text-sm font-bold tabular-nums text-yellow-400' : 'text-sm font-bold tabular-nums text-dark-text';
      }

      const wrapper = document.getElementById('it-composition-wrapper');
      if (wrapper && cogs > 0) {
        const stockFrac = Math.min(1, res.averageInventory / cogs);
        const clearedFrac = Math.max(0, (cogs - res.averageInventory) / cogs);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(stockFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(clearedFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.averageInventory);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(cogs);
      }

      serializeHash({ c: cogs, b: beg, e: end });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(cogsSlider, cogsInput);
    sync(begSlider, begInput);
    sync(endSlider, endInput);

    document.getElementById('it-calculate')?.addEventListener('click', recalc);
    document.getElementById('it-reset')?.addEventListener('click', () => {
      cogsInput.value = fmtLiveInput(String(DEFAULTS.cogs));
      begInput.value = fmtLiveInput(String(DEFAULTS.beg));
      endInput.value = fmtLiveInput(String(DEFAULTS.end));

      if (cogsSlider) {
        cogsSlider.value = String(DEFAULTS.cogs);
        cogsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.cogs - 50000) / (10000000 - 50000)) * 100}%`);
      }
      if (begSlider) {
        begSlider.value = String(DEFAULTS.beg);
        begSlider.style.setProperty('--slider-pct', `${(DEFAULTS.beg / 2500000) * 100}%`);
      }
      if (endSlider) {
        endSlider.value = String(DEFAULTS.end);
        endSlider.style.setProperty('--slider-pct', `${(DEFAULTS.end / 2500000) * 100}%`);
      }

      clearError();
      recalc();
      cogsInput.focus();
    });

    [cogsInput, begInput, endInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('it-copy-btn')?.addEventListener('click', async () => {
      const rawCogs = cogsInput.value.replace(/[^0-9.]/g, '');
      const rawBeg = begInput.value.replace(/[^0-9.]/g, '');
      const rawEnd = endInput.value.replace(/[^0-9.]/g, '');

      const vCogs = validate(rawCogs, { required: true, min: 1, label: 'Cost of Goods Sold (COGS)' });
      const vBeg = validate(rawBeg, { required: true, min: 0, label: 'Beginning Inventory' });
      const vEnd = validate(rawEnd, { required: true, min: 0, label: 'Ending Inventory' });
      if (!vCogs.valid || !vBeg.valid || !vEnd.valid) return;

      const res = calcInventoryTurnover(vCogs.value!, vBeg.value!, vEnd.value!);
      const text = `Inventory Turnover: COGS ${fmtVal(vCogs.value!)}, Avg Stock ${fmtVal(res.averageInventory)} => Turnover: ${res.inventoryTurnoverRatio.toFixed(2)}x, DSI: ${Math.round(res.daysSalesInventory)} days (${res.efficiencyRating}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('it-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('it-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('it-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      c: { required: false, min: 1, label: 'c' },
      b: { required: false, min: 0, label: 'b' },
      e: { required: false, min: 0, label: 'e' },
      cogs: { required: false, min: 1, label: 'cogs' },
      beg: { required: false, min: 0, label: 'beg' },
      end: { required: false, min: 0, label: 'end' },
    });
    const initCogs = restored.values.c ?? restored.values.cogs;
    const initBeg = restored.values.b ?? restored.values.beg;
    const initEnd = restored.values.e ?? restored.values.end;
    if (restored.valid && initCogs !== undefined) {
      cogsInput.value = fmtLiveInput(String(initCogs));
      if (initBeg !== undefined) begInput.value = fmtLiveInput(String(initBeg));
      if (initEnd !== undefined) endInput.value = fmtLiveInput(String(initEnd));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initITCalc();
  document.addEventListener('astro:page-load', initITCalc);
</script>
