---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcLumpSum } from '../lib/calculators/lumpsum';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 8, years: 10 };
const result = calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'annually');
const fmt = (n: number) => '₹' + formatIndian(n);
const related = TOOLS.filter((t) => t.category === 'Investments' && t.slug !== 'lump-sum-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/lump-sum-calculator';
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'Lump Sum Calculator', url: canonicalUrl, description: 'Calculate future value of a one-time investment with compound interest.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' }, { '@type': 'ListItem', position: 3, name: 'Lump Sum Calculator' }] }] };
---
<Layout title="Lump Sum Calculator: Future Value & Returns | Calcumetrics" description="Calculate the future value of a one-time investment with compound interest. Section 12 fixture: ₹1,00,000 @ 8% / 10yr = ₹2,15,892. 100% client-side." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="Lump Sum Calculator" category="Investments" categoryHref="/investments" heroValue={fmt(result.maturity)} heroLabel="Future Value">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Lump Sum Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the future value of a one-time investment with compound interest. Formula: A = P × (1 + r/n)^(n×t)</p>
      <div class="mb-5">
        <Input id="ls-principal" label="Investment Amount" prefix="₹" value="1,00,000" isNumeric={true} localeFormat="indian" helperText="One-time investment" inputmode="decimal" />
        <div class="mt-2"><Slider id="ls-principal-slider" min={1000} max={10000000} step={1000} value={100000} ariaLabel="Investment amount slider" /></div>
      </div>
      <div class="mb-5">
        <Input id="ls-rate" label="Expected Return Rate" suffix="%" value="8.0" isNumeric={true} helperText="Annual rate of return" inputmode="decimal" />
        <div class="mt-2"><Slider id="ls-rate-slider" min={1} max={30} step={0.5} value={8} ariaLabel="Return rate slider" /></div>
      </div>
      <div class="mb-5">
        <Input id="ls-years" label="Investment Period" suffix="Yrs" value="10" isNumeric={true} helperText="Duration in years" inputmode="decimal" />
        <div class="mt-2"><Slider id="ls-years-slider" min={1} max={40} step={1} value={10} ariaLabel="Investment period slider" /></div>
      </div>
      <div class="mb-6">
        <Dropdown id="ls-freq" label="Compounding Frequency" options={[{value:'annually',label:'Annually'},{value:'semi-annually',label:'Semi-annually'},{value:'quarterly',label:'Quarterly'},{value:'monthly',label:'Monthly'}]} value="annually" helperText="How often interest is compounded" />
      </div>
      <Alert variant="info" title="Assumption">Annual compounding is assumed by default. Returns are estimates; not guaranteed.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" id="ls-calculate" type="button">Calculate</Button><Button variant="ghost" id="ls-reset" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Future Value</span>
        <div id="ls-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite" aria-atomic="true">{fmt(result.maturity)}</div>
      </div>
      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border"><span class="text-xs text-dark-muted">Principal Invested</span><span id="ls-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span></div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border"><span class="text-xs text-dark-muted">Wealth Gain</span><span id="ls-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.gain)}</span></div>
        <div class="flex items-center justify-between py-2.5"><span class="text-xs text-dark-muted">Return %</span><span id="ls-result-gain-pct" class="text-sm font-medium tabular-nums text-dark-accent">{result.gainPct.toFixed(1)}%</span></div>
      </div>
      <div class="mb-5"><CompositionBar principalFraction={result.principalFraction} gainFraction={result.gainFraction} principalLabel="Principal" gainLabel="Gain" principalValue={fmt(DEFAULT.principal)} gainValue={fmt(result.gain)} /></div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Returns are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="ls-how">
        <h2 id="ls-how" class="text-xl font-bold text-text-primary mb-4">How the Lump Sum calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">A lump sum investment is a one-time deployment of capital. Unlike a SIP where you invest monthly, here your entire principal starts compounding from day one. This means the longer your investment horizon, the more dramatic the compounding effect.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">A = P × (1 + r/n)^(n × t)</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">A</strong> — Future value</li>
            <li><strong class="text-text-primary">P</strong> — Principal (initial investment)</li>
            <li><strong class="text-text-primary">r</strong> — Annual rate (e.g. 0.08 for 8%)</li>
            <li><strong class="text-text-primary">n</strong> — Compounding periods per year</li>
            <li><strong class="text-text-primary">t</strong> — Time in years</li>
          </ul>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">For ₹1,00,000 at 8% p.a. compounded annually over 10 years: A = 1,00,000 × (1.08)¹⁰ = ₹2,15,892. This matches the Section 12 test fixture. With quarterly compounding the result would be slightly higher due to more frequent interest application.</p>
      </section>
      <section aria-labelledby="ls-faq">
        <h2 id="ls-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the difference between SIP and lump sum investing?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">A SIP invests a fixed amount monthly, averaging your purchase cost over time (rupee-cost averaging). A lump sum deploys all capital at once — ideal when valuations are low, but carries more timing risk. Both strategies have merit; many investors use a combination.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Does compounding frequency matter significantly?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Yes, but less so at shorter horizons. For ₹1 lakh at 8% over 10 years, annual compounding gives ₹2,15,892 while monthly compounding gives ₹2,21,964 — a difference of about ₹6,000. Over 30 years the gap grows considerably. Most bank FDs specify quarterly compounding.</div></details>
        </div>
      </section>
      <section aria-labelledby="ls-related">
        <h2 id="ls-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
<script>
function calcLS(p:number,r:number,t:number,n:number){const m=p*Math.pow(1+r/100/n,n*t);return{maturity:m,gain:m-p,gainPct:p>0?(m-p)/p*100:0,principalFraction:m>0?p/m:0,gainFraction:m>0?(m-p)/m:0};}
function fmtI(n:number){return '₹'+new Intl.NumberFormat('en-IN',{maximumFractionDigits:0}).format(Math.round(n));}
function fmtL(s:string){const num=parseInt(s.replace(/[^0-9]/g,''),10);return isNaN(num)?'':new Intl.NumberFormat('en-IN',{maximumFractionDigits:0}).format(num);}
function initLS(){
  const pi=document.getElementById('ls-principal') as HTMLInputElement|null;
  const ri=document.getElementById('ls-rate') as HTMLInputElement|null;
  const yi=document.getElementById('ls-years') as HTMLInputElement|null;
  const fi=document.getElementById('ls-freq') as HTMLSelectElement|null;
  const ps=document.getElementById('ls-principal-slider') as HTMLInputElement|null;
  const rs=document.getElementById('ls-rate-slider') as HTMLInputElement|null;
  const ys=document.getElementById('ls-years-slider') as HTMLInputElement|null;
  if(!pi||!ri||!yi) return;
  const FREQ:Record<string,number>={annually:1,'semi-annually':2,quarterly:4,monthly:12};
  const DEFAULTS={principal:100000,rate:8,years:10};
  let timer:ReturnType<typeof setTimeout>;
  function parseR(s:string){return parseFloat(s.replace(/[^0-9.]/g,''))||0;}
  function recalc(){
    const p=parseR(pi.value),r=parseFloat(ri.value)||0,y=parseInt(yi.value)||0,n=FREQ[fi?.value||'annually']??1;
    if(p<=0||r<=0||y<=0) return;
    const res=calcLS(p,r,y,n);
    const rm=document.getElementById('ls-result-maturity');const rp=document.getElementById('ls-result-principal');const rg=document.getElementById('ls-result-gain');const rpc=document.getElementById('ls-result-gain-pct');const mh=document.getElementById('calc-mobile-hero');
    if(rm) rm.textContent=fmtI(res.maturity);if(rp) rp.textContent=fmtI(p);if(rg) rg.textContent=fmtI(res.gain);if(rpc) rpc.textContent=res.gainPct.toFixed(1)+'%';if(mh) mh.textContent=fmtI(res.maturity);
    history.replaceState(null,'',`#p=${p}&r=${r}&y=${y}`);
  }
  function db(){clearTimeout(timer);timer=setTimeout(recalc,100);}
  function syncP(sl:HTMLInputElement|null,inp:HTMLInputElement,indian:boolean){if(!sl)return;sl.addEventListener('input',()=>{inp.value=indian?fmtL(sl.value):sl.value;const pct=((parseFloat(sl.value)-parseFloat(sl.min))/(parseFloat(sl.max)-parseFloat(sl.min)))*100;sl.style.setProperty('--slider-pct',`${pct.toFixed(2)}%`);db();});inp.addEventListener('input',()=>{const raw=inp.value.replace(/[^0-9.]/g,'');const num=parseFloat(raw);if(!isNaN(num)&&num>=parseFloat(sl.min)&&num<=parseFloat(sl.max)){sl.value=String(num);const pct=((num-parseFloat(sl.min))/(parseFloat(sl.max)-parseFloat(sl.min)))*100;sl.style.setProperty('--slider-pct',`${pct.toFixed(2)}%`);}if(indian)inp.value=fmtL(raw);db();});}
  syncP(ps,pi,true);syncP(rs,ri,false);syncP(ys,yi,false);
  fi?.addEventListener('change',db);
  document.getElementById('ls-calculate')?.addEventListener('click',recalc);
  document.getElementById('ls-reset')?.addEventListener('click',()=>{pi.value=fmtL(String(DEFAULTS.principal));ri.value=String(DEFAULTS.rate);yi.value=String(DEFAULTS.years);if(ps){ps.value=String(DEFAULTS.principal);ps.style.setProperty('--slider-pct',`${((DEFAULTS.principal-1000)/(10000000-1000)*100).toFixed(2)}%`);}if(rs){rs.value=String(DEFAULTS.rate);rs.style.setProperty('--slider-pct',`${((DEFAULTS.rate-1)/(30-1)*100).toFixed(2)}%`);}if(ys){ys.value=String(DEFAULTS.years);ys.style.setProperty('--slider-pct',`${((DEFAULTS.years-1)/(40-1)*100).toFixed(2)}%`);}recalc();pi.focus();});
  [pi,ri,yi].forEach(el=>el.addEventListener('keydown',(e)=>{if(e.key==='Enter')recalc();}));
}
initLS();document.addEventListener('astro:page-load',initLS);
</script>
