---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcLumpSum } from '../lib/calculators/lumpsum';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 8, years: 10 };
const result = calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'annually');
const fmt = (n: number) => '₹' + formatIndian(n);
const related = TOOLS.filter((t) => t.category === 'Investments' && t.slug !== 'lump-sum-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/lump-sum-calculator';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Lump Sum Calculator',
      url: canonicalUrl,
      description: 'Calculate future value of a one-time investment with compound interest.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Lump Sum Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the difference between SIP and lump sum investing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A SIP invests a fixed amount periodically, dollar-cost or rupee-cost averaging purchase prices over time. A lump sum deploys entire capital at once, compounding from day one, which maximizes long-term compound growth when entered at reasonable market valuations.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does compounding frequency matter significantly in lump sum investments?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. More frequent compounding (such as monthly or quarterly versus annually) produces slightly higher effective annual yields because accumulated interest starts generating subsequent interest sooner.',
          },
        },
        {
          '@type': 'Question',
          name: 'What formula is used for lump sum future value?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The standard compound interest formula is A = P × (1 + r/n)^(n × t), where A is maturity value, P is initial principal, r is the annual rate (decimal), n is compounding frequency per year, and t is time in years.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does inflation affect lump sum investment returns?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Inflation erodes nominal purchasing power. To assess real purchasing gains, calculate real return using the Fisher equation: Real Return ≈ Nominal Return − Inflation Rate.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I withdraw or add funds to a lump sum investment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Mutual funds and stocks typically allow flexible additions and redemptions. Fixed deposits (FDs) usually penalize early withdrawals and do not allow mid-tenure balance additions without creating a new separate deposit.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Lump Sum Calculator: Future Value & Compound Returns | Calcumetrics"
  description="Calculate the future value of a one-time investment with compound interest and custom compounding frequency. 100% client-side."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Lump Sum Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.maturity)}
    heroLabel="Future Value"
    calcType="simple"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Lump Sum Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the future value of a one-time investment with compound interest.</p>

      <!-- Error alert -->
      <div id="ls-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="ls-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <div class="mb-5">
        <Input
          id="ls-principal"
          label="Investment Amount"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="One-time upfront investment"
          inputmode="decimal"
          aria-describedby="ls-error-msg"
        />
        <div class="mt-2">
          <Slider id="ls-principal-slider" min={1000} max={10000000} step={1000} value={100000} ariaLabel="Investment amount slider" />
        </div>
      </div>

      <div class="mb-5">
        <Input
          id="ls-rate"
          label="Expected Return Rate"
          suffix="%"
          value="8.0"
          isNumeric={true}
          helperText="Annual rate of return"
          inputmode="decimal"
          aria-describedby="ls-error-msg"
        />
        <div class="mt-2">
          <Slider id="ls-rate-slider" min={1} max={30} step={0.5} value={8} ariaLabel="Return rate slider" />
        </div>
      </div>

      <div class="mb-5">
        <Input
          id="ls-years"
          label="Investment Period"
          suffix="Yrs"
          value="10"
          isNumeric={true}
          helperText="Duration in years"
          inputmode="decimal"
          aria-describedby="ls-error-msg"
        />
        <div class="mt-2">
          <Slider id="ls-years-slider" min={1} max={40} step={1} value={10} ariaLabel="Investment period slider" />
        </div>
      </div>

      <div class="mb-6">
        <Dropdown
          id="ls-freq"
          label="Compounding Frequency"
          options={[
            { value: 'annually', label: 'Annually' },
            { value: 'semi-annually', label: 'Semi-annually' },
            { value: 'quarterly', label: 'Quarterly' },
            { value: 'monthly', label: 'Monthly' },
          ]}
          value="annually"
          helperText="How often interest is compounded"
        />
      </div>

      <Alert variant="info" title="Assumption">Annual compounding is assumed by default. Returns are estimates; not guaranteed.</Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="ls-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="ls-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Future Value</span>
        <div id="ls-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Principal Invested</span>
          <span id="ls-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Wealth Gain</span>
          <span id="ls-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.gain)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Return</span>
          <span id="ls-result-gain-pct" class="text-sm font-medium tabular-nums text-dark-accent">{result.gainPct.toFixed(1)}%</span>
        </div>
      </div>

      <div class="mb-5" id="ls-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.gainFraction}
          principalLabel="Principal"
          gainLabel="Gain"
          principalValue={fmt(DEFAULT.principal)}
          gainValue={fmt(result.gain)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="ls-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="ls-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Returns are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="ls-how">
        <h2 id="ls-how" class="text-xl font-bold text-text-primary mb-4">How the Lump Sum calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">A lump sum investment is a one-time deployment of capital. Unlike a SIP where you invest monthly, here your entire principal starts compounding from day one. This means the longer your investment horizon, the more dramatic the compounding effect.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">A = P &times; (1 + r/n)<sup>n &times; t</sup></p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">A</strong> &mdash; Future value</li>
            <li><strong class="text-text-primary">P</strong> &mdash; Principal (initial investment)</li>
            <li><strong class="text-text-primary">r</strong> &mdash; Annual rate (e.g. 0.08 for 8%)</li>
            <li><strong class="text-text-primary">n</strong> &mdash; Compounding periods per year</li>
            <li><strong class="text-text-primary">t</strong> &mdash; Time in years</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="ls-faq">
        <h2 id="ls-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            ['What is the difference between SIP and lump sum investing?', 'A SIP invests a fixed amount periodically, dollar-cost or rupee-cost averaging purchase prices over time. A lump sum deploys entire capital at once, compounding from day one, which maximizes long-term compound growth when entered at reasonable market valuations.'],
            ['Does compounding frequency matter significantly in lump sum investments?', 'Yes. More frequent compounding (such as monthly or quarterly versus annually) produces slightly higher effective annual yields because accumulated interest starts generating subsequent interest sooner.'],
            ['What formula is used for lump sum future value?', 'The standard compound interest formula is A = P × (1 + r/n)^(n × t), where A is maturity value, P is initial principal, r is the annual rate (decimal), n is compounding frequency per year, and t is time in years.'],
            ['How does inflation affect lump sum investment returns?', 'Inflation erodes nominal purchasing power. To assess real purchasing gains, calculate real return using the Fisher equation: Real Return ≈ Nominal Return − Inflation Rate.'],
            ['Can I withdraw or add funds to a lump sum investment?', 'Mutual funds and stocks typically allow flexible additions and redemptions. Fixed deposits (FDs) usually penalize early withdrawals and do not allow mid-tenure balance additions without creating a new separate deposit.'],
          ].map(([q, a]) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{q}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="ls-related">
        <h2 id="ls-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';
  import { calcLumpSum } from '../lib/calculators/lumpsum';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initLS() {
    if ((window as any).__cmLSBound) return;
    (window as any).__cmLSBound = true;

    const pi = document.getElementById('ls-principal') as HTMLInputElement | null;
    const ri = document.getElementById('ls-rate') as HTMLInputElement | null;
    const yi = document.getElementById('ls-years') as HTMLInputElement | null;
    const fi = document.getElementById('ls-freq') as HTMLSelectElement | null;
    const ps = document.getElementById('ls-principal-slider') as HTMLInputElement | null;
    const rs = document.getElementById('ls-rate-slider') as HTMLInputElement | null;
    const ys = document.getElementById('ls-years-slider') as HTMLInputElement | null;

    const resMaturity = document.getElementById('ls-result-maturity');
    const resPrincipal = document.getElementById('ls-result-principal');
    const resGain = document.getElementById('ls-result-gain');
    const resGainPct = document.getElementById('ls-result-gain-pct');

    const errAlert = document.getElementById('ls-error-alert');
    const errMsg = document.getElementById('ls-error-msg');

    if (!pi || !ri || !yi) return;

    const FREQ: Record<string, number> = { annually: 1, 'semi-annually': 2, quarterly: 4, monthly: 12 };
    const DEFAULTS = { principal: 100000, rate: 8, years: 10 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawP = pi!.value.replace(/[^0-9.]/g, '');
      const rawR = ri!.value.replace(/[^0-9.]/g, '');
      const rawY = yi!.value.replace(/[^0-9.]/g, '');

      const vP = validate(rawP, { required: true, min: 1, label: 'Investment Amount' });
      const vR = validate(rawR, { required: true, min: 0.1, max: 100, decimal: true, label: 'Expected Return Rate' });
      const vY = validate(rawY, { required: true, min: 1, max: 50, integer: true, label: 'Investment Period' });

      if (!vP.valid) { showError(vP.error!.message); return; }
      if (!vR.valid) { showError(vR.error!.message); return; }
      if (!vY.valid) { showError(vY.error!.message); return; }
      clearError();

      const p = vP.value!;
      const r = vR.value!;
      const y = vY.value!;
      const freqVal = fi?.value || 'annually';
      const n = FREQ[freqVal] ?? 1;

      const res = calcLumpSum(p, r, y, freqVal as any);

      setResult({
        heroValue: fmtVal(res.maturity),
        heroLabel: 'Future Value',
        rows: [
          { label: 'Principal Invested', value: fmtVal(p) },
          { label: 'Wealth Gain', value: fmtVal(res.gain) },
          { label: 'Total Return', value: res.gainPct.toFixed(1) + '%' },
        ],
      });

      if (resMaturity) resMaturity.textContent = fmtVal(res.maturity);
      if (resPrincipal) resPrincipal.textContent = fmtVal(p);
      if (resGain) resGain.textContent = fmtVal(res.gain);
      if (resGainPct) resGainPct.textContent = res.gainPct.toFixed(1) + '%';

      const wrapper = document.getElementById('ls-composition-wrapper');
      if (wrapper && res.maturity > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(p);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.gain);
      }

      history.replaceState(null, '', serializeHash({ p, r, y }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(ps, pi, true);
    sync(rs, ri, false);
    sync(ys, yi, false);
    fi?.addEventListener('change', debounce);

    document.getElementById('ls-calculate')?.addEventListener('click', recalc);
    document.getElementById('ls-reset')?.addEventListener('click', () => {
      pi.value = fmtLiveInput(String(DEFAULTS.principal));
      ri.value = String(DEFAULTS.rate);
      yi.value = String(DEFAULTS.years);
      if (fi) fi.value = 'annually';

      if (ps) {
        ps.value = String(DEFAULTS.principal);
        ps.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 1000) / (10000000 - 1000)) * 100}%`);
      }
      if (rs) {
        rs.value = String(DEFAULTS.rate);
        rs.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (30 - 1)) * 100}%`);
      }
      if (ys) {
        ys.value = String(DEFAULTS.years);
        ys.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (40 - 1)) * 100}%`);
      }

      clearError();
      recalc();
      pi.focus();
    });

    [pi, ri, yi].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('ls-copy-btn')?.addEventListener('click', async () => {
      const rawP = pi.value.replace(/[^0-9.]/g, '');
      const rawR = ri.value.replace(/[^0-9.]/g, '');
      const rawY = yi.value.replace(/[^0-9.]/g, '');

      const vP = validate(rawP, { required: true, min: 1, label: 'P' });
      const vR = validate(rawR, { required: true, min: 0.1, label: 'R' });
      const vY = validate(rawY, { required: true, min: 1, label: 'Y' });

      if (!vP.valid || !vR.valid || !vY.valid) return;

      const res = calcLumpSum(vP.value!, vR.value!, vY.value!, (fi?.value || 'annually') as any);
      const text = `Lump Sum: ${fmtVal(vP.value!)} invested for ${vY.value} years at ${vR.value}% returns future value of ${fmtVal(res.maturity)} (Wealth gain: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('ls-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('ls-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('ls-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      p: { required: true, min: 1, label: 'p' },
      r: { required: true, min: 0.1, max: 100, decimal: true, label: 'r' },
      y: { required: true, min: 1, max: 50, integer: true, label: 'y' },
    });
    if (restored.valid && restored.values.p && restored.values.r !== undefined && restored.values.y) {
      pi.value = fmtLiveInput(String(restored.values.p));
      ri.value = String(restored.values.r);
      yi.value = String(restored.values.y);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initLS();
  document.addEventListener('astro:page-load', initLS);
</script>
