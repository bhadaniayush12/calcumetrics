---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcWorkingCapital } from '../lib/calculators/working-capital';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = {
  cash: 250000,
  receivables: 350000,
  inventory: 400000,
  payables: 300000,
  debt: 150000,
};

const result = calcWorkingCapital(
  DEFAULT.cash,
  DEFAULT.receivables,
  DEFAULT.inventory,
  0,
  DEFAULT.payables,
  DEFAULT.debt,
  0
);

const fmt = (n: number) => (n < 0 ? '-' : '') + '₹' + formatIndian(Math.abs(Math.round(n)));

const relatedSlugs = ['cash-conversion-cycle-calculator', 'liquidity-ratios-calculator', 'inventory-turnover-calculator'];
const related = TOOLS.filter((t) => relatedSlugs.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/working-capital-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Working Capital & Net Working Capital Calculator',
      url: canonicalUrl,
      description: 'Calculate Net Working Capital (NWC), Current Ratio, and Quick Acid-Test Ratio to assess operational liquidity and solvency.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'Working Capital Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can negative working capital ever be positive for a business?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, in specific asset-light businesses with rapid cash cycles (like supermarkets, McDonald’s, or Amazon). They receive immediate cash from customers while enjoying 30 to 90 days to pay suppliers, allowing them to fund growth on vendor float.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why is inventory deducted from the Quick Ratio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Inventory takes time to manufacture, market, and sell, and may only be liquidated at steep fire-sale discounts in an immediate cash crisis. The Quick Ratio tests pure near-cash liquidity.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is an ideal Current Ratio benchmark?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A Current Ratio between 1.5x and 2.0x is generally considered healthy across most operating industries, indicating sufficient liquid assets to cover maturing short-term obligations without tying up excess idle cash.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does lengthening supplier payment terms improve working capital?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Negotiating longer payment terms with suppliers (higher Accounts Payable) delays cash outflows, directly preserving cash balances and increasing net operating liquidity.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between Gross Working Capital and Net Working Capital?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Gross Working Capital refers to the total monetary sum of all current assets. Net Working Capital subtracts total current liabilities from current assets, quantifying the true liquidity cushion.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Working Capital Calculator: NWC & Ratios | Calcumetrics"
  description="Calculate Net Working Capital (NWC), Current Ratio, and Quick Acid-Test Ratio to assess operational liquidity and short-term solvency."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Working Capital Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(result.netWorkingCapital)}
    heroLabel="Net Working Capital (NWC)"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Working Capital Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate operating liquidity cushion: Current Assets minus Current Liabilities.</p>

      <!-- Error alert -->
      <div id="wc-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="wc-error-msg"></span>
      </div>

      <!-- Current Assets section -->
      <div class="mb-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Current Assets</h2>
        <div class="space-y-4">
          <div>
            <Input id="wc-cash" label="Cash & Bank Balances" prefix="₹" value="2,50,000" isNumeric={true} localeFormat="indian" />
            <div class="mt-2">
              <Slider id="wc-cash-slider" min={0} max={2500000} step={10000} value={250000} ariaLabel="Cash slider" />
            </div>
          </div>
          <div>
            <Input id="wc-receivables" label="Accounts Receivable (Debtors)" prefix="₹" value="3,50,000" isNumeric={true} localeFormat="indian" />
            <div class="mt-2">
              <Slider id="wc-receivables-slider" min={0} max={2500000} step={10000} value={350000} ariaLabel="Receivables slider" />
            </div>
          </div>
          <div>
            <Input id="wc-inventory" label="Inventory / Raw Stock" prefix="₹" value="4,00,000" isNumeric={true} localeFormat="indian" />
            <div class="mt-2">
              <Slider id="wc-inventory-slider" min={0} max={2500000} step={10000} value={400000} ariaLabel="Inventory slider" />
            </div>
          </div>
        </div>
      </div>

      <!-- Current Liabilities section -->
      <div class="mb-6 border-t border-border pt-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-text-primary mb-3">Current Liabilities</h2>
        <div class="space-y-4">
          <div>
            <Input id="wc-payables" label="Accounts Payable (Creditors)" prefix="₹" value="3,00,000" isNumeric={true} localeFormat="indian" />
            <div class="mt-2">
              <Slider id="wc-payables-slider" min={0} max={2500000} step={10000} value={300000} ariaLabel="Payables slider" />
            </div>
          </div>
          <div>
            <Input id="wc-debt" label="Short-Term Debt & Overdrafts" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" />
            <div class="mt-2">
              <Slider id="wc-debt-slider" min={0} max={2500000} step={10000} value={150000} ariaLabel="Short-term debt slider" />
            </div>
          </div>
        </div>
      </div>

      <Alert variant="info" title="Healthy Liquidity Target">
        A <strong>Current Ratio between 1.5 and 2.0</strong> and positive Net Working Capital indicates a comfortable cushion to meet short-term commitments without emergency financing.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="wc-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="wc-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Net Working Capital</span>
        <div id="wc-result-hero" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.netWorkingCapital)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Current Assets</span>
          <span id="wc-result-assets" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.totalCurrentAssets)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Current Liabilities</span>
          <span id="wc-result-liabilities" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.totalCurrentLiabilities)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Current Ratio</span>
          <span id="wc-result-currentratio" class="text-sm font-bold tabular-nums text-dark-text">{result.currentRatio.toFixed(2)}x</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Quick (Acid-Test) Ratio</span>
          <span id="wc-result-quickratio" class="text-sm font-medium tabular-nums text-dark-text">{result.quickRatio.toFixed(2)}x</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Liquidity Status</span>
          <span id="wc-result-status" class="text-sm font-bold tabular-nums text-dark-accent">Strong Liquidity</span>
        </div>
      </div>

      <div class="mb-5" id="wc-composition-wrapper">
        <CompositionBar
          principalFraction={result.totalCurrentAssets > 0 ? Math.min(1, result.totalCurrentLiabilities / result.totalCurrentAssets) : 0.5}
          gainFraction={result.totalCurrentAssets > 0 ? Math.max(0, result.netWorkingCapital / result.totalCurrentAssets) : 0.5}
          principalLabel="Liabilities"
          gainLabel="Net Cushion"
          principalValue={fmt(result.totalCurrentLiabilities)}
          gainValue={fmt(result.netWorkingCapital)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="wc-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="wc-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Core metric for corporate treasury, trade credit, and working capital loans.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="wc-calculator-how">
        <h2 id="wc-calculator-how" class="text-xl font-bold text-text-primary mb-4">Working Capital formulas and definitions</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            Working capital measures an enterprise's short-term financial health, operational liquidity, and ability to cover maturing obligations within a 12-month commercial cycle:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono mb-4">
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Net Working Capital (NWC)</span>
              <span class="text-text-muted">NWC = Current Assets − Current Liabilities</span><br />
              <span class="text-accent font-semibold mt-1 block">Monetary liquidity buffer</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Current Ratio</span>
              <span class="text-text-muted">CR = Current Assets ÷ Current Liabilities</span><br />
              <span class="text-accent font-semibold mt-1 block">Benchmark: 1.5× – 2.0×</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Quick (Acid-Test) Ratio</span>
              <span class="text-text-muted">QR = (Current Assets − Inventory) ÷ Current Liab.</span><br />
              <span class="text-accent font-semibold mt-1 block">Benchmark: &ge; 1.0×</span>
            </div>
          </div>
          <p class="text-xs text-text-muted leading-relaxed">
            <strong>Operating Working Capital (OWC):</strong> In corporate valuation and DCF modeling, analysts often compute <em>OWC = (Accounts Receivable + Inventory) − Accounts Payable</em>, which isolates core operating working capital requirements from non-operating excess cash and financing notes.
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-step worked example</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider an operating trading enterprise with the default baseline parameters: cash balances of <strong>₹2,50,000</strong>, trade receivables of <strong>₹3,50,000</strong>, physical inventory of <strong>₹4,00,000</strong>, accounts payable of <strong>₹3,00,000</strong>, and bank overdraft debt of <strong>₹1,50,000</strong>:
        </p>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="py-3 px-4">Balance Sheet Category</th>
                <th class="py-3 px-4">Component</th>
                <th class="py-3 px-4">Book Value</th>
                <th class="py-3 px-4">Subtotal / Ratio Impact</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary" rowspan="3">Current Assets</td>
                <td class="py-2.5 px-4">Cash & Bank Balances</td>
                <td class="py-2.5 px-4 font-mono">₹2,50,000</td>
                <td class="py-2.5 px-4 font-mono text-text-muted" rowspan="3">
                  <strong class="text-text-primary">Total Current Assets:</strong><br />
                  <span class="text-accent font-bold">₹10,00,000</span>
                </td>
              </tr>
              <tr>
                <td class="py-2.5 px-4">Accounts Receivable (Debtors)</td>
                <td class="py-2.5 px-4 font-mono">₹3,50,000</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4">Inventory / Stock</td>
                <td class="py-2.5 px-4 font-mono">₹4,00,000</td>
              </tr>
              <tr class="border-t-2 border-border">
                <td class="py-2.5 px-4 font-medium text-text-primary" rowspan="2">Current Liabilities</td>
                <td class="py-2.5 px-4">Accounts Payable (Creditors)</td>
                <td class="py-2.5 px-4 font-mono">₹3,00,000</td>
                <td class="py-2.5 px-4 font-mono text-text-muted" rowspan="2">
                  <strong class="text-text-primary">Total Current Liabilities:</strong><br />
                  <span class="text-error font-bold">₹4,50,000</span>
                </td>
              </tr>
              <tr>
                <td class="py-2.5 px-4">Short-Term Debt & Overdrafts</td>
                <td class="py-2.5 px-4 font-mono">₹1,50,000</td>
              </tr>
              <tr class="bg-surface/50 font-medium border-t-2 border-border">
                <td class="py-2.5 px-4 text-text-primary" colspan="2">Net Working Capital (Assets − Liabilities)</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold" colspan="2">₹10,00,000 − ₹4,50,000 = ₹5,50,000 Cushion</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary">
                <td class="py-2.5 px-4" colspan="2">Current Ratio (Solvency Coverage)</td>
                <td class="py-2.5 px-4 font-mono text-text-primary" colspan="2">₹10,00,000 ÷ ₹4,50,000 = <strong>2.22×</strong> (Healthy Cushion)</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-text-primary" colspan="2">Quick Ratio (Near-Cash Coverage Excl. Stock)</td>
                <td class="py-2.5 px-4 font-mono text-accent" colspan="2">(₹10,00,000 − ₹4,00,000) ÷ ₹4,50,000 = <strong>1.33×</strong> (Safe &gt; 1.0×)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Can Negative Working Capital Be Advantageous?</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              While negative NWC signifies imminent insolvency for capital-intensive manufacturers, it can be a hallmark of supreme capital efficiency in specific business models:
            </p>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4">
              <li><strong>Hypermarket & Retail Platforms:</strong> Companies like Amazon or supermarkets collect cash from customers immediately at the point of sale (0 to 2 days) while negotiating 60- to 90-day payment terms with suppliers.</li>
              <li><strong>Free Vendor Financing:</strong> Operating with negative working capital means suppliers effectively provide interest-free capital to fund company expansion.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Bank Financing Norms (MPBF Framework)</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              Commercial banks in India evaluate working capital credit limits using the Tandon Committee &amp; Maximum Permissible Bank Finance (MPBF) norms:
            </p>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4">
              <li><strong>Borrower Margin Money:</strong> Banks require corporate borrowers to finance at least 25% of current assets (or the working capital gap) from long-term equity/surplus funds.</li>
              <li><strong>Mandatory Benchmark:</strong> Banks generally mandate a minimum Current Ratio of 1.33× before sanctioning cash credit (CC) or bank overdraft (OD) facilities.</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions & Balance Sheet Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Balance Sheet Point-in-Time Snapshot:</strong> Ratios reflect balances on a single calendar day (e.g., March 31). Seasonal businesses may appear highly liquid during inventory ramp-up while suffering severe mid-year cash shortages.</li>
            <li><strong>Receivables Collectibility Risk:</strong> The standard Current Ratio assumes 100% of accounts receivable will convert to cash. Aging debtors (> 90 days overdue) or uncollectible bad debts inflate apparent working capital without providing actual liquidity.</li>
            <li><strong>Inventory Liquidation Reality:</strong> Finished goods may suffer from obsolescence, spoilage, or demand drops, meaning forced liquidation would yield substantially less than recorded book cost.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Looking Beyond Current Ratios?</strong>
        A positive working capital balance does not guarantee solvency if cash is trapped in sluggish cycles. Learn how balance sheet velocity protects liquidity in our guide: <a href="/blog/cash-conversion-cycle" class="text-accent font-medium hover:underline">The Cash Conversion Cycle: How Working Capital Velocity Drives Business Solvency</a>.
      </div>

      <section aria-labelledby="wc-calculator-faq">
        <h2 id="wc-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="wc-calculator-related">
        <h2 id="wc-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcWorkingCapital } from '../lib/calculators/working-capital';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    const sign = n < 0 ? '-' : '';
    return sign + currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.abs(Math.round(n)));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initWCCalc() {
    if ((window as any).__cmWcBound) return;
    (window as any).__cmWcBound = true;

    const cashInput = document.getElementById('wc-cash') as HTMLInputElement | null;
    const recInput = document.getElementById('wc-receivables') as HTMLInputElement | null;
    const invInput = document.getElementById('wc-inventory') as HTMLInputElement | null;
    const payInput = document.getElementById('wc-payables') as HTMLInputElement | null;
    const debtInput = document.getElementById('wc-debt') as HTMLInputElement | null;

    const cashSlider = document.getElementById('wc-cash-slider') as HTMLInputElement | null;
    const recSlider = document.getElementById('wc-receivables-slider') as HTMLInputElement | null;
    const invSlider = document.getElementById('wc-inventory-slider') as HTMLInputElement | null;
    const paySlider = document.getElementById('wc-payables-slider') as HTMLInputElement | null;
    const debtSlider = document.getElementById('wc-debt-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('wc-result-hero');
    const resAssets = document.getElementById('wc-result-assets');
    const resLiabilities = document.getElementById('wc-result-liabilities');
    const resCurRatio = document.getElementById('wc-result-currentratio');
    const resQuickRatio = document.getElementById('wc-result-quickratio');
    const resStatus = document.getElementById('wc-result-status');

    const errAlert = document.getElementById('wc-error-alert');
    const errMsg = document.getElementById('wc-error-msg');

    if (!cashInput || !recInput || !invInput) return;

    const DEFAULTS = { cash: 250000, rec: 350000, inv: 400000, pay: 300000, debt: 150000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawCash = cashInput!.value.replace(/[^0-9.]/g, '');
      const rawRec = recInput!.value.replace(/[^0-9.]/g, '');
      const rawInv = invInput!.value.replace(/[^0-9.]/g, '');
      const rawPay = payInput ? payInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawDebt = debtInput ? debtInput.value.replace(/[^0-9.]/g, '') : '0';

      const vCash = validate(rawCash, { required: true, min: 0, label: 'Cash & Bank Balances' });
      const vRec = validate(rawRec, { required: true, min: 0, label: 'Accounts Receivable' });
      const vInv = validate(rawInv, { required: true, min: 0, label: 'Inventory' });
      const vPay = validate(rawPay, { required: true, min: 0, label: 'Accounts Payable' });
      const vDebt = validate(rawDebt, { required: true, min: 0, label: 'Short-Term Debt' });

      if (!vCash.valid) { showError(vCash.error!.message); return; }
      if (!vRec.valid) { showError(vRec.error!.message); return; }
      if (!vInv.valid) { showError(vInv.error!.message); return; }
      if (!vPay.valid) { showError(vPay.error!.message); return; }
      if (!vDebt.valid) { showError(vDebt.error!.message); return; }
      clearError();

      const cash = vCash.value!;
      const rec = vRec.value!;
      const inv = vInv.value!;
      const pay = vPay.value!;
      const debt = vDebt.value!;

      const res = calcWorkingCapital(cash, rec, inv, 0, pay, debt, 0);

      const statusText = res.status === 'Strong' ? 'Strong Liquidity' : res.status === 'Deficit' ? 'Liquidity Deficit / Risk' : 'Adequate Cushion';

      setResult({
        heroValue: fmtVal(res.netWorkingCapital),
        heroLabel: 'Net Working Capital (NWC)',
        rows: [
          { label: 'Total Current Assets', value: fmtVal(res.totalCurrentAssets) },
          { label: 'Total Current Liabilities', value: fmtVal(res.totalCurrentLiabilities) },
          { label: 'Current Ratio', value: `${res.currentRatio.toFixed(2)}x` },
          { label: 'Quick (Acid-Test) Ratio', value: `${res.quickRatio.toFixed(2)}x` },
          { label: 'Liquidity Status', value: statusText },
        ],
      });

      if (resHero) resHero.textContent = fmtVal(res.netWorkingCapital);
      if (resAssets) resAssets.textContent = fmtVal(res.totalCurrentAssets);
      if (resLiabilities) resLiabilities.textContent = fmtVal(res.totalCurrentLiabilities);
      if (resCurRatio) resCurRatio.textContent = `${res.currentRatio.toFixed(2)}x`;
      if (resQuickRatio) resQuickRatio.textContent = `${res.quickRatio.toFixed(2)}x`;

      if (resStatus) {
        if (res.status === 'Strong') {
          resStatus.textContent = 'Strong Liquidity';
          resStatus.className = 'text-sm font-bold tabular-nums text-dark-accent';
        } else if (res.status === 'Deficit') {
          resStatus.textContent = 'Liquidity Deficit / Risk';
          resStatus.className = 'text-sm font-bold tabular-nums text-red-400';
        } else {
          resStatus.textContent = 'Adequate Cushion';
          resStatus.className = 'text-sm font-bold tabular-nums text-yellow-400';
        }
      }

      const wrapper = document.getElementById('wc-composition-wrapper');
      if (wrapper && res.totalCurrentAssets > 0) {
        const liabFrac = Math.min(1, res.totalCurrentLiabilities / res.totalCurrentAssets);
        const cushionFrac = Math.max(0, res.netWorkingCapital / res.totalCurrentAssets);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(liabFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(cushionFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.totalCurrentLiabilities);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.netWorkingCapital);
      }

      serializeHash({ c: cash, r: rec, i: inv, p: pay, d: debt });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(cashSlider, cashInput);
    sync(recSlider, recInput);
    sync(invSlider, invInput);
    sync(paySlider, payInput!);
    sync(debtSlider, debtInput!);

    document.getElementById('wc-calculate')?.addEventListener('click', recalc);
    document.getElementById('wc-reset')?.addEventListener('click', () => {
      cashInput.value = fmtLiveInput(String(DEFAULTS.cash));
      recInput.value = fmtLiveInput(String(DEFAULTS.rec));
      invInput.value = fmtLiveInput(String(DEFAULTS.inv));
      if (payInput) payInput.value = fmtLiveInput(String(DEFAULTS.pay));
      if (debtInput) debtInput.value = fmtLiveInput(String(DEFAULTS.debt));

      if (cashSlider) {
        cashSlider.value = String(DEFAULTS.cash);
        cashSlider.style.setProperty('--slider-pct', `${(DEFAULTS.cash / 2500000) * 100}%`);
      }
      if (recSlider) {
        recSlider.value = String(DEFAULTS.rec);
        recSlider.style.setProperty('--slider-pct', `${(DEFAULTS.rec / 2500000) * 100}%`);
      }
      if (invSlider) {
        invSlider.value = String(DEFAULTS.inv);
        invSlider.style.setProperty('--slider-pct', `${(DEFAULTS.inv / 2500000) * 100}%`);
      }
      if (paySlider) {
        paySlider.value = String(DEFAULTS.pay);
        paySlider.style.setProperty('--slider-pct', `${(DEFAULTS.pay / 2500000) * 100}%`);
      }
      if (debtSlider) {
        debtSlider.value = String(DEFAULTS.debt);
        debtSlider.style.setProperty('--slider-pct', `${(DEFAULTS.debt / 2500000) * 100}%`);
      }

      clearError();
      recalc();
      cashInput.focus();
    });

    [cashInput, recInput, invInput, payInput, debtInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('wc-copy-btn')?.addEventListener('click', async () => {
      const rawCash = cashInput.value.replace(/[^0-9.]/g, '');
      const rawRec = recInput.value.replace(/[^0-9.]/g, '');
      const rawInv = invInput.value.replace(/[^0-9.]/g, '');
      const rawPay = payInput ? payInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawDebt = debtInput ? debtInput.value.replace(/[^0-9.]/g, '') : '0';

      const vCash = validate(rawCash, { required: true, min: 0, label: 'Cash' });
      const vRec = validate(rawRec, { required: true, min: 0, label: 'Receivables' });
      const vInv = validate(rawInv, { required: true, min: 0, label: 'Inventory' });
      const vPay = validate(rawPay, { required: true, min: 0, label: 'Payables' });
      const vDebt = validate(rawDebt, { required: true, min: 0, label: 'Debt' });
      if (!vCash.valid || !vRec.valid || !vInv.valid || !vPay.valid || !vDebt.valid) return;

      const res = calcWorkingCapital(vCash.value!, vRec.value!, vInv.value!, 0, vPay.value!, vDebt.value!, 0);
      const text = `Working Capital: Assets ${fmtVal(res.totalCurrentAssets)}, Liabilities ${fmtVal(res.totalCurrentLiabilities)} => NWC: ${fmtVal(res.netWorkingCapital)}, Current Ratio: ${res.currentRatio.toFixed(2)}x (${res.status}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('wc-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('wc-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('wc-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      c: { required: true, min: 0, label: 'c' },
      r: { required: true, min: 0, label: 'r' },
      i: { required: true, min: 0, label: 'i' },
      p: { required: true, min: 0, label: 'p' },
      d: { required: true, min: 0, label: 'd' },
    });
    if (restored.valid && restored.values.c !== undefined && restored.values.r !== undefined && restored.values.i !== undefined) {
      cashInput.value = fmtLiveInput(String(restored.values.c));
      recInput.value = fmtLiveInput(String(restored.values.r));
      invInput.value = fmtLiveInput(String(restored.values.i));
      if (payInput && restored.values.p !== undefined) payInput.value = fmtLiveInput(String(restored.values.p));
      if (debtInput && restored.values.d !== undefined) debtInput.value = fmtLiveInput(String(restored.values.d));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initWCCalc();
  document.addEventListener('astro:page-load', initWCCalc);
</script>
