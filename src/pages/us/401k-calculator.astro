---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calc401K } from '../../lib/calculators/401k';
import { TOOLS } from '../../config/site';

const DEFAULT = {
  annualSalary: 100000,
  contributionPct: 8,
  employerMatchPct: 50,
  employerMatchUpToPct: 6,
  ratePercent: 8,
  years: 30,
};

const result = calc401K(
  DEFAULT.annualSalary,
  DEFAULT.contributionPct,
  DEFAULT.employerMatchPct,
  DEFAULT.employerMatchUpToPct,
  DEFAULT.ratePercent,
  DEFAULT.years
);

const fmtUSD = (n: number) => '$' + new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Investments' && t.slug !== '401k-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/us/401k-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: '401(k) Calculator (US)',
      url: canonicalUrl,
      description: 'Free 401(k) calculator to estimate retirement savings growth with employer match, compound returns, and IRS contribution limits.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: '401(k) Calculator (US)' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is employer matching in a 401(k)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Employer match is additional money contributed by your company based on your own contributions. For instance, a 50% match up to 6% of salary means that if you contribute 6% of your $100,000 salary ($6,000), your employer contributes an additional $3,000, bringing total annual contributions to $9,000.',
          },
        },
        {
          '@type': 'Question',
          name: 'When can I withdraw from a 401(k) without penalty?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Generally, qualified penalty-free distributions can begin at age 59½. Non-qualified withdrawals prior to 59½ are typically subject to regular income taxes plus an additional 10% early withdrawal tax penalty, barring specific statutory exceptions.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the annual employee contribution limit for a 401(k)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For 2024–2026, the IRS employee elective deferral limit is $23,000 to $23,500 per year, with an additional catch-up contribution permitted for workers aged 50 and older.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between Traditional and Roth 401(k)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A Traditional 401(k) is funded with pre-tax dollars, lowering your taxable income today, and withdrawals in retirement are taxed as ordinary income. A Roth 401(k) is funded with after-tax dollars, but qualified withdrawals in retirement are completely tax-free.',
          },
        },
        {
          '@type': 'Question',
          name: 'What average annual return rate is realistic for a 401(k)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Historically, broad US equity indices like the S&P 500 have generated long-term nominal annualized returns around 9% to 10% (around 7% real after inflation). Diversified retirement portfolios containing bonds typically project between 6% and 8% p.a.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="401(k) Calculator: Retirement Savings Growth | Calcumetrics"
  description="Free 401(k) calculator. Estimate 401(k) retirement savings growth with employer match, compound returns, pre-tax advantages, and IRS contribution limits."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="401(k) Calculator (US)"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmtUSD(result.maturity)}
    heroLabel="Projected 401(k) Balance"
    calcType="advanced"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">401(k) Calculator (US)</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory baseline: <a href="https://www.irs.gov" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Internal Revenue Service (IRS)</a> · Contribution Limits &amp; SECURE 2.0.
      </p>

      <!-- Error alert -->
      <div id="k401-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="k401-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Annual Salary -->
      <div class="mb-5">
        <Input
          id="k401-salary"
          label="Current Annual Salary"
          prefix="$"
          value="100,000"
          isNumeric={true}
          localeFormat="international"
          helperText="Gross pre-tax annual income"
          inputmode="decimal"
          aria-describedby="k401-error-msg"
        />
        <div class="mt-2">
          <Slider id="k401-salary-slider" min={20000} max={500000} step={5000} value={100000} ariaLabel="Annual salary slider" />
        </div>
      </div>

      <!-- Contribution Pct -->
      <div class="mb-5">
        <Input
          id="k401-contrib"
          label="Your Contribution (% of Salary)"
          suffix="%"
          value="8"
          isNumeric={true}
          helperText="Percentage deducted each paycheck"
          inputmode="decimal"
          aria-describedby="k401-error-msg"
        />
        <div class="mt-2">
          <Slider id="k401-contrib-slider" min={1} max={50} step={0.5} value={8} ariaLabel="Contribution slider" />
        </div>
      </div>

      <!-- Employer Match -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
        <div>
          <Input
            id="k401-match"
            label="Employer Match Rate"
            suffix="%"
            value="50"
            isNumeric={true}
            helperText="e.g. 50% match (50c on the dollar)"
            inputmode="decimal"
            aria-describedby="k401-error-msg"
          />
          <div class="mt-2">
            <Slider id="k401-match-slider" min={0} max={100} step={5} value={50} ariaLabel="Match rate slider" />
          </div>
        </div>
        <div>
          <Input
            id="k401-match-limit"
            label="Match Capped Up To"
            suffix="%"
            value="6"
            isNumeric={true}
            helperText="Max % of salary matched by employer"
            inputmode="decimal"
            aria-describedby="k401-error-msg"
          />
          <div class="mt-2">
            <Slider id="k401-match-limit-slider" min={0} max={15} step={0.5} value={6} ariaLabel="Match cap slider" />
          </div>
        </div>
      </div>

      <!-- Return Rate -->
      <div class="mb-5">
        <Input
          id="k401-rate"
          label="Estimated Annual Rate of Return"
          suffix="%"
          value="8"
          isNumeric={true}
          helperText="Expected annual portfolio compound return"
          inputmode="decimal"
          aria-describedby="k401-error-msg"
        />
        <div class="mt-2">
          <Slider id="k401-rate-slider" min={1} max={15} step={0.25} value={8} ariaLabel="Return rate slider" />
        </div>
      </div>

      <!-- Years to Retire -->
      <div class="mb-6">
        <Input
          id="k401-years"
          label="Years Until Retirement"
          suffix="Years"
          value="30"
          isNumeric={true}
          helperText="Time horizon until retirement withdrawals start"
          inputmode="numeric"
          aria-describedby="k401-error-msg"
        />
        <div class="mt-2">
          <Slider id="k401-years-slider" min={1} max={45} step={1} value={30} ariaLabel="Years slider" />
        </div>
      </div>

      <Alert variant="info" title="US Jurisdiction Lock">
        This calculator operates strictly in US Dollars ($) reflecting US Internal Revenue Code 401(k) contribution rules.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="k401-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="k401-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Projected 401(k) Balance</span>
        <div id="k401-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmtUSD(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Your Contributions</span>
          <span id="k401-result-emp" class="text-sm font-medium tabular-nums text-dark-text">{fmtUSD(result.employeeContributed)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Employer Match (Free Money)</span>
          <span id="k401-result-er" class="text-sm font-medium tabular-nums text-dark-text">{fmtUSD(result.employerContributed)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Contributed</span>
          <span id="k401-result-total-contrib" class="text-sm font-medium tabular-nums text-dark-text">{fmtUSD(result.totalContributed)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Compound Growth / Gains</span>
          <span id="k401-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmtUSD(result.gain)}</span>
        </div>
      </div>

      <div class="mb-5" id="k401-composition-wrapper">
        <CompositionBar
          principalFraction={result.contributedFraction}
          gainFraction={result.gainFraction}
          principalLabel="Contributions"
          gainLabel="Growth"
          principalValue={fmtUSD(result.totalContributed)}
          gainValue={fmtUSD(result.gain)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="k401-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="k401-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes regular contributions and annual compounding. Not investment advice.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- 1. How it works -->
      <section aria-labelledby="k401-calculator-how">
        <h2 id="k401-calculator-how" class="text-xl font-bold text-text-primary mb-4">How 401(k) compound growth works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          A 401(k) plan is an employer-sponsored retirement savings account defined under Section 401(k) of the US Internal Revenue Code. Elective employee deferrals reduce your current taxable gross income, while company matching contributions provide an immediate, guaranteed boost to your retirement savings. All funds compound tax-deferred until distribution.
        </p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Each year's account accumulation combines ongoing savings and compound market performance:
        </p>

        <!-- Formula block -->
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-2">Balance<sub>t</sub> = (Balance<sub>t&minus;1</sub> + C<sub>employee</sub> + C<sub>employer</sub>) &times; (1 + r)</p>
          <p class="text-base font-mono text-text-primary mb-3">C<sub>employer</sub> = Salary &times; min(Contribution %, Match Cap %) &times; Match Rate %</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">Balance<sub>t</sub></strong> &mdash; 401(k) balance at the end of year <em>t</em></li>
            <li><strong class="text-text-primary">C<sub>employee</sub></strong> &mdash; Annual employee contribution (Salary &times; Contribution %)</li>
            <li><strong class="text-text-primary">C<sub>employer</sub></strong> &mdash; Annual employer matching contribution</li>
            <li><strong class="text-text-primary">r</strong> &mdash; Annual nominal portfolio rate of return (decimal)</li>
          </ul>
        </div>
      </section>

      <!-- 2. Step-by-Step Worked Example -->
      <section aria-labelledby="k401-calculator-example">
        <h2 id="k401-calculator-example" class="text-xl font-bold text-text-primary mb-4">Worked example: $100,000 salary over 30 years at 8% return</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an employee earning $100,000 annually who contributes 8% of salary with an employer match of 50% up to 6% of salary, invested for 30 years at an expected 8% annual return:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 text-sm text-text-muted space-y-2">
          <p><strong class="text-text-primary">1. Annual Employee Contribution:</strong> 8% of $100,000 = <strong class="text-text-primary">$8,000/year</strong></p>
          <p><strong class="text-text-primary">2. Annual Employer Match:</strong> 50% of the first 6% ($6,000) = <strong class="text-text-primary">$3,000/year</strong></p>
          <p><strong class="text-text-primary">3. Combined Annual Inflow:</strong> $8,000 + $3,000 = <strong class="text-text-primary">$11,000/year</strong></p>
          <p><strong class="text-text-primary">4. Cumulative Contributions over 30 Years:</strong></p>
          <ul class="list-disc pl-5 space-y-1 text-xs">
            <li>Your direct payroll contributions: 30 &times; $8,000 = <strong class="text-text-primary">$240,000</strong></li>
            <li>Employer matching contributions: 30 &times; $3,000 = <strong class="text-text-primary">$90,000</strong></li>
            <li>Total capital contributed: <strong class="text-text-primary">$330,000</strong></li>
          </ul>
          <p><strong class="text-text-primary">5. Compound Investment Growth:</strong> <strong class="text-text-primary text-accent">+$1,015,805</strong></p>
          <p><strong class="text-text-primary">6. Final Projected 401(k) Balance:</strong> <strong class="text-text-primary text-accent">$1,345,805</strong></p>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          <strong>The Power of Compound Growth:</strong> Over a 30-year horizon, compound returns generate <strong>$1.01M</strong> &mdash; more than triple the total deposits made by you and your employer combined.
        </p>
      </section>

      <!-- 3. Interpreting Your Results -->
      <section aria-labelledby="k401-calculator-interpretation">
        <h2 id="k401-calculator-interpretation" class="text-xl font-bold text-text-primary mb-4">Interpreting your 401(k) results</h2>
        <div class="space-y-3 text-sm text-text-muted leading-relaxed">
          <p>
            <strong class="text-text-primary">Capturing the Full Employer Match:</strong> Employer matching represents an immediate 50% or 100% risk-free return on your savings. Contributing less than your company's matching ceiling (6% in this example) forfeits direct compensation.
          </p>
          <p>
            <strong class="text-text-primary">Tax-Deferred vs. After-Tax Balance:</strong> The projected balance represents gross tax-deferred assets. In a Traditional 401(k), distributions taken during retirement are taxed as ordinary income at your future tax bracket. If utilizing a Roth 401(k), qualified distributions at retirement are completely federal income tax-free.
          </p>
        </div>
      </section>

      <!-- 4. Key Assumptions and Limitations -->
      <section aria-labelledby="k401-calculator-assumptions">
        <h2 id="k401-calculator-assumptions" class="text-xl font-bold text-text-primary mb-4">Key assumptions and limitations</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-text-muted leading-relaxed">
          <li>
            <strong class="text-text-primary">Flat Salary Baseline:</strong> The simulation holds salary and annual contributions constant across the tenure without modeling merit raises or inflation wage adjustments.
          </li>
          <li>
            <strong class="text-text-primary">Linear Annual Return:</strong> Assumes a constant 8.0% annual rate of return. Real financial markets fluctuate, introducing sequence-of-returns risk especially during the 5–10 years immediately preceding retirement.
          </li>
          <li>
            <strong class="text-text-primary">Immediate Vesting:</strong> Assumes 100% immediate vesting of all employer match funds. Some company plans utilize graded vesting schedules (e.g. 20% per year of service) or cliff vesting.
          </li>
          <li>
            <strong class="text-text-primary">IRS Statutory Contribution Caps:</strong> Employee contributions cannot exceed IRS elective deferral limits ($23,000 for 2024; $23,500 for 2025; plus catch-up for age 50+).
          </li>
          <li>
            <strong class="text-text-primary">Plan Fees Excluded:</strong> Does not deduct underlying mutual fund expense ratios, index tracking error, or plan administration charges.
          </li>
        </ul>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Deciding between pre-tax and post-tax contributions?</strong>
        Read our in-depth analysis on <a href="/blog/traditional-vs-roth-401k" class="text-accent font-medium hover:underline">Traditional vs. Roth 401(k): How to Choose Based on Tax Brackets and Retirement Horizon</a> to evaluate marginal tax arbitrage, employer match rules, and SECURE 2.0 catch-up provisions.
      </div>

      <!-- 5. Frequently Asked Questions -->
      <section aria-labelledby="k401-calculator-faq">
        <h2 id="k401-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            ['What is employer matching in a 401(k)?', 'Employer match is additional money contributed by your company based on your own contributions. For instance, a 50% match up to 6% of salary means that if you contribute 6% of your $100,000 salary ($6,000), your employer contributes an additional $3,000, bringing total annual contributions to $9,000.'],
            ['When can I withdraw from a 401(k) without penalty?', 'Generally, qualified penalty-free distributions can begin at age 59½. Non-qualified withdrawals prior to 59½ are typically subject to regular income taxes plus an additional 10% early withdrawal tax penalty, barring specific statutory exceptions.'],
            ['What is the annual employee contribution limit for a 401(k)?', 'For 2024–2026, the IRS employee elective deferral limit is $23,000 to $23,500 per year, with an additional catch-up contribution permitted for workers aged 50 and older.'],
            ['What is the difference between Traditional and Roth 401(k)?', 'A Traditional 401(k) is funded with pre-tax dollars, lowering your taxable income today, and withdrawals in retirement are taxed as ordinary income. A Roth 401(k) is funded with after-tax dollars, but qualified withdrawals in retirement are completely tax-free.'],
            ['What average annual return rate is realistic for a 401(k)?', 'Historically, broad US equity indices like the S&P 500 have generated long-term nominal annualized returns around 9% to 10% (around 7% real after inflation). Diversified retirement portfolios containing bonds typically project between 6% and 8% p.a.'],
          ].map(([q, a]) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{q}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="k401-calculator-related">
        <h2 id="k401-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';
  import { calc401K } from '../../lib/calculators/401k';

  // Strict USD jurisdiction lock
  const currSym = '$';
  const currLocale = 'en-US';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function init401KCalc() {
    if ((window as any).__cm401KBound) return;
    (window as any).__cm401KBound = true;

    const salaryInput = document.getElementById('k401-salary') as HTMLInputElement | null;
    const contribInput = document.getElementById('k401-contrib') as HTMLInputElement | null;
    const matchInput = document.getElementById('k401-match') as HTMLInputElement | null;
    const matchLimitInput = document.getElementById('k401-match-limit') as HTMLInputElement | null;
    const rateInput = document.getElementById('k401-rate') as HTMLInputElement | null;
    const yearsInput = document.getElementById('k401-years') as HTMLInputElement | null;

    const salarySlider = document.getElementById('k401-salary-slider') as HTMLInputElement | null;
    const contribSlider = document.getElementById('k401-contrib-slider') as HTMLInputElement | null;
    const matchSlider = document.getElementById('k401-match-slider') as HTMLInputElement | null;
    const matchLimitSlider = document.getElementById('k401-match-limit-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('k401-rate-slider') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('k401-years-slider') as HTMLInputElement | null;

    const resMaturity = document.getElementById('k401-result-maturity');
    const resEmp = document.getElementById('k401-result-emp');
    const resEr = document.getElementById('k401-result-er');
    const resTotalContrib = document.getElementById('k401-result-total-contrib');
    const resGain = document.getElementById('k401-result-gain');

    const errAlert = document.getElementById('k401-error-alert');
    const errMsg = document.getElementById('k401-error-msg');

    if (!salaryInput || !contribInput || !matchInput || !matchLimitInput || !rateInput || !yearsInput) return;

    const DEFAULTS = { salary: 100000, contrib: 8, match: 50, matchLimit: 6, rate: 8, years: 30 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawSal = salaryInput!.value.replace(/[^0-9.]/g, '');
      const rawCon = contribInput!.value.replace(/[^0-9.]/g, '');
      const rawMat = matchInput ? matchInput.value.replace(/[^0-9.]/g, '') : '50';
      const rawLim = matchLimitInput ? matchLimitInput.value.replace(/[^0-9.]/g, '') : '6';
      const rawR = rateInput!.value.replace(/[^0-9.]/g, '');
      const rawY = yearsInput!.value.replace(/[^0-9.]/g, '');

      const vSal = validate(rawSal, { required: true, min: 1000, label: 'Annual Salary' });
      const vCon = validate(rawCon, { required: true, min: 0, max: 100, decimal: true, label: 'Contribution %' });
      const vMat = validate(rawMat, { required: true, min: 0, max: 200, decimal: true, label: 'Employer Match %' });
      const vLim = validate(rawLim, { required: true, min: 0, max: 100, decimal: true, label: 'Match Cap %' });
      const vR = validate(rawR, { required: true, min: 0.1, max: 25, decimal: true, label: 'Return Rate' });
      const vY = validate(rawY, { required: true, min: 1, max: 50, integer: true, label: 'Years to Retirement' });

      if (!vSal.valid) { showError(vSal.error!.message); return; }
      if (!vCon.valid) { showError(vCon.error!.message); return; }
      if (!vMat.valid) { showError(vMat.error!.message); return; }
      if (!vLim.valid) { showError(vLim.error!.message); return; }
      if (!vR.valid) { showError(vR.error!.message); return; }
      if (!vY.valid) { showError(vY.error!.message); return; }
      clearError();

      const sal = vSal.value!;
      const con = vCon.value!;
      const mat = vMat.value!;
      const lim = vLim.value!;
      const r = vR.value!;
      const y = vY.value!;

      const res = calc401K(sal, con, mat, lim, r, y);

      setResult({
        heroValue: fmtVal(res.maturity),
        heroLabel: 'Projected 401(k) Balance',
        rows: [
          { label: 'Your Contributions', value: fmtVal(res.employeeContributed) },
          { label: 'Employer Match', value: fmtVal(res.employerContributed) },
          { label: 'Total Contributed', value: fmtVal(res.totalContributed) },
          { label: 'Compound Growth / Gains', value: fmtVal(res.gain) },
        ],
      });

      if (resMaturity) resMaturity.textContent = fmtVal(res.maturity);
      if (resEmp) resEmp.textContent = fmtVal(res.employeeContributed);
      if (resEr) resEr.textContent = fmtVal(res.employerContributed);
      if (resTotalContrib) resTotalContrib.textContent = fmtVal(res.totalContributed);
      if (resGain) resGain.textContent = fmtVal(res.gain);

      const wrapper = document.getElementById('k401-composition-wrapper');
      if (wrapper && res.maturity > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.contributedFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.totalContributed);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.gain);
      }

      history.replaceState(null, '', serializeHash({ s: sal, c: con, m: mat, l: lim, r, y }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(salarySlider, salaryInput, true);
    sync(contribSlider, contribInput, false);
    sync(matchSlider, matchInput, false);
    sync(matchLimitSlider, matchLimitInput, false);
    sync(rateSlider, rateInput, false);
    sync(yearsSlider, yearsInput, false);

    document.getElementById('k401-calculate')?.addEventListener('click', recalc);
    document.getElementById('k401-reset')?.addEventListener('click', () => {
      salaryInput.value = fmtLiveInput(String(DEFAULTS.salary));
      contribInput.value = String(DEFAULTS.contrib);
      matchInput.value = String(DEFAULTS.match);
      matchLimitInput.value = String(DEFAULTS.matchLimit);
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);

      if (salarySlider) {
        salarySlider.value = String(DEFAULTS.salary);
        salarySlider.style.setProperty('--slider-pct', `${((DEFAULTS.salary - 20000) / (500000 - 20000)) * 100}%`);
      }
      if (contribSlider) {
        contribSlider.value = String(DEFAULTS.contrib);
        contribSlider.style.setProperty('--slider-pct', `${((DEFAULTS.contrib - 1) / (50 - 1)) * 100}%`);
      }
      if (matchSlider) {
        matchSlider.value = String(DEFAULTS.match);
        matchSlider.style.setProperty('--slider-pct', `${((DEFAULTS.match - 0) / (100 - 0)) * 100}%`);
      }
      if (matchLimitSlider) {
        matchLimitSlider.value = String(DEFAULTS.matchLimit);
        matchLimitSlider.style.setProperty('--slider-pct', `${((DEFAULTS.matchLimit - 0) / (15 - 0)) * 100}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (15 - 1)) * 100}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (45 - 1)) * 100}%`);
      }

      clearError();
      recalc();
      salaryInput.focus();
    });

    [salaryInput, contribInput, matchInput, matchLimitInput, rateInput, yearsInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('k401-copy-btn')?.addEventListener('click', async () => {
      const rawSal = salaryInput.value.replace(/[^0-9.]/g, '');
      const rawCon = contribInput.value.replace(/[^0-9.]/g, '');
      const rawMat = matchInput ? matchInput.value.replace(/[^0-9.]/g, '') : '50';
      const rawLim = matchLimitInput ? matchLimitInput.value.replace(/[^0-9.]/g, '') : '6';
      const rawR = rateInput.value.replace(/[^0-9.]/g, '');
      const rawY = yearsInput.value.replace(/[^0-9.]/g, '');

      const vSal = validate(rawSal, { required: true, min: 1000, label: 'Salary' });
      const vCon = validate(rawCon, { required: true, min: 0, max: 100, label: 'Contrib' });
      const vMat = validate(rawMat, { required: true, min: 0, max: 200, label: 'Match' });
      const vLim = validate(rawLim, { required: true, min: 0, max: 100, label: 'Limit' });
      const vR = validate(rawR, { required: true, min: 0.1, label: 'R' });
      const vY = validate(rawY, { required: true, min: 1, label: 'Y' });

      if (!vSal.valid || !vCon.valid || !vMat.valid || !vLim.valid || !vR.valid || !vY.valid) return;

      const res = calc401K(vSal.value!, vCon.value!, vMat.value!, vLim.value!, vR.value!, vY.value!);
      const text = `401(k) Projection: Salary ${fmtVal(vSal.value!)}, saving ${vCon.value}% with ${vMat.value}% match up to ${vLim.value}% at ${vR.value}% for ${vY.value} years => Retirement balance: ${fmtVal(res.maturity)} (gains: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('k401-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('k401-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('k401-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      s: { required: true, min: 1000, label: 's' },
      c: { required: true, min: 0, max: 100, decimal: true, label: 'c' },
      m: { required: true, min: 0, max: 200, decimal: true, label: 'm' },
      l: { required: true, min: 0, max: 100, decimal: true, label: 'l' },
      r: { required: true, min: 0.1, max: 25, decimal: true, label: 'r' },
      y: { required: true, min: 1, max: 50, integer: true, label: 'y' },
    });
    if (restored.valid && restored.values.s && restored.values.c !== undefined && restored.values.r !== undefined && restored.values.y) {
      salaryInput.value = fmtLiveInput(String(restored.values.s));
      contribInput.value = String(restored.values.c);
      if (matchInput && restored.values.m !== undefined) matchInput.value = String(restored.values.m);
      if (matchLimitInput && restored.values.l !== undefined) matchLimitInput.value = String(restored.values.l);
      rateInput.value = String(restored.values.r);
      yearsInput.value = String(restored.values.y);
      recalc();
    } else {
      recalc();
    }
  }

  init401KCalc();
  document.addEventListener('astro:page-load', init401KCalc);
</script>
