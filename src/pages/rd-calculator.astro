---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcRD } from '../lib/calculators/rd';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { monthly: 5000, rate: 7.0, months: 60 };
const result = calcRD(DEFAULT.monthly, DEFAULT.rate, DEFAULT.months / 12);
const defaultGainPct = result.invested > 0 ? (result.interest / result.invested) * 100 : 0;

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Investments' && t.slug !== 'rd-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/rd-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Recurring Deposit (RD) Calculator',
      url: canonicalUrl,
      description: 'Calculate maturity value and interest earned on recurring deposits with quarterly compounding.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Recurring Deposit Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can I change my monthly RD installment amount?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In standard recurring deposits with commercial banks and post offices, the monthly installment amount is fixed at account opening. Some specialized digital banks offer flexible RD accounts where contributions can vary.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is Recurring Deposit interest taxable in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. RD interest is fully taxable as "Income from Other Sources" at your applicable income tax slab rate. TDS applies if total annual interest across all deposits with a banking entity exceeds ₹40,000 (₹50,000 for senior citizens).',
          },
        },
        {
          '@type': 'Question',
          name: 'How is interest compounded on a Recurring Deposit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Per Indian Banks\' Association (IBA) guidelines, commercial banks compound RD interest quarterly. Each monthly installment earns interest compounded quarterly for its respective remaining tenure until maturity.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if I miss an RD monthly installment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Banks usually levy a nominal penalty (e.g. ₹1.50 to ₹2.00 per ₹100 per month) for missed installments. If installments remain unpaid for consecutive months (typically 4 to 6 months), the bank may prematurely deactivate the account.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I withdraw funds prematurely from an RD account?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, premature closure is permitted by most banks, but it typically incurs a penalty of 0.5% to 1% reduction from the applicable interest rate for the period the deposit actually ran.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Recurring Deposit (RD) Calculator: Maturity & Interest | Calcumetrics"
  description="Calculate your Recurring Deposit maturity value and interest earned with bank-standard quarterly compounding on monthly deposits."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Recurring Deposit (RD) Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.maturity)}
    heroLabel="Maturity Value"
    calcType="simple"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Recurring Deposit Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the total maturity and interest from regular monthly bank deposits.</p>

      <!-- Error alert -->
      <div id="rd-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="rd-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Monthly Deposit -->
      <div class="mb-5">
        <Input
          id="rd-monthly"
          label="Monthly Installment"
          prefix="₹"
          value="5,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Amount deposited every month"
          inputmode="decimal"
          aria-describedby="rd-error-msg"
        />
        <div class="mt-2">
          <Slider id="rd-monthly-slider" min={500} max={100000} step={500} value={5000} ariaLabel="Monthly installment slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="rd-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="7.0"
          isNumeric={true}
          helperText="Bank interest rate p.a."
          inputmode="decimal"
          aria-describedby="rd-error-msg"
        />
        <div class="mt-2">
          <Slider id="rd-rate-slider" min={3} max={12} step={0.1} value={7.0} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure in Months -->
      <div class="mb-6">
        <Input
          id="rd-months"
          label="Tenure (Months)"
          suffix="Months"
          value="60"
          isNumeric={true}
          helperText="Total investment duration (60 months = 5 years)"
          inputmode="decimal"
          aria-describedby="rd-error-msg"
        />
        <div class="mt-2">
          <Slider id="rd-months-slider" min={6} max={120} step={6} value={60} ariaLabel="Tenure slider" />
        </div>
      </div>

      <Alert variant="info" title="Quarterly Compounding">
        Indian banks calculate RD interest compounded quarterly on all monthly installments per Indian Banks' Association guidelines.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="rd-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="rd-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Maturity Value</span>
        <div id="rd-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Invested</span>
          <span id="rd-result-invested" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.invested)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Interest Earned</span>
          <span id="rd-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.interest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Return on Investment</span>
          <span id="rd-result-gain-pct" class="text-sm font-medium tabular-nums text-dark-accent">{defaultGainPct.toFixed(1)}%</span>
        </div>
      </div>

      <div class="mb-5" id="rd-composition-wrapper">
        <CompositionBar
          principalFraction={result.investedFraction}
          gainFraction={result.interestFraction}
          principalLabel="Invested"
          gainLabel="Interest"
          principalValue={fmt(result.invested)}
          gainValue={fmt(result.interest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="rd-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="rd-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- 1. How it works -->
      <section aria-labelledby="rd-calculator-how">
        <h2 id="rd-calculator-how" class="text-xl font-bold text-text-primary mb-4">How the RD calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          A Recurring Deposit (RD) is a disciplined savings scheme where you deposit a fixed sum of money every month over a predetermined tenure. Per Indian Banks' Association (IBA) regulations, commercial banks compound interest on recurring deposits on a <strong>quarterly basis</strong>.
        </p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Because contributions happen monthly while interest compounds quarterly, each monthly installment earns interest for the precise number of months it remains deposited until the maturity date:
        </p>

        <!-- Formula block -->
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">M = &Sigma;<sub>i=1</sub><sup>N</sup> [ P &times; (1 + r / 4)<sup>4 &times; (N &minus; i + 1) / 12</sup> ]</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">M</strong> &mdash; Total maturity value at the end of the tenure</li>
            <li><strong class="text-text-primary">P</strong> &mdash; Fixed monthly installment amount</li>
            <li><strong class="text-text-primary">r</strong> &mdash; Annual nominal interest rate expressed as a decimal (e.g. 0.07 for 7.0%)</li>
            <li><strong class="text-text-primary">N</strong> &mdash; Total number of monthly installments (e.g. 60 months for 5 years)</li>
            <li><strong class="text-text-primary">i</strong> &mdash; The installment sequence index (from 1 to N)</li>
          </ul>
        </div>
      </section>

      <!-- 2. Step-by-Step Worked Example -->
      <section aria-labelledby="rd-calculator-example">
        <h2 id="rd-calculator-example" class="text-xl font-bold text-text-primary mb-4">Worked example: ₹5,000 monthly for 5 years (60 months) at 7.0%</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an individual opening an RD account with a monthly contribution of ₹5,000 at a fixed 7.0% annual interest rate for 5 years:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 text-sm text-text-muted space-y-2">
          <p><strong class="text-text-primary">1. Monthly deposit (P):</strong> ₹5,000</p>
          <p><strong class="text-text-primary">2. Number of installments (N):</strong> 60 months (5 years)</p>
          <p><strong class="text-text-primary">3. Cumulative principal invested:</strong> 60 &times; ₹5,000 = <strong class="text-text-primary">₹3,00,000</strong></p>
          <p><strong class="text-text-primary">4. Quarterly compounding mechanics:</strong> The 1st installment compounds across all 20 quarters; the 30th installment compounds for 10 quarters; the 60th installment compounds for 1 month.</p>
          <p><strong class="text-text-primary">5. Total maturity corpus:</strong> <strong class="text-text-primary text-accent">₹3,61,746</strong></p>
          <p><strong class="text-text-primary">6. Total interest earned:</strong> ₹3,61,746 &minus; ₹3,00,000 = <strong class="text-text-primary text-accent">₹61,746</strong> (an effective 20.6% total return on deposited capital)</p>
        </div>
      </section>

      <!-- 3. Interpreting Your Results -->
      <section aria-labelledby="rd-calculator-interpretation">
        <h2 id="rd-calculator-interpretation" class="text-xl font-bold text-text-primary mb-4">Interpreting your results</h2>
        <div class="space-y-3 text-sm text-text-muted leading-relaxed">
          <p>
            <strong class="text-text-primary">Guaranteed Capital and Returns:</strong> Unlike equity SIPs where maturity values depend on market cycles and sequence of returns, bank Recurring Deposits offer guaranteed capital protection and fixed interest rates locked at account inception. In India, bank deposits are insured up to ₹5,00,000 per depositor per bank by DICGC.
          </p>
          <p>
            <strong class="text-text-primary">Tax Drag on Real Yield:</strong> RD interest is categorized as "Income from Other Sources" and taxed at your marginal income tax slab. For individuals in the 30% slab, a 7.0% nominal return yields an effective post-tax return of approximately ~4.9%, which may trail inflation.
          </p>
        </div>
      </section>

      <!-- 4. Key Assumptions and Limitations -->
      <section aria-labelledby="rd-calculator-assumptions">
        <h2 id="rd-calculator-assumptions" class="text-xl font-bold text-text-primary mb-4">Key assumptions and limitations</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-text-muted leading-relaxed">
          <li>
            <strong class="text-text-primary">Quarterly Compounding Standard:</strong> Calculation follows the standard Indian Banks' Association (IBA) quarterly compounding schedule.
          </li>
          <li>
            <strong class="text-text-primary">Prompt Installment Payments:</strong> Assumes every monthly installment is paid on the exact due date without default or payment delay penalties.
          </li>
          <li>
            <strong class="text-text-primary">Fixed Interest Rate:</strong> The interest rate remains uniform throughout the entire contracted duration.
          </li>
          <li>
            <strong class="text-text-primary">TDS Excluded:</strong> Displays gross pre-tax maturity value. Banks deduct 10% TDS (with PAN) if total interest earned across deposits in a financial year exceeds ₹40,000 (₹50,000 for senior citizens).
          </li>
        </ul>
      </section>

      <!-- 5. Frequently Asked Questions -->
      <section aria-labelledby="rd-calculator-faq">
        <h2 id="rd-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            ['Can I change my monthly RD installment amount?', 'In standard recurring deposits with commercial banks and post offices, the monthly installment amount is fixed at account opening. Some specialized digital banks offer flexible RD accounts where contributions can vary.'],
            ['Is Recurring Deposit interest taxable in India?', 'Yes. RD interest is fully taxable as "Income from Other Sources" at your applicable income tax slab rate. TDS applies if total annual interest across all deposits with a banking entity exceeds ₹40,000 (₹50,000 for senior citizens).'],
            ['How is interest compounded on a Recurring Deposit?', 'Per Indian Banks\' Association (IBA) guidelines, commercial banks compound RD interest quarterly. Each monthly installment earns interest compounded quarterly for its respective remaining tenure until maturity.'],
            ['What happens if I miss an RD monthly installment?', 'Banks usually levy a nominal penalty (e.g. ₹1.50 to ₹2.00 per ₹100 per month) for missed installments. If installments remain unpaid for consecutive months (typically 4 to 6 months), the bank may prematurely deactivate the account.'],
            ['Can I withdraw funds prematurely from an RD account?', 'Yes, premature closure is permitted by most banks, but it typically incurs a penalty of 0.5% to 1% reduction from the applicable interest rate for the period the deposit actually ran.'],
          ].map(([q, a]) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{q}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="rd-calculator-related">
        <h2 id="rd-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';
  import { calcRD } from '../lib/calculators/rd';

  function calcRDClient(p: number, rate: number, months: number) {
    const r = rate / 100;
    let maturity = 0;
    for (let i = 0; i < months; i++) {
      const remainingMonths = months - i;
      maturity += p * Math.pow(1 + r / 4, (remainingMonths / 12) * 4);
    }
    const invested = p * months;
    const gain = maturity - invested;
    return {
      maturity,
      invested,
      gain,
      gainPct: invested > 0 ? (gain / invested) * 100 : 0,
      principalFraction: maturity > 0 ? invested / maturity : 0,
      gainFraction: maturity > 0 ? gain / maturity : 0,
    };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initRDCalc() {
    if ((window as any).__cmRDBound) return;
    (window as any).__cmRDBound = true;

    const mInput = document.getElementById('rd-monthly') as HTMLInputElement | null;
    const rInput = document.getElementById('rd-rate') as HTMLInputElement | null;
    const yInput = document.getElementById('rd-months') as HTMLInputElement | null;

    const mSlider = document.getElementById('rd-monthly-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('rd-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('rd-months-slider') as HTMLInputElement | null;

    const resMaturity = document.getElementById('rd-result-maturity');
    const resInvested = document.getElementById('rd-result-invested');
    const resGain = document.getElementById('rd-result-gain');
    const resGainPct = document.getElementById('rd-result-gain-pct');

    const errAlert = document.getElementById('rd-error-alert');
    const errMsg = document.getElementById('rd-error-msg');

    if (!mInput || !rInput || !yInput) return;

    const DEFAULTS = { monthly: 5000, rate: 7.0, months: 60 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawM = mInput!.value.replace(/[^0-9.]/g, '');
      const rawR = rInput!.value.replace(/[^0-9.]/g, '');
      const rawMo = yInput!.value.replace(/[^0-9.]/g, '');

      const vM = validate(rawM, { required: true, min: 100, label: 'Monthly Installment' });
      const vR = validate(rawR, { required: true, min: 0.1, max: 25, decimal: true, label: 'Interest Rate' });
      const vMo = validate(rawMo, { required: true, min: 1, max: 240, integer: true, label: 'Tenure in Months' });

      if (!vM.valid) { showError(vM.error!.message); return; }
      if (!vR.valid) { showError(vR.error!.message); return; }
      if (!vMo.valid) { showError(vMo.error!.message); return; }
      clearError();

      const m = vM.value!;
      const r = vR.value!;
      const mo = vMo.value!;

      const res = calcRDClient(m, r, mo);

      setResult({
        heroValue: fmtVal(res.maturity),
        heroLabel: 'Maturity Value',
        rows: [
          { label: 'Total Invested', value: fmtVal(res.invested) },
          { label: 'Interest Earned', value: fmtVal(res.gain) },
          { label: 'Return on Investment', value: res.gainPct.toFixed(1) + '%' },
        ],
      });

      if (resMaturity) resMaturity.textContent = fmtVal(res.maturity);
      if (resInvested) resInvested.textContent = fmtVal(res.invested);
      if (resGain) resGain.textContent = fmtVal(res.gain);
      if (resGainPct) resGainPct.textContent = res.gainPct.toFixed(1) + '%';

      const wrapper = document.getElementById('rd-composition-wrapper');
      if (wrapper && res.maturity > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.invested);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.gain);
      }

      history.replaceState(null, '', serializeHash({ m, r, mo }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(mSlider, mInput, true);
    sync(rSlider, rInput, false);
    sync(ySlider, yInput, false);

    document.getElementById('rd-calculate')?.addEventListener('click', recalc);
    document.getElementById('rd-reset')?.addEventListener('click', () => {
      mInput.value = fmtLiveInput(String(DEFAULTS.monthly));
      rInput.value = String(DEFAULTS.rate);
      yInput.value = String(DEFAULTS.months);
      if (mSlider) {
        mSlider.value = String(DEFAULTS.monthly);
        mSlider.style.setProperty('--slider-pct', `${((DEFAULTS.monthly - 500) / (100000 - 500)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 3) / (12 - 3)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.months);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.months - 6) / (120 - 6)) * 100}%`);
      }
      clearError();
      recalc();
      mInput.focus();
    });

    [mInput, rInput, yInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('rd-copy-btn')?.addEventListener('click', async () => {
      const rawM = mInput.value.replace(/[^0-9.]/g, '');
      const rawR = rInput.value.replace(/[^0-9.]/g, '');
      const rawMo = yInput.value.replace(/[^0-9.]/g, '');

      const vM = validate(rawM, { required: true, min: 100, label: 'M' });
      const vR = validate(rawR, { required: true, min: 0.1, label: 'R' });
      const vMo = validate(rawMo, { required: true, min: 1, label: 'Mo' });

      if (!vM.valid || !vR.valid || !vMo.valid) return;

      const res = calcRDClient(vM.value!, vR.value!, vMo.value!);
      const text = `Recurring Deposit: ${fmtVal(vM.value!)}/mo for ${vMo.value} months at ${vR.value}% p.a. gives maturity of ${fmtVal(res.maturity)} (invested: ${fmtVal(res.invested)}, interest: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('rd-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('rd-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('rd-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      m: { required: true, min: 100, label: 'm' },
      r: { required: true, min: 0.1, max: 25, decimal: true, label: 'r' },
      mo: { required: true, min: 1, max: 240, integer: true, label: 'mo' },
    });
    if (restored.valid && restored.values.m && restored.values.r !== undefined && restored.values.mo) {
      mInput.value = fmtLiveInput(String(restored.values.m));
      rInput.value = String(restored.values.r);
      yInput.value = String(restored.values.mo);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initRDCalc();
  document.addEventListener('astro:page-load', initRDCalc);
</script>
