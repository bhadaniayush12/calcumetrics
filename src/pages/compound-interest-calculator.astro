---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { TOOLS } from '../config/site';

const related = TOOLS.filter((t) => t.category === 'Investments' && t.slug !== 'compound-interest-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/compound-interest-calculator';
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'Compound Interest Calculator', url: canonicalUrl, description: 'Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' }, { '@type': 'ListItem', position: 3, name: 'Compound Interest Calculator' }] }] };
---
<Layout title="Compound Interest Calculator: Formula & Results | Calcumetrics" description="Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="Compound Interest Calculator" category="Investments" categoryHref="/investments" heroValue="₹2,15,892" heroLabel="Future Value">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Compound Interest Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding.</p>
      <Alert variant="info" title="Assumption">Results are estimates for information only. Not financial advice.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" type="button">Calculate</Button><Button variant="ghost" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Future Value</span>
        <div class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">₹2,15,892</div>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="compound-interest-calculator-how">
        <h2 id="compound-interest-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted">A = P × (1 + r/n)^(n×t) — same as lump sum. P=principal, r=annual rate, n=compounding periods/year, t=years.</p>
        </div>
      </section>
      <section aria-labelledby="compound-interest-calculator-faq">
        <h2 id="compound-interest-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is compound interest?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Compound interest is interest calculated on both the initial principal and the accumulated interest from previous periods. Unlike simple interest (which is only on principal), compounding accelerates growth — especially over long horizons. Einstein reportedly called it the eighth wonder of the world, though that quote is apocryphal.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the difference between nominal and effective annual rate?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">The nominal rate is the stated annual rate (e.g. 8%). The effective annual rate (EAR) accounts for compounding frequency: EAR = (1 + r/n)^n − 1. For 8% compounded quarterly, EAR = (1.02)⁴ − 1 = 8.243%. This calculator uses the nominal rate and specified compounding frequency.</div></details>
        </div>
      </section>
      <section aria-labelledby="compound-interest-calculator-related">
        <h2 id="compound-interest-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
