---
/**
 * Compound Interest Calculator — /compound-interest-calculator
 * Phase 5.2: Full Phase 4 architecture integration.
 *
 * Section 12 fixture: ₹1,00,000, 8% annual, 10 yrs → ₹2,15,892.50
 * Formula: A = P × (1 + r/n)^(n×t)
 *
 * Architecture:
 *   - CalculatorType.Advanced (multi-input, derived metrics, composition bar)
 *   - Centralized validation via validate.ts
 *   - Canonical result state via result-bus.ts setResult()
 *   - URL hash state via url-state.ts serializeHash/restoreFromHash
 */

import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { CalculatorType } from '../lib/calculator-types';
import { calcLumpSum } from '../lib/calculators/lumpsum';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 8, years: 10, frequency: 'annually' as const };
const result = calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, DEFAULT.frequency);
// Frequency comparison for the FAQ, from the engine (same principal, rate and term).
const byFreq = {
  annually: calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'annually').maturity,
  quarterly: calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'quarterly').maturity,
  monthly: calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'monthly').maturity,
  daily: calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'daily').maturity,
};
const fmtR = (n: number) => '₹' + formatIndian(Math.round(n));

const exampleMoney = (n: number) => '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const monthlyYear = calcLumpSum(DEFAULT.principal, DEFAULT.rate, 1, 'monthly');

const fmt = (n: number) => '₹' + formatIndian(n);

const RELATED_SLUGS = ['future-value-calculator', 'sip-calculator', 'simple-interest-calculator'];
const related = RELATED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://calcumetrics.com/compound-interest-calculator';
const faqs = [
  { question: "What is compound interest?", answer: "Compound interest adds earned interest to your balance so that later interest is calculated on both your original deposit and the interest already credited. Simple interest is calculated only on the original principal." },
  { question: "How do you calculate compound interest?", answer: "For one deposit, use A = P × (1 + r/n)^(n × t). P is the starting amount, r is the annual rate as a decimal, n is the number of compounding periods per year and t is the number of years. Interest earned is A minus P." },
  { question: "Is daily compounding better than monthly compounding?", answer: "For the same positive nominal annual rate and term, daily compounding gives a slightly higher balance because interest is added more often. Compare rates on the same basis: an effective annual yield already includes the effect of compounding." },
  { question: "Can I calculate compound interest with monthly contributions?", answer: "This calculator models one initial deposit. Monthly contributions need a separate calculation because each deposit has a different time to grow. Use the linked SIP calculator to model regular monthly investments; do not add all future deposits to the opening balance." },
  { question: "How long does compound interest take to double money?", answer: "The Rule of 72 estimates doubling time as 72 divided by the annual percentage return. It is an approximation. Use the calculator with your chosen rate and frequency to compare balances over different terms; an assumed investment return is not guaranteed." }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Compound Interest Calculator',
      url: canonicalUrl,
      description: 'Free compound interest calculator. Apply the compound interest formula: A = P(1+r/n)^(nt) with daily, monthly, and annual compounding options.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-10-19',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Compound Interest Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<Layout
  title="Compound Interest Calculator: Daily, Monthly & Yearly"
  description="Calculate future value and interest earned. Compare daily, monthly and yearly compounding with a worked example, formula and clear assumptions."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Compound Interest Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.maturity)}
    heroLabel="Future Value"
    calcType={CalculatorType.Advanced}
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Compound Interest Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Use this compound interest calculator to find the future value and interest earned with daily, monthly, quarterly, semi-annual or annual compounding.</p>

      <!-- Principal -->
      <div class="mb-5">
        <Input
          id="ci-principal"
          label="Initial Investment (Principal)"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Starting investment amount"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-principal-slider" min={5000} max={10000000} step={5000} value={100000} ariaLabel="Principal amount slider" />
        </div>
      </div>

      <!-- Annual Rate -->
      <div class="mb-5">
        <Input
          id="ci-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="8"
          isNumeric={true}
          helperText="Nominal annual interest rate"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-rate-slider" min={1} max={30} step={0.25} value={8} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-5">
        <Input
          id="ci-years"
          label="Investment Tenure"
          suffix="Years"
          value="10"
          isNumeric={true}
          helperText="Duration of compounding"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-years-slider" min={1} max={40} step={1} value={10} ariaLabel="Investment tenure slider" />
        </div>
      </div>

      <!-- Compounding Frequency -->
      <div class="mb-6">
        <Dropdown
          id="ci-frequency"
          label="Compounding Frequency"
          options={[
            { value: 'annually', label: 'Annually (Once a year)' },
            { value: 'semi-annually', label: 'Semi-Annually (Twice a year)' },
            { value: 'quarterly', label: 'Quarterly (4 times a year)' },
            { value: 'monthly', label: 'Monthly (12 times a year)' },
            { value: 'daily', label: 'Daily (365 times a year)' },
          ]}
          value="annually"
          helperText="How often interest is compounded onto principal"
        />
      </div>

      <Alert variant="info" title="Compounding Rule">
        More frequent compounding increases the effective yield. For example, monthly compounding at {DEFAULT.rate}% gives an effective annual rate of {monthlyYear.gainPct.toFixed(2)}%.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="ci-calculate" type="button">Calculate Compound Growth</Button>
        <Button variant="ghost" id="ci-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Future Value</span>
        <div id="ci-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Initial Principal</span>
          <span id="ci-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest Earned</span>
          <span id="ci-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.gain)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Return</span>
          <span id="ci-result-gainpct" class="text-sm font-medium tabular-nums text-dark-text">{result.gainPct.toFixed(1)}%</span>
        </div>
      </div>

      <div class="mb-5" id="ci-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.gainFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(DEFAULT.principal)}
          gainValue={fmt(result.gain)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="ci-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="ci-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <p class="text-sm text-text-muted leading-relaxed mb-4">A compound interest calculator estimates how one deposit grows when earned interest stays invested. Enter the starting amount, annual rate, time and compounding frequency to see the future balance and interest earned. The estimate assumes the same rate throughout and excludes tax, fees and inflation.</p><section aria-labelledby="ci-formula">
        <h2 id="ci-formula" class="text-xl font-bold text-text-primary mb-4">Compound interest formula</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">For a single deposit, the compound interest formula is:</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">A = P × (1 + r / n)<sup>n × t</sup></p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong>P</strong>: initial deposit; <strong>A</strong>: final balance.</li>
            <li><strong>r</strong>: nominal annual rate as a decimal, so 8% is 0.08.</li>
            <li><strong>n</strong>: periods per year; <strong>t</strong>: years invested.</li>
            <li><strong>Interest earned</strong> = A − P.</li>
          </ul>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The daily compound interest formula uses n = 365; monthly uses 12, quarterly 4, semi-annual 2 and annual 1. These are this calculator’s conventions. Check the product’s accrual rules before comparing a bank statement with the estimate.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">An effective annual rate is (1 + r/n)<sup>n</sup> − 1. For the example’s {DEFAULT.rate}% nominal rate, monthly compounding gives {monthlyYear.gainPct.toFixed(2)}% over one year. <a href="https://www.investor.gov/additional-resources/information/youth/teachers-classroom-resources/what-compound-interest" class="text-accent font-medium hover:underline">Investor.gov explains why interest on accumulated interest grows the balance</a>.</p>
      </section>

      <section aria-labelledby="ci-example">
        <h2 id="ci-example" class="text-xl font-bold text-text-primary mb-4">Worked example: one deposit over ten years</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Assume a {exampleMoney(DEFAULT.principal)} deposit earns {DEFAULT.rate}% a year, compounded annually, for {DEFAULT.years} years. The rate is an illustration, not a current savings or investment offer.</p>
        <div class="bg-surface border border-border rounded-card p-5 space-y-3 text-sm text-text-muted">
          <p>1. Annual compounding means one interest credit per year.</p>
          <p>2. The growth factor is (1 + {DEFAULT.rate} / 100)<sup>{DEFAULT.years}</sup> = {(result.maturity / result.principal).toFixed(6)}.</p>
          <p>3. Multiply the deposit by that factor: the final balance is <strong class="text-text-primary">{exampleMoney(result.maturity)}</strong>.</p>
          <p>4. Subtract the original deposit: interest earned is <strong class="text-text-primary">{exampleMoney(result.gain)}</strong>, a total return of {result.gainPct.toFixed(2)}%.</p>
        </div>
      </section>

      <section aria-labelledby="ci-frequency-comparison">
        <h2 id="ci-frequency-comparison" class="text-xl font-bold text-text-primary mb-4">Daily, monthly, quarterly or annual compounding?</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Same illustrative deposit, nominal rate and term as the worked example; no additional deposits</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Frequency</th><th scope="col" class="text-left py-2.5 px-3">Final balance</th><th scope="col" class="text-left py-2.5 px-3">Interest earned</th></tr></thead>
          <tbody>{Object.entries(byFreq).map(([frequency, maturity]) => (
          <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">{frequency}</td><td class="py-2.5 px-3 text-text-primary">{exampleMoney(maturity)}</td><td class="py-2.5 px-3 text-text-primary">{exampleMoney(maturity - DEFAULT.principal)}</td></tr>
        ))}</tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Monthly compounding adds {exampleMoney(byFreq.monthly - byFreq.annually)} to the final balance compared with annual compounding under these assumptions. More frequent compounding has no benefit if interest is withdrawn instead of reinvested.</p>
      </section>

      <section aria-labelledby="ci-contributions">
        <h2 id="ci-contributions" class="text-xl font-bold text-text-primary mb-4">Compound interest with monthly contributions</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">A monthly contribution earns for fewer periods when it is deposited later. This page’s one-deposit formula cannot model that by adding all future deposits to the principal.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Use the <a href="/sip-calculator" class="text-accent font-medium hover:underline">SIP calculator for monthly investments</a> to model regular contributions, or the <a href="/savings-goal-calculator" class="text-accent font-medium hover:underline">savings goal calculator</a> to work out the monthly amount needed after allowing for existing savings. <a href="https://www.investor.gov/financial-tools-calculators/calculators/compound-interest-calculator" class="text-accent font-medium hover:underline">Investor.gov’s calculator</a> has separate inputs for an initial investment and monthly contributions.</p>
      </section>

      <section aria-labelledby="ci-assumptions">
        <h2 id="ci-assumptions" class="text-xl font-bold text-text-primary mb-4">What the result assumes</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The example keeps the rate constant, reinvests every interest credit and makes no further deposits or withdrawals. It excludes taxes, charges and changes in purchasing power. Market-linked returns vary, so a smooth projection does not predict the path of an investment.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">For rate terminology, read <a href="/blog/apr-vs-apy-compounding-frequency" class="text-accent font-medium hover:underline">APR vs APY and compounding frequency</a>. To compare a non-compounding calculation, use the <a href="/simple-interest-calculator" class="text-accent font-medium hover:underline">simple interest calculator</a>.</p>
      </section>

      <section aria-labelledby="ci-faq">
        <h2 id="ci-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.question}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{faq.answer}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="ci-related">
        <h2 id="ci-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a data-currency-lock={tool.path.startsWith('/in/') ? 'INR' : undefined} href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  /**
   * Compound Interest Calculator — Phase 5.2 client-side logic.
   *
   * Architecture:
   *   - Centralized validation via validate() from src/lib/validate.ts
   *   - URL hash state via serializeHash() / restoreFromHash() / readCurrentHash() / updateHash() from src/lib/url-state.ts
   *   - Canonical result state via setResult() from src/lib/result-bus.ts
   *   - Pure calculation via calcLumpSum() from src/lib/calculators/lumpsum.ts
   *   - CalculatorLayout subscriber handles mobile hero updates automatically
   */

  import { validate, type ValidationRules } from '../lib/validate';

  import { moneyRules } from '../lib/currency';
  import { parseSmartInput } from '../lib/formatters';
  import { serializeHash, restoreFromHash, readCurrentHash, updateHash } from '../lib/url-state';
  import { setResult } from '../lib/result-bus';
  import { calcLumpSum, type CompoundFrequency } from '../lib/calculators/lumpsum';
  import { getStoredCurrency, CURRENCY_CONFIG } from '../lib/currency';

  // ── Currency state ──────────────────────────────────────────────────────────
  let currSym = '₹';
  let currLocale = 'en-IN';

  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtLiveInput(raw: string | number) {
    const num = parseSmartInput(raw, currLocale === 'de-DE' ? 'EUR' : undefined);
    return num === null || isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 2 }).format(num);
  }

  // ── Validation schema (Phase 4.3 Centralized Engine) ────────────────────────
  const CI_RULES: Record<'principal' | 'rate' | 'years', ValidationRules> = {
    principal: moneyRules({ required: true, min: 100, max: 100_000_000, decimal: false, negativeAllowed: false, label: 'Principal' }),
    rate: { required: true, min: 0.01, max: 100, decimal: true, negativeAllowed: false, label: 'Interest Rate' },
    years: { required: true, min: 1, max: 50, integerOnly: true, negativeAllowed: false, label: 'Tenure' },
  };

  const HASH_SCHEMA: Record<'p' | 'r' | 'y', ValidationRules> = {
    p: CI_RULES.principal,
    r: CI_RULES.rate,
    y: CI_RULES.years,
  };

  // Valid compounding frequencies
  const VALID_FREQUENCIES = new Set<CompoundFrequency>(['annually', 'semi-annually', 'quarterly', 'monthly', 'daily']);

  // ── Field validation visual feedback ───────────────────────────────────────
  function setFieldError(id: string, error?: string) {
    const input = document.getElementById(id) as HTMLInputElement | null;
    const helper = document.getElementById(`${id}-helper`);
    const container = input?.closest('.rounded-control');
    if (error) {
      input?.setAttribute('aria-invalid', 'true');
      if (container) {
        container.classList.add('border-error-border', 'bg-error-bg', 'text-error-text');
        container.classList.remove('border-border');
      }
      if (helper) {
        helper.textContent = error;
        helper.classList.add('text-error-text');
        helper.classList.remove('text-text-muted');
        helper.setAttribute('role', 'alert');
      }
    } else {
      input?.removeAttribute('aria-invalid');
      if (container) {
        container.classList.remove('border-error-border', 'bg-error-bg', 'text-error-text');
        container.classList.add('border-border');
      }
      if (helper) {
        if (id === 'ci-principal') helper.textContent = 'Starting investment amount';
        else if (id === 'ci-rate') helper.textContent = 'Nominal annual interest rate';
        else if (id === 'ci-years') helper.textContent = 'Duration of compounding';
        helper.classList.remove('text-error-text');
        helper.classList.add('text-text-muted');
        helper.removeAttribute('role');
      }
    }
  }

  // ── Main initialization ─────────────────────────────────────────────────────
  function initCICalc() {
    const pInput = document.getElementById('ci-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('ci-rate') as HTMLInputElement | null;
    const yInput = document.getElementById('ci-years') as HTMLInputElement | null;
    const fSelect = document.getElementById('ci-frequency') as HTMLSelectElement | null;
    const pSlider = document.getElementById('ci-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('ci-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('ci-years-slider') as HTMLInputElement | null;

    if (!pInput || !rInput || !yInput) return;

    try {
      const code = getStoredCurrency();
      const cfg = CURRENCY_CONFIG[code] || CURRENCY_CONFIG.INR;
      currSym = cfg.symbol;
      currLocale = cfg.locale;
    } catch (e) {}
    document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
      el.textContent = currSym;
    });

    if (pInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    pInput.dataset.bound = 'true';

    const DEFAULTS = { principal: 100000, rate: 8, years: 10, frequency: 'annually' as CompoundFrequency };
    let timer: ReturnType<typeof setTimeout>;

    function recalc() {
      // ── Phase 4.3: Centralized validation engine ──────────────────────
      const isEur = currLocale === 'de-DE';
      const numP = parseSmartInput(pInput.value, isEur ? 'EUR' : undefined);
      const numR = parseSmartInput(rInput.value, isEur ? 'EUR' : undefined);
      const numY = parseSmartInput(yInput.value, isEur ? 'EUR' : undefined);

      const pResult = validate(numP ?? pInput.value, CI_RULES.principal);
      const rResult = validate(numR ?? rInput.value, CI_RULES.rate);
      const yResult = validate(numY ?? yInput.value, CI_RULES.years);

      setFieldError('ci-principal', pResult.valid ? undefined : pResult.error.message);
      setFieldError('ci-rate', rResult.valid ? undefined : rResult.error.message);
      setFieldError('ci-years', yResult.valid ? undefined : yResult.error.message);

      if (!pResult.valid || !rResult.valid || !yResult.valid) return;
      if (pResult.value === undefined || rResult.value === undefined || yResult.value === undefined) return;

      const p = pResult.value;
      const r = rResult.value;
      const y = yResult.value;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';

      const res = calcLumpSum(p, r, y, f);

      // ── Phase 4.2: Canonical result state (single source of truth) ─────
      // Desktop DOM updates via fields mapping; Mobile hero updated automatically
      setResult({
        heroValue: fmtVal(res.maturity),
        heroLabel: 'Future Value',
        rows: [
          { label: 'Initial Principal', value: fmtVal(p) },
          { label: 'Total Interest Earned', value: fmtVal(res.gain), variant: 'accent' },
          { label: 'Total Return', value: res.gainPct.toFixed(1) + '%' },
        ],
        fields: {
          'ci-result-maturity': fmtVal(res.maturity),
          'ci-result-principal': fmtVal(p),
          'ci-result-gain': fmtVal(res.gain),
          'ci-result-gainpct': res.gainPct.toFixed(1) + '%',
        },
      });

      const resMatEl = document.getElementById('ci-result-maturity');
      if (resMatEl) resMatEl.textContent = fmtVal(res.maturity);
      const resPrincEl = document.getElementById('ci-result-principal');
      if (resPrincEl) resPrincEl.textContent = fmtVal(p);
      const resGainEl = document.getElementById('ci-result-gain');
      if (resGainEl) resGainEl.textContent = fmtVal(res.gain);
      const resGainPctEl = document.getElementById('ci-result-gainpct');
      if (resGainPctEl) resGainPctEl.textContent = res.gainPct.toFixed(1) + '%';

      // ── Composition bar update (visual sub-component) ──────────────────
      const wrapper = document.getElementById('ci-composition-wrapper');
      if (wrapper) {
        const bar = (wrapper.querySelector('[data-comp-bar="principal"]') || wrapper.querySelector('[class*="bg-dark-muted"]')) as HTMLElement | null;
        const gainBar = (wrapper.querySelector('[data-comp-bar="gain"]') || wrapper.querySelector('[class*="bg-dark-accent"]')) as HTMLElement | null;
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legP = wrapper.querySelector<HTMLElement>('[data-comp-legend="principal"]') || wrapper.querySelectorAll('[class*="tabular-nums"]')[0];
        const legG = wrapper.querySelector<HTMLElement>('[data-comp-legend="gain"]') || wrapper.querySelectorAll('[class*="tabular-nums"]')[1];
        if (legP) legP.textContent = fmtVal(p);
        if (legG) legG.textContent = fmtVal(res.gain);
      }

      // ── Phase 4.4: URL hash state via shared utility ───────────────────
// Option B: hash updated on Share click only
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    // ── Slider ↔ Input sync ─────────────────────────────────────────────────
    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        debounce();
      });
      input.addEventListener('blur', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num)) {
          input.value = isFormatted ? fmtLiveInput(num) : String(num);
          recalc();
        }
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(ySlider, yInput, false);
    fSelect?.addEventListener('change', recalc);

    // ── Calculate & Reset ───────────────────────────────────────────────────
    document.getElementById('ci-calculate')?.addEventListener('click', () => {
      recalc();
      if (window.innerWidth < 1024) {
        document.getElementById('calc-mobile-bar')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    document.getElementById('ci-reset')?.addEventListener('click', () => {
      setFieldError('ci-principal');
      setFieldError('ci-rate');
      setFieldError('ci-years');
      pInput.value = fmtLiveInput(DEFAULTS.principal);
      rInput.value = String(DEFAULTS.rate);
      yInput.value = String(DEFAULTS.years);
      if (fSelect) fSelect.value = DEFAULTS.frequency;
      if (pSlider) {
        pSlider.value = String(DEFAULTS.principal);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 5000) / (10000000 - 5000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (30 - 1)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.years);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (40 - 1)) * 100}%`);
      }
      // Clear hash on reset via shared url-state utility

      recalc();
      pInput.focus();
    });

    [pInput, rInput, yInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // ── Phase 4.4: Restore from URL hash via shared utility ──────────────────
    const currentHash = readCurrentHash();
    if (currentHash) {
      const restored = restoreFromHash(currentHash, HASH_SCHEMA);
      let hashRestored = false;

      if (restored.values.p !== undefined) {
        pInput.value = fmtLiveInput(restored.values.p);
        if (pSlider) {
          const clamped = Math.min(Math.max(restored.values.p, 5000), 10000000);
          pSlider.value = String(clamped);
          pSlider.style.setProperty('--slider-pct', `${((clamped - 5000) / (10000000 - 5000)) * 100}%`);
        }
        hashRestored = true;
      }
      if (restored.values.r !== undefined) {
        rInput.value = String(restored.values.r);
        if (rSlider) {
          const clamped = Math.min(Math.max(restored.values.r, 1), 30);
          rSlider.value = String(clamped);
          rSlider.style.setProperty('--slider-pct', `${((clamped - 1) / (30 - 1)) * 100}%`);
        }
        hashRestored = true;
      }
      if (restored.values.y !== undefined) {
        yInput.value = String(restored.values.y);
        if (ySlider) {
          const clamped = Math.min(Math.max(restored.values.y, 1), 40);
          ySlider.value = String(clamped);
          ySlider.style.setProperty('--slider-pct', `${((clamped - 1) / (40 - 1)) * 100}%`);
        }
        hashRestored = true;
      }
      const rawFreq = restored.raw['f'];
      if (rawFreq && VALID_FREQUENCIES.has(rawFreq as CompoundFrequency) && fSelect) {
        fSelect.value = rawFreq;
        hashRestored = true;
      }
    }

    recalc();

    // ── Copy & Share ────────────────────────────────────────────────────────
    async function flashBtn(btn: HTMLElement, label: string) {
      const orig = btn.textContent;
      btn.textContent = label;
      await new Promise((r) => setTimeout(r, 2000));
      btn.textContent = orig;
    }

    document.getElementById('ci-copy-btn')?.addEventListener('click', async () => {
      const pRes = validate(pInput.value, CI_RULES.principal);
      const rRes = validate(rInput.value, CI_RULES.rate);
      const yRes = validate(yInput.value, CI_RULES.years);
      if (!pRes.valid || !rRes.valid || !yRes.valid) return;
      const p = pRes.value!, r = rRes.value!, y = yRes.value!;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';
      const res = calcLumpSum(p, r, y, f);
      const text = `Compound Interest: ${fmtVal(p)} at ${r}% for ${y} years (${f}) grows to ${fmtVal(res.maturity)} (gain: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(document.getElementById('ci-copy-btn')!, 'Copied!');
    });

    document.getElementById('ci-share-btn')?.addEventListener('click', async () => {
      const pRes = validate(pInput.value, CI_RULES.principal);
      const rRes = validate(rInput.value, CI_RULES.rate);
      const yRes = validate(yInput.value, CI_RULES.years);
      if (!pRes.valid || !rRes.valid || !yRes.valid) return;
      const p = pRes.value!, r = rRes.value!, y = yRes.value!;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';
      const hash = serializeHash({ f, p, r, y });
      const url = `${location.href.split('#')[0]}${hash}`;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(document.getElementById('ci-share-btn')!, 'Copied Link!');
    });

    // ── Currency synchronization ────────────────────────────────────────────
    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
          el.textContent = currSym;
        });
        if (pInput && pInput.value) {
          pInput.value = fmtLiveInput(pInput.value);
        }
        recalc();
      }
    });
  }

  initCICalc();
  document.addEventListener('astro:page-load', initCICalc);
</script>
