---
/**
 * Compound Interest Calculator — /compound-interest-calculator
 * Phase 5.2: Full Phase 4 architecture integration.
 *
 * Section 12 fixture: ₹1,00,000, 8% annual, 10 yrs → ₹2,15,892.50
 * Formula: A = P × (1 + r/n)^(n×t)
 *
 * Architecture:
 *   - CalculatorType.Advanced (multi-input, derived metrics, composition bar)
 *   - Centralized validation via validate.ts
 *   - Canonical result state via result-bus.ts setResult()
 *   - URL hash state via url-state.ts serializeHash/restoreFromHash
 */

import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { CalculatorType } from '../lib/calculator-types';
import { calcLumpSum } from '../lib/calculators/lumpsum';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 8, years: 10, frequency: 'annually' as const };
const result = calcLumpSum(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, DEFAULT.frequency);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Investments' && t.slug !== 'compound-interest-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/compound-interest-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Compound Interest Calculator',
      url: canonicalUrl,
      description: 'Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Compound Interest Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the difference between simple and compound interest?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Simple interest is calculated only on the initial principal amount. Compound interest is calculated on both the principal and all accumulated interest from preceding periods. Over longer periods, compound interest grows much faster due to the snowball effect.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the effective annual rate (EAR)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'EAR = (1 + r/n)^n − 1. It represents the true annual rate you earn when compounding happens more frequently than once a year. For example, 8% compounded monthly gives an EAR of about 8.30%.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does compounding frequency affect returns?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'More frequent compounding yields higher returns because interest is added to the principal more often, creating a larger base for the next period. Daily compounding produces slightly more than monthly, which produces more than quarterly, and so on.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the Rule of 72?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Rule of 72 is a quick estimation: divide 72 by the annual interest rate to approximate how many years it takes to double your money with compound interest. At 8% annual compounding, your money approximately doubles in 72 ÷ 8 = 9 years.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is the compound interest result guaranteed?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. This calculator provides a mathematical estimate based on a constant assumed rate. Actual returns from market-linked instruments vary. Fixed deposits offer guaranteed rates, but market-linked investments do not. The result is for information only and is not financial advice.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Compound Interest Calculator: Formula & Results | Calcumetrics"
  description="Calculate compound interest for any principal, rate, time, and compounding frequency. Works for annual, quarterly, or monthly compounding."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Compound Interest Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.maturity)}
    heroLabel="Future Value"
    calcType={CalculatorType.Advanced}
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Compound Interest Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the future value and interest earned with flexible compounding frequencies.</p>

      <!-- Principal -->
      <div class="mb-5">
        <Input
          id="ci-principal"
          label="Initial Investment (Principal)"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Starting investment amount"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-principal-slider" min={5000} max={10000000} step={5000} value={100000} ariaLabel="Principal amount slider" />
        </div>
      </div>

      <!-- Annual Rate -->
      <div class="mb-5">
        <Input
          id="ci-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="8"
          isNumeric={true}
          helperText="Nominal annual interest rate"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-rate-slider" min={1} max={30} step={0.25} value={8} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-5">
        <Input
          id="ci-years"
          label="Investment Tenure"
          suffix="Years"
          value="10"
          isNumeric={true}
          helperText="Duration of compounding"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="ci-years-slider" min={1} max={40} step={1} value={10} ariaLabel="Investment tenure slider" />
        </div>
      </div>

      <!-- Compounding Frequency -->
      <div class="mb-6">
        <Dropdown
          id="ci-frequency"
          label="Compounding Frequency"
          options={[
            { value: 'annually', label: 'Annually (Once a year)' },
            { value: 'semi-annually', label: 'Semi-Annually (Twice a year)' },
            { value: 'quarterly', label: 'Quarterly (4 times a year)' },
            { value: 'monthly', label: 'Monthly (12 times a year)' },
            { value: 'daily', label: 'Daily (365 times a year)' },
          ]}
          value="annually"
          helperText="How often interest is compounded onto principal"
        />
      </div>

      <Alert variant="info" title="Compounding Rule">
        More frequent compounding increases the effective yield. For example, monthly compounding on 8% yields an effective annual rate of 8.30%.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="ci-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="ci-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Future Value</span>
        <div id="ci-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Initial Principal</span>
          <span id="ci-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest Earned</span>
          <span id="ci-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.gain)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Return</span>
          <span id="ci-result-gainpct" class="text-sm font-medium tabular-nums text-dark-text">{result.gainPct.toFixed(1)}%</span>
        </div>
      </div>

      <div class="mb-5" id="ci-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.gainFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(DEFAULT.principal)}
          gainValue={fmt(result.gain)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="ci-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="ci-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- 1. Formula -->
      <section aria-labelledby="ci-formula">
        <h2 id="ci-formula" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Compound interest is calculated using the exponential growth formula where interest earned in each period is added to the principal balance for the next period:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">A = P × (1 + r / n)<sup>n × t</sup></p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">A</strong> — Final maturity amount (future value)</li>
            <li><strong class="text-text-primary">P</strong> — Initial principal balance</li>
            <li><strong class="text-text-primary">r</strong> — Annual nominal interest rate (as a decimal, e.g. 0.08 for 8%)</li>
            <li><strong class="text-text-primary">n</strong> — Number of times interest is compounded per year</li>
            <li><strong class="text-text-primary">t</strong> — Number of years</li>
          </ul>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          The total interest earned is <strong class="text-text-primary">A − P</strong>. The effective annual rate (EAR) is <span class="font-mono">(1 + r/n)<sup>n</sup> − 1</span>, which shows the true annual yield accounting for compounding frequency.
        </p>
      </section>

      <!-- 2. Worked Example -->
      <section aria-labelledby="ci-example">
        <h2 id="ci-example" class="text-xl font-bold text-text-primary mb-4">Worked example</h2>
        <div class="bg-surface border border-border rounded-card p-5">
          <p class="text-sm text-text-muted leading-relaxed mb-3">
            <strong class="text-text-primary">Given:</strong> P = ₹1,00,000, r = 8% (0.08), n = 1 (annual), t = 10 years
          </p>
          <div class="space-y-2 text-sm text-text-muted leading-relaxed">
            <p><strong class="text-text-primary">Step 1:</strong> Calculate the growth factor</p>
            <p class="font-mono pl-4">(1 + 0.08 / 1)<sup>1 × 10</sup> = 1.08<sup>10</sup> = 2.15892</p>
            <p><strong class="text-text-primary">Step 2:</strong> Calculate the future value</p>
            <p class="font-mono pl-4">A = 1,00,000 × 2.15892 = ₹2,15,892</p>
            <p><strong class="text-text-primary">Step 3:</strong> Calculate interest earned</p>
            <p class="font-mono pl-4">Interest = ₹2,15,892 − ₹1,00,000 = ₹1,15,892</p>
            <p><strong class="text-text-primary">Step 4:</strong> Calculate total return</p>
            <p class="font-mono pl-4">Return = (₹1,15,892 / ₹1,00,000) × 100 = 115.9%</p>
          </div>
          <p class="text-sm text-text-muted leading-relaxed mt-3">
            If the same investment were compounded <strong class="text-text-primary">monthly</strong> instead of annually, the future value would be ₹2,21,964 — an additional ₹6,072 from more frequent compounding.
          </p>
        </div>
      </section>

      <!-- 3. Assumptions -->
      <section aria-labelledby="ci-assumptions">
        <h2 id="ci-assumptions" class="text-xl font-bold text-text-primary mb-4">Assumptions</h2>
        <ul class="space-y-2 text-sm text-text-muted leading-relaxed list-disc pl-5">
          <li>The interest rate remains constant throughout the investment period.</li>
          <li>Interest is reinvested at the same rate — no withdrawals during the tenure.</li>
          <li>The calculation does not account for taxes on interest earned, fees, or inflation.</li>
          <li>Compounding occurs at the selected frequency (annually, semi-annually, quarterly, monthly, or daily).</li>
        </ul>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Confused about nominal rates vs. compounding frequencies?</strong>
        Read our in-depth guide on <a href="/blog/apr-vs-apy-compounding-frequency" class="text-accent font-medium hover:underline">APR vs. APY: Why Compounding Frequency Changes Your Real Interest Rate</a> to see mathematical proofs, frequency tables, and disclosure traps across loans and savings products.
      </div>

      <!-- 4. FAQ -->
      <section aria-labelledby="ci-faq">
        <h2 id="ci-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the difference between simple and compound interest?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Simple interest is calculated only on the initial principal amount. Compound interest is calculated on both the principal and all accumulated interest from preceding periods. Over longer periods, compound interest grows much faster due to the snowball effect. For example, ₹1,00,000 at 8% for 10 years earns ₹80,000 with simple interest but ₹1,15,892 with annual compound interest.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the effective annual rate (EAR)?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              EAR = (1 + r/n)<sup>n</sup> − 1. It represents the true annual rate you earn when compounding happens more frequently than once a year. For example, a nominal rate of 8% compounded monthly gives an EAR of approximately 8.30%, meaning you effectively earn 8.30% per year rather than 8%.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How does compounding frequency affect returns?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              More frequent compounding yields higher returns because interest is added to the principal more often, creating a larger base for the next period. For ₹1,00,000 at 8% over 10 years: annual compounding gives ₹2,15,893, quarterly gives ₹2,20,804, monthly gives ₹2,21,964, and daily gives ₹2,22,535. The difference between annual and daily compounding is ₹6,643 — significant over larger amounts and longer periods.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the Rule of 72?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              The Rule of 72 is a quick estimation method: divide 72 by the annual interest rate to approximate how many years it takes to double your money with compound interest. At 8% annual compounding, your money approximately doubles in 72 ÷ 8 = 9 years. The exact answer (using the formula) is 9.006 years, making the Rule of 72 remarkably accurate for typical interest rates.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Is the compound interest result guaranteed?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              No. This calculator provides a mathematical estimate based on a constant assumed rate. Fixed deposits and government bonds offer guaranteed rates, but market-linked instruments (mutual funds, equities) fluctuate and actual returns may differ substantially. The result is for educational and planning purposes only, not financial advice.
            </div>
          </details>
        </div>
      </section>

      <!-- 5. Related calculators -->
      <section aria-labelledby="ci-related">
        <h2 id="ci-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  /**
   * Compound Interest Calculator — Phase 5.2 client-side logic.
   *
   * Architecture:
   *   - Centralized validation via validate() from src/lib/validate.ts
   *   - URL hash state via serializeHash() / restoreFromHash() / readCurrentHash() / updateHash() from src/lib/url-state.ts
   *   - Canonical result state via setResult() from src/lib/result-bus.ts
   *   - Pure calculation via calcLumpSum() from src/lib/calculators/lumpsum.ts
   *   - CalculatorLayout subscriber handles mobile hero updates automatically
   */

  import { validate, type ValidationRules } from '../lib/validate';
  import { serializeHash, restoreFromHash, readCurrentHash, updateHash } from '../lib/url-state';
  import { setResult } from '../lib/result-bus';
  import { calcLumpSum, type CompoundFrequency } from '../lib/calculators/lumpsum';

  // ── Currency state ──────────────────────────────────────────────────────────
  let currSym = '₹';
  let currLocale = 'en-IN';

  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  // ── Validation schema (Phase 4.3 Centralized Engine) ────────────────────────
  const CI_RULES: Record<'principal' | 'rate' | 'years', ValidationRules> = {
    principal: { required: true, min: 100, max: 100_000_000, decimal: false, negativeAllowed: false, label: 'Principal' },
    rate: { required: true, min: 0.01, max: 100, decimal: true, negativeAllowed: false, label: 'Interest Rate' },
    years: { required: true, min: 1, max: 50, integerOnly: true, negativeAllowed: false, label: 'Tenure' },
  };

  // URL Hash state schema mapping (Phase 4.4 URL State Engine)
  const HASH_SCHEMA: Record<'p' | 'r' | 'y', ValidationRules> = {
    p: CI_RULES.principal,
    r: CI_RULES.rate,
    y: CI_RULES.years,
  };

  // Valid compounding frequencies
  const VALID_FREQUENCIES = new Set<CompoundFrequency>(['annually', 'semi-annually', 'quarterly', 'monthly', 'daily']);

  // ── Field validation visual feedback ───────────────────────────────────────
  function setFieldError(id: string, error?: string) {
    const input = document.getElementById(id) as HTMLInputElement | null;
    const helper = document.getElementById(`${id}-helper`);
    const container = input?.closest('.rounded-control');
    if (error) {
      input?.setAttribute('aria-invalid', 'true');
      if (container) {
        container.classList.add('border-error-border', 'bg-error-bg', 'text-error-text');
        container.classList.remove('border-border');
      }
      if (helper) {
        helper.textContent = error;
        helper.classList.add('text-error-text');
        helper.classList.remove('text-text-muted');
        helper.setAttribute('role', 'alert');
      }
    } else {
      input?.removeAttribute('aria-invalid');
      if (container) {
        container.classList.remove('border-error-border', 'bg-error-bg', 'text-error-text');
        container.classList.add('border-border');
      }
      if (helper) {
        if (id === 'ci-principal') helper.textContent = 'Starting investment amount';
        else if (id === 'ci-rate') helper.textContent = 'Nominal annual interest rate';
        else if (id === 'ci-years') helper.textContent = 'Duration of compounding';
        helper.classList.remove('text-error-text');
        helper.classList.add('text-text-muted');
        helper.removeAttribute('role');
      }
    }
  }

  // ── Main initialization ─────────────────────────────────────────────────────
  function initCICalc() {
    const pInput = document.getElementById('ci-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('ci-rate') as HTMLInputElement | null;
    const yInput = document.getElementById('ci-years') as HTMLInputElement | null;
    const fSelect = document.getElementById('ci-frequency') as HTMLSelectElement | null;
    const pSlider = document.getElementById('ci-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('ci-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('ci-years-slider') as HTMLInputElement | null;

    if (!pInput || !rInput || !yInput) return;

    const DEFAULTS = { principal: 100000, rate: 8, years: 10, frequency: 'annually' as CompoundFrequency };
    let timer: ReturnType<typeof setTimeout>;

    function recalc() {
      // ── Phase 4.3: Centralized validation engine ──────────────────────
      const pResult = validate(pInput.value, CI_RULES.principal);
      const rResult = validate(rInput.value, CI_RULES.rate);
      const yResult = validate(yInput.value, CI_RULES.years);

      setFieldError('ci-principal', pResult.valid ? undefined : pResult.error.message);
      setFieldError('ci-rate', rResult.valid ? undefined : rResult.error.message);
      setFieldError('ci-years', yResult.valid ? undefined : yResult.error.message);

      if (!pResult.valid || !rResult.valid || !yResult.valid) return;
      if (pResult.value === undefined || rResult.value === undefined || yResult.value === undefined) return;

      const p = pResult.value;
      const r = rResult.value;
      const y = yResult.value;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';

      const res = calcLumpSum(p, r, y, f);

      // ── Phase 4.2: Canonical result state (single source of truth) ─────
      // Desktop DOM updates via fields mapping; Mobile hero updated automatically
      setResult({
        heroValue: fmtVal(res.maturity),
        heroLabel: 'Future Value',
        rows: [
          { label: 'Initial Principal', value: fmtVal(p) },
          { label: 'Total Interest Earned', value: fmtVal(res.gain), variant: 'accent' },
          { label: 'Total Return', value: res.gainPct.toFixed(1) + '%' },
        ],
        fields: {
          'ci-result-maturity': fmtVal(res.maturity),
          'ci-result-principal': fmtVal(p),
          'ci-result-gain': fmtVal(res.gain),
          'ci-result-gainpct': res.gainPct.toFixed(1) + '%',
        },
      });

      // ── Composition bar update (visual sub-component) ──────────────────
      const wrapper = document.getElementById('ci-composition-wrapper');
      if (wrapper) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(p);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.gain);
      }

      // ── Phase 4.4: URL hash state via shared utility ───────────────────
      updateHash(serializeHash({ f, p, r, y }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    // ── Slider ↔ Input sync ─────────────────────────────────────────────────
    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(ySlider, yInput, false);
    fSelect?.addEventListener('change', recalc);

    // ── Calculate & Reset ───────────────────────────────────────────────────
    document.getElementById('ci-calculate')?.addEventListener('click', () => {
      recalc();
      if (window.innerWidth < 1024) {
        document.getElementById('calc-mobile-bar')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    document.getElementById('ci-reset')?.addEventListener('click', () => {
      setFieldError('ci-principal');
      setFieldError('ci-rate');
      setFieldError('ci-years');
      pInput.value = fmtLiveInput(String(DEFAULTS.principal));
      rInput.value = String(DEFAULTS.rate);
      yInput.value = String(DEFAULTS.years);
      if (fSelect) fSelect.value = DEFAULTS.frequency;
      if (pSlider) {
        pSlider.value = String(DEFAULTS.principal);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 5000) / (10000000 - 5000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (30 - 1)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.years);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (40 - 1)) * 100}%`);
      }
      // Clear hash on reset via shared url-state utility
      updateHash('');
      recalc();
      pInput.focus();
    });

    [pInput, rInput, yInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // ── Phase 4.4: Restore from URL hash via shared utility ──────────────────
    const currentHash = readCurrentHash();
    if (currentHash) {
      const restored = restoreFromHash(currentHash, HASH_SCHEMA);
      let hashRestored = false;

      if (restored.values.p !== undefined) {
        pInput.value = fmtLiveInput(String(restored.values.p));
        if (pSlider) {
          const clamped = Math.min(Math.max(restored.values.p, 5000), 10000000);
          pSlider.value = String(clamped);
          pSlider.style.setProperty('--slider-pct', `${((clamped - 5000) / (10000000 - 5000)) * 100}%`);
        }
        hashRestored = true;
      }
      if (restored.values.r !== undefined) {
        rInput.value = String(restored.values.r);
        if (rSlider) {
          const clamped = Math.min(Math.max(restored.values.r, 1), 30);
          rSlider.value = String(clamped);
          rSlider.style.setProperty('--slider-pct', `${((clamped - 1) / (30 - 1)) * 100}%`);
        }
        hashRestored = true;
      }
      if (restored.values.y !== undefined) {
        yInput.value = String(restored.values.y);
        if (ySlider) {
          const clamped = Math.min(Math.max(restored.values.y, 1), 40);
          ySlider.value = String(clamped);
          ySlider.style.setProperty('--slider-pct', `${((clamped - 1) / (40 - 1)) * 100}%`);
        }
        hashRestored = true;
      }
      const rawFreq = restored.raw['f'];
      if (rawFreq && VALID_FREQUENCIES.has(rawFreq as CompoundFrequency) && fSelect) {
        fSelect.value = rawFreq;
        hashRestored = true;
      }

      if (hashRestored) recalc();
    }

    // ── Copy & Share ────────────────────────────────────────────────────────
    async function flashBtn(btn: HTMLElement, label: string) {
      const orig = btn.textContent;
      btn.textContent = label;
      await new Promise((r) => setTimeout(r, 2000));
      btn.textContent = orig;
    }

    document.getElementById('ci-copy-btn')?.addEventListener('click', async () => {
      const pRes = validate(pInput.value, CI_RULES.principal);
      const rRes = validate(rInput.value, CI_RULES.rate);
      const yRes = validate(yInput.value, CI_RULES.years);
      if (!pRes.valid || !rRes.valid || !yRes.valid) return;
      const p = pRes.value!, r = rRes.value!, y = yRes.value!;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';
      const res = calcLumpSum(p, r, y, f);
      const text = `Compound Interest: ${fmtVal(p)} at ${r}% for ${y} years (${f}) grows to ${fmtVal(res.maturity)} (gain: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(document.getElementById('ci-copy-btn')!, 'Copied!');
    });

    document.getElementById('ci-share-btn')?.addEventListener('click', async () => {
      const pRes = validate(pInput.value, CI_RULES.principal);
      const rRes = validate(rInput.value, CI_RULES.rate);
      const yRes = validate(yInput.value, CI_RULES.years);
      if (!pRes.valid || !rRes.valid || !yRes.valid) return;
      const p = pRes.value!, r = rRes.value!, y = yRes.value!;
      const freqRaw = fSelect ? fSelect.value : 'annually';
      const f: CompoundFrequency = VALID_FREQUENCIES.has(freqRaw as CompoundFrequency)
        ? (freqRaw as CompoundFrequency)
        : 'annually';
      const hash = serializeHash({ f, p, r, y });
      const url = `${location.href.split('#')[0]}${hash}`;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(document.getElementById('ci-share-btn')!, 'Copied Link!');
    });

    // ── Currency synchronization ────────────────────────────────────────────
    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initCICalc();
  document.addEventListener('astro:page-load', initCICalc);
</script>
