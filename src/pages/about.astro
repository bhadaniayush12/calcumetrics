---
import Layout from '../layouts/Layout.astro';
import { getToolCount, CATEGORIES, SITE_EMAIL } from '../config/site';

const canonicalUrl = 'https://calcumetrics.com/about';
const toolCount = getToolCount();
const categoryCount = CATEGORIES.length;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      name: 'About Calcumetrics',
      url: canonicalUrl,
      description: 'Learn about Calcumetrics — our story, formula accuracy, client-side privacy, public corrections log, and test-case verification architecture.',
      mainEntity: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        email: 'hello@calcumetrics.com',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout
  title="About Calcumetrics | Our Story, Testing & Mission"
  description="Learn about Calcumetrics — built by two commerce graduates who needed reliable financial calculators without the noise. 100% client-side privacy."
  canonical={canonicalUrl}
  slimFooter={true}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <div class="max-w-[860px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium" aria-current="page">About</li>
      </ol>
    </nav>

    <!-- Page Title & Intro -->
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs font-semibold text-accent mb-3">
        <span>🛡️</span>
        <span>100% Free · No Sign-Up · 100% Client-Side Privacy</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary mb-2.5">
        About Calcumetrics
      </h1>
      <p class="text-base text-text-muted leading-relaxed font-normal max-w-2xl">
        Fast, transparent financial calculation engines built with documented mathematical formulas, zero personal data collection, and verified test fixtures.
      </p>
    </header>

    <!-- macOS Interactive System Settings Window -->
    <section class="bg-surface border border-border rounded-card shadow-mac overflow-hidden mb-12" aria-label="Calcumetrics Preferences Window">
      <!-- Window Title Bar with Functional Traffic Lights -->
      <div class="bg-canvas/90 border-b border-border px-4 py-3 flex items-center justify-between select-none">
        <div class="flex items-center gap-2">
          <!-- Red: Close / Reset -->
          <button
            type="button"
            id="traffic-dot-red"
            class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E] hover:opacity-80 transition-standard cursor-pointer relative group"
            aria-label="Reset tabs"
            title="Reset to Overview tab"
          >
            <span class="opacity-0 group-hover:opacity-100 absolute -top-7 left-1/2 -translate-x-1/2 bg-dark-bg text-dark-text text-[10px] font-medium px-1.5 py-0.5 rounded shadow pointer-events-none whitespace-nowrap transition-standard">
              Reset view
            </span>
          </button>
          <!-- Yellow: Minimize -->
          <button
            type="button"
            id="traffic-dot-yellow"
            class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123] hover:opacity-80 transition-standard cursor-pointer relative group"
            aria-label="Minimize preview"
            title="Minimize"
          >
            <span class="opacity-0 group-hover:opacity-100 absolute -top-7 left-1/2 -translate-x-1/2 bg-dark-bg text-dark-text text-[10px] font-medium px-1.5 py-0.5 rounded shadow pointer-events-none whitespace-nowrap transition-standard">
              Minimize
            </span>
          </button>
          <!-- Green: Zoom / Expand -->
          <button
            type="button"
            id="traffic-dot-green"
            class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29] hover:opacity-80 transition-standard cursor-pointer relative group"
            aria-label="Expand view"
            title="Zoom"
          >
            <span class="opacity-0 group-hover:opacity-100 absolute -top-7 left-1/2 -translate-x-1/2 bg-dark-bg text-dark-text text-[10px] font-medium px-1.5 py-0.5 rounded shadow pointer-events-none whitespace-nowrap transition-standard">
              Zoom
            </span>
          </button>
        </div>

        <div class="text-xs font-semibold text-text-muted flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          <span>Calcumetrics — System Settings</span>
        </div>

        <div class="text-[11px] text-text-muted font-mono hidden sm:block">
          v2.4 · Sep 2026
        </div>
      </div>

      <!-- System Settings Tab Bar -->
      <div class="bg-canvas/50 border-b border-border px-3 py-2 flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs">
        <button
          type="button"
          data-about-tab="overview"
          class="about-tab-btn px-3 py-1.5 rounded-control font-semibold bg-surface text-accent shadow-sm border border-border/80 transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>👤</span>
          <span>Overview &amp; Story</span>
        </button>
        <button
          type="button"
          data-about-tab="testing"
          class="about-tab-btn px-3 py-1.5 rounded-control font-medium text-text-muted hover:text-text-primary hover:bg-canvas transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>📐</span>
          <span>How We Test (Worked Proofs)</span>
        </button>
        <button
          type="button"
          data-about-tab="money"
          class="about-tab-btn px-3 py-1.5 rounded-control font-medium text-text-muted hover:text-text-primary hover:bg-canvas transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>🛡️</span>
          <span>Money &amp; Ethics</span>
        </button>
        <button
          type="button"
          data-about-tab="corrections"
          class="about-tab-btn px-3 py-1.5 rounded-control font-medium text-text-muted hover:text-text-primary hover:bg-canvas transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>📝</span>
          <span>Corrections Log</span>
        </button>
      </div>

      <!-- Tab Content Area -->
      <div class="p-6 sm:p-8" id="about-tab-content">

        <!-- TAB 1: OVERVIEW & FOUNDER STORY -->
        <div id="tab-panel-overview" class="space-y-8">
          <!-- Founder Origin Story Card (5-6 lines emotional connection) -->
          <div class="p-5 sm:p-6 bg-canvas/70 border border-border rounded-card">
            <div class="flex items-center gap-2 text-xs font-semibold text-accent uppercase tracking-wider mb-2">
              <span>💡</span>
              <span>Why This Exists</span>
            </div>
            <h2 class="text-xl font-bold text-text-primary mb-3">
              The Origin: Two Commerce Friends &amp; Broken Calculators
            </h2>
            <p class="text-[15px] text-text-primary leading-relaxed mb-3">
              Calcumetrics started with two college friends — Dev and Yuvraj — who spent their commerce years jumping between ad-cluttered websites every time they needed a reliable formula. Each site had something wrong: hidden logic, outdated tax slabs, or a layout that broke on mobile the moment it mattered most.
            </p>
            <p class="text-[15px] text-text-muted leading-relaxed">
              One night, deep in semester projects, we hit a wall. <em>"Why doesn't a clean, honest calculator site exist?"</em> So we built one. Calcumetrics is that tool — a place where commerce students, CA aspirants, and everyday investors can get exact numbers instantly, without a lead form, a popup, or a paywall.
            </p>
          </div>

          <!-- Co-Founders Profile -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Dev -->
            <div class="flex items-start gap-4 p-5 bg-surface border border-border rounded-card">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/30 flex items-center justify-center text-accent text-xl font-bold shrink-0 shadow-sm">
                D
              </div>
              <div class="flex-1">
                <h3 class="text-base font-bold text-text-primary">Dev</h3>
                <p class="text-xs text-text-muted mb-2">Co-founder &middot; Calcumetrics</p>
                <p class="text-xs text-text-muted leading-relaxed">Commerce background. Focuses on formula architecture, statutory accuracy, and making financial math accessible to everyone.</p>
                <a href={`mailto:${SITE_EMAIL}`} class="inline-flex items-center gap-1 text-xs mt-2 text-accent hover:underline">
                  ✉️ {SITE_EMAIL}
                </a>
              </div>
            </div>
            <!-- Yuvraj -->
            <div class="flex items-start gap-4 p-5 bg-surface border border-border rounded-card">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/30 flex items-center justify-center text-accent text-xl font-bold shrink-0 shadow-sm">
                Y
              </div>
              <div class="flex-1">
                <h3 class="text-base font-bold text-text-primary">Yuvraj</h3>
                <p class="text-xs text-text-muted mb-2">Co-founder &middot; Calcumetrics</p>
                <p class="text-xs text-text-muted leading-relaxed">Commerce background. Leads UX, content strategy, and ensures every calculator solves a real user problem without friction.</p>
                <a href={`mailto:${SITE_EMAIL}`} class="inline-flex items-center gap-1 text-xs mt-2 text-accent hover:underline">
                  ✉️ {SITE_EMAIL}
                </a>
              </div>
            </div>
          </div>

          <!-- 4-Stat Trust Bar -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="p-4 bg-canvas border border-border rounded-control text-center">
              <span class="text-2xl font-extrabold text-text-primary tabular-nums block">{toolCount}+</span>
              <span class="text-xs text-text-muted font-medium">Precision Calculators</span>
            </div>
            <div class="p-4 bg-canvas border border-border rounded-control text-center">
              <span class="text-2xl font-extrabold text-text-primary tabular-nums block">{categoryCount}</span>
              <span class="text-xs text-text-muted font-medium">Core Financial Hubs</span>
            </div>
            <div class="p-4 bg-canvas border border-border rounded-control text-center">
              <span class="text-2xl font-extrabold text-accent tabular-nums block">100%</span>
              <span class="text-xs text-text-muted font-medium">Client-Side Privacy</span>
            </div>
            <div class="p-4 bg-canvas border border-border rounded-control text-center">
              <span class="text-2xl font-extrabold text-accent tabular-nums block">0</span>
              <span class="text-xs text-text-muted font-medium">Server Data Stored</span>
            </div>
          </div>

          <!-- Audience & Values -->
          <div>
            <h3 class="text-base font-bold text-text-primary mb-2">Built Specifically For</h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Calcumetrics is engineered for <strong>commerce students, CA aspirants, finance professionals, and everyday investors</strong> who need dependable numbers fast. No login walls, no email gates, no sales reps calling you after you calculate your mortgage or tax liability.
            </p>
          </div>
        </div>

        <!-- TAB 2: HOW WE TEST (WORKED PROOFS) -->
        <div id="tab-panel-testing" class="hidden space-y-6">
          <div>
            <h2 class="text-xl font-bold text-text-primary mb-2">
              Public Test Fixtures: Tested Against Worked Examples
            </h2>
            <p class="text-sm text-text-muted leading-relaxed">
              Every calculator on Calcumetrics is tested with continuous automated unit tests against worked examples, statutory formulas, and verified mathematical benchmarks.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Fixture 1: SIP -->
            <div class="p-4 bg-canvas border border-border rounded-control text-xs">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-text-primary text-sm">1. SIP Compound Annuity</span>
                <span class="text-emerald-700 dark:text-emerald-400 font-semibold">✓ Tested</span>
              </div>
              <p class="text-text-muted mb-2 font-mono text-[11px]">
                FV = P × [((1 + i)^n − 1) / i] × (1 + i)
              </p>
              <div class="bg-surface p-2.5 rounded border border-border space-y-1 text-text-muted">
                <div><strong>Inputs:</strong> ₹25,000/mo, 12% p.a., 15 Years</div>
                <div><strong>Invested:</strong> ₹45,00,000</div>
                <div class="text-text-primary font-bold">Maturity: ₹1,26,14,400</div>
              </div>
            </div>

            <!-- Fixture 2: EMI -->
            <div class="p-4 bg-canvas border border-border rounded-control text-xs">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-text-primary text-sm">2. Loan EMI (Reducing Balance)</span>
                <span class="text-emerald-700 dark:text-emerald-400 font-semibold">✓ Tested</span>
              </div>
              <p class="text-text-muted mb-2 font-mono text-[11px]">
                EMI = P × r × (1 + r)^n / [(1 + r)^n − 1]
              </p>
              <div class="bg-surface p-2.5 rounded border border-border space-y-1 text-text-muted">
                <div><strong>Inputs:</strong> ₹50,00,000, 8.5% p.a., 20 Years</div>
                <div><strong>Monthly EMI:</strong> ₹43,391</div>
                <div class="text-text-primary font-bold">Total Interest: ₹54,13,879</div>
              </div>
            </div>

            <!-- Fixture 3: WACC -->
            <div class="p-4 bg-canvas border border-border rounded-control text-xs">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-text-primary text-sm">3. Corporate WACC (CAPM)</span>
                <span class="text-emerald-700 dark:text-emerald-400 font-semibold">✓ Tested</span>
              </div>
              <p class="text-text-muted mb-2 font-mono text-[11px]">
                WACC = (E/V × Ke) + (D/V × Kd × (1 − t))
              </p>
              <div class="bg-surface p-2.5 rounded border border-border space-y-1 text-text-muted">
                <div><strong>Inputs:</strong> Ke=13.5%, Kd=9.0%, Tax=25%, E/D=60/40</div>
                <div><strong>After-tax Debt:</strong> 6.75%</div>
                <div class="text-text-primary font-bold">Blended WACC: 10.80%</div>
              </div>
            </div>

            <!-- Fixture 4: Section 115BAC -->
            <div class="p-4 bg-canvas border border-border rounded-control text-xs">
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-text-primary text-sm">4. New Tax Regime (FY 2025-27)</span>
                <span class="text-emerald-700 dark:text-emerald-400 font-semibold">✓ Tested</span>
              </div>
              <p class="text-text-muted mb-2 font-mono text-[11px]">
                Sec 115BAC + Sec 87A Rebate + ₹75k Standard Deduction
              </p>
              <div class="bg-surface p-2.5 rounded border border-border space-y-1 text-text-muted">
                <div><strong>Gross Salary:</strong> ₹12,75,000</div>
                <div><strong>Taxable Income:</strong> ₹12,00,000</div>
                <div class="text-emerald-700 dark:text-emerald-400 font-bold">Final Tax Payable: ₹0</div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: MONEY & ETHICS -->
        <div id="tab-panel-money" class="hidden space-y-6">
          <div>
            <h2 class="text-xl font-bold text-text-primary mb-2">
              Transparency: How This Site Is Funded
            </h2>
            <p class="text-sm text-text-muted leading-relaxed">
              We believe financial websites should be completely honest about how they make money.
            </p>
          </div>

          <div class="p-5 bg-canvas border border-border rounded-card">
            <h3 class="text-base font-bold text-text-primary mb-2">Monetization Statement</h3>
            <p class="text-sm text-text-primary leading-relaxed mb-3">
              <strong>Calcumetrics is free and supported by clean, relevant advertising.</strong>
            </p>
            <p class="text-sm text-text-muted leading-relaxed">
              We partner with vetted, professional advertising networks to cover domain, hosting, and editorial infrastructure costs. We will never sell user calculation inputs, never gate results behind forced email opt-ins, and never track your browsing behavior across the web.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-4 bg-canvas border border-border rounded-control space-y-1.5">
              <span class="font-bold text-text-primary text-sm block">What We Never Do</span>
              <p class="text-text-muted">❌ Never store your financial numbers on a server</p>
              <p class="text-text-muted">❌ Never require sign-up, email, or phone number</p>
              <p class="text-text-muted">❌ Never run intrusive full-screen popups</p>
              <p class="text-text-muted">❌ Never sell data to credit bureaus or loan brokers</p>
            </div>
            <div class="p-4 bg-canvas border border-border rounded-control space-y-1.5">
              <span class="font-bold text-text-primary text-sm block">What We Guarantee</span>
              <p class="text-text-muted">✅ 100% in-browser JavaScript execution</p>
              <p class="text-text-muted">✅ Fully documented formulas on every page</p>
              <p class="text-text-muted">✅ Immediate calculation on slider/input change</p>
              <p class="text-text-muted">✅ Public test fixtures and quarterly rate audits</p>
            </div>
          </div>
        </div>

        <!-- TAB 4: CORRECTIONS LOG -->
        <div id="tab-panel-corrections" class="hidden space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-text-primary mb-1">
                Public Statutory Corrections Log
              </h2>
              <p class="text-xs text-text-muted">
                Transparent changelog of all statutory rate updates and formula adjustments.
              </p>
            </div>
            <span class="text-xs bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 px-2 py-1 rounded font-semibold">
              Live Audited
            </span>
          </div>

          <div class="relative pl-6 border-l-2 border-border space-y-6 text-xs">
            <!-- Entry 1 (Real First Entry) -->
            <div class="relative">
              <div class="absolute -left-[31px] top-0 w-3.5 h-3.5 rounded-full bg-accent border-2 border-surface"></div>
              <span class="font-bold text-text-primary text-sm block">24 September 2026</span>
              <p class="text-accent font-semibold mt-0.5">Income Tax Rebate Threshold &amp; GST 40% Tier Rectification</p>
              <p class="text-text-muted mt-1 leading-relaxed">
                <strong>Audit finding:</strong> Pre-launch review identified that educational FAQ text on the income tax calculator and analysis posts referenced the outdated ₹7 Lakh rebate (₹7.75 Lakh threshold), and the GST rate schema was missing the 40% luxury/demerit slab.<br />
                <strong>Resolution:</strong> Corrected all editorial and FAQ copy to the statutory Section 87A ₹12 Lakh rebate and ₹12.75 Lakh zero-tax threshold (with ₹75,000 standard deduction). Appended the 40% slab to active GST datasets and updated all verification timestamps.
              </p>
            </div>

            <!-- Entry 2 -->
            <div class="relative">
              <div class="absolute -left-[31px] top-0 w-3.5 h-3.5 rounded-full bg-border border-2 border-surface"></div>
              <span class="font-bold text-text-primary text-sm block">September 2026</span>
              <p class="text-accent font-semibold mt-0.5">GST 2.0 Reform Implementation</p>
              <p class="text-text-muted mt-1 leading-relaxed">
                Upgraded Indian GST calculator from former 5/12/18/28% slabs to the restructured 0%, 5%, 18%, and 40% luxury/demerit tier. Retained 12% and 28% under legacy reconciliation toggle.
              </p>
            </div>

            <!-- Entry 2 -->
            <div class="relative">
              <div class="absolute -left-[31px] top-0 w-3.5 h-3.5 rounded-full bg-border border-2 border-surface"></div>
              <span class="font-bold text-text-primary text-sm block">July 2026</span>
              <p class="text-accent font-semibold mt-0.5">Income Tax Slabs &amp; Sec 87A Rebate Verification</p>
              <p class="text-text-muted mt-1 leading-relaxed">
                Confirmed Section 115BAC statutory schedule for FY 2025-27: ₹75,000 standard deduction verified, full rebate up to ₹12 Lakh taxable income, yielding ₹0 net tax for gross salary up to ₹12.75 Lakh.
              </p>
            </div>

            <!-- Entry 3 -->
            <div class="relative">
              <div class="absolute -left-[31px] top-0 w-3.5 h-3.5 rounded-full bg-border border-2 border-surface"></div>
              <span class="font-bold text-text-primary text-sm block">May 2026</span>
              <p class="text-accent font-semibold mt-0.5">Capital Gains Tax Rationalization</p>
              <p class="text-text-muted mt-1 leading-relaxed">
                Standardized Indian equity LTCG at 12.5% (exemption threshold ₹1.25 Lakh) and STCG under Section 111A at 20% across all relevant equity tools and blog articles.
              </p>
            </div>

            <!-- Entry 4 -->
            <div class="relative">
              <div class="absolute -left-[31px] top-0 w-3.5 h-3.5 rounded-full bg-border border-2 border-surface"></div>
              <span class="font-bold text-text-primary text-sm block">April 2026</span>
              <p class="text-accent font-semibold mt-0.5">Terminal Value Formula Damodaran Alignment</p>
              <p class="text-text-muted mt-1 leading-relaxed">
                Verified perpetual Gordon Growth Model assumptions in DCF engine against McKinsey Valuation guidelines and NYU Stern benchmarks.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- "Also Built By Us" Section (Point 5) -->
    <section class="mb-12 p-6 bg-surface border border-border rounded-card" aria-label="Also Built By Us">
      <div class="flex items-center gap-2 text-xs font-semibold text-text-muted uppercase tracking-wider mb-2">
        <span>🛠️</span>
        <span>Independent Operator Portfolio</span>
      </div>
      <h2 class="text-lg font-bold text-text-primary mb-2">
        Also Built By Us
      </h2>
      <p class="text-xs text-text-muted mb-4 max-w-xl">
        We build focused, high-utility web tools that solve everyday problems without bloat or tracking.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-1 gap-4">
        <!-- Sister Project Card 1: FixTheSpeaker -->
        <a
          href="https://fixthespeaker.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-canvas hover:bg-surface border border-border hover:border-accent rounded-control transition-standard flex items-start gap-3.5 group cursor-pointer"
        >
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0 text-xl font-bold group-hover:scale-105 transition-standard">
            🔊
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5 font-bold text-sm text-text-primary group-hover:text-accent transition-standard">
              <span>FixTheSpeaker.com</span>
              <span class="text-xs text-text-muted">&nearr;</span>
            </div>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">
              Clean browser tool generating precision sine-wave sound frequencies to clear water and dust trapped in smartphone speakers.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- Bottom Actionable CTAs (Point 8: No Dead End) -->
