  <!-- Interactive Tabs and Traffic Light script -->
  <script>
    function initAboutTabs() {
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.about-tab-btn');
      const panels: Record<string, HTMLElement | null> = {
        overview: document.getElementById('tab-panel-overview'),
        testing: document.getElementById('tab-panel-testing'),
        money: document.getElementById('tab-panel-money'),
        corrections: document.getElementById('tab-panel-corrections'),
      };

      function switchTab(targetTab: string) {
        tabBtns.forEach((btn) => {
          const tab = btn.getAttribute('data-about-tab');
          if (tab === targetTab) {
            btn.className = 'about-tab-btn px-3 py-1.5 rounded-control font-semibold bg-surface text-accent shadow-sm border border-border/80 transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
          } else {
            btn.className = 'about-tab-btn px-3 py-1.5 rounded-control font-medium text-text-muted hover:text-text-primary hover:bg-canvas transition-standard cursor-pointer flex items-center gap-1.5 whitespace-nowrap';
          }
        });

        Object.keys(panels).forEach((k) => {
          const p = panels[k];
          if (p) {
            if (k === targetTab) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          }
        });
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-about-tab') || 'overview';
          switchTab(tab);
        });
      });

      // Traffic Light buttons
      const redBtn = document.getElementById('traffic-dot-red');
      const yellowBtn = document.getElementById('traffic-dot-yellow');
      const greenBtn = document.getElementById('traffic-dot-green');

      redBtn?.addEventListener('click', () => {
        switchTab('overview');
        window.__cmShowToast?.({ title: 'System Settings', message: 'Tabs reset to Overview' });
      });

      yellowBtn?.addEventListener('click', () => {
        const content = document.getElementById('about-tab-content');
        if (content) {
          content.classList.toggle('hidden');
          const isHidden = content.classList.contains('hidden');
          window.__cmShowToast?.({
            title: 'System Settings',
            message: isHidden ? 'Window minimized' : 'Window restored',
          });
        }
      });

      greenBtn?.addEventListener('click', () => {
        switchTab('testing');
        window.__cmShowToast?.({ title: 'System Settings', message: 'Expanded test fixtures' });
      });
    }

    initAboutTabs();
    document.addEventListener('astro:page-load', initAboutTabs);
  </script>
</Layout>
