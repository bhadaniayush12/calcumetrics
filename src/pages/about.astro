  <!-- Interactive Tabs and Traffic Light script -->
  <script>
    function initAboutTabs() {
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.about-tab-btn');
      const panels: Record<string, HTMLElement | null> = {
        overview: document.getElementById('tab-panel-overview'),
        testing: document.getElementById('tab-panel-testing'),
        money: document.getElementById('tab-panel-money'),
        corrections: document.getElementById('tab-panel-corrections'),
      };

      function switchTab(targetTab: string) {
        tabBtns.forEach((btn) => {
          const tab = btn.getAttribute('data-about-tab');
          if (tab === targetTab) {
            btn.className = 'about-tab-btn px-3.5 py-1.5 rounded-control font-semibold bg-surface text-accent shadow-sm border border-border/80 transition-standard cursor-pointer whitespace-nowrap';
          } else {
            btn.className = 'about-tab-btn px-3.5 py-1.5 rounded-control font-medium text-text-muted hover:text-text-primary hover:bg-canvas transition-standard cursor-pointer whitespace-nowrap';
          }
        });

        Object.keys(panels).forEach((k) => {
          const p = panels[k];
          if (p) {
            if (k === targetTab) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          }
        });
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-about-tab') || 'overview';
          switchTab(tab);
        });
      });

      function handleHash() {
        const hash = window.location.hash.replace('#', '').toLowerCase();
        if (hash === 'corrections' || hash === 'corrections-log') {
          switchTab('corrections');
        } else if (hash === 'testing') {
          switchTab('testing');
        } else if (hash === 'money' || hash === 'ethics') {
          switchTab('money');
        } else if (hash === 'overview' || hash === 'story') {
          switchTab('overview');
        }
      }
      handleHash();
      window.addEventListener('hashchange', handleHash);
    }

    initAboutTabs();
    document.addEventListener('astro:page-load', initAboutTabs);
  </script>
</Layout>
