---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcCOGS } from '../lib/calculators/cogs';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = {
  beginning: 150000,
  purchases: 450000,
  labor: 100000,
  overhead: 50000,
  ending: 120000,
  revenue: 950000,
};

const result = calcCOGS(
  DEFAULT.beginning,
  DEFAULT.purchases,
  DEFAULT.labor,
  DEFAULT.overhead,
  DEFAULT.ending,
  DEFAULT.revenue
);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const relatedSlugs = ['profit-margin-calculator', 'inventory-turnover-calculator', 'break-even-calculator'];
const related = TOOLS.filter((t) => relatedSlugs.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/cogs-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Cost of Goods Sold (COGS) Calculator',
      url: canonicalUrl,
      description: 'Apply the cogs formula to calculate Cost of Goods Sold, Goods Available for Sale, Gross Profit, and Gross Profit Margin for retail and manufacturing businesses.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'COGS Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What costs are excluded from COGS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Operating expenses such as sales commissions, marketing and advertising, administrative legal fees, corporate office rent, and corporate executive salaries are operating expenses (OpEx), not direct manufacturing costs, and must be excluded from COGS.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does inventory accounting method impact COGS?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In inflationary environments, FIFO (First-In, First-Out) yields lower COGS and higher reported gross profit, whereas LIFO (Last-In, First-Out) or Weighted Average Cost yields higher COGS and lower taxable income.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is COGS calculated for a service business?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Service companies report Cost of Services (COS), which includes billable employee salaries, contractor fees, and direct software licenses required to deliver client deliverables, with zero physical inventory components.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between direct labor and indirect labor?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Direct labor includes wages of employees directly assembling or fabricating products. Indirect labor includes plant supervisors, maintenance staff, and security guards, which are categorized as factory overhead.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why is ending inventory subtracted in the COGS formula?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the matching principle, costs must be matched to revenues in the period earned. Goods remaining in ending inventory were not sold, so their costs are capitalized on the balance sheet rather than expensed in COGS.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="COGS Formula Calculator: Cost of Goods Sold | Calcumetrics"
  description="Free cogs formula calculator. Compute cost of goods sold formula result, Goods Available for Sale, Gross Profit, and Gross Margin for retail and manufacturing."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Cost of Goods Sold (COGS)"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(result.cogs)}
    heroLabel="Cost of Goods Sold"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Cost of Goods Sold (COGS)</h1>
      <p class="text-sm text-text-muted mb-6">Calculate inventory flow costs and direct production expenses incurred to generate revenue.</p>

      <!-- Error alert -->
      <div id="cogs-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="cogs-error-msg"></span>
      </div>

      <!-- Beginning Inventory -->
      <div class="mb-5">
        <Input
          id="cogs-beginning"
          label="Beginning Inventory (Start of Period)"
          prefix="₹"
          value="1,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Value of stock carried over from prior financial quarter or year"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="cogs-beginning-slider" min={0} max={2000000} step={10000} value={150000} ariaLabel="Beginning inventory slider" />
        </div>
      </div>

      <!-- Purchases -->
      <div class="mb-5">
        <Input
          id="cogs-purchases"
          label="Additional Purchases (Raw Materials / Stock)"
          prefix="₹"
          value="4,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total inventory purchases made during the period"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="cogs-purchases-slider" min={0} max={5000000} step={25000} value={450000} ariaLabel="Purchases slider" />
        </div>
      </div>

      <!-- Direct Labor & Overhead -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
        <div>
          <Input id="cogs-labor" label="Direct Labor" prefix="₹" value="1,00,000" isNumeric={true} localeFormat="indian" helperText="Assembly & manufacturing wages" />
          <div class="mt-2">
            <Slider id="cogs-labor-slider" min={0} max={1000000} step={10000} value={100000} ariaLabel="Direct labor slider" />
          </div>
        </div>
        <div>
          <Input id="cogs-overhead" label="Direct Factory Overhead" prefix="₹" value="50,000" isNumeric={true} localeFormat="indian" helperText="Packaging & plant utilities" />
          <div class="mt-2">
            <Slider id="cogs-overhead-slider" min={0} max={500000} step={5000} value={50000} ariaLabel="Overhead slider" />
          </div>
        </div>
      </div>

      <!-- Ending Inventory & Revenue -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <Input id="cogs-ending" label="Ending Inventory (Physical Count)" prefix="₹" value="1,20,000" isNumeric={true} localeFormat="indian" helperText="Stock remaining at period close" />
          <div class="mt-2">
            <Slider id="cogs-ending-slider" min={0} max={2000000} step={10000} value={120000} ariaLabel="Ending inventory slider" />
          </div>
        </div>
        <div>
          <Input id="cogs-revenue" label="Total Sales Revenue" prefix="₹" value="9,50,000" isNumeric={true} localeFormat="indian" helperText="Gross revenue earned" />
          <div class="mt-2">
            <Slider id="cogs-revenue-slider" min={50000} max={10000000} step={25000} value={950000} ariaLabel="Revenue slider" />
          </div>
        </div>
      </div>

      <Alert variant="info" title="Standard Accounting Rule">
        <strong>COGS = Beginning Inventory + Production Purchases − Ending Inventory</strong>. Indirect general expenses (rent, marketing) are excluded.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="cogs-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="cogs-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Cost of Goods Sold (COGS)</span>
        <div id="cogs-result-hero" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.cogs)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Goods Available for Sale</span>
          <span id="cogs-result-available" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(result.goodsAvailableForSale)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Profit</span>
          <span id="cogs-result-grossprofit" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.grossProfit)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Profit Margin</span>
          <span id="cogs-result-grossmargin" class="text-sm font-bold tabular-nums text-dark-accent">{result.grossMarginPct.toFixed(1)}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Manufacturing Additions</span>
          <span id="cogs-result-additions" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.totalAdditions)}</span>
        </div>
      </div>

      <div class="mb-5" id="cogs-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.revenue > 0 ? result.cogs / DEFAULT.revenue : 0.6}
          gainFraction={DEFAULT.revenue > 0 ? result.grossProfit / DEFAULT.revenue : 0.4}
          principalLabel="COGS"
          gainLabel="Gross Profit"
          principalValue={fmt(result.cogs)}
          gainValue={fmt(result.grossProfit)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cogs-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cogs-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Direct line item deducted from revenue on corporate income statements.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="cogs-calculator-how">
        <h2 id="cogs-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Cost of Goods Sold is calculated</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            Cost of Goods Sold (COGS) measures the direct expenditures incurred to manufacture, purchase, or package products that were successfully sold to customers during an accounting period:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono mb-4">
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Goods Available for Sale</span>
              <span class="text-text-muted">Total Additions = Purchases + Direct Labor + Factory Overhead</span><br />
              <span class="text-accent font-semibold">Available for Sale = Beginning Inventory + Total Additions</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">COGS & Gross Profit</span>
              <span class="text-accent font-semibold">COGS = Goods Available for Sale − Ending Inventory</span><br />
              <span class="text-text-muted">Gross Profit = Sales Revenue − COGS</span><br />
              <span class="text-text-muted">Gross Margin % = (Gross Profit ÷ Sales Revenue) × 100</span>
            </div>
          </div>
          <p class="text-xs text-text-muted leading-relaxed">
            <strong>The Matching Principle:</strong> Under accrual accounting (GAAP &amp; IFRS), inventory costs remain on the balance sheet as an asset until the goods are actually sold, at which point they are expensed on the income statement as COGS to match sales revenue.
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-step worked example</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider a manufacturing business with the default baseline parameters: beginning stock of <strong>₹1,50,000</strong>, raw material purchases of <strong>₹4,50,000</strong>, direct manufacturing wages of <strong>₹1,00,000</strong>, factory overhead of <strong>₹50,000</strong>, ending physical inventory of <strong>₹1,20,000</strong>, and sales revenue of <strong>₹9,50,000</strong>:
        </p>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="py-3 px-4">Cost Flow Step</th>
                <th class="py-3 px-4">Amount</th>
                <th class="py-3 px-4">% of Revenue</th>
                <th class="py-3 px-4">Accounting Function</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">1. Beginning Inventory</td>
                <td class="py-2.5 px-4 font-mono">₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono">15.79%</td>
                <td class="py-2.5 px-4">Unsold inventory carried forward from prior period closing.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">2. Add: Raw Material Purchases</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">+₹4,50,000</td>
                <td class="py-2.5 px-4 font-mono">47.37%</td>
                <td class="py-2.5 px-4">Direct inventory stock and raw components procured.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">3. Add: Direct Labor Wages</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">+₹1,00,000</td>
                <td class="py-2.5 px-4 font-mono">10.53%</td>
                <td class="py-2.5 px-4">Assembly-line workers directly fabricating the product.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">4. Add: Direct Factory Overhead</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">+₹50,000</td>
                <td class="py-2.5 px-4 font-mono">5.26%</td>
                <td class="py-2.5 px-4">Plant machinery electricity, machine lubrication, and packaging.</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-text-primary">5. Goods Available for Sale</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹7,50,000</td>
                <td class="py-2.5 px-4 font-mono text-accent">78.95%</td>
                <td class="py-2.5 px-4">Total pool of physical inventory available for customer shipment.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">6. Less: Ending Physical Inventory</td>
                <td class="py-2.5 px-4 font-mono text-error">−₹1,20,000</td>
                <td class="py-2.5 px-4 font-mono">12.63%</td>
                <td class="py-2.5 px-4">Physical count of unsold finished stock remaining in warehouse.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">7. Cost of Goods Sold (COGS)</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">₹6,30,000</td>
                <td class="py-3 px-4 font-mono text-accent">66.32%</td>
                <td class="py-3 px-4">Direct manufacturing cost of units sold to buyers.</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-text-primary">8. Gross Sales Revenue</td>
                <td class="py-2.5 px-4 font-mono">₹9,50,000</td>
                <td class="py-2.5 px-4 font-mono">100.0%</td>
                <td class="py-2.5 px-4">Total top-line billings from product sales.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">9. Resulting Gross Profit</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">₹3,20,000</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">33.68% Margin</td>
                <td class="py-3 px-4">Available gross contribution to cover SG&amp;A and taxes.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Cost Models: Retail vs. Manufacturing vs. Services</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Retail &amp; Merchandising:</strong> Simple formula: <em>Beginning Inventory + Purchases + Inbound Freight − Ending Inventory</em>. No labor or factory overhead.</li>
              <li><strong>Manufacturing:</strong> Incorporates 3 distinct inventory accounts: Raw Materials, Work-in-Progress (WIP), and Finished Goods, factoring in machine depreciation.</li>
              <li><strong>Professional Services &amp; SaaS:</strong> Reported as <em>Cost of Services (COS)</em> or <em>Cost of Revenue</em>. Includes cloud server hosting (AWS/Azure), third-party API costs, and billable engineering salaries, with zero physical inventory.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Costs That Must Be EXCLUDED From COGS</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              Mistakenly including operational overhead in COGS distorts gross margins:
            </p>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4">
              <li><strong>Selling Expenses:</strong> Google/Meta advertising, sales commissions, outbound customer shipping, and marketing team payroll.</li>
              <li><strong>General &amp; Administrative (G&amp;A):</strong> Corporate headquarters lease, executive C-suite salaries, legal retainers, and audit fees.</li>
              <li><strong>Financing Costs:</strong> Bank overdraft interest and corporate income tax deductions.</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions & Inventory Valuation Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Inventory Valuation Method Sensitivity:</strong> During inflationary cycles, FIFO (First-In, First-Out) reports lower COGS and higher taxable income, whereas Weighted Average Cost smooths pricing surges. (Note: LIFO is banned under IFRS and Indian AS 2).</li>
            <li><strong>Shrinkage, Breakage &amp; Theft:</strong> Unrecorded inventory theft or warehouse damage artificially increases reported COGS because ending inventory count comes in lower than accounting records predict.</li>
            <li><strong>Periodic vs. Perpetual Inventory Systems:</strong> This calculator models the periodic inventory method where COGS is established after a physical inventory count at period close.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Unsure whether an expense belongs in Gross Margin or Operating Overhead?</strong>
        Read our accounting analysis on <a href="/blog/cogs-vs-opex-accounting" class="text-accent font-medium hover:underline">COGS vs. Operating Expenses (OPEX): Income Statement Classification, Gross Margin Impact, and SaaS Gray Areas</a> to examine inventory capitalization, capitalized R&amp;D rules, and EBITDA purity.
      </div>

      <section aria-labelledby="cogs-calculator-faq">
        <h2 id="cogs-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {(jsonld['@graph'] as any)[2]?.mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="cogs-calculator-related">
        <h2 id="cogs-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcCOGS } from '../lib/calculators/cogs';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initCOGSCalc() {
    if ((window as any).__cmCogsBound) return;
    (window as any).__cmCogsBound = true;

    const begInput = document.getElementById('cogs-beginning') as HTMLInputElement | null;
    const purchInput = document.getElementById('cogs-purchases') as HTMLInputElement | null;
    const labInput = document.getElementById('cogs-labor') as HTMLInputElement | null;
    const ovhInput = document.getElementById('cogs-overhead') as HTMLInputElement | null;
    const endInput = document.getElementById('cogs-ending') as HTMLInputElement | null;
    const revInput = document.getElementById('cogs-revenue') as HTMLInputElement | null;

    const begSlider = document.getElementById('cogs-beginning-slider') as HTMLInputElement | null;
    const purchSlider = document.getElementById('cogs-purchases-slider') as HTMLInputElement | null;
    const labSlider = document.getElementById('cogs-labor-slider') as HTMLInputElement | null;
    const ovhSlider = document.getElementById('cogs-overhead-slider') as HTMLInputElement | null;
    const endSlider = document.getElementById('cogs-ending-slider') as HTMLInputElement | null;
    const revSlider = document.getElementById('cogs-revenue-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('cogs-result-hero');
    const resAvailable = document.getElementById('cogs-result-available');
    const resGrossProfit = document.getElementById('cogs-result-grossprofit');
    const resGrossMargin = document.getElementById('cogs-result-grossmargin');
    const resAdditions = document.getElementById('cogs-result-additions');

    const errAlert = document.getElementById('cogs-error-alert');
    const errMsg = document.getElementById('cogs-error-msg');

    if (!begInput || !purchInput) return;

    const DEFAULTS = { beg: 150000, purch: 450000, lab: 100000, ovh: 50000, end: 120000, rev: 950000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawBeg = begInput!.value.replace(/[^0-9.]/g, '');
      const rawPurch = purchInput!.value.replace(/[^0-9.]/g, '');
      const rawLab = labInput ? labInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawOvh = ovhInput ? ovhInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawEnd = endInput ? endInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawRev = revInput ? revInput.value.replace(/[^0-9.]/g, '') : '0';

      const vBeg = validate(rawBeg, { required: true, min: 0, label: 'Beginning Inventory' });
      const vPurch = validate(rawPurch, { required: true, min: 0, label: 'Purchases' });
      const vLab = validate(rawLab, { required: true, min: 0, label: 'Direct Labor' });
      const vOvh = validate(rawOvh, { required: true, min: 0, label: 'Overhead' });
      const vEnd = validate(rawEnd, { required: true, min: 0, label: 'Ending Inventory' });
      const vRev = validate(rawRev, { required: true, min: 0, label: 'Revenue' });

      if (!vBeg.valid) { showError(vBeg.error!.message); return; }
      if (!vPurch.valid) { showError(vPurch.error!.message); return; }
      if (!vLab.valid) { showError(vLab.error!.message); return; }
      if (!vOvh.valid) { showError(vOvh.error!.message); return; }
      if (!vEnd.valid) { showError(vEnd.error!.message); return; }
      if (!vRev.valid) { showError(vRev.error!.message); return; }
      clearError();

      const beg = vBeg.value!;
      const purch = vPurch.value!;
      const lab = vLab.value!;
      const ovh = vOvh.value!;
      const end = vEnd.value!;
      const rev = vRev.value!;

      const res = calcCOGS(beg, purch, lab, ovh, end, rev);

      setResult({
        heroValue: fmtVal(res.cogs),
        heroLabel: 'Cost of Goods Sold (COGS)',
        rows: [
          { label: 'Goods Available for Sale', value: fmtVal(res.goodsAvailableForSale) },
          { label: 'Gross Profit', value: fmtVal(res.grossProfit) },
          { label: 'Gross Profit Margin', value: `${res.grossMarginPct.toFixed(1)}%` },
          { label: 'Total Manufacturing Additions', value: fmtVal(res.totalAdditions) },
        ],
      });

      if (resHero) resHero.textContent = fmtVal(res.cogs);
      if (resAvailable) resAvailable.textContent = fmtVal(res.goodsAvailableForSale);
      if (resGrossProfit) resGrossProfit.textContent = fmtVal(res.grossProfit);
      if (resGrossMargin) resGrossMargin.textContent = `${res.grossMarginPct.toFixed(1)}%`;
      if (resAdditions) resAdditions.textContent = fmtVal(res.totalAdditions);

      const wrapper = document.getElementById('cogs-composition-wrapper');
      if (wrapper && rev > 0) {
        const cogsFrac = Math.min(1, res.cogs / rev);
        const gpFrac = Math.max(0, res.grossProfit / rev);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(cogsFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(gpFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.cogs);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.grossProfit);
      }

      serializeHash({ b: beg, p: purch, l: lab, o: ovh, e: end, r: rev });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(begSlider, begInput);
    sync(purchSlider, purchInput);
    sync(labSlider, labInput!);
    sync(ovhSlider, ovhInput!);
    sync(endSlider, endInput!);
    sync(revSlider, revInput!);

    document.getElementById('cogs-calculate')?.addEventListener('click', recalc);
    document.getElementById('cogs-reset')?.addEventListener('click', () => {
      begInput.value = fmtLiveInput(String(DEFAULTS.beg));
      purchInput.value = fmtLiveInput(String(DEFAULTS.purch));
      if (labInput) labInput.value = fmtLiveInput(String(DEFAULTS.lab));
      if (ovhInput) ovhInput.value = fmtLiveInput(String(DEFAULTS.ovh));
      if (endInput) endInput.value = fmtLiveInput(String(DEFAULTS.end));
      if (revInput) revInput.value = fmtLiveInput(String(DEFAULTS.rev));

      if (begSlider) {
        begSlider.value = String(DEFAULTS.beg);
        begSlider.style.setProperty('--slider-pct', `${(DEFAULTS.beg / 2000000) * 100}%`);
      }
      if (purchSlider) {
        purchSlider.value = String(DEFAULTS.purch);
        purchSlider.style.setProperty('--slider-pct', `${(DEFAULTS.purch / 5000000) * 100}%`);
      }
      if (labSlider) {
        labSlider.value = String(DEFAULTS.lab);
        labSlider.style.setProperty('--slider-pct', `${(DEFAULTS.lab / 1000000) * 100}%`);
      }
      if (ovhSlider) {
        ovhSlider.value = String(DEFAULTS.ovh);
        ovhSlider.style.setProperty('--slider-pct', `${(DEFAULTS.ovh / 500000) * 100}%`);
      }
      if (endSlider) {
        endSlider.value = String(DEFAULTS.end);
        endSlider.style.setProperty('--slider-pct', `${(DEFAULTS.end / 2000000) * 100}%`);
      }
      if (revSlider) {
        revSlider.value = String(DEFAULTS.rev);
        revSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rev - 50000) / (10000000 - 50000)) * 100}%`);
      }

      clearError();
      recalc();
      begInput.focus();
    });

    [begInput, purchInput, labInput, ovhInput, endInput, revInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('cogs-copy-btn')?.addEventListener('click', async () => {
      const rawBeg = begInput.value.replace(/[^0-9.]/g, '');
      const rawPurch = purchInput.value.replace(/[^0-9.]/g, '');
      const rawLab = labInput ? labInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawOvh = ovhInput ? ovhInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawEnd = endInput ? endInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawRev = revInput ? revInput.value.replace(/[^0-9.]/g, '') : '0';

      const vBeg = validate(rawBeg, { required: true, min: 0, label: 'Beginning Inventory' });
      const vPurch = validate(rawPurch, { required: true, min: 0, label: 'Purchases' });
      const vLab = validate(rawLab, { required: true, min: 0, label: 'Labor' });
      const vOvh = validate(rawOvh, { required: true, min: 0, label: 'Overhead' });
      const vEnd = validate(rawEnd, { required: true, min: 0, label: 'Ending Inventory' });
      const vRev = validate(rawRev, { required: true, min: 0, label: 'Revenue' });
      if (!vBeg.valid || !vPurch.valid || !vLab.valid || !vOvh.valid || !vEnd.valid || !vRev.valid) return;

      const res = calcCOGS(vBeg.value!, vPurch.value!, vLab.value!, vOvh.value!, vEnd.value!, vRev.value!);
      const text = `COGS Calculation: COGS ${fmtVal(res.cogs)}, Gross Profit: ${fmtVal(res.grossProfit)} (${res.grossMarginPct.toFixed(1)}% margin). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('cogs-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cogs-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('cogs-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      b: { required: true, min: 0, label: 'b' },
      p: { required: true, min: 0, label: 'p' },
      l: { required: false, label: 'l' },
      o: { required: false, label: 'o' },
      e: { required: false, label: 'e' },
      r: { required: false, label: 'r' },
    });
    if (restored.valid && restored.values.b !== undefined && restored.values.p !== undefined) {
      begInput.value = fmtLiveInput(String(restored.values.b));
      purchInput.value = fmtLiveInput(String(restored.values.p));
      if (labInput && restored.values.l !== undefined) labInput.value = fmtLiveInput(String(restored.values.l));
      if (ovhInput && restored.values.o !== undefined) ovhInput.value = fmtLiveInput(String(restored.values.o));
      if (endInput && restored.values.e !== undefined) endInput.value = fmtLiveInput(String(restored.values.e));
      if (revInput && restored.values.r !== undefined) revInput.value = fmtLiveInput(String(restored.values.r));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initCOGSCalc();
  document.addEventListener('astro:page-load', initCOGSCalc);
</script>
