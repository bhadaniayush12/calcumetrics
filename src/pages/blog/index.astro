---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS } from '../../data/blog/posts';

const canonicalUrl = 'https://calcumetrics.com/blog';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Financial Guides & Educational Blog',
      url: canonicalUrl,
      description: 'In-depth financial guides, calculation methodologies, and statutory tax breakdowns connecting to free client-side calculators.',
    },
    {
      '@type': 'ItemList',
      itemListElement: BLOG_POSTS.map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://calcumetrics.com/blog/${post.slug}`,
        name: post.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog' },
      ],
    },
  ],
};
---

<Layout
  title="Financial Guides & Calculation Insights | Calcumetrics Blog"
  description="In-depth, mathematically verified financial guides, investment metrics, tax rules, and pricing strategies with direct calculator integration."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium" aria-current="page">Blog</li>
      </ol>
    </nav>

    <div class="mb-8">
      <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Financial Intelligence</span>
      <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-2">Guides & Calculation Insights</h1>
      <p class="text-sm text-text-muted max-w-2xl leading-relaxed">
        Explore research-backed educational articles designed to help you understand personal finance, statutory tax compliance, corporate valuation, and business metrics. Every guide connects directly to interactive, client-side Calcumetrics calculation engines.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {BLOG_POSTS.map((post) => (
        <article class="bg-surface border border-border rounded-card p-5 flex flex-col justify-between hover:border-accent transition-standard focus-within:border-accent">
          <div>
            <div class="flex items-center justify-between text-xs text-text-muted mb-2">
              <span class="font-semibold text-accent uppercase tracking-wider">{post.category}</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-base font-bold text-text-primary mb-2 leading-snug">
              <a href={`/blog/${post.slug}`} class="hover:text-accent transition-standard focus-visible:outline-accent">
                {post.title}
              </a>
            </h2>
            <p class="text-xs text-text-muted line-clamp-3 leading-relaxed mb-4">
              {post.description}
            </p>
          </div>

          <div class="pt-4 border-t border-border mt-auto">
            <span class="text-[11px] font-semibold text-text-primary block mb-2">Connected Calculators:</span>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {post.relatedCalculators.slice(0, 3).map((calc) => (
                <a
                  href={calc.path}
                  class="text-[11px] px-2 py-0.5 rounded bg-canvas border border-border text-text-muted hover:text-accent hover:border-accent transition-standard"
                >
                  {calc.name}
                </a>
              ))}
            </div>
            <div class="flex items-center justify-between text-[11px] text-text-muted pt-2 border-t border-border/50">
              <span>{post.publishDate}</span>
              <a href={`/blog/${post.slug}`} class="text-accent font-medium hover:underline">Read Article &rarr;</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
