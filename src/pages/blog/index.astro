---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS } from '../../data/blog/posts';
import { formatDisplayDate } from '../../lib/formatters';

const canonicalUrl = 'https://calcumetrics.com/blog';
const featuredPost = BLOG_POSTS.find((p) => p.isFeatured) || BLOG_POSTS[2];
const regularPosts = BLOG_POSTS.filter((p) => p.slug !== featuredPost.slug);

// Randomized author display pool (no fake identity, seeded by slug for stable SSR)
const authorPool = ['Dev', 'Yuvraj', 'Calcumetrics Team'];
function getDisplayAuthor(slug: string): string {
  const idx = slug.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % authorPool.length;
  return authorPool[idx];
}

// Compute category counts
const categoryCounts: Record<string, number> = { All: BLOG_POSTS.length };
for (const post of BLOG_POSTS) {
  categoryCounts[post.category] = (categoryCounts[post.category] || 0) + 1;
}

const categories = ['All', 'Investments', 'Loans', 'Taxes', 'Business', 'Corporate Finance'] as const;

const categoryIcons: Record<string, string> = {
  Investments: '📈',
  Loans: '💳',
  Taxes: '🏛️',
  Business: '📊',
  'Corporate Finance': '🏢',
};

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Financial Guides & Educational Blog',
      url: canonicalUrl,
      description: 'In-depth financial guides, calculation methodologies, and statutory tax breakdowns connecting to free client-side calculators.',
    },
    {
      '@type': 'ItemList',
      itemListElement: BLOG_POSTS.map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://calcumetrics.com/blog/${post.slug}`,
        name: post.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: canonicalUrl },
      ],
    },
  ],
};
---

<Layout
  title="Financial Guides & Calculation Insights | Calcumetrics Blog"
  description="In-depth, mathematically verified financial guides, investment metrics, tax rules, and pricing strategies with direct calculator integration."
  canonical={canonicalUrl}
  ogImage="/og/categories/blog.png"
  ogImageAlt="Calcumetrics Research & Guides — Financial Intelligence, Statutory Tax Rules, and Interactive Calculation Analysis"
  slimFooter={true}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium" aria-current="page">Blog</li>
      </ol>
    </nav>

    <!-- Header Intro -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-accent/10 text-accent text-xs font-semibold uppercase tracking-wider mb-2">
        <span>📚</span>
        <span>Financial Intelligence &amp; Mathematical Guides</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary mb-3">
        Guides &amp; Calculation Insights
      </h1>
      <p class="text-base text-text-muted max-w-3xl leading-relaxed">
        Research-backed guides demystifying statutory tax laws, compounding formulas, loan economics, and valuation theory. Every guide connects directly to instant, client-side Calcumetrics calculation engines.
      </p>
    </div>

    <!-- Featured / Most Read Article Card (§4) -->
    {featuredPost && (
      <section aria-label="Featured Guide" class="mb-12">
        <div class="relative overflow-hidden bg-gradient-to-br from-surface to-surface/80 border-2 border-accent/40 rounded-card p-6 sm:p-8 shadow-sm hover:border-accent transition-standard">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-accent text-canvas">
                ⭐ Featured / Most Read
              </span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent uppercase tracking-wider">
                {featuredPost.category}
              </span>
              {featuredPost.market === 'India-Only' && (
                <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  🇮🇳 India
                </span>
              )}
            </div>
            <span class="text-xs text-text-muted font-medium">{featuredPost.readTime}</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary mb-3 leading-snug">
            <a href={`/blog/${featuredPost.slug}`} class="hover:text-accent transition-standard focus-visible:outline-accent">
              {featuredPost.title}
            </a>
          </h2>

          <p class="text-sm text-text-muted leading-relaxed mb-4 max-w-3xl">
            {featuredPost.description}
          </p>

          {featuredPost.quickAnswer && (
            <div class="p-3.5 bg-canvas/80 border-l-4 border-accent rounded-r text-xs text-text-muted leading-relaxed mb-6 max-w-3xl">
              <span class="text-text-primary font-bold block mb-0.5">⚡ Short Answer:</span>
              {featuredPost.quickAnswer}
            </div>
          )}

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-border">
            <div class="flex items-center gap-2 text-xs text-text-muted">
              <span>By <strong class="text-text-primary font-medium">{featuredPost.author}</strong></span>
              <span>•</span>
              <span>Updated {formatDisplayDate(featuredPost.dateModified)}</span>
              {featuredPost.reviewer && (
                <>
                  <span class="hidden sm:inline">•</span>
                  <span class="hidden sm:inline text-[11px] text-text-muted">{featuredPost.reviewer}</span>
                </>
              )}
            </div>

            <div class="flex items-center gap-3">
              {featuredPost.relatedCalculators[0] && (
                <a
                  href={featuredPost.relatedCalculators[0].path}
                  class="text-xs font-semibold px-3 py-1.5 rounded bg-canvas border border-border text-text-primary hover:border-accent hover:text-accent transition-standard"
                >
                  Try: {featuredPost.relatedCalculators[0].name} &rarr;
                </a>
              )}
              <a
                href={`/blog/${featuredPost.slug}`}
                class="px-4 py-1.5 rounded text-xs font-bold bg-accent text-canvas hover:opacity-90 transition-standard focus-visible:outline-accent"
              >
                Read Article &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Filter & Search Controls Bar (§5) -->
    <div class="mb-8 space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search guides by topic, formula, or keyword..."
            aria-label="Search articles"
            class="w-full bg-surface border border-border rounded-control px-4 py-2 text-xs sm:text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-standard"
          />
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-text-muted pointer-events-none" aria-hidden="true">
            🔍
          </span>
        </div>

        <div class="text-xs text-text-muted shrink-0 flex items-center gap-1.5 self-end md:self-center">
          <span id="blog-visible-count" class="font-bold text-text-primary tabular-nums">{BLOG_POSTS.length}</span>
          <span>articles found</span>
        </div>
      </div>

      <!-- Category Filter Chips (§5) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" role="tablist" aria-label="Filter articles by category">
        {categories.map((cat) => (
          <button
            type="button"
            role="tab"
            aria-selected={cat === 'All' ? 'true' : 'false'}
            data-category-filter={cat}
            class={`category-filter-btn shrink-0 text-xs px-3.5 py-1.5 rounded-full font-medium transition-standard cursor-pointer border ${
              cat === 'All'
                ? 'bg-accent text-canvas border-accent'
                : 'bg-surface text-text-muted border-border hover:border-accent hover:text-text-primary'
            }`}
          >
            {categoryIcons[cat] ? `${categoryIcons[cat]} ` : ''}{cat} ({categoryCounts[cat] || 0})
          </button>
        ))}
      </div>
    </div>

    <!-- Article Grid (§6, §7, §8, §9) -->
    <div id="blog-articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {BLOG_POSTS.map((post) => {
        const primaryCalc = post.relatedCalculators[0];
        const icon = categoryIcons[post.category] || '📄';
        return (
          <article
            class="blog-card bg-surface border border-border rounded-card flex flex-col justify-between hover:border-accent transition-standard focus-within:border-accent overflow-hidden"
            data-category={post.category}
            data-search={`${post.title} ${post.description} ${post.quickAnswer || ''} ${post.category}`.toLowerCase()}
          >
            <!-- Card Visual Anchor Header (§6) -->
            <div class="p-5 pb-3">
              <div class="flex items-center justify-between text-xs text-text-muted mb-2.5">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="inline-flex items-center gap-1 font-semibold text-accent uppercase tracking-wider text-[11px]">
                    <span aria-hidden="true">{icon}</span>
                    {post.category}
                  </span>

                  {/* Badge consistency: Only India or US (§9) */}
                  {post.market === 'India-Only' && (
                    <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                      🇮🇳 India
                    </span>
                  )}
                  {post.market === 'Both' && (
                    <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20">
                      🇮🇳 / Global
                    </span>
                  )}
                </div>
                <span class="text-[11px] text-text-muted shrink-0">{post.readTime}</span>
              </div>

              <!-- Title -->
              <h2 class="text-base font-bold text-text-primary mb-2 leading-snug line-clamp-2">
                <a href={`/blog/${post.slug}`} class="hover:text-accent transition-standard focus-visible:outline-accent">
                  {post.title}
                </a>
              </h2>

              <!-- Clamped Description (§8) -->
              <p class="text-xs text-text-muted line-clamp-2 leading-relaxed mb-3">
                {post.description}
              </p>

              <!-- Quick Answer Teaser Box (§13) -->
              {post.quickAnswer && (
                <div class="p-2.5 rounded bg-canvas border border-border/70 text-[11px] text-text-muted leading-relaxed line-clamp-2">
                  <strong class="text-text-primary font-semibold">⚡ Quick Take:</strong> {post.quickAnswer.length > 120 ? post.quickAnswer.slice(0, 117) + '...' : post.quickAnswer}
                </div>
              )}
            </div>

            <!-- Card Bottom Bar: Single Calculator CTA + Date & Link (§7, §8) -->
            <div class="px-5 pb-5 pt-2 mt-auto">
              {primaryCalc && (
                <div class="pt-3 border-t border-border/60 mb-3">
                  <a
                    href={primaryCalc.path}
                    class="group inline-flex items-center justify-between w-full text-xs font-semibold px-3 py-1.5 rounded bg-canvas border border-border text-text-primary hover:border-accent hover:text-accent transition-standard"
                    title={`Try ${primaryCalc.name}`}
                  >
                    <span class="truncate">Try: {primaryCalc.name}</span>
                    <span class="text-accent group-hover:translate-x-0.5 transition-transform shrink-0 ml-1">&rarr;</span>
                  </a>
                </div>
              )}

              <div class="flex items-center justify-between text-[11px] text-text-muted pt-2 border-t border-border/40">
                <div class="flex items-center gap-1.5">
                  <span class="text-text-primary font-medium">By {getDisplayAuthor(post.slug)}</span>
                  <span>•</span>
                  <span>{formatDisplayDate(post.publishDate)}</span>
                </div>
                <a href={`/blog/${post.slug}`} class="text-accent font-semibold hover:underline">
                  Read &rarr;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty Filter State -->
    <div id="blog-empty-state" class="hidden text-center py-16 px-4 bg-surface border border-border rounded-card my-8">
      <div class="text-3xl mb-3" aria-hidden="true">🔍</div>
      <h3 class="text-lg font-bold text-text-primary mb-1">No guides found</h3>
      <p class="text-xs text-text-muted max-w-sm mx-auto mb-4">
        We couldn't find any articles matching your search query. Try searching for "SIP", "Tax", or "WACC".
      </p>
      <button
        type="button"
        id="blog-reset-filters"
        class="px-4 py-2 rounded-control text-xs font-semibold bg-accent text-canvas hover:opacity-90 transition-standard cursor-pointer"
      >
        Reset Filters
      </button>
    </div>
  </div>
</Layout>

<script>
  // Client-side real-time filtering & search (§5)
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll('.category-filter-btn') as NodeListOf<HTMLButtonElement>;
  const cards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
  const emptyState = document.getElementById('blog-empty-state');
  const countEl = document.getElementById('blog-visible-count');
  const resetBtn = document.getElementById('blog-reset-filters');

  let activeCategory = 'All';
  let activeSearch = '';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardSearchText = card.getAttribute('data-search') || '';

      const matchesCategory = activeCategory === 'All' || cardCategory === activeCategory;
      const matchesSearch = !activeSearch || cardSearchText.includes(activeSearch);

      if (matchesCategory && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countEl) countEl.textContent = String(visibleCount);

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Category filter click
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.setAttribute('aria-selected', 'false');
        b.className = 'category-filter-btn shrink-0 text-xs px-3.5 py-1.5 rounded-full font-medium transition-standard cursor-pointer border bg-surface text-text-muted border-border hover:border-accent hover:text-text-primary';
      });

      btn.setAttribute('aria-selected', 'true');
      btn.className = 'category-filter-btn shrink-0 text-xs px-3.5 py-1.5 rounded-full font-medium transition-standard cursor-pointer border bg-accent text-canvas border-accent';

      activeCategory = btn.getAttribute('data-category-filter') || 'All';
      applyFilters();
    });
  });

  // Search input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      activeSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });
  }

  // Reset button
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeSearch = '';
      activeCategory = 'All';

      filterBtns.forEach((b) => {
        const isAll = b.getAttribute('data-category-filter') === 'All';
        b.setAttribute('aria-selected', isAll ? 'true' : 'false');
        b.className = isAll
          ? 'category-filter-btn shrink-0 text-xs px-3.5 py-1.5 rounded-full font-medium transition-standard cursor-pointer border bg-accent text-canvas border-accent'
          : 'category-filter-btn shrink-0 text-xs px-3.5 py-1.5 rounded-full font-medium transition-standard cursor-pointer border bg-surface text-text-muted border-border hover:border-accent hover:text-text-primary';
      });

      applyFilters();
    });
  }
</script>
