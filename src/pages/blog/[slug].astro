---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS } from '../../data/blog/posts';
import type { BlogPost } from '../../data/blog/types';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const canonicalUrl = `https://calcumetrics.com/blog/${post.slug}`;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.title,
      description: post.description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      datePublished: post.publishDate,
      dateModified: post.dateModified,
      author: {
        '@type': 'Organization',
        name: post.author,
        url: 'https://calcumetrics.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://calcumetrics.com/blog' },
        { '@type': 'ListItem', position: 3, name: post.title },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: post.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={post.seoTitle}
  description={post.description}
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <article class="max-w-[840px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted flex-wrap">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog" class="hover:text-accent transition-standard">Blog</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium truncate max-w-[280px] sm:max-w-none" aria-current="page">{post.title}</li>
      </ol>
    </nav>

    <!-- Header Meta -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-accent/10 text-accent uppercase tracking-wider">
          {post.category}
        </span>
        <span class="text-xs text-text-muted">•</span>
        <span class="text-xs text-text-muted">{post.readTime}</span>
        <span class="text-xs text-text-muted">•</span>
        <span class="text-xs text-text-muted">Updated {post.dateModified}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-text-primary mb-4 leading-tight">
        {post.title}
      </h1>

      <p class="text-sm sm:text-base text-text-muted leading-relaxed border-l-2 border-accent pl-4 py-1 italic bg-canvas/60 rounded-r">
        {post.summary}
      </p>
    </header>

    <!-- Prominent Quick Tool Access Callout -->
    <aside aria-label="Related Calculators" class="mb-8 p-4 sm:p-5 bg-surface border border-accent/30 rounded-card shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-base" aria-hidden="true">🧮</span>
        <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-text-primary">
          Calcumetrics Interactive Calculation Tools
        </h2>
      </div>
      <p class="text-xs text-text-muted mb-3 leading-relaxed">
        Put this guide into practice with instant, client-side calculations:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {post.relatedCalculators.map((calc) => (
          <a
            href={calc.path}
            class="group block p-2.5 bg-canvas border border-border rounded hover:border-accent transition-standard focus-visible:outline-accent"
          >
            <div class="flex items-center justify-between mb-0.5">
              <span class="text-xs font-bold text-text-primary group-hover:text-accent transition-standard">{calc.name}</span>
              {calc.badge && <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded bg-accent/10 text-accent">{calc.badge}</span>}
            </div>
            <p class="text-[11px] text-text-muted leading-snug line-clamp-1">{calc.description}</p>
          </a>
        ))}
      </div>
    </aside>

    <!-- Main Content Body -->
    <div class="article-body prose prose-invert max-w-none text-text-primary leading-relaxed text-sm sm:text-base">
      <Fragment set:html={post.content} />
    </div>

    <!-- FAQ Section -->
    {post.faqs.length > 0 && (
      <section aria-labelledby="post-faq-heading" class="mt-12 pt-8 border-t border-border">
        <h2 id="post-faq-heading" class="text-xl font-bold text-text-primary mb-4">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {post.faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden bg-surface">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">
                {faq.question}
              </summary>
              <div class="px-5 pb-4 pt-2 text-xs sm:text-sm text-text-muted leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles Section -->
    {post.relatedArticles.length > 0 && (
      <section aria-labelledby="related-articles-heading" class="mt-10 pt-8 border-t border-border">
        <h2 id="related-articles-heading" class="text-lg font-bold text-text-primary mb-4">Related Guides & Readings</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {post.relatedArticles.map((rel) => (
            <a
              href={`/blog/${rel.slug}`}
              class="group block p-4 bg-surface border border-border rounded-card hover:border-accent transition-standard focus-visible:outline-accent"
            >
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Related Guide</span>
              <h3 class="text-sm font-bold text-text-primary group-hover:text-accent transition-standard mb-1 leading-snug">
                {rel.title}
              </h3>
              <p class="text-xs text-text-muted leading-relaxed line-clamp-2">{rel.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Author & Disclaimer Note -->
    <div class="mt-12 p-4 bg-surface/50 border border-border rounded-card text-xs text-text-muted leading-relaxed">
      <p class="font-semibold text-text-primary mb-1">Editorial Notice & Disclaimer</p>
      <p>
        Authored by the Calcumetrics Financial Research Team. Content is prepared for educational and informational purposes only and does not constitute statutory, investment, tax, or legal advice. Verify all financial decisions against official regulations or consult a licensed professional before taking action.
      </p>
    </div>
  </article>
</Layout>
