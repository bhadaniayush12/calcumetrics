---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS } from '../../data/blog/posts';
import type { BlogPost } from '../../data/blog/types';
import { formatDisplayDate } from '../../lib/formatters';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const canonicalUrl = `https://calcumetrics.com/blog/${post.slug}`;
const articleOgImage = `/og/articles/${post.slug}.png`;
const articleOgImageUrl = `https://calcumetrics.com${articleOgImage}`;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.title,
      description: post.description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      datePublished: post.publishDate,
      dateModified: post.dateModified,
      image: [articleOgImageUrl],
      author: {
        '@type': 'Person',
        name: post.author,
        url: 'https://calcumetrics.com/about',
      },
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
          width: 200,
          height: 200,
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://calcumetrics.com/blog' },
        { '@type': 'ListItem', position: 3, name: post.title, item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: post.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title={post.seoTitle}
  description={post.description}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={articleOgImage}
  slimFooter={true}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <article class="max-w-[840px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted flex-wrap">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog" class="hover:text-accent transition-standard">Blog</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium truncate max-w-[280px] sm:max-w-none" aria-current="page">{post.title}</li>
      </ol>
    </nav>

    <!-- Header Meta -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-accent/10 text-accent uppercase tracking-wider">
          {post.category}
        </span>
        {post.market === 'India-Only' && (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
            🇮🇳 India-Specific
          </span>
        )}
        {post.market === 'Both' && (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20">
            🇮🇳 / Global
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-text-primary mb-3 leading-tight">
        {post.title}
      </h1>

      <div class="flex items-center gap-2 text-xs text-text-muted mb-6 pb-4 border-b border-border/60 flex-wrap">
        <span>By <a href="/about" class="text-text-primary font-medium hover:text-accent transition-standard underline decoration-border/60 underline-offset-2">{post.author}</a></span>
        <span>•</span>
        <span>Published {formatDisplayDate(post.publishDate)}</span>
        {post.dateModified !== post.publishDate && (
          <>
            <span>•</span>
            <span>Updated <time datetime={post.dateModified} class="text-text-primary font-medium">{formatDisplayDate(post.dateModified)}</time></span>
          </>
        )}
        <span>•</span>
        <span>{post.readTime}</span>
        {post.reviewer && (
          <>
            <span>•</span>
            <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
              <span>✓</span>
              <span>{post.reviewer}</span>
            </span>
          </>
        )}
      </div>

      <!-- Direct Answer / Featured Snippet Box (§5) -->
      <div class="p-4 bg-surface/80 border-l-4 border-accent rounded-r text-sm text-text-muted leading-relaxed mb-6">
        <strong class="text-text-primary text-xs uppercase tracking-wider block mb-1 font-semibold">Key Takeaway (Direct Answer)</strong>
        {post.summary}
      </div>
    </header>

    <!-- Prominent Quick Tool Access Callout -->
    <aside aria-label="Related Calculators" class="mb-8 p-4 sm:p-5 bg-surface border border-accent/30 rounded-card shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-base" aria-hidden="true">🧮</span>
        <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-text-primary">
          Calcumetrics Interactive Calculation Tools
        </h2>
      </div>
      <p class="text-xs text-text-muted mb-3 leading-relaxed">
        Put this guide into practice with instant, client-side calculations:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {post.relatedCalculators.map((calc) => (
          <a
            href={calc.path}
            class="group block p-2.5 bg-canvas border border-border rounded hover:border-accent transition-standard focus-visible:outline-accent"
          >
            <div class="flex items-center justify-between mb-0.5">
              <span class="text-xs font-bold text-text-primary group-hover:text-accent transition-standard">{calc.name}</span>
              {calc.badge && <span class="text-[10px] font-semibold px-1.5 py-0.2 rounded bg-accent/10 text-accent">{calc.badge}</span>}
            </div>
            <p class="text-[11px] text-text-muted leading-snug line-clamp-1">{calc.description}</p>
          </a>
        ))}
      </div>
    </aside>

    <!-- Main Content Body -->
    <div class="article-body prose prose-invert max-w-none text-text-primary leading-relaxed text-sm sm:text-base">
      <Fragment set:html={post.content} />
    </div>

    <!-- Authoritative Sources & Citations (§4) -->
    {post.sources && post.sources.length > 0 && (
      <section aria-labelledby="sources-heading" class="mt-10 pt-6 border-t border-border">
        <h2 id="sources-heading" class="text-xs font-bold text-text-primary uppercase tracking-wider mb-3">
          Authoritative Sources &amp; Statutory References
        </h2>
        <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4 leading-relaxed">
          {post.sources.map((src) => (
            <li>
              {src.url ? (
                <a href={src.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium">
                  {src.name}
                </a>
              ) : (
                <span class="text-text-primary font-medium">{src.name}</span>
              )}
              {src.citation && <span class="text-text-muted"> ({src.citation})</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- FAQ Section -->
    {post.faqs.length > 0 && (
      <section aria-labelledby="post-faq-heading" class="mt-10 pt-8 border-t border-border">
        <h2 id="post-faq-heading" class="text-xl font-bold text-text-primary mb-4">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {post.faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden bg-surface">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">
                {faq.question}
              </summary>
              <div class="px-5 pb-4 pt-2 text-xs sm:text-sm text-text-muted leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles Section -->
    {post.relatedArticles.length > 0 && (
      <section aria-labelledby="related-articles-heading" class="mt-10 pt-8 border-t border-border">
        <h2 id="related-articles-heading" class="text-lg font-bold text-text-primary mb-4">Related Guides &amp; Readings</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {post.relatedArticles.map((rel) => (
            <a
              href={`/blog/${rel.slug}`}
              class="group block p-4 bg-surface border border-border rounded-card hover:border-accent transition-standard focus-visible:outline-accent"
            >
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Related Guide</span>
              <h3 class="text-sm font-bold text-text-primary group-hover:text-accent transition-standard mb-1 leading-snug">
                {rel.title}
              </h3>
              <p class="text-xs text-text-muted leading-relaxed line-clamp-2">{rel.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Author Box -->
    <div class="mt-12 p-6 bg-surface border border-border rounded-card flex items-start gap-5">
      <div class="w-14 h-14 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center text-accent text-lg font-bold shrink-0 shadow-sm">
        {post.author.slice(0, 1).toUpperCase()}
      </div>
      <div class="flex-1">
        <h3 class="text-sm font-bold text-text-primary mb-1">
          Written by <a href="/about" class="text-accent hover:underline">{post.author}</a>
        </h3>
        <span class="text-[11px] text-accent font-semibold uppercase tracking-wider">Calcumetrics Contributor</span>
        <p class="text-xs text-text-muted leading-relaxed mt-2">
          This guide is part of the Calcumetrics editorial library, created to explain financial concepts and calculations clearly for readers using the platform.
        </p>
      </div>
    </div>

    <!-- Author & Trust Disclaimer Note (§4) -->
    <div class="mt-12 p-5 bg-surface/50 border border-border rounded-card text-xs text-text-muted leading-relaxed space-y-2">
      <div class="flex items-center gap-2 text-text-primary font-semibold text-xs uppercase tracking-wider">
        <span>🛡️</span>
        <span>Editorial Standards &amp; Financial Disclaimer</span>
      </div>
      <p>
        Authored by <strong>{post.author}</strong>. Calcumetrics financial guides and computational engines are developed strictly for educational and modeling purposes. Calculations are mathematical estimates based on user inputs and assumed parameters, never statutory, tax, legal, or investment advice.
      </p>
      <p>
        Financial regulations, tax brackets, and market parameters evolve. Always verify statutory figures against official regulatory authorities or consult a certified financial planner, chartered accountant, or tax attorney before making capital decisions.
      </p>
      <p class="pt-1 text-[11px] text-text-muted">
        Learn more about our <a href="/about" class="text-accent hover:underline font-medium">editorial integrity</a> and <a href="/methodology" class="text-accent hover:underline font-medium">calculation methodologies</a>.
      </p>
    </div>
  </article>
</Layout>
