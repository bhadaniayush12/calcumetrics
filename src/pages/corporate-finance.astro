---
import Layout from '../layouts/Layout.astro';
import { getPublishedTools } from '../config/site';
const tools = getPublishedTools().filter((t) => t.category === 'Corporate Finance');
const count = tools.length;
const noindex = count < 4;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Corporate Finance Calculators', url: 'https://calcumetrics.com/corporate-finance', description: `${count} free corporate finance calculators: WACC, NPV, IRR, Payback Period, and DCF.` },
    { '@type': 'ItemList', itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://calcumetrics.com${t.path}`, name: t.name })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Corporate Finance', item: 'https://calcumetrics.com/corporate-finance' }] },
  ],
};
---
<Layout title={`Corporate Finance Calculators: ${count} Free Tools | Calcumetrics`} description={`${count} free corporate finance calculators: WACC, NPV, IRR, Payback Period, and DCF analysis. Built for analysts, CAs, and finance students.`} canonical="https://calcumetrics.com/corporate-finance" robots={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} ogImage="/og/categories/corporate-finance.png">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6"><ol class="flex items-center gap-1.5 text-xs text-text-muted"><li><a href="/" class="hover:text-accent transition-standard">Home</a></li><li aria-hidden="true">›</li><li class="text-text-primary font-medium" aria-current="page">Corporate Finance</li></ol></nav>
    <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-2">Corporate Finance Calculators</h1>
    <p class="text-sm text-text-muted mb-8 max-w-xl">Professional-grade tools for valuation and capital structure decisions — WACC, NPV, IRR, Payback Period, and Discounted Cash Flow analysis.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.region}</span>
          <h2 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard mb-1">{tool.name}</h2>
          <p class="text-xs text-text-muted leading-relaxed">{tool.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
