---
import Layout from '../layouts/Layout.astro';
import { getPublishedTools } from '../config/site';
const tools = getPublishedTools().filter((t) => t.category === 'Corporate Finance');
const count = tools.length;
const noindex = count < 4;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Corporate Finance Calculators', url: 'https://calcumetrics.com/corporate-finance', description: `${count} free corporate finance calculators: WACC, NPV, IRR, Payback Period, and DCF.` },
    { '@type': 'ItemList', itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://calcumetrics.com${t.path}`, name: t.name })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Corporate Finance', item: 'https://calcumetrics.com/corporate-finance' }] },
  ],
};
---
<Layout title={`Corporate Finance Calculators: ${count} Free Tools | Calcumetrics`} description={`${count} free corporate finance calculators: WACC, NPV, IRR, Payback Period, and DCF analysis. Built for analysts, CAs, and finance students.`} canonical="https://calcumetrics.com/corporate-finance" robots={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} ogImage="/og/categories/corporate-finance.png" ogImageAlt="Calcumetrics Corporate Finance Calculators — WACC, Net Present Value, and IRR valuation suite preview card">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6"><ol class="flex items-center gap-1.5 text-xs text-text-muted"><li><a href="/" class="hover:text-accent transition-standard">Home</a></li><li aria-hidden="true">›</li><li class="text-text-primary font-medium" aria-current="page">Corporate Finance</li></ol></nav>
    <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-2">Corporate Finance Calculators</h1>
    <p class="text-sm text-text-muted mb-8 max-w-xl">Professional-grade tools for valuation and capital structure decisions: WACC, NPV, IRR, Payback Period, and Discounted Cash Flow analysis.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <a data-currency-lock={tool.path.startsWith('/in/') ? 'INR' : undefined} href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.region}</span>
          <h2 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard mb-1">{tool.name}</h2>
          <p class="text-xs text-text-muted leading-relaxed">{tool.description}</p>
        </a>
      ))}
    </div>
    <section aria-labelledby="hub-guide" class="mt-12 max-w-3xl">
      <h2 id="hub-guide" class="text-xl font-bold text-text-primary mb-4">How to choose a corporate finance calculator</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-4">Start with the discount rate. The <a href="/wacc-calculator" class="text-accent hover:underline font-medium">WACC calculator</a> gives the blended cost of capital that most firms use as the hurdle rate for new projects. Feed that rate into the <a href="/npv-calculator" class="text-accent hover:underline font-medium">NPV calculator</a>: a positive NPV means the project earns more than it costs to fund. The <a href="/irr-calculator" class="text-accent hover:underline font-medium">IRR calculator</a> returns the rate at which NPV is zero, which is easier to compare across projects but can mislead when cash flows change sign more than once.</p>
      <p class="text-sm text-text-muted leading-relaxed mb-4">For a quick risk check, <a href="/payback-period-calculator" class="text-accent hover:underline font-medium">payback period</a> shows how many years it takes to recover the outlay, and <a href="/discounted-payback-period-calculator" class="text-accent hover:underline font-medium">discounted payback</a> does the same after discounting, so it is never shorter. To value a whole business, the <a href="/dcf-calculator" class="text-accent hover:underline font-medium">DCF calculator</a> adds a terminal value to projected cash flows. <a href="/present-value-calculator" class="text-accent hover:underline font-medium">Present value</a> and <a href="/future-value-calculator" class="text-accent hover:underline font-medium">future value</a> handle single amounts, such as what a payment due in five years is worth today.</p>
      <h3 class="text-sm font-semibold text-text-primary mb-2 mt-6">Related guides</h3>
      <ul class="list-disc pl-5 space-y-1 text-sm">
        <li><a href="/blog/npv-vs-irr" class="text-accent hover:underline font-medium">NPV vs IRR: which to use</a></li>
        <li><a href="/blog/how-to-calculate-wacc" class="text-accent hover:underline font-medium">How to calculate WACC</a></li>
        <li><a href="/blog/dcf-valuation-terminal-value-guide" class="text-accent hover:underline font-medium">DCF valuation and terminal value</a></li>
      </ul>
    </section>
  </div>
</Layout>
