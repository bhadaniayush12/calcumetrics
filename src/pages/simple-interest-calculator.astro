---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcSimpleInterest } from '../lib/calculators/simple-interest';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 7.5, years: 5 };
const result = calcSimpleInterest(DEFAULT.principal, DEFAULT.rate, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Investments' && t.slug !== 'simple-interest-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/simple-interest-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Simple Interest Calculator',
      url: canonicalUrl,
      description: 'Calculate simple interest, maturity value, and compare with compound interest growth for loans and savings.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Simple Interest Calculator' },
      ],
    },
  ],
};
---

<Layout
  title="Simple Interest Calculator: Formula, Interest & Maturity | Calcumetrics"
  description="Calculate simple interest, total maturity value, and compare directly with compound interest. Fast, precise, and interactive."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Simple Interest Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.totalAmount)}
    heroLabel="Maturity Value"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Simple Interest Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate linear interest on principal deposits, consumer loans, and promissory bonds.</p>

      <!-- Principal -->
      <div class="mb-5">
        <Input
          id="si-principal"
          label="Principal Amount"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Starting principal balance"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="si-principal-slider" min={5000} max={5000000} step={5000} value={100000} ariaLabel="Principal slider" />
        </div>
      </div>

      <!-- Rate -->
      <div class="mb-5">
        <Input
          id="si-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="7.5"
          isNumeric={true}
          helperText="Nominal rate per annum"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="si-rate-slider" min={1} max={30} step={0.25} value={7.5} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Time Period -->
      <div class="mb-6">
        <Input
          id="si-years"
          label="Time Period (Tenure)"
          suffix="Years"
          value="5"
          isNumeric={true}
          helperText="Duration of interest calculation"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="si-years-slider" min={1} max={30} step={0.5} value={5} ariaLabel="Years slider" />
        </div>
      </div>

      <Alert variant="info" title="Simple vs Compound Interest">
        Simple interest grows linearly every year without interest-on-interest. Over 5 years at 7.5%, compounding would generate an extra {fmt(result.compoundingAdvantage)}.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="si-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="si-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Maturity Value</span>
        <div id="si-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.totalAmount)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Initial Principal</span>
          <span id="si-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Simple Interest</span>
          <span id="si-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.interest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Compounded Equivalent</span>
          <span id="si-result-compound" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.compoundInterestAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Compounding Advantage</span>
          <span id="si-result-advantage" class="text-sm font-semibold tabular-nums text-dark-accent">+{fmt(result.compoundingAdvantage)}</span>
        </div>
      </div>

      <div class="mb-5" id="si-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.principal / result.totalAmount}
          gainFraction={result.interest / result.totalAmount}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(DEFAULT.principal)}
          gainValue={fmt(result.interest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="si-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="si-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Calculated via standard SI formula: (P &times; R &times; T) / 100.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="si-calculator-how">
        <h2 id="si-calculator-how" class="text-xl font-bold text-text-primary mb-4">How simple interest is calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Simple interest is determined solely by multiplying the daily or annual rate by the original principal:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">SI = (P &times; R &times; T) / 100</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">SI</strong> — Simple Interest earned or owed</li>
            <li><strong class="text-text-primary">P</strong> — Principal investment or borrowed loan</li>
            <li><strong class="text-text-primary">R</strong> — Annual nominal percentage rate</li>
            <li><strong class="text-text-primary">T</strong> — Time period in years</li>
            <li><strong class="text-text-primary">Total Maturity</strong> = P + SI</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="si-calculator-faq">
        <h2 id="si-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Where is simple interest typically used in banking?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Simple interest is commonly used for short-term personal loans, car loans, auto financing, installment loans, and certificates of deposit where interest is paid out periodically rather than reinvested into the principal.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Why do savings accounts use compound interest instead?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Compound interest incentivizes long-term saving because earned interest remains in the account and generates additional interest in subsequent compounding periods (monthly or quarterly), rapidly compounding wealth.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="si-calculator-related">
        <h2 id="si-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  function calcSIClient(p: number, r: number, y: number) {
    const interest = (p * r * y) / 100;
    const totalAmount = p + interest;
    const compoundAmount = p * Math.pow(1 + r / 100, y);
    const compoundingAdvantage = Math.max(0, compoundAmount - totalAmount);
    return {
      interest,
      totalAmount,
      compoundAmount,
      compoundingAdvantage,
      pFrac: totalAmount > 0 ? p / totalAmount : 1,
      iFrac: totalAmount > 0 ? interest / totalAmount : 0,
    };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initSICalc() {
    const pInput = document.getElementById('si-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('si-rate') as HTMLInputElement | null;
    const yInput = document.getElementById('si-years') as HTMLInputElement | null;

    const pSlider = document.getElementById('si-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('si-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('si-years-slider') as HTMLInputElement | null;

    const resMaturity = document.getElementById('si-result-maturity');
    const resPrincipal = document.getElementById('si-result-principal');
    const resInterest = document.getElementById('si-result-interest');
    const resCompound = document.getElementById('si-result-compound');
    const resAdvantage = document.getElementById('si-result-advantage');
    const mobileHero = document.getElementById('calc-mobile-hero');

    if (!pInput || !rInput || !yInput) return;

    const DEFAULTS = { p: 100000, r: 7.5, y: 5 };
    let timer: ReturnType<typeof setTimeout>;

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const y = parseFloat(yInput.value) || 0;

      if (p <= 0 || r <= 0 || y <= 0) return;

      const res = calcSIClient(p, r, y);

      if (resMaturity) resMaturity.textContent = fmtVal(res.totalAmount);
      if (resPrincipal) resPrincipal.textContent = fmtVal(p);
      if (resInterest) resInterest.textContent = fmtVal(res.interest);
      if (resCompound) resCompound.textContent = fmtVal(res.compoundAmount);
      if (resAdvantage) resAdvantage.textContent = '+' + fmtVal(res.compoundingAdvantage);
      if (mobileHero) mobileHero.textContent = fmtVal(res.totalAmount);

      const wrapper = document.getElementById('si-composition-wrapper');
      if (wrapper && res.totalAmount > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.pFrac * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.iFrac * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(p);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.interest);
      }

      history.replaceState(null, '', `#p=${p}&r=${r}&y=${y}`);
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(ySlider, yInput, false);

    document.getElementById('si-calculate')?.addEventListener('click', recalc);
    document.getElementById('si-reset')?.addEventListener('click', () => {
      pInput.value = fmtLiveInput(String(DEFAULTS.p));
      rInput.value = String(DEFAULTS.r);
      yInput.value = String(DEFAULTS.y);

      if (pSlider) {
        pSlider.value = String(DEFAULTS.p);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.p - 5000) / (5000000 - 5000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.r);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.r - 1) / (30 - 1)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.y);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.y - 1) / (30 - 1)) * 100}%`);
      }

      recalc();
      pInput.focus();
    });

    [pInput, rInput, yInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('si-copy-btn')?.addEventListener('click', async () => {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const y = parseFloat(yInput.value) || 0;
      const res = calcSIClient(p, r, y);
      const text = `Simple Interest: Principal ${fmtVal(p)} at ${r}% for ${y} years => Total Interest: ${fmtVal(res.interest)}, Maturity: ${fmtVal(res.totalAmount)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('si-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('si-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('si-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initSICalc();
  document.addEventListener('astro:page-load', initSICalc);
</script>
