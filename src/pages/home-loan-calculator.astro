---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcEMI } from '../lib/calculators/emi';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { price: 5000000, downPct: 20, rate: 8.5, years: 20 };
const initialLoan = DEFAULT.price * (1 - DEFAULT.downPct / 100);
const initialResult = calcEMI(initialLoan, DEFAULT.rate, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Loans' && t.slug !== 'home-loan-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/home-loan-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Home Loan EMI Calculator',
      url: canonicalUrl,
      description: 'Calculate your home loan monthly EMI, down payment, total interest, and property repayment breakdown.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Home Loan Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How is home loan EMI calculated?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Home loan EMI is calculated using the reducing balance method: EMI = [P × r × (1+r)^n] / [(1+r)^n − 1], where P is principal borrowed (property cost minus down payment), r is monthly interest rate, and n is tenure in months.',
          },
        },
        {
          '@type': 'Question',
          name: 'How much down payment should I make on a home loan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'While regulatory guidelines allow financing up to 80%–90% of property cost depending on the loan bracket, providing a higher down payment (e.g. 20% to 30%) substantially reduces your lifetime interest burden.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I prepay my home loan without penalty?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, per RBI guidelines, commercial banks and HFCs cannot levy foreclosure or prepayment charges on floating-rate home loans availed by individual borrowers.',
          },
        },
        {
          '@type': 'Question',
          name: 'What tax benefits are available on home loans?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the Old Tax Regime in India, borrowers can claim up to ₹1.5 lakh per year for principal repayment under Section 80C, and up to ₹2 lakh per year for interest paid under Section 24(b) for a self-occupied property.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does choosing a longer loan tenure affect total cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A longer loan tenure decreases your monthly EMI payment, making it more affordable in the short term. However, it significantly increases the total interest paid over the life of the loan.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Home Loan EMI Calculator: Monthly Instalment & Down Payment | Calcumetrics"
  description="Calculate your home loan monthly EMI, down payment, total interest, and property repayment breakdown. Free, instant, 100% client-side."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Home Loan EMI Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={fmt(initialResult.emiRounded)}
    heroLabel="Monthly EMI"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Home Loan EMI Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Estimate your housing loan EMI, interest burden, and required down payment.</p>

      <!-- Error alert -->
      <div id="hl-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="hl-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Property Value -->
      <div class="mb-5">
        <Input
          id="hl-price"
          label="Property Value"
          prefix="₹"
          value="50,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total cost of the home"
          inputmode="decimal"
          aria-describedby="hl-error-msg"
        />
        <div class="mt-2">
          <Slider id="hl-price-slider" min={500000} max={50000000} step={100000} value={5000000} ariaLabel="Property value slider" />
        </div>
      </div>

      <!-- Down Payment % -->
      <div class="mb-5">
        <Input
          id="hl-down"
          label="Down Payment (%)"
          suffix="%"
          value="20"
          isNumeric={true}
          helperText="Standard minimum is 10% to 20%"
          inputmode="decimal"
          aria-describedby="hl-error-msg"
        />
        <div class="mt-2">
          <Slider id="hl-down-slider" min={10} max={80} step={1} value={20} ariaLabel="Down payment slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="hl-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="8.5"
          isNumeric={true}
          helperText="Prevailing bank home loan rate"
          inputmode="decimal"
          aria-describedby="hl-error-msg"
        />
        <div class="mt-2">
          <Slider id="hl-rate-slider" min={6.5} max={15} step={0.1} value={8.5} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-6">
        <Input
          id="hl-years"
          label="Loan Tenure (Years)"
          suffix="Years"
          value="20"
          isNumeric={true}
          helperText="Duration of repayment (up to 30 years)"
          inputmode="numeric"
          aria-describedby="hl-error-msg"
        />
        <div class="mt-2">
          <Slider id="hl-years-slider" min={1} max={30} step={1} value={20} ariaLabel="Tenure slider" />
        </div>
      </div>

      <Alert variant="info" title="Tax Benefit">
        Repayment of principal qualifies for deduction under Section 80C (up to ₹1.5L), while interest paid is deductible under Section 24(b) (up to ₹2L/year).
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="hl-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="hl-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div id="hl-result-emi" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(initialResult.emiRounded)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Loan Amount (Principal)</span>
          <span id="hl-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialLoan)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Down Payment</span>
          <span id="hl-result-down" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.price * 0.2)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest</span>
          <span id="hl-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(initialResult.totalInterest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Payment</span>
          <span id="hl-result-total" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.totalPayment)}</span>
        </div>
      </div>

      <div class="mb-5" id="hl-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.principalFraction}
          gainFraction={initialResult.interestFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(initialLoan)}
          gainValue={fmt(initialResult.totalInterest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="hl-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="hl-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- 1. How it works -->
      <section aria-labelledby="home-loan-calculator-how">
        <h2 id="home-loan-calculator-how" class="text-xl font-bold text-text-primary mb-4">How home loan EMI is computed</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          A home loan EMI (Equated Monthly Instalment) is a fixed monthly payment made to your lender over a specified loan tenure. Housing finance institutions use the <strong>reducing balance method</strong>, where monthly interest is calculated only on the remaining unpaid principal balance at the end of each billing cycle.
        </p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Your loan principal equals the total property purchase price minus your upfront down payment. The standard mathematical formula for monthly EMI is:
        </p>

        <!-- Formula block -->
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">EMI = [P &times; r &times; (1 + r)<sup>n</sup>] &divide; [(1 + r)<sup>n</sup> &minus; 1]</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">P</strong> &mdash; Principal loan amount borrowed = Property Cost &minus; Down Payment</li>
            <li><strong class="text-text-primary">r</strong> &mdash; Monthly periodic interest rate = Annual Interest Rate / 12 / 100</li>
            <li><strong class="text-text-primary">n</strong> &mdash; Total repayment tenure in months = Years &times; 12</li>
          </ul>
        </div>
      </section>

      <!-- 2. Step-by-Step Worked Example -->
      <section aria-labelledby="home-loan-calculator-example">
        <h2 id="home-loan-calculator-example" class="text-xl font-bold text-text-primary mb-4">Worked example: ₹50 Lakh property, 20% down payment, 8.5% p.a. for 20 years</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an individual purchasing a home valued at ₹50,00,000 with a 20% down payment, financing the balance at 8.5% per annum over 20 years:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 text-sm text-text-muted space-y-2">
          <p><strong class="text-text-primary">1. Property Purchase Price:</strong> ₹50,00,000</p>
          <p><strong class="text-text-primary">2. Down Payment (20%):</strong> 0.20 &times; ₹50,00,000 = <strong class="text-text-primary">₹10,00,000</strong></p>
          <p><strong class="text-text-primary">3. Net Loan Amount (Principal P):</strong> ₹50,00,000 &minus; ₹10,00,000 = <strong class="text-text-primary">₹40,00,000</strong></p>
          <p><strong class="text-text-primary">4. Monthly Periodic Rate (r):</strong> 8.5 / 1200 &asymp; 0.0070833</p>
          <p><strong class="text-text-primary">5. Total Repayment Months (n):</strong> 20 &times; 12 = 240 months</p>
          <p><strong class="text-text-primary">6. Monthly Equated Instalment (EMI):</strong> <strong class="text-text-primary text-accent">₹34,713</strong></p>
          <p><strong class="text-text-primary">7. Total Repayment Over 20 Years:</strong> 240 &times; ₹34,712.93 = <strong class="text-text-primary">₹83,31,103</strong></p>
          <p><strong class="text-text-primary">8. Cumulative Lifetime Interest Paid:</strong> ₹83,31,103 &minus; ₹40,00,000 = <strong class="text-text-primary text-accent">₹43,31,103</strong></p>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          <strong>Key Insight:</strong> Over a standard 20-year term, total interest paid (₹43.31 lakh) actually exceeds the original borrowed loan amount (₹40 lakh). Making occasional partial prepayments directly accelerates principal retirement and dramatically compresses total interest.
        </p>
      </section>

      <!-- 3. Interpreting Your Results -->
      <section aria-labelledby="home-loan-calculator-interpretation">
        <h2 id="home-loan-calculator-interpretation" class="text-xl font-bold text-text-primary mb-4">Interpreting your home loan repayment breakdown</h2>
        <div class="space-y-3 text-sm text-text-muted leading-relaxed">
          <p>
            <strong class="text-text-primary">Front-Loaded Interest Schedule:</strong> Because interest is charged on the outstanding loan balance, the initial years of your home loan are heavily interest-weighted. In the first 3 years, approximately 65% to 70% of every monthly EMI pays interest, with only 30% reducing the principal balance.
          </p>
          <p>
            <strong class="text-text-primary">Leverage and Down Payment Impact:</strong> Increasing your down payment from 20% (₹10 lakh) to 30% (₹15 lakh) reduces the loan amount to ₹35 lakh. This cuts your monthly EMI from ₹34,713 down to ₹30,374 (saving ₹4,339/month) and reduces total lifetime interest by ₹5,41,388.
          </p>
        </div>
      </section>

      <!-- 4. Key Assumptions and Limitations -->
      <section aria-labelledby="home-loan-calculator-assumptions">
        <h2 id="home-loan-calculator-assumptions" class="text-xl font-bold text-text-primary mb-4">Key assumptions and limitations</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-text-muted leading-relaxed">
          <li>
            <strong class="text-text-primary">Fixed Interest Rate Assumption:</strong> Models a steady 8.5% annual rate. Most consumer home loans operate on floating rates pegged to benchmark external rates (e.g. RBI repo rate via EBLR in India, or SOFR in the US); adjustments will alter future EMI amounts or tenure.
          </li>
          <li>
            <strong class="text-text-primary">Incidental Costs Excluded:</strong> Calculation covers loan principal and interest only. It does not include stamp duty (typically 5%–7%), registration fees, bank processing fees, mortgage insurance, or property taxes.
          </li>
          <li>
            <strong class="text-text-primary">Tax Relief Caveats:</strong> Tax benefits under Section 24(b) (up to ₹2 lakh interest deduction) and Section 80C (up to ₹1.5 lakh principal deduction) apply under India's Old Tax Regime for self-occupied properties and are subject to statutory eligibility rules.
          </li>
        </ul>
      </section>

      <section aria-labelledby="home-loan-calculator-faq">
        <h2 id="home-loan-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="home-loan-calculator-related">
        <h2 id="home-loan-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcEMI } from '../lib/calculators/emi';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initHLCalc() {
    if ((window as any).__cmHlBound) return;
    (window as any).__cmHlBound = true;

    const priceInput = document.getElementById('hl-price') as HTMLInputElement | null;
    const downInput = document.getElementById('hl-down') as HTMLInputElement | null;
    const rateInput = document.getElementById('hl-rate') as HTMLInputElement | null;
    const yearsInput = document.getElementById('hl-years') as HTMLInputElement | null;
    const priceSlider = document.getElementById('hl-price-slider') as HTMLInputElement | null;
    const downSlider = document.getElementById('hl-down-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('hl-rate-slider') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('hl-years-slider') as HTMLInputElement | null;

    const resEMI = document.getElementById('hl-result-emi');
    const resPrincipal = document.getElementById('hl-result-principal');
    const resDown = document.getElementById('hl-result-down');
    const resInterest = document.getElementById('hl-result-interest');
    const resTotal = document.getElementById('hl-result-total');

    const errAlert = document.getElementById('hl-error-alert');
    const errMsg = document.getElementById('hl-error-msg');

    if (!priceInput || !downInput || !rateInput || !yearsInput) return;

    const DEFAULTS = { price: 5000000, downPct: 20, rate: 8.5, years: 20 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawPrice = priceInput!.value.replace(/[^0-9.]/g, '');
      const rawDown = downInput!.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput!.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput!.value.replace(/[^0-9.]/g, '');

      const vPrice = validate(rawPrice, { required: true, min: 100000, label: 'Property Price' });
      const vDown = validate(rawDown, { required: true, min: 0, max: 95, decimal: true, label: 'Down Payment %' });
      const vRate = validate(rawRate, { required: true, min: 0.1, max: 30, decimal: true, label: 'Interest Rate' });
      const vYears = validate(rawYears, { required: true, min: 1, max: 40, integer: true, label: 'Tenure' });

      if (!vPrice.valid) { showError(vPrice.error!.message); return; }
      if (!vDown.valid) { showError(vDown.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      if (!vYears.valid) { showError(vYears.error!.message); return; }
      clearError();

      const price = vPrice.value!;
      const downPct = vDown.value!;
      const rate = vRate.value!;
      const years = vYears.value!;

      const downAmt = price * (downPct / 100);
      const loan = Math.max(0, price - downAmt);
      const res = calcEMI(loan, rate, years);

      setResult({
        heroValue: fmtVal(res.emiRounded),
        heroLabel: 'Monthly EMI',
        rows: [
          { label: 'Loan Amount (Principal)', value: fmtVal(loan) },
          { label: 'Down Payment', value: fmtVal(downAmt) },
          { label: 'Total Interest', value: fmtVal(res.totalInterest) },
          { label: 'Total Payment', value: fmtVal(res.totalPayment) },
        ],
      });

      if (resEMI) resEMI.textContent = fmtVal(res.emiRounded);
      if (resPrincipal) resPrincipal.textContent = fmtVal(loan);
      if (resDown) resDown.textContent = fmtVal(downAmt);
      if (resInterest) resInterest.textContent = fmtVal(res.totalInterest);
      if (resTotal) resTotal.textContent = fmtVal(res.totalPayment);

      const wrapper = document.getElementById('hl-composition-wrapper');
      if (wrapper && res.totalPayment > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${Math.min(100, res.principalFraction * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(loan);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalInterest);
      }

      serializeHash({ p: price, d: downPct, r: rate, y: years });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider || !input) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(priceSlider, priceInput, true);
    sync(downSlider, downInput, false);
    sync(rateSlider, rateInput, false);
    sync(yearsSlider, yearsInput, false);

    document.getElementById('hl-calculate')?.addEventListener('click', recalc);
    document.getElementById('hl-reset')?.addEventListener('click', () => {
      priceInput.value = fmtLiveInput(String(DEFAULTS.price));
      downInput.value = String(DEFAULTS.downPct);
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);
      if (priceSlider) {
        priceSlider.value = String(DEFAULTS.price);
        priceSlider.style.setProperty('--slider-pct', `${((DEFAULTS.price - 500000) / (50000000 - 500000)) * 100}%`);
      }
      if (downSlider) {
        downSlider.value = String(DEFAULTS.downPct);
        downSlider.style.setProperty('--slider-pct', `${((DEFAULTS.downPct - 10) / (80 - 10)) * 100}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 6.5) / (15 - 6.5)) * 100}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (30 - 1)) * 100}%`);
      }
      clearError();
      recalc();
      priceInput.focus();
    });

    [priceInput, downInput, rateInput, yearsInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('hl-copy-btn')?.addEventListener('click', async () => {
      const rawPrice = priceInput.value.replace(/[^0-9.]/g, '');
      const rawDown = downInput.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput.value.replace(/[^0-9.]/g, '');

      const vPrice = validate(rawPrice, { required: true, min: 100000, label: 'Property Price' });
      const vDown = validate(rawDown, { required: true, min: 0, max: 95, label: 'Down Payment' });
      const vRate = validate(rawRate, { required: true, min: 0.1, label: 'Rate' });
      const vYears = validate(rawYears, { required: true, min: 1, label: 'Tenure' });

      if (!vPrice.valid || !vDown.valid || !vRate.valid || !vYears.valid) return;

      const loan = vPrice.value! * (1 - vDown.value! / 100);
      const res = calcEMI(loan, vRate.value!, vYears.value!);
      const text = `Home Loan EMI: ${fmtVal(res.emiRounded)}/month on property value of ${fmtVal(vPrice.value!)} (${vDown.value}% down, ${vRate.value}% for ${vYears.value} yrs). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('hl-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('hl-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('hl-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      p: { required: true, min: 100000, label: 'p' },
      d: { required: true, min: 0, max: 95, decimal: true, label: 'd' },
      r: { required: true, min: 0.1, max: 30, decimal: true, label: 'r' },
      y: { required: true, min: 1, max: 40, integer: true, label: 'y' },
    });
    if (restored.valid && restored.values.p && restored.values.d !== undefined && restored.values.r !== undefined && restored.values.y) {
      priceInput.value = fmtLiveInput(String(restored.values.p));
      downInput.value = String(restored.values.d);
      rateInput.value = String(restored.values.r);
      yearsInput.value = String(restored.values.y);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initHLCalc();
  document.addEventListener('astro:page-load', initHLCalc);
</script>
