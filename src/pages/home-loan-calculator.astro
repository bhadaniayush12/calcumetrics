---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { TOOLS } from '../config/site';

const related = TOOLS.filter((t) => t.category === 'Loans' && t.slug !== 'home-loan-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/home-loan-calculator';
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'Home Loan Calculator', url: canonicalUrl, description: 'Calculate your home loan EMI, total interest paid, and year-by-year amortization schedule for any loan amount, rate, and tenure.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' }, { '@type': 'ListItem', position: 3, name: 'Home Loan Calculator' }] }] };
---
<Layout title="Home Loan Calculator: EMI & Total Interest | Calcumetrics" description="Calculate your home loan EMI, total interest paid, and year-by-year amortization schedule for any loan amount, rate, and tenure." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="Home Loan Calculator" category="Loans" categoryHref="/loans" heroValue="Calculate to see" heroLabel="Monthly EMI">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Home Loan Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate your home loan EMI, total interest paid, and year-by-year amortization schedule for any loan amount, rate, and tenure.</p>
      <Alert variant="info" title="Assumption">Results are estimates for information only. Not financial advice.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" type="button">Calculate</Button><Button variant="ghost" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">Calculate to see</div>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="home-loan-calculator-how">
        <h2 id="home-loan-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Calculate your home loan EMI, total interest paid, and year-by-year amortization schedule for any loan amount, rate, and tenure.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted">EMI = P × r × (1+r)^n / ((1+r)^n − 1). For home loans: n = years × 12, r = annual rate / 12 / 100. The amortization schedule shows each year's principal and interest breakdown.</p>
        </div>
      </section>
      <section aria-labelledby="home-loan-calculator-faq">
        <h2 id="home-loan-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the ideal home loan tenure?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">A shorter tenure means higher EMI but significantly lower total interest. A longer tenure lowers monthly burden but increases total cost. A common strategy is to take a longer tenure initially for affordability, then make prepayments as income grows to reduce the effective tenure.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can I claim tax benefits on home loan interest?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Under India's Income Tax Act, 2025, interest on home loans may be deductible from income from house property. Principal repayment may qualify under Section 80C. Eligibility and limits have changed from the 1961 Act — consult a CA or tax professional for your specific situation.</div></details>
        </div>
      </section>
      <section aria-labelledby="home-loan-calculator-related">
        <h2 id="home-loan-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
