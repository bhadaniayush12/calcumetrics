---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcProfitMargin } from '../lib/calculators/business';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { revenue: 1000000, cogs: 600000, opex: 150000, taxes: 50000 };
const initialResult = calcProfitMargin(DEFAULT.revenue, DEFAULT.cogs, DEFAULT.opex, DEFAULT.taxes);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'profit-margin-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/profit-margin-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Profit Margin Calculator',
      url: canonicalUrl,
      description: 'Calculate gross profit margin, net profit margin, and operating profit from revenue and cost inputs with comprehensive cost breakdown.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'Profit Margin Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a good net profit margin benchmark across industries?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Profit margins vary widely by industry. Software and technology companies often achieve 20% to 30% net margins due to low incremental unit costs. Manufacturing firms typically average 8% to 15%, while grocery retail operates on thin 2% to 4% margins balanced by high inventory turnover.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the key difference between gross margin and net margin?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Gross margin evaluates product profitability after deducting only direct production costs (COGS) from revenue. Net margin evaluates overall company profitability after deducting all operational overheads (OpEx), administrative expenses, debt interest, and income taxes.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why might a company have high gross margin but low net margin?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'This common divergence indicates excessive operating expenses, such as bloated administrative payroll, aggressive customer acquisition (marketing) spend, expensive office leases, or heavy debt service draining gross earnings.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I calculate operating profit margin?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Operating profit margin (EBIT margin) is calculated as: Operating Profit ÷ Total Revenue × 100, where Operating Profit = Gross Profit − Operating Expenses (OpEx). It isolates core business operating efficiency prior to non-operating items like capital structure financing and taxes.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can net profit margin be negative?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. If total direct costs, operating overheads, interest, and taxes exceed total revenue, the net profit is negative, reflecting an operating net loss for the reporting period.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Profit Margin Calculator: Gross & Net Margin Analysis | Calcumetrics"
  description="Calculate gross profit margin, net profit margin, and operating profit from revenue and cost inputs with comprehensive cost breakdown."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Profit Margin Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={initialResult.netMarginPct.toFixed(1) + '%'}
    heroLabel="Net Profit Margin"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Profit Margin Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate gross and net profit margins, operating overheads, and true bottom-line profitability.</p>

      <!-- Error alert -->
      <div id="pm-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="pm-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Revenue -->
      <div class="mb-5">
        <Input
          id="pm-revenue"
          label="Total Revenue"
          prefix="₹"
          value="10,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross sales or total billings"
          inputmode="decimal"
          aria-describedby="pm-error-msg"
        />
        <div class="mt-2">
          <Slider id="pm-revenue-slider" min={50000} max={10000000} step={25000} value={1000000} ariaLabel="Revenue slider" />
        </div>
      </div>

      <!-- COGS -->
      <div class="mb-5">
        <Input
          id="pm-cogs"
          label="Cost of Goods Sold (COGS)"
          prefix="₹"
          value="6,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Direct raw materials, manufacturing, and direct labor"
          inputmode="decimal"
          aria-describedby="pm-error-msg"
        />
        <div class="mt-2">
          <Slider id="pm-cogs-slider" min={10000} max={8000000} step={25000} value={600000} ariaLabel="COGS slider" />
        </div>
      </div>

      <!-- OpEx -->
      <div class="mb-5">
        <Input
          id="pm-opex"
          label="Operating Expenses (OpEx)"
          prefix="₹"
          value="1,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Rent, marketing, utilities, and administrative salaries"
          inputmode="decimal"
          aria-describedby="pm-error-msg"
        />
        <div class="mt-2">
          <Slider id="pm-opex-slider" min={0} max={3000000} step={10000} value={150000} ariaLabel="OpEx slider" />
        </div>
      </div>

      <!-- Taxes & Interest -->
      <div class="mb-6">
        <Input
          id="pm-taxes"
          label="Taxes & Interest Expense"
          prefix="₹"
          value="50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Corporate income tax and loan financing costs"
          inputmode="decimal"
          aria-describedby="pm-error-msg"
        />
        <div class="mt-2">
          <Slider id="pm-taxes-slider" min={0} max={1000000} step={5000} value={50000} ariaLabel="Taxes slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="pm-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="pm-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Net Profit Margin</span>
        <div id="pm-result-netmargin" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {initialResult.netMarginPct.toFixed(1)}%
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Profit Amount</span>
          <span id="pm-result-netprofit" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.netProfit)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Profit</span>
          <span id="pm-result-grossprofit" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.grossProfit)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Profit Margin</span>
          <span id="pm-result-grossmargin" class="text-sm font-medium tabular-nums text-dark-text">{initialResult.grossMarginPct.toFixed(1)}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Operating Profit (EBIT)</span>
          <span id="pm-result-operatingprofit" class="text-sm font-bold tabular-nums text-dark-text">{fmt(initialResult.operatingProfit)}</span>
        </div>
      </div>

      <div class="mb-5" id="pm-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.revenue > 0 ? (initialResult.cogs + initialResult.opex + initialResult.taxes) / initialResult.revenue : 1}
          gainFraction={initialResult.revenue > 0 ? Math.max(0, initialResult.netProfit / initialResult.revenue) : 0}
          principalLabel="Total Costs"
          gainLabel="Net Profit"
          principalValue={fmt(initialResult.cogs + initialResult.opex + initialResult.taxes)}
          gainValue={fmt(initialResult.netProfit)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="pm-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="pm-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">COGS = Direct production costs; OpEx = Indirect operating overheads.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="pm-calculator-how">
        <h2 id="pm-calculator-how" class="text-xl font-bold text-text-primary mb-4">How profit margins are calculated</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">
            <strong>Gross Profit:</strong> Revenue − Cost of Goods Sold (COGS)<br />
            <strong>Gross Margin %:</strong> (Gross Profit ÷ Revenue) × 100<br />
            <strong>Operating Profit:</strong> Gross Profit − Operating Expenses (OpEx)<br />
            <strong>Net Profit:</strong> Operating Profit − Taxes & Interest<br />
            <strong>Net Margin %:</strong> (Net Profit ÷ Revenue) × 100
          </p>
        </div>
      </section>

      <section aria-labelledby="pm-calculator-faq">
        <h2 id="pm-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="pm-calculator-related">
        <h2 id="pm-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcProfitMargin } from '../lib/calculators/business';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initProfitMarginCalc() {
    if ((window as any).__cmPmBound) return;
    (window as any).__cmPmBound = true;

    const revInput = document.getElementById('pm-revenue') as HTMLInputElement | null;
    const cogsInput = document.getElementById('pm-cogs') as HTMLInputElement | null;
    const opexInput = document.getElementById('pm-opex') as HTMLInputElement | null;
    const taxesInput = document.getElementById('pm-taxes') as HTMLInputElement | null;

    const revSlider = document.getElementById('pm-revenue-slider') as HTMLInputElement | null;
    const cogsSlider = document.getElementById('pm-cogs-slider') as HTMLInputElement | null;
    const opexSlider = document.getElementById('pm-opex-slider') as HTMLInputElement | null;
    const taxesSlider = document.getElementById('pm-taxes-slider') as HTMLInputElement | null;

    const resNetMargin = document.getElementById('pm-result-netmargin');
    const resGrossProfit = document.getElementById('pm-result-grossprofit');
    const resGrossMargin = document.getElementById('pm-result-grossmargin');
    const resOpProfit = document.getElementById('pm-result-operatingprofit');
    const resNetProfit = document.getElementById('pm-result-netprofit');

    const errAlert = document.getElementById('pm-error-alert');
    const errMsg = document.getElementById('pm-error-msg');

    if (!revInput || !cogsInput) return;

    const DEFAULTS = { revenue: 1000000, cogs: 600000, opex: 150000, taxes: 50000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawRev = revInput!.value.replace(/[^0-9.]/g, '');
      const rawCogs = cogsInput!.value.replace(/[^0-9.]/g, '');
      const rawOpex = opexInput ? opexInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawTaxes = taxesInput ? taxesInput.value.replace(/[^0-9.]/g, '') : '0';

      const vRev = validate(rawRev, { required: true, min: 1, label: 'Revenue' });
      const vCogs = validate(rawCogs, { required: true, min: 0, label: 'COGS' });
      const vOpex = validate(rawOpex, { required: true, min: 0, label: 'OpEx' });
      const vTaxes = validate(rawTaxes, { required: true, min: 0, label: 'Taxes' });

      if (!vRev.valid) { showError(vRev.error!.message); return; }
      if (!vCogs.valid) { showError(vCogs.error!.message); return; }
      if (!vOpex.valid) { showError(vOpex.error!.message); return; }
      if (!vTaxes.valid) { showError(vTaxes.error!.message); return; }
      clearError();

      const rev = vRev.value!;
      const cogs = vCogs.value!;
      const opex = vOpex.value!;
      const taxes = vTaxes.value!;

      const res = calcProfitMargin(rev, cogs, opex, taxes);

      setResult({
        heroValue: `${res.netMarginPct.toFixed(1)}%`,
        heroLabel: 'Net Profit Margin',
        rows: [
          { label: 'Net Profit', value: fmtVal(res.netProfit) },
          { label: 'Gross Profit', value: fmtVal(res.grossProfit) },
          { label: 'Gross Margin', value: `${res.grossMarginPct.toFixed(1)}%` },
          { label: 'Operating Profit', value: fmtVal(res.operatingProfit) },
        ],
      });

      if (resNetMargin) resNetMargin.textContent = `${res.netMarginPct.toFixed(1)}%`;
      if (resGrossProfit) resGrossProfit.textContent = fmtVal(res.grossProfit);
      if (resGrossMargin) resGrossMargin.textContent = `${res.grossMarginPct.toFixed(1)}%`;
      if (resOpProfit) resOpProfit.textContent = fmtVal(res.operatingProfit);
      if (resNetProfit) resNetProfit.textContent = fmtVal(res.netProfit);

      const wrapper = document.getElementById('pm-composition-wrapper');
      if (wrapper && rev > 0) {
        const totalCosts = cogs + opex + taxes;
        const costFrac = Math.min(1, totalCosts / rev);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(costFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(totalCosts);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.netProfit);
      }

      serializeHash({ r: rev, c: cogs, o: opex, t: taxes });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(revSlider, revInput);
    sync(cogsSlider, cogsInput);
    sync(opexSlider, opexInput!);
    sync(taxesSlider, taxesInput!);

    document.getElementById('pm-calculate')?.addEventListener('click', recalc);
    document.getElementById('pm-reset')?.addEventListener('click', () => {
      revInput.value = fmtLiveInput(String(DEFAULTS.revenue));
      cogsInput.value = fmtLiveInput(String(DEFAULTS.cogs));
      if (opexInput) opexInput.value = fmtLiveInput(String(DEFAULTS.opex));
      if (taxesInput) taxesInput.value = fmtLiveInput(String(DEFAULTS.taxes));

      if (revSlider) {
        revSlider.value = String(DEFAULTS.revenue);
        revSlider.style.setProperty('--slider-pct', `${((DEFAULTS.revenue - 50000) / (10000000 - 50000)) * 100}%`);
      }
      if (cogsSlider) {
        cogsSlider.value = String(DEFAULTS.cogs);
        cogsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.cogs - 10000) / (8000000 - 10000)) * 100}%`);
      }
      if (opexSlider) {
        opexSlider.value = String(DEFAULTS.opex);
        opexSlider.style.setProperty('--slider-pct', `${((DEFAULTS.opex - 0) / (3000000 - 0)) * 100}%`);
      }
      if (taxesSlider) {
        taxesSlider.value = String(DEFAULTS.taxes);
        taxesSlider.style.setProperty('--slider-pct', `${((DEFAULTS.taxes - 0) / (1000000 - 0)) * 100}%`);
      }

      clearError();
      recalc();
      revInput.focus();
    });

    [revInput, cogsInput, opexInput, taxesInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('pm-copy-btn')?.addEventListener('click', async () => {
      const rawRev = revInput.value.replace(/[^0-9.]/g, '');
      const rawCogs = cogsInput.value.replace(/[^0-9.]/g, '');
      const rawOpex = opexInput ? opexInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawTaxes = taxesInput ? taxesInput.value.replace(/[^0-9.]/g, '') : '0';

      const vRev = validate(rawRev, { required: true, min: 1, label: 'Revenue' });
      const vCogs = validate(rawCogs, { required: true, min: 0, label: 'COGS' });
      const vOpex = validate(rawOpex, { required: true, min: 0, label: 'OpEx' });
      const vTaxes = validate(rawTaxes, { required: true, min: 0, label: 'Taxes' });

      if (!vRev.valid || !vCogs.valid || !vOpex.valid || !vTaxes.valid) return;

      const res = calcProfitMargin(vRev.value!, vCogs.value!, vOpex.value!, vTaxes.value!);
      const text = `Profit Margin: Revenue ${fmtVal(vRev.value!)}, COGS ${fmtVal(vCogs.value!)} => Gross Margin: ${res.grossMarginPct.toFixed(1)}%, Net Margin: ${res.netMarginPct.toFixed(1)}% (${fmtVal(res.netProfit)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pm-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('pm-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('pm-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      r: { required: true, min: 1, label: 'r' },
      c: { required: true, min: 0, label: 'c' },
      o: { required: true, min: 0, label: 'o' },
      t: { required: true, min: 0, label: 't' },
    });
    if (restored.valid && restored.values.r && restored.values.c !== undefined && restored.values.o !== undefined && restored.values.t !== undefined) {
      revInput.value = fmtLiveInput(String(restored.values.r));
      cogsInput.value = fmtLiveInput(String(restored.values.c));
      if (opexInput) opexInput.value = fmtLiveInput(String(restored.values.o));
      if (taxesInput) taxesInput.value = fmtLiveInput(String(restored.values.t));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initProfitMarginCalc();
  document.addEventListener('astro:page-load', initProfitMarginCalc);
</script>
