---
import Layout from '../layouts/Layout.astro';
const canonicalUrl = 'https://calcumetrics.com/terms';
---
<Layout title="Terms of Use | Calcumetrics" description="Terms and conditions for using the Calcumetrics financial calculator website." canonical={canonicalUrl}>
  <div class="max-w-[700px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-xs text-text-muted mb-2">Last updated: 20 September 2026</p>
    <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-6">Terms of Use</h1>
    <p class="text-sm text-text-muted leading-relaxed mb-4">Effective date: 20 September 2026. By using this website, you agree to these terms.</p>
      <h2 class="text-xl font-bold text-text-primary mt-8 mb-3">1. Acceptable use</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-4">You may use Calcumetrics for personal, educational, or professional planning purposes. You may not scrape, reproduce, or redistribute our content commercially without written permission.</p>
      <h2 class="text-xl font-bold text-text-primary mt-8 mb-3">2. No warranty</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-4">This site is provided &ldquo;as is&rdquo; without any warranty. Results are estimates based on stated assumptions. We do not warrant that the results are accurate, complete, or suitable for any particular purpose.</p>
      <h2 class="text-xl font-bold text-text-primary mt-8 mb-3">3. Limitation of liability</h2>
