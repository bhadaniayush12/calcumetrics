---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import CountryRules from '../components/calculator/CountryRules.astro';
import { calcCreditCardPayoff } from '../lib/finance/amortization';
import { CURRENCY_CONFIG, type CurrencyCode } from '../lib/currency';
import { getCalculatorDefaults } from '../data/market-defaults';
import { TOOLS } from '../config/site';

// Server render uses the USD market defaults (like the mortgage page); the client swaps
// symbol, grouping and defaults for the selected currency.
const usdDefaults = getCalculatorDefaults('credit-card-payoff', 'USD');
const DEFAULT = { balance: usdDefaults['cc-balance'].value, apr: usdDefaults['cc-apr'].value, payment: usdDefaults['cc-payment'].value };
const result = calcCreditCardPayoff(DEFAULT.balance, DEFAULT.apr, DEFAULT.payment);

const moneyIn = (code: CurrencyCode) => (n: number) =>
  CURRENCY_CONFIG[code].symbol + new Intl.NumberFormat(CURRENCY_CONFIG[code].locale, { maximumFractionDigits: 0 }).format(Math.round(n));
const fmtCurrency = moneyIn('USD');
const fmtInput = (n: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n);

// Worked examples from the engine with each market's defaults. USD is shown by default;
// the INR version is shown only to INR visitors.
const CONSOLIDATION_APR: Partial<Record<CurrencyCode, number>> = { USD: 12, INR: 13 };
function buildExample(code: CurrencyCode) {
  const d = getCalculatorDefaults('credit-card-payoff', code);
  const balance = d['cc-balance'].value, apr = d['cc-apr'].value, payment = d['cc-payment'].value;
  const money = moneyIn(code);
  const res = calcCreditCardPayoff(balance, apr, payment);
  const monthlyPct = apr / 12;
  const m1Interest = (balance * monthlyPct) / 100;
  const m1Principal = payment - m1Interest;
  const m2Interest = ((balance - m1Principal) * monthlyPct) / 100;
  const ear = (Math.pow(1 + apr / 1200, 12) - 1) * 100;
  const fastPayment = payment * 1.5;
  const fast = calcCreditCardPayoff(balance, apr, fastPayment);
  const loanApr = CONSOLIDATION_APR[code] ?? 12;
  const loanInterest = (balance * loanApr) / 1200;
  return { code, balance, apr, payment, money, res, monthlyPct, m1Interest, m1Principal, m2Interest, ear, fastPayment, fast, loanApr, loanInterest };
}
const examples = [buildExample('USD'), buildExample('INR')];

const related = TOOLS.filter((t) => t.category === 'Loans' && t.slug !== 'credit-card-payoff-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/credit-card-payoff-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Credit Card Payoff Calculator',
      url: canonicalUrl,
      description: 'Free credit card payoff calculator to compute payoff duration, credit card debt payoff savings, and monthly debt amortization schedules.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Credit Card Payoff Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What happens if I only pay the minimum due on my credit card?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Paying only the minimum due can stretch repayment over many years, because most of each payment covers interest and fees and only a small slice reduces the balance. How the minimum is set varies by country and card issuer (see the country boxes on this page).',
          },
        },
        {
          '@type': 'Question',
          name: 'Why are credit card interest rates (APR) so high?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Credit cards are unsecured revolving debt with no collateral. To offset higher default risk, card issuers charge far more than secured loans; typical purchase APRs differ by country, so check the rate on your statement.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the debt avalanche method?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The debt avalanche strategy prioritizes paying down the credit card or loan with the highest interest rate first while making minimum required payments on others. Mathematically, this minimizes total interest paid across all liabilities.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does a balance transfer card or personal loan help?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Moving high-APR card debt to a lower-rate personal loan or a 0% introductory balance transfer card cuts the monthly interest charge, so more of each payment reduces the balance. Watch for transfer fees and the rate after the introductory period ends.',
          },
        },
        {
          '@type': 'Question',
          name: 'What does "insufficient payment" mean in this calculator?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If your monthly payment is less than or equal to the monthly interest accrued on your balance, the loan balance will never decline and the payoff period becomes mathematically infinite.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Credit Card Payoff Calculator: Debt-Free Date | Calcumetrics"
  description="Free credit card payoff calculator. Use this credit card debt payoff calculator to find payoff duration, interest savings, and debt-free schedules."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Credit Card Payoff Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={result.paymentSufficient ? `${result.payoffMonths} Months` : 'Infinite'}
    heroLabel="Payoff Duration"
    calcType="simple"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Credit Card Payoff Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Find out exactly how long it takes to pay off your card balance and how much interest you will save.</p>

      <!-- Error alert -->
      <div id="cc-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="cc-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Current Balance -->
      <div class="mb-5">
        <Input
          id="cc-balance"
          label="Current Outstanding Balance"
          prefix="$"
          value={fmtInput(DEFAULT.balance)}
          isNumeric={true}
          localeFormat="international"
          helperText="Total credit card balance to eliminate"
          inputmode="decimal"
          aria-describedby="cc-error-msg"
        />
        <div class="mt-2">
          <Slider id="cc-balance-slider" min={usdDefaults['cc-balance'].min} max={usdDefaults['cc-balance'].max} step={usdDefaults['cc-balance'].step} value={DEFAULT.balance} ariaLabel="Card balance slider" />
        </div>
      </div>

      <!-- Interest Rate (APR) -->
      <div class="mb-5">
        <Input
          id="cc-apr"
          label="Annual Interest Rate (APR)"
          suffix="%"
          value={String(DEFAULT.apr)}
          isNumeric={true}
          helperText="Purchase APR shown on your card statement"
          inputmode="decimal"
          aria-describedby="cc-error-msg"
        />
        <div class="mt-2">
          <Slider id="cc-apr-slider" min={usdDefaults['cc-apr'].min} max={usdDefaults['cc-apr'].max} step={usdDefaults['cc-apr'].step} value={DEFAULT.apr} ariaLabel="APR slider" />
        </div>
      </div>

      <!-- Monthly Payment -->
      <div class="mb-6">
        <Input
          id="cc-payment"
          label="Planned Monthly Payment"
          prefix="$"
          value={fmtInput(DEFAULT.payment)}
          isNumeric={true}
          localeFormat="international"
          helperText="Fixed amount you plan to pay each month"
          inputmode="decimal"
          aria-describedby="cc-error-msg"
        />
        <div class="mt-2">
          <Slider id="cc-payment-slider" min={usdDefaults['cc-payment'].min} max={usdDefaults['cc-payment'].max} step={usdDefaults['cc-payment'].step} value={DEFAULT.payment} ariaLabel="Monthly payment slider" />
        </div>
      </div>

      <div class="flex gap-3">
        <Button variant="primary" id="cc-calculate" type="button">See Debt-Free Timeline</Button>
        <Button variant="ghost" id="cc-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Time to Zero Debt</span>
        <div id="cc-result-months" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {result.paymentSufficient ? `${result.payoffMonths} Months` : 'Infinite'}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest Paid</span>
          <span id="cc-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{isFinite(result.totalInterest) ? fmtCurrency(result.totalInterest) : 'Infinite'}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Amount Paid</span>
          <span id="cc-result-total" class="text-sm font-medium tabular-nums text-dark-text">{isFinite(result.totalPaid) ? fmtCurrency(result.totalPaid) : 'Infinite'}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Original Balance</span>
          <span id="cc-result-balance" class="text-sm font-medium tabular-nums text-dark-text">{fmtCurrency(result.balance)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Time in Years</span>
          <span id="cc-result-years" class="text-sm font-bold tabular-nums text-dark-text">{isFinite(result.payoffMonths) ? (result.payoffMonths / 12).toFixed(1) + ' Years' : 'Never'}</span>
        </div>
      </div>

      <div class="mb-5" id="cc-composition-wrapper">
        <CompositionBar
          principalFraction={isFinite(result.totalPaid) && result.totalPaid > 0 ? result.balance / result.totalPaid : 0.5}
          gainFraction={isFinite(result.totalPaid) && result.totalPaid > 0 ? result.totalInterest / result.totalPaid : 0.5}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmtCurrency(result.balance)}
          gainValue={isFinite(result.totalInterest) ? fmtCurrency(result.totalInterest) : '—'}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cc-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cc-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes no additional purchases are made on the card while paying off the balance.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="cc-calculator-how">
        <h2 id="cc-calculator-how" class="text-xl font-bold text-text-primary mb-4">How credit card amortization works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Credit cards represent unsecured revolving credit where interest accrues daily on outstanding balances. Each monthly payment is applied first toward billing charges and accrued interest, with only the residual cash reducing principal:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed font-mono">
            <strong>1. Monthly Periodic Rate:</strong> r = Annual Interest Rate (APR %) &divide; 12 &divide; 100<br /><br />
            <strong>2. Accrued Monthly Interest:</strong> I<sub>t</sub> = Outstanding Balance<sub>t</sub> &times; r<br /><br />
            <strong>3. Payoff Duration Formula:</strong> n = &minus;ln[ 1 &minus; (r &times; P &divide; PMT) ] &divide; ln(1 + r)<br /><br />
            <strong>4. Solvency Requirement:</strong> Monthly Payment (PMT) &gt; Initial Monthly Interest (P &times; r)<br /><br />
            <strong>5. Total Financing Outflow:</strong> Total Paid = PMT &times; n<br /><br />
            <strong>6. Cumulative Interest Burden:</strong> Total Interest = Total Paid &minus; Original Balance (P)
          </p>
        </div>

        {examples.map((ex) => (
          <div {...(ex.code === 'INR' ? { 'data-inr-only': '', class: 'hidden' } : { 'data-non-inr-only': '' })}>
            <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-Step Worked Example (Default Scenario{ex.code === 'INR' ? ', India' : ''})</h3>
            <p class="text-sm text-text-muted leading-relaxed mb-3">
              Consider an outstanding credit card balance of <strong>{ex.money(ex.balance)}</strong> at an APR of <strong>{ex.apr.toFixed(2)}%</strong> ({ex.monthlyPct.toFixed(2)}% per month) with a fixed payment of <strong>{ex.money(ex.payment)} per month</strong>:
            </p>
            <div class="overflow-x-auto border border-border rounded-card mb-6">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="bg-surface border-b border-border text-text-primary font-semibold">
                    <th class="py-2.5 px-4">Payoff Metric / Milestone</th>
                    <th class="py-2.5 px-4">Calculation / Methodology</th>
                    <th class="py-2.5 px-4">Computed Output</th>
                    <th class="py-2.5 px-4">Financial Consequence</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border text-text-muted">
                  <tr>
                    <td class="py-2.5 px-4 font-medium text-text-primary">Starting Balance (P)</td>
                    <td class="py-2.5 px-4 font-mono">Current statement balance</td>
                    <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">{ex.money(ex.balance)}</td>
                    <td class="py-2.5 px-4">Principal subject to {ex.apr}% annual finance charges.</td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-4 font-medium text-text-primary">Monthly Interest Rate (r)</td>
                    <td class="py-2.5 px-4 font-mono">{ex.apr.toFixed(2)}% &divide; 12</td>
                    <td class="py-2.5 px-4 font-mono">{ex.monthlyPct.toFixed(2)}% / Month</td>
                    <td class="py-2.5 px-4">Compounds to a {ex.ear.toFixed(2)}% effective annual rate (EAR).</td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-4 font-medium text-text-primary">Planned Monthly Payment (PMT)</td>
                    <td class="py-2.5 px-4 font-mono">Fixed commitment</td>
                    <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">{ex.money(ex.payment)} / Month</td>
                    <td class="py-2.5 px-4">Above the Month 1 interest of {ex.money(ex.m1Interest)}, so the balance falls every month.</td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-4 font-medium text-text-primary">Month 1 Breakdown</td>
                    <td class="py-2.5 px-4 font-mono">Interest: {ex.money(ex.balance)} &times; {ex.monthlyPct.toFixed(2)}% = {ex.money(ex.m1Interest)}<br />Principal: {ex.money(ex.payment)} &minus; {ex.money(ex.m1Interest)} = {ex.money(ex.m1Principal)}</td>
                    <td class="py-2.5 px-4 font-mono">{Math.round((ex.m1Interest / ex.payment) * 100)}% Interest / {Math.round((ex.m1Principal / ex.payment) * 100)}% Principal</td>
                    <td class="py-2.5 px-4">Balance drops to {ex.money(ex.balance - ex.m1Principal)}, lowering Month 2 interest to {ex.money(ex.m2Interest)}.</td>
                  </tr>
                  <tr class="bg-surface/50 font-semibold text-text-primary">
                    <td class="py-2.5 px-4">Total Payoff Duration</td>
                    <td class="py-2.5 px-4 font-mono">Amortization equation solved</td>
                    <td class="py-2.5 px-4 font-mono text-accent font-bold">{ex.res.payoffMonths} Months ({(ex.res.payoffMonths / 12).toFixed(1)} Years)</td>
                    <td class="py-2.5 px-4">The last payment is smaller because it only clears what is left.</td>
                  </tr>
                  <tr>
                    <td class="py-2.5 px-4 font-medium text-text-primary">Total Cash Paid</td>
                    <td class="py-2.5 px-4 font-mono">{ex.money(ex.payment)} &times; {ex.res.payoffMonths - 1} + final payment</td>
                    <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">{ex.money(ex.res.totalPaid)}</td>
                    <td class="py-2.5 px-4">Gross cash outflow needed to clear the card.</td>
                  </tr>
                  <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                    <td class="py-3 px-4">Total Interest</td>
                    <td class="py-3 px-4 font-mono">{ex.money(ex.res.totalPaid)} &minus; {ex.money(ex.balance)}</td>
                    <td class="py-3 px-4 font-mono text-accent font-bold">{ex.money(ex.res.totalInterest)} ({((ex.res.totalInterest / ex.res.totalPaid) * 100).toFixed(1)}%)</td>
                    <td class="py-3 px-4">Financing cost paid to the card issuer.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
              <div class="bg-surface border border-border rounded-card p-5">
                <h3 class="text-base font-bold text-text-primary mb-2">Why Paying More Each Month Matters</h3>
                <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
                  <li><strong>Minimum Due Only:</strong> Minimum payments shrink as the balance shrinks, so most of each payment goes to interest and repayment can take many years. See the country boxes below for how minimums are set.</li>
                  <li><strong>Fixed {ex.money(ex.payment)} Payment:</strong> Clears the debt in <strong>{ex.res.payoffMonths} months</strong> with {ex.money(ex.res.totalInterest)} total interest.</li>
                  <li><strong>Accelerated {ex.money(ex.fastPayment)} Payment:</strong> Clears the debt in <strong>{ex.fast.payoffMonths} months</strong> with {ex.money(ex.fast.totalInterest)} total interest — {ex.money(ex.res.totalInterest - ex.fast.totalInterest)} less.</li>
                </ul>
              </div>
              <div class="bg-surface border border-border rounded-card p-5">
                <h3 class="text-base font-bold text-text-primary mb-2">Debt Elimination Strategies</h3>
                <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
                  <li><strong>The Avalanche Method:</strong> Direct all surplus cash toward the highest APR card first while paying minimums on others. Mathematically minimizes total interest paid across all liabilities.</li>
                  <li><strong>Personal Loan Consolidation:</strong> Refinancing {ex.money(ex.balance)} at {ex.apr}% APR into a {ex.loanApr}% personal loan drops monthly interest from {ex.money(ex.m1Interest)} to {ex.money(ex.loanInterest)} — freeing {ex.money(ex.m1Interest - ex.loanInterest)}/month for principal.</li>
                  <li><strong>0% Balance Transfer Card:</strong> A 0% introductory APR stops interest for the promotional period (often 12–21 months), so every payment reduces principal; check the transfer fee.</li>
                </ul>
              </div>
            </div>
          </div>
        ))}

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions &amp; Real-World Exclusions</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Zero New Transactions:</strong> The model assumes you immediately stop using the card. Any new purchases during the payoff period reset interest calculations and prolong payoff.</li>
            <li data-currency-lock="INR"><strong>Taxes and Fees Excluded:</strong> Taxes on finance charges (for example GST in India), annual fees and late fees are not included.</li>
            <li><strong>Loss of Interest-Free Grace Period:</strong> Once you carry a balance from month to month, the interest-free grace period usually stops; interest can accrue on new purchases from the transaction date.</li>
          </ul>
        </div>

        <CountryRules id="cc-country-rules" />
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Juggling multiple credit cards and personal loans?</strong>
        Read our strategic comparison on <a href="/blog/debt-avalanche-vs-snowball" class="text-accent font-medium hover:underline">Debt Avalanche vs. Debt Snowball: Which Strategy Pays Off Debt Faster?</a> to see worked multi-debt payback schedules, interest savings comparisons, and behavioral success drivers.
      </div>

      <section aria-labelledby="cc-calculator-faq">
        <h2 id="cc-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="cc-calculator-related">
        <h2 id="cc-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/debt-to-income-ratio-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Loans</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Debt-to-Income Ratio Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Assess your borrowing health and loan approval eligibility using front-end and back-end DTI.</p>
          </a>
          <a href="/loan-amortization-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Loans</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Loan Amortization Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Generate complete month-by-month principal and interest loan amortization schedules.</p>
          </a>
          <a href="/loan-affordability-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Loans</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Loan Affordability Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Determine maximum borrowing capacity based on monthly income and debt limits.</p>
          </a>
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { moneyRules } from '../lib/currency';
  import { activePageCurrency, applyCurrencyVisibility, pageCurrencyFor } from '../lib/page-currency';
  import { parseSmartInput } from '../lib/formatters';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';
  import { calcCreditCardPayoff } from '../lib/finance/amortization';

  let currentHashState: Record<string, any> = {};
  let currSym = '$';
  let currLocale = 'en-US';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseSmartInput(raw, currLocale === 'de-DE' ? 'EUR' : undefined);
    return num === null || isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(num));
  }

  function initCCCalc() {
    const bInput = document.getElementById('cc-balance') as HTMLInputElement | null;
    const rInput = document.getElementById('cc-apr') as HTMLInputElement | null;
    const pInput = document.getElementById('cc-payment') as HTMLInputElement | null;

    const bSlider = document.getElementById('cc-balance-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('cc-apr-slider') as HTMLInputElement | null;
    const pSlider = document.getElementById('cc-payment-slider') as HTMLInputElement | null;

    const resMonths = document.getElementById('cc-result-months');
    const resInterest = document.getElementById('cc-result-interest');
    const resTotal = document.getElementById('cc-result-total');
    const resBalance = document.getElementById('cc-result-balance');
    const resYears = document.getElementById('cc-result-years');

    const errAlert = document.getElementById('cc-error-alert');
    const errMsg = document.getElementById('cc-error-msg');

    if (!bInput || !rInput || !pInput) return;
    ({ symbol: currSym, locale: currLocale } = activePageCurrency());
    applyCurrencyVisibility(activePageCurrency().code);
    document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
      el.textContent = currSym;
    });

    if (bInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    bInput.dataset.bound = 'true';

    const DEFAULTS = { balance: 6000, apr: 22, payment: 250 }; // USD market defaults; the layout applies the active market's defaults on reset
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const numB = parseSmartInput(bInput!.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numR = parseSmartInput(rInput!.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numP = parseSmartInput(pInput!.value, currLocale === 'de-DE' ? 'EUR' : undefined);

      const vB = validate(numB ?? '', moneyRules({ required: true, min: 100, label: 'Balance' }));
      const vR = validate(numR ?? '', { required: true, min: 0.1, max: 100, decimal: true, label: 'APR' });
      const vP = validate(numP ?? '', moneyRules({ required: true, min: 10, label: 'Monthly Payment' }));

      if (!vB.valid) { showError(vB.error!.message); return; }
      if (!vR.valid) { showError(vR.error!.message); return; }
      if (!vP.valid) { showError(vP.error!.message); return; }

      const balance = vB.value!;
      const apr = vR.value!;
      const payment = vP.value!;

      const firstMonthInterest = balance * (apr / 100 / 12);
      if (payment <= firstMonthInterest) {
        showError(`Monthly payment must exceed monthly interest (${fmtVal(firstMonthInterest)}) to ever pay off the balance.`);
        return;
      }
      clearError();

      const res = calcCreditCardPayoff(balance, apr, payment);

      const heroText = res.paymentSufficient ? `${res.payoffMonths} Months` : 'Infinite';
      const yrsText = isFinite(res.payoffMonths) ? (res.payoffMonths / 12).toFixed(1) + ' Years' : 'Never';

      setResult({
        heroValue: heroText,
        heroLabel: 'Payoff Duration',
        rows: [
          { label: 'Total Interest Paid', value: isFinite(res.totalInterest) ? fmtVal(res.totalInterest) : 'Infinite' },
          { label: 'Total Amount Paid', value: isFinite(res.totalPaid) ? fmtVal(res.totalPaid) : 'Infinite' },
          { label: 'Original Balance', value: fmtVal(balance) },
          { label: 'Time in Years', value: yrsText },
        ],
      });

      if (resMonths) resMonths.textContent = heroText;
      if (resInterest) resInterest.textContent = isFinite(res.totalInterest) ? fmtVal(res.totalInterest) : 'Infinite';
      if (resTotal) resTotal.textContent = isFinite(res.totalPaid) ? fmtVal(res.totalPaid) : 'Infinite';
      if (resBalance) resBalance.textContent = fmtVal(balance);
      if (resYears) resYears.textContent = yrsText;

      const wrapper = document.getElementById('cc-composition-wrapper');
      if (wrapper && isFinite(res.totalPaid) && res.totalPaid > 0) {
        const pFrac = balance / res.totalPaid;
        const iFrac = res.totalInterest / res.totalPaid;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(pFrac * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(iFrac * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(balance);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.totalInterest);
      }

      currentHashState = { b: balance, r: apr, p: payment };
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        debounce();
      });
      input.addEventListener('blur', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num)) {
          input.value = isFormatted ? fmtLiveInput(String(num)) : String(num);
          recalc();
        }
      });
    }

    sync(bSlider, bInput, true);
    sync(rSlider, rInput, false);
    sync(pSlider, pInput, true);

    document.getElementById('cc-calculate')?.addEventListener('click', recalc);
    document.getElementById('cc-reset')?.addEventListener('click', () => {
      bInput.value = fmtLiveInput(String(DEFAULTS.balance));
      rInput.value = String(DEFAULTS.apr);
      pInput.value = fmtLiveInput(String(DEFAULTS.payment));

      if (bSlider) {
        bSlider.value = String(DEFAULTS.balance);
        bSlider.style.setProperty('--slider-pct', `${((DEFAULTS.balance - Number(bSlider.min)) / (Number(bSlider.max) - Number(bSlider.min))) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.apr);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.apr - Number(rSlider.min)) / (Number(rSlider.max) - Number(rSlider.min))) * 100}%`);
      }
      if (pSlider) {
        pSlider.value = String(DEFAULTS.payment);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.payment - Number(pSlider.min)) / (Number(pSlider.max) - Number(pSlider.min))) * 100}%`);
      }

      clearError();
      recalc();
      bInput.focus();
    });

    [bInput, rInput, pInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('cc-copy-btn')?.addEventListener('click', async () => {
      const numB = parseSmartInput(bInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numR = parseSmartInput(rInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numP = parseSmartInput(pInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);

      const vB = validate(numB ?? '', moneyRules({ required: true, min: 100, label: 'Balance' }));
      const vR = validate(numR ?? '', { required: true, min: 0.1, label: 'APR' });
      const vP = validate(numP ?? '', moneyRules({ required: true, min: 10, label: 'Payment' }));

      if (!vB.valid || !vR.valid || !vP.valid) return;

      const res = calcCreditCardPayoff(vB.value!, vR.value!, vP.value!);
      const text = `Credit Card Payoff: Balance ${fmtVal(vB.value!)} at ${vR.value}% APR paying ${fmtVal(vP.value!)}/mo takes ${res.payoffMonths} months (Total Interest: ${fmtVal(res.totalInterest)}). ${location.href.split('#')[0]}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cc-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cc-share-btn')?.addEventListener('click', async () => {
      const shareUrl = `${location.href.split('#')[0]}${serializeHash(currentHashState)}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cc-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      b: moneyRules({ required: true, min: 100, label: 'b' }),
      r: { required: true, min: 0.1, max: 100, decimal: true, label: 'r' },
      p: moneyRules({ required: true, min: 10, label: 'p' }),
    });
    if (restored.valid && restored.values.b && restored.values.r !== undefined && restored.values.p) {
      bInput.value = fmtLiveInput(String(restored.values.b));
      rInput.value = String(restored.values.r);
      pInput.value = fmtLiveInput(String(restored.values.p));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        ({ symbol: currSym, locale: currLocale } = pageCurrencyFor(e.detail.code));
        applyCurrencyVisibility(pageCurrencyFor(e.detail.code).code);
        document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
          el.textContent = currSym;
        });
        recalc();
      }
    });
  }

  initCCCalc();
  document.addEventListener('astro:page-load', initCCCalc);
</script>
