---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcXIRR } from '../lib/calculators/xirr';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT_FLOWS = [
  { amount: -100000, date: '2023-01-01' },
  { amount: -50000, date: '2023-07-01' },
  { amount: 20000, date: '2024-01-01' },
  { amount: 185000, date: '2025-01-01' },
];

const parsedFlows = DEFAULT_FLOWS.map((f) => ({ amount: f.amount, date: new Date(f.date) }));
const initialResult = calcXIRR(parsedFlows);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Investments' && t.slug !== 'xirr-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/xirr-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'XIRR Calculator',
      url: canonicalUrl,
      description: 'Free XIRR calculator to compute mutual fund xirr and annualized return for irregular cash flow dates using the xirr formula.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'XIRR Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'When should I use XIRR instead of CAGR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Use CAGR only for a single lump sum investment held from start to finish. For mutual fund SIPs, dividend reinvestments, STP, or sporadic investments, XIRR is mandatory because money is added or withdrawn at multiple different dates.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why does XIRR require both negative and positive numbers?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'XIRR mathematically solves for the discount rate that balances outflows against inflows. Outflows (money invested) must be negative and inflows (redemptions or current market valuation) must be positive.',
          },
        },
        {
          '@type': 'Question',
          name: 'What does a negative XIRR mean?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A negative XIRR means your investment portfolio has lost value on an annualized basis across the cash flow timeline, with current valuations plus redemptions trailing total deployed capital.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does XIRR differ from IRR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Standard IRR assumes cash flows occur at strictly equal time intervals (e.g. exactly annually or monthly). XIRR allows arbitrary, exact daily dates for each cash flow event, accounting for leap years and exact day counts.',
          },
        },
        {
          '@type': 'Question',
          name: 'What algorithm is used to compute XIRR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'XIRR uses the Newton-Raphson numerical iterative solver with tolerance guards to discover the annualized rate of return where the net present value of all cash flows equals zero.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="XIRR Calculator: Irregular Cash Flow Returns | Calcumetrics"
  description="Free XIRR calculator. Compute annualized return for mutual fund xirr, understand xirr meaning, and calculate irregular cash flows with the xirr formula."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="XIRR Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={initialResult.xirrPct.toFixed(2) + '%'}
    heroLabel="Annualised XIRR"
    calcType="advanced"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">XIRR Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the annualized return for irregular investments with dates. Use negative numbers for investments/outflows and positive numbers for redemptions/current value.</p>

      <!-- Error alert -->
      <div id="xirr-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="xirr-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <div class="mb-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Cash Flows (Date & Amount)</span>
          <button type="button" id="xirr-add-row" class="text-xs font-semibold text-accent hover:underline flex items-center gap-1 cursor-pointer">
            + Add Cash Flow
          </button>
        </div>

        <div id="xirr-rows-container" class="space-y-2.5">
          {DEFAULT_FLOWS.map((cf, idx) => (
            <div class="flex items-center gap-2 p-2 rounded-control border border-border bg-surface xirr-row" data-index={idx}>
              <input
                type="date"
                class="xirr-date text-xs h-9 px-2 rounded border border-border bg-canvas text-text-primary focus:outline-accent"
                value={cf.date}
                required
                aria-label={`Date for cash flow ${idx + 1}`}
              />
              <div class="relative flex-1">
                <input
                  type="text"
                  class="xirr-amount text-sm h-9 w-full px-2.5 rounded border border-border bg-canvas text-text-primary tabular-nums text-right focus:outline-accent"
                  value={cf.amount}
                  placeholder="e.g. -50000"
                  required
                  aria-label={`Amount for cash flow ${idx + 1}`}
                />
              </div>
              <button
                type="button"
                class="xirr-remove-row text-text-muted hover:text-error-text h-9 w-9 flex items-center justify-center rounded border border-transparent hover:border-border transition-standard cursor-pointer"
                title="Remove cash flow"
                aria-label="Remove cash flow"
              >
                ✕
              </button>
            </div>
          ))}
        </div>
      </div>

      <Alert variant="info" title="Convention">
        Enter cash outlays (investments) as <strong>negative numbers</strong> (e.g. -100000) and returns or current portfolio valuation as <strong>positive numbers</strong> (e.g. 185000).
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="xirr-calculate" type="button">Calculate Annualized Return (XIRR)</Button>
        <Button variant="ghost" id="xirr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Extended Internal Rate of Return</span>
        <div id="xirr-result-pct" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {initialResult.xirrPct.toFixed(2)}%
        </div>
        <p id="xirr-plain-translation" class="text-xs text-dark-muted mt-1.5 leading-relaxed">
          {initialResult.xirrPct > 0 ? (
            <>Equivalent to roughly <strong class="text-dark-text">~₹{Math.round(initialResult.xirrPct * 100).toLocaleString('en-IN')}/year</strong> for every ₹10,000 invested</>
          ) : (
            ''
          )}
        </p>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Invested (Outflows)</span>
          <span id="xirr-result-outflow" class="text-sm font-medium tabular-nums text-dark-text">{fmt(150000)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Received/Value (Inflows)</span>
          <span id="xirr-result-inflow" class="text-sm font-medium tabular-nums text-dark-text">{fmt(205000)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Absolute Profit</span>
          <span id="xirr-result-profit" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(55000)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Cash Flows</span>
          <span id="xirr-result-count" class="text-sm font-medium tabular-nums text-dark-text">4 events</span>
        </div>
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="xirr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="xirr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- 1. How it works -->
      <section aria-labelledby="xirr-calculator-how">
        <h2 id="xirr-calculator-how" class="text-xl font-bold text-text-primary mb-4">How the XIRR calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          The Extended Internal Rate of Return (XIRR) measures the annualized performance of an investment portfolio that experiences irregular deposits, sporadic withdrawals, or fluctuating dividend payouts. Unlike the standard Internal Rate of Return (IRR) which assumes cash flows arrive at uniform annual or monthly intervals, XIRR calculates the exact fractional day count for every individual transaction.
        </p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          XIRR uses the Newton-Raphson numerical iterative method to discover the discount rate <em>r</em> that sets the Net Present Value (NPV) of all historic cash flows to exactly zero:
        </p>

        <!-- Formula block -->
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">NPV = &Sigma; [ C<sub>i</sub> / (1 + r)<sup>(d<sub>i</sub> &minus; d<sub>0</sub>) / 365.25</sup> ] = 0</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">C<sub>i</sub></strong> &mdash; Cash flow amount at event <em>i</em> (negative for outflows/investments, positive for inflows/redemptions)</li>
            <li><strong class="text-text-primary">d<sub>i</sub></strong> &mdash; Date of transaction <em>i</em></li>
            <li><strong class="text-text-primary">d<sub>0</sub></strong> &mdash; Date of the initial transaction</li>
            <li><strong class="text-text-primary">r</strong> &mdash; Annualized internal rate of return (XIRR)</li>
          </ul>
        </div>
      </section>

      <!-- 2. Step-by-Step Worked Example -->
      <section aria-labelledby="xirr-calculator-example">
        <h2 id="xirr-calculator-example" class="text-xl font-bold text-text-primary mb-4">Worked example: 4 irregular cash flow events</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an investor managing an active portfolio over a two-year period with the following transactions:
        </p>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm border-collapse border border-border rounded-card">
            <thead>
              <tr class="bg-canvas border-b border-border text-left">
                <th class="py-2.5 px-4 font-semibold text-text-primary">Date</th>
                <th class="py-2.5 px-4 font-semibold text-text-primary">Nature of Flow</th>
                <th class="py-2.5 px-4 font-semibold text-right text-text-primary">Amount</th>
                <th class="py-2.5 px-4 font-semibold text-right text-text-primary">Elapsed Days</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2 px-4 font-mono">2023-01-01</td>
                <td class="py-2 px-4">Initial Investment (Outflow)</td>
                <td class="py-2 px-4 text-right font-mono text-text-primary">-₹1,00,000</td>
                <td class="py-2 px-4 text-right font-mono">0 days</td>
              </tr>
              <tr>
                <td class="py-2 px-4 font-mono">2023-07-01</td>
                <td class="py-2 px-4">Follow-on Investment (Outflow)</td>
                <td class="py-2 px-4 text-right font-mono text-text-primary">-₹50,000</td>
                <td class="py-2 px-4 text-right font-mono">181 days</td>
              </tr>
              <tr>
                <td class="py-2 px-4 font-mono">2024-01-01</td>
                <td class="py-2 px-4">Partial Profit Booking (Inflow)</td>
                <td class="py-2 px-4 text-right font-mono text-text-primary">+₹20,000</td>
                <td class="py-2 px-4 text-right font-mono">365 days</td>
              </tr>
              <tr>
                <td class="py-2 px-4 font-mono">2025-01-01</td>
                <td class="py-2 px-4">Current Valuation (Terminal Inflow)</td>
                <td class="py-2 px-4 text-right font-mono text-text-primary">+₹1,85,000</td>
                <td class="py-2 px-4 text-right font-mono">731 days</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 text-sm text-text-muted space-y-2">
          <p><strong class="text-text-primary">1. Aggregate Cash Outlays:</strong> ₹1,00,000 + ₹50,000 = ₹1,50,000</p>
          <p><strong class="text-text-primary">2. Aggregate Recoveries & Valuation:</strong> ₹20,000 + ₹1,85,000 = ₹2,05,000</p>
          <p><strong class="text-text-primary">3. Net Absolute Gain:</strong> ₹2,05,000 &minus; ₹1,50,000 = <strong class="text-text-primary text-accent">₹55,000</strong> (+36.67% absolute return)</p>
          <p><strong class="text-text-primary">4. Newton-Raphson Solving:</strong> Finding discount rate <em>r</em> such that NPV = 0:</p>
          <p class="font-mono text-xs pl-3">
            -100000 + [-50000 / (1 + r)<sup>0.496</sup>] + [20000 / (1 + r)<sup>0.999</sup>] + [185000 / (1 + r)<sup>2.001</sup>] = 0
          </p>
          <p><strong class="text-text-primary">5. Resulting Annualized Return:</strong> <strong class="text-text-primary text-accent">XIRR = 19.73%</strong></p>
        </div>
      </section>

      <!-- 3. Interpreting Your Results -->
      <section aria-labelledby="xirr-calculator-interpretation">
        <h2 id="xirr-calculator-interpretation" class="text-xl font-bold text-text-primary mb-4">Interpreting your XIRR results</h2>
        <div class="space-y-3 text-sm text-text-muted leading-relaxed">
          <p>
            <strong class="text-text-primary">Money-Weighted Rate of Return:</strong> XIRR is fundamentally a money-weighted return metric. It is sensitive to both the magnitude and the timing of your deposits. Deploying large sums just before an asset surge boosts your XIRR, while investing right before a correction depresses it.
          </p>
          <p>
            <strong class="text-text-primary">Distortion Over Short Horizons:</strong> Because XIRR annualizes all rates, short holding durations can produce misleadingly high numbers. For instance, making 3% profit over 5 days equates to an annualized XIRR exceeding 700%, even though the actual cash gain was modest. Always evaluate XIRR alongside the net absolute monetary gain.
          </p>
        </div>

        <div class="p-3.5 bg-surface border border-accent/30 rounded-card my-4 text-xs text-text-muted">
          <strong class="text-text-primary">Wondering how XIRR compares to CAGR?</strong> For a single lump-sum investment, XIRR is mathematically identical to CAGR. To understand how timing alters returns across SIPs vs lump sums, read our deep dive on <a href="/blog/cagr-vs-xirr" class="text-accent font-medium hover:underline">CAGR vs. XIRR</a> or use the <a href="/cagr-calculator" class="text-accent font-medium hover:underline">CAGR Calculator</a>.
        </div>
      </section>

      <!-- 4. Assumptions & Limitations -->
      <section aria-labelledby="xirr-calculator-assumptions">
        <h2 id="xirr-calculator-assumptions" class="text-xl font-bold text-text-primary mb-4">Key assumptions and limitations</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-text-muted leading-relaxed">
          <li>
            <strong class="text-text-primary">Reinvestment Rate Assumption:</strong> Mathematically, XIRR presumes that all intermediate positive cash flows (such as dividend payouts) are reinvested in instruments earning the same internal rate of return until the terminal date.
          </li>
          <li>
            <strong class="text-text-primary">Sign Variation Required:</strong> The calculation requires at least one negative outflow (purchase) and at least one positive inflow (sale or current valuation). If all flows share the same sign, the internal rate cannot be computed.
          </li>
          <li>
            <strong class="text-text-primary">Exclusion of Taxes and Friction:</strong> Figures represent gross internal performance and do not incorporate capital gains taxes, trading slippage, brokerage fees, or exit loads.
          </li>
        </ul>
      </section>

      <!-- 5. Frequently Asked Questions -->
      <section aria-labelledby="xirr-calculator-faq">
        <h2 id="xirr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            ['When should I use XIRR instead of CAGR?', 'Use CAGR only for a single lump sum investment held from start to finish. For mutual fund SIPs, dividend reinvestments, STP, or sporadic investments, XIRR is mandatory because money is added or withdrawn at multiple different dates.'],
            ['Why does XIRR require both negative and positive numbers?', 'XIRR mathematically solves for the discount rate that balances outflows against inflows. Outflows (money invested) must be negative and inflows (redemptions or current market valuation) must be positive.'],
            ['What does a negative XIRR mean?', 'A negative XIRR means your investment portfolio has lost value on an annualized basis across the cash flow timeline, with current valuations plus redemptions trailing total deployed capital.'],
            ['How does XIRR differ from IRR?', 'Standard IRR assumes cash flows occur at strictly equal time intervals (e.g. exactly annually or monthly). XIRR allows arbitrary, exact daily dates for each cash flow event, accounting for leap years and exact day counts.'],
            ['What algorithm is used to compute XIRR?', 'XIRR uses the Newton-Raphson numerical iterative solver with tolerance guards to discover the annualized rate of return where the net present value of all cash flows equals zero.'],
          ].map(([q, a]) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{q}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="xirr-calculator-related">
        <h2 id="xirr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';

  function npvRate(flows: Array<{ amount: number; date: Date }>, rate: number): number {
    const t0 = flows[0].date.getTime();
    return flows.reduce((sum, cf) => {
      const years = (cf.date.getTime() - t0) / (365.25 * 24 * 3600 * 1000);
      return sum + cf.amount / Math.pow(1 + rate, years);
    }, 0);
  }

  function calcXIRRClient(flows: Array<{ amount: number; date: Date }>) {
    const hasNeg = flows.some((c) => c.amount < 0);
    const hasPos = flows.some((c) => c.amount > 0);
    if (!hasNeg || !hasPos) {
      return { xirrPct: 0, valid: false, error: 'XIRR requires at least one negative outflow (investment) and one positive inflow (return).' };
    }

    let rate = 0.1;
    for (let i = 0; i < 1000; i++) {
      const npv = npvRate(flows, rate);
      const npvDelta = npvRate(flows, rate + 1e-6);
      const derivative = (npvDelta - npv) / 1e-6;
      if (Math.abs(derivative) < 1e-12) break;
      const nextRate = rate - npv / derivative;
      if (Math.abs(nextRate - rate) < 1e-7) {
        return { xirrPct: nextRate * 100, valid: true };
      }
      rate = nextRate;
    }
    return { xirrPct: rate * 100, valid: true };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  const DEFAULT_DATA = [
    { amount: -100000, date: '2023-01-01' },
    { amount: -50000, date: '2023-07-01' },
    { amount: 20000, date: '2024-01-01' },
    { amount: 185000, date: '2025-01-01' },
  ];

  function initXIRRCalc() {
    if ((window as any).__cmXIRRBound) return;
    (window as any).__cmXIRRBound = true;

    const container = document.getElementById('xirr-rows-container');
    const addBtn = document.getElementById('xirr-add-row');
    const calcBtn = document.getElementById('xirr-calculate');
    const resetBtn = document.getElementById('xirr-reset');

    const resPct = document.getElementById('xirr-result-pct');
    const resOutflow = document.getElementById('xirr-result-outflow');
    const resInflow = document.getElementById('xirr-result-inflow');
    const resProfit = document.getElementById('xirr-result-profit');
    const resCount = document.getElementById('xirr-result-count');

    const errAlert = document.getElementById('xirr-error-alert');
    const errMsg = document.getElementById('xirr-error-msg');

    if (!container) return;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function getFlows(): Array<{ amount: number; date: Date }> {
      const rows = Array.from(container!.querySelectorAll<HTMLElement>('.xirr-row'));
      const flows: Array<{ amount: number; date: Date }> = [];
      for (const row of rows) {
        const dateInput = row.querySelector<HTMLInputElement>('.xirr-date');
        const amtInput = row.querySelector<HTMLInputElement>('.xirr-amount');
        if (dateInput && amtInput && dateInput.value && amtInput.value.trim() !== '') {
          const rawAmt = amtInput.value.replace(/,/g, '').trim();
          const num = parseFloat(rawAmt);
          const dt = new Date(dateInput.value);
          if (!isNaN(num) && !isNaN(dt.getTime())) {
            flows.push({ amount: num, date: dt });
          }
        }
      }
      return flows.sort((a, b) => a.date.getTime() - b.date.getTime());
    }

    function recalc() {
      const flows = getFlows();
      if (flows.length < 2) {
        showError('Please specify at least 2 cash flow entries with valid dates and amounts.');
        return;
      }

      const res = calcXIRRClient(flows);
      if (!res.valid) {
        showError(res.error || 'Invalid cash flows.');
        return;
      }
      clearError();

      let outflow = 0;
      let inflow = 0;
      flows.forEach((f) => {
        if (f.amount < 0) outflow += Math.abs(f.amount);
        else inflow += f.amount;
      });

      const heroPctText = res.xirrPct.toFixed(2) + '%';

      setResult({
        heroValue: heroPctText,
        heroLabel: 'Annualised XIRR',
        rows: [
          { label: 'Total Invested (Outflows)', value: fmtVal(outflow) },
          { label: 'Total Received/Value (Inflows)', value: fmtVal(inflow) },
          { label: 'Net Absolute Profit', value: fmtVal(inflow - outflow) },
          { label: 'Total Cash Flows', value: `${flows.length} events` },
        ],
      });

      if (resPct) resPct.textContent = heroPctText;
      if (resOutflow) resOutflow.textContent = fmtVal(outflow);
      if (resInflow) resInflow.textContent = fmtVal(inflow);
      if (resProfit) resProfit.textContent = fmtVal(inflow - outflow);
      if (resCount) resCount.textContent = `${flows.length} events`;

      const plainEl = document.getElementById('xirr-plain-translation');
      if (plainEl) {
        if (res.xirrPct > 0) {
          const annualGainPer10k = Math.round(res.xirrPct * 100);
          plainEl.innerHTML = `Equivalent to roughly <strong class="text-dark-text">~${currSym}${annualGainPer10k.toLocaleString('en-IN')}/year</strong> for every ${currSym}10,000 invested`;
        } else if (res.xirrPct < 0) {
          const annualLossPer10k = Math.abs(Math.round(res.xirrPct * 100));
          plainEl.innerHTML = `Loses roughly <strong class="text-dark-text">~${currSym}${annualLossPer10k.toLocaleString('en-IN')}/year</strong> for every ${currSym}10,000 invested`;
        } else {
          plainEl.textContent = 'Zero annual growth or loss across cash flow dates';
        }
      }
    }

    function wireRow(row: HTMLElement) {
      row.querySelector('.xirr-remove-row')?.addEventListener('click', () => {
        if (container!.querySelectorAll('.xirr-row').length > 2) {
          row.remove();
          recalc();
        } else {
          showError('At least two cash flow events are required.');
        }
      });
      row.querySelector('.xirr-date')?.addEventListener('change', recalc);
      row.querySelector('.xirr-amount')?.addEventListener('input', recalc);
    }

    container.querySelectorAll<HTMLElement>('.xirr-row').forEach(wireRow);

    addBtn?.addEventListener('click', () => {
      const today = new Date().toISOString().split('T')[0];
      const newRow = document.createElement('div');
      newRow.className = 'flex items-center gap-2 p-2 rounded-control border border-border bg-surface xirr-row';
      newRow.innerHTML = `
        <input type="date" class="xirr-date text-xs h-9 px-2 rounded border border-border bg-canvas text-text-primary focus:outline-accent" value="${today}" required />
        <div class="relative flex-1">
          <input type="text" class="xirr-amount text-sm h-9 w-full px-2.5 rounded border border-border bg-canvas text-text-primary tabular-nums text-right focus:outline-accent" placeholder="e.g. 50000" required />
        </div>
        <button type="button" class="xirr-remove-row text-text-muted hover:text-error-text h-9 w-9 flex items-center justify-center rounded border border-transparent hover:border-border transition-standard cursor-pointer" title="Remove cash flow" aria-label="Remove cash flow">✕</button>
      `;
      container.appendChild(newRow);
      wireRow(newRow);
      newRow.querySelector<HTMLInputElement>('.xirr-amount')?.focus();
    });

    calcBtn?.addEventListener('click', recalc);

    resetBtn?.addEventListener('click', () => {
      container.innerHTML = '';
      DEFAULT_DATA.forEach((cf, idx) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 p-2 rounded-control border border-border bg-surface xirr-row';
        row.setAttribute('data-index', String(idx));
        row.innerHTML = `
          <input type="date" class="xirr-date text-xs h-9 px-2 rounded border border-border bg-canvas text-text-primary focus:outline-accent" value="${cf.date}" required />
          <div class="relative flex-1">
            <input type="text" class="xirr-amount text-sm h-9 w-full px-2.5 rounded border border-border bg-canvas text-text-primary tabular-nums text-right focus:outline-accent" value="${cf.amount}" placeholder="e.g. -50000" required />
          </div>
          <button type="button" class="xirr-remove-row text-text-muted hover:text-error-text h-9 w-9 flex items-center justify-center rounded border border-transparent hover:border-border transition-standard cursor-pointer" title="Remove cash flow" aria-label="Remove cash flow">✕</button>
        `;
        container.appendChild(row);
        wireRow(row);
      });
      clearError();
      recalc();
    });

    document.getElementById('xirr-copy-btn')?.addEventListener('click', async () => {
      const flows = getFlows();
      const res = calcXIRRClient(flows);
      if (!res.valid) return;
      const text = `XIRR: ${res.xirrPct.toFixed(2)}% across ${flows.length} cash flows. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('xirr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('xirr-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('xirr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initXIRRCalc();
  document.addEventListener('astro:page-load', initXIRRCalc);
</script>
