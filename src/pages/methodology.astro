---
import Layout from '../layouts/Layout.astro';
import WindowFrame from '../components/calculator/WindowFrame.astro';

const canonicalUrl = 'https://calcumetrics.com/methodology';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Methodology: Formulas & Conventions',
      url: canonicalUrl,
      description: 'Formulas, conventions, data sources, and our correction policy for all Calcumetrics calculators.',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Methodology', item: canonicalUrl },
      ],
    },
  ],
};
---
<Layout
  title="Methodology: Our Formulas & Conventions | Calcumetrics"
  description="Formulas, conventions, data sources, and our correction policy for all Calcumetrics calculators."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <div class="max-w-[760px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-text-muted">
        <li><a href="/" class="hover:text-accent transition-standard">Home</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-primary font-medium" aria-current="page">Methodology</li>
      </ol>
    </nav>
    <!-- 1. Title + Introduction -->
    <p class="text-xs text-text-muted mb-2">Last updated: 23 September 2026</p>
    <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-3">Methodology</h1>
    <p class="text-sm text-text-muted leading-relaxed mb-8">
      Calcumetrics uses standard mathematical formulas from widely accepted financial textbooks and official regulatory sources. This page documents our conventions, assumptions, data sources, and client-side execution architecture.
    </p>

    <!-- 2. Dark WindowFrame Methodology Demo -->
    <section class="mb-10" aria-label="Methodology demonstration sandbox">
      <WindowFrame variant="dark" urlPill="calcumetrics.com/methodology">
        <div class="p-5 sm:p-6 text-dark-text">
          <div class="flex items-center justify-between border-b border-dark-border pb-3 mb-5">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-dark-accent uppercase tracking-wider">Interactive Sandbox</span>
              <span class="text-xs text-dark-muted hidden sm:inline">· Client-Side Flow</span>
            </div>
            <span class="text-[11px] font-mono text-dark-muted">Calculation runs locally · 0 network requests</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-start">
            <!-- Col 1: INPUT -->
            <div class="space-y-3">
              <div class="text-xs font-semibold uppercase tracking-wider text-dark-muted flex items-center gap-1.5">
                <span>1. Input</span>
              </div>
              <div>
                <label for="demo-principal" class="text-xs text-dark-muted mb-1 flex justify-between">
                  <span>Principal (P)</span>
                  <span id="demo-principal-val" class="font-mono text-dark-text tabular-nums">$5,000</span>
                </label>
                <input
                  type="range"
                  id="demo-principal"
                  min="1000"
                  max="20000"
                  step="500"
                  value="5000"
                  class="w-full h-1.5 bg-dark-border rounded-control appearance-none cursor-pointer accent-dark-accent"
                  aria-label="Demo Principal Amount"
                />
              </div>

              <div>
                <label for="demo-rate" class="text-xs text-dark-muted mb-1 flex justify-between">
                  <span>Annual Rate (r)</span>
                  <span id="demo-rate-val" class="font-mono text-dark-text tabular-nums">7.0%</span>
                </label>
                <input
                  type="range"
                  id="demo-rate"
                  min="1"
                  max="15"
                  step="0.5"
                  value="7"
                  class="w-full h-1.5 bg-dark-border rounded-control appearance-none cursor-pointer accent-dark-accent"
                  aria-label="Demo Annual Interest Rate"
                />
              </div>

              <div class="text-[11px] text-dark-muted flex justify-between pt-1">
                <span>Term (t)</span>
                <span class="font-mono text-dark-text">5 years (fixed)</span>
              </div>
            </div>

            <!-- Col 2: ENGINE -->
            <div>
              <div class="text-xs font-semibold uppercase tracking-wider text-dark-muted mb-3 flex items-center gap-1.5">
                <span>2. Engine</span>
              </div>
              <div class="bg-surface/5 border border-dark-border rounded-control p-3 font-mono text-xs space-y-2">
                <div class="text-dark-muted text-[11px]">Formula:</div>
                <div class="text-dark-accent font-medium">A = P × (1 + r)^t</div>
                <div class="text-dark-muted text-[11px] pt-1 border-t border-dark-border">Execution:</div>
                <div id="demo-engine-calc" class="text-dark-text text-[11px] break-all tabular-nums">5000 × (1 + 0.07)^5</div>
                <div class="text-[10px] text-dark-muted">IEEE 754 64-bit float</div>
              </div>
            </div>

            <!-- Col 3: OUTPUT -->
            <div>
              <div class="text-xs font-semibold uppercase tracking-wider text-dark-muted mb-3 flex items-center gap-1.5">
                <span>3. Output</span>
              </div>
              <div class="bg-surface/5 border border-dark-border rounded-control p-3 flex flex-col justify-between min-h-[140px]">
                <div>
                  <div class="text-[11px] text-dark-muted">Future Value (A)</div>
                  <div id="demo-output-result" class="text-xl font-bold tabular-nums text-dark-accent mt-0.5 tracking-tight">$7,012.76</div>
                  <div id="demo-output-gain" class="text-[11px] text-dark-muted tabular-nums mt-0.5">+ $2,012.76 gain</div>
                </div>
                <div class="pt-2 border-t border-dark-border flex items-center justify-between text-[10px] text-dark-muted">
                  <span>Display rounding:</span>
                  <span class="text-dark-text font-mono">2 decimals</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </WindowFrame>
    </section>

    <!-- 3. Input → Engine → Output Pipeline -->
    <section class="mb-10" aria-labelledby="pipeline-heading">
      <h2 id="pipeline-heading" class="text-xl font-bold text-text-primary mb-4">
        The calculation pipeline
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-surface border border-border rounded-card p-5">
          <div class="inline-flex items-center justify-center w-6 h-6 rounded-chip bg-disabled-bg text-text-muted text-xs font-bold mb-3">
            1
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-1">Input</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            User provides values directly in form fields or sliders. All data stays local to the client session.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-card p-5">
          <div class="inline-flex items-center justify-center w-6 h-6 rounded-chip bg-disabled-bg text-text-muted text-xs font-bold mb-3">
            2
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-1">Engine</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Formula and calculation logic process the inputs in the browser using standard floating-point arithmetic.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-card p-5">
          <div class="inline-flex items-center justify-center w-6 h-6 rounded-chip bg-disabled-bg text-text-muted text-xs font-bold mb-3">
            3
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-1">Output</h3>
          <p class="text-xs text-text-muted leading-relaxed">
            The resulting value is rounded to standard currency decimals and presented for immediate interpretation.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Engineering Standards Grid -->
    <section class="mb-12" aria-labelledby="standards-heading">
      <h2 id="standards-heading" class="text-xl font-bold text-text-primary mb-4">
        Engineering standards
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-surface border border-border rounded-card p-5">
          <h3 class="text-sm font-bold text-text-primary mb-2 flex items-center justify-between">
            <span>IEEE 754</span>
            <span class="text-[10px] font-mono font-normal text-text-muted px-2 py-0.5 rounded-chip bg-disabled-bg border border-border">64-bit float</span>
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Internal calculations preserve normal floating-point precision and values are rounded for display.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-card p-5">
          <h3 class="text-sm font-bold text-text-primary mb-2 flex items-center justify-between">
            <span>Zero Scripts</span>
            <span class="text-[10px] font-mono font-normal text-text-muted px-2 py-0.5 rounded-chip bg-disabled-bg border border-border">100% local</span>
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            No remote calculation service is required; calculations execute in the browser.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-card p-5">
          <h3 class="text-sm font-bold text-text-primary mb-2 flex items-center justify-between">
            <span>Immutable Formulas</span>
            <span class="text-[10px] font-mono font-normal text-text-muted px-2 py-0.5 rounded-chip bg-disabled-bg border border-border">Documented</span>
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Calculator formulas are explicitly documented and should not change silently.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-card p-5">
          <h3 class="text-sm font-bold text-text-primary mb-2 flex items-center justify-between">
            <span>Annual Statutory Review</span>
            <span class="text-[10px] font-mono font-normal text-text-muted px-2 py-0.5 rounded-chip bg-disabled-bg border border-border">Versioned</span>
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            Tax/regulatory data is reviewed and carries a visible verification date.
          </p>
        </div>
      </div>
    </section>

    <!-- 5-10. Preserved Methodology Documentation Content -->
    <div class="space-y-8 pt-4 border-t border-border">
      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Formulas and conventions</h2>
        <div class="bg-surface border border-border rounded-card p-5 space-y-3 text-sm text-text-muted break-words">
          <p><strong class="text-text-primary">SIP (annuity-due):</strong> M = P × [((1 + i)^n − 1) / i] × (1 + i). Contribution at start of month. i = r/12/100.</p>
          <p><strong class="text-text-primary">EMI:</strong> E = P × r × (1+r)^n / ((1+r)^n − 1). Internal computation uses unrounded EMI. r = annual rate / 12 / 100.</p>
          <p><strong class="text-text-primary">Compound interest:</strong> A = P × (1 + r/n)^(n×t). Nominal rate, specified compounding frequency.</p>
          <p><strong class="text-text-primary">CAGR:</strong> CAGR = (FV/PV)^(1/n) − 1.</p>
          <p><strong class="text-text-primary">WACC:</strong> WACC = (E/V) × Re + (D/V) × Rd × (1 − Tc).</p>
          <p><strong class="text-text-primary">IRR/XIRR:</strong> Newton-Raphson numerical iteration. Requires at least one sign change in cash flows.</p>
          <p><strong class="text-text-primary">NPV:</strong> NPV = Σ CF_t / (1+r)^t from t=0 to n.</p>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Interest rate conventions</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          All calculators use nominal annual rates unless labelled otherwise. We do not use effective annual rate (EAR) unless explicitly stated. This matches the convention of Indian mutual fund platforms, banks, and most retail financial products.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Jurisdiction-locked calculators</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Calculators bound to regional tax statutes or legal frameworks (such as Indian Income Tax under Section 115BAC, HRA exemptions, Capital Gains Tax, GST, TDS, and the US 401(k) calculator) are strictly jurisdiction-locked. They always execute using their designated statutory currency (₹ INR for India-specific tools, $ USD for US 401(k)) and apply local statutory rules directly. They cannot be converted to other jurisdictions or currencies because tax codes and retirement regulations cannot be translated simply via exchange rates.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Display currency formatting vs. foreign exchange</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          For universal financial calculators (e.g. CAGR, NPV, IRR, EMI, Loan Amortization, DCF), Calcumetrics allows users to select their preferred display currency symbol ($, €, £, ₹). This control affects <em>display formatting and symbol presentation only</em>. It does <strong>not</strong> perform real-time currency conversion or modify numerical input/output amounts. Calcumetrics is not a foreign exchange service.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Tax and regulatory data</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Tax rates (GST slabs, PPF rates) are stored in a data file with a <strong>verifiedOn</strong> date and a link to the official source. We re-verify rates on a schedule. The <strong>verifiedOn</strong> date is displayed on each tax tool. Rates change; always verify against official government sources before making decisions.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Rounding</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          All internal computations use full floating-point precision. Values are rounded only when displayed to the user. This prevents accumulated rounding errors in multi-step calculations such as loan amortization.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Limitations</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Calculators assume constant rates for the entire period. Actual market returns, interest rates, and tax laws change. All results are estimates for information and planning purposes only. They are not financial, tax, or legal advice.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-text-primary mb-3">Correction policy</h2>
        <p class="text-sm text-text-muted leading-relaxed">
          If you find a calculation error, <a href="/contact" class="text-accent hover:underline focus-visible:outline-accent">contact us</a> with the input values and the discrepancy. We verify reported errors against published test fixtures and correct them promptly. The visible &ldquo;Last updated&rdquo; date changes only when logic, rates, or copy actually change.
        </p>
      </section>
    </div>
  </div>
</Layout>

<script>
  function initMethodologyDemo() {
    const pInput = document.getElementById('demo-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('demo-rate') as HTMLInputElement | null;
    const pVal = document.getElementById('demo-principal-val');
    const rVal = document.getElementById('demo-rate-val');
    const engineCalc = document.getElementById('demo-engine-calc');
    const outputResult = document.getElementById('demo-output-result');
    const outputGain = document.getElementById('demo-output-gain');

    if (!pInput || !rInput || !pVal || !rVal || !engineCalc || !outputResult || !outputGain) return;

    function updateValues() {
      if (!pInput || !rInput || !pVal || !rVal || !engineCalc || !outputResult || !outputGain) return;
      const P = parseFloat(pInput.value) || 5000;
      const rPercent = parseFloat(rInput.value) || 7;
      const t = 5;
      const r = rPercent / 100;

      pVal.textContent = `$${P.toLocaleString()}`;
      rVal.textContent = `${rPercent.toFixed(1)}%`;
      engineCalc.textContent = `${P} × (1 + ${(r).toFixed(3)})^${t}`;

      const A = P * Math.pow(1 + r, t);
      const gain = A - P;

      outputResult.textContent = `$${A.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      outputGain.textContent = `+ $${gain.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} gain`;
    }

    pInput.addEventListener('input', updateValues);
    rInput.addEventListener('input', updateValues);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMethodologyDemo);
  } else {
    initMethodologyDemo();
  }
</script>
