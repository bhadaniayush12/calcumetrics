                <math xmlns="http://www.w3.org/1998/Math/MathML" display="block" class="text-sm text-accent font-semibold py-1">
                  <mtext>CAGR</mtext>
                  <mo>=</mo>
                  <msup>
                    <mrow><mo>(</mo><mfrac><mi>FV</mi><mi>PV</mi></mfrac><mo>)</mo></mrow>
                    <mfrac><mn>1</mn><mi>n</mi></mfrac>
                  </msup>
                  <mo>−</mo>
                  <mn>1</mn>
                </math>
              </div>

              <div class="p-3 bg-canvas border border-border rounded-control overflow-x-auto">
                <div class="text-[11px] font-semibold text-text-muted mb-1">WACC Formula</div>
                <math xmlns="http://www.w3.org/1998/Math/MathML" display="block" class="text-sm text-accent font-semibold py-1">
