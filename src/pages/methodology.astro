<script>
  import { animateValue } from '../lib/animate-number';

  function initMethodologySandbox() {
    const pInput = document.getElementById('demo-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('demo-rate') as HTMLInputElement | null;
    const pVal = document.getElementById('demo-principal-val');
    const rVal = document.getElementById('demo-rate-val');
    const engineCalc = document.getElementById('demo-engine-calc');
    const outputResult = document.getElementById('demo-output-result');
    const outputGain = document.getElementById('demo-output-gain');

    if (!pInput || !rInput) return;

    function formatIndianRupee(num: number): string {
      return '₹' + new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(num));
    }

    function updateValues() {
      if (!pInput || !rInput) return;
      const P = parseFloat(pInput.value) || 500000;
      const rPercent = parseFloat(rInput.value) || 7.5;
      const t = 5;
      const r = rPercent / 100;

      if (pVal) pVal.textContent = formatIndianRupee(P);
      if (rVal) rVal.textContent = `${rPercent.toFixed(2)}%`;
      if (engineCalc) {
        engineCalc.textContent = `${P.toLocaleString('en-IN')} × (1 + ${(r).toFixed(3)})^${t}`;
      }

      const A = P * Math.pow(1 + r, t);
      const gain = A - P;

      const formattedCorpus = formatIndianRupee(A);
      const formattedGain = `+ ${formatIndianRupee(gain)} wealth gain`;

      if (outputResult) animateValue(outputResult, formattedCorpus, { duration: 150 });
      if (outputGain) animateValue(outputGain, formattedGain, { duration: 150 });
    }

    pInput.addEventListener('input', updateValues);
    rInput.addEventListener('input', updateValues);

    // Initial run
    updateValues();

    // Feedback widget handlers
    const yesBtn = document.getElementById('feedback-yes-btn');
    const noBtn = document.getElementById('feedback-no-btn');
    const feedbackBox = document.getElementById('methodology-feedback-container');

    const handleFeedback = (response: string) => {
      if (!feedbackBox) return;
      feedbackBox.innerHTML = `
        <div class="px-3 py-2 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-control text-xs font-semibold flex items-center gap-1.5">
          <span>✓ Thank you for your feedback!</span>
        </div>
      `;
      if ((window as any).__cmShowToast) {
        (window as any).__cmShowToast('Feedback recorded. Thank you!');
      }
    };

    yesBtn?.addEventListener('click', () => handleFeedback('yes'));
    noBtn?.addEventListener('click', () => handleFeedback('no'));

    // IntersectionObserver for Table of Contents active highlight
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const observedSections = document.querySelectorAll('section[id], article[id]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (id) {
              tocLinks.forEach((link) => {
                const href = link.getAttribute('href');
                if (href === `#${id}`) {
                  link.classList.add('text-accent', 'font-bold', 'bg-canvas');
                  link.classList.remove('text-text-muted');
                } else {
                  link.classList.remove('text-accent', 'font-bold', 'bg-canvas');
                  link.classList.add('text-text-muted');
                }
              });
            }
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    observedSections.forEach((sec) => observer.observe(sec));
  }

  initMethodologySandbox();
  document.addEventListener('astro:page-load', initMethodologySandbox);
</script>
