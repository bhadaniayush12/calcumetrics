---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcROI } from '../lib/calculators/business';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { initial: 100000, final: 250000, years: 3 };
const result = calcROI(DEFAULT.initial, DEFAULT.final, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'roi-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/roi-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'ROI Calculator',
      url: canonicalUrl,
      description: 'Calculate return on investment as a percentage, absolute profit, and annualised rate for any investment or business decision.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'ROI Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a good ROI for business projects?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most corporate finance teams benchmark internal projects against their Weighted Average Cost of Capital (WACC), typically requiring projects to yield at least 15% to 20% annualised ROI to justify capital risk.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does ROI differ from IRR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Simple ROI only examines starting cost and final payoff, ignoring cash inflows or outflows occurring along the way. The Internal Rate of Return (IRR) accounts for the exact timing and magnitude of intermittent cash flows.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between total ROI and annualised ROI (CAGR)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Total ROI measures the overall percentage gain across the entire investment lifecycle. Annualised ROI (CAGR) calculates the geometric compound annual growth rate, allowing direct comparison between investments of different durations.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can ROI be negative?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. If the final value is less than the initial capital invested, the net profit is negative, resulting in a negative ROI representing a capital loss.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does inflation impact real ROI?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nominal ROI does not reflect the loss of purchasing power over time. Real ROI adjusts nominal returns for inflation using the Fisher equation: Real ROI ≈ Nominal ROI − Inflation Rate.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="ROI Calculator: Return on Investment & Annualised Rate | Calcumetrics"
  description="Calculate return on investment as a percentage, absolute profit, and annualised rate for any investment or business decision."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="ROI Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={result.roi.toFixed(1) + '%'}
    heroLabel="Total Return on Investment"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">ROI Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate capital efficiency, profit gain, and annualised compound returns.</p>

      <!-- Error alert -->
      <div id="roi-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="roi-error-msg"></span>
      </div>

      <!-- Initial Investment -->
      <div class="mb-5">
        <Input
          id="roi-initial"
          label="Initial Investment"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total capital or project expenditure committed"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="roi-initial-slider" min={5000} max={5000000} step={5000} value={100000} ariaLabel="Initial investment slider" />
        </div>
      </div>

      <!-- Final Value -->
      <div class="mb-5">
        <Input
          id="roi-final"
          label="Final Value (Returned Capital)"
          prefix="₹"
          value="2,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross value returned or realized after exit"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="roi-final-slider" min={5000} max={10000000} step={10000} value={250000} ariaLabel="Final value slider" />
        </div>
      </div>

      <!-- Duration -->
      <div class="mb-6">
        <Input
          id="roi-years"
          label="Investment Horizon"
          suffix="Years"
          value="3"
          isNumeric={true}
          helperText="Time elapsed between investment and return"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="roi-years-slider" min={0.5} max={30} step={0.5} value={3} ariaLabel="Years slider" />
        </div>
      </div>

      <Alert variant="info" title="Annualised Returns">
        A 100% ROI achieved over 1 year is vastly superior to a 100% ROI achieved over 10 years. Always examine Annualised ROI (CAGR) when comparing assets.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="roi-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="roi-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Total Return on Investment</span>
        <div id="roi-result-pct" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {result.roi.toFixed(1)}%
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Profit / Gain</span>
          <span id="roi-result-profit" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.netProfit)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Annualised Return (CAGR)</span>
          <span id="roi-result-annualised" class="text-sm font-medium tabular-nums text-dark-text">{result.annualisedROI.toFixed(1)}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Investment Multiple</span>
          <span id="roi-result-multiple" class="text-sm font-medium tabular-nums text-dark-text">{(DEFAULT.final / DEFAULT.initial).toFixed(2)}x</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Realized Value</span>
          <span id="roi-result-total" class="text-sm font-bold tabular-nums text-dark-text">{fmt(DEFAULT.final)}</span>
        </div>
      </div>

      <div class="mb-5" id="roi-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.final > 0 ? DEFAULT.initial / DEFAULT.final : 1}
          gainFraction={DEFAULT.final > 0 ? Math.max(0, result.netProfit) / DEFAULT.final : 0}
          principalLabel="Initial Capital"
          gainLabel="Net Profit"
          principalValue={fmt(DEFAULT.initial)}
          gainValue={fmt(result.netProfit)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="roi-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="roi-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Standard metric for evaluating business initiatives and asset portfolios.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="roi-calculator-how">
        <h2 id="roi-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Return on Investment is calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          ROI quantifies the efficiency of an investment relative to its cost:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">
            <strong>Net Profit = </strong> Final Value − Initial Cost<br />
            <strong>Absolute ROI % = </strong> (Net Profit ÷ Initial Cost) × 100<br />
            <strong>Annualised ROI % = </strong> [(Final Value ÷ Initial Cost)<sup>(1 / Years)</sup> − 1] × 100<br />
            <strong>Investment Multiple = </strong> Final Value ÷ Initial Cost
          </p>
        </div>
      </section>

      <section aria-labelledby="roi-calculator-faq">
        <h2 id="roi-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is a good ROI for business projects?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Most corporate finance teams benchmark internal projects against their Weighted Average Cost of Capital (WACC), typically requiring projects to yield at least 15% to 20% annualised ROI to justify capital risk.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How does ROI differ from IRR?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Simple ROI only examines starting cost and final payoff, ignoring cash inflows or outflows occurring along the way. The Internal Rate of Return (IRR) accounts for the exact timing and magnitude of intermittent cash flows.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the difference between total ROI and annualised ROI (CAGR)?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Total ROI measures the overall percentage gain across the entire investment lifecycle. Annualised ROI (CAGR) calculates the geometric compound annual growth rate, allowing direct comparison between investments of different durations.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can ROI be negative?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes. If the final value is less than the initial capital invested, the net profit is negative, resulting in a negative ROI representing a capital loss.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How does inflation impact real ROI?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Nominal ROI does not reflect the loss of purchasing power over time. Real ROI adjusts nominal returns for inflation using the Fisher equation: Real ROI ≈ Nominal ROI − Inflation Rate.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="roi-calculator-related">
        <h2 id="roi-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcROI } from '../lib/calculators/business';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initROICalc() {
    if ((window as any).__cmRoiBound) return;
    (window as any).__cmRoiBound = true;

    const initInput = document.getElementById('roi-initial') as HTMLInputElement | null;
    const finalInput = document.getElementById('roi-final') as HTMLInputElement | null;
    const yearsInput = document.getElementById('roi-years') as HTMLInputElement | null;

    const initSlider = document.getElementById('roi-initial-slider') as HTMLInputElement | null;
    const finalSlider = document.getElementById('roi-final-slider') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('roi-years-slider') as HTMLInputElement | null;

    const resPct = document.getElementById('roi-result-pct');
    const resProfit = document.getElementById('roi-result-profit');
    const resAnnualised = document.getElementById('roi-result-annualised');
    const resMultiple = document.getElementById('roi-result-multiple');
    const resTotal = document.getElementById('roi-result-total');

    const errAlert = document.getElementById('roi-error-alert');
    const errMsg = document.getElementById('roi-error-msg');

    if (!initInput || !finalInput || !yearsInput) return;

    const DEFAULTS = { initial: 100000, final: 250000, years: 3 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawInit = initInput!.value.replace(/[^0-9.]/g, '');
      const rawFinal = finalInput!.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput!.value.replace(/[^0-9.]/g, '');

      const vInit = validate(rawInit, { required: true, min: 1, label: 'Initial Investment' });
      const vFinal = validate(rawFinal, { required: true, min: 0, label: 'Final Value' });
      const vYears = validate(rawYears, { required: true, min: 0.1, max: 100, label: 'Investment Horizon' });

      if (!vInit.valid) { showError(vInit.error!.message); return; }
      if (!vFinal.valid) { showError(vFinal.error!.message); return; }
      if (!vYears.valid) { showError(vYears.error!.message); return; }
      clearError();

      const initVal = vInit.value!;
      const finalVal = vFinal.value!;
      const yrs = vYears.value!;

      const res = calcROI(initVal, finalVal, yrs);
      const multiple = initVal > 0 ? finalVal / initVal : 0;

      setResult({
        heroValue: `${res.roi.toFixed(1)}%`,
        heroLabel: 'Total Return on Investment',
        rows: [
          { label: 'Net Profit / Gain', value: fmtVal(res.netProfit) },
          { label: 'Annualised Return (CAGR)', value: `${res.annualisedROI.toFixed(1)}%` },
          { label: 'Investment Multiple', value: `${multiple.toFixed(2)}x` },
          { label: 'Total Realized Value', value: fmtVal(finalVal) },
        ],
      });

      if (resPct) resPct.textContent = `${res.roi.toFixed(1)}%`;
      if (resProfit) resProfit.textContent = fmtVal(res.netProfit);
      if (resAnnualised) resAnnualised.textContent = `${res.annualisedROI.toFixed(1)}%`;
      if (resMultiple) resMultiple.textContent = `${multiple.toFixed(2)}x`;
      if (resTotal) resTotal.textContent = fmtVal(finalVal);

      const wrapper = document.getElementById('roi-composition-wrapper');
      if (wrapper && finalVal > 0) {
        const initFrac = Math.min(1, initVal / finalVal);
        const profitFrac = Math.min(1, Math.max(0, res.netProfit) / finalVal);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(initFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(profitFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(initVal);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.netProfit);
      }

      serializeHash({ i: initVal, f: finalVal, y: yrs });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(initSlider, initInput, true);
    sync(finalSlider, finalInput, true);
    sync(yearsSlider, yearsInput, false);

    document.getElementById('roi-calculate')?.addEventListener('click', recalc);
    document.getElementById('roi-reset')?.addEventListener('click', () => {
      initInput.value = fmtLiveInput(String(DEFAULTS.initial));
      finalInput.value = fmtLiveInput(String(DEFAULTS.final));
      yearsInput.value = String(DEFAULTS.years);

      if (initSlider) {
        initSlider.value = String(DEFAULTS.initial);
        initSlider.style.setProperty('--slider-pct', `${((DEFAULTS.initial - 5000) / (5000000 - 5000)) * 100}%`);
      }
      if (finalSlider) {
        finalSlider.value = String(DEFAULTS.final);
        finalSlider.style.setProperty('--slider-pct', `${((DEFAULTS.final - 5000) / (10000000 - 5000)) * 100}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 0.5) / (30 - 0.5)) * 100}%`);
      }

      clearError();
      recalc();
      initInput.focus();
    });

    [initInput, finalInput, yearsInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('roi-copy-btn')?.addEventListener('click', async () => {
      const rawInit = initInput.value.replace(/[^0-9.]/g, '');
      const rawFinal = finalInput.value.replace(/[^0-9.]/g, '');
      const rawYears = yearsInput.value.replace(/[^0-9.]/g, '');
      const vInit = validate(rawInit, { required: true, min: 1, label: 'Initial Investment' });
      const vFinal = validate(rawFinal, { required: true, min: 0, label: 'Final Value' });
      const vYears = validate(rawYears, { required: true, min: 0.1, label: 'Years' });
      if (!vInit.valid || !vFinal.valid || !vYears.valid) return;

      const initVal = vInit.value!;
      const finalVal = vFinal.value!;
      const yrs = vYears.value!;
      const res = calcROI(initVal, finalVal, yrs);
      const multiple = initVal > 0 ? finalVal / initVal : 0;
      const text = `ROI Result: Invested ${fmtVal(initVal)}, Returned ${fmtVal(finalVal)} over ${yrs} years => Total ROI: ${res.roi.toFixed(1)}%, CAGR: ${res.annualisedROI.toFixed(1)}% (${multiple.toFixed(2)}x). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('roi-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('roi-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('roi-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      i: { required: true, min: 1, label: 'i' },
      f: { required: true, min: 0, label: 'f' },
      y: { required: true, min: 0.1, label: 'y' },
    });
    if (restored.valid && restored.values.i && restored.values.f !== undefined && restored.values.y) {
      initInput.value = fmtLiveInput(String(restored.values.i));
      finalInput.value = fmtLiveInput(String(restored.values.f));
      yearsInput.value = String(restored.values.y);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initROICalc();
  document.addEventListener('astro:page-load', initROICalc);
</script>
