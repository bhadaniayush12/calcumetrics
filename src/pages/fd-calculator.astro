---
/**
 * FD Calculator — /fd-calculator
 * Master SEO & UX Gold Standard Template
 * Live reactive calculations, preset chips, compact Indian numbers, WhatsApp sharing,
 * featured snippet answer, step-by-step worked example, formula breakdown, and 6 real FAQs.
 */

import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Alert from '../components/ui/Alert.astro';
import { calcFD, type FDCompoundFreq } from '../lib/calculators/fd';
import { formatCurrency, formatIndian, formatIndianCompact, formatIndianWords } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 7.1, years: 5, freq: 'quarterly' as FDCompoundFreq };
const result = calcFD(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, DEFAULT.freq);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));
const heroExact = fmt(result.maturity);
const heroCompact = formatIndianCompact(result.maturity, '₹');
const principalExact = fmt(DEFAULT.principal);
const principalCompact = formatIndianCompact(DEFAULT.principal, '₹');
const interestExact = fmt(result.interest);
const interestCompact = formatIndianCompact(result.interest, '₹');

const related = TOOLS.filter(
  (t) => (t.category === 'Investments' || t.category === 'Loans') && t.slug !== 'fd-calculator' && t.status === 'published'
).slice(0, 4);

const canonicalUrl = 'https://calcumetrics.com/fd-calculator';
const pageTitle = 'FD Calculator: Fixed Deposit Interest & Returns | Calcumetrics';
const pageDesc = 'Free FD calculator. Calculate bank fixed deposit maturity, compare fd interest calculator rates, quarterly compounding, and senior citizen returns.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Fixed Deposit (FD) Calculator',
      url: canonicalUrl,
      description: pageDesc,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-24',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Fixed Deposit Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How is Fixed Deposit (FD) interest compounded in Indian banks?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most commercial banks in India (including SBI, HDFC Bank, ICICI Bank, and Punjab National Bank) compound FD interest on a quarterly basis (every 3 months). The accrued quarterly interest is added to the principal to generate higher compound yields.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do senior citizens get higher FD interest rates?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Indian banks provide an additional interest rate premium of 0.50% to 0.75% per annum for depositors aged 60 and above. Certain banks also offer super-senior citizen schemes (age 80+) with up to 0.80% extra return.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is FD interest taxable, and what are the TDS limits?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, interest earned on fixed deposits is fully taxable under Income from Other Sources at your applicable income tax slab rate. Under Section 194A, banks deduct 10% TDS if cumulative FD interest across branches exceeds ₹40,000 per financial year (₹50,000 for senior citizens).',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a 5-Year Tax-Saving Fixed Deposit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A 5-year tax-saving FD allows individuals to claim a tax deduction of up to ₹1.5 lakh under Section 80C of the Income Tax Act (Old Tax Regime). These deposits have a mandatory 5-year lock-in period with no premature withdrawal or loan facility.',
          },
        },
        {
          '@type': 'Question',
          name: 'What formula is used to compute FD maturity?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The standard compound interest formula is A = P × (1 + r / n)^(n × t), where P is principal, r is annual nominal rate in decimal, n is compounding frequency (4 for quarterly), and t is duration in years.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I withdraw my fixed deposit before maturity?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, regular fixed deposits allow premature withdrawal, though banks usually penalize premature closure with a 0.5% to 1.0% interest rate penalty on the applicable rate for the contracted tenure.',
          },
        },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <CalculatorLayout
    toolName="Fixed Deposit (FD) Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={heroExact}
    heroLabel="Maturity Value"
  >
    <!-- ── INPUT CARD ─────────────────────────────────────────────────────────── -->
    <Fragment slot="inputs">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          Fixed Deposit Calculator
        </h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Live Reactive
        </span>
      </div>
      <p class="text-sm text-text-muted mb-6 leading-relaxed">
        Calculate guaranteed returns on your bank fixed deposit with standard quarterly compounding.
      </p>

      <!-- Currency selector -->
      <div class="mb-5">
        <Dropdown
          id="fd-currency"
          label="Display Currency & Grouping"
          options={[
            { value: 'INR', label: '₹ Indian Rupee (INR) — Lakhs & Crores' },
            { value: 'USD', label: '$ US Dollar (USD)' },
            { value: 'EUR', label: '€ Euro (EUR)' },
            { value: 'GBP', label: '£ British Pound (GBP)' },
          ]}
          value="INR"
          helperText="Adjusts currency symbol and number format"
        />
      </div>

      <!-- Deposit Amount + Presets -->
      <div class="mb-6">
        <Input
          id="fd-principal"
          label="Deposit Amount"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Principal investment sum"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-principal-slider" min={5000} max={10000000} step={5000} value={100000} ariaLabel="Deposit amount slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Deposit amount presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 25000, label: '₹25k' },
            { val: 100000, label: '₹1L' },
            { val: 500000, label: '₹5L' },
            { val: 1000000, label: '₹10L' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-principal={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Interest Rate + Presets -->
      <div class="mb-6">
        <Input
          id="fd-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="7.1"
          isNumeric={true}
          helperText="Bank interest rate per annum"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-rate-slider" min={3} max={12} step={0.1} value={7.1} ariaLabel="Interest rate slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Interest rate presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 6.5, label: '6.5% (Short-term)' },
            { val: 7.1, label: '7.1% (Standard)' },
            { val: 7.6, label: '7.6% (Senior citizen)' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-rate={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Tenure + Presets -->
      <div class="mb-6">
        <Input
          id="fd-years"
          label="Tenure (Years)"
          suffix="Yrs"
          value="5"
          isNumeric={true}
          helperText="Fixed deposit duration in years"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-years-slider" min={0.5} max={10} step={0.5} value={5} ariaLabel="Tenure slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Tenure presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 1, label: '1 Yr' },
            { val: 3, label: '3 Yrs' },
            { val: 5, label: '5 Yrs (Tax-Saver)' },
            { val: 10, label: '10 Yrs' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-years={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Compounding Frequency -->
      <div class="mb-5">
        <Dropdown
          id="fd-compounding"
          label="Compounding Frequency"
          options={[
            { value: 'quarterly', label: 'Quarterly Compounding (Indian Bank Standard)' },
            { value: 'monthly', label: 'Monthly Compounding' },
            { value: 'half-yearly', label: 'Half-Yearly Compounding' },
            { value: 'annually', label: 'Annual Compounding' },
          ]}
          value="quarterly"
          helperText="Most Indian banks compound FD interest quarterly"
        />
      </div>

      <!-- Validation Error Container -->
      <div id="fd-error-alert" class="hidden mb-4">
        <Alert variant="error" title="Validation Error">
          <span id="fd-error-message">Please check your inputs.</span>
        </Alert>
      </div>

      <div class="flex justify-end pt-2">
        <button
          type="button"
          id="fd-reset"
          class="text-xs text-text-muted hover:text-accent font-medium py-1 px-2 rounded hover:bg-surface transition-standard cursor-pointer"
        >
          Reset to defaults
        </button>
      </div>
    </Fragment>

    <!-- ── OUTPUT PANEL ────────────────────────────────────────────────────────── -->
    <Fragment slot="outputs">
      <!-- Maturity Value Hero -->
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-dark-muted block mb-1">
          Guaranteed Maturity Value
        </span>
        <div class="flex items-baseline gap-2 flex-wrap">
          <div
            id="fd-result-maturity-compact"
            class="text-3xl sm:text-4xl font-extrabold tabular-nums text-dark-text tracking-tight"
            aria-live="polite"
            aria-atomic="true"
          >
            {heroCompact}
          </div>
          <span id="fd-result-maturity" class="text-xs sm:text-sm text-dark-muted font-mono tabular-nums">
            ({heroExact})
          </span>
        </div>
      </div>

      <!-- Breakdown metrics -->
      <div class="space-y-0 border-t border-dark-border pt-4 mb-4">
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Deposit Principal</span>
          <div class="text-right">
            <span id="fd-result-principal-compact" class="text-sm font-semibold tabular-nums text-dark-text mr-1.5">{principalCompact}</span>
            <span id="fd-result-principal" class="text-xs text-dark-muted tabular-nums font-mono">({principalExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Interest Earned</span>
          <div class="text-right">
            <span id="fd-result-interest-compact" class="text-sm font-bold tabular-nums text-dark-accent mr-1.5">+{interestCompact}</span>
            <span id="fd-result-gain" class="text-xs text-dark-accent/80 tabular-nums font-mono">(+{interestExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-xs text-dark-muted">Return on Investment</span>
          <span id="fd-result-gain-pct" class="text-sm font-bold tabular-nums text-dark-accent">{((result.interest / DEFAULT.principal) * 100).toFixed(1)}%</span>
        </div>
      </div>

      <!-- Composition bar -->
      <div class="mb-4" id="fd-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.interestFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={principalExact}
          gainValue={interestExact}
        />
      </div>

      <!-- Tax & TDS Notice Box -->
      <div class="p-3 rounded-control bg-dark-border/40 border border-dark-border text-xs text-dark-text mb-4 space-y-1">
        <p class="leading-relaxed">
          TDS under Section 194A applies if annual interest exceeds <strong>₹40,000</strong> (₹50,000 for senior citizens).
        </p>
      </div>

      <!-- Share Actions -->
      <div class="space-y-2">
        <a
          id="fd-whatsapp-btn"
          href="https://api.whatsapp.com/send?text=Check%20out%20my%20FD%20calculation:%20%E2%82%B91%20Lakh%20at%207.1%25%20for%205%20years%20matures%20to%20%E2%82%B91.42%20Lakh%20on%20Calcumetrics:%20https://calcumetrics.com/fd-calculator"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full h-10 text-xs font-semibold rounded-control bg-[#25D366] text-white hover:opacity-90 transition-standard focus-visible:outline-2 focus-visible:outline-white cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.782 2.791.782 3.183 0 5.769-2.587 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.362c-.896 0-1.637-.247-2.366-.679l-.17-.1-1.758.461.469-1.714-.111-.177c-.476-.757-.727-1.466-.726-2.392.001-2.483 2.022-4.503 4.506-4.503 2.481 0 4.502 2.021 4.503 4.503-.001 2.483-2.023 4.503-4.507 4.503zm2.593-3.374c-.142-.071-.84-.415-.97-.462-.13-.047-.225-.071-.32.071-.095.142-.367.462-.45.557-.083.095-.166.107-.308.036s-.601-.222-1.145-.707c-.424-.378-.71-.845-.793-.987-.083-.142-.009-.219.062-.29.064-.064.142-.166.213-.249.071-.083.095-.142.142-.237.047-.095.024-.178-.012-.249s-.32-.771-.439-1.055c-.116-.277-.234-.239-.32-.243-.083-.004-.178-.005-.273-.005s-.249.036-.379.178c-.13.142-.498.486-.498 1.185s.51 1.375.581 1.47c.071.095 1.004 1.533 2.433 2.15.34.147.606.235.813.301.341.109.652.093.898.056.274-.041.84-.344.959-.676.119-.332.119-.617.083-.676-.035-.06-.13-.095-.272-.166z"/>
          </svg>
          Share on WhatsApp
        </a>
        <div class="flex gap-2">
          <button
            type="button"
            id="fd-copy-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Copy Result
          </button>
          <button
            type="button"
            id="fd-share-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Share Link
          </button>
        </div>
      </div>
    </Fragment>

    <!-- ── BELOW THE FOLD (SEO CONTENT) ───────────────────────────────────────── -->
    <Fragment slot="below">

      <!-- 1. Featured Snippet Direct Answer Box -->
      <div class="p-5 bg-surface border-l-4 border-accent rounded-r-card mb-8 shadow-sm">
        <p class="text-xs font-bold text-accent uppercase tracking-wider mb-1">Quick Answer / Summary</p>
        <p class="text-sm text-text-primary leading-relaxed" id="fd-snippet-answer">
          A fixed deposit of <strong>₹1.00 Lakh</strong> at an interest rate of <strong>7.10% p.a.</strong> with quarterly compounding over a <strong>5-year tenure</strong> yields a guaranteed maturity amount of <strong>₹1.42 Lakh</strong> (₹1,42,010). The total compound interest earned is <strong>₹42,010</strong>.
        </p>
      </div>

      <!-- 2. Formula & Explanation -->
      <section aria-labelledby="fd-how" class="mb-10">
        <h2 id="fd-how" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">How Fixed Deposit interest is calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          A Fixed Deposit (FD) is a secure investment instrument provided by banks and NBFCs offering guaranteed returns with quarterly compounding. Unlike a simple interest deposit where interest remains uninvested, quarterly compounding reinvests your interest every 3 months.
        </p>

        <!-- Formula block -->
        <div class="bg-surface border border-border rounded-card p-5 mb-5 overflow-x-auto">
          <div class="text-base sm:text-lg font-mono text-accent font-bold mb-3 tracking-wide">
            A = P × (1 + r / n)ⁿᵗ
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-text-muted border-t border-border pt-3">
            <div><strong class="text-text-primary">A</strong> = Final maturity amount</div>
            <div><strong class="text-text-primary">P</strong> = Principal deposit sum</div>
            <div><strong class="text-text-primary">r</strong> = Annual nominal interest rate = Rate / 100</div>
            <div><strong class="text-text-primary">n</strong> = Compounding frequency per year (4 for quarterly)</div>
            <div><strong class="text-text-primary">t</strong> = Tenure in years</div>
          </div>
        </div>
      </section>

      <!-- 3. Worked numerical example -->
      <section aria-labelledby="fd-example" class="mb-10">
        <h2 id="fd-example" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">Worked mathematical example</h2>
        <p class="text-sm text-text-muted mb-4">
          Calculating maturity for a ₹1,00,000 deposit at 7.1% p.a. compounded quarterly for 5 years:
        </p>
        <div class="space-y-3 bg-surface border border-border rounded-card p-5 text-xs text-text-muted">
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 1:</span>
            <span>Quarterly rate: <code>r / 4 = 0.071 / 4 = 0.01775</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 2:</span>
            <span>Total compounding quarters: <code>n × t = 4 × 5 = 20 quarters</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 3:</span>
            <span>Compound growth factor: <code>(1 + 0.01775)²⁰ ≈ 1.42010</code></span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-accent">Step 4:</span>
            <span>Final maturity: <code>1,00,000 × 1.42010 = ₹1,42,010</code></span>
          </div>
          <div class="pt-2 border-t border-border flex justify-between font-medium text-text-primary text-sm">
            <span>Principal: ₹1,00,000</span>
            <span class="text-accent font-bold">Interest Earned: ₹42,010</span>
          </div>
        </div>
      </section>

      <!-- 4. Real FAQs -->
      <section aria-labelledby="fd-faq" class="mb-10">
        <h2 id="fd-faq" class="text-xl sm:text-2xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            {
              q: 'How is Fixed Deposit (FD) interest compounded in Indian banks?',
              a: 'Most commercial banks in India (including SBI, HDFC Bank, ICICI Bank, and Punjab National Bank) compound FD interest on a quarterly basis (every 3 months). The accrued quarterly interest is added to the principal to generate higher compound yields.',
            },
            {
              q: 'Do senior citizens get higher FD interest rates?',
              a: 'Yes. Indian banks provide an additional interest rate premium of 0.50% to 0.75% per annum for depositors aged 60 and above. Certain banks also offer super-senior citizen schemes (age 80+) with up to 0.80% extra return.',
            },
            {
              q: 'Is FD interest taxable, and what are the TDS limits?',
              a: 'Yes, interest earned on fixed deposits is fully taxable under Income from Other Sources at your applicable income tax slab rate. Under Section 194A, banks deduct 10% TDS if cumulative FD interest across branches exceeds ₹40,000 per financial year (₹50,000 for senior citizens).',
            },
            {
              q: 'What is a 5-Year Tax-Saving Fixed Deposit?',
              a: 'A 5-year tax-saving FD allows individuals to claim a tax deduction of up to ₹1.5 lakh under Section 80C of the Income Tax Act (Old Tax Regime). These deposits have a mandatory 5-year lock-in period with no premature withdrawal or loan facility.',
            },
            {
              q: 'What formula is used to compute FD maturity?',
              a: 'The standard compound interest formula is A = P × (1 + r / n)^(n × t), where P is principal, r is annual nominal rate in decimal, n is compounding frequency (4 for quarterly), and t is duration in years.',
            },
            {
              q: 'Can I withdraw my fixed deposit before maturity?',
              a: 'Yes, regular fixed deposits allow premature withdrawal, though banks usually penalize premature closure with a 0.5% to 1.0% interest rate penalty on the applicable rate for the contracted tenure.',
            },
          ].map((item) => (
            <details class="border border-border rounded-card overflow-hidden bg-surface">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-semibold text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">
                {item.q}
              </summary>
              <div class="px-5 pb-4 pt-1 text-xs sm:text-sm text-text-muted leading-relaxed">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- 5. Related Calculators -->
      <section aria-labelledby="fd-related" class="mb-10">
        <h2 id="fd-related" class="text-xl sm:text-2xl font-bold text-text-primary mb-4">Related investment calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((tool) => (
            <a
              href={tool.path}
              class="group block bg-surface border border-border rounded-card p-4 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
            >
              <span class="text-[11px] font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed line-clamp-2">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- 6. Authoritative Footer Review -->
      <div class="border-t border-border pt-6 pb-2 flex flex-col sm:flex-row items-center justify-between text-xs text-text-muted gap-2">
        <div>
          <span>Last updated: <strong>September 2026</strong></span>
          <span class="mx-2">·</span>
          <span>Verified against standard banking compounding conventions</span>
        </div>
        <div>
          <a href="/methodology" class="hover:text-accent underline transition-standard">View formula methodology</a>
        </div>
      </div>

    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcFD, type FDCompoundFreq } from '../lib/calculators/fd';
  import { setResult } from '../lib/result-bus';
  import { validate } from '../lib/validate';
  import { restoreFromHash, serializeHash, updateHash } from '../lib/url-state';
  import { formatIndian, formatIndianCompact, formatCompactCurrency } from '../lib/formatters';
  import { getStoredCurrency, CURRENCY_CONFIG, type CurrencyCode } from '../lib/currency';

  const fdSchema = {
    principal: { required: true, min: 500, max: 100000000, integerOnly: true, label: 'Deposit Amount' },
    rate: { required: true, min: 1, max: 20, decimal: true, label: 'Annual Interest Rate' },
    years: { required: true, min: 0.1, max: 30, decimal: true, label: 'Tenure (Years)' },
  } as const;

  let currentCurrencyCode: CurrencyCode = getStoredCurrency();
  let currentCurrencySymbol = CURRENCY_CONFIG[currentCurrencyCode]?.symbol || '₹';
  let currentNumberLocale = CURRENCY_CONFIG[currentCurrencyCode]?.locale || 'en-IN';

  function fmtNumber(n: number): string {
    return new Intl.NumberFormat(currentNumberLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtCurrency(n: number): string {
    return currentCurrencySymbol + fmtNumber(n);
  }

  function fmtCompact(n: number): string {
    return currentCurrencyCode === 'INR'
      ? formatIndianCompact(n, currentCurrencySymbol)
      : formatCompactCurrency(n, currentCurrencyCode);
  }

  function fmtLiveIndian(raw: string): string {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    if (isNaN(num)) return '';
    return new Intl.NumberFormat(currentNumberLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initFDCalc() {
    const principalInput = document.getElementById('fd-principal') as HTMLInputElement | null;
    const principalSlider = document.getElementById('fd-principal-slider') as HTMLInputElement | null;
    const rateInput = document.getElementById('fd-rate') as HTMLInputElement | null;
    const rateSlider = document.getElementById('fd-rate-slider') as HTMLInputElement | null;
    const yearsInput = document.getElementById('fd-years') as HTMLInputElement | null;
    const yearsSlider = document.getElementById('fd-years-slider') as HTMLInputElement | null;
    const compoundingSelect = document.getElementById('fd-compounding') as HTMLSelectElement | null;

    const copyBtn = document.getElementById('fd-copy-btn');
    const shareBtn = document.getElementById('fd-share-btn');
    const whatsappBtn = document.getElementById('fd-whatsapp-btn') as HTMLAnchorElement | null;
    const resetBtn = document.getElementById('fd-reset');
    const currencyDropdown = document.getElementById('fd-currency') as HTMLSelectElement | null;
    const errorAlert = document.getElementById('fd-error-alert');
    const errorMessage = document.getElementById('fd-error-message');

    const resMaturityCompact = document.getElementById('fd-result-maturity-compact');
    const resMaturity = document.getElementById('fd-result-maturity');
    const resPrincipalCompact = document.getElementById('fd-result-principal-compact');
    const resPrincipal = document.getElementById('fd-result-principal');
    const resInterestCompact = document.getElementById('fd-result-interest-compact');
    const resInterest = document.getElementById('fd-result-gain');
    const resGainPct = document.getElementById('fd-result-gain-pct');

    const snippetAnswer = document.getElementById('fd-snippet-answer');

    if (!principalInput || !rateInput || !yearsInput) return;

    const DEFAULTS = { principal: 100000, rate: 7.1, years: 5 };
    let debounceTimer: ReturnType<typeof setTimeout>;

    function updateCompositionBar(pFraction: number, iFraction: number, principal: number, interest: number) {
      const wrapper = document.getElementById('fd-composition-wrapper');
      if (!wrapper) return;
      const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
      const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
      if (bar) bar.style.width = `${(pFraction * 100).toFixed(2)}%`;
      if (gainBar) gainBar.style.width = `${(iFraction * 100).toFixed(2)}%`;
      const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
      if (legendEls[0]) legendEls[0].textContent = fmtCurrency(principal);
      if (legendEls[1]) legendEls[1].textContent = fmtCurrency(interest);
    }

    function showValidationFeedback(errorMsg?: string) {
      if (errorAlert) {
        if (errorMsg) {
          if (errorMessage) errorMessage.textContent = errorMsg;
          errorAlert.classList.remove('hidden');
        } else {
          errorAlert.classList.add('hidden');
        }
      }
    }

    function recalc() {
      const vPrincipal = validate(principalInput.value, fdSchema.principal);
      const vRate = validate(rateInput.value, fdSchema.rate);
      const vYears = validate(yearsInput.value, fdSchema.years);

      if (!vPrincipal.valid) {
        showValidationFeedback(vPrincipal.error.message);
        principalInput.setAttribute('aria-invalid', 'true');
        return;
      }
      principalInput.removeAttribute('aria-invalid');

      if (!vRate.valid) {
        showValidationFeedback(vRate.error.message);
        rateInput.setAttribute('aria-invalid', 'true');
        return;
      }
      rateInput.removeAttribute('aria-invalid');

      if (!vYears.valid) {
        showValidationFeedback(vYears.error.message);
        yearsInput.setAttribute('aria-invalid', 'true');
        return;
      }
      yearsInput.removeAttribute('aria-invalid');

      showValidationFeedback();

      const principal = vPrincipal.value!;
      const rate = vRate.value!;
      const years = vYears.value!;
      const freq = (compoundingSelect?.value as FDCompoundFreq) || 'quarterly';

      const r = calcFD(principal, rate, years, freq);

      const compMaturity = fmtCompact(r.maturity);
      const compPrincipal = fmtCompact(principal);
      const compInterest = fmtCompact(r.interest);
      const returnPct = principal > 0 ? ((r.interest / principal) * 100).toFixed(1) + '%' : '0%';

      if (resMaturityCompact) resMaturityCompact.textContent = compMaturity;
      if (resMaturity) resMaturity.textContent = `(${fmtCurrency(r.maturity)})`;
      if (resPrincipalCompact) resPrincipalCompact.textContent = compPrincipal;
      if (resPrincipal) resPrincipal.textContent = `(${fmtCurrency(principal)})`;
      if (resInterestCompact) resInterestCompact.textContent = `+${compInterest}`;
      if (resInterest) resInterest.textContent = `(+${fmtCurrency(r.interest)})`;
      if (resGainPct) resGainPct.textContent = returnPct;

      updateCompositionBar(r.principalFraction, r.interestFraction, principal, r.interest);

      if (snippetAnswer) {
        snippetAnswer.innerHTML = `A fixed deposit of <strong>${compPrincipal}</strong> (${fmtCurrency(principal)}) at an interest rate of <strong>${rate.toFixed(2)}% p.a.</strong> with ${freq} compounding over a <strong>${years}-year tenure</strong> yields a guaranteed maturity amount of <strong>${compMaturity}</strong> (${fmtCurrency(r.maturity)}). The total compound interest earned is <strong>${compInterest}</strong>.`;
      }

      if (whatsappBtn) {
        const shareMsg = encodeURIComponent(
          `Fixed Deposit (FD) Calculation:\nDeposit: ${compPrincipal}\nRate: ${rate}% p.a.\nTenure: ${years} years\nMaturity Value: ${compMaturity} (${fmtCurrency(r.maturity)})\nInterest Earned: +${compInterest}\nCalculate on Calcumetrics: ${location.href.split('#')[0]}#p=${principal}&r=${rate}&y=${years}`
        );
        whatsappBtn.href = `https://api.whatsapp.com/send?text=${shareMsg}`;
      }

      const canonicalResult = {
        heroValue: compMaturity,
        heroLabel: 'Maturity Value',
        rows: [
          { label: 'Deposit Principal', value: compPrincipal },
          { label: 'Interest Earned', value: compInterest, variant: 'accent' as const },
          { label: 'Return on Investment', value: returnPct },
        ],
        fields: {
          'fd-result-maturity': fmtCurrency(r.maturity),
          'fd-result-principal': fmtCurrency(principal),
          'fd-result-gain': fmtCurrency(r.interest),
        },
        meta: {
          principalFraction: r.principalFraction,
          interestFraction: r.interestFraction,
          principal,
          interest: r.interest,
          maturity: r.maturity,
        },
      };

      setResult(canonicalResult);
      if ((window as any).__cmResultStore) {
        (window as any).__cmResultStore.setResult(canonicalResult);
      }
      window.dispatchEvent(new CustomEvent('cm:result', { detail: canonicalResult }));

      const hash = serializeHash({ p: principal, r: rate, y: years });
      updateHash(hash, true);
    }

    function debounceRecalc() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(recalc, 60);
    }

    function syncSlider(slider: HTMLInputElement, input: HTMLInputElement, isFormatted: boolean) {
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveIndian(slider.value) : slider.value;
        const min = parseFloat(slider.min), max = parseFloat(slider.max), val = parseFloat(slider.value);
        const pct = ((val - min) / (max - min)) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounceRecalc();
      });

      input.addEventListener('input', () => {
        const v = validate(input.value, { decimal: true, negativeAllowed: false });
        if (v.valid && v.value !== undefined) {
          const num = v.value;
          if (num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
            slider.value = String(num);
            const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
            slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
          }
        }
        debounceRecalc();
      });

      input.addEventListener('blur', () => {
        if (isFormatted) {
          const v = validate(input.value, { integerOnly: true });
          if (v.valid && v.value !== undefined) {
            input.value = fmtLiveIndian(String(v.value));
          }
        }
      });
    }

    if (principalSlider) syncSlider(principalSlider, principalInput, true);
    if (rateSlider) syncSlider(rateSlider, rateInput, false);
    if (yearsSlider) syncSlider(yearsSlider, yearsInput, false);
    compoundingSelect?.addEventListener('change', debounceRecalc);

    if (principalSlider) {
      const min = parseFloat(principalSlider.min), max = parseFloat(principalSlider.max), val = parseFloat(principalSlider.value);
      principalSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (rateSlider) {
      const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max), val = parseFloat(rateSlider.value);
      rateSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }
    if (yearsSlider) {
      const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max), val = parseFloat(yearsSlider.value);
      yearsSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min) * 100).toFixed(2)}%`);
    }

    // ── Preset Chips ─────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('[data-chip-principal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-principal');
        if (val) {
          principalInput.value = fmtLiveIndian(val);
          if (principalSlider) {
            principalSlider.value = val;
            const min = parseFloat(principalSlider.min), max = parseFloat(principalSlider.max);
            principalSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-rate]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-rate');
        if (val) {
          rateInput.value = val;
          if (rateSlider) {
            rateSlider.value = val;
            const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max);
            rateSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-years]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-years');
        if (val) {
          yearsInput.value = val;
          if (yearsSlider) {
            yearsSlider.value = val;
            const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max);
            yearsSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min) * 100).toFixed(2)}%`);
          }
          debounceRecalc();
        }
      });
    });

    // ── Reset ────────────────────────────────────────────────────────────────
    resetBtn?.addEventListener('click', () => {
      principalInput.value = fmtLiveIndian(String(DEFAULTS.principal));
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);
      if (principalSlider) {
        principalSlider.value = String(DEFAULTS.principal);
        principalSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 5000) / (10000000 - 5000) * 100).toFixed(2)}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 3) / (12 - 3) * 100).toFixed(2)}%`);
      }
      if (yearsSlider) {
        yearsSlider.value = String(DEFAULTS.years);
        yearsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 0.5) / (10 - 0.5) * 100).toFixed(2)}%`);
      }
      showValidationFeedback();
      recalc();
      principalInput.focus();
    });

    // ── Restore from URL Hash ────────────────────────────────────────────────
    const restored = restoreFromHash(location.hash, {
      p: fdSchema.principal,
      r: fdSchema.rate,
      y: fdSchema.years,
    });

    if (restored.values.p !== undefined) {
      principalInput.value = fmtLiveIndian(String(restored.values.p));
      if (principalSlider) {
        principalSlider.value = String(Math.min(restored.values.p, 10000000));
        const min = parseFloat(principalSlider.min), max = parseFloat(principalSlider.max);
        principalSlider.style.setProperty('--slider-pct', `${((parseFloat(principalSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
      }
    }
    if (restored.values.r !== undefined) {
      rateInput.value = String(restored.values.r);
      if (rateSlider) {
        rateSlider.value = String(Math.min(restored.values.r, 12));
        const min = parseFloat(rateSlider.min), max = parseFloat(rateSlider.max);
        rateSlider.style.setProperty('--slider-pct', `${((parseFloat(rateSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
      }
    }
    if (restored.values.y !== undefined) {
      yearsInput.value = String(restored.values.y);
      if (yearsSlider) {
        yearsSlider.value = String(Math.min(restored.values.y, 10));
        const min = parseFloat(yearsSlider.min), max = parseFloat(yearsSlider.max);
        yearsSlider.style.setProperty('--slider-pct', `${((parseFloat(yearsSlider.value) - min) / (max - min) * 100).toFixed(2)}%`);
      }
    }

    recalc();

    // ── Copy & Share ─────────────────────────────────────────────────────────
    async function flashBtn(btn: HTMLElement, label: string) {
      const orig = btn.textContent;
      btn.textContent = label;
      btn.setAttribute('aria-label', label);
      await new Promise((r) => setTimeout(r, 2000));
      btn.textContent = orig;
      btn.setAttribute('aria-label', orig ?? '');
    }

    copyBtn?.addEventListener('click', async () => {
      const vP = validate(principalInput.value, fdSchema.principal);
      const vR = validate(rateInput.value, fdSchema.rate);
      const vY = validate(yearsInput.value, fdSchema.years);
      if (!vP.valid || !vR.valid || !vY.valid) return;

      const r = calcFD(vP.value!, vR.value!, vY.value!, (compoundingSelect?.value as FDCompoundFreq) || 'quarterly');
      const text = `FD Calculator: ${fmtCompact(vP.value!)} at ${vR.value!}% p.a. for ${vY.value!} years matures to ${fmtCompact(r.maturity)} (${fmtCurrency(r.maturity)}). Calculated on Calcumetrics: ${location.href.split('#')[0]}${serializeHash({ p: vP.value!, r: vR.value!, y: vY.value! })}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(copyBtn, 'Copied!');
    });

    shareBtn?.addEventListener('click', async () => {
      const vP = validate(principalInput.value, fdSchema.principal);
      const vR = validate(rateInput.value, fdSchema.rate);
      const vY = validate(yearsInput.value, fdSchema.years);
      const hash = vP.valid && vR.valid && vY.valid
        ? serializeHash({ p: vP.value!, r: vR.value!, y: vY.value! })
        : location.hash;
      const url = `${location.href.split('#')[0]}${hash}`;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      flashBtn(shareBtn, 'Copied Link!');
    });

    // ── Currency synchronization ─────────────────────────────────────────────
    function setFDCurrency(code: CurrencyCode, symbol: string) {
      currentCurrencyCode = code;
      currentCurrencySymbol = symbol;
      currentNumberLocale = CURRENCY_CONFIG[code]?.locale || 'en-IN';

      if (currencyDropdown && currencyDropdown.value !== code) {
        currencyDropdown.value = code;
      }
      recalc();
    }

    currencyDropdown?.addEventListener('change', () => {
      const code = (currencyDropdown.value as CurrencyCode) || 'INR';
      const config = CURRENCY_CONFIG[code];
      const sym = config?.symbol || '₹';
      setFDCurrency(code, sym);
      window.dispatchEvent(
        new CustomEvent('cm:currency-change', {
          detail: { code, symbol: sym, label: `${sym} ${code}` },
        })
      );
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.code && e.detail?.symbol) {
        setFDCurrency(e.detail.code, e.detail.symbol);
      }
    });
  }

  initFDCalc();
  document.addEventListener('astro:page-load', initFDCalc);
</script>
