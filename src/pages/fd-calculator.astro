---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcFD } from '../lib/calculators/fd';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 100000, rate: 7.1, years: 5 };
const result = calcFD(DEFAULT.principal, DEFAULT.rate, DEFAULT.years, 'quarterly');

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Investments' && t.slug !== 'fd-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/fd-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Fixed Deposit (FD) Calculator',
      url: canonicalUrl,
      description: 'Calculate maturity value and interest earned on fixed deposits with quarterly or monthly compounding.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'Fixed Deposit Calculator' },
      ],
    },
  ],
};
---

<Layout
  title="Fixed Deposit (FD) Calculator: Maturity & Interest | Calcumetrics"
  description="Calculate maturity value and interest earned on fixed deposits with quarterly compounding. Compares bank rates and tenure options."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Fixed Deposit (FD) Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={fmt(result.maturity)}
    heroLabel="Maturity Value"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Fixed Deposit Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Estimate the guaranteed return on your fixed deposit with standard quarterly compounding.</p>

      <!-- Deposit Amount -->
      <div class="mb-5">
        <Input
          id="fd-principal"
          label="Total Investment Amount"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Principal deposit amount"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-principal-slider" min={5000} max={10000000} step={5000} value={100000} ariaLabel="Deposit amount slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="fd-rate"
          label="Annual Interest Rate"
          suffix="%"
          value="7.1"
          isNumeric={true}
          helperText="Bank interest rate p.a."
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-rate-slider" min={2.5} max={15} step={0.1} value={7.1} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Tenure -->
      <div class="mb-5">
        <Input
          id="fd-years"
          label="Tenure (Years)"
          suffix="Years"
          value="5"
          isNumeric={true}
          helperText="Fixed deposit duration in years"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="fd-years-slider" min={0.5} max={10} step={0.5} value={5} ariaLabel="Tenure slider" />
        </div>
      </div>

      <!-- Compounding Frequency -->
      <div class="mb-6">
        <Dropdown
          id="fd-compounding"
          label="Compounding Frequency"
          options={[
            { value: 'quarterly', label: 'Quarterly Compounding (Bank Standard)' },
            { value: 'monthly', label: 'Monthly Compounding' },
            { value: 'half-yearly', label: 'Half-Yearly Compounding' },
            { value: 'annually', label: 'Annual Compounding' },
          ]}
          value="quarterly"
          helperText="Most Indian banks compound FD interest quarterly"
        />
      </div>

      <Alert variant="info" title="Tax Note">
        Interest earned above ₹40,000/year (₹50,000 for senior citizens) is subject to TDS under Indian Income Tax regulations.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="fd-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="fd-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Maturity Value</span>
        <div id="fd-result-maturity" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.maturity)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Principal Amount</span>
          <span id="fd-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest</span>
          <span id="fd-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.interest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Return</span>
          <span id="fd-result-gainpct" class="text-sm font-medium tabular-nums text-dark-text">{result.principal > 0 ? ((result.interest / result.principal) * 100).toFixed(1) : '0.0'}%</span>
        </div>
      </div>

      <div class="mb-5" id="fd-composition-wrapper">
        <CompositionBar
          principalFraction={result.principalFraction}
          gainFraction={result.interestFraction}
          principalLabel="Principal"
          gainLabel="Interest"
          principalValue={fmt(DEFAULT.principal)}
          gainValue={fmt(result.interest)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="fd-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="fd-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="fd-calculator-how">
        <h2 id="fd-calculator-how" class="text-xl font-bold text-text-primary mb-4">How the FD calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          In India, major banks calculate term deposit maturity using quarterly compounding with the standard compound interest formula:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">A = P × (1 + r / 4)^(4 × t)</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">A</strong> — Maturity value</li>
            <li><strong class="text-text-primary">P</strong> — Principal deposit amount</li>
            <li><strong class="text-text-primary">r</strong> — Annual interest rate expressed as a decimal</li>
            <li><strong class="text-text-primary">t</strong> — Tenure in years</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="fd-calculator-faq">
        <h2 id="fd-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How is FD interest compounded?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Most Indian banks (SBI, HDFC, ICICI, etc.) compound interest on a quarterly basis. Every three months, the interest earned is added to the principal balance for subsequent interest calculations.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Do senior citizens get higher interest rates?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes, banks typically offer an additional 0.50% to 0.75% per annum for deposits held by individuals aged 60 and above.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="fd-calculator-related">
        <h2 id="fd-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  function calcFDClient(p: number, rate: number, years: number, freq: string) {
    const freqMap: Record<string, number> = { quarterly: 4, monthly: 12, 'half-yearly': 2, annually: 1 };
    const n = freqMap[freq] || 4;
    const r = rate / 100;
    const maturity = p * Math.pow(1 + r / n, n * years);
    const gain = maturity - p;
    const gainPct = p > 0 ? (gain / p) * 100 : 0;
    return {
      maturity,
      gain,
      gainPct,
      principalFraction: maturity > 0 ? p / maturity : 0,
      gainFraction: maturity > 0 ? gain / maturity : 0,
    };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initFDCalc() {
    const pInput = document.getElementById('fd-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('fd-rate') as HTMLInputElement | null;
    const yInput = document.getElementById('fd-years') as HTMLInputElement | null;
    const fSelect = document.getElementById('fd-compounding') as HTMLSelectElement | null;
    const pSlider = document.getElementById('fd-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('fd-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('fd-years-slider') as HTMLInputElement | null;

    const resMaturity = document.getElementById('fd-result-maturity');
    const resPrincipal = document.getElementById('fd-result-principal');
    const resGain = document.getElementById('fd-result-gain');
    const resGainPct = document.getElementById('fd-result-gainpct');
    const mobileHero = document.getElementById('calc-mobile-hero');

    if (!pInput || !rInput || !yInput) return;

    const DEFAULTS = { principal: 100000, rate: 7.1, years: 5, freq: 'quarterly' };
    let timer: ReturnType<typeof setTimeout>;

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const y = parseFloat(yInput.value) || 0;
      const f = fSelect ? fSelect.value : 'quarterly';

      if (p <= 0 || r <= 0 || y <= 0) return;

      const res = calcFDClient(p, r, y, f);

      if (resMaturity) resMaturity.textContent = fmtVal(res.maturity);
      if (resPrincipal) resPrincipal.textContent = fmtVal(p);
      if (resGain) resGain.textContent = fmtVal(res.gain);
      if (resGainPct) resGainPct.textContent = res.gainPct.toFixed(1) + '%';
      if (mobileHero) mobileHero.textContent = fmtVal(res.maturity);

      const wrapper = document.getElementById('fd-composition-wrapper');
      if (wrapper) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.gainFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(p);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.gain);
      }

      history.replaceState(null, '', `#p=${p}&r=${r}&y=${y}&f=${f}`);
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(ySlider, yInput, false);
    fSelect?.addEventListener('change', recalc);

    document.getElementById('fd-calculate')?.addEventListener('click', recalc);
    document.getElementById('fd-reset')?.addEventListener('click', () => {
      pInput.value = fmtLiveInput(String(DEFAULTS.principal));
      rInput.value = String(DEFAULTS.rate);
      yInput.value = String(DEFAULTS.years);
      if (fSelect) fSelect.value = DEFAULTS.freq;
      if (pSlider) {
        pSlider.value = String(DEFAULTS.principal);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 5000) / (10000000 - 5000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 2.5) / (15 - 2.5)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.years);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 0.5) / (10 - 0.5)) * 100}%`);
      }
      recalc();
      pInput.focus();
    });

    [pInput, rInput, yInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('fd-copy-btn')?.addEventListener('click', async () => {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const y = parseFloat(yInput.value) || 0;
      const f = fSelect ? fSelect.value : 'quarterly';
      const res = calcFDClient(p, r, y, f);
      const text = `Fixed Deposit: ${fmtVal(p)} at ${r}% p.a. for ${y} years gives maturity of ${fmtVal(res.maturity)} (interest: ${fmtVal(res.gain)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('fd-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('fd-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('fd-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initFDCalc();
  document.addEventListener('astro:page-load', initFDCalc);
</script>
