---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcCAGR } from '../lib/calculators/cagr';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { pv: 100000, fv: 250000, years: 5 };
const result = calcCAGR(DEFAULT.pv, DEFAULT.fv, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter(
  (t) => t.category === 'Investments' && t.slug !== 'cagr-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/cagr-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'CAGR Calculator',
      url: canonicalUrl,
      description: 'Calculate the Compound Annual Growth Rate (CAGR) using the cagr formula: CAGR = (Ending Value / Beginning Value)^(1/Years) − 1. Ideal cagr growth rate calculator for investment analysis.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' },
        { '@type': 'ListItem', position: 3, name: 'CAGR Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is CAGR and when should I use it?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'CAGR (Compound Annual Growth Rate) represents the annualized constant return rate required for an investment to grow from its initial value to its final value over a given period, smoothing out year-over-year market fluctuations.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the formula for CAGR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The formula is CAGR = (Ending Value / Beginning Value)^(1 / Years) − 1. The result is multiplied by 100 to express it as an annual percentage.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can CAGR be negative?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. If the final value is less than the beginning value, the investment suffered a loss, resulting in a negative CAGR reflecting the annualized rate of loss.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="CAGR Calculator: Compound Annual Growth Rate Formula | Calcumetrics"
  description="Free CAGR calculator. Compute compound annual growth rate using the cagr formula: CAGR = (FV/PV)^(1/n) − 1. Instant cagr growth rate calculator with chart."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="CAGR Calculator"
    category="Investments"
    categoryHref="/investments"
    heroValue={result.cagrPct.toFixed(2) + '%'}
    heroLabel="CAGR"
    calcType="simple"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">CAGR Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the annualised compounded rate of return between two points in time.</p>

      <!-- Present Value -->
      <div class="mb-5">
        <Input
          id="cagr-pv"
          label="Initial Investment (Starting Value)"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Value at the beginning of the period"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="cagr-pv-slider" min={5000} max={10000000} step={5000} value={100000} ariaLabel="Initial value slider" />
        </div>
      </div>

      <!-- Future Value -->
      <div class="mb-5">
        <Input
          id="cagr-fv"
          label="Final Value (Ending Value)"
          prefix="₹"
          value="2,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Value at the end of the period"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="cagr-fv-slider" min={5000} max={50000000} step={10000} value={250000} ariaLabel="Final value slider" />
        </div>
      </div>

      <!-- Years -->
      <div class="mb-6">
        <Input
          id="cagr-years"
          label="Time Period (Years)"
          suffix="Years"
          value="5"
          isNumeric={true}
          helperText="Number of years between start and end"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="cagr-years-slider" min={1} max={30} step={0.5} value={5} ariaLabel="Years slider" />
        </div>
      </div>

      <!-- Validation Error Container -->
      <div id="cagr-error-alert" class="hidden mb-5">
        <Alert variant="error" title="Validation Error">
          <span id="cagr-error-message">Please check your inputs.</span>
        </Alert>
      </div>

      <Alert variant="info" title="How CAGR Works">
        CAGR smooths out intermediate fluctuations to provide a single annual rate that would have grown the initial value to the final value.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="cagr-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="cagr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Compound Annual Growth Rate</span>
        <div id="cagr-result-pct" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {result.cagrPct.toFixed(2)}%
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Initial Investment</span>
          <span id="cagr-result-pv" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.pv)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Final Value</span>
          <span id="cagr-result-fv" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.fv)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Absolute Gain</span>
          <span id="cagr-result-gain" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.absoluteReturn)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Absolute Return</span>
          <span id="cagr-result-absret" class="text-sm font-medium tabular-nums text-dark-text">{result.absoluteReturnPct.toFixed(1)}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Growth Multiple</span>
          <span id="cagr-result-multiple" class="text-sm font-semibold tabular-nums text-dark-text">{(DEFAULT.fv / DEFAULT.pv).toFixed(2)}x</span>
        </div>
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cagr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cagr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="cagr-calculator-how">
        <h2 id="cagr-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          The Compound Annual Growth Rate (CAGR) is computed by taking the nth root of total return over n years:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">CAGR = (FV / PV)^(1 / n) − 1</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">FV</strong> — Final value of the investment</li>
            <li><strong class="text-text-primary">PV</strong> — Initial present value of the investment</li>
            <li><strong class="text-text-primary">n</strong> — Number of years</li>
          </ul>
        </div>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <h3 class="text-sm font-bold text-text-primary mb-2">Worked Example</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Suppose you invested <strong class="text-text-primary">₹1,00,000</strong> and after <strong class="text-text-primary">5 years</strong> your portfolio reached <strong class="text-text-primary">₹2,50,000</strong>:
          </p>
          <p class="text-sm font-mono text-text-primary my-2">
            CAGR = (2,50,000 / 1,00,000)^(1 / 5) − 1 = (2.5)^(0.2) − 1 ≈ 0.2011 (20.11%)
          </p>
          <p class="text-sm text-text-muted leading-relaxed">
            Total absolute gain is ₹1,50,000 (+150.0%), representing a 2.50x growth multiple over the 5-year investment duration.
          </p>
        </div>

        <div class="p-3.5 bg-surface border border-accent/30 rounded-card mb-4 text-xs text-text-muted">
          <strong class="text-text-primary">Measuring monthly SIPs or multiple cash flows?</strong> CAGR only works for one-time lump-sum investments. To understand why SIP returns require a different formula, read our guide on <a href="/blog/cagr-vs-xirr" class="text-accent font-medium hover:underline">CAGR vs. XIRR</a> or use the <a href="/xirr-calculator" class="text-accent font-medium hover:underline">XIRR Calculator</a>.
        </div>
      </section>

      <section aria-labelledby="cagr-calculator-faq">
        <h2 id="cagr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is CAGR and when should I use it?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              CAGR is ideal when evaluating mutual funds, stocks, real estate, or business revenues over multiple years. Because returns vary from year to year, CAGR provides the geometric mean rate of return.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What are the limitations of CAGR?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              CAGR assumes a smooth annual rate and ignores volatility and drawdowns during intermediate years. Two investments with identical CAGRs could have experienced wildly different levels of risk.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can CAGR be negative?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes. If an investment declines in value (e.g. ₹1,00,000 drops to ₹80,000 over 3 years), the CAGR formula yields a negative annual rate (-7.17%), accurately reflecting the annualized capital loss.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="cagr-calculator-related">
        <h2 id="cagr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcCAGR } from '../lib/calculators/cagr';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, updateHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';

  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initCAGRCalc() {
    const pvInput = document.getElementById('cagr-pv') as HTMLInputElement | null;
    const fvInput = document.getElementById('cagr-fv') as HTMLInputElement | null;
    const yInput = document.getElementById('cagr-years') as HTMLInputElement | null;

    const pvSlider = document.getElementById('cagr-pv-slider') as HTMLInputElement | null;
    const fvSlider = document.getElementById('cagr-fv-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('cagr-years-slider') as HTMLInputElement | null;

    const resPct = document.getElementById('cagr-result-pct');
    const resPv = document.getElementById('cagr-result-pv');
    const resFv = document.getElementById('cagr-result-fv');
    const resGain = document.getElementById('cagr-result-gain');
    const resAbsRet = document.getElementById('cagr-result-absret');
    const resMult = document.getElementById('cagr-result-multiple');
    const mobileHero = document.getElementById('calc-mobile-hero');

    const errorAlert = document.getElementById('cagr-error-alert');
    const errorMessage = document.getElementById('cagr-error-message');

    if (!pvInput || !fvInput || !yInput) return;

    if (pvInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    pvInput.dataset.bound = 'true';

    const DEFAULTS = { pv: 100000, fv: 250000, years: 5 };
    const cagrSchema = {
      pv: { required: true, min: 100, max: 1000000000, label: 'Initial Investment' },
      fv: { required: true, min: 1, max: 1000000000, label: 'Final Value' },
      y: { required: true, min: 0.1, max: 100, decimal: true, label: 'Time Period (Years)' },
    };

    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errorAlert && errorMessage) {
        errorMessage.textContent = msg;
        errorAlert.classList.remove('hidden');
      }
    }

    function hideError() {
      if (errorAlert) {
        errorAlert.classList.add('hidden');
      }
    }

    function recalc() {
      // Phase 4.3 Centralized Validation Engine
      const valPv = validate(pvInput.value, cagrSchema.pv);
      if (!valPv.valid) {
        showError(valPv.error.message);
        return;
      }

      const valFv = validate(fvInput.value, cagrSchema.fv);
      if (!valFv.valid) {
        showError(valFv.error.message);
        return;
      }

      const valY = validate(yInput.value, cagrSchema.y);
      if (!valY.valid) {
        showError(valY.error.message);
        return;
      }

      hideError();

      const pv = valPv.value!;
      const fv = valFv.value!;
      const y = valY.value!;

      const res = calcCAGR(pv, fv, y);

      const cagrPctStr = res.cagrPct.toFixed(2) + '%';
      const pvStr = fmtVal(pv);
      const fvStr = fmtVal(fv);
      const gainStr = fmtVal(res.absoluteReturn);
      const absRetStr = res.absoluteReturnPct.toFixed(1) + '%';
      const multStr = res.multiple.toFixed(2) + 'x';

      // Phase 4.2 Canonical Result State
      const canonicalResult = {
        heroValue: cagrPctStr,
        heroLabel: 'CAGR',
        rows: [
          { label: 'Initial Investment', value: pvStr },
          { label: 'Final Value', value: fvStr },
          { label: 'Absolute Gain', value: gainStr, variant: 'accent' as const },
          { label: 'Total Absolute Return', value: absRetStr },
          { label: 'Growth Multiple', value: multStr },
        ],
        fields: {
          'cagr-result-pct': cagrPctStr,
          'cagr-result-pv': pvStr,
          'cagr-result-fv': fvStr,
          'cagr-result-gain': gainStr,
          'cagr-result-absret': absRetStr,
          'cagr-result-multiple': multStr,
        },
        meta: { pv, fv, y, cagr: res.cagr, cagrPct: res.cagrPct, multiple: res.multiple },
      };

      setResult(canonicalResult);

      // Desktop fallback updates
      if (resPct) resPct.textContent = cagrPctStr;
      if (resPv) resPv.textContent = pvStr;
      if (resFv) resFv.textContent = fvStr;
      if (resGain) resGain.textContent = gainStr;
      if (resAbsRet) resAbsRet.textContent = absRetStr;
      if (resMult) resMult.textContent = multStr;
      if (mobileHero) mobileHero.textContent = cagrPctStr;

      // Phase 4.4 URL State Serialization
      updateHash(serializeHash({ pv, fv, y }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const min = parseFloat(slider.min), max = parseFloat(slider.max), val = parseFloat(slider.value);
        const pct = ((val - min) / (max - min)) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pvSlider, pvInput, true);
    sync(fvSlider, fvInput, true);
    sync(ySlider, yInput, false);

    document.getElementById('cagr-calculate')?.addEventListener('click', recalc);
    document.getElementById('cagr-reset')?.addEventListener('click', () => {
      pvInput.value = fmtLiveInput(String(DEFAULTS.pv));
      fvInput.value = fmtLiveInput(String(DEFAULTS.fv));
      yInput.value = String(DEFAULTS.years);

      if (pvSlider) {
        pvSlider.value = String(DEFAULTS.pv);
        pvSlider.style.setProperty('--slider-pct', `${((DEFAULTS.pv - 5000) / (10000000 - 5000)) * 100}%`);
      }
      if (fvSlider) {
        fvSlider.value = String(DEFAULTS.fv);
        fvSlider.style.setProperty('--slider-pct', `${((DEFAULTS.fv - 5000) / (50000000 - 5000)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.years);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (30 - 1)) * 100}%`);
      }

      hideError();
      recalc();
      pvInput.focus();
    });

    [pvInput, fvInput, yInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('cagr-copy-btn')?.addEventListener('click', async () => {
      const valPv = validate(pvInput.value, cagrSchema.pv);
      const valFv = validate(fvInput.value, cagrSchema.fv);
      const valY = validate(yInput.value, cagrSchema.y);
      if (!valPv.valid || !valFv.valid || !valY.valid) {
        showError((!valPv.valid && valPv.error.message) || (!valFv.valid && valFv.error.message) || (!valY.valid && valY.error.message) || 'Invalid inputs');
        return;
      }
      const pv = valPv.value!;
      const fv = valFv.value!;
      const y = valY.value!;
      const res = calcCAGR(pv, fv, y);
      const text = `CAGR: ${fmtVal(pv)} to ${fmtVal(fv)} over ${y} years is ${res.cagrPct.toFixed(2)}% CAGR (${res.multiple.toFixed(2)}x return). ${location.href.split('#')[0]}#pv=${pv}&fv=${fv}&y=${y}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cagr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cagr-share-btn')?.addEventListener('click', async () => {
      const valPv = validate(pvInput.value, cagrSchema.pv);
      const valFv = validate(fvInput.value, cagrSchema.fv);
      const valY = validate(yInput.value, cagrSchema.y);
      if (!valPv.valid || !valFv.valid || !valY.valid) {
        showError((!valPv.valid && valPv.error.message) || (!valFv.valid && valFv.error.message) || (!valY.valid && valY.error.message) || 'Invalid inputs');
        return;
      }
      const pv = valPv.value!;
      const fv = valFv.value!;
      const y = valY.value!;
      const shareUrl = `${location.href.split('#')[0]}#pv=${pv}&fv=${fv}&y=${y}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('cagr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Currency synchronization
    const win = window as any;
    if (!win.__cmCAGRCurrencyBound) {
      win.__cmCAGRCurrencyBound = true;
      window.addEventListener('cm:currency-change', (e: any) => {
        if (e.detail?.symbol) {
          currSym = e.detail.symbol;
          currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
          recalc();
        }
      });
    }
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}

    // Phase 4.4 URL State Restoration
    const currentHash = readCurrentHash();
    if (currentHash) {
      const restored = restoreFromHash(currentHash, cagrSchema);
      if (restored.valid) {
        if (restored.values.pv !== undefined) {
          pvInput.value = fmtLiveInput(String(restored.values.pv));
          if (pvSlider) {
            pvSlider.value = String(restored.values.pv);
            pvSlider.style.setProperty('--slider-pct', `${((restored.values.pv - 5000) / (10000000 - 5000)) * 100}%`);
          }
        }
        if (restored.values.fv !== undefined) {
          fvInput.value = fmtLiveInput(String(restored.values.fv));
          if (fvSlider) {
            fvSlider.value = String(restored.values.fv);
            fvSlider.style.setProperty('--slider-pct', `${((restored.values.fv - 5000) / (50000000 - 5000)) * 100}%`);
          }
        }
        if (restored.values.y !== undefined) {
          yInput.value = String(restored.values.y);
          if (ySlider) {
            ySlider.value = String(restored.values.y);
            ySlider.style.setProperty('--slider-pct', `${((restored.values.y - 1) / (30 - 1)) * 100}%`);
          }
        }
      }
    }

    recalc();
  }

  initCAGRCalc();
  document.addEventListener('astro:page-load', initCAGRCalc);
</script>
