---
/**
 * EMI Calculator — /emi-calculator
 * Section 12 fixture: ₹10,00,000, 8.5% p.a., 20 yrs → EMI ₹8,678; total interest ₹10,82,776
 */
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcEMI, calcEMIAmortization } from '../lib/calculators/emi';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 1000000, rate: 8.5, years: 20 };
const result = calcEMI(DEFAULT.principal, DEFAULT.rate, DEFAULT.years);
const amort = calcEMIAmortization(DEFAULT.principal, DEFAULT.rate, DEFAULT.years);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Loans' && t.slug !== 'emi-calculator' && t.status === 'published').slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/emi-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: 'EMI Calculator', url: canonicalUrl, description: 'Calculate monthly EMI, total interest, and repayment schedule for any loan.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' }, { '@type': 'ListItem', position: 3, name: 'EMI Calculator' }] },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is EMI and how is it calculated?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'An Equated Monthly Instalment (EMI) is a fixed monthly payment made by a borrower to a lender. It is calculated using the formula: EMI = P × r × (1 + r)^n / ((1 + r)^n − 1), where P is principal, r is monthly interest rate, and n is total months.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does a higher tenure mean lower EMI?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, a longer tenure reduces the monthly instalment amount, but significantly increases the cumulative interest paid over the life of the loan.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I save interest by making prepayments?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Making prepayments directly reduces your outstanding loan principal balance, reducing future compound interest and either lowering your EMI or shortening your loan tenure.',
          },
        },
      ],
    },
  ],
};
---

<Layout title="EMI Calculator: Monthly Instalment & Total Interest | Calcumetrics" description="Calculate your loan EMI, total interest paid, and year-by-year amortization. Works for home loans, car loans, and personal loans. 100% client-side." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="EMI Calculator" category="Loans" categoryHref="/loans" heroValue={fmt(result.emiRounded)} heroLabel="Monthly EMI" calcType="multi-input">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">EMI Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate your Equated Monthly Instalment, total interest paid, and view an amortization schedule.</p>
      <div class="mb-6"><Dropdown id="emi-currency" label="Currency" options={[{value:'INR',label:'₹ Indian Rupee (INR)'},{value:'USD',label:'$ US Dollar (USD)'}]} value="INR" /></div>
      <div class="mb-5">
        <Input id="emi-principal" label="Loan Amount" prefix="₹" value="10,00,000" isNumeric={true} localeFormat="indian" helperText="Total loan principal" inputmode="decimal" />
        <div class="mt-2"><Slider id="emi-principal-slider" min={10000} max={10000000} step={10000} value={1000000} ariaLabel="Loan amount slider" /></div>
      </div>
      <div class="mb-5">
        <Input id="emi-rate" label="Annual Interest Rate" suffix="%" value="8.5" isNumeric={true} helperText="Nominal annual rate" inputmode="decimal" />
        <div class="mt-2"><Slider id="emi-rate-slider" min={1} max={30} step={0.25} value={8.5} ariaLabel="Interest rate slider" /></div>
      </div>
      <div class="mb-6">
        <Input id="emi-years" label="Loan Tenure" suffix="Yrs" value="20" isNumeric={true} helperText="Duration in whole years" inputmode="numeric" />
        <div class="mt-2"><Slider id="emi-years-slider" min={1} max={30} step={1} value={20} ariaLabel="Loan tenure slider" /></div>
      </div>

      <!-- Validation Error Container -->
      <div id="emi-error-alert" class="hidden mb-5">
        <Alert variant="error" title="Validation Error">
          <span id="emi-error-message">Please check your inputs.</span>
        </Alert>
      </div>

      <Alert variant="info" title="Assumption">Computed using standard EMI formula. Internal computation uses unrounded EMI; displayed EMI is rounded to the nearest rupee. Total interest may differ slightly from multiplying rounded EMI × months.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" id="emi-calculate" type="button">Calculate</Button><Button variant="ghost" id="emi-reset" type="button">Reset</Button></div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Monthly EMI</span>
        <div id="emi-result-emi" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite" aria-atomic="true">{fmt(result.emiRounded)}</div>
      </div>
      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Principal Amount</span>
          <span id="emi-result-principal" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.principal)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Interest</span>
          <span id="emi-result-interest" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.totalInterest)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Payment</span>
          <span id="emi-result-total" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.totalPayment)}</span>
        </div>
      </div>
      <div class="mb-5" id="emi-composition-wrapper">
        <CompositionBar principalFraction={result.principalFraction} gainFraction={result.interestFraction} principalLabel="Principal" gainLabel="Interest" principalValue={fmt(DEFAULT.principal)} gainValue={fmt(result.totalInterest)} />
      </div>
      <div class="flex gap-2 mt-4">
        <button type="button" id="emi-copy-btn" aria-live="polite" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2 cursor-pointer">Copy Result</button>
        <button type="button" id="emi-share-btn" aria-live="polite" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2 cursor-pointer">Share Link</button>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="emi-how">
        <h2 id="emi-how" class="text-xl font-bold text-text-primary mb-4">How the EMI calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">An Equated Monthly Instalment (EMI) is a fixed amount paid every month to repay a loan over a set tenure. The EMI covers both the principal and the interest, calculated so the loan is fully repaid by the final month.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">This calculator uses the standard EMI formula used by all major Indian banks and financial institutions:</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 overflow-x-auto">
          <p class="text-base font-mono text-text-primary mb-3">EMI = P × r × (1 + r)ⁿ / ((1 + r)ⁿ − 1)</p>
          <ul class="space-y-1 text-sm text-text-muted">
            <li><strong class="text-text-primary">P</strong> — Principal loan amount</li>
            <li><strong class="text-text-primary">r</strong> — Monthly interest rate = annual rate / 12 / 100</li>
            <li><strong class="text-text-primary">n</strong> — Total months = years × 12</li>
          </ul>
        </div>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <h3 class="text-sm font-bold text-text-primary mb-2">Worked Example</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Consider a loan of <strong class="text-text-primary">₹10,00,000</strong> at <strong class="text-text-primary">8.5% p.a.</strong> over <strong class="text-text-primary">20 years</strong> (240 months):
          </p>
          <ul class="space-y-1 text-sm text-text-muted my-2">
            <li>Monthly Interest Rate (r) = 8.5 / 1200 ≈ 0.0070833</li>
            <li>Monthly EMI = <strong class="text-text-primary">₹8,678</strong></li>
            <li>Total Payment = 8,678.23 &times; 240 = <strong class="text-text-primary">₹20,82,776</strong></li>
            <li>Total Interest Paid = ₹20,82,776 − ₹10,00,000 = <strong class="text-text-primary">₹10,82,776</strong></li>
          </ul>
          <p class="text-sm text-text-muted leading-relaxed">
            Because of the 20-year duration, total interest exceeds the original loan principal amount, highlighting the value of partial prepayments.
          </p>
        </div>
      </section>

      <section aria-labelledby="emi-example">
        <h2 id="emi-example" class="text-xl font-bold text-text-primary mb-4">Year-by-year amortization</h2>
        <details>
          <summary class="cursor-pointer text-sm font-medium text-accent hover:text-accent-hover transition-standard mb-3 focus-visible:outline-accent rounded">Show / hide full schedule</summary>
          <div class="overflow-x-auto mt-3">
            <table class="w-full text-sm border-collapse">
              <thead><tr class="border-b border-border"><th class="text-left py-2 px-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Year</th><th class="text-right py-2 px-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Principal</th><th class="text-right py-2 px-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Interest</th><th class="text-right py-2 px-3 text-xs font-semibold text-text-muted uppercase tracking-wider">Balance</th></tr></thead>
              <tbody id="emi-amort-body">
                {amort.map((row) => (
                  <tr class="border-b border-border hover:bg-canvas transition-standard">
                    <td class="py-2 px-3 text-text-primary">{row.year}</td>
                    <td class="py-2 px-3 text-right tabular-nums text-text-primary font-medium">{fmt(row.principal)}</td>
                    <td class="py-2 px-3 text-right tabular-nums text-accent">{fmt(row.interest)}</td>
                    <td class="py-2 px-3 text-right tabular-nums text-text-muted">{fmt(row.balance)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Understanding the shift between interest and principal?</strong>
        Read our in-depth research guide on <a href="/blog/how-loan-amortization-works" class="text-accent font-medium hover:underline">How Loan Amortization Works: Principal vs. Interest Split and the True Cost of Front-Loaded Debt</a> to learn how monthly schedules compound interest savings.
      </div>

      <section aria-labelledby="emi-faq">
        <h2 id="emi-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is EMI and how is it structured?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Each EMI payment consists of an interest component and a principal component. In the early months, most of the EMI goes toward interest; as the loan matures, a greater portion pays down the principal. This is called an amortizing loan.</div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Does a higher tenure mean lower EMI?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Yes — a longer tenure reduces your monthly EMI, but increases your total interest paid significantly. For ₹10 lakh at 8.5% p.a., a 10-year tenure gives an EMI of ₹12,399 with ₹4.88 lakh total interest, while a 20-year tenure gives ₹8,678 EMI but ₹10.83 lakh total interest.</div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can I save interest by prepaying?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Yes. Making a partial prepayment reduces your outstanding principal, which reduces future interest charges. Use our Loan Prepayment Calculator to estimate how much interest you can save and by how many months your tenure could reduce.</div>
          </details>
        </div>
      </section>

      <section aria-labelledby="emi-related">
        <h2 id="emi-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcEMI, calcEMIAmortization } from '../lib/calculators/emi';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, updateHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';

  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initEMICalc() {
    const principalInput = document.getElementById('emi-principal') as HTMLInputElement | null;
    const rateInput = document.getElementById('emi-rate') as HTMLInputElement | null;
    const yearsInput = document.getElementById('emi-years') as HTMLInputElement | null;

    const pSlider = document.getElementById('emi-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('emi-rate-slider') as HTMLInputElement | null;
    const ySlider = document.getElementById('emi-years-slider') as HTMLInputElement | null;

    const resEMI = document.getElementById('emi-result-emi');
    const resPrincipal = document.getElementById('emi-result-principal');
    const resInterest = document.getElementById('emi-result-interest');
    const resTotal = document.getElementById('emi-result-total');
    const mobileHero = document.getElementById('calc-mobile-hero');

    const errorAlert = document.getElementById('emi-error-alert');
    const errorMessage = document.getElementById('emi-error-message');
    const currencyDropdown = document.getElementById('emi-currency') as HTMLSelectElement | null;
    const amortBody = document.getElementById('emi-amort-body');

    if (!principalInput || !rateInput || !yearsInput) return;

    if (principalInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    principalInput.dataset.bound = 'true';

    const DEFAULTS = { principal: 1000000, rate: 8.5, years: 20 };
    const emiSchema = {
      p: { required: true, min: 1000, max: 1000000000, integerOnly: true, label: 'Loan Amount' },
      r: { required: true, min: 0, max: 50, decimal: true, label: 'Annual Interest Rate' },
      y: { required: true, min: 1, max: 50, integerOnly: true, label: 'Loan Tenure (Years)' },
    };

    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errorAlert && errorMessage) {
        errorMessage.textContent = msg;
        errorAlert.classList.remove('hidden');
      }
    }

    function hideError() {
      if (errorAlert) {
        errorAlert.classList.add('hidden');
      }
    }

    function updateAmortizationTable(p: number, r: number, y: number) {
      if (!amortBody) return;
      const rows = calcEMIAmortization(p, r, y);
      amortBody.innerHTML = '';
      rows.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-border hover:bg-canvas transition-standard';
        tr.innerHTML = `
          <td class="py-2 px-3 text-text-primary">${row.year}</td>
          <td class="py-2 px-3 text-right tabular-nums text-text-primary font-medium">${fmtVal(row.principal)}</td>
          <td class="py-2 px-3 text-right tabular-nums text-accent">${fmtVal(row.interest)}</td>
          <td class="py-2 px-3 text-right tabular-nums text-text-muted">${fmtVal(row.balance)}</td>
        `;
        amortBody.appendChild(tr);
      });
    }

    function recalc() {
      // Phase 4.3 Centralized Validation Engine
      const valP = validate(principalInput.value, emiSchema.p);
      if (!valP.valid) {
        showError(valP.error.message);
        return;
      }

      const valR = validate(rateInput.value, emiSchema.r);
      if (!valR.valid) {
        showError(valR.error.message);
        return;
      }

      const valY = validate(yearsInput.value, emiSchema.y);
      if (!valY.valid) {
        showError(valY.error.message);
        return;
      }

      hideError();

      const p = valP.value!;
      const r = valR.value!;
      const y = valY.value!;

      const res = calcEMI(p, r, y);

      const emiStr = fmtVal(res.emiRounded);
      const principalStr = fmtVal(p);
      const interestStr = fmtVal(res.totalInterest);
      const totalStr = fmtVal(res.totalPayment);

      // Phase 4.2 Canonical Result State
      const canonicalResult = {
        heroValue: emiStr,
        heroLabel: 'Monthly EMI',
        rows: [
          { label: 'Principal Amount', value: principalStr },
          { label: 'Total Interest', value: interestStr, variant: 'accent' as const },
          { label: 'Total Payment', value: totalStr },
        ],
        fields: {
          'emi-result-emi': emiStr,
          'emi-result-principal': principalStr,
          'emi-result-interest': interestStr,
          'emi-result-total': totalStr,
        },
        meta: { p, r, y, emi: res.emi, emiRounded: res.emiRounded, totalInterest: res.totalInterest, totalPayment: res.totalPayment },
      };

      setResult(canonicalResult);

      // Fallback desktop node updates
      if (resEMI) resEMI.textContent = emiStr;
      if (resPrincipal) resPrincipal.textContent = principalStr;
      if (resInterest) resInterest.textContent = interestStr;
      if (resTotal) resTotal.textContent = totalStr;
      if (mobileHero) mobileHero.textContent = emiStr;

      const wrapper = document.getElementById('emi-composition-wrapper');
      if (wrapper && res.totalPayment > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.principalFraction * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.interestFraction * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = principalStr;
        if (legendEls[1]) legendEls[1].textContent = interestStr;
      }

      updateAmortizationTable(p, r, y);

      // Phase 4.4 URL State Serialization
      updateHash(serializeHash({ p, r, y }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const min = parseFloat(slider.min), max = parseFloat(slider.max), val = parseFloat(slider.value);
        const pct = ((val - min) / (max - min)) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, principalInput, true);
    sync(rSlider, rateInput, false);
    sync(ySlider, yearsInput, false);

    document.getElementById('emi-calculate')?.addEventListener('click', recalc);
    document.getElementById('emi-reset')?.addEventListener('click', () => {
      principalInput.value = fmtLiveInput(String(DEFAULTS.principal));
      rateInput.value = String(DEFAULTS.rate);
      yearsInput.value = String(DEFAULTS.years);

      if (pSlider) {
        pSlider.value = String(DEFAULTS.principal);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 10000) / (10000000 - 10000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (30 - 1)) * 100}%`);
      }
      if (ySlider) {
        ySlider.value = String(DEFAULTS.years);
        ySlider.style.setProperty('--slider-pct', `${((DEFAULTS.years - 1) / (30 - 1)) * 100}%`);
      }

      hideError();
      recalc();
      principalInput.focus();
    });

    [principalInput, rateInput, yearsInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('emi-copy-btn')?.addEventListener('click', async () => {
      const valP = validate(principalInput.value, emiSchema.p);
      const valR = validate(rateInput.value, emiSchema.r);
      const valY = validate(yearsInput.value, emiSchema.y);
      if (!valP.valid || !valR.valid || !valY.valid) {
        showError((!valP.valid && valP.error.message) || (!valR.valid && valR.error.message) || (!valY.valid && valY.error.message) || 'Invalid inputs');
        return;
      }
      const p = valP.value!;
      const r = valR.value!;
      const y = valY.value!;
      const res = calcEMI(p, r, y);
      const text = `EMI Calculator: Loan of ${fmtVal(p)} at ${r}% p.a. for ${y} years => Monthly EMI: ${fmtVal(res.emiRounded)}, Total Interest: ${fmtVal(res.totalInterest)}. ${location.href.split('#')[0]}#p=${p}&r=${r}&y=${y}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('emi-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('emi-share-btn')?.addEventListener('click', async () => {
      const valP = validate(principalInput.value, emiSchema.p);
      const valR = validate(rateInput.value, emiSchema.r);
      const valY = validate(yearsInput.value, emiSchema.y);
      if (!valP.valid || !valR.valid || !valY.valid) {
        showError((!valP.valid && valP.error.message) || (!valR.valid && valR.error.message) || (!valY.valid && valY.error.message) || 'Invalid inputs');
        return;
      }
      const p = valP.value!;
      const r = valR.value!;
      const y = valY.value!;
      const shareUrl = `${location.href.split('#')[0]}#p=${p}&r=${r}&y=${y}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('emi-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Currency synchronization
    function setEMICurrency(code: string, symbol: string) {
      currSym = symbol;
      currLocale = code === 'USD' ? 'en-US' : code === 'EUR' ? 'de-DE' : code === 'GBP' ? 'en-GB' : 'en-IN';
      if (currencyDropdown && currencyDropdown.value !== code) {
        currencyDropdown.value = code;
      }
      recalc();
    }

    currencyDropdown?.addEventListener('change', () => {
      const code = currencyDropdown.value;
      const symbolMap: Record<string, string> = { INR: '₹', USD: '$', EUR: '€', GBP: '£' };
      const sym = symbolMap[code] || '₹';
      setEMICurrency(code, sym);
      window.dispatchEvent(new CustomEvent('cm:currency-change', {
        detail: { code, symbol: sym, label: `${sym} ${code}` },
      }));
    });

    const win = window as any;
    if (!win.__cmEMICurrencyBound) {
      win.__cmEMICurrencyBound = true;
      window.addEventListener('cm:currency-change', (e: any) => {
        if (e.detail?.code && e.detail?.symbol) {
          setEMICurrency(e.detail.code, e.detail.symbol);
        }
      });
    }
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        if (saved.includes('USD')) setEMICurrency('USD', '$');
        else if (saved.includes('EUR')) setEMICurrency('EUR', '€');
        else if (saved.includes('GBP')) setEMICurrency('GBP', '£');
        else setEMICurrency('INR', '₹');
      }
    } catch (e) {}

    // Phase 4.4 URL State Restoration
    const currentHash = readCurrentHash();
    if (currentHash) {
      const restored = restoreFromHash(currentHash, emiSchema);
      if (restored.valid) {
        if (restored.values.p !== undefined) {
          principalInput.value = fmtLiveInput(String(restored.values.p));
          if (pSlider) {
            pSlider.value = String(restored.values.p);
            pSlider.style.setProperty('--slider-pct', `${((restored.values.p - 10000) / (10000000 - 10000)) * 100}%`);
          }
        }
        if (restored.values.r !== undefined) {
          rateInput.value = String(restored.values.r);
          if (rSlider) {
            rSlider.value = String(restored.values.r);
            rSlider.style.setProperty('--slider-pct', `${((restored.values.r - 1) / (30 - 1)) * 100}%`);
          }
        }
        if (restored.values.y !== undefined) {
          yearsInput.value = String(restored.values.y);
          if (ySlider) {
            ySlider.value = String(restored.values.y);
            ySlider.style.setProperty('--slider-pct', `${((restored.values.y - 1) / (30 - 1)) * 100}%`);
          }
        }
      }
    }

    recalc();
  }

  initEMICalc();
  document.addEventListener('astro:page-load', initEMICalc);
</script>
