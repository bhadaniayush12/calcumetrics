---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcDSCR } from '../lib/accounting/ratios';
import { TOOLS } from '../config/site';

const DEFAULT = { noi: 1500000, debtService: 1000000 };
const initialResult = calcDSCR(DEFAULT.noi, DEFAULT.debtService);
const cushion = Math.max(0, DEFAULT.noi - DEFAULT.debtService);

const fmtCurrency = (n: number, sym = '₹', locale = 'en-IN') =>
  sym + new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'dscr-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/dscr-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Debt Service Coverage Ratio (DSCR) Calculator',
      url: canonicalUrl,
      description: 'Calculate Debt Service Coverage Ratio (DSCR) from Net Operating Income and annual debt service to evaluate commercial loan eligibility.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'DSCR Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a good Debt Service Coverage Ratio (DSCR)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most commercial banks and SBA lenders require a minimum DSCR of 1.20x to 1.25x, meaning the business generates 20% to 25% more operating income than required to service all principal and interest payments. A DSCR above 1.50x is considered strong.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if a company DSCR is below 1.0?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A DSCR below 1.0 means operating earnings are insufficient to cover total debt service. The company faces negative operational cash flow after debt obligations and must rely on cash reserves, new debt, or equity injections to prevent default.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between NOI and Net Income for DSCR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Net Operating Income (NOI) or EBITDA reflects earnings before interest, taxes, depreciation, and amortization. Using NOI ensures income is evaluated before loan interest deductions, providing a true measure of operational cash generation available for debt coverage.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does Total Debt Service include principal repayment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Unlike the Interest Coverage Ratio (which only accounts for interest expense), DSCR includes both mandatory principal amortization and periodic interest payments due in the measurement period.',
          },
        },
        {
          '@type': 'Question',
          name: 'How can a business improve its DSCR for loan approval?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A business can improve DSCR by cutting non-essential operating expenses to increase NOI, negotiating longer loan repayment tenures to reduce annual principal payments, or paying down existing high-interest debt to lower overall debt service.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="DSCR Calculator: Debt Service Coverage Ratio | Calcumetrics"
  description="Calculate your Debt Service Coverage Ratio (DSCR) from Net Operating Income and debt obligations. Commercial loan underwriting benchmarks included."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="DSCR Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={`${initialResult.dscr.toFixed(2)}x`}
    heroLabel="Debt Service Coverage Ratio"
    calcType="simple"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Debt Service Coverage Ratio (DSCR) Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate whether operating cash flow is sufficient to cover annual commercial debt service obligations.</p>

      <!-- Error alert -->
      <div id="dscr-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="dscr-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Net Operating Income -->
      <div class="mb-5">
        <Input
          id="dscr-noi"
          label="Annual Net Operating Income (NOI / EBITDA)"
          prefix="₹"
          value="15,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Operating earnings before interest, income taxes, and depreciation"
          inputmode="decimal"
          aria-describedby="dscr-error-msg"
        />
        <div class="mt-2">
          <Slider id="dscr-noi-slider" min={100000} max={10000000} step={25000} value={1500000} ariaLabel="NOI slider" />
        </div>
      </div>

      <!-- Total Debt Service -->
      <div class="mb-6">
        <Input
          id="dscr-debt"
          label="Total Annual Debt Service"
          prefix="₹"
          value="10,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total annual principal repayments + interest charges"
          inputmode="decimal"
          aria-describedby="dscr-error-msg"
        />
        <div class="mt-2">
          <Slider id="dscr-debt-slider" min={50000} max={10000000} step={25000} value={1000000} ariaLabel="Debt service slider" />
        </div>
      </div>

      <div class="flex gap-3">
        <Button variant="primary" id="dscr-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="dscr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Debt Service Coverage Ratio</span>
        <div id="dscr-result-hero" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {initialResult.dscr.toFixed(2)}x
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Operating Income</span>
          <span id="dscr-result-noi" class="text-sm font-semibold tabular-nums text-dark-text">{fmtCurrency(initialResult.noi)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Annual Debt Service</span>
          <span id="dscr-result-debt" class="text-sm font-medium tabular-nums text-dark-text">{fmtCurrency(initialResult.totalDebtService)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Cash Cushion (Surplus)</span>
          <span id="dscr-result-cushion" class="text-sm font-semibold tabular-nums text-dark-accent">{fmtCurrency(cushion)}</span>
        </div>
        <div class="py-2.5">
          <span class="text-xs text-dark-muted block mb-1">Underwriting Assessment</span>
          <span id="dscr-result-assessment" class="text-xs font-medium text-dark-text leading-snug block">{initialResult.assessment}</span>
        </div>
      </div>

      <div class="mb-5" id="dscr-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.noi > 0 ? Math.min(1, DEFAULT.debtService / DEFAULT.noi) : 0}
          gainFraction={DEFAULT.noi > 0 ? Math.max(0, (DEFAULT.noi - DEFAULT.debtService) / DEFAULT.noi) : 0}
          principalLabel="Debt Obligation"
          gainLabel="Income Cushion"
          principalValue={fmtCurrency(DEFAULT.debtService)}
          gainValue={fmtCurrency(cushion)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="dscr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="dscr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Standard lender benchmark: 1.25x or higher. Below 1.0x indicates inability to service debt from operational earnings.</p>
    </Fragment>

    <Fragment slot="formula">
      <div class="space-y-4 text-sm text-text-secondary">
        <p>The Debt Service Coverage Ratio is defined as:</p>
        <div class="bg-surface-elevated p-4 rounded-card border border-border font-mono text-xs overflow-x-auto text-center">
          DSCR = Net Operating Income (NOI) / Total Debt Service
        </div>
        <p>Where Total Debt Service = Annual Principal Amortization + Annual Interest Expense.</p>
      </div>
    </Fragment>

    <Fragment slot="faq">
      <div class="space-y-3">
        {jsonld['@graph'][2].mainEntity.map((faq: any) => (
          <details class="group bg-surface rounded-card border border-border overflow-hidden">
            <summary class="flex items-center justify-between p-4 text-sm font-medium text-text-primary cursor-pointer hover:bg-surface-elevated transition-colors">
              <span>{faq.name}</span>
              <svg class="w-4 h-4 text-text-muted transition-transform group-open:rotate-180 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-4 pt-1 text-xs text-text-secondary leading-relaxed border-t border-border/50">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </Fragment>

    <Fragment slot="related">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {related.map((t) => (
          <a href={t.path} class="p-4 bg-surface rounded-card border border-border hover:border-accent/40 transition-colors block">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{t.category}</span>
            <span class="text-sm font-semibold text-text-primary block mb-1">{t.name}</span>
            <p class="text-xs text-text-muted line-clamp-2">{t.description}</p>
          </a>
        ))}
      </div>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcDSCR } from '../lib/accounting/ratios';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initDSCRCalc() {
    if ((window as any).__cmDscrBound) return;
    (window as any).__cmDscrBound = true;

    const noiInput = document.getElementById('dscr-noi') as HTMLInputElement | null;
    const debtInput = document.getElementById('dscr-debt') as HTMLInputElement | null;

    const noiSlider = document.getElementById('dscr-noi-slider') as HTMLInputElement | null;
    const debtSlider = document.getElementById('dscr-debt-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('dscr-result-hero');
    const resNoi = document.getElementById('dscr-result-noi');
    const resDebt = document.getElementById('dscr-result-debt');
    const resCushion = document.getElementById('dscr-result-cushion');
    const resAssessment = document.getElementById('dscr-result-assessment');

    const errAlert = document.getElementById('dscr-error-alert');
    const errMsg = document.getElementById('dscr-error-msg');

    if (!noiInput || !debtInput) return;

    const DEFAULTS = { noi: 1500000, debtService: 1000000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawNoi = noiInput!.value.replace(/[^0-9.]/g, '');
      const rawDebt = debtInput!.value.replace(/[^0-9.]/g, '');

      const vNoi = validate(rawNoi, { required: true, min: 0, label: 'Net Operating Income' });
      const vDebt = validate(rawDebt, { required: true, min: 1, label: 'Debt Service' });

      if (!vNoi.valid) { showError(vNoi.error!.message); return; }
      if (!vDebt.valid) { showError(vDebt.error!.message); return; }
      clearError();

      const noi = vNoi.value!;
      const debt = vDebt.value!;

      const res = calcDSCR(noi, debt);
      const cushion = Math.max(0, noi - debt);

      setResult({
        heroValue: `${res.dscr.toFixed(2)}x`,
        heroLabel: 'Debt Service Coverage Ratio',
        rows: [
          { label: 'Net Operating Income (NOI)', value: fmtVal(noi) },
          { label: 'Total Debt Service', value: fmtVal(debt) },
          { label: 'Income Cushion', value: fmtVal(cushion) },
          { label: 'Assessment', value: res.assessment },
        ],
      });

      if (resHero) resHero.textContent = `${res.dscr.toFixed(2)}x`;
      if (resNoi) resNoi.textContent = fmtVal(noi);
      if (resDebt) resDebt.textContent = fmtVal(debt);
      if (resCushion) resCushion.textContent = fmtVal(cushion);
      if (resAssessment) resAssessment.textContent = res.assessment;

      const wrapper = document.getElementById('dscr-composition-wrapper');
      if (wrapper && noi > 0) {
        const debtPct = Math.min(100, (debt / noi) * 100);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${debtPct.toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(debt);
        if (valEls[1]) valEls[1].textContent = fmtVal(cushion);
      }

      serializeHash({ noi, d: debt });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(noiSlider, noiInput);
    sync(debtSlider, debtInput);

    document.getElementById('dscr-calculate')?.addEventListener('click', recalc);
    document.getElementById('dscr-reset')?.addEventListener('click', () => {
      noiInput.value = fmtLiveInput(String(DEFAULTS.noi));
      debtInput.value = fmtLiveInput(String(DEFAULTS.debtService));
      if (noiSlider) {
        noiSlider.value = String(DEFAULTS.noi);
        noiSlider.style.setProperty('--slider-pct', `${((DEFAULTS.noi - 100000) / (10000000 - 100000)) * 100}%`);
      }
      if (debtSlider) {
        debtSlider.value = String(DEFAULTS.debtService);
        debtSlider.style.setProperty('--slider-pct', `${((DEFAULTS.debtService - 50000) / (10000000 - 50000)) * 100}%`);
      }
      clearError();
      recalc();
      noiInput.focus();
    });

    [noiInput, debtInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('dscr-copy-btn')?.addEventListener('click', async () => {
      const rawNoi = noiInput.value.replace(/[^0-9.]/g, '');
      const rawDebt = debtInput.value.replace(/[^0-9.]/g, '');

      const vNoi = validate(rawNoi, { required: true, min: 0, label: 'NOI' });
      const vDebt = validate(rawDebt, { required: true, min: 1, label: 'Debt' });

      if (!vNoi.valid || !vDebt.valid) return;

      const res = calcDSCR(vNoi.value!, vDebt.value!);
      const text = `DSCR: ${res.dscr.toFixed(2)}x on NOI of ${fmtVal(vNoi.value!)} with debt service of ${fmtVal(vDebt.value!)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('dscr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('dscr-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('dscr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      noi: { required: true, min: 0, label: 'noi' },
      d: { required: true, min: 1, label: 'd' },
    });
    if (restored.valid && restored.values.noi !== undefined && restored.values.d) {
      noiInput.value = fmtLiveInput(String(restored.values.noi));
      debtInput.value = fmtLiveInput(String(restored.values.d));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initDSCRCalc();
  document.addEventListener('astro:page-load', initDSCRCalc);
</script>
