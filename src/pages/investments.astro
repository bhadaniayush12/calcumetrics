---
import Layout from '../layouts/Layout.astro';
import { getPublishedTools } from '../config/site';
const tools = getPublishedTools().filter((t) => t.category === 'Investments');
const count = tools.length;
const noindex = count < 4;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Investment Calculators', url: 'https://calcumetrics.com/investments', description: `${count} free investment calculators: SIP, lump sum, CAGR, XIRR, FD, RD, PPF, and more.` },
    { '@type': 'ItemList', itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://calcumetrics.com${t.path}`, name: t.name })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Investments', item: 'https://calcumetrics.com/investments' }] },
  ],
};
---
<Layout title={`Investment Calculators: ${count} Free Tools | Calcumetrics`} description={`${count} free investment calculators: SIP returns, lump sum growth, CAGR, XIRR, FD maturity, RD, PPF, and 401(k). 100% client-side.`} canonical="https://calcumetrics.com/investments" robots={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} ogImage="/og/categories/investments.png" ogImageAlt="Calcumetrics Investment Calculators — SIP, Compound Interest, CAGR, and PPF suite preview card">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav aria-label="Breadcrumb" class="mb-6"><ol class="flex items-center gap-1.5 text-xs text-text-muted"><li><a href="/" class="hover:text-accent transition-standard">Home</a></li><li aria-hidden="true">›</li><li class="text-text-primary font-medium" aria-current="page">Investments</li></ol></nav>
    <h1 class="text-3xl font-bold tracking-tight text-text-primary mb-2">Investment Calculators</h1>
    <p class="text-sm text-text-muted mb-8 max-w-xl">Plan and project your investments: SIP returns, lump sum growth, fixed deposits, and more. All calculations run in your browser.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.region}</span>
          <h2 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard mb-1">{tool.name}</h2>
          <p class="text-xs text-text-muted leading-relaxed">{tool.description}</p>
        </a>
      ))}
    </div>
    <section aria-labelledby="hub-guide" class="mt-12 max-w-3xl">
      <h2 id="hub-guide" class="text-xl font-bold text-text-primary mb-4">How to choose an investment calculator</h2>
      <p class="text-sm text-text-muted leading-relaxed mb-4">Start with how the money goes in. For a fixed monthly amount into a mutual fund, use the <a href="/sip-calculator" class="text-accent hover:underline font-medium">SIP calculator</a>; for a single deposit left to grow, use <a href="/lump-sum-calculator" class="text-accent hover:underline font-medium">lump sum</a> or <a href="/compound-interest-calculator" class="text-accent hover:underline font-medium">compound interest</a>. Simple interest only applies when interest is paid out rather than reinvested.</p>
      <p class="text-sm text-text-muted leading-relaxed mb-4">For bank deposits, the <a href="/fd-calculator" class="text-accent hover:underline font-medium">FD calculator</a> handles one deposit and the <a href="/rd-calculator" class="text-accent hover:underline font-medium">RD calculator</a> handles fixed monthly deposits. Indian savers after tax-free long-term returns should check the <a href="/in/ppf-calculator" class="text-accent hover:underline font-medium">PPF calculator</a>; US savers should use the <a href="/us/401k-calculator" class="text-accent hover:underline font-medium">401(k) calculator</a>.</p>
      <p class="text-sm text-text-muted leading-relaxed mb-4">To judge returns you have already earned, use <a href="/cagr-calculator" class="text-accent hover:underline font-medium">CAGR</a> when there is one start value and one end value, and <a href="/xirr-calculator" class="text-accent hover:underline font-medium">XIRR</a> when you added or withdrew money on different dates. Then run any target through the <a href="/inflation-calculator" class="text-accent hover:underline font-medium">inflation calculator</a> and let the <a href="/savings-goal-calculator" class="text-accent hover:underline font-medium">savings goal calculator</a> turn it into a monthly amount.</p>
      <h3 class="text-sm font-semibold text-text-primary mb-2 mt-6">Related guides</h3>
      <ul class="list-disc pl-5 space-y-1 text-sm">
        <li><a href="/blog/cagr-vs-xirr" class="text-accent hover:underline font-medium">CAGR vs XIRR: which return figure to trust</a></li>
        <li><a href="/blog/rd-vs-sip" class="text-accent hover:underline font-medium">RD vs SIP: fixed deposits or mutual funds</a></li>
        <li><a href="/blog/real-rate-of-return" class="text-accent hover:underline font-medium">Real rate of return after inflation</a></li>
      </ul>
    </section>
  </div>
</Layout>
