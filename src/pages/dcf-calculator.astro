---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { TOOLS } from '../config/site';

const related = TOOLS.filter((t) => t.category === 'Corporate Finance' && t.slug !== 'dcf-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/dcf-calculator' as string;
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'DCF Calculator', url: canonicalUrl, description: 'Calculate the intrinsic value of an investment using the Discounted Cash Flow method with a terminal value based on Gordon Growth Model.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Corporate Finance', item: 'https://calcumetrics.com/corporate-finance' }, { '@type': 'ListItem', position: 3, name: 'DCF Calculator' }] }] };
---
<Layout title="DCF Calculator: Discounted Cash Flow Valuation | Calcumetrics" description="Calculate the intrinsic value of an investment using the Discounted Cash Flow method with a terminal value based on Gordon Growth Model." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="DCF Calculator" category="Corporate Finance" categoryHref="/corporate-finance" heroValue="Calculate to see" heroLabel="Intrinsic Value">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">DCF Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate the intrinsic value of an investment using the Discounted Cash Flow method with a terminal value based on Gordon Growth Model.</p>
      <Alert variant="info" title="Assumption">Results are estimates for information only. Not financial advice.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" type="button">Calculate</Button><Button variant="ghost" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Intrinsic Value</span>
        <div class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">Calculate to see</div>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="dcf-calculator-how">
        <h2 id="dcf-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Calculate the intrinsic value of an investment using the Discounted Cash Flow method with a terminal value based on Gordon Growth Model.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">DCF = Σ FCF_t / (1+r)^t + TV / (1+r)^n. Terminal Value (Gordon Growth): TV = FCF_n × (1+g) / (r−g) where g = terminal growth rate. Sensitive to discount rate and growth rate assumptions.</p>
        </div>
      </section>
      <section aria-labelledby="dcf-calculator-faq">
        <h2 id="dcf-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How sensitive is DCF to the discount rate and growth rate?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Very sensitive. Small changes in these inputs can swing the intrinsic value by 30-50%. This is why DCF analysts typically run scenarios (base, bull, bear) with different assumptions and examine a range of values rather than a single point estimate. Terminal value often comprises 60-80% of total DCF value.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is a reasonable terminal growth rate?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">The terminal growth rate should not exceed the long-term nominal GDP growth rate (3-5% for developed economies; 5-7% for India at current trajectory), since no company can grow faster than the economy indefinitely. Many analysts use 2-4% for mature companies in stable industries.</div></details>
        </div>
      </section>
      <section aria-labelledby="dcf-calculator-related">
        <h2 id="dcf-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
