---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcDCF } from '../lib/calculators/corporate';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

// 5 years of projected cash flows starting from ₹1,00,000 at 10% growth
const DEFAULT = { fcf1: 100000, growth: 10, discountRate: 12, terminalGrowth: 3 };
const flows = [DEFAULT.fcf1, DEFAULT.fcf1 * 1.1, DEFAULT.fcf1 * 1.21, DEFAULT.fcf1 * 1.331, DEFAULT.fcf1 * 1.4641];
const result = calcDCF(flows, DEFAULT.discountRate, DEFAULT.terminalGrowth);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Corporate Finance' && t.slug !== 'dcf-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/dcf-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'DCF Calculator',
      url: canonicalUrl,
      description: 'Calculate the intrinsic value of an investment using Discounted Cash Flow with Gordon Growth terminal value.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Corporate Finance', item: 'https://calcumetrics.com/corporate-finance' },
        { '@type': 'ListItem', position: 3, name: 'DCF Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Why is terminal value often 70%+ of DCF value?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Because companies are assumed to exist as going concerns into perpetuity, all cash flows earned beyond year 5 accumulate into the terminal value, making it naturally the largest component of total value.',
          },
        },
        {
          '@type': 'Question',
          name: 'What discount rate should I use?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For firm valuation, use the Weighted Average Cost of Capital (WACC), which reflects the blended required returns of equity investors and debt lenders. Typically, WACC ranges between 8% to 15% depending on risk.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the Gordon Growth Model rule for terminal value?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The perpetual growth rate (g) must strictly be lower than the discount rate (r). If perpetual growth equals or exceeds the cost of capital, the enterprise is mathematically modeled to grow larger than the overall economy, rendering the valuation undefined.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a realistic perpetual terminal growth rate?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In practice, perpetual terminal growth rates are typically pegged to long-run nominal GDP growth or expected inflation rates, typically ranging between 2% and 4% for mature economies and up to 5% to 6% for rapidly expanding developing markets.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does DCF differ from market multiples like P/E or EV/EBITDA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'DCF calculates fundamental intrinsic value derived from the firm\'s expected cash generation and risk profile, whereas market multiples reflect relative valuation based on current market sentiment and peer pricing.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="DCF Calculator: Discounted Cash Flow Valuation | Calcumetrics"
  description="Calculate the intrinsic value of an investment using Discounted Cash Flow with Gordon Growth terminal value."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="DCF Calculator"
    category="Corporate Finance"
    categoryHref="/corporate-finance"
    heroValue={fmt(result.intrinsicValue)}
    heroLabel="Intrinsic Enterprise Value"
    calcType="advanced"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">DCF Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Estimate corporate intrinsic value based on discounted future cash flows and terminal value.</p>

      <!-- Error alert -->
      <div id="dcf-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="dcf-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Year 1 Cash Flow -->
      <div class="mb-5">
        <Input
          id="dcf-fcf1"
          label="Year 1 Free Cash Flow (FCF)"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Operating cash flow minus capital expenditures"
          inputmode="decimal"
          aria-describedby="dcf-error-msg"
        />
        <div class="mt-2">
          <Slider id="dcf-fcf1-slider" min={10000} max={2500000} step={10000} value={100000} ariaLabel="Year 1 FCF slider" />
        </div>
      </div>

      <!-- Growth Rate -->
      <div class="mb-5">
        <Input
          id="dcf-growth"
          label="5-Year FCF Growth Rate"
          suffix="%"
          value="10"
          isNumeric={true}
          helperText="Forecast annual growth for explicit 5-year period"
          inputmode="decimal"
          aria-describedby="dcf-error-msg"
        />
        <div class="mt-2">
          <Slider id="dcf-growth-slider" min={0} max={40} step={0.5} value={10} ariaLabel="5-year growth slider" />
        </div>
      </div>

      <!-- Discount Rate -->
      <div class="mb-5">
        <Input
          id="dcf-discount"
          label="Discount Rate (WACC / Hurdle Rate)"
          suffix="%"
          value="12"
          isNumeric={true}
          helperText="Cost of capital or required rate of return"
          inputmode="decimal"
          aria-describedby="dcf-error-msg"
        />
        <div class="mt-2">
          <Slider id="dcf-discount-slider" min={4} max={30} step={0.25} value={12} ariaLabel="Discount rate slider" />
        </div>
      </div>

      <!-- Terminal Growth Rate -->
      <div class="mb-6">
        <Input
          id="dcf-terminal"
          label="Perpetual Terminal Growth Rate (g)"
          suffix="%"
          value="3"
          isNumeric={true}
          helperText="Long-term GDP growth ceiling (must be less than discount rate)"
          inputmode="decimal"
          aria-describedby="dcf-error-msg"
        />
        <div class="mt-2">
          <Slider id="dcf-terminal-slider" min={0.5} max={8} step={0.25} value={3} ariaLabel="Terminal growth slider" />
        </div>
      </div>

      <Alert variant="info" title="Gordon Growth Rule">
        The terminal growth rate must be lower than the discount rate (r &gt; g). If r &le; g, terminal value becomes mathematically undefined.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="dcf-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="dcf-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Intrinsic Enterprise Value</span>
        <div id="dcf-result-intrinsic" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.intrinsicValue)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">PV of 5-Yr Forecast</span>
          <span id="dcf-result-pvflows" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.pvOfCashFlows)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">PV of Terminal Value</span>
          <span id="dcf-result-pvtv" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.pvOfTerminalValue)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Undiscounted Terminal Value</span>
          <span id="dcf-result-tv" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.terminalValue)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Terminal Value % of Total</span>
          <span id="dcf-result-tvpct" class="text-sm font-bold tabular-nums text-dark-text">{result.intrinsicValue > 0 ? ((result.pvOfTerminalValue / result.intrinsicValue) * 100).toFixed(1) : 0}%</span>
        </div>
      </div>

      <div class="mb-5" id="dcf-composition-wrapper">
        <CompositionBar
          principalFraction={result.intrinsicValue > 0 ? result.pvOfCashFlows / result.intrinsicValue : 0.5}
          gainFraction={result.intrinsicValue > 0 ? result.pvOfTerminalValue / result.intrinsicValue : 0.5}
          principalLabel="5-Yr Cash Flows"
          gainLabel="Terminal Value"
          principalValue={fmt(result.pvOfCashFlows)}
          gainValue={fmt(result.pvOfTerminalValue)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="dcf-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="dcf-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">DCF intrinsic valuations are highly sensitive to discount and terminal assumptions.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="dcf-calculator-how">
        <h2 id="dcf-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Discounted Cash Flow works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          DCF valuation discounts future cash flows back to the present day using the opportunity cost of capital:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">
            <strong>PV of Explicit Flows: </strong> &Sigma; [ FCF<sub>t</sub> / (1 + r)<sup>t</sup> ]<br />
            <strong>Gordon Growth Terminal Value: </strong> TV = [ FCF<sub>n</sub> &times; (1 + g) ] / (r &minus; g)<br />
            <strong>PV of Terminal Value: </strong> TV / (1 + r)<sup>n</sup><br />
            <strong>Total Enterprise Value: </strong> PV of Flows + PV of Terminal Value
          </p>
        </div>
      </section>

      <section aria-labelledby="dcf-calculator-faq">
        <h2 id="dcf-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            ['Why is terminal value often 70%+ of DCF value?', 'Because companies are assumed to exist as going concerns into perpetuity, all cash flows earned beyond year 5 accumulate into the terminal value, making it naturally the largest component of total value.'],
            ['What discount rate should I use?', 'For firm valuation, use the Weighted Average Cost of Capital (WACC), which reflects the blended required returns of equity investors and debt lenders. Typically, WACC ranges between 8% to 15% depending on risk.'],
            ['What is the Gordon Growth Model rule for terminal value?', 'The perpetual growth rate (g) must strictly be lower than the discount rate (r). If perpetual growth equals or exceeds the cost of capital, the enterprise is mathematically modeled to grow larger than the overall economy, rendering the valuation undefined.'],
            ['What is a realistic perpetual terminal growth rate?', 'In practice, perpetual terminal growth rates are typically pegged to long-run nominal GDP growth or expected inflation rates, typically ranging between 2% and 4% for mature economies and up to 5% to 6% for rapidly expanding developing markets.'],
            ['How does DCF differ from market multiples like P/E or EV/EBITDA?', 'DCF calculates fundamental intrinsic value derived from the firm\'s expected cash generation and risk profile, whereas market multiples reflect relative valuation based on current market sentiment and peer pricing.'],
          ].map(([q, a]) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{q}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="dcf-calculator-related">
        <h2 id="dcf-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  function calcDCFClient(fcf1: number, growthPct: number, discountPct: number, terminalPct: number) {
    const r = discountPct / 100;
    const g = terminalPct / 100;
    const gr = growthPct / 100;

    const flows: number[] = [];
    let cur = fcf1;
    for (let i = 0; i < 5; i++) {
      flows.push(cur);
      cur *= (1 + gr);
    }

    const pvOfCashFlows = flows.reduce((sum, cf, t) => sum + cf / Math.pow(1 + r, t + 1), 0);
    const lastCF = flows[flows.length - 1];
    const terminalValue = r > g ? (lastCF * (1 + g)) / (r - g) : 0;
    const pvOfTerminalValue = terminalValue / Math.pow(1 + r, 5);
    const intrinsicValue = pvOfCashFlows + pvOfTerminalValue;

    return {
      intrinsicValue,
      pvOfCashFlows,
      terminalValue,
      pvOfTerminalValue,
      tvPct: intrinsicValue > 0 ? (pvOfTerminalValue / intrinsicValue) * 100 : 0,
      flowFrac: intrinsicValue > 0 ? pvOfCashFlows / intrinsicValue : 0.5,
      tvFrac: intrinsicValue > 0 ? pvOfTerminalValue / intrinsicValue : 0.5,
    };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initDCFCalc() {
    if ((window as any).__cmDCFBound) return;
    (window as any).__cmDCFBound = true;

    const fcf1Input = document.getElementById('dcf-fcf1') as HTMLInputElement | null;
    const growthInput = document.getElementById('dcf-growth') as HTMLInputElement | null;
    const discountInput = document.getElementById('dcf-discount') as HTMLInputElement | null;
    const terminalInput = document.getElementById('dcf-terminal') as HTMLInputElement | null;

    const fcf1Slider = document.getElementById('dcf-fcf1-slider') as HTMLInputElement | null;
    const growthSlider = document.getElementById('dcf-growth-slider') as HTMLInputElement | null;
    const discountSlider = document.getElementById('dcf-discount-slider') as HTMLInputElement | null;
    const terminalSlider = document.getElementById('dcf-terminal-slider') as HTMLInputElement | null;

    const resIntrinsic = document.getElementById('dcf-result-intrinsic');
    const resPvFlows = document.getElementById('dcf-result-pvflows');
    const resPvTv = document.getElementById('dcf-result-pvtv');
    const resTv = document.getElementById('dcf-result-tv');
    const resTvPct = document.getElementById('dcf-result-tvpct');

    const errAlert = document.getElementById('dcf-error-alert');
    const errMsg = document.getElementById('dcf-error-msg');

    if (!fcf1Input || !growthInput || !discountInput || !terminalInput) return;

    const DEFAULTS = { fcf1: 100000, growth: 10, discount: 12, terminal: 3 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawFcf = fcf1Input!.value.replace(/[^0-9.]/g, '');
      const rawGrowth = growthInput!.value.replace(/[^0-9.-]/g, '');
      const rawDiscount = discountInput!.value.replace(/[^0-9.]/g, '');
      const rawTerminal = terminalInput!.value.replace(/[^0-9.-]/g, '');

      const vFcf = validate(rawFcf, { required: true, min: 1, label: 'Year 1 Free Cash Flow' });
      const vGrowth = validate(rawGrowth, { required: true, min: -50, max: 100, decimal: true, label: '5-Year FCF Growth Rate' });
      const vDiscount = validate(rawDiscount, { required: true, min: 0.1, max: 100, decimal: true, label: 'Discount Rate' });
      const vTerminal = validate(rawTerminal, { required: true, min: -10, max: 20, decimal: true, label: 'Terminal Growth Rate' });

      if (!vFcf.valid) { showError(vFcf.error!.message); return; }
      if (!vGrowth.valid) { showError(vGrowth.error!.message); return; }
      if (!vDiscount.valid) { showError(vDiscount.error!.message); return; }
      if (!vTerminal.valid) { showError(vTerminal.error!.message); return; }

      if (vDiscount.value! <= vTerminal.value!) {
        showError('Discount rate must be strictly greater than perpetual terminal growth rate (r > g).');
        return;
      }
      clearError();

      const fcf1 = vFcf.value!;
      const growth = vGrowth.value!;
      const discount = vDiscount.value!;
      const terminal = vTerminal.value!;

      const res = calcDCFClient(fcf1, growth, discount, terminal);

      setResult({
        heroValue: fmtVal(res.intrinsicValue),
        heroLabel: 'Intrinsic Enterprise Value',
        rows: [
          { label: 'PV of 5-Yr Forecast', value: fmtVal(res.pvOfCashFlows) },
          { label: 'PV of Terminal Value', value: fmtVal(res.pvOfTerminalValue) },
          { label: 'Undiscounted Terminal Value', value: fmtVal(res.terminalValue) },
          { label: 'Terminal Value % of Total', value: res.tvPct.toFixed(1) + '%' },
        ],
      });

      if (resIntrinsic) resIntrinsic.textContent = fmtVal(res.intrinsicValue);
      if (resPvFlows) resPvFlows.textContent = fmtVal(res.pvOfCashFlows);
      if (resPvTv) resPvTv.textContent = fmtVal(res.pvOfTerminalValue);
      if (resTv) resTv.textContent = fmtVal(res.terminalValue);
      if (resTvPct) resTvPct.textContent = res.tvPct.toFixed(1) + '%';

      const wrapper = document.getElementById('dcf-composition-wrapper');
      if (wrapper && res.intrinsicValue > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.flowFrac * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.tvFrac * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.pvOfCashFlows);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.pvOfTerminalValue);
      }

      history.replaceState(null, '', serializeHash({ f: fcf1, g: growth, d: discount, t: terminal }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(fcf1Slider, fcf1Input, true);
    sync(growthSlider, growthInput, false);
    sync(discountSlider, discountInput, false);
    sync(terminalSlider, terminalInput, false);

    document.getElementById('dcf-calculate')?.addEventListener('click', recalc);
    document.getElementById('dcf-reset')?.addEventListener('click', () => {
      fcf1Input.value = fmtLiveInput(String(DEFAULTS.fcf1));
      growthInput.value = String(DEFAULTS.growth);
      discountInput.value = String(DEFAULTS.discount);
      terminalInput.value = String(DEFAULTS.terminal);

      if (fcf1Slider) {
        fcf1Slider.value = String(DEFAULTS.fcf1);
        fcf1Slider.style.setProperty('--slider-pct', `${((DEFAULTS.fcf1 - 10000) / (2500000 - 10000)) * 100}%`);
      }
      if (growthSlider) {
        growthSlider.value = String(DEFAULTS.growth);
        growthSlider.style.setProperty('--slider-pct', `${((DEFAULTS.growth - 0) / (40 - 0)) * 100}%`);
      }
      if (discountSlider) {
        discountSlider.value = String(DEFAULTS.discount);
        discountSlider.style.setProperty('--slider-pct', `${((DEFAULTS.discount - 4) / (30 - 4)) * 100}%`);
      }
      if (terminalSlider) {
        terminalSlider.value = String(DEFAULTS.terminal);
        terminalSlider.style.setProperty('--slider-pct', `${((DEFAULTS.terminal - 0.5) / (8 - 0.5)) * 100}%`);
      }

      clearError();
      recalc();
      fcf1Input.focus();
    });

    [fcf1Input, growthInput, discountInput, terminalInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('dcf-copy-btn')?.addEventListener('click', async () => {
      const rawFcf = fcf1Input.value.replace(/[^0-9.]/g, '');
      const rawGrowth = growthInput.value.replace(/[^0-9.-]/g, '');
      const rawDiscount = discountInput.value.replace(/[^0-9.]/g, '');
      const rawTerminal = terminalInput.value.replace(/[^0-9.-]/g, '');

      const vFcf = validate(rawFcf, { required: true, min: 1, label: 'Year 1 Free Cash Flow' });
      const vGrowth = validate(rawGrowth, { required: true, min: -50, max: 100, decimal: true, label: '5-Year FCF Growth Rate' });
      const vDiscount = validate(rawDiscount, { required: true, min: 0.1, max: 100, decimal: true, label: 'Discount Rate' });
      const vTerminal = validate(rawTerminal, { required: true, min: -10, max: 20, decimal: true, label: 'Terminal Growth Rate' });

      if (!vFcf.valid || !vGrowth.valid || !vDiscount.valid || !vTerminal.valid || vDiscount.value! <= vTerminal.value!) return;

      const res = calcDCFClient(vFcf.value!, vGrowth.value!, vDiscount.value!, vTerminal.value!);
      const text = `DCF Valuation: Year 1 FCF ${fmtVal(vFcf.value!)}, growth ${vGrowth.value}%, discount ${vDiscount.value}%, terminal ${vTerminal.value}% => Intrinsic Value: ${fmtVal(res.intrinsicValue)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('dcf-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('dcf-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('dcf-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      f: { required: true, min: 1, label: 'f' },
      g: { required: true, min: -50, max: 100, decimal: true, label: 'g' },
      d: { required: true, min: 0.1, max: 100, decimal: true, label: 'd' },
      t: { required: true, min: -10, max: 20, decimal: true, label: 't' },
    });
    if (restored.valid && restored.values.f && restored.values.g !== undefined && restored.values.d && restored.values.t !== undefined) {
      fcf1Input.value = fmtLiveInput(String(restored.values.f));
      growthInput.value = String(restored.values.g);
      discountInput.value = String(restored.values.d);
      terminalInput.value = String(restored.values.t);
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initDCFCalc();
  document.addEventListener('astro:page-load', initDCFCalc);
</script>
