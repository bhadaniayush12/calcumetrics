---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcLoanPrepayment } from '../lib/calculators/prepayment';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 3000000, rate: 8.5, months: 180, prepay: 300000, strategy: 'reduce-tenure' as const };
const initialResult = calcLoanPrepayment(DEFAULT.principal, DEFAULT.rate, DEFAULT.months, DEFAULT.prepay, DEFAULT.strategy);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Loans' && t.slug !== 'loan-prepayment-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/loan-prepayment-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Loan Prepayment Calculator',
      url: canonicalUrl,
      description: 'Calculate interest saved and tenure reduction when making lump-sum or partial prepayments on your loan.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Loan Prepayment Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Should I choose tenure reduction or EMI reduction when prepaying?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If your current monthly cash flow is comfortable, reducing tenure saves significantly more interest because loan interest compounds over a shorter timeframe. If your monthly cash flow is strained, reducing EMI lowers your monthly obligation and improves liquidity.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does part-prepayment save interest on a reducing-balance loan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Every rupee of prepayment directly deducts from the outstanding principal balance. Since future monthly interest is computed strictly on the remaining principal, shrinking the principal immediately reduces monthly interest accumulation.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are there prepayment penalties on home loans?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under RBI rules in India, banks and housing finance companies cannot charge prepayment or foreclosure penalties on floating-rate individual home loans. For fixed-rate loans or non-individual borrowers, penalties of 2% to 4% may apply.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the best time during a loan tenure to make a prepayment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Prepayments yield the highest financial benefit early in the loan tenure, when the principal balance is highest and the interest component forms the largest portion of each monthly EMI installment.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is there a minimum amount required for loan prepayment?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most lending institutions mandate that partial prepayments equal at least one or two monthly EMIs, or a minimum threshold such as ₹10,000 to ₹25,000. Refer to your loan sanction letter for specific bank guidelines.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Loan Prepayment Calculator: Interest Saved & Tenure Reduced | Calcumetrics"
  description="Calculate how much interest you can save by prepaying your home or car loan. Compare tenure reduction vs lower EMI."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Loan Prepayment Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={fmt(initialResult.interestSaved)}
    heroLabel="Total Interest Saved"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Loan Prepayment Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate the exact interest savings and tenure reduction from making a partial loan prepayment.</p>

      <!-- Error alert -->
      <div id="lp-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="lp-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Outstanding Principal -->
      <div class="mb-5">
        <Input
          id="lp-principal"
          label="Outstanding Principal Balance"
          prefix="₹"
          value="30,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Current remaining balance on your loan"
          inputmode="decimal"
          aria-describedby="lp-error-msg"
        />
        <div class="mt-2">
          <Slider id="lp-principal-slider" min={100000} max={20000000} step={50000} value={3000000} ariaLabel="Principal balance slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="lp-rate"
          label="Interest Rate"
          suffix="%"
          value="8.5"
          isNumeric={true}
          helperText="Current annual interest rate"
          inputmode="decimal"
          aria-describedby="lp-error-msg"
        />
        <div class="mt-2">
          <Slider id="lp-rate-slider" min={5.0} max={20.0} step={0.25} value={8.5} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Remaining Tenure (Months) -->
      <div class="mb-5">
        <Input
          id="lp-months"
          label="Remaining Tenure (Months)"
          suffix="Months"
          value="180"
          isNumeric={true}
          helperText="Total remaining monthly payments (e.g. 15 years = 180 months)"
          inputmode="numeric"
          aria-describedby="lp-error-msg"
        />
        <div class="mt-2">
          <Slider id="lp-months-slider" min={12} max={360} step={6} value={180} ariaLabel="Remaining months slider" />
        </div>
      </div>

      <!-- Prepayment Amount -->
      <div class="mb-5">
        <Input
          id="lp-prepay"
          label="Part-Prepayment Amount"
          prefix="₹"
          value="3,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Lump-sum amount you plan to prepay"
          inputmode="decimal"
          aria-describedby="lp-error-msg"
        />
        <div class="mt-2">
          <Slider id="lp-prepay-slider" min={10000} max={5000000} step={25000} value={300000} ariaLabel="Prepayment slider" />
        </div>
      </div>

      <!-- Prepayment Option -->
      <div class="mb-6">
        <Dropdown
          id="lp-strategy"
          label="Prepayment Benefit Strategy"
          options={[
            { value: 'reduce-tenure', label: 'Reduce Loan Tenure (Keep EMI Same)' },
            { value: 'reduce-emi',    label: 'Reduce Monthly EMI (Keep Tenure Same)' },
          ]}
          value="reduce-tenure"
          helperText="Tenure reduction maximizes interest saved"
        />
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="lp-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="lp-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Total Interest Saved</span>
        <div id="lp-result-saved" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.interestSaved)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Current Monthly EMI</span>
          <span id="lp-result-curremi" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.originalEMI)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Tenure Saved</span>
          <span id="lp-result-savedmonths" class="text-sm font-semibold tabular-nums text-dark-accent">
            {initialResult.monthsSaved} months ({(initialResult.monthsSaved / 12).toFixed(1)} yrs)
          </span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Revised Remaining Tenure</span>
          <span id="lp-result-newtenure" class="text-sm font-medium tabular-nums text-dark-text">
            {initialResult.newMonths} months ({(initialResult.newMonths / 12).toFixed(1)} yrs)
          </span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Revised Monthly EMI</span>
          <span id="lp-result-newemi" class="text-sm font-bold tabular-nums text-dark-text">{fmt(initialResult.newEMI)}</span>
        </div>
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="lp-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="lp-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes reducing balance interest calculation without prepayment penalties.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="loan-prepayment-calculator-how">
        <h2 id="loan-prepayment-calculator-how" class="text-xl font-bold text-text-primary mb-4">How loan prepayment savings work</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Every rupee of prepayment directly subtracts from your outstanding loan principal. Because monthly interest on reducing-balance loans is computed strictly on the remaining unpaid principal balance, shrinking the principal immediately prevents future interest compounding:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 space-y-3">
          <p class="text-base font-mono text-text-primary">P_new = Outstanding Balance − Prepayment Amount</p>
          <div class="border-t border-border/50 pt-3 text-sm text-text-muted space-y-2">
            <p><strong>Strategy 1: Tenure Reduction (Keep EMI constant)</strong></p>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">n_new = ⌈ −ln(1 − (r × P_new / EMI)) / ln(1 + r) ⌉</p>
            <p>Here, the monthly EMI remains unchanged, so a greater fraction of each subsequent installment repays principal, accelerating debt payoff and maximizing interest savings.</p>
          </div>
          <div class="border-t border-border/50 pt-3 text-sm text-text-muted space-y-2">
            <p><strong>Strategy 2: EMI Reduction (Keep tenure constant)</strong></p>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">EMI_new = [P_new × r × (1 + r)^n] / [(1 + r)^n − 1]</p>
            <p>Here, the remaining tenure is preserved, recalculating a lower monthly installment to enhance immediate monthly household liquidity.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-worked-example">
        <h2 id="loan-prepayment-worked-example" class="text-xl font-bold text-text-primary mb-4">Step-by-step worked example: ₹30 Lakh Loan</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider an outstanding home loan balance of <strong>₹30,00,000</strong> at an annual interest rate of <strong>8.5%</strong> with <strong>180 months (15 years)</strong> remaining. The current monthly EMI is <strong>₹29,542</strong>, with a cumulative remaining interest obligation of <strong>₹23,17,498</strong>. You decide to make a <strong>₹3,00,000</strong> lump-sum prepayment:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 space-y-3 text-sm text-text-muted">
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Outstanding Balance before Prepayment:</span>
            <strong class="text-text-primary font-mono">₹30,00,000</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Lump-Sum Prepayment Amount:</span>
            <strong class="text-text-primary font-mono">₹3,00,000 (10% of balance)</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Revised Principal Balance (P_new):</span>
            <strong class="text-text-primary font-mono">₹27,00,000</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Original Monthly EMI:</span>
            <strong class="text-text-primary font-mono">₹29,542</strong>
          </div>
          <div class="bg-canvas p-3 rounded space-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-accent block">Strategy A: Reduce Tenure (Keep EMI at ₹29,542)</span>
            <div class="flex justify-between text-xs">
              <span>New Remaining Tenure:</span>
              <strong class="text-text-primary font-mono">148 months (12.3 years)</strong>
            </div>
            <div class="flex justify-between text-xs">
              <span>Tenure Saved:</span>
              <strong class="text-text-primary font-mono">32 months (2.7 years)</strong>
            </div>
            <div class="flex justify-between text-xs">
              <span>Total Interest Saved:</span>
              <strong class="text-accent font-mono font-bold">₹6,45,333</strong>
            </div>
          </div>
          <div class="bg-canvas p-3 rounded space-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-text-primary block">Strategy B: Reduce EMI (Keep Tenure at 180 Months)</span>
            <div class="flex justify-between text-xs">
              <span>Revised Monthly EMI:</span>
              <strong class="text-text-primary font-mono">₹26,587 (saves ₹2,955/mo)</strong>
            </div>
            <div class="flex justify-between text-xs">
              <span>Total Interest Saved:</span>
              <strong class="text-text-primary font-mono">₹5,31,750</strong>
            </div>
          </div>
          <p class="text-xs text-text-muted pt-1">
            <strong>Key Comparison:</strong> Choosing tenure reduction saves an additional <strong>₹1,13,583</strong> in interest compared to EMI reduction because the debt is liquidated 32 months earlier.
          </p>
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-strategy">
        <h2 id="loan-prepayment-strategy" class="text-xl font-bold text-text-primary mb-4">Decision guide: Tenure reduction vs. lower EMI</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted">
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-2">When to Choose Tenure Reduction</h3>
            <ul class="space-y-1.5 list-disc list-inside">
              <li>Your regular monthly salary/cash flow comfortably accommodates the current EMI.</li>
              <li>Your primary objective is minimizing total lifetime finance costs.</li>
              <li>You want to achieve debt freedom before major milestones (e.g. child education, retirement).</li>
              <li>Highest compounded interest savings over the life of the loan.</li>
            </ul>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-2">When to Choose EMI Reduction</h3>
            <ul class="space-y-1.5 list-disc list-inside">
              <li>Household monthly budget is tight, or living expenses have escalated.</li>
              <li>You are transitioning careers, starting a venture, or anticipating income variability.</li>
              <li>You want to improve your debt-to-income (DTI) ratio to qualify for other credit facilities.</li>
              <li>Provides immediate cash flow relief every single month.</li>
            </ul>
          </div>
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-assumptions">
        <h2 id="loan-prepayment-assumptions" class="text-xl font-bold text-text-primary mb-4">Assumptions & practical considerations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted">
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Prepayment Penalty Rules</h3>
            <p>Under Reserve Bank of India (RBI) regulations, banks and HFCs cannot levy foreclosure or prepayment charges on floating-rate individual home loans. However, fixed-rate loans and commercial facilities may carry penalties (2%–4%).</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Lender Processing Guidelines</h3>
            <p>Lenders frequently specify minimum prepayment thresholds (such as minimum 1 or 2 EMIs or ₹10,000–₹25,000) and may restrict the frequency of partial payments per financial year.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Tax Shield Considerations</h3>
            <p>Under the Old Tax Regime in India, Section 24(b) permits interest deduction up to ₹2,00,000 for self-occupied property. Substantially shrinking loan interest reduces this tax shield, which should be factored into net savings.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Guaranteed vs. Equity Returns</h3>
            <p>Prepaying an 8.5% loan yields a guaranteed, tax-free return of 8.5%. Compare this risk-free hurdle rate against alternative long-term investment options before deploying surplus capital.</p>
          </div>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Debating whether to prepay your home loan or invest in mutual funds?</strong>
        Read our in-depth research guide on <a href="/blog/home-loan-prepayment-vs-sip" class="text-accent font-medium hover:underline">Home Loan Prepayment vs. SIP: Which Builds More Wealth?</a> to see the 20-year net wealth math, tax impacts, and the 5-year hybrid repayment framework.
      </div>

      <section aria-labelledby="loan-prepayment-calculator-faq">
        <h2 id="loan-prepayment-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-calculator-related">
        <h2 id="loan-prepayment-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcLoanPrepayment } from '../lib/calculators/prepayment';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initLPCalc() {
    if ((window as any).__cmLpBound) return;
    (window as any).__cmLpBound = true;

    const pInput = document.getElementById('lp-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('lp-rate') as HTMLInputElement | null;
    const mInput = document.getElementById('lp-months') as HTMLInputElement | null;
    const prepayInput = document.getElementById('lp-prepay') as HTMLInputElement | null;
    const stratSelect = document.getElementById('lp-strategy') as HTMLSelectElement | null;

    const pSlider = document.getElementById('lp-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('lp-rate-slider') as HTMLInputElement | null;
    const mSlider = document.getElementById('lp-months-slider') as HTMLInputElement | null;
    const prepaySlider = document.getElementById('lp-prepay-slider') as HTMLInputElement | null;

    const resSaved = document.getElementById('lp-result-saved');
    const resCurrEmi = document.getElementById('lp-result-curremi');
    const resSavedMonths = document.getElementById('lp-result-savedmonths');
    const resNewTenure = document.getElementById('lp-result-newtenure');
    const resNewEmi = document.getElementById('lp-result-newemi');

    const errAlert = document.getElementById('lp-error-alert');
    const errMsg = document.getElementById('lp-error-msg');

    if (!pInput || !rInput || !mInput || !prepayInput) return;

    const DEFAULTS = { principal: 3000000, rate: 8.5, months: 180, prepay: 300000, strategy: 'reduce-tenure' as const };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawP = pInput!.value.replace(/[^0-9.]/g, '');
      const rawR = rInput!.value.replace(/[^0-9.]/g, '');
      const rawM = mInput!.value.replace(/[^0-9.]/g, '');
      const rawPrepay = prepayInput!.value.replace(/[^0-9.]/g, '');
      const strat = (stratSelect?.value === 'reduce-emi' ? 'reduce-emi' : 'reduce-tenure') as 'reduce-tenure' | 'reduce-emi';

      const vP = validate(rawP, { required: true, min: 10000, label: 'Principal' });
      const vR = validate(rawR, { required: true, min: 0.1, max: 30, decimal: true, label: 'Rate' });
      const vM = validate(rawM, { required: true, min: 1, max: 480, integer: true, label: 'Months' });
      const vPrepay = validate(rawPrepay, { required: true, min: 0, label: 'Prepayment' });

      if (!vP.valid) { showError(vP.error!.message); return; }
      if (!vR.valid) { showError(vR.error!.message); return; }
      if (!vM.valid) { showError(vM.error!.message); return; }
      if (!vPrepay.valid) { showError(vPrepay.error!.message); return; }

      const p = vP.value!;
      const r = vR.value!;
      const m = vM.value!;
      const prepay = vPrepay.value!;

      if (prepay >= p) {
        showError('Prepayment amount cannot exceed or equal outstanding principal balance.');
        return;
      }
      clearError();

      const res = calcLoanPrepayment(p, r, m, prepay, strat);

      setResult({
        heroValue: fmtVal(res.interestSaved),
        heroLabel: 'Total Interest Saved',
        rows: [
          { label: 'Current Monthly EMI', value: fmtVal(res.originalEMI) },
          { label: 'Tenure Saved', value: `${res.monthsSaved} months (${(res.monthsSaved / 12).toFixed(1)} yrs)` },
          { label: 'Revised Remaining Tenure', value: `${res.newMonths} months (${(res.newMonths / 12).toFixed(1)} yrs)` },
          { label: 'Revised Monthly EMI', value: fmtVal(res.newEMI) },
        ],
      });

      if (resSaved) resSaved.textContent = fmtVal(res.interestSaved);
      if (resCurrEmi) resCurrEmi.textContent = fmtVal(res.originalEMI);
      if (resSavedMonths) resSavedMonths.textContent = `${res.monthsSaved} months (${(res.monthsSaved / 12).toFixed(1)} yrs)`;
      if (resNewTenure) resNewTenure.textContent = `${res.newMonths} months (${(res.newMonths / 12).toFixed(1)} yrs)`;
      if (resNewEmi) resNewEmi.textContent = fmtVal(res.newEMI);

      serializeHash({ p, r, m, prep: prepay, s: strat });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(mSlider, mInput, false);
    sync(prepaySlider, prepayInput, true);
    stratSelect?.addEventListener('change', recalc);

    document.getElementById('lp-calculate')?.addEventListener('click', recalc);
    document.getElementById('lp-reset')?.addEventListener('click', () => {
      pInput.value = fmtLiveInput(String(DEFAULTS.principal));
      rInput.value = String(DEFAULTS.rate);
      mInput.value = String(DEFAULTS.months);
      prepayInput.value = fmtLiveInput(String(DEFAULTS.prepay));
      if (stratSelect) stratSelect.value = DEFAULTS.strategy;
      if (pSlider) {
        pSlider.value = String(DEFAULTS.principal);
        pSlider.style.setProperty('--slider-pct', `${((DEFAULTS.principal - 100000) / (20000000 - 100000)) * 100}%`);
      }
      if (rSlider) {
        rSlider.value = String(DEFAULTS.rate);
        rSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 5.0) / (20.0 - 5.0)) * 100}%`);
      }
      if (mSlider) {
        mSlider.value = String(DEFAULTS.months);
        mSlider.style.setProperty('--slider-pct', `${((DEFAULTS.months - 12) / (360 - 12)) * 100}%`);
      }
      if (prepaySlider) {
        prepaySlider.value = String(DEFAULTS.prepay);
        prepaySlider.style.setProperty('--slider-pct', `${((DEFAULTS.prepay - 10000) / (5000000 - 10000)) * 100}%`);
      }
      clearError();
      recalc();
      pInput.focus();
    });

    [pInput, rInput, mInput, prepayInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('lp-copy-btn')?.addEventListener('click', async () => {
      const rawP = pInput.value.replace(/[^0-9.]/g, '');
      const rawR = rInput.value.replace(/[^0-9.]/g, '');
      const rawM = mInput.value.replace(/[^0-9.]/g, '');
      const rawPrepay = prepayInput.value.replace(/[^0-9.]/g, '');
      const strat = (stratSelect?.value === 'reduce-emi' ? 'reduce-emi' : 'reduce-tenure') as 'reduce-tenure' | 'reduce-emi';

      const vP = validate(rawP, { required: true, min: 10000, label: 'Principal' });
      const vR = validate(rawR, { required: true, min: 0.1, label: 'Rate' });
      const vM = validate(rawM, { required: true, min: 1, label: 'Months' });
      const vPrepay = validate(rawPrepay, { required: true, min: 0, label: 'Prepayment' });

      if (!vP.valid || !vR.valid || !vM.valid || !vPrepay.valid) return;
      if (vPrepay.value! >= vP.value!) return;

      const res = calcLoanPrepayment(vP.value!, vR.value!, vM.value!, vPrepay.value!, strat);
      const text = `Loan Prepayment: Prepaying ${fmtVal(vPrepay.value!)} on ${fmtVal(vP.value!)} balance saves ${fmtVal(res.interestSaved)} interest (${res.monthsSaved} months reduced). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('lp-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('lp-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('lp-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      p: { required: true, min: 10000, label: 'p' },
      r: { required: true, min: 0.1, max: 30, decimal: true, label: 'r' },
      m: { required: true, min: 1, max: 480, integer: true, label: 'm' },
      prep: { required: true, min: 0, label: 'prep' },
    });
    if (restored.valid && restored.values.p && restored.values.r !== undefined && restored.values.m && restored.values.prep !== undefined) {
      pInput.value = fmtLiveInput(String(restored.values.p));
      rInput.value = String(restored.values.r);
      mInput.value = String(restored.values.m);
      prepayInput.value = fmtLiveInput(String(restored.values.prep));
      const hashParams = new URLSearchParams(readCurrentHash().replace(/^#/, ''));
      const s = hashParams.get('s');
      if (s === 'reduce-emi' || s === 'reduce-tenure') {
        if (stratSelect) stratSelect.value = s;
      }
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initLPCalc();
  document.addEventListener('astro:page-load', initLPCalc);
</script>
