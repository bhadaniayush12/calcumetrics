---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcLoanPrepayment } from '../lib/calculators/prepayment';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { principal: 3000000, rate: 8.5, months: 180, prepay: 300000, strategy: 'reduce-tenure' as const };
const result = calcLoanPrepayment(DEFAULT.principal, DEFAULT.rate, DEFAULT.months, DEFAULT.prepay, DEFAULT.strategy);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Loans' && t.slug !== 'loan-prepayment-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/loan-prepayment-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Loan Prepayment Calculator',
      url: canonicalUrl,
      description: 'Calculate interest saved and tenure reduction when making lump-sum or partial prepayments on your loan.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Loans', item: 'https://calcumetrics.com/loans' },
        { '@type': 'ListItem', position: 3, name: 'Loan Prepayment Calculator' },
      ],
    },
  ],
};
---

<Layout
  title="Loan Prepayment Calculator: Interest Saved & Tenure Reduced | Calcumetrics"
  description="Calculate how much interest you can save by prepaying your home or car loan. Compare tenure reduction vs lower EMI."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Loan Prepayment Calculator"
    category="Loans"
    categoryHref="/loans"
    heroValue={fmt(result.interestSaved)}
    heroLabel="Total Interest Saved"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Loan Prepayment Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Evaluate the exact interest savings and tenure reduction from making a partial loan prepayment.</p>

      <!-- Outstanding Principal -->
      <div class="mb-5">
        <Input
          id="lp-principal"
          label="Outstanding Principal Balance"
          prefix="₹"
          value="30,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Current remaining balance on your loan"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lp-principal-slider" min={100000} max={20000000} step={50000} value={3000000} ariaLabel="Principal balance slider" />
        </div>
      </div>

      <!-- Interest Rate -->
      <div class="mb-5">
        <Input
          id="lp-rate"
          label="Interest Rate"
          suffix="%"
          value="8.5"
          isNumeric={true}
          helperText="Current annual interest rate"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lp-rate-slider" min={5.0} max={20.0} step={0.25} value={8.5} ariaLabel="Interest rate slider" />
        </div>
      </div>

      <!-- Remaining Tenure in Months -->
      <div class="mb-5">
        <Input
          id="lp-months"
          label="Remaining Tenure (Months)"
          suffix="Months"
          value="180"
          isNumeric={true}
          helperText="Months remaining (180 months = 15 years)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lp-months-slider" min={12} max={360} step={6} value={180} ariaLabel="Remaining months slider" />
        </div>
      </div>

      <!-- Prepayment Amount -->
      <div class="mb-5">
        <Input
          id="lp-prepay"
          label="Prepayment Amount"
          prefix="₹"
          value="3,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Lump-sum part-payment amount"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lp-prepay-slider" min={10000} max={5000000} step={25000} value={300000} ariaLabel="Prepayment slider" />
        </div>
      </div>

      <!-- Strategy -->
      <div class="mb-6">
        <Dropdown
          id="lp-strategy"
          label="Prepayment Benefit Option"
          options={[
            { value: 'reduce-tenure', label: 'Reduce Tenure (Keep Same EMI) — Recommended' },
            { value: 'reduce-emi', label: 'Reduce Monthly EMI (Keep Same Tenure)' },
          ]}
          value="reduce-tenure"
          helperText="Reducing tenure saves significantly more interest than reducing EMI"
        />
      </div>

      <Alert variant="info" title="RBI Rule">
        Floating rate retail loans (home loans, personal loans) do not attract prepayment or foreclosure fees when paid by individual borrowers.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="lp-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="lp-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Total Interest Saved</span>
        <div id="lp-result-saved" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(result.interestSaved)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Current Monthly EMI</span>
          <span id="lp-result-curremi" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.originalEMI)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Tenure Reduced By</span>
          <span id="lp-result-savedmonths" class="text-sm font-semibold tabular-nums text-dark-accent">{result.monthsSaved} months ({(result.monthsSaved / 12).toFixed(1)} yrs)</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Remaining Tenure</span>
          <span id="lp-result-newtenure" class="text-sm font-medium tabular-nums text-dark-text">{result.newMonthsRemaining} months ({(result.newMonthsRemaining / 12).toFixed(1)} yrs)</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">New Monthly EMI</span>
          <span id="lp-result-newemi" class="text-sm font-medium tabular-nums text-dark-text">{result.newEMI ? fmt(result.newEMI) : fmt(result.originalEMI)}</span>
        </div>
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="lp-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="lp-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="loan-prepayment-calculator-how">
        <h2 id="loan-prepayment-calculator-how" class="text-xl font-bold text-text-primary mb-4">How loan prepayment savings work</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Every rupee of prepayment directly subtracts from your outstanding principal balance. Because monthly interest is calculated as a percentage of the remaining principal, shrinking the principal immediately reduces future interest compounding:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-base font-mono text-text-primary mb-2">New Principal = Outstanding Balance − Prepayment Amount</p>
          <p class="text-sm text-text-muted">
            Opting for <strong>Tenure Reduction</strong> keeps your EMI the same, allowing more of every subsequent EMI to pay off principal. This yields 2x–3x more interest savings compared to choosing a reduced monthly EMI.
          </p>
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-calculator-faq">
        <h2 id="loan-prepayment-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Should I reduce tenure or reduce EMI?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              If your monthly cash flow is comfortable, always choose <strong>Tenure Reduction</strong>. It dramatically cuts the total interest paid and frees you from debt years earlier. If you are experiencing cash flow strain, reducing EMI will free up monthly disposable income.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Is there a minimum prepayment amount?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Most banks require part-prepayments to be at least equal to one month's EMI or a minimum of ₹10,000–₹25,000. Check your specific loan agreement.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="loan-prepayment-calculator-related">
        <h2 id="loan-prepayment-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  function calcPrepayClient(p: number, rate: number, months: number, prepay: number, opt: string) {
    const r = rate / (12 * 100);
    const emi = r === 0 ? p / months : (p * r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1);
    const origInterest = emi * months - p;
    const newP = Math.max(0, p - prepay);

    if (opt === 'reduce-tenure') {
      const newMonths = r === 0 ? Math.ceil(newP / emi) : Math.ceil(-Math.log(1 - (r * newP) / emi) / Math.log(1 + r));
      const newInterest = emi * newMonths - newP;
      return {
        originalEMI: emi,
        newEMI: emi,
        originalMonths: months,
        newMonths: Math.max(0, newMonths),
        monthsSaved: Math.max(0, months - newMonths),
        interestSaved: Math.max(0, origInterest - newInterest),
      };
    } else {
      const newEMI = r === 0 ? newP / months : (newP * r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1);
      const newInterest = newEMI * months - newP;
      return {
        originalEMI: emi,
        newEMI,
        originalMonths: months,
        newMonths: months,
        monthsSaved: 0,
        interestSaved: Math.max(0, origInterest - newInterest),
      };
    }
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initLPCalc() {
    const pInput = document.getElementById('lp-principal') as HTMLInputElement | null;
    const rInput = document.getElementById('lp-rate') as HTMLInputElement | null;
    const mInput = document.getElementById('lp-months') as HTMLInputElement | null;
    const prepayInput = document.getElementById('lp-prepay') as HTMLInputElement | null;
    const stratSelect = document.getElementById('lp-strategy') as HTMLSelectElement | null;

    const pSlider = document.getElementById('lp-principal-slider') as HTMLInputElement | null;
    const rSlider = document.getElementById('lp-rate-slider') as HTMLInputElement | null;
    const mSlider = document.getElementById('lp-months-slider') as HTMLInputElement | null;
    const prepaySlider = document.getElementById('lp-prepay-slider') as HTMLInputElement | null;

    const resSaved = document.getElementById('lp-result-saved');
    const resCurrEmi = document.getElementById('lp-result-curremi');
    const resSavedMonths = document.getElementById('lp-result-savedmonths');
    const resNewTenure = document.getElementById('lp-result-newtenure');
    const resNewEmi = document.getElementById('lp-result-newemi');
    const mobileHero = document.getElementById('calc-mobile-hero');

    if (!pInput || !rInput || !mInput || !prepayInput) return;

    const DEFAULTS = { principal: 3000000, rate: 8.5, months: 180, prepay: 300000, strategy: 'reduce-tenure' };
    let timer: ReturnType<typeof setTimeout>;

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const m = parseInt(mInput.value) || 0;
      const prepay = parse(prepayInput.value);
      const strat = stratSelect ? stratSelect.value : 'reduce-tenure';

      if (p <= 0 || r <= 0 || m <= 0) return;

      const res = calcPrepayClient(p, r, m, prepay, strat);

      if (resSaved) resSaved.textContent = fmtVal(res.interestSaved);
      if (resCurrEmi) resCurrEmi.textContent = fmtVal(res.originalEMI);
      if (resSavedMonths) resSavedMonths.textContent = `${res.monthsSaved} months (${(res.monthsSaved / 12).toFixed(1)} yrs)`;
      if (resNewTenure) resNewTenure.textContent = `${res.newMonths} months (${(res.newMonths / 12).toFixed(1)} yrs)`;
      if (resNewEmi) resNewEmi.textContent = fmtVal(res.newEMI);
      if (mobileHero) mobileHero.textContent = fmtVal(res.interestSaved);

      history.replaceState(null, '', `#p=${p}&r=${r}&m=${m}&prep=${prepay}&s=${strat}`);
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(pSlider, pInput, true);
    sync(rSlider, rInput, false);
    sync(mSlider, mInput, false);
    sync(prepaySlider, prepayInput, true);
    stratSelect?.addEventListener('change', recalc);

    document.getElementById('lp-calculate')?.addEventListener('click', recalc);
    document.getElementById('lp-reset')?.addEventListener('click', () => {
      pInput.value = fmtLiveInput(String(DEFAULTS.principal));
      rInput.value = String(DEFAULTS.rate);
      mInput.value = String(DEFAULTS.months);
      prepayInput.value = fmtLiveInput(String(DEFAULTS.prepay));
      if (stratSelect) stratSelect.value = DEFAULTS.strategy;
      if (pSlider) pSlider.value = String(DEFAULTS.principal);
      if (rSlider) rSlider.value = String(DEFAULTS.rate);
      if (mSlider) mSlider.value = String(DEFAULTS.months);
      if (prepaySlider) prepaySlider.value = String(DEFAULTS.prepay);
      recalc();
      pInput.focus();
    });

    [pInput, rInput, mInput, prepayInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('lp-copy-btn')?.addEventListener('click', async () => {
      const p = parse(pInput.value);
      const r = parseFloat(rInput.value) || 0;
      const m = parseInt(mInput.value) || 0;
      const prepay = parse(prepayInput.value);
      const strat = stratSelect ? stratSelect.value : 'reduce-tenure';
      const res = calcPrepayClient(p, r, m, prepay, strat);
      const text = `Loan Prepayment: Prepaying ${fmtVal(prepay)} on ${fmtVal(p)} balance saves ${fmtVal(res.interestSaved)} interest (${res.monthsSaved} months reduced). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('lp-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('lp-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('lp-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
  }

  initLPCalc();
  document.addEventListener('astro:page-load', initLPCalc);
</script>
