---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcMarkupMargin, markupToMargin, marginToMarkup } from '../lib/calculators/business';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { cost: 1000, markup: 25 };
const result = calcMarkupMargin(DEFAULT.cost, DEFAULT.markup);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const relatedSlugs = ['profit-margin-calculator', 'break-even-calculator', 'cogs-calculator'];
const related = TOOLS.filter((t) => relatedSlugs.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/markup-vs-margin-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Markup vs Margin Calculator',
      url: canonicalUrl,
      description: 'Free markup vs margin calculator to calculate markup percentages, convert between margin and markup, and determine optimal pricing.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'Markup vs Margin Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the fundamental difference between markup and margin?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Markup represents the percentage added on top of unit cost to determine the selling price. Gross margin represents the percentage of the selling price retained as profit after covering costs.',
          },
        },
        {
          '@type': 'Question',
          name: 'What markup is needed for a 50% margin?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'To achieve a 50% gross margin, you must apply a 100% markup to your cost (i.e. doubling the cost). For example, an item costing ₹500 marked up 100% sells for ₹1,000, yielding ₹500 profit (50% of the ₹1,000 selling price).',
          },
        },
        {
          '@type': 'Question',
          name: 'Can margin ever exceed 100%?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Gross margin cannot exceed 100% unless cost is negative. However, markup can exceed 100% indefinitely (e.g. 200%, 500%, or 1000% markup on low-cost digital goods or luxury items).',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I convert markup percentage directly to margin percentage?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Use the standard formula: Margin % = [Markup % / (100 + Markup %)] × 100. For instance, a 25% markup equals (25 / 125) × 100 = 20% margin.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why does confusing markup and margin lead to business losses?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If a business with 30% overhead costs marks up goods by 30% thinking it achieves a 30% margin, it only gets a 23.1% margin. The shortfall of nearly 7% directly produces operating losses.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Markup vs Margin Calculator: Convert Between Both | Calcumetrics"
  description="Free markup vs margin calculator. Calculate markup percentage and profit margin, convert between margin and markup, and find optimal selling prices."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Markup vs Margin Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(result.sellingPrice)}
    heroLabel="Recommended Selling Price"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Markup vs Margin Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Convert between markup % (on cost) and margin % (on price) to protect your profitability.</p>

      <!-- Error alert -->
      <div id="mvm-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="mvm-error-msg"></span>
      </div>

      <!-- Cost -->
      <div class="mb-5">
        <Input
          id="mvm-cost"
          label="Unit Cost (COGS)"
          prefix="₹"
          value="1,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Direct purchase or production cost per unit"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mvm-cost-slider" min={50} max={100000} step={50} value={1000} ariaLabel="Unit cost slider" />
        </div>
      </div>

      <!-- Calculation Mode -->
      <div class="mb-5">
        <Dropdown
          id="mvm-mode"
          label="Calculate By"
          options={[
            { value: 'markup', label: 'Markup Percentage (added onto cost)' },
            { value: 'margin', label: 'Target Gross Margin Percentage (of final price)' },
          ]}
          value="markup"
          helperText="Choose which pricing metric you want to specify"
        />
      </div>

      <!-- Percentage Value -->
      <div class="mb-6">
        <Input
          id="mvm-rate"
          label="Percentage (%)"
          suffix="%"
          value="25"
          isNumeric={true}
          helperText="Enter markup or target margin %"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mvm-rate-slider" min={1} max={200} step={0.5} value={25} ariaLabel="Rate percentage slider" />
        </div>
      </div>

      <Alert variant="info" title="Key Distinction">
        <strong>Markup</strong> is the % added to cost. <strong>Margin</strong> is the % of selling price that is profit. A 100% markup equals a 50% profit margin!
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="mvm-calculate" type="button">Compare Markup vs Margin</Button>
        <Button variant="ghost" id="mvm-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Recommended Selling Price</span>
        <div id="mvm-result-price" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.sellingPrice)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Unit Cost</span>
          <span id="mvm-result-cost" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.cost)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Profit per Unit</span>
          <span id="mvm-result-profit" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.profit)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Markup on Cost</span>
          <span id="mvm-result-markup" class="text-sm font-medium tabular-nums text-dark-text">{result.markupPct.toFixed(1)}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Gross Margin on Price</span>
          <span id="mvm-result-margin" class="text-sm font-bold tabular-nums text-dark-text">{result.marginPct.toFixed(1)}%</span>
        </div>
      </div>

      <div class="mb-5" id="mvm-composition-wrapper">
        <CompositionBar
          principalFraction={result.sellingPrice > 0 ? DEFAULT.cost / result.sellingPrice : 1}
          gainFraction={result.sellingPrice > 0 ? result.profit / result.sellingPrice : 0}
          principalLabel="Cost"
          gainLabel="Profit"
          principalValue={fmt(DEFAULT.cost)}
          gainValue={fmt(result.profit)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="mvm-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="mvm-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Avoid pricing errors: Never confuse markup % with margin %.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="mvm-calculator-how">
        <h2 id="mvm-calculator-how" class="text-xl font-bold text-text-primary mb-4">How to convert between markup and margin</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            While both markup and profit margin evaluate commercial profitability, they measure financial return against completely different financial bases: <strong>markup</strong> benchmarks profit against unit cost, whereas <strong>gross margin</strong> benchmarks profit against final selling price.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono mb-4">
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Markup Percentage (On Cost)</span>
              <span class="text-text-muted">Markup % = (Profit ÷ Cost) × 100</span><br />
              <span class="text-accent font-semibold">Markup % = [(Selling Price − Cost) ÷ Cost] × 100</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Gross Margin Percentage (On Selling Price)</span>
              <span class="text-text-muted">Margin % = (Profit ÷ Selling Price) × 100</span><br />
              <span class="text-accent font-semibold">Margin % = [(Selling Price − Cost) ÷ Selling Price] × 100</span>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Convert Markup to Margin</span>
              <span class="text-text-primary font-semibold">Margin % = [Markup % ÷ (100 + Markup %)] × 100</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Convert Margin to Markup</span>
              <span class="text-text-primary font-semibold">Markup % = [Margin % ÷ (100 − Margin %)] × 100</span>
            </div>
          </div>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Quick Reference Conversion Table</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Because selling price is always larger than cost for profitable goods, <strong>margin percentage is mathematically always lower than markup percentage</strong>.
        </p>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="py-3 px-4">Markup on Cost</th>
                <th class="py-3 px-4">Equivalent Gross Margin</th>
                <th class="py-3 px-4">Pricing Multiplier</th>
                <th class="py-3 px-4">Example (Cost = ₹1,000)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">10.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">9.09%</td>
                <td class="py-2.5 px-4 font-mono">1.10×</td>
                <td class="py-2.5 px-4">Sells for ₹1,100 (Profit: ₹100)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">15.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">13.04%</td>
                <td class="py-2.5 px-4 font-mono">1.15×</td>
                <td class="py-2.5 px-4">Sells for ₹1,150 (Profit: ₹150)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">20.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">16.67%</td>
                <td class="py-2.5 px-4 font-mono">1.20×</td>
                <td class="py-2.5 px-4">Sells for ₹1,200 (Profit: ₹200)</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 font-mono text-text-primary">25.0% (Default)</td>
                <td class="py-2.5 px-4 font-mono text-accent">20.00%</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">1.25×</td>
                <td class="py-2.5 px-4 text-text-primary">Sells for ₹1,250 (Profit: ₹250)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">33.33%</td>
                <td class="py-2.5 px-4 font-mono text-accent">25.00%</td>
                <td class="py-2.5 px-4 font-mono">1.33×</td>
                <td class="py-2.5 px-4">Sells for ₹1,333 (Profit: ₹333)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">50.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">33.33%</td>
                <td class="py-2.5 px-4 font-mono">1.50×</td>
                <td class="py-2.5 px-4">Sells for ₹1,500 (Profit: ₹500)</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 font-mono text-text-primary">100.0% (Keystone)</td>
                <td class="py-2.5 px-4 font-mono text-accent">50.00%</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">2.00×</td>
                <td class="py-2.5 px-4 text-text-primary">Sells for ₹2,000 (Profit: ₹1,000)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">200.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">66.67%</td>
                <td class="py-2.5 px-4 font-mono">3.00×</td>
                <td class="py-2.5 px-4">Sells for ₹3,000 (Profit: ₹2,000)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">300.0%</td>
                <td class="py-2.5 px-4 font-mono text-accent">75.00%</td>
                <td class="py-2.5 px-4 font-mono">4.00×</td>
                <td class="py-2.5 px-4">Sells for ₹4,000 (Profit: ₹3,000)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-step worked examples</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h4 class="text-sm font-bold text-text-primary mb-2">Scenario A: Cost-Plus Pricing (Markup Mode)</h4>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              A manufacturer produces a consumer electronic accessory with unit direct cost of <strong>₹1,000</strong> and applies a standard <strong>25% markup</strong>:
            </p>
            <ol class="text-xs text-text-muted space-y-1 list-decimal pl-4 font-mono">
              <li>Selling Price = Cost × (1 + Markup ÷ 100) = ₹1,000 × 1.25 = <strong class="text-text-primary">₹1,250</strong></li>
              <li>Unit Gross Profit = ₹1,250 − ₹1,000 = <strong class="text-accent">₹250</strong></li>
              <li>Gross Profit Margin = (₹250 ÷ ₹1,250) × 100 = <strong class="text-accent">20.0%</strong></li>
            </ol>
            <p class="text-xs text-text-muted mt-2">
              Note: The 25% markup produces only a 20% margin because the ₹250 profit is measured against the ₹1,250 retail price.
            </p>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h4 class="text-sm font-bold text-text-primary mb-2">Scenario B: Target Gross Margin Pricing (Margin Mode)</h4>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              A boutique retailer procures artisanal merchandise at wholesale unit cost of <strong>₹1,200</strong> and requires a strict <strong>40% gross margin</strong> to cover boutique rent and overhead:
            </p>
            <ol class="text-xs text-text-muted space-y-1 list-decimal pl-4 font-mono">
              <li>Selling Price = Cost ÷ (1 − Margin ÷ 100) = ₹1,200 ÷ 0.60 = <strong class="text-text-primary">₹2,000</strong></li>
              <li>Unit Gross Profit = ₹2,000 − ₹1,200 = <strong class="text-accent">₹800</strong></li>
              <li>Required Markup = (₹800 ÷ ₹1,200) × 100 = <strong class="text-accent">66.67%</strong></li>
            </ol>
            <p class="text-xs text-text-muted mt-2">
              If the manager had mistakenly added a 40% markup instead of a 40% margin, the price would be ₹1,680, generating only ₹480 profit (28.6% margin) and causing severe budget shortfalls.
            </p>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">The "Overhead Trap": Why Confusing Terms Causes Involuntary Losses</h3>
          <p class="text-xs text-text-muted leading-relaxed mb-3">
            One of the most frequent small business accounting mistakes is matching operating overhead percentages against product markup.
          </p>
          <div class="bg-canvas border border-border rounded p-3 text-xs text-text-muted leading-relaxed">
            <p class="mb-1">
              Suppose a business incurs <strong>20% operational overhead</strong> (rent, staff salaries, marketing, and utilities expressed as 20% of revenue). The business owner decides to apply a <strong>20% markup</strong> to all inventory, believing the business will break even.
            </p>
            <p class="font-mono text-text-primary mb-1">
              Product Cost = ₹100 → Price with 20% markup = ₹120. Gross Profit = ₹20.<br />
              Actual Gross Margin = ₹20 ÷ ₹120 = 16.67%.<br />
              Operating Expenses per unit = 20% of ₹120 = ₹24.00.<br />
              Net Bottom Line = ₹20.00 − ₹24.00 = <strong class="text-error">−₹4.00 Loss per unit sold</strong>.
            </p>
            <p class="text-accent">
              To genuinely cover a 20% overhead requirement, the business requires a 20% margin, which requires a <strong>25% markup</strong> (Selling Price: ₹125, Profit: ₹25, Overhead: ₹25, Net: ₹0).
            </p>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions & Pricing Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Pre-Tax Transaction Modeling:</strong> Computations model unit direct cost and net price excluding sales tax, value-added tax (VAT), or Goods and Services Tax (GST). Taxes collected from customers must not be counted as markup or margin.</li>
            <li><strong>Exclusion of Indirect Operating Overheads:</strong> Gross margin only accounts for direct cost of goods sold (COGS). Total enterprise profitability requires subtracting all sales, general, and administrative (SG&A) overhead.</li>
            <li><strong>Zero Price Elasticity Consideration:</strong> This calculator converts between mathematical rates; it does not predict whether consumer demand will soften at higher recommended selling prices.</li>
            <li><strong>Inventory Holding Cost & Shrinkage:</strong> Realized gross margins are typically 2% to 5% lower than initial target margins due to clearance markdowns, customer returns, breakage, and warehouse spoilage.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Pricing your products or setting up e-commerce margins?</strong>
        Read our in-depth commercial pricing guide on <a href="/blog/markup-vs-margin" class="text-accent font-medium hover:underline">Markup vs. Margin: The Math Mistake That Silently Erases Business Profits</a> to see worked e-commerce overhead schedules and algebraic conversion proofs.
      </div>

      <section aria-labelledby="mvm-calculator-faq">
        <h2 id="mvm-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="mvm-calculator-related">
        <h2 id="mvm-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcMarkupMargin } from '../lib/calculators/business';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initMVMCalc() {
    if ((window as any).__cmMvmBound) return;
    (window as any).__cmMvmBound = true;

    const costInput = document.getElementById('mvm-cost') as HTMLInputElement | null;
    const modeSelect = document.getElementById('mvm-mode') as HTMLSelectElement | null;
    const rateInput = document.getElementById('mvm-rate') as HTMLInputElement | null;

    const costSlider = document.getElementById('mvm-cost-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('mvm-rate-slider') as HTMLInputElement | null;

    const resPrice = document.getElementById('mvm-result-price');
    const resCost = document.getElementById('mvm-result-cost');
    const resProfit = document.getElementById('mvm-result-profit');
    const resMarkup = document.getElementById('mvm-result-markup');
    const resMargin = document.getElementById('mvm-result-margin');

    const errAlert = document.getElementById('mvm-error-alert');
    const errMsg = document.getElementById('mvm-error-msg');

    if (!costInput || !rateInput) return;

    const DEFAULTS = { cost: 1000, rate: 25, mode: 'markup' };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawCost = costInput!.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput!.value.replace(/[^0-9.]/g, '');
      const mode = (modeSelect ? modeSelect.value : 'markup') as 'markup' | 'margin';

      const vCost = validate(rawCost, { required: true, min: 1, label: 'Unit Cost' });
      const maxRate = mode === 'margin' ? 99.9 : 10000;
      const vRate = validate(rawRate, { required: true, min: 0.1, max: maxRate, label: mode === 'margin' ? 'Margin Percentage' : 'Markup Percentage' });

      if (!vCost.valid) { showError(vCost.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      clearError();

      const cost = vCost.value!;
      const rate = vRate.value!;

      let resSellingPrice = 0;
      let resProfitVal = 0;
      let resMarkupPct = 0;
      let resMarginPct = 0;

      if (mode === 'markup') {
        const res = calcMarkupMargin(cost, rate);
        resSellingPrice = res.sellingPrice;
        resProfitVal = res.profit;
        resMarkupPct = res.markupPct;
        resMarginPct = res.marginPct;
      } else {
        const marginPct = Math.min(rate, 99.99);
        resSellingPrice = cost / (1 - marginPct / 100);
        resProfitVal = resSellingPrice - cost;
        resMarkupPct = cost > 0 ? (resProfitVal / cost) * 100 : 0;
        resMarginPct = marginPct;
      }

      setResult({
        heroValue: fmtVal(resSellingPrice),
        heroLabel: 'Recommended Selling Price',
        rows: [
          { label: 'Unit Cost', value: fmtVal(cost) },
          { label: 'Gross Profit per Unit', value: fmtVal(resProfitVal) },
          { label: 'Markup on Cost', value: `${resMarkupPct.toFixed(1)}%` },
          { label: 'Gross Margin on Price', value: `${resMarginPct.toFixed(1)}%` },
        ],
      });

      if (resPrice) resPrice.textContent = fmtVal(resSellingPrice);
      if (resCost) resCost.textContent = fmtVal(cost);
      if (resProfit) resProfit.textContent = fmtVal(resProfitVal);
      if (resMarkup) resMarkup.textContent = `${resMarkupPct.toFixed(1)}%`;
      if (resMargin) resMargin.textContent = `${resMarginPct.toFixed(1)}%`;

      const wrapper = document.getElementById('mvm-composition-wrapper');
      if (wrapper && resSellingPrice > 0) {
        const costFrac = Math.min(1, cost / resSellingPrice);
        const profitFrac = Math.min(1, resProfitVal / resSellingPrice);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(costFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(profitFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(cost);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(resProfitVal);
      }

      serializeHash({ c: cost, r: rate, m: mode });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(costSlider, costInput, true);
    sync(rateSlider, rateInput, false);
    modeSelect?.addEventListener('change', () => {
      const mode = modeSelect.value;
      if (rateSlider) {
        rateSlider.max = mode === 'margin' ? '95' : '200';
      }
      recalc();
    });

    document.getElementById('mvm-calculate')?.addEventListener('click', recalc);
    document.getElementById('mvm-reset')?.addEventListener('click', () => {
      costInput.value = fmtLiveInput(String(DEFAULTS.cost));
      rateInput.value = String(DEFAULTS.rate);
      if (modeSelect) modeSelect.value = DEFAULTS.mode;

      if (costSlider) {
        costSlider.value = String(DEFAULTS.cost);
        costSlider.style.setProperty('--slider-pct', `${((DEFAULTS.cost - 50) / (100000 - 50)) * 100}%`);
      }
      if (rateSlider) {
        rateSlider.max = '200';
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 1) / (200 - 1)) * 100}%`);
      }

      clearError();
      recalc();
      costInput.focus();
    });

    [costInput, rateInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('mvm-copy-btn')?.addEventListener('click', async () => {
      const rawCost = costInput.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput.value.replace(/[^0-9.]/g, '');
      const mode = (modeSelect ? modeSelect.value : 'markup') as any;
      const vCost = validate(rawCost, { required: true, min: 1, label: 'Unit Cost' });
      const vRate = validate(rawRate, { required: true, min: 0.1, label: 'Rate' });
      if (!vCost.valid || !vRate.valid) return;

      const cost = vCost.value!;
      const rate = vRate.value!;
      let price = 0;
      let profit = 0;
      if (mode === 'markup') {
        const res = calcMarkupMargin(cost, rate);
        price = res.sellingPrice;
        profit = res.profit;
      } else {
        price = cost / (1 - Math.min(rate, 99.99) / 100);
        profit = price - cost;
      }
      const text = `Markup vs Margin: Cost ${fmtVal(cost)} => Selling Price: ${fmtVal(price)} (Profit: ${fmtVal(profit)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('mvm-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('mvm-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('mvm-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      c: { required: true, min: 1, label: 'c' },
      r: { required: true, min: 0.1, label: 'r' },
      m: { required: false, label: 'm' },
    });
    if (restored.valid && restored.values.c && restored.values.r) {
      costInput.value = fmtLiveInput(String(restored.values.c));
      rateInput.value = String(restored.values.r);
      if (restored.values.m && modeSelect && (restored.values.m === 'markup' || restored.values.m === 'margin')) {
        modeSelect.value = restored.values.m;
      }
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initMVMCalc();
  document.addEventListener('astro:page-load', initMVMCalc);
</script>
