---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { TOOLS } from '../config/site';

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'markup-vs-margin-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/markup-vs-margin-calculator' as string;
const jsonld = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebApplication', name: 'Markup vs Margin Calculator', url: canonicalUrl, description: 'Understand and convert between markup percentage and gross profit margin. These are related but different concepts that cause frequent confusion in pricing.', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, inLanguage: 'en', dateModified: '2026-09-20', publisher: { '@id': 'https://calcumetrics.com/#org' } }, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' }, { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' }, { '@type': 'ListItem', position: 3, name: 'Markup vs Margin Calculator' }] }] };
---
<Layout title="Markup vs Margin Calculator: Convert Between Both | Calcumetrics" description="Understand and convert between markup percentage and gross profit margin. These are related but different concepts that cause frequent confusion in pricing." canonical={canonicalUrl}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>
  <CalculatorLayout toolName="Markup vs Margin Calculator" category="Business" categoryHref="/business" heroValue="Calculate to see" heroLabel="Selling Price">
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Markup vs Margin Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Understand and convert between markup percentage and gross profit margin. These are related but different concepts that cause frequent confusion in pricing.</p>
      <Alert variant="info" title="Assumption">Results are estimates for information only. Not financial advice.</Alert>
      <div class="flex gap-3 mt-6"><Button variant="primary" type="button">Calculate</Button><Button variant="ghost" type="button">Reset</Button></div>
    </Fragment>
    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Selling Price</span>
        <div class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">Calculate to see</div>
      </div>
      <p class="text-xs text-dark-muted mt-4 leading-relaxed">For information only. Not financial advice. Results are estimates.</p>
    </Fragment>
    <Fragment slot="below">
      <section aria-labelledby="markup-vs-margin-calculator-how">
        <h2 id="markup-vs-margin-calculator-how" class="text-xl font-bold text-text-primary mb-4">How this calculator works</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Understand and convert between markup percentage and gross profit margin. These are related but different concepts that cause frequent confusion in pricing.</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">Markup % = profit / cost × 100. Margin % = profit / price × 100. Convert: margin = markup / (1 + markup/100) × 100; markup = margin / (1 − margin/100) × 100.</p>
        </div>
      </section>
      <section aria-labelledby="markup-vs-margin-calculator-faq">
        <h2 id="markup-vs-margin-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is the difference between markup and margin?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Markup is calculated as a percentage of cost (how much you add on top of what you paid). Margin is calculated as a percentage of selling price (how much of each sale is profit). A 50% markup gives a 33% margin. A 50% margin requires a 100% markup. Confusing the two leads to significant underpricing.</div></details>
          <details class="border border-border rounded-card overflow-hidden"><summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Why do retailers use markup while analysts use margin?</summary><div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">Retailers traditionally use markup because they start with a known cost and add a percentage to set the price. Analysts prefer margin because it expresses profitability as a share of revenue, which is standard in income statement analysis. Both are valid; the key is knowing which you are using.</div></details>
        </div>
      </section>
      <section aria-labelledby="markup-vs-margin-calculator-related">
        <h2 id="markup-vs-margin-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>
