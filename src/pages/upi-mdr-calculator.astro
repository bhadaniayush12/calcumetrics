---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcUPIMDR } from '../lib/calculators/upi-mdr';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = {
  monthlyVolume: 500000,
  ticketSize: 1500,
  chargeableShare: 20,
  mdrRate: 1.1,
  gstRate: 18,
};

const result = calcUPIMDR(
  DEFAULT.monthlyVolume,
  DEFAULT.ticketSize,
  DEFAULT.chargeableShare,
  DEFAULT.mdrRate,
  DEFAULT.gstRate
);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'upi-mdr-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/upi-mdr-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'UPI MDR Calculator',
      url: canonicalUrl,
      description: 'Calculate UPI merchant fees, interchange rates on PPI wallets and RuPay credit cards on UPI, GST deductions, and net bank settlement.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'UPI MDR Calculator' },
      ],
    },
  ],
};
---

<Layout
  title="UPI MDR Calculator: Merchant Discount Rates & GST Settlement | Calcumetrics"
  description="Calculate UPI merchant fees, interchange rates on PPI wallets and RuPay credit cards on UPI, GST deductions, and net bank settlement."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="UPI MDR Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(result.netSettlement)}
    heroLabel="Net Merchant Settlement"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">UPI MDR Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate interchange fees, 18% GST, and net merchant payouts on UPI and RuPay credit transactions.</p>

      <!-- Monthly Volume -->
      <div class="mb-5">
        <Input
          id="mdr-volume"
          label="Total Monthly UPI Volume"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross value of UPI merchant transactions processed monthly"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mdr-volume-slider" min={25000} max={5000000} step={25000} value={500000} ariaLabel="Monthly volume slider" />
        </div>
      </div>

      <!-- Chargeable Share % -->
      <div class="mb-5">
        <Input
          id="mdr-share"
          label="Chargeable Volume Share (PPI &amp; RuPay Credit &gt; ₹2,000)"
          suffix="%"
          value="20"
          isNumeric={true}
          helperText="Standard bank-to-bank UPI has 0% MDR. PPI wallets and RuPay Credit have interchange fees."
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mdr-share-slider" min={0} max={100} step={5} value={20} ariaLabel="Chargeable share slider" />
        </div>
      </div>

      <!-- MDR Rate % -->
      <div class="mb-5">
        <Input
          id="mdr-rate"
          label="Interchange / MDR Rate"
          suffix="%"
          value="1.1"
          isNumeric={true}
          helperText="Standard NPCI interchange cap is 1.1% on transactions above ₹2,000"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mdr-rate-slider" min={0.5} max={2.5} step={0.05} value={1.1} ariaLabel="MDR rate slider" />
        </div>
      </div>

      <!-- GST on MDR -->
      <div class="mb-6">
        <Input
          id="mdr-gst"
          label="GST on Processing Fee"
          suffix="%"
          value="18"
          isNumeric={true}
          helperText="Standard 18% GST applied on merchant financial services"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="mdr-gst-slider" min={0} max={28} step={1} value={18} ariaLabel="GST rate slider" />
        </div>
      </div>

      <Alert variant="info" title="Zero MDR on Peer-to-Merchant (P2M)">
        Normal UPI payments from customer savings bank accounts to merchant QR codes continue to have <strong>0% MDR</strong> under Indian government regulations.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="mdr-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="mdr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Net Merchant Settlement</span>
        <div id="mdr-result-settlement" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {fmt(result.netSettlement)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Deductions (Fee + GST)</span>
          <span id="mdr-result-deductions" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.totalDeductions)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Base Interchange Fee</span>
          <span id="mdr-result-basefee" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.baseMdrFee)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">GST on Fee (18%)</span>
          <span id="mdr-result-gstamt" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.gstAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Effective Blended Fee Rate</span>
          <span id="mdr-result-effective" class="text-sm font-bold tabular-nums text-dark-text">{result.effectiveRatePct.toFixed(3)}%</span>
        </div>
      </div>

      <div class="mb-5" id="mdr-composition-wrapper">
        <CompositionBar
          principalFraction={result.netSettlement / DEFAULT.monthlyVolume}
          gainFraction={result.totalDeductions / DEFAULT.monthlyVolume}
          principalLabel="Net Settlement"
          gainLabel="MDR &amp; GST"
          principalValue={fmt(result.netSettlement)}
          gainValue={fmt(result.totalDeductions)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="mdr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="mdr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">NPCI guidelines: Zero surcharge can be passed onto consumers.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="mdr-calculator-how">
        <h2 id="mdr-calculator-how" class="text-xl font-bold text-text-primary mb-4">How UPI MDR works for businesses</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          While direct bank-account-to-bank-account UPI payments have zero MDR, the NPCI introduced interchange pricing on merchant transactions initiated via Prepaid Payment Instruments (wallets) and RuPay credit cards:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed">
            <strong>Chargeable Volume = </strong> Monthly Volume &times; (Chargeable Share % &divide; 100)<br />
            <strong>Base MDR Fee = </strong> Chargeable Volume &times; (MDR % &divide; 100)<br />
            <strong>GST Amount = </strong> Base MDR Fee &times; 18%<br />
            <strong>Net Payout = </strong> Total Monthly Volume &minus; (Base MDR + GST)
          </p>
        </div>
      </section>

      <section aria-labelledby="mdr-calculator-faq">
        <h2 id="mdr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Does a customer ever pay MDR on UPI?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              No. Customers are never charged any fee or surcharge for paying via UPI, RuPay credit cards, or digital wallets. The interchange fee is absorbed strictly by the merchant and deducted by the acquiring payment aggregator.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can businesses claim Input Tax Credit (ITC) on the 18% GST?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes. If your business has an active GST registration, you can claim the 18% GST charged on MDR fees as Input Tax Credit (ITC) on your monthly GSTR-3B filings to offset output tax liabilities.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="mdr-calculator-related">
        <h2 id="mdr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  function calcUPIMDRClient(vol: number, sharePct: number, mdrPct: number, gstPct: number) {
    const chargeableVol = vol * (Math.min(100, Math.max(0, sharePct)) / 100);
    const baseFee = chargeableVol * (mdrPct / 100);
    const gstAmt = baseFee * (gstPct / 100);
    const deductions = baseFee + gstAmt;
    const settlement = Math.max(0, vol - deductions);
    const effRate = vol > 0 ? (deductions / vol) * 100 : 0;
    return {
      chargeableVol,
      baseFee,
      gstAmt,
      deductions,
      settlement,
      effRate,
      setFrac: vol > 0 ? settlement / vol : 1,
      dedFrac: vol > 0 ? deductions / vol : 0,
    };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initMDRCalc() {
    const volInput = document.getElementById('mdr-volume') as HTMLInputElement | null;
    const shareInput = document.getElementById('mdr-share') as HTMLInputElement | null;
    const rateInput = document.getElementById('mdr-rate') as HTMLInputElement | null;
    const gstInput = document.getElementById('mdr-gst') as HTMLInputElement | null;

    const volSlider = document.getElementById('mdr-volume-slider') as HTMLInputElement | null;
    const shareSlider = document.getElementById('mdr-share-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('mdr-rate-slider') as HTMLInputElement | null;
    const gstSlider = document.getElementById('mdr-gst-slider') as HTMLInputElement | null;

    const resSettlement = document.getElementById('mdr-result-settlement');
    const resDeductions = document.getElementById('mdr-result-deductions');
    const resBaseFee = document.getElementById('mdr-result-basefee');
    const resGstAmt = document.getElementById('mdr-result-gstamt');
    const resEffRate = document.getElementById('mdr-result-effective');
    const mobileHero = document.getElementById('calc-mobile-hero');

    if (!volInput || !shareInput) return;

    const DEFAULTS = { vol: 500000, share: 20, rate: 1.1, gst: 18 };
    let timer: ReturnType<typeof setTimeout>;

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const vol = parse(volInput.value);
      const share = parseFloat(shareInput.value) || 0;
      const rate = parseFloat(rateInput ? rateInput.value : '1.1') || 1.1;
      const gst = parseFloat(gstInput ? gstInput.value : '18') || 18;

      if (vol <= 0) return;

      const res = calcUPIMDRClient(vol, share, rate, gst);

      if (resSettlement) resSettlement.textContent = fmtVal(res.settlement);
      if (resDeductions) resDeductions.textContent = fmtVal(res.deductions);
      if (resBaseFee) resBaseFee.textContent = fmtVal(res.baseFee);
      if (resGstAmt) resGstAmt.textContent = fmtVal(res.gstAmt);
      if (resEffRate) resEffRate.textContent = res.effRate.toFixed(3) + '%';
      if (mobileHero) mobileHero.textContent = fmtVal(res.settlement);

      const wrapper = document.getElementById('mdr-composition-wrapper');
      if (wrapper && vol > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(res.setFrac * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(res.dedFrac * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.settlement);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.deductions);
      }

      history.replaceState(null, '', `#v=${vol}&s=${share}&r=${rate}&g=${gst}`);
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(volSlider, volInput, true);
    sync(shareSlider, shareInput, false);
    sync(rateSlider, rateInput!, false);
    sync(gstSlider, gstInput!, false);

    document.getElementById('mdr-calculate')?.addEventListener('click', recalc);
    document.getElementById('mdr-reset')?.addEventListener('click', () => {
      volInput.value = fmtLiveInput(String(DEFAULTS.vol));
      shareInput.value = String(DEFAULTS.share);
      if (rateInput) rateInput.value = String(DEFAULTS.rate);
      if (gstInput) gstInput.value = String(DEFAULTS.gst);

      if (volSlider) {
        volSlider.value = String(DEFAULTS.vol);
        volSlider.style.setProperty('--slider-pct', `${((DEFAULTS.vol - 25000) / (5000000 - 25000)) * 100}%`);
      }
      if (shareSlider) {
        shareSlider.value = String(DEFAULTS.share);
        shareSlider.style.setProperty('--slider-pct', `${DEFAULTS.share}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 0.5) / (2.5 - 0.5)) * 100}%`);
      }
      if (gstSlider) {
        gstSlider.value = String(DEFAULTS.gst);
        gstSlider.style.setProperty('--slider-pct', `${(DEFAULTS.gst / 28) * 100}%`);
      }

      recalc();
      volInput.focus();
    });

    [volInput, shareInput, rateInput, gstInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('mdr-copy-btn')?.addEventListener('click', async () => {
      const vol = parse(volInput.value);
      const share = parseFloat(shareInput.value) || 0;
      const rate = parseFloat(rateInput ? rateInput.value : '1.1') || 1.1;
      const gst = parseFloat(gstInput ? gstInput.value : '18') || 18;
      const res = calcUPIMDRClient(vol, share, rate, gst);
      const text = `UPI MDR: Volume ${fmtVal(vol)} (${share}% chargeable at ${rate}%) => Fee+GST: ${fmtVal(res.deductions)}, Net Settlement: ${fmtVal(res.settlement)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('mdr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('mdr-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('mdr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initMDRCalc();
  document.addEventListener('astro:page-load', initMDRCalc);
</script>
