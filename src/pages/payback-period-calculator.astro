---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcPayback } from '../lib/calculators/corporate';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { initial: 500000, annual: 150000 };
const result = calcPayback(DEFAULT.initial, [DEFAULT.annual, DEFAULT.annual, DEFAULT.annual, DEFAULT.annual, DEFAULT.annual]);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const RELATED_SLUGS = ['discounted-payback-period-calculator', 'npv-calculator', 'roi-calculator'];
const related = TOOLS.filter((t) => RELATED_SLUGS.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/payback-period-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Payback Period Calculator',
      url: canonicalUrl,
      description: 'Free payback period calculator. Apply the formula for payback period to calculate capital recovery time and investment breakeven.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Corporate Finance', item: 'https://calcumetrics.com/corporate-finance' },
        { '@type': 'ListItem', position: 3, name: 'Payback Period Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is a good payback period for equipment or software?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Industrial machinery usually has acceptable payback periods between 3 to 5 years. Enterprise software, tooling, or marketing automation projects generally aim for a payback period of under 18 to 24 months due to fast technological shifts.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is discounted payback period?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The discounted payback period discounts future cash flows at the company\'s cost of capital before calculating the recovery time. Because discounted dollars have lower present values, the discounted payback period is always longer than the simple payback period.',
          },
        },
        {
          '@type': 'Question',
          name: 'What are the limitations of the payback period?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The payback period ignores (1) the time value of money, (2) all cash flows after the break-even point, and (3) risk. It should be used alongside NPV, IRR, or the discounted payback period for robust capital budgeting decisions.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is payback calculated when cash flows are uneven?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For uneven annual cash flows, cumulate net inflows year-by-year until the cumulative sum matches or exceeds the initial outlay. Add the full years prior to recovery to the fractional year calculated as: (Unrecovered balance at start of recovery year) ÷ (Total cash inflow during recovery year).',
          },
        },
        {
          '@type': 'Question',
          name: 'When should a business prioritize payback period over NPV?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Payback period takes priority when liquidity or survival is the primary corporate constraint—such as early-stage startups with limited cash reserves, companies facing high debt service obligations, or industries with severe technological obsolescence risk.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Payback Period Calculator: Capital Recovery | Calcumetrics"
  description="Free payback period calculator. Apply the formula for payback period to determine exact break-even years and months from uneven projected cash flows."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Payback Period Calculator"
    category="Corporate Finance"
    categoryHref="/corporate-finance"
    heroValue={result.paybackYears.toFixed(1) + ' Years'}
    heroLabel="Payback Period"
    calcType="advanced"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Payback Period Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Determine the exact time required for capital outlays to be completely recouped from projected cash inflows.</p>

      <!-- Error alert -->
      <div id="pb-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="pb-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Initial Investment -->
      <div class="mb-5">
        <Input
          id="pb-initial"
          label="Initial Investment (Outflow)"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total upfront capital expenditure at Year 0"
          inputmode="decimal"
          aria-describedby="pb-error-msg"
        />
        <div class="mt-2">
          <Slider id="pb-initial-slider" min={50000} max={5000000} step={25000} value={500000} ariaLabel="Initial outlay slider" />
        </div>
      </div>

      <!-- Expected Annual Inflow -->
      <div class="mb-5">
        <Input
          id="pb-annual"
          label="Expected Annual Cash Inflow"
          prefix="₹"
          value="1,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Estimated net cash generated per year"
          inputmode="decimal"
          aria-describedby="pb-error-msg"
        />
        <div class="mt-2">
          <Slider id="pb-annual-slider" min={10000} max={2500000} step={10000} value={150000} ariaLabel="Annual cash flow slider" />
        </div>
      </div>

      <div class="border-t border-border pt-4 mb-6">
        <div class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3">Or Specify Uneven Inflows (Years 1 to 5)</div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div><Input id="pb-y1" label="Year 1" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" /></div>
          <div><Input id="pb-y2" label="Year 2" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" /></div>
          <div><Input id="pb-y3" label="Year 3" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" /></div>
          <div><Input id="pb-y4" label="Year 4" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" /></div>
          <div><Input id="pb-y5" label="Year 5" prefix="₹" value="1,50,000" isNumeric={true} localeFormat="indian" /></div>
        </div>
      </div>

      <Alert variant="info" title="Capital Budgeting Tip">
        Payback period ignores the time value of money and cash flows generated after the break-even point. For comprehensive capital decisions, review Net Present Value (NPV) or use the Discounted Payback Period.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="pb-calculate" type="button">Calculate Payback Period</Button>
        <Button variant="ghost" id="pb-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Payback Period</span>
        <div id="pb-result-years" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite" aria-atomic="true">
          {result.paybackYears.toFixed(1)} Years
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Recovery In Months</span>
          <span id="pb-result-months" class="text-sm font-semibold tabular-nums text-dark-accent">{Math.round(result.paybackMonths)} Months</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Initial Outlay</span>
          <span id="pb-result-initial" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.initial)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">5-Year Cumulative Inflows</span>
          <span id="pb-result-inflows" class="text-sm font-medium tabular-nums text-dark-text">{fmt(DEFAULT.annual * 5)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Status</span>
          <span id="pb-result-status" class="text-sm font-bold tabular-nums text-dark-text">Fully Recovered</span>
        </div>
      </div>

      <div class="mb-5" id="pb-composition-wrapper">
        <CompositionBar
          principalFraction={result.recovered ? 1 : 0.6}
          gainFraction={result.recovered ? 0 : 0.4}
          principalLabel="Recouped"
          gainLabel="Unrecovered"
          principalValue={fmt(DEFAULT.initial)}
          gainValue={fmt(0)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="pb-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="pb-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes continuous linear cash inflows during recovery year.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="pb-calculator-how" class="mb-8">
        <h2 id="pb-calculator-how" class="text-xl font-bold text-text-primary mb-4">How the Payback Period Is Calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          The payback period measures capital recovery velocity—the exact time required for cumulative net cash inflows generated by an investment to equal the initial capital outlay. It answers the fundamental executive liquidity question: <em>"When do we get our principal investment back?"</em>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-4">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Scenario A: Uniform (Even) Annual Inflows</span>
            <div class="font-mono text-sm text-text-primary font-bold mb-2">Payback Period = Initial Outlay ÷ Annual Inflow</div>
            <p class="text-xs text-text-muted leading-relaxed">
              Applicable when annuity-like or steady annual contract cash flows are projected.
            </p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Scenario B: Uneven Cash Flow Series</span>
            <div class="font-mono text-sm text-text-primary font-bold mb-2">Payback = A + (B ÷ C)</div>
            <p class="text-xs text-text-muted leading-relaxed">
              Where <strong>A</strong> is the last period with negative cumulative cash flow, <strong>B</strong> is the unrecovered balance at start of year A+1, and <strong>C</strong> is the total inflow received during year A+1.
            </p>
          </div>
        </div>

        <h3 class="text-base font-bold text-text-primary mb-3">Worked Example: 5-Year Capital Outlay Recovery Schedule</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Evaluating a manufacturing equipment purchase with an initial capital outlay of ₹5,00,000 generating uniform annual net cash inflows of ₹1,50,000:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-border bg-surface text-text-primary">
                <th class="py-3 px-4 font-semibold">Period</th>
                <th class="py-3 px-4 font-semibold">Annual Net Cash Flow</th>
                <th class="py-3 px-4 font-semibold">Cumulative Cash Flow</th>
                <th class="py-3 px-4 font-semibold">Unrecovered Capital Balance</th>
                <th class="py-3 px-4 font-semibold">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 0 (Outlay)</td>
                <td class="py-2.5 px-4 font-mono text-red-400 font-semibold">-₹5,00,000</td>
                <td class="py-2.5 px-4 font-mono text-red-400">-₹5,00,000</td>
                <td class="py-2.5 px-4 font-mono">₹5,00,000</td>
                <td class="py-2.5 px-4">Initial Investment Deployed</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 1 Inflow</td>
                <td class="py-2.5 px-4 font-mono">+₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono text-red-400">-₹3,50,000</td>
                <td class="py-2.5 px-4 font-mono">₹3,50,000</td>
                <td class="py-2.5 px-4">30.0% Recovered</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 2 Inflow</td>
                <td class="py-2.5 px-4 font-mono">+₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono text-red-400">-₹2,00,000</td>
                <td class="py-2.5 px-4 font-mono">₹2,00,000</td>
                <td class="py-2.5 px-4">60.0% Recovered</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 3 Inflow</td>
                <td class="py-2.5 px-4 font-mono">+₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono text-red-400">-₹50,000</td>
                <td class="py-2.5 px-4 font-mono">₹50,000</td>
                <td class="py-2.5 px-4">90.0% Recovered</td>
              </tr>
              <tr class="bg-surface/50 font-semibold text-text-primary">
                <td class="py-2.5 px-4">Year 3.33 (Break-Even)</td>
                <td class="py-2.5 px-4 font-mono">+₹50,000 (of ₹1.5L)</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹0 (Full Recovery)</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹0</td>
                <td class="py-2.5 px-4 text-accent font-bold">Full Break-even at 3 Yrs 4 Mos</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 4 Inflow</td>
                <td class="py-2.5 px-4 font-mono">+₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono text-emerald-400">+₹1,00,000</td>
                <td class="py-2.5 px-4 font-mono">₹0</td>
                <td class="py-2.5 px-4">Pure Net Surplus Profit</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Year 5 Inflow</td>
                <td class="py-2.5 px-4 font-mono">+₹1,50,000</td>
                <td class="py-2.5 px-4 font-mono text-emerald-400">+₹2,50,000</td>
                <td class="py-2.5 px-4 font-mono">₹0</td>
                <td class="py-2.5 px-4">Cumulative Total Inflows = ₹7,50,000</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Industry Payback Horizons</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>SaaS &amp; Enterprise Software:</strong> Target <strong>12 to 18 months</strong>. Rapid obsolescence and shifting tech stacks demand swift capital recoupment.</li>
              <li><strong>Commercial Solar &amp; Energy Efficiency:</strong> Target <strong>3 to 5 years</strong>. Predictable utility savings offset initial CapEx.</li>
              <li><strong>Industrial Machinery &amp; Tooling:</strong> Target <strong>3 to 6 years</strong>. Aligns with equipment depreciation schedules and product lifecycles.</li>
              <li><strong>Commercial Real Estate Development:</strong> Target <strong>7 to 12 years</strong>. Longer cycles supported by structural asset appreciation and long leases.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">The "Liquidity Bias" vs. Wealth Maximization</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              Payback period measures liquidity risk, not profitability:
            </p>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4">
              <li><strong>Ignores Post-Payback Cash:</strong> Project A with a 2-year payback might yield ₹0 thereafter, whereas Project B with a 3-year payback produces ₹20,00,000 over Year 4–10. Relying solely on payback wrongly favors Project A.</li>
              <li><strong>Ignores Time Value of Money:</strong> ₹1,50,000 received in Year 5 is treated as identical to ₹1,50,000 received in Year 1. Use the <em>Discounted Payback Period</em> to account for the cost of capital.</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions &amp; Analytical Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Continuous Cash Inflow Distribution:</strong> Fractional year calculations assume cash flows are generated uniformly and smoothly throughout the 12 months rather than as discrete quarterly or lump-sum year-end checks.</li>
            <li><strong>Zero Cost of Capital Imputation:</strong> The simple payback model assumes an effective discount rate of 0%, failing to reflect inflation or borrowing costs.</li>
            <li><strong>Reinvestment Assumption:</strong> Does not account for reinvestment returns on early capital recoveries.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Simple payback vs. time-discounted cash flow recovery?</strong>
        Read our capital budgeting guide on <a href="/blog/payback-period-vs-discounted-payback" class="text-accent font-medium hover:underline">Payback Period vs. Discounted Payback Period: Why Simple Payback Misleads Capital Budgeting</a> to see the mathematical divergence across hurdle rates and terminal year cash flows.
      </div>

      <section aria-labelledby="pb-calculator-faq">
        <h2 id="pb-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="pb-calculator-related">
        <h2 id="pb-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  function calcPaybackClient(initial: number, flows: number[]) {
    let cumulative = 0;
    for (let i = 0; i < flows.length; i++) {
      const prev = cumulative;
      cumulative += flows[i];
      if (cumulative >= initial) {
        const fraction = flows[i] > 0 ? (initial - prev) / flows[i] : 0;
        const years = i + fraction;
        return { paybackYears: years, paybackMonths: years * 12, recovered: true, totalInflows: flows.reduce((a, b) => a + b, 0) };
      }
    }
    return { paybackYears: Infinity, paybackMonths: Infinity, recovered: false, totalInflows: flows.reduce((a, b) => a + b, 0) };
  }

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initPaybackCalc() {
    if ((window as any).__cmPBBound) return;
    (window as any).__cmPBBound = true;

    const initInput = document.getElementById('pb-initial') as HTMLInputElement | null;
    const annualInput = document.getElementById('pb-annual') as HTMLInputElement | null;
    const initSlider = document.getElementById('pb-initial-slider') as HTMLInputElement | null;
    const annualSlider = document.getElementById('pb-annual-slider') as HTMLInputElement | null;

    const yInputs = [
      document.getElementById('pb-y1') as HTMLInputElement | null,
      document.getElementById('pb-y2') as HTMLInputElement | null,
      document.getElementById('pb-y3') as HTMLInputElement | null,
      document.getElementById('pb-y4') as HTMLInputElement | null,
      document.getElementById('pb-y5') as HTMLInputElement | null,
    ];

    const resYears = document.getElementById('pb-result-years');
    const resMonths = document.getElementById('pb-result-months');
    const resInitial = document.getElementById('pb-result-initial');
    const resInflows = document.getElementById('pb-result-inflows');
    const resStatus = document.getElementById('pb-result-status');
    const errAlert = document.getElementById('pb-error-alert');
    const errMsg = document.getElementById('pb-error-msg');

    if (!initInput || !annualInput) return;

    const DEFAULTS = { initial: 500000, annual: 150000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) { if (errAlert) errAlert.classList.remove('hidden'); if (errMsg) errMsg.textContent = msg; }
    function clearError() { if (errAlert) errAlert.classList.add('hidden'); }

    function recalc() {
      const rawI = initInput!.value.replace(/[^0-9.]/g, '');
      const rawA = annualInput!.value.replace(/[^0-9.]/g, '');
      const vI = validate(rawI, { required: true, min: 1, label: 'Initial Investment' });
      const vA = validate(rawA, { required: true, min: 0, label: 'Annual Cash Flow' });
      if (!vI.valid) { showError(vI.error!.message); return; }
      if (!vA.valid) { showError(vA.error!.message); return; }
      clearError();

      const initial = vI.value!;
      const annual = vA.value!;
      const flows = yInputs.map((el) => {
        const raw = el?.value.replace(/[^0-9.]/g, '') ?? '';
        const v = validate(raw, { required: false, min: 0, decimal: true, label: 'Year' });
        return v.valid && v.value !== undefined ? v.value : annual;
      });

      const res = calcPaybackClient(initial, flows);
      const yrsText = isFinite(res.paybackYears) ? res.paybackYears.toFixed(1) + ' Years' : '> 5 Years';
      const mthsText = isFinite(res.paybackMonths) ? Math.round(res.paybackMonths) + ' Months' : 'Unrecovered';

      setResult({
        heroValue: yrsText,
        heroLabel: 'Payback Period',
        rows: [
          { label: 'Months to Recover', value: mthsText },
          { label: 'Initial Investment', value: fmtVal(initial) },
          { label: 'Total Inflows', value: fmtVal(res.totalInflows) },
          { label: 'Status', value: res.recovered ? 'Fully Recovered' : 'Not Recovered', variant: res.recovered ? 'accent' : 'muted' },
        ],
      });

      if (resYears) resYears.textContent = yrsText;
      if (resMonths) resMonths.textContent = mthsText;
      if (resInitial) resInitial.textContent = fmtVal(initial);
      if (resInflows) resInflows.textContent = fmtVal(res.totalInflows);
      if (resStatus) {
        resStatus.textContent = res.recovered ? 'Fully Recovered' : 'Not Recovered in 5 Yrs';
        resStatus.className = res.recovered ? 'text-sm font-bold tabular-nums text-dark-accent' : 'text-sm font-bold tabular-nums text-red-400';
      }

      history.replaceState(null, '', serializeHash({ i: initial, a: annual }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        if (slider === annualSlider) {
          yInputs.forEach((y) => { if (y) y.value = input.value; });
        }
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        if (input === annualInput) {
          yInputs.forEach((y) => { if (y) y.value = input.value; });
        }
        debounce();
      });
    }

    sync(initSlider, initInput);
    sync(annualSlider, annualInput);

    yInputs.forEach((el) => {
      el?.addEventListener('input', () => {
        el.value = fmtLiveInput(el.value);
        debounce();
      });
    });

    document.getElementById('pb-calculate')?.addEventListener('click', recalc);
    document.getElementById('pb-reset')?.addEventListener('click', () => {
      initInput.value = fmtLiveInput(String(DEFAULTS.initial));
      annualInput.value = fmtLiveInput(String(DEFAULTS.annual));
      yInputs.forEach((y) => { if (y) y.value = fmtLiveInput(String(DEFAULTS.annual)); });
      if (initSlider) {
        initSlider.value = String(DEFAULTS.initial);
        initSlider.style.setProperty('--slider-pct', `${((DEFAULTS.initial - 50000) / (5000000 - 50000)) * 100}%`);
      }
      if (annualSlider) {
        annualSlider.value = String(DEFAULTS.annual);
        annualSlider.style.setProperty('--slider-pct', `${((DEFAULTS.annual - 10000) / (2500000 - 10000)) * 100}%`);
      }
      clearError();
      recalc();
      initInput.focus();
    });

    document.getElementById('pb-copy-btn')?.addEventListener('click', async () => {
      const rawI = initInput.value.replace(/[^0-9.]/g, '');
      const vI = validate(rawI, { required: true, min: 1, label: 'Initial' });
      if (!vI.valid) return;
      const flows = yInputs.map((el) => {
        const raw = el?.value.replace(/[^0-9.]/g, '') ?? '';
        const v = validate(raw, { required: false, min: 0, decimal: true, label: 'Y' });
        const vA = validate(annualInput!.value.replace(/[^0-9.]/g, ''), { required: false, min: 0, label: 'A' });
        return v.valid && v.value !== undefined ? v.value : (vA.value ?? 0);
      });
      const res = calcPaybackClient(vI.value!, flows);
      const text = `Payback Period: Initial Outflow ${fmtVal(vI.value!)} => Payback in ${isFinite(res.paybackYears) ? res.paybackYears.toFixed(1) + ' years' : '> 5 years'} (${Math.round(res.paybackMonths)} months). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-btn');
      if (btn) { const orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => (btn.textContent = orig), 2000); }
    });

    document.getElementById('pb-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('pb-share-btn');
      if (btn) { const orig = btn.textContent; btn.textContent = 'Copied Link!'; setTimeout(() => (btn.textContent = orig), 2000); }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      i: { required: true, min: 1, label: 'i' },
      a: { required: true, min: 0, label: 'a' },
    });
    if (restored.valid && restored.values.i && restored.values.a) {
      initInput.value = fmtLiveInput(String(restored.values.i));
      annualInput.value = fmtLiveInput(String(restored.values.a));
      yInputs.forEach((y) => { if (y) y.value = fmtLiveInput(String(restored.values.a)); });
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initPaybackCalc();
  document.addEventListener('astro:page-load', initPaybackCalc);
</script>
