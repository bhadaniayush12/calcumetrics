---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcLiquidityRatios } from '../lib/calculators/liquidity-ratios';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = {
  cash: 300000,
  securities: 100000,
  receivables: 400000,
  inventory: 450000,
  liabilities: 500000,
};

const result = calcLiquidityRatios(
  DEFAULT.cash,
  DEFAULT.securities,
  DEFAULT.receivables,
  DEFAULT.inventory,
  0,
  DEFAULT.liabilities
);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'liquidity-ratios-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/liquidity-ratios-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Liquidity Ratios Suite (Current, Quick & Cash Ratios)',
      url: canonicalUrl,
      description: 'Calculate and benchmark key short-term liquidity ratios: Current Ratio, Quick Ratio, and Cash Ratio against financial health standards.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'Liquidity Ratios Suite' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can a Current Ratio be too high?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. A Current Ratio exceeding 3.0x or 4.0x often indicates capital misallocation—such as holding excessive non-interest-bearing cash, hoarding slow-moving inventory, or failing to collect outstanding invoices aggressively from customer debtors.',
          },
        },
        {
          '@type': 'Question',
          name: 'Which ratio do commercial lenders inspect first?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Commercial bank credit analysts scrutinize the Quick (Acid-Test) Ratio most closely. They rely on it because it eliminates inventory liquidation uncertainty while verifying that cash and receivables cover short-term debts.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is considered a healthy Quick Ratio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A Quick Ratio of 1.0x or greater is generally considered healthy, meaning the firm has at least one dollar of liquid assets (cash, marketable securities, and accounts receivable) for every dollar of current obligations.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is the Cash Ratio different from the Quick Ratio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'While the Quick Ratio includes accounts receivable (which may take 30 to 90 days to collect), the Cash Ratio is the most conservative metric, counting strictly cash and cash equivalents to assess immediate payment capacity without reliance on debtors.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why are prepaid expenses excluded from Quick Assets?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Prepaid expenses (such as advance insurance or rent) represent future economic benefits, but they cannot be liquidated or directly converted into cash to pay off maturing debts in an emergency.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Liquidity Ratios Suite: Current, Quick & Cash Ratio Calculator | Calcumetrics"
  description="Calculate and benchmark key short-term liquidity ratios: Current Ratio, Quick Ratio, and Cash Ratio against financial health standards."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Liquidity Ratios Suite"
    category="Business"
    categoryHref="/business"
    heroValue={result.currentRatio.toFixed(2) + 'x'}
    heroLabel="Current Ratio"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Liquidity Ratios Suite</h1>
      <p class="text-sm text-text-muted mb-6">Assess corporate solvency across the three tiers of liquidity: Current, Acid-Test, and Cash ratios.</p>

      <!-- Error Alert -->
      <div id="lr-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="lr-error-msg"></span>
      </div>

      <!-- Cash & Bank -->
      <div class="mb-5">
        <Input
          id="lr-cash"
          label="Cash & Bank Balances"
          prefix="₹"
          value="3,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Direct cash held in bank checking and currency reserves"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lr-cash-slider" min={0} max={3000000} step={25000} value={300000} ariaLabel="Cash slider" />
        </div>
      </div>

      <!-- Marketable Securities -->
      <div class="mb-5">
        <Input
          id="lr-securities"
          label="Marketable Securities (Liquid Mutual Funds/T-Bills)"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Near-cash equivalents convertible within 24 to 48 hours"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lr-securities-slider" min={0} max={2000000} step={25000} value={100000} ariaLabel="Securities slider" />
        </div>
      </div>

      <!-- Accounts Receivable -->
      <div class="mb-5">
        <Input
          id="lr-receivables"
          label="Accounts Receivable (Debtors)"
          prefix="₹"
          value="4,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Invoices due from customers on trade terms"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lr-receivables-slider" min={0} max={3000000} step={25000} value={400000} ariaLabel="Receivables slider" />
        </div>
      </div>

      <!-- Inventory -->
      <div class="mb-5">
        <Input
          id="lr-inventory"
          label="Inventory (Raw Materials & Finished Goods)"
          prefix="₹"
          value="4,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Physical goods held for manufacturing or retail sale"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lr-inventory-slider" min={0} max={3000000} step={25000} value={450000} ariaLabel="Inventory slider" />
        </div>
      </div>

      <!-- Current Liabilities -->
      <div class="mb-6">
        <Input
          id="lr-liabilities"
          label="Total Current Liabilities (Payables + Short-term Debt)"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="All obligations falling due within 12 months"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="lr-liabilities-slider" min={50000} max={5000000} step={25000} value={500000} ariaLabel="Liabilities slider" />
        </div>
      </div>

      <Alert variant="info" title="The Three Liquidity Tiers">
        <strong>Current Ratio:</strong> General solvency (&gt;1.5x is healthy). <strong>Quick Ratio:</strong> Excludes inventory (&gt;1.0x is ideal). <strong>Cash Ratio:</strong> Pure cash coverage (&gt;0.2–0.5x is strong).
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="lr-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="lr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Current Ratio</span>
        <div id="lr-result-current" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {result.currentRatio.toFixed(2)}x
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Quick (Acid-Test) Ratio</span>
          <span id="lr-result-quick" class="text-sm font-semibold tabular-nums text-dark-accent">{result.quickRatio.toFixed(2)}x</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Cash Ratio (Immediate Coverage)</span>
          <span id="lr-result-cash" class="text-sm font-semibold tabular-nums text-dark-text">{result.cashRatio.toFixed(2)}x</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Working Capital Cushion</span>
          <span id="lr-result-nwc" class="text-sm font-medium tabular-nums text-dark-accent">{fmt(result.netWorkingCapital)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Solvency Health Rating</span>
          <span id="lr-result-status" class="text-sm font-bold tabular-nums text-dark-accent">Optimal Liquidity Profile</span>
        </div>
      </div>

      <div class="mb-5" id="lr-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.liabilities / (DEFAULT.cash + DEFAULT.securities + DEFAULT.receivables + DEFAULT.inventory)}
          gainFraction={result.netWorkingCapital / (DEFAULT.cash + DEFAULT.securities + DEFAULT.receivables + DEFAULT.inventory)}
          principalLabel="Liabilities"
          gainLabel="Net Cushion"
          principalValue={fmt(DEFAULT.liabilities)}
          gainValue={fmt(result.netWorkingCapital)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="lr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="lr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Essential financial health test required by commercial loan lenders.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="lr-calculator-how">
        <h2 id="lr-calculator-how" class="text-xl font-bold text-text-primary mb-4">The Three Liquidity Formulas Explained</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-sm text-text-primary mb-2">1. Current Ratio</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">Broadest liquidity gauge: covers all assets convertible within 12 months.</p>
            <p class="font-mono text-xs text-text-primary">Current Assets ÷ Current Liabilities</p>
            <p class="text-xs text-accent mt-2">Benchmark: 1.5x – 2.0x</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-sm text-text-primary mb-2">2. Quick (Acid-Test) Ratio</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">Excludes slow-moving inventory and illiquid prepaid expenses.</p>
            <p class="font-mono text-xs text-text-primary">(Cash + Securities + Debtors) ÷ Current Liabilities</p>
            <p class="text-xs text-accent mt-2">Benchmark: &ge; 1.0x</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-sm text-text-primary mb-2">3. Cash Ratio</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">Most stringent test: examines immediate ability to pay debts without selling anything.</p>
            <p class="font-mono text-xs text-text-primary">(Cash + Marketable Securities) ÷ Current Liabilities</p>
            <p class="text-xs text-accent mt-2">Benchmark: 0.2x – 0.5x</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="lr-calculator-faq">
        <h2 id="lr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can a Current Ratio be too high?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes. A Current Ratio exceeding 3.0x or 4.0x often indicates capital misallocation—such as holding excessive non-interest-bearing cash, hoarding slow-moving inventory, or failing to collect outstanding invoices aggressively from customer debtors.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Which ratio do commercial lenders inspect first?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Commercial bank credit analysts scrutinize the Quick (Acid-Test) Ratio most closely. They rely on it because it eliminates inventory liquidation uncertainty while verifying that cash and receivables cover short-term debts.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What is considered a healthy Quick Ratio?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              A Quick Ratio of 1.0x or greater is generally considered healthy, meaning the firm has at least one dollar of liquid assets (cash, marketable securities, and accounts receivable) for every dollar of current obligations.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How is the Cash Ratio different from the Quick Ratio?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              While the Quick Ratio includes accounts receivable (which may take 30 to 90 days to collect), the Cash Ratio is the most conservative metric, counting strictly cash and cash equivalents to assess immediate payment capacity without reliance on debtors.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Why are prepaid expenses excluded from Quick Assets?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Prepaid expenses (such as advance insurance or rent) represent future economic benefits, but they cannot be liquidated or directly converted into cash to pay off maturing debts in an emergency.
            </div>
          </details>
        </div>
      </section>

      <section aria-labelledby="lr-calculator-related">
        <h2 id="lr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">{related.map((tool) => (<a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent"><span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span><h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3><p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p></a>))}</div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcLiquidityRatios } from '../lib/calculators/liquidity-ratios';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    const sign = n < 0 ? '-' : '';
    return sign + currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.abs(Math.round(n)));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initLRCalc() {
    if ((window as any).__cmLrBound) return;
    (window as any).__cmLrBound = true;

    const cashInput = document.getElementById('lr-cash') as HTMLInputElement | null;
    const secInput = document.getElementById('lr-securities') as HTMLInputElement | null;
    const arInput = document.getElementById('lr-receivables') as HTMLInputElement | null;
    const invInput = document.getElementById('lr-inventory') as HTMLInputElement | null;
    const clInput = document.getElementById('lr-liabilities') as HTMLInputElement | null;

    const cashSlider = document.getElementById('lr-cash-slider') as HTMLInputElement | null;
    const secSlider = document.getElementById('lr-securities-slider') as HTMLInputElement | null;
    const arSlider = document.getElementById('lr-receivables-slider') as HTMLInputElement | null;
    const invSlider = document.getElementById('lr-inventory-slider') as HTMLInputElement | null;
    const clSlider = document.getElementById('lr-liabilities-slider') as HTMLInputElement | null;

    const resCurrent = document.getElementById('lr-result-current');
    const resQuick = document.getElementById('lr-result-quick');
    const resCash = document.getElementById('lr-result-cash');
    const resNwc = document.getElementById('lr-result-nwc');
    const resStatus = document.getElementById('lr-result-status');
    const mobileHero = document.getElementById('calc-mobile-hero');

    const errAlert = document.getElementById('lr-error-alert');
    const errMsg = document.getElementById('lr-error-msg');

    if (!cashInput || !clInput) return;

    const DEFAULTS = { cash: 300000, sec: 100000, ar: 400000, inv: 450000, cl: 500000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function parse(v: string) {
      return parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
    }

    function recalc() {
      const rawCash = cashInput!.value.replace(/[^0-9.]/g, '');
      const rawSec = secInput ? secInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawAr = arInput ? arInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawInv = invInput ? invInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawCl = clInput!.value.replace(/[^0-9.]/g, '');

      const vCash = validate(rawCash, { required: true, min: 0, label: 'Cash & Bank Balances' });
      const vSec = validate(rawSec, { required: true, min: 0, label: 'Marketable Securities' });
      const vAr = validate(rawAr, { required: true, min: 0, label: 'Accounts Receivable' });
      const vInv = validate(rawInv, { required: true, min: 0, label: 'Inventory' });
      const vCl = validate(rawCl, { required: true, min: 1, label: 'Current Liabilities' });

      if (!vCash.valid) { showError(vCash.error!.message); return; }
      if (!vSec.valid) { showError(vSec.error!.message); return; }
      if (!vAr.valid) { showError(vAr.error!.message); return; }
      if (!vInv.valid) { showError(vInv.error!.message); return; }
      if (!vCl.valid) { showError(vCl.error!.message); return; }
      clearError();

      const cash = vCash.value!;
      const sec = vSec.value!;
      const ar = vAr.value!;
      const inv = vInv.value!;
      const cl = vCl.value!;

      const res = calcLiquidityRatios(cash, sec, ar, inv, 0, cl);

      setResult({
        heroValue: `${res.currentRatio.toFixed(2)}x`,
        heroLabel: 'Current Ratio',
        rows: [
          { label: 'Quick (Acid-Test) Ratio', value: `${res.quickRatio.toFixed(2)}x` },
          { label: 'Cash Ratio', value: `${res.cashRatio.toFixed(2)}x` },
          { label: 'Net Working Capital Cushion', value: fmtVal(res.netWorkingCapital) },
          { label: 'Current Ratio Status', value: res.currentRatioStatus },
          { label: 'Quick Ratio Status', value: res.quickRatioStatus },
          { label: 'Cash Ratio Status', value: res.cashRatioStatus },
        ],
      });

      if (resCurrent) resCurrent.textContent = res.currentRatio.toFixed(2) + 'x';
      if (resQuick) resQuick.textContent = res.quickRatio.toFixed(2) + 'x';
      if (resCash) resCash.textContent = res.cashRatio.toFixed(2) + 'x';
      if (resNwc) resNwc.textContent = fmtVal(res.netWorkingCapital);
      if (mobileHero) mobileHero.textContent = res.currentRatio.toFixed(2) + 'x';

      if (resStatus) {
        let statusText = 'Optimal Liquidity Profile';
        if (res.currentRatio < 1.0 || res.quickRatio < 0.8) {
          statusText = 'Liquidity Distress / Deficit';
        } else if (res.currentRatio < 1.5 || res.quickRatio < 1.0) {
          statusText = 'Caution: Monitor Working Capital';
        }
        resStatus.textContent = statusText;
        resStatus.className = statusText.includes('Optimal')
          ? 'text-sm font-bold tabular-nums text-dark-accent'
          : statusText.includes('Deficit')
          ? 'text-sm font-bold tabular-nums text-red-400'
          : 'text-sm font-bold tabular-nums text-yellow-400';
      }

      const totalAssets = cash + sec + ar + inv;
      const wrapper = document.getElementById('lr-composition-wrapper');
      if (wrapper && totalAssets > 0) {
        const liabFrac = Math.min(1, cl / totalAssets);
        const cushionFrac = Math.max(0, res.netWorkingCapital / totalAssets);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(liabFrac * 100).toFixed(1)}%`;
        if (gainBar) gainBar.style.width = `${(cushionFrac * 100).toFixed(1)}%`;
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(cl);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.netWorkingCapital);
      }

      serializeHash({ c: cash, s: sec, ar: ar, i: inv, cl: cl });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(cashSlider, cashInput);
    sync(secSlider, secInput!);
    sync(arSlider, arInput!);
    sync(invSlider, invInput!);
    sync(clSlider, clInput);

    document.getElementById('lr-calculate')?.addEventListener('click', recalc);
    document.getElementById('lr-reset')?.addEventListener('click', () => {
      cashInput.value = fmtLiveInput(String(DEFAULTS.cash));
      if (secInput) secInput.value = fmtLiveInput(String(DEFAULTS.sec));
      if (arInput) arInput.value = fmtLiveInput(String(DEFAULTS.ar));
      if (invInput) invInput.value = fmtLiveInput(String(DEFAULTS.inv));
      clInput.value = fmtLiveInput(String(DEFAULTS.cl));

      if (cashSlider) {
        cashSlider.value = String(DEFAULTS.cash);
        cashSlider.style.setProperty('--slider-pct', `${(DEFAULTS.cash / 3000000) * 100}%`);
      }
      if (secSlider) {
        secSlider.value = String(DEFAULTS.sec);
        secSlider.style.setProperty('--slider-pct', `${(DEFAULTS.sec / 2000000) * 100}%`);
      }
      if (arSlider) {
        arSlider.value = String(DEFAULTS.ar);
        arSlider.style.setProperty('--slider-pct', `${(DEFAULTS.ar / 3000000) * 100}%`);
      }
      if (invSlider) {
        invSlider.value = String(DEFAULTS.inv);
        invSlider.style.setProperty('--slider-pct', `${(DEFAULTS.inv / 3000000) * 100}%`);
      }
      if (clSlider) {
        clSlider.value = String(DEFAULTS.cl);
        clSlider.style.setProperty('--slider-pct', `${((DEFAULTS.cl - 50000) / (5000000 - 50000)) * 100}%`);
      }

      clearError();
      recalc();
      cashInput.focus();
    });

    [cashInput, secInput, arInput, invInput, clInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('lr-copy-btn')?.addEventListener('click', async () => {
      const rawCash = cashInput.value.replace(/[^0-9.]/g, '');
      const rawSec = secInput ? secInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawAr = arInput ? arInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawInv = invInput ? invInput.value.replace(/[^0-9.]/g, '') : '0';
      const rawCl = clInput.value.replace(/[^0-9.]/g, '');

      const vCash = validate(rawCash, { required: true, min: 0, label: 'Cash & Bank Balances' });
      const vSec = validate(rawSec, { required: true, min: 0, label: 'Marketable Securities' });
      const vAr = validate(rawAr, { required: true, min: 0, label: 'Accounts Receivable' });
      const vInv = validate(rawInv, { required: true, min: 0, label: 'Inventory' });
      const vCl = validate(rawCl, { required: true, min: 1, label: 'Current Liabilities' });
      if (!vCash.valid || !vSec.valid || !vAr.valid || !vInv.valid || !vCl.valid) return;

      const res = calcLiquidityRatios(vCash.value!, vSec.value!, vAr.value!, vInv.value!, 0, vCl.value!);
      const text = `Liquidity Ratios: Current Ratio: ${res.currentRatio.toFixed(2)}x, Quick Ratio: ${res.quickRatio.toFixed(2)}x, Cash Ratio: ${res.cashRatio.toFixed(2)}x (NWC: ${fmtVal(res.netWorkingCapital)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('lr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('lr-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('lr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      c: { required: false, min: 0, label: 'c' },
      s: { required: false, min: 0, label: 's' },
      ar: { required: false, min: 0, label: 'ar' },
      i: { required: false, min: 0, label: 'i' },
      cl: { required: false, min: 1, label: 'cl' },
      cash: { required: false, min: 0, label: 'cash' },
      securities: { required: false, min: 0, label: 'securities' },
      receivables: { required: false, min: 0, label: 'receivables' },
      inventory: { required: false, min: 0, label: 'inventory' },
      liabilities: { required: false, min: 1, label: 'liabilities' },
    });
    const initCash = restored.values.c ?? restored.values.cash;
    const initSec = restored.values.s ?? restored.values.securities;
    const initAr = restored.values.ar ?? restored.values.receivables;
    const initInv = restored.values.i ?? restored.values.inventory;
    const initCl = restored.values.cl ?? restored.values.liabilities;

    if (restored.valid && (initCash !== undefined || initCl !== undefined)) {
      if (initCash !== undefined) cashInput.value = fmtLiveInput(String(initCash));
      if (secInput && initSec !== undefined) secInput.value = fmtLiveInput(String(initSec));
      if (arInput && initAr !== undefined) arInput.value = fmtLiveInput(String(initAr));
      if (invInput && initInv !== undefined) invInput.value = fmtLiveInput(String(initInv));
      if (initCl !== undefined) clInput.value = fmtLiveInput(String(initCl));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initLRCalc();
  document.addEventListener('astro:page-load', initLRCalc);
</script>
