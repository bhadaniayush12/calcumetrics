---
/**
 * Homepage — /
 * India-first financial calculators with instant live calculations.
 * Pre-rendered live interactive SIP preview inside WindowFrame.
 * Quick-pick row, Most Popular Tools, Browse by Category, unified Why Calcumetrics.
 */
import Layout from '../layouts/Layout.astro';
import WindowFrame from '../components/calculator/WindowFrame.astro';
import { calcSIP } from '../lib/calculators/sip';
import { formatIndian, formatIndianCompact, formatIndianWords } from '../lib/formatters';
import { getPublishedTools, getToolCount, CATEGORIES } from '../config/site';

const initialMonthly = 25000;
const initialRate = 12;
const initialYears = 15;
const result = calcSIP(initialMonthly, initialRate, initialYears);

const heroCompact = formatIndianCompact(result.maturity, '₹');
const heroExact = '₹' + formatIndian(result.maturity);
const heroInvested = formatIndianCompact(result.invested, '₹');
const heroGain = formatIndianCompact(result.gain, '₹');
const initialGainWords = formatIndianWords(result.gain, '₹');

const allTools = getPublishedTools();
const totalCount = getToolCount();

// Most popular — hand-picked 6 for the homepage with badge labels
const popularConfig: Record<string, string> = {
  'sip-calculator':       'Featured',
  'emi-calculator':       'Featured',
  'fd-calculator':        'Investments',
  'cagr-calculator':      'Investments',
  'wacc-calculator':      'Corporate Finance',
  'break-even-calculator':'Business',
};
const popularSlugs = Object.keys(popularConfig);
const popularTools = popularSlugs
  .map((s) => allTools.find((t) => t.slug === s))
  .filter(Boolean);

// Category descriptions for richer cards
const categoryDescriptions: Record<string, string> = {
  Investments: 'SIP, compound interest, CAGR, XIRR, FD, PPF, 401(k) and more.',
  Loans: 'EMI, home loan, car loan and prepayment impact calculators.',
  Taxes: 'GST, HRA, and Old vs New income tax regime for India.',
  Business: 'Break-even, profit margins, markup vs margin, ROI.',
  'Corporate Finance': 'WACC, NPV, IRR, payback period, DCF — global formulas.',
};

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://calcumetrics.com/#org',
      name: 'Calcumetrics',
      url: 'https://calcumetrics.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://calcumetrics.com/logo.svg',
        width: 200,
        height: 200,
      },
      email: 'hello@calcumetrics.com',
      description: `Free, 100% client-side financial calculators for investments, loans, taxes, business, and corporate finance. Runs in your browser with zero sign-up.`,
    },
    {
      '@type': 'WebSite',
      '@id': 'https://calcumetrics.com/#website',
      url: 'https://calcumetrics.com/',
      name: 'Calcumetrics',
      description: `${totalCount} free financial calculators for investments, loans, taxes, business and corporate finance.`,
      publisher: { '@id': 'https://calcumetrics.com/#org' },
      inLanguage: 'en',
    },
  ],
};
---

<Layout
  title="Free Financial Calculators — SIP, EMI, Tax, Loans & More | Calcumetrics"
  description={`${totalCount}+ free financial calculators for investments, loans, taxes, business, and corporate finance. Instant results, transparent formulas, 100% client-side privacy.`}
  canonical="https://calcumetrics.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="bg-canvas border-b border-border py-10 sm:py-14" aria-labelledby="hero-heading">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-12 lg:gap-10 lg:items-center">

        <!-- Left: Copy & Quick Picks -->
        <div class="lg:col-span-5 mb-8 lg:mb-0">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-chip border border-accent/20 bg-accent/5 text-xs font-semibold text-accent mb-3">
            100% Free · No Sign-Up · 100% Client-Side Privacy
          </div>
          <h1 id="hero-heading" class="text-3xl sm:text-4xl lg:text-[40px] font-bold tracking-tight text-text-primary mb-3 leading-tight">
            Free Financial Calculators — SIP, EMI, Loans, Tax &amp; More
          </h1>
          <p class="text-sm sm:text-base text-text-muted leading-relaxed mb-6 max-w-md">
            Instant results. Transparent formulas. Your financial data stays entirely on your device with 100% private calculations.
          </p>
          <div class="flex flex-wrap gap-3 mb-6">
            <a href="/calculators" class="inline-flex items-center h-11 px-5 rounded-control bg-accent text-white text-sm font-medium hover:bg-accent-hover transition-standard focus-visible:outline-accent shadow-sm">
              Browse all calculators &rarr;
            </a>
            <a href="/methodology" class="inline-flex items-center h-11 px-5 rounded-control border border-border text-sm font-medium text-text-primary hover:text-accent hover:border-accent transition-standard focus-visible:outline-accent">
              How formulas work
            </a>
          </div>

          <!-- Quick pick row -->
          <div class="pt-4 border-t border-border">
            <p class="text-[11px] font-semibold text-text-muted uppercase tracking-wider mb-2">Quick Pick Tools</p>
            <div class="flex flex-wrap gap-1.5">
              {[
                { name: 'SIP', href: '/sip-calculator' },
                { name: 'EMI', href: '/emi-calculator' },
                { name: 'FD', href: '/fd-calculator' },
                { name: 'GST', href: '/in/gst-calculator' },
                { name: 'Income Tax', href: '/in/income-tax-calculator' },
                { name: 'HRA', href: '/in/hra-calculator' },
                { name: 'PPF', href: '/in/ppf-calculator' },
              ].map((t) => (
                <a
                  href={t.href}
                  class="inline-flex items-center px-2.5 py-1 rounded-control bg-surface hover:bg-canvas border border-border hover:border-accent text-xs font-medium text-text-primary hover:text-accent transition-standard"
                >
                  {t.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Live Interactive SIP preview in WindowFrame -->
        <div class="lg:col-span-7">
          <WindowFrame urlPill="calcumetrics.com/sip-calculator" class="w-full">
            <div class="p-5 sm:p-6" id="hero-sip-widget">
              <div class="flex flex-col sm:flex-row gap-5">
                <!-- Input side preview with live sliders -->
                <div class="flex-1 space-y-4">
                  <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-text-muted uppercase tracking-wider">SIP Live Preview</p>
                    <span class="text-[11px] text-accent font-medium bg-accent/10 px-2 py-0.5 rounded">Live Interactive</span>
                  </div>

                  <!-- Monthly Investment -->
                  <div class="space-y-1.5">
                    <div class="flex justify-between text-xs font-medium text-text-primary">
                      <span>Monthly Investment</span>
                      <span class="tabular-nums font-semibold" id="hero-val-monthly">₹25,000</span>
                    </div>
                    <input
                      type="range"
                      id="hero-slider-monthly"
                      min="500"
                      max="100000"
                      step="500"
                      value="25000"
                      aria-label="Monthly investment slider"
                      class="w-full h-1.5 bg-border rounded-lg appearance-none cursor-pointer accent-accent"
                    />
                  </div>

                  <!-- Expected Return Rate -->
                  <div class="space-y-1.5">
                    <div class="flex justify-between text-xs font-medium text-text-primary">
                      <span>Expected Return</span>
                      <span class="tabular-nums font-semibold" id="hero-val-rate">12.0%</span>
                    </div>
                    <input
                      type="range"
                      id="hero-slider-rate"
                      min="1"
                      max="30"
                      step="0.5"
                      value="12"
                      aria-label="Expected return rate slider"
                      class="w-full h-1.5 bg-border rounded-lg appearance-none cursor-pointer accent-accent"
                    />
                  </div>

                  <!-- Time Period -->
                  <div class="space-y-1.5">
                    <div class="flex justify-between text-xs font-medium text-text-primary">
                      <span>Time Period</span>
                      <span class="tabular-nums font-semibold" id="hero-val-years">15 yrs</span>
                    </div>
                    <input
                      type="range"
                      id="hero-slider-years"
                      min="1"
                      max="40"
                      step="1"
                      value="15"
                      aria-label="Time period slider"
                      class="w-full h-1.5 bg-border rounded-lg appearance-none cursor-pointer accent-accent"
                    />
                  </div>

                  <a
                    id="hero-full-calculator-btn"
                    href="/sip-calculator#p=25000&r=12&y=15"
                    class="flex items-center justify-center gap-1.5 w-full h-10 rounded-control bg-accent text-white text-xs font-semibold hover:bg-accent-hover transition-standard focus-visible:outline-accent"
                  >
                    Open full SIP calculator & year schedule &rarr;
                  </a>
                </div>

                <!-- Output side preview with big compact format + compounding insight -->
                <div class="flex-1 bg-dark-bg rounded-card p-4 flex flex-col justify-between">
                  <div>
                    <p class="text-[11px] text-dark-muted mb-1 uppercase tracking-wider font-medium">Estimated Maturity</p>
                    <div class="flex items-baseline gap-2 mb-1 flex-wrap">
                      <p class="text-3xl sm:text-4xl font-extrabold tabular-nums text-dark-text" id="hero-maturity-compact">
                        {heroCompact}
                      </p>
                      <span class="text-xs text-dark-muted tabular-nums" id="hero-maturity-exact">
                        ({heroExact})
                      </span>
                    </div>

                    <div class="space-y-2 text-xs border-t border-dark-border pt-3 mt-3">
                      <div class="flex justify-between">
                        <span class="text-dark-muted">Total Invested</span>
                        <span class="tabular-nums text-dark-text font-medium" id="hero-res-invested">{heroInvested}</span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-dark-muted">Total Gain</span>
                        <span class="tabular-nums text-dark-accent font-bold" id="hero-res-gain">+{heroGain}</span>
                      </div>
                    </div>

                    <!-- Composition bar preview -->
                    <div class="mt-3 h-2 w-full flex overflow-hidden rounded-sm bg-dark-border">
                      <div id="hero-bar-invested" class="h-full bg-dark-muted transition-all duration-150" style={`width: ${(result.principalFraction * 100).toFixed(1)}%`}></div>
                      <div id="hero-bar-gain" class="h-full bg-dark-accent transition-all duration-150" style={`width: ${(result.gainFraction * 100).toFixed(1)}%`}></div>
                    </div>
                  </div>

                  <!-- Compounding Insight line -->
                  <div class="mt-4 p-2.5 rounded bg-dark-border/50 border border-dark-border text-[11px] text-dark-text leading-snug">
                    <span id="hero-compounding-insight">
                      ₹25,000/month over 15 years yields {initialGainWords} in pure compounding gain.
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </WindowFrame>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Stats Bar (Fixed 4th item) -->
  <section class="bg-surface border-b border-border py-4" aria-label="Platform highlights">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-0 sm:divide-x sm:divide-border">
        {[
          { stat: String(totalCount) + '+', label: 'Free calculators' },
          { stat: '5',                      label: 'Finance categories' },
          { stat: '100%',                   label: 'Client-side privacy' },
          { stat: '0',                      label: 'Sign-ups required' },
        ].map((item) => (
          <div class="flex flex-col items-center text-center px-4 py-1">
            <span class="text-xl font-bold tabular-nums text-text-primary tracking-tight">{item.stat}</span>
            <span class="text-xs text-text-muted mt-0.5">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Most Popular Tools -->
  <section class="py-12 bg-canvas border-b border-border" aria-labelledby="popular-heading">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8">
        <div>
          <h2 id="popular-heading" class="text-2xl font-bold text-text-primary mb-1">Most popular calculators</h2>
          <p class="text-sm text-text-muted">Start with top tools for personal wealth, home loans, taxation, and business planning.</p>
        </div>
        <a href="/calculators" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-hover transition-standard">
          View all {totalCount} tools &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularTools.map((tool) => tool && (
          <a
            href={tool.path}
            class="group block bg-surface border border-border rounded-card p-4 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
          >
            <div class="flex items-start justify-between mb-2">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider">{tool.category}</span>
              {popularConfig[tool.slug] === 'Featured' && (
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-chip bg-accent/10 border border-accent/20 text-[10px] font-semibold text-accent uppercase tracking-wider">
                  Featured
                </span>
              )}
            </div>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard mb-1">{tool.name}</h3>
            <p class="text-xs text-text-muted leading-relaxed">{tool.description}</p>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center sm:hidden">
        <a href="/calculators" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover transition-standard focus-visible:outline-accent">
          View all {totalCount} calculators &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Browse by Category -->
  <section class="py-12 bg-surface border-b border-border" aria-labelledby="categories-heading">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="categories-heading" class="text-2xl font-bold text-text-primary mb-2">Browse by category</h2>
      <p class="text-sm text-text-muted mb-8">{totalCount} calculators across five categories — personal finance, business valuation, tax planning, loans, and corporate finance.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {CATEGORIES.map((cat) => {
          const catTools = allTools.filter((t) => t.category === cat.name);
          return (
            <a
              href={cat.href}
              class="group block bg-canvas border border-border rounded-card p-5 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
            >
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{cat.name}</h3>
                <span class="text-xs text-text-muted">{catTools.length} tools</span>
              </div>
              <p class="text-xs text-text-muted leading-relaxed mb-3">{categoryDescriptions[cat.name]}</p>
              <ul class="space-y-1">
                {catTools.slice(0, 3).map((tool) => (
                  <li class="text-xs text-text-muted truncate">· {tool.name}</li>
                ))}
                {catTools.length > 3 && (
                  <li class="text-xs text-accent font-medium">+ {catTools.length - 3} more &rarr;</li>
                )}
              </ul>
            </a>
          );
        })}
        <!-- View all card -->
        <a
          href="/calculators"
          class="group block bg-canvas border border-border rounded-card p-5 hover:border-accent hover:bg-surface transition-standard focus-visible:outline-accent flex flex-col items-center justify-center text-center min-h-[140px]"
        >
          <span class="text-2xl font-bold text-accent mb-1">{totalCount}</span>
          <span class="text-sm font-medium text-text-primary group-hover:text-accent transition-standard">View all calculators</span>
          <span class="text-xs text-text-muted mt-1">Search, filter, browse &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- From the Blog -->
  <section class="py-12 bg-canvas border-b border-border" aria-labelledby="blog-preview-heading">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8">
        <div>
          <h2 id="blog-preview-heading" class="text-2xl font-bold text-text-primary mb-1">From the blog</h2>
          <p class="text-sm text-text-muted">Research-backed guides on investments, loans, taxes, and business finance.</p>
        </div>
        <a href="/blog" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-hover transition-standard mt-2 sm:mt-0">
          All guides &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            category: 'Investments',
            icon: '📈',
            title: 'Why a 10% Flat Loan Actually Costs 18% APR',
            desc: 'Most people compare loans by the headline rate. Here\'s why that\'s wrong — and how to calculate the true cost of any loan.',
            href: '/blog/flat-vs-reducing-interest-rate',
            readTime: '6 min read',
          },
          {
            category: 'Taxes',
            icon: '🏛️',
            title: 'New vs Old Tax Regime: Which Saves You More?',
            desc: 'A worked step-by-step comparison using real FY 2025-26 slabs, standard deductions, and the Section 87A rebate.',
            href: '/blog/old-vs-new-tax-regime',
            readTime: '8 min read',
          },
          {
            category: 'Business',
            icon: '📊',
            title: 'Break-Even Analysis: The One Number Every Business Needs',
            desc: 'Fixed costs, variable costs, contribution margin — how to find your break-even point and what it actually means for pricing.',
            href: '/blog/how-to-calculate-break-even-point',
            readTime: '5 min read',
          },
        ].map((post) => (
          <a
            href={post.href}
            class="group block bg-surface border border-border rounded-card p-5 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider flex items-center gap-1">
                <span aria-hidden="true">{post.icon}</span>
                {post.category}
              </span>
              <span class="text-[11px] text-text-muted">{post.readTime}</span>
            </div>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard mb-2 leading-snug">{post.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed line-clamp-2">{post.desc}</p>
            <div class="mt-4 text-xs font-semibold text-accent group-hover:underline">Read article &rarr;</div>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center sm:hidden">
        <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover transition-standard focus-visible:outline-accent">
          All guides &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Why Calcumetrics (Unified Single High-Trust Section) -->
  <section class="py-14 bg-canvas border-b border-border" aria-labelledby="why-heading">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 id="why-heading" class="text-2xl sm:text-3xl font-bold text-text-primary mb-2">Why Calcumetrics</h2>
        <p class="text-sm text-text-muted">Built for investors, students, business owners, and finance professionals who need transparent, reliable calculation tools.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            icon: `<svg class="w-5 h-5 text-accent stroke-current fill-none mb-3" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
            title: 'India & Global Coverage',
            body: 'Specialized calculators for Indian GST, HRA, PPF, and tax regimes, alongside international tools like WACC, DCF, IRR, and 401(k).',
          },
          {
            icon: `<svg class="w-5 h-5 text-accent stroke-current fill-none mb-3" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
            title: 'Every Formula Transparent',
            body: 'The exact formula, variable legend, and worked step-by-step example appear directly on every calculator. Zero black-box calculations.',
          },
          {
            icon: `<svg class="w-5 h-5 text-accent stroke-current fill-none mb-3" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
            title: '100% Client-Side Privacy',
            body: 'All calculations run directly in your web browser. No accounts, no logins, and zero financial data ever sent to any remote server.',
          },
          {
            icon: `<svg class="w-5 h-5 text-accent stroke-current fill-none mb-3" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
            title: 'Test-Driven Accuracy',
            body: 'Every calculation engine is validated with published financial fixtures and current statutory tax amendments before launch.',
          },
        ].map((item) => (
          <div class="bg-surface border border-border rounded-card p-5 hover:border-accent transition-standard">
            <Fragment set:html={item.icon} />
            <h3 class="font-bold text-sm text-text-primary mb-2">{item.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter / Stay Updated Section -->
  <section class="py-14 bg-surface border-b border-border" aria-labelledby="newsletter-heading">
    <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-chip border border-accent/20 bg-accent/5 text-xs font-semibold text-accent mb-4">
        📬 Finance Insights
      </div>
      <h2 id="newsletter-heading" class="text-2xl sm:text-3xl font-bold text-text-primary mb-3 tracking-tight">
        Stay sharp on money matters
      </h2>
      <p class="text-sm text-text-muted mb-8 leading-relaxed max-w-lg mx-auto">
        Get occasional articles on investment strategies, tax updates, and formula breakdowns — no spam, no promotions. Straight to the point.
      </p>
      <form
        id="newsletter-form"
        onsubmit="return false;"
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
        aria-label="Newsletter subscription form"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          inputmode="email"
          autocomplete="email"
          class="flex-1 h-11 px-4 rounded-control border border-border bg-canvas text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-standard"
        />
        <button
          type="submit"
          id="newsletter-submit"
          class="h-11 px-6 rounded-control bg-accent text-white text-sm font-semibold hover:bg-accent-hover transition-standard focus-visible:outline-accent shrink-0"
        >
          Notify me
        </button>
      </form>
      <p class="text-[11px] text-text-muted mt-4">No marketing. Unsubscribe anytime. We respect your inbox.</p>
    </div>
  </section>

  <!-- Closing CTA (Clean copy, no ads claim) -->
  <section class="py-16 bg-dark-bg" aria-labelledby="cta-heading">
    <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-heading" class="text-3xl font-bold tracking-tight text-dark-text mb-4">
        Every formula. Shown and tested.
      </h2>
      <p class="text-sm text-dark-muted mb-8 leading-relaxed">
        {totalCount} free financial calculators for investments, loans, taxes, business and corporate finance. Transparent, reliable, and private.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/calculators" class="inline-flex items-center h-12 px-6 rounded-control bg-dark-accent text-dark-bg text-sm font-semibold hover:opacity-90 transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2">
          Browse all {totalCount} calculators
        </a>
        <a href="/methodology" class="inline-flex items-center h-12 px-6 rounded-control border border-dark-border text-dark-text text-sm font-medium hover:bg-dark-border transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2">
          How it works
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { calcSIP } from '../lib/calculators/sip';
  import { formatIndian, formatIndianCompact, formatIndianWords, formatCompactCurrency } from '../lib/formatters';
  import { getStoredCurrency, CURRENCY_CONFIG, type CurrencyCode } from '../lib/currency';

  function initHeroSIP() {
    const sliderMonthly = document.getElementById('hero-slider-monthly') as HTMLInputElement | null;
    const sliderRate = document.getElementById('hero-slider-rate') as HTMLInputElement | null;
    const sliderYears = document.getElementById('hero-slider-years') as HTMLInputElement | null;

    const valMonthly = document.getElementById('hero-val-monthly');
    const valRate = document.getElementById('hero-val-rate');
    const valYears = document.getElementById('hero-val-years');

    const maturityCompact = document.getElementById('hero-maturity-compact');
    const maturityExact = document.getElementById('hero-maturity-exact');
    const resInvested = document.getElementById('hero-res-invested');
    const resGain = document.getElementById('hero-res-gain');
    const barInvested = document.getElementById('hero-bar-invested');
    const barGain = document.getElementById('hero-bar-gain');
    const insightText = document.getElementById('hero-compounding-insight');
    const fullLink = document.getElementById('hero-full-calculator-btn') as HTMLAnchorElement | null;

    if (!sliderMonthly || !sliderRate || !sliderYears) return;

    // Narrowed non-null slider references for closure
    const monthlyInput = sliderMonthly;
    const rateInput = sliderRate;
    const yearsInput = sliderYears;

    let activeCurrency: CurrencyCode = getStoredCurrency();

    function updateHero() {
      const monthly = parseFloat(monthlyInput.value);
      const rate = parseFloat(rateInput.value);
      const years = parseFloat(yearsInput.value);

      const symbol = CURRENCY_CONFIG[activeCurrency]?.symbol || '₹';

      // Update input labels
      if (valMonthly) {
        valMonthly.textContent = activeCurrency === 'INR'
          ? `₹${formatIndian(monthly)}`
          : `${symbol}${new Intl.NumberFormat('en-US').format(monthly)}`;
      }
      if (valRate) valRate.textContent = `${rate.toFixed(1)}%`;
      if (valYears) valYears.textContent = `${years} yrs`;

      // Run calculation
      const r = calcSIP(monthly, rate, years);

      // Compact format
      const compactMaturity = activeCurrency === 'INR'
        ? formatIndianCompact(r.maturity, '₹')
        : formatCompactCurrency(r.maturity, activeCurrency);

      const exactMaturity = activeCurrency === 'INR'
        ? `(₹${formatIndian(r.maturity)})`
        : `(${symbol}${new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(r.maturity)})`;

      const compactInvested = activeCurrency === 'INR'
        ? formatIndianCompact(r.invested, '₹')
        : formatCompactCurrency(r.invested, activeCurrency);

      const compactGain = activeCurrency === 'INR'
        ? formatIndianCompact(r.gain, '₹')
        : formatCompactCurrency(r.gain, activeCurrency);

      if (maturityCompact) maturityCompact.textContent = compactMaturity;
      if (maturityExact) maturityExact.textContent = exactMaturity;
      if (resInvested) resInvested.textContent = compactInvested;
      if (resGain) resGain.textContent = `+${compactGain}`;

      // Update composition bar
      if (barInvested) barInvested.style.width = `${(r.principalFraction * 100).toFixed(1)}%`;
      if (barGain) barGain.style.width = `${(r.gainFraction * 100).toFixed(1)}%`;

      // Emotional Compounding Insight line
      if (insightText) {
        if (activeCurrency === 'INR') {
          const gainWords = formatIndianWords(r.gain, '₹');
          insightText.textContent = `₹${formatIndian(monthly)}/month over ${years} years yields ${gainWords} in pure compounding gain.`;
        } else {
          insightText.textContent = `${symbol}${new Intl.NumberFormat('en-US').format(monthly)}/month over ${years} years yields ${compactGain} in pure compounding gain.`;
        }
      }

      // Update link to transfer state to full SIP calculator
      if (fullLink) {
        fullLink.href = `/sip-calculator#p=${monthly}&r=${rate}&y=${years}`;
      }
    }

    monthlyInput.addEventListener('input', updateHero);
    rateInput.addEventListener('input', updateHero);
    yearsInput.addEventListener('input', updateHero);

    // Listen to navbar currency switch event to prevent mismatch
    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.code) {
        activeCurrency = e.detail.code;
        updateHero();
      }
    });

    updateHero();
  }

  // Newsletter form — placeholder handler (ready for backend integration)
  function initNewsletter() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
    if (!form || !submitBtn) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (document.getElementById('newsletter-email') as HTMLInputElement)?.value;
      if (!email) return;
      submitBtn.textContent = '✓ You\'re on the list';
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      if (window.__cmShowToast) {
        window.__cmShowToast('Thanks! We\'ll be in touch with finance insights.', 'success');
      }
    });
  }

  initHeroSIP();
  initNewsletter();
  document.addEventListener('astro:page-load', initHeroSIP);
  document.addEventListener('astro:page-load', initNewsletter);
</script>
