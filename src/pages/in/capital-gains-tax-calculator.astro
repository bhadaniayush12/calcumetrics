---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcCapitalGains, type AssetType } from '../../lib/tax/india';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = { sale: 500000, purchase: 300000, months: 24, asset: 'equity' as AssetType };
const initialResult = calcCapitalGains(DEFAULT.sale, DEFAULT.purchase, DEFAULT.months, DEFAULT.asset);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Taxes' && t.slug !== 'capital-gains-tax-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/in/capital-gains-tax-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Capital Gains Tax Calculator India',
      url: canonicalUrl,
      description: 'Free capital gains tax calculator to compute LTCG and STCG under post-Budget 2024 tax rules for equity, mutual funds, and real estate.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'Capital Gains Tax Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What are the capital gains tax rates after Budget 2024?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Effective July 23, 2024, Short-Term Capital Gains (STCG) on listed equity and equity mutual funds are taxed at 20% (Section 111A). Long-Term Capital Gains (LTCG) on all financial and non-financial assets are taxed at 12.5% (Section 112A), with the annual equity LTCG exemption limit increased to ₹1.25 lakh.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is holding period determined for LTCG vs STCG?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the simplified holding period framework, listed equities and equity mutual funds qualify as long-term if held for more than 12 months. All other assets (including real estate, physical gold, and unlisted shares) qualify as long-term if held for more than 24 months.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is indexation benefit still available for real estate?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For properties acquired on or after 23 July 2024, indexation benefit is eliminated and LTCG is taxed at a flat 12.5%. For properties acquired before 23 July 2024 by resident individuals/HUFs, taxpayers can compute tax under both 12.5% without indexation and 20% with indexation, paying whichever is lower.',
          },
        },
        {
          '@type': 'Question',
          name: 'How are debt mutual funds taxed in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Per Section 50AA introduced in Finance Act 2023, gains from mutual funds investing less than 35% in domestic equities (pure debt funds) purchased after 1 April 2023 are treated as deemed short-term capital gains and taxed at the investor applicable slab rate regardless of holding duration.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is Health and Education Cess added to capital gains tax?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, a mandatory 4% Health and Education Cess is levied on the aggregate amount of capital gains income tax and applicable surcharge.',
          },
        },
      ],
    },
  ],
};

const ASSET_OPTIONS = [
  { value: 'equity', label: 'Listed Equity Shares / Equity Mutual Funds' },
  { value: 'real-estate', label: 'Immovable Property (Real Estate)' },
  { value: 'gold', label: 'Physical Gold / Gold ETFs / SGBs' },
  { value: 'debt-fund', label: 'Debt Mutual Funds (Taxed at Slab Rate)' },
];
---

<Layout
  title="Capital Gains Tax Calculator: LTCG & STCG | Calcumetrics"
  description="Free capital gains tax calculator India. Compute LTCG and STCG under post-Budget 2024 rules (12.5% LTCG, 20% STCG) for stocks, mutual funds & property."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Capital Gains Tax Calculator"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(initialResult.totalTax)}
    heroLabel="Estimated Capital Gains Tax"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">Capital Gains Tax Calculator: FY 2026-27</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory source: <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Income Tax Department (CBDT)</a> · Sections 111A, 112, 112A.
      </p>

      <!-- Surcharge Disclaimer (§18) -->
      <div class="mb-5 p-3 rounded-card bg-amber-500/10 border border-amber-500/20 text-xs text-text-muted leading-relaxed">
        <strong class="text-amber-700 dark:text-amber-400 font-semibold block mb-0.5">⚠️ Surcharge Disclaimer:</strong>
        Computations calculate 12.5% LTCG, 20% STCG, ₹1.25 Lakh exemption, and 4% Health & Education Cess. <strong>Surcharge on taxable capital gains where total taxable income exceeds ₹50 Lakh (capped at 15% for Section 111A/112A) is not modeled.</strong>
      </div>

      <!-- Error alert -->
      <div id="cgt-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="cgt-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Asset Type -->
      <div class="mb-5">
        <Dropdown
          id="cgt-asset"
          label="Asset Category"
          options={ASSET_OPTIONS}
          value="equity"
          helperText="Determines statutory LTCG threshold and applicable tax rate"
        />
      </div>

      <!-- Sale Price -->
      <div class="mb-5">
        <Input
          id="cgt-sale"
          label="Selling Price / Total Consideration"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross value realized upon sale or redemption"
          inputmode="decimal"
          aria-describedby="cgt-error-msg"
        />
        <div class="mt-2">
          <Slider id="cgt-sale-slider" min={10000} max={5000000} step={10000} value={500000} ariaLabel="Selling price slider" />
        </div>
      </div>

      <!-- Purchase Price -->
      <div class="mb-5">
        <Input
          id="cgt-purchase"
          label="Purchase Price / Cost of Acquisition"
          prefix="₹"
          value="3,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Original cost incurred to buy the asset"
          inputmode="decimal"
          aria-describedby="cgt-error-msg"
        />
        <div class="mt-2">
          <Slider id="cgt-purchase-slider" min={10000} max={5000000} step={10000} value={300000} ariaLabel="Purchase price slider" />
        </div>
      </div>

      <!-- Holding Period -->
      <div class="mb-6">
        <Input
          id="cgt-months"
          label="Holding Period (Months)"
          suffix="Months"
          value="24"
          isNumeric={true}
          helperText="Total months held from acquisition date to transfer date"
          inputmode="numeric"
          aria-describedby="cgt-error-msg"
        />
        <div class="mt-2">
          <Slider id="cgt-months-slider" min={1} max={120} step={1} value={24} ariaLabel="Holding period slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="cgt-calculate" type="button">Calculate Capital Gains Tax</Button>
        <Button variant="ghost" id="cgt-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Total Tax Liability (with Cess)</span>
        <div id="cgt-result-tax" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.totalTax)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Gain After Tax</span>
          <span id="cgt-result-netgain" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.netGain)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Capital Gain</span>
          <span id="cgt-result-gain" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.gain)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gain Classification</span>
          <span id="cgt-result-type" class="text-sm font-bold tabular-nums text-dark-text">{initialResult.gainType}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Applicable Tax Rate</span>
          <span id="cgt-result-rate" class="text-sm font-medium tabular-nums text-dark-text">{initialResult.taxRatePct}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Health & Education Cess (4%)</span>
          <span id="cgt-result-cess" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.cess)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Statutory Provision</span>
          <span id="cgt-result-section" class="text-xs font-mono text-dark-muted">Section {initialResult.section}</span>
        </div>
      </div>

      <div class="mb-5" id="cgt-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.gain > 0 ? initialResult.netGain / initialResult.gain : 1}
          gainFraction={initialResult.gain > 0 ? initialResult.totalTax / initialResult.gain : 0}
          principalLabel="Net Retained Gain"
          gainLabel="Tax Paid"
          principalValue={fmt(initialResult.netGain)}
          gainValue={fmt(initialResult.totalTax)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="cgt-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="cgt-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Reflects Budget 2024 changes: 20% STCG, 12.5% LTCG with ₹1.25L annual exemption on equity. Debt fund slab estimate uses 30% conservative rate.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="cgt-calculator-how">
        <h2 id="cgt-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Indian Capital Gains Taxation Works (Post-Budget 2024)</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Capital gains tax is levied under Chapter IV-E (Sections 45 to 55A) of the Indian Income-tax Act, 1961, upon profits realized from the transfer of a capital asset. The Finance (No. 2) Act, 2024, enacted a historic structural overhaul of India's capital gains regime (effective July 23, 2024), standardizing holding periods and tax rates across asset classes while removing indexation benefits.
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed font-mono">
            <strong>1. Total Capital Gain:</strong> Gain = Full Value of Consideration (Sale Price) &minus; Cost of Acquisition &minus; Transfer Expenses<br /><br />
            <strong>2. Holding Period Classification:</strong><br />
            &bull; Listed Equities &amp; Equity Mutual Funds: Short-Term if &le;12 months; Long-Term if &gt;12 months.<br />
            &bull; Real Estate, Physical Gold &amp; Unlisted Shares: Short-Term if &le;24 months; Long-Term if &gt;24 months.<br />
            &bull; Debt Mutual Funds (&lt;35% equity): Deemed Short-Term under Section 50AA regardless of holding duration.<br /><br />
            <strong>3. Statutory Tax Rates (Budget 2024):</strong><br />
            &bull; Section 111A (Equity STCG): Flat 20.00% (raised from 15%).<br />
            &bull; Section 112A (Equity LTCG): Flat 12.50% (raised from 10%) on gains exceeding annual exemption threshold of ₹1,25,000.<br />
            &bull; Section 112 (Non-Equity LTCG): Flat 12.50% without indexation for assets acquired post-July 23, 2024.<br /><br />
            <strong>4. Final Tax Obligation (with Cess):</strong> Total Tax = [ Base Tax Amount &times; 1.04 ] (reflecting mandatory 4% Health &amp; Education Cess)<br /><br />
            <strong>5. Net Retained Capital Gain:</strong> Net Realized Gain = Total Capital Gain &minus; Total Tax
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-Step Worked Example (Default Scenario)</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an investor who sells listed equity mutual fund units for <strong>₹5,00,000</strong> after holding them for <strong>24 months</strong>, having originally purchased them for <strong>₹3,00,000</strong>:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-surface border-b border-border text-text-primary font-semibold">
                <th class="py-2.5 px-4">Statutory Step / Component</th>
                <th class="py-2.5 px-4">Legal Basis / Calculation</th>
                <th class="py-2.5 px-4">Computed Output</th>
                <th class="py-2.5 px-4">Regulatory Explanation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Full Sale Consideration</td>
                <td class="py-2.5 px-4 font-mono">Gross Redemption Value</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹5,00,000</td>
                <td class="py-2.5 px-4">Total gross value realized upon redemption of units.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Cost of Acquisition</td>
                <td class="py-2.5 px-4 font-mono">Original Purchase Capital</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹3,00,000</td>
                <td class="py-2.5 px-4">Original purchase price paid by investor.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Total Gross Capital Gain</td>
                <td class="py-2.5 px-4 font-mono">₹5,00,000 &minus; ₹3,00,000</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹2,00,000</td>
                <td class="py-2.5 px-4">Gross capital profit before exemptions and deductions.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Classification &amp; Governing Section</td>
                <td class="py-2.5 px-4 font-mono">24 Months &gt; 12-Month Threshold</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">LTCG (Section 112A)</td>
                <td class="py-2.5 px-4">Exceeds the 12-month statutory threshold for listed equities/mutual funds.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Annual Statutory Exemption</td>
                <td class="py-2.5 px-4 font-mono">Finance Act 2024 Threshold</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">&minus;₹1,25,000</td>
                <td class="py-2.5 px-4">Expanded from ₹1,00,000 to ₹1,25,000 per financial year under Section 112A.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Net Taxable Capital Gain</td>
                <td class="py-2.5 px-4 font-mono">₹2,00,000 &minus; ₹1,25,000</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹75,000</td>
                <td class="py-2.5 px-4">Portion of capital gain subject to tax.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Base LTCG Tax (12.50%)</td>
                <td class="py-2.5 px-4 font-mono">₹75,000 &times; 12.50%</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹9,375</td>
                <td class="py-2.5 px-4">Rationalized uniform rate under Section 112A (formerly 10%).</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Health &amp; Education Cess (4%)</td>
                <td class="py-2.5 px-4 font-mono">₹9,375 &times; 4.00%</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">₹375</td>
                <td class="py-2.5 px-4">Statutory cess levied on all income tax liabilities under Indian tax law.</td>
              </tr>
              <tr class="bg-surface/50 font-semibold text-text-primary">
                <td class="py-2.5 px-4">Total Capital Gains Tax Payable</td>
                <td class="py-2.5 px-4 font-mono">₹9,375 + ₹375</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹9,750</td>
                <td class="py-2.5 px-4">Final tax liability payable via advance tax or self-assessment tax.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">Net Retained Gain (After Tax)</td>
                <td class="py-3 px-4 font-mono">₹2,00,000 &minus; ₹9,750</td>
                <td class="py-3 px-4 font-mono font-bold text-text-primary">₹1,90,250 (95.12%)</td>
                <td class="py-3 px-4">Effective tax rate on gross capital gain is just 4.88% due to the ₹1.25L exemption.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Asset Class Comparison (Post-July 23, 2024)</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Listed Equity &amp; Equity Funds:</strong> STCG (&le;12 mos) taxed at <strong>20.00%</strong> (Sec 111A). LTCG (&gt;12 mos) taxed at <strong>12.50%</strong> above <strong>₹1.25 Lakh</strong> exemption (Sec 112A).</li>
              <li><strong>Immovable Property (Real Estate):</strong> STCG (&le;24 mos) taxed at individual slab rates. LTCG (&gt;24 mos) taxed at <strong>12.50% without indexation</strong> for transfers post-July 23, 2024.</li>
              <li><strong>Physical Gold &amp; Gold ETFs:</strong> STCG (&le;24 mos) taxed at slab rate. LTCG (&gt;24 mos) taxed at <strong>12.50%</strong> without indexation.</li>
              <li><strong>Debt Mutual Funds (Sec 50AA):</strong> Funds with &le;35% equity acquired on/after April 1, 2023 are deemed STCG and taxed at marginal income tax slab rates regardless of holding period.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Exemptions &amp; Tax Reinvestment Options</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              Taxpayers can legally eliminate or reduce long-term capital gains tax by reinvesting profits under statutory exemption sections:
            </p>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Section 54 (Residential House):</strong> Reinvest LTCG from sale of a residential house into acquiring another residential house in India within 1 year before or 2 years after sale (3 years for construction).</li>
              <li><strong>Section 54F (Any Non-House Asset):</strong> Reinvest the <em>net sale consideration</em> from equity, gold, or land into one residential property.</li>
              <li><strong>Section 54EC (Capital Gains Bonds):</strong> Invest up to <strong>₹50,00,000</strong> within 6 months of sale in specified bonds (REC, PFC, NHAI) with a 5-year lock-in period.</li>
              <li><strong>Capital Gains Account Scheme (CGAS):</strong> If unutilized before the ITR filing due date (July 31), deposit funds into a CGAS account to claim exemption.</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Loss Set-Off &amp; Carry-Forward Framework</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Short-Term Capital Loss (STCL):</strong> Can be set off against both Short-Term and Long-Term Capital Gains in the same assessment year.</li>
            <li><strong>Long-Term Capital Loss (LTCL):</strong> Can strictly be set off <em>only</em> against Long-Term Capital Gains; it cannot offset STCG or any other head of income.</li>
            <li><strong>Carry-Forward Window:</strong> Unabsorbed capital losses can be carried forward for up to <strong>8 assessment years</strong>, provided the Income Tax Return (ITR) is filed on or before the statutory due date under Section 139(1).</li>
            <li><strong>Surcharge Cap:</strong> Surcharge on capital gains arising under Sections 111A and 112A is statutorily capped at <strong>15.00%</strong>, even for high-net-worth individuals in the highest income brackets.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Selling property bought before July 23, 2024?</strong>
        Learn how the dual indexation option works and see a step-by-step worked comparison in our in-depth guide: <a href="/blog/capital-gains-tax-rules" class="text-accent font-medium hover:underline">Capital Gains Tax in India (Post-Budget 2024): Rates, Holding Periods, and the Real Estate Indexation Rule</a>.
      </div>

      <section aria-labelledby="cgt-calculator-faq">
        <h2 id="cgt-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="cgt-calculator-related">
        <h2 id="cgt-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related tax calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/in/income-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Income Tax Calculator (India)</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Compare Old vs New Tax Regime tax liability per Finance Act 2024-25.</p>
          </a>
          <a href="/in/advance-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Advance Tax Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Calculate quarterly advance tax installments and Section 234B/234C interest liability.</p>
          </a>
          <a href="/in/tds-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">TDS Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Determine Tax Deducted at Source withholding amounts across commercial and professional sections.</p>
          </a>
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcCapitalGains, type AssetType } from '../../lib/tax/india';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initCGTCalc() {
    if ((window as any).__cmCgtBound) return;
    (window as any).__cmCgtBound = true;

    const saleInput = document.getElementById('cgt-sale') as HTMLInputElement | null;
    const purchaseInput = document.getElementById('cgt-purchase') as HTMLInputElement | null;
    const monthsInput = document.getElementById('cgt-months') as HTMLInputElement | null;
    const assetSelect = document.getElementById('cgt-asset') as HTMLSelectElement | null;

    const saleSlider = document.getElementById('cgt-sale-slider') as HTMLInputElement | null;
    const purchaseSlider = document.getElementById('cgt-purchase-slider') as HTMLInputElement | null;
    const monthsSlider = document.getElementById('cgt-months-slider') as HTMLInputElement | null;

    const resTax = document.getElementById('cgt-result-tax');
    const resNetGain = document.getElementById('cgt-result-netgain');
    const resGain = document.getElementById('cgt-result-gain');
    const resType = document.getElementById('cgt-result-type');
    const resRate = document.getElementById('cgt-result-rate');
    const resCess = document.getElementById('cgt-result-cess');
    const resSection = document.getElementById('cgt-result-section');

    const errAlert = document.getElementById('cgt-error-alert');
    const errMsg = document.getElementById('cgt-error-msg');

    if (!saleInput || !purchaseInput || !monthsInput || !assetSelect) return;

    const DEFAULTS = { sale: 500000, purchase: 300000, months: 24, asset: 'equity' as AssetType };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawSale = saleInput!.value.replace(/[^0-9.]/g, '');
      const rawPurchase = purchaseInput!.value.replace(/[^0-9.]/g, '');
      const rawMonths = monthsInput!.value.replace(/[^0-9.]/g, '');
      const asset = assetSelect!.value as AssetType;

      const vSale = validate(rawSale, { required: true, min: 0, label: 'Sale Price' });
      const vPurchase = validate(rawPurchase, { required: true, min: 0, label: 'Purchase Price' });
      const vMonths = validate(rawMonths, { required: true, min: 1, max: 600, integer: true, label: 'Holding Period' });

      if (!vSale.valid) { showError(vSale.error!.message); return; }
      if (!vPurchase.valid) { showError(vPurchase.error!.message); return; }
      if (!vMonths.valid) { showError(vMonths.error!.message); return; }
      clearError();

      const sale = vSale.value!;
      const purchase = vPurchase.value!;
      const months = vMonths.value!;

      const res = calcCapitalGains(sale, purchase, months, asset);

      setResult({
        heroValue: fmtVal(res.totalTax),
        heroLabel: 'Estimated Capital Gains Tax',
        rows: [
          { label: 'Net Gain After Tax', value: fmtVal(res.netGain) },
          { label: 'Total Capital Gain', value: fmtVal(res.gain) },
          { label: 'Gain Type', value: res.gainType },
          { label: 'Tax Rate', value: `${res.taxRatePct}%` },
          { label: 'Cess (4%)', value: fmtVal(res.cess) },
          { label: 'Statutory Section', value: res.section },
        ],
      });

      if (resTax) resTax.textContent = fmtVal(res.totalTax);
      if (resNetGain) resNetGain.textContent = fmtVal(res.netGain);
      if (resGain) resGain.textContent = fmtVal(res.gain);
      if (resType) resType.textContent = res.gainType;
      if (resRate) resRate.textContent = `${res.taxRatePct}%`;
      if (resCess) resCess.textContent = fmtVal(res.cess);
      if (resSection) resSection.textContent = `Section ${res.section}`;

      const wrapper = document.getElementById('cgt-composition-wrapper');
      if (wrapper && res.gain > 0) {
        const retainedPct = Math.max(0, Math.min(100, (res.netGain / res.gain) * 100));
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${retainedPct.toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.netGain);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalTax);
      }

      serializeHash({ s: sale, p: purchase, m: months, a: asset });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(saleSlider, saleInput, true);
    sync(purchaseSlider, purchaseInput, true);
    sync(monthsSlider, monthsInput, false);
    assetSelect.addEventListener('change', recalc);

    document.getElementById('cgt-calculate')?.addEventListener('click', recalc);
    document.getElementById('cgt-reset')?.addEventListener('click', () => {
      saleInput.value = fmtLiveInput(String(DEFAULTS.sale));
      purchaseInput.value = fmtLiveInput(String(DEFAULTS.purchase));
      monthsInput.value = String(DEFAULTS.months);
      assetSelect.value = DEFAULTS.asset;
      if (saleSlider) {
        saleSlider.value = String(DEFAULTS.sale);
        saleSlider.style.setProperty('--slider-pct', `${((DEFAULTS.sale - 10000) / (5000000 - 10000)) * 100}%`);
      }
      if (purchaseSlider) {
        purchaseSlider.value = String(DEFAULTS.purchase);
        purchaseSlider.style.setProperty('--slider-pct', `${((DEFAULTS.purchase - 10000) / (5000000 - 10000)) * 100}%`);
      }
      if (monthsSlider) {
        monthsSlider.value = String(DEFAULTS.months);
        monthsSlider.style.setProperty('--slider-pct', `${((DEFAULTS.months - 1) / (120 - 1)) * 100}%`);
      }
      clearError();
      recalc();
      saleInput.focus();
    });

    [saleInput, purchaseInput, monthsInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('cgt-copy-btn')?.addEventListener('click', async () => {
      const rawSale = saleInput.value.replace(/[^0-9.]/g, '');
      const rawPurchase = purchaseInput.value.replace(/[^0-9.]/g, '');
      const rawMonths = monthsInput.value.replace(/[^0-9.]/g, '');
      const asset = assetSelect.value as AssetType;

      const vSale = validate(rawSale, { required: true, min: 0, label: 'Sale' });
      const vPurchase = validate(rawPurchase, { required: true, min: 0, label: 'Purchase' });
      const vMonths = validate(rawMonths, { required: true, min: 1, label: 'Months' });

      if (!vSale.valid || !vPurchase.valid || !vMonths.valid) return;

      const res = calcCapitalGains(vSale.value!, vPurchase.value!, vMonths.value!, asset);
      const text = `Capital Gains Tax (${res.gainType}): ${fmtVal(res.totalTax)} on gain of ${fmtVal(res.gain)} (Net retained: ${fmtVal(res.netGain)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('cgt-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('cgt-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('cgt-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      s: { required: true, min: 0, label: 's' },
      p: { required: true, min: 0, label: 'p' },
      m: { required: true, min: 1, max: 600, integer: true, label: 'm' },
    });
    if (restored.valid && restored.values.s !== undefined && restored.values.p !== undefined && restored.values.m) {
      saleInput.value = fmtLiveInput(String(restored.values.s));
      purchaseInput.value = fmtLiveInput(String(restored.values.p));
      monthsInput.value = String(restored.values.m);
      const hashParams = new URLSearchParams(readCurrentHash().replace(/^#/, ''));
      const a = hashParams.get('a');
      if (a && ['equity', 'real-estate', 'gold', 'debt-fund'].includes(a)) {
        assetSelect.value = a;
      }
      recalc();
    } else {
      recalc();
    }
  }

  initCGTCalc();
  document.addEventListener('astro:page-load', initCGTCalc);
</script>
