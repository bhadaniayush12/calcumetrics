---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcIncomeTax } from '../../lib/calculators/income-tax';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = {
  grossIncome: 1200000,
  ded80C: 150000,
  ded80D: 25000,
  otherDed: 50000,
};

const result = calcIncomeTax(DEFAULT.grossIncome, DEFAULT.ded80C, DEFAULT.ded80D, DEFAULT.otherDed);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Taxes' && t.slug !== 'income-tax-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/in/income-tax-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Income Tax Calculator (India)',
      url: canonicalUrl,
      description: 'Compare New Tax Regime (Budget 2024 / FY 2024-25 / AY 2025-26) vs Old Tax Regime. Calculate total tax liability, Section 87A rebate, standard deduction, and identify your optimal tax regime.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'Income Tax Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What are the major changes in the New Tax Regime under Budget 2024?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Budget 2024 increased the standard deduction for salaried employees from ₹50,000 to ₹75,000 under the New Tax Regime and widened the income slabs: 0-3L (Nil), 3-7L (5%), 7-10L (10%), 10-12L (15%), 12-15L (20%), and above 15L (30%).',
          },
        },
        {
          '@type': 'Question',
          name: 'How does the Section 87A tax rebate work in the New Tax Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the New Tax Regime, resident individuals with total taxable income up to ₹7,00,000 receive a 100% tax rebate under Section 87A. Combined with the ₹75,000 standard deduction, salaried employees earning up to ₹7,75,000 pay zero income tax.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I claim deductions like 80C, 80D, and HRA in the New Tax Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Chapter VI-A deductions such as Section 80C (EPF, PPF, ELSS), Section 80D (health insurance), Section 24(b) (home loan interest on self-occupied property), and HRA exemptions are only available under the Old Tax Regime.',
          },
        },
        {
          '@type': 'Question',
          name: 'When is the Old Tax Regime still better than the New Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Old Tax Regime can be advantageous for taxpayers who claim substantial deductions exceeding ₹3.75 lakh to ₹4.25 lakh, such as the ₹1.5L 80C cap, ₹2L home loan interest, ₹50k-₹1L health insurance, and large HRA exemptions.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is the 4% Health and Education Cess applicable to both tax regimes?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. A mandatory 4% Health and Education Cess is calculated on the aggregate of income tax after applying the Section 87A rebate under both the New and Old Tax Regimes.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Income Tax Calculator: New vs Old Regime (Budget 2024) | Calcumetrics"
  description="Compare New Tax Regime (Budget 2024) vs Old Tax Regime. Calculate total tax, Section 87A rebate, standard deduction, and discover your highest annual tax savings."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Income Tax Calculator (India)"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(result.newRegime.totalTax)}
    heroLabel="New Regime Tax"
    calcType="dual-comparison"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Income Tax Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Compare New Tax Regime (Budget 2024 / FY 2024-25) with Old Regime to maximize your annual tax savings.</p>

      <!-- Dynamic validation error alert -->
      <div id="it-error-alert" class="hidden mb-5">
        <Alert variant="error" title="Input Error">
          <span id="it-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <!-- Gross Annual Income -->
      <div class="mb-5">
        <Input
          id="it-gross"
          label="Gross Annual Income (Salary / CTC / Business)"
          prefix="₹"
          value="12,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total annual earnings before standard deduction or exemptions"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-gross-slider" min={300000} max={10000000} step={25000} value={1200000} ariaLabel="Gross income slider" />
        </div>
      </div>

      <!-- Section 80C -->
      <div class="mb-5">
        <Input
          id="it-80c"
          label="Section 80C Deductions (Old Regime only)"
          prefix="₹"
          value="1,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="EPF, PPF, ELSS, Life Insurance, Home Loan Principal (Max ₹1.5L)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-80c-slider" min={0} max={150000} step={5000} value={150000} ariaLabel="80C deductions slider" />
        </div>
      </div>

      <!-- Section 80D -->
      <div class="mb-5">
        <Input
          id="it-80d"
          label="Section 80D Health Insurance (Old Regime only)"
          prefix="₹"
          value="25,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Medical insurance premiums for self, family, and parents (Max ₹1L)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-80d-slider" min={0} max={100000} step={5000} value={25000} ariaLabel="80D health insurance slider" />
        </div>
      </div>

      <!-- Other Deductions -->
      <div class="mb-6">
        <Input
          id="it-other"
          label="Other Deductions (HRA, Home Loan Interest Sec 24b, NPS 80CCD)"
          prefix="₹"
          value="50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Eligible Chapter VI-A deductions and allowances (Old Regime only)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-other-slider" min={0} max={500000} step={10000} value={50000} ariaLabel="Other deductions slider" />
        </div>
      </div>

      <Alert variant="info" title="Budget 2024 Update (FY 2024-25 / AY 2025-26)">
        Standard deduction under the New Tax Regime is increased to <strong>₹75,000</strong>. Income up to <strong>₹7.75 Lakh</strong> is 100% tax-free after the Section 87A rebate.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="it-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="it-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Recommended Option</span>
        <div id="it-result-rec" class="text-2xl font-bold tabular-nums text-dark-accent" aria-live="polite">
          {result.recommendedRegime === 'Equal' ? 'Both Regimes Equal' : `${result.recommendedRegime} (Save ${fmt(result.taxSavings)})`}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Tax (Budget 2024)</span>
          <span id="it-result-newtax" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(result.newRegime.totalTax)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Old Regime Tax</span>
          <span id="it-result-oldtax" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(result.oldRegime.totalTax)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Standard Deduction</span>
          <span class="text-sm font-medium tabular-nums text-dark-accent">₹75,000</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Old Regime Total Deductions</span>
          <span id="it-result-old-deductions" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.oldRegime.totalDeductions)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Annual Take-Home</span>
          <span id="it-result-newtakehome" class="text-sm font-semibold tabular-nums text-dark-accent">{fmt(result.newRegime.takeHomeIncome)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Old Regime Annual Take-Home</span>
          <span id="it-result-oldtakehome" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.oldRegime.takeHomeIncome)}</span>
        </div>
      </div>

      <div class="mb-5" id="it-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.grossIncome > 0 ? result.newRegime.takeHomeIncome / DEFAULT.grossIncome : 1}
          gainFraction={DEFAULT.grossIncome > 0 ? result.newRegime.totalTax / DEFAULT.grossIncome : 0}
          principalLabel="Take-Home Pay"
          gainLabel="Income Tax"
          principalValue={fmt(result.newRegime.takeHomeIncome)}
          gainValue={fmt(result.newRegime.totalTax)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="it-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="it-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Tax computations include applicable Section 87A rebate and 4% Health & Education Cess for FY 2024-25 / AY 2025-26.</p>
    </Fragment>

    <Fragment slot="below">
      <!-- Slab Comparison Section -->
      <section aria-labelledby="tax-slabs-comparison">
        <h2 id="tax-slabs-comparison" class="text-xl font-bold text-text-primary mb-4">New vs Old Tax Regime Slabs (FY 2024-25)</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="p-3">New Tax Regime Slabs (Budget 2024)</th>
                <th class="p-3">Rate</th>
                <th class="p-3">Old Tax Regime Slabs</th>
                <th class="p-3">Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="p-3">Up to ₹3,00,000</td>
                <td class="p-3 font-medium text-text-primary">Nil</td>
                <td class="p-3">Up to ₹2,50,000</td>
                <td class="p-3 font-medium text-text-primary">Nil</td>
              </tr>
              <tr>
                <td class="p-3">₹3,00,001 to ₹7,00,000</td>
                <td class="p-3 font-medium text-text-primary">5%</td>
                <td class="p-3">₹2,50,001 to ₹5,00,000</td>
                <td class="p-3 font-medium text-text-primary">5%</td>
              </tr>
              <tr>
                <td class="p-3">₹7,00,001 to ₹10,00,000</td>
                <td class="p-3 font-medium text-text-primary">10%</td>
                <td class="p-3">₹5,00,001 to ₹10,00,000</td>
                <td class="p-3 font-medium text-text-primary">20%</td>
              </tr>
              <tr>
                <td class="p-3">₹10,00,001 to ₹12,00,000</td>
                <td class="p-3 font-medium text-text-primary">15%</td>
                <td class="p-3">Above ₹10,00,000</td>
                <td class="p-3 font-medium text-text-primary">30%</td>
              </tr>
              <tr>
                <td class="p-3">₹12,00,001 to ₹15,00,000</td>
                <td class="p-3 font-medium text-text-primary">20%</td>
                <td class="p-3">—</td>
                <td class="p-3">—</td>
              </tr>
              <tr>
                <td class="p-3">Above ₹15,00,000</td>
                <td class="p-3 font-medium text-text-primary">30%</td>
                <td class="p-3">—</td>
                <td class="p-3">—</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Worked Example -->
      <section aria-labelledby="tax-example" class="mt-8">
        <h2 id="tax-example" class="text-xl font-bold text-text-primary mb-4">Worked Example: Salaried Employee at ₹12 Lakh CTC</h2>
        <div class="bg-surface border border-border rounded-card p-5 space-y-3 text-sm text-text-muted leading-relaxed">
          <p>
            Consider a salaried employee in Bengaluru earning a gross annual CTC of <strong>₹12,00,000</strong>. The employee invests <strong>₹1,50,000</strong> in EPF/PPF (Section 80C), pays <strong>₹25,000</strong> in family medical insurance (Section 80D), and claims <strong>₹50,000</strong> in other allowances:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="bg-canvas border border-border p-4 rounded">
              <h3 class="font-bold text-text-primary mb-2">New Tax Regime (Budget 2024)</h3>
              <ul class="list-disc pl-5 space-y-1 text-xs">
                <li>Gross Salary: ₹12,00,000</li>
                <li>Standard Deduction: &minus;₹75,000</li>
                <li>Taxable Income: <strong>₹11,25,000</strong></li>
                <li>3L-7L (5%): ₹20,000</li>
                <li>7L-10L (10%): ₹30,000</li>
                <li>10L-11.25L (15%): ₹18,750</li>
                <li>Base Tax: ₹68,750</li>
                <li>4% Cess: ₹2,750</li>
                <li><strong>Total Tax: ₹71,500</strong></li>
              </ul>
            </div>
            <div class="bg-canvas border border-border p-4 rounded">
              <h3 class="font-bold text-text-primary mb-2">Old Tax Regime</h3>
              <ul class="list-disc pl-5 space-y-1 text-xs">
                <li>Gross Salary: ₹12,00,000</li>
                <li>Standard Deduction: &minus;₹50,000</li>
                <li>80C + 80D + Other: &minus;₹2,25,000</li>
                <li>Taxable Income: <strong>₹9,25,000</strong></li>
                <li>2.5L-5L (5%): ₹12,500</li>
                <li>5L-9.25L (20%): ₹85,000</li>
                <li>Base Tax: ₹97,500</li>
                <li>4% Cess: ₹3,900</li>
                <li><strong>Total Tax: ₹1,01,400</strong></li>
              </ul>
            </div>
          </div>
          <p class="pt-2 font-medium text-text-primary">
            Outcome: The New Tax Regime reduces annual income tax from ₹1,01,400 down to ₹71,500, delivering a net tax savings of <strong>₹29,900</strong> per year.
          </p>
        </div>
      </section>

      <!-- Assumptions & Limitations -->
      <section aria-labelledby="tax-assumptions" class="mt-8">
        <h2 id="tax-assumptions" class="text-xl font-bold text-text-primary mb-4">Key Assumptions and Legal Notes</h2>
        <div class="bg-surface border border-border rounded-card p-5 space-y-2 text-sm text-text-muted leading-relaxed">
          <p>• <strong>Applicable Assessment Year:</strong> Computations reflect provisions of the Finance (No. 2) Act, 2024 applicable for Financial Year 2024-25 (Assessment Year 2025-26).</p>
          <p>• <strong>Resident Status:</strong> Assumes the taxpayer is an individual tax resident of India below 60 years of age.</p>
          <p>• <strong>Standard Deduction:</strong> The ₹75,000 standard deduction under the New Tax Regime is available exclusively for salaried individuals and pensioners, not business professionals.</p>
          <p>• <strong>Surcharge:</strong> High-net-worth surcharge (>₹50L income) is omitted in standard salary ranges. Consult a Chartered Accountant for complex income portfolios.</p>
        </div>
      </section>

      <!-- FAQ Section -->
      <section aria-labelledby="tax-faq" class="mt-8">
        <h2 id="tax-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">What are the major changes in the New Tax Regime under Budget 2024?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Budget 2024 increased the standard deduction for salaried employees from ₹50,000 to ₹75,000 under the New Tax Regime and widened the income slabs: 0-3L (Nil), 3-7L (5%), 7-10L (10%), 10-12L (15%), 12-15L (20%), and above 15L (30%).
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">How does the Section 87A tax rebate work in the New Tax Regime?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Under the New Tax Regime, resident individuals with total taxable income up to ₹7,00,000 receive a 100% tax rebate under Section 87A. Combined with the ₹75,000 standard deduction, salaried employees earning up to ₹7,75,000 pay zero income tax.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Can I claim deductions like 80C, 80D, and HRA in the New Tax Regime?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              No. Chapter VI-A deductions such as Section 80C (EPF, PPF, ELSS), Section 80D (health insurance), Section 24(b) (home loan interest on self-occupied property), and HRA exemptions are only available under the Old Tax Regime.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">When is the Old Tax Regime still better than the New Regime?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              The Old Tax Regime can be advantageous for taxpayers who claim substantial deductions exceeding ₹3.75 lakh to ₹4.25 lakh, such as the ₹1.5L 80C cap, ₹2L home loan interest, ₹50k-₹1L health insurance, and large HRA exemptions.
            </div>
          </details>
          <details class="border border-border rounded-card overflow-hidden">
            <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">Is the 4% Health and Education Cess applicable to both tax regimes?</summary>
            <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
              Yes. A mandatory 4% Health and Education Cess is calculated on the aggregate of income tax after applying the Section 87A rebate under both the New and Old Tax Regimes.
            </div>
          </details>
        </div>
      </section>

      <!-- Related Calculators -->
      <section aria-labelledby="tax-related" class="mt-8">
        <h2 id="tax-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { validate } from '../../lib/validate';
  import { serializeHash, restoreFromHash, updateHash, readCurrentHash } from '../../lib/url-state';
  import { setResult } from '../../lib/result-bus';
  import { calcIncomeTax } from '../../lib/calculators/income-tax';

  // Strict India Currency Lock: Income Tax is an India-only calculator.
  // Must NOT change when global currency switcher changes.
  const currSym = '₹';
  const currLocale = 'en-IN';

  function fmtVal(n: number) {
    if (!isFinite(n)) return 'N/A';
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }

  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  const itSchema = {
    g: { required: true, min: 0, max: 1000000000, decimal: true, label: 'Gross Annual Income' },
    c: { required: true, min: 0, max: 150000, decimal: true, label: 'Section 80C' },
    d: { required: true, min: 0, max: 100000, decimal: true, label: 'Section 80D' },
    o: { required: true, min: 0, max: 100000000, decimal: true, label: 'Other Deductions' },
  };

  function initITCalc() {
    const grossInput = document.getElementById('it-gross') as HTMLInputElement | null;
    const c80Input = document.getElementById('it-80c') as HTMLInputElement | null;
    const d80Input = document.getElementById('it-80d') as HTMLInputElement | null;
    const otherInput = document.getElementById('it-other') as HTMLInputElement | null;

    const grossSlider = document.getElementById('it-gross-slider') as HTMLInputElement | null;
    const c80Slider = document.getElementById('it-80c-slider') as HTMLInputElement | null;
    const d80Slider = document.getElementById('it-80d-slider') as HTMLInputElement | null;
    const otherSlider = document.getElementById('it-other-slider') as HTMLInputElement | null;

    const resRec = document.getElementById('it-result-rec');
    const resNewTax = document.getElementById('it-result-newtax');
    const resOldTax = document.getElementById('it-result-oldtax');
    const resOldDed = document.getElementById('it-result-old-deductions');
    const resNewTH = document.getElementById('it-result-newtakehome');
    const resOldTH = document.getElementById('it-result-oldtakehome');
    const mobileHero = document.getElementById('calc-mobile-hero');

    const errorAlert = document.getElementById('it-error-alert');
    const errorMsg = document.getElementById('it-error-msg');

    if (!grossInput) return;

    const DEFAULTS = { gross: 1200000, c80: 150000, d80: 25000, other: 50000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errorAlert && errorMsg) {
        errorMsg.textContent = msg;
        errorAlert.classList.remove('hidden');
      }
    }

    function hideError() {
      if (errorAlert) {
        errorAlert.classList.add('hidden');
      }
    }

    function recalc() {
      const valG = validate(grossInput.value, itSchema.g);
      const valC = validate(c80Input ? c80Input.value : '0', itSchema.c);
      const valD = validate(d80Input ? d80Input.value : '0', itSchema.d);
      const valO = validate(otherInput ? otherInput.value : '0', itSchema.o);

      if (!valG.valid || !valC.valid || !valD.valid || !valO.valid) {
        const firstErr = (!valG.valid && valG.error.message) ||
          (!valC.valid && valC.error.message) ||
          (!valD.valid && valD.error.message) ||
          (!valO.valid && valO.error.message) ||
          'Invalid input values';
        showError(firstErr);
        return;
      }

      hideError();

      const gross = valG.value!;
      const c80 = valC.value!;
      const d80 = valD.value!;
      const other = valO.value!;

      const res = calcIncomeTax(gross, c80, d80, other);

      const recText = res.recommendedRegime === 'Equal'
        ? 'Both Regimes Equal'
        : `${res.recommendedRegime} (Save ${fmtVal(res.taxSavings)})`;

      const newTaxVal = fmtVal(res.newRegime.totalTax);
      const oldTaxVal = fmtVal(res.oldRegime.totalTax);
      const oldDedVal = fmtVal(res.oldRegime.totalDeductions);
      const newTakeHomeVal = fmtVal(res.newRegime.takeHomeIncome);
      const oldTakeHomeVal = fmtVal(res.oldRegime.takeHomeIncome);

      setResult({
        heroValue: newTaxVal,
        heroLabel: 'New Regime Tax',
        rows: [
          { label: 'Recommended Choice', value: recText, variant: 'accent' },
          { label: 'New Regime Tax', value: newTaxVal },
          { label: 'Old Regime Tax', value: oldTaxVal },
          { label: 'Old Regime Total Deductions', value: oldDedVal },
          { label: 'New Regime Annual Take-Home', value: newTakeHomeVal, variant: 'accent' },
          { label: 'Old Regime Annual Take-Home', value: oldTakeHomeVal },
        ],
        fields: {
          'it-result-rec': recText,
          'it-result-newtax': newTaxVal,
          'it-result-oldtax': oldTaxVal,
          'it-result-old-deductions': oldDedVal,
          'it-result-newtakehome': newTakeHomeVal,
          'it-result-oldtakehome': oldTakeHomeVal,
        },
        meta: { gross, c80, d80, other, ...res },
      });

      if (resRec) resRec.textContent = recText;
      if (resNewTax) resNewTax.textContent = newTaxVal;
      if (resOldTax) resOldTax.textContent = oldTaxVal;
      if (resOldDed) resOldDed.textContent = oldDedVal;
      if (resNewTH) resNewTH.textContent = newTakeHomeVal;
      if (resOldTH) resOldTH.textContent = oldTakeHomeVal;
      if (mobileHero) mobileHero.textContent = newTaxVal;

      const wrapper = document.getElementById('it-composition-wrapper');
      if (wrapper && gross > 0) {
        const thFrac = Math.max(0, res.newRegime.takeHomeIncome / gross);
        const taxFrac = Math.min(1, res.newRegime.totalTax / gross);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        const gainBar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-accent"]');
        if (bar) bar.style.width = `${(thFrac * 100).toFixed(2)}%`;
        if (gainBar) gainBar.style.width = `${(taxFrac * 100).toFixed(2)}%`;
        const legendEls = wrapper.querySelectorAll('[class*="tabular-nums"]');
        if (legendEls[0]) legendEls[0].textContent = newTakeHomeVal;
        if (legendEls[1]) legendEls[1].textContent = newTaxVal;
      }

      updateHash(serializeHash({ g: gross, c: c80, d: d80, o: other }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, maxVal: number) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(grossSlider, grossInput, 10000000);
    if (c80Slider && c80Input) sync(c80Slider, c80Input, 150000);
    if (d80Slider && d80Input) sync(d80Slider, d80Input, 100000);
    if (otherSlider && otherInput) sync(otherSlider, otherInput, 500000);

    document.getElementById('it-calculate')?.addEventListener('click', recalc);
    document.getElementById('it-reset')?.addEventListener('click', () => {
      grossInput.value = fmtLiveInput(String(DEFAULTS.gross));
      if (c80Input) c80Input.value = fmtLiveInput(String(DEFAULTS.c80));
      if (d80Input) d80Input.value = fmtLiveInput(String(DEFAULTS.d80));
      if (otherInput) otherInput.value = fmtLiveInput(String(DEFAULTS.other));

      if (grossSlider) {
        grossSlider.value = String(DEFAULTS.gross);
        grossSlider.style.setProperty('--slider-pct', `${((DEFAULTS.gross - 300000) / (10000000 - 300000)) * 100}%`);
      }
      if (c80Slider) {
        c80Slider.value = String(DEFAULTS.c80);
        c80Slider.style.setProperty('--slider-pct', `${(DEFAULTS.c80 / 150000) * 100}%`);
      }
      if (d80Slider) {
        d80Slider.value = String(DEFAULTS.d80);
        d80Slider.style.setProperty('--slider-pct', `${(DEFAULTS.d80 / 100000) * 100}%`);
      }
      if (otherSlider) {
        otherSlider.value = String(DEFAULTS.other);
        otherSlider.style.setProperty('--slider-pct', `${(DEFAULTS.other / 500000) * 100}%`);
      }

      hideError();
      recalc();
      grossInput.focus();
    });

    [grossInput, c80Input, d80Input, otherInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('it-copy-btn')?.addEventListener('click', async () => {
      const valG = validate(grossInput.value, itSchema.g);
      const valC = validate(c80Input ? c80Input.value : '0', itSchema.c);
      const valD = validate(d80Input ? d80Input.value : '0', itSchema.d);
      const valO = validate(otherInput ? otherInput.value : '0', itSchema.o);

      if (!valG.valid || !valC.valid || !valD.valid || !valO.valid) {
        showError('Please check your inputs before copying.');
        return;
      }
      const gross = valG.value!;
      const c80 = valC.value!;
      const d80 = valD.value!;
      const other = valO.value!;
      const res = calcIncomeTax(gross, c80, d80, other);
      const text = `Income Tax Comparison (Budget 2024): Gross ${fmtVal(gross)} => New Regime: ${fmtVal(res.newRegime.totalTax)}, Old Regime: ${fmtVal(res.oldRegime.totalTax)}. Recommended: ${res.recommendedRegime} (Save ${fmtVal(res.taxSavings)}). ${location.href.split('#')[0]}${serializeHash({ g: gross, c: c80, d: d80, o: other })}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('it-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('it-share-btn')?.addEventListener('click', async () => {
      const valG = validate(grossInput.value, itSchema.g);
      const valC = validate(c80Input ? c80Input.value : '0', itSchema.c);
      const valD = validate(d80Input ? d80Input.value : '0', itSchema.d);
      const valO = validate(otherInput ? otherInput.value : '0', itSchema.o);

      if (!valG.valid || !valC.valid || !valD.valid || !valO.valid) {
        showError('Please check your inputs before sharing.');
        return;
      }
      const gross = valG.value!;
      const c80 = valC.value!;
      const d80 = valD.value!;
      const other = valO.value!;
      const shareUrl = `${location.href.split('#')[0]}${serializeHash({ g: gross, c: c80, d: d80, o: other })}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('it-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Jurisdiction Lock: Income Tax is India-specific (INR-locked).
    // Intentionally ignore cm:currency-change events and never read USD/EUR/GBP from localStorage.

    // Phase 4.4 URL State Restoration
    const currentHash = readCurrentHash();
    if (currentHash) {
      const restored = restoreFromHash(currentHash, itSchema);
      if (restored.valid) {
        if (restored.values.g !== undefined) {
          grossInput.value = fmtLiveInput(String(restored.values.g));
          if (grossSlider) {
            grossSlider.value = String(restored.values.g);
            grossSlider.style.setProperty('--slider-pct', `${((restored.values.g - 300000) / (10000000 - 300000)) * 100}%`);
          }
        }
        if (restored.values.c !== undefined && c80Input) {
          c80Input.value = fmtLiveInput(String(restored.values.c));
          if (c80Slider) {
            c80Slider.value = String(restored.values.c);
            c80Slider.style.setProperty('--slider-pct', `${(restored.values.c / 150000) * 100}%`);
          }
        }
        if (restored.values.d !== undefined && d80Input) {
          d80Input.value = fmtLiveInput(String(restored.values.d));
          if (d80Slider) {
            d80Slider.value = String(restored.values.d);
            d80Slider.style.setProperty('--slider-pct', `${(restored.values.d / 100000) * 100}%`);
          }
        }
        if (restored.values.o !== undefined && otherInput) {
          otherInput.value = fmtLiveInput(String(restored.values.o));
          if (otherSlider) {
            otherSlider.value = String(restored.values.o);
            otherSlider.style.setProperty('--slider-pct', `${(restored.values.o / 500000) * 100}%`);
          }
        }
      }
    }

    recalc();
  }

  initITCalc();
  document.addEventListener('astro:page-load', initITCalc);
</script>
