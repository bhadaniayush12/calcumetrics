---
/**
 * Income Tax Calculator (India) — /in/income-tax-calculator
 * Master SEO & UX Gold Standard Template
 * Live reactive calculations, preset salary chips, compact Indian numbers, WhatsApp sharing,
 * featured snippet answer, Old vs New Regime comparison, Budget 2024 slabs, and real FAQs.
 */

import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcIncomeTax } from '../../lib/calculators/income-tax';
import { formatIndian, formatIndianCompact } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = {
  grossIncome: 1500000,
  ded80C: 150000,
  ded80D: 25000,
  otherDed: 50000,
};

const result = calcIncomeTax(DEFAULT.grossIncome, DEFAULT.ded80C, DEFAULT.ded80D, DEFAULT.otherDed);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));
const newTaxExact = fmt(result.newRegime.totalTax);
const newTaxCompact = formatIndianCompact(result.newRegime.totalTax, '₹');
const oldTaxExact = fmt(result.oldRegime.totalTax);
const oldTaxCompact = formatIndianCompact(result.oldRegime.totalTax, '₹');
const savingsExact = fmt(result.taxSavings);
const savingsCompact = formatIndianCompact(result.taxSavings, '₹');

const related = TOOLS.filter((t) => t.category === 'Taxes' && t.slug !== 'income-tax-calculator' && t.status === 'published').slice(0, 4);
const canonicalUrl = 'https://calcumetrics.com/in/income-tax-calculator';
const pageTitle = 'Income Tax Calculator FY 2026-27 / AY 2027-28 | Calcumetrics';
const pageDesc = 'Free income tax calculator India (FY 2026-27). Compare income tax calculator new regime vs old regime with ₹75k standard deduction and ₹12L rebate.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Income Tax Calculator (India)',
      url: canonicalUrl,
      description: pageDesc,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en-IN',
      dateModified: '2026-09-24',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'Income Tax Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What are the current New Tax Regime slabs for FY 2025-26 and FY 2026-27?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the current New Tax Regime, the slabs are: ₹0-₹4 Lakh (Nil), ₹4-₹8 Lakh (5%), ₹8-₹12 Lakh (10%), ₹12-₹16 Lakh (15%), ₹16-₹20 Lakh (20%), ₹20-₹24 Lakh (25%), and above ₹24 Lakh (30%). Salaried taxpayers also receive an automatic ₹75,000 standard deduction.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does the Section 87A rebate work and why is ₹12.75 Lakh tax-free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Section 87A provides a 100% tax rebate (up to ₹60,000) for resident individuals with taxable income up to ₹12,00,000. Combined with the ₹75,000 standard deduction for salaried employees, gross income up to ₹12,75,000 attracts zero income tax under the New Regime.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does marginal relief work under Section 87A?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Marginal relief ensures that if your taxable income slightly exceeds ₹12,00,000, your tax payable cannot exceed the amount by which your taxable income exceeds ₹12,00,000. This eliminates the tax cliff.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I claim deductions like 80C, 80D, and HRA in the New Tax Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Chapter VI-A deductions such as Section 80C (EPF, PPF, ELSS), Section 80D (health insurance), Section 24(b) (home loan interest on self-occupied property), and HRA exemptions are only available under the Old Tax Regime.',
          },
        },
        {
          '@type': 'Question',
          name: 'When is the Old Tax Regime still better than the New Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'With the New Regime basic exemption at ₹4 Lakh and zero tax up to ₹12.75 Lakh gross salary, the Old Tax Regime is rarely beneficial unless you have very high deductions exceeding ₹4.5 Lakh to ₹5 Lakh (e.g. combined 80C, 80D, high home loan interest, and large HRA).',
          },
        },
        {
          '@type': 'Question',
          name: 'Is the 4% Health and Education Cess applicable to both tax regimes?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. A mandatory 4% Health and Education Cess is calculated on the aggregate of income tax after applying Section 87A rebate and marginal relief under both regimes.',
          },
        },
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <CalculatorLayout
    toolName="Income Tax Calculator (India)"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={newTaxExact}
    heroLabel="New Regime Tax"
  >
    <!-- ── INPUT CARD ─────────────────────────────────────────────────────────── -->
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          Income Tax Calculator: FY 2026-27 / AY 2027-28
        </h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory source: <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Income Tax Department (CBDT)</a> · Succeeded legacy Income-tax Act 1961.
      </p>

      <!-- Surcharge Disclaimer (§18) -->
      <div class="mb-5 p-3 rounded-card bg-amber-500/10 border border-amber-500/20 text-xs text-text-muted leading-relaxed">
        <strong class="text-amber-700 dark:text-amber-400 font-semibold block mb-0.5">⚠️ Surcharge Disclaimer:</strong>
        Computations model base statutory slab rates, ₹75,000 standard deduction, Section 87A rebate (zero tax up to ₹12.75 Lakh gross), and 4% Health & Education Cess. <strong>Surcharge on taxable income exceeding ₹50 Lakh (10% to 25%) is not modeled.</strong> Taxpayers with income above ₹50 Lakh should consult a tax professional for surcharge and marginal relief calculations.
      </div>

      <!-- Gross Annual Income Input + Presets -->
      <div class="mb-6">
        <Input
          id="it-gross"
          label="Gross Annual Income (Salary / CTC / Business)"
          prefix="₹"
          value="15,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total annual earnings before standard deduction or exemptions"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-gross-slider" min={300000} max={10000000} step={25000} value={1500000} ariaLabel="Gross income slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Income presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 1275000, label: '₹12.75L (Zero Tax)' },
            { val: 1500000, label: '₹15L' },
            { val: 2000000, label: '₹20L' },
            { val: 2500000, label: '₹25L' },
            { val: 5000000, label: '₹50L' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-gross={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Section 80C -->
      <div class="mb-5">
        <Input
          id="it-80c"
          label="Section 80C Deductions (Old Regime only)"
          prefix="₹"
          value="1,50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="EPF, PPF, ELSS, Life Insurance, Home Loan Principal (Max ₹1.5L)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-80c-slider" min={0} max={150000} step={5000} value={150000} ariaLabel="80C deductions slider" />
        </div>
      </div>

      <!-- Section 80D -->
      <div class="mb-5">
        <Input
          id="it-80d"
          label="Section 80D Health Insurance (Old Regime only)"
          prefix="₹"
          value="25,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Medical insurance premiums for self, family, and parents (Max ₹1L)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-80d-slider" min={0} max={100000} step={5000} value={25000} ariaLabel="80D health insurance slider" />
        </div>
      </div>

      <!-- Other Deductions -->
      <div class="mb-6">
        <Input
          id="it-other"
          label="Other Deductions (HRA, Sec 24b Home Loan Interest)"
          prefix="₹"
          value="50,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Eligible Chapter VI-A deductions and exemptions (Old Regime only)"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="it-other-slider" min={0} max={500000} step={10000} value={50000} ariaLabel="Other deductions slider" />
        </div>
      </div>

      <!-- Error alert -->
      <div id="it-error-alert" class="hidden mb-4">
        <Alert variant="error" title="Input Error">
          <span id="it-error-msg">Please review the highlighted values.</span>
        </Alert>
      </div>

      <div class="flex justify-end pt-2">
        <button
          type="button"
          id="it-reset"
          class="text-xs text-text-muted hover:text-accent font-medium py-1 px-2 rounded hover:bg-surface transition-standard cursor-pointer"
        >
          Reset to defaults
        </button>
      </div>
    </Fragment>

    <!-- ── OUTPUT PANEL ────────────────────────────────────────────────────────── -->
    <Fragment slot="outputs">
      <!-- Recommendation Hero -->
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-dark-muted block mb-1">
          Recommended Tax Regime
        </span>
        <div id="it-result-rec" class="text-2xl sm:text-3xl font-extrabold tabular-nums text-dark-accent tracking-tight" aria-live="polite">
          {result.recommendedRegime === 'Equal' ? 'Both Regimes Equal' : `${result.recommendedRegime} (Save ${savingsCompact})`}
        </div>
      </div>

      <!-- Comparison Metrics -->
      <div class="space-y-0 border-t border-dark-border pt-4 mb-4">
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Tax (FY 2025-26 & 2026-27)</span>
          <div class="text-right">
            <span id="it-result-newtax-compact" class="text-sm font-bold tabular-nums text-dark-accent mr-1.5">{newTaxCompact}</span>
            <span id="it-result-newtax" class="text-xs text-dark-muted tabular-nums font-mono">({newTaxExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Old Regime Tax</span>
          <div class="text-right">
            <span id="it-result-oldtax-compact" class="text-sm font-semibold tabular-nums text-dark-text mr-1.5">{oldTaxCompact}</span>
            <span id="it-result-oldtax" class="text-xs text-dark-muted tabular-nums font-mono">({oldTaxExact})</span>
          </div>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Standard Deduction</span>
          <span class="text-sm font-semibold tabular-nums text-dark-accent">₹75,000</span>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Old Regime Total Deductions</span>
          <span id="it-result-old-deductions" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.oldRegime.totalDeductions)}</span>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">New Regime Take-Home Pay</span>
          <span id="it-result-newtakehome" class="text-sm font-bold tabular-nums text-dark-text">{fmt(result.newRegime.takeHomeIncome)}</span>
        </div>
        <div class="flex items-center justify-between py-2">
          <span class="text-xs text-dark-muted">Old Regime Take-Home Pay</span>
          <span id="it-result-oldtakehome" class="text-sm font-medium tabular-nums text-dark-muted">{fmt(result.oldRegime.takeHomeIncome)}</span>
        </div>
      </div>

      <!-- Composition bar -->
      <div class="mb-4" id="it-composition-wrapper">
        <CompositionBar
          principalFraction={DEFAULT.grossIncome > 0 ? result.newRegime.takeHomeIncome / DEFAULT.grossIncome : 1}
          gainFraction={DEFAULT.grossIncome > 0 ? result.newRegime.totalTax / DEFAULT.grossIncome : 0}
          principalLabel="Take-Home Pay"
          gainLabel="Income Tax"
          principalValue={fmt(result.newRegime.takeHomeIncome)}
          gainValue={newTaxExact}
        />
      </div>

      <!-- Share Actions -->
      <div class="space-y-2">
        <a
          id="it-whatsapp-btn"
          href="https://api.whatsapp.com/send?text=Compare%20Income%20Tax%20(Budget%202024):%20Gross%20%E2%82%B912%20Lakh%20yields%20New%20Regime%20Tax%20of%20%E2%82%B985,800%20vs%20Old%20Regime%20Tax%20of%20%E2%82%B91,06,600%20on%20Calcumetrics:%20https://calcumetrics.com/in/income-tax-calculator"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full h-10 text-xs font-semibold rounded-control bg-[#25D366] text-white hover:opacity-90 transition-standard focus-visible:outline-2 focus-visible:outline-white cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.782 2.791.782 3.183 0 5.769-2.587 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.362c-.896 0-1.637-.247-2.366-.679l-.17-.1-1.758.461.469-1.714-.111-.177c-.476-.757-.727-1.466-.726-2.392.001-2.483 2.022-4.503 4.506-4.503 2.481 0 4.502 2.021 4.503 4.503-.001 2.483-2.023 4.503-4.507 4.503zm2.593-3.374c-.142-.071-.84-.415-.97-.462-.13-.047-.225-.071-.32.071-.095.142-.367.462-.45.557-.083.095-.166.107-.308.036s-.601-.222-1.145-.707c-.424-.378-.71-.845-.793-.987-.083-.142-.009-.219.062-.29.064-.064.142-.166.213-.249.071-.083.095-.142.142-.237.047-.095.024-.178-.012-.249s-.32-.771-.439-1.055c-.116-.277-.234-.239-.32-.243-.083-.004-.178-.005-.273-.005s-.249.036-.379.178c-.13.142-.498.486-.498 1.185s.51 1.375.581 1.47c.071.095 1.004 1.533 2.433 2.15.34.147.606.235.813.301.341.109.652.093.898.056.274-.041.84-.344.959-.676.119-.332.119-.617.083-.676-.035-.06-.13-.095-.272-.166z"/>
          </svg>
          Share on WhatsApp
        </a>
        <div class="flex gap-2">
          <button
            type="button"
            id="it-copy-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Copy Result
          </button>
          <button
            type="button"
            id="it-share-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Share Link
          </button>
        </div>
      </div>

      <p class="text-[11px] text-dark-muted mt-3 leading-relaxed">
        Computations include Section 87A rebate, marginal relief, and 4% Health & Education Cess for FY 2025-26 & FY 2026-27 (AY 2026-27 & 2027-28).
      </p>
    </Fragment>

    <!-- ── BELOW THE FOLD (SEO CONTENT) ───────────────────────────────────────── -->
    <Fragment slot="below">

      <!-- 1. Featured Snippet Direct Answer Box -->
      <div class="p-5 bg-surface border-l-4 border-accent rounded-r-card mb-8 shadow-sm">
        <p class="text-xs font-bold text-accent uppercase tracking-wider mb-1">Quick Answer / Summary</p>
        <p class="text-sm text-text-primary leading-relaxed" id="it-snippet-answer">
          For a gross salary of <strong>₹15.00 Lakh</strong>, the <strong>New Tax Regime</strong> is more beneficial, resulting in a tax of <strong>₹97,500</strong> compared to <strong>₹1,87,200</strong> under the Old Regime (with ₹2.75L deductions), saving you <strong>₹89,700</strong> annually.
        </p>
      </div>

      <!-- 2. Current Slabs Comparison Table -->
      <section aria-labelledby="tax-slabs-comparison" class="mb-10">
        <h2 id="tax-slabs-comparison" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">New vs Old Tax Regime Slabs (FY 2025-26 & FY 2026-27)</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card">
          <table class="w-full text-xs sm:text-sm border-collapse">
            <thead class="bg-surface border-b border-border text-text-primary font-semibold">
              <tr>
                <th class="p-3 text-left">New Tax Regime Slabs (FY 2025-26 & 2026-27)</th>
                <th class="p-3 text-left">Tax Rate</th>
                <th class="p-3 text-left">Old Tax Regime Slabs</th>
                <th class="p-3 text-left">Tax Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="p-3">Up to ₹4,00,000</td>
                <td class="p-3 font-semibold text-text-primary">Nil</td>
                <td class="p-3">Up to ₹2,50,000</td>
                <td class="p-3 font-semibold text-text-primary">Nil</td>
              </tr>
              <tr>
                <td class="p-3">₹4,00,001 to ₹8,00,000</td>
                <td class="p-3 font-semibold text-accent">5%</td>
                <td class="p-3">₹2,50,001 to ₹5,00,000</td>
                <td class="p-3 font-semibold text-accent">5%</td>
              </tr>
              <tr>
                <td class="p-3">₹8,00,001 to ₹12,00,000</td>
                <td class="p-3 font-semibold text-accent">10%</td>
                <td class="p-3">₹5,00,001 to ₹10,00,000</td>
                <td class="p-3 font-semibold text-accent">20%</td>
              </tr>
              <tr>
                <td class="p-3">₹12,00,001 to ₹16,00,000</td>
                <td class="p-3 font-semibold text-accent">15%</td>
                <td class="p-3">Above ₹10,00,000</td>
                <td class="p-3 font-semibold text-text-primary">30%</td>
              </tr>
              <tr>
                <td class="p-3">₹16,00,001 to ₹20,00,000</td>
                <td class="p-3 font-semibold text-accent">20%</td>
                <td class="p-3">—</td>
                <td class="p-3">—</td>
              </tr>
              <tr>
                <td class="p-3">₹20,00,001 to ₹24,00,000</td>
                <td class="p-3 font-semibold text-accent">25%</td>
                <td class="p-3">—</td>
                <td class="p-3">—</td>
              </tr>
              <tr>
                <td class="p-3">Above ₹24,00,000</td>
                <td class="p-3 font-semibold text-text-primary">30%</td>
                <td class="p-3">—</td>
                <td class="p-3">—</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 3. Key Rules: 87A Rebate, Marginal Relief & Standard Deduction -->
      <section aria-labelledby="tax-rules" class="mb-10">
        <h2 id="tax-rules" class="text-xl sm:text-2xl font-bold text-text-primary mb-3">Key statutory highlights (FY 2025-26 & FY 2026-27)</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs text-text-muted">
          <div class="p-4 bg-surface border border-border rounded-card">
            <h3 class="font-bold text-text-primary text-sm mb-1.5">₹75,000 Standard Deduction</h3>
            <p class="leading-relaxed">Salaried individuals under the New Regime receive an automatic ₹75,000 deduction without needing to submit bills or investment receipts.</p>
          </div>
          <div class="p-4 bg-surface border border-border rounded-card">
            <h3 class="font-bold text-text-primary text-sm mb-1.5">Zero Tax Up to ₹12.75 Lakh</h3>
            <p class="leading-relaxed">Under Section 87A, taxable income up to ₹12 Lakh gets 100% tax rebate. With the ₹75,000 standard deduction, salaried gross income up to ₹12.75L pays zero tax.</p>
          </div>
          <div class="p-4 bg-surface border border-border rounded-card">
            <h3 class="font-bold text-text-primary text-sm mb-1.5">Section 87A Marginal Relief</h3>
            <p class="leading-relaxed">No tax cliff: if your taxable income slightly exceeds ₹12 Lakh, marginal relief caps your tax liability to the exact excess income earned over ₹12 Lakh.</p>
          </div>
        </div>
      </section>

      <!-- 4. Real FAQs -->
      <section aria-labelledby="it-faq" class="mb-10">
        <h2 id="it-faq" class="text-xl sm:text-2xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {[
            {
              q: 'What are the current New Tax Regime slabs for FY 2025-26 and FY 2026-27?',
              a: 'Under the current New Tax Regime, the standard deduction for salaried individuals is ₹75,000 and the slabs are: ₹0-₹4 Lakh (Nil), ₹4-₹8 Lakh (5%), ₹8-₹12 Lakh (10%), ₹12-₹16 Lakh (15%), ₹16-₹20 Lakh (20%), ₹20-₹24 Lakh (25%), and above ₹24 Lakh (30%).',
            },
            {
              q: 'How does the Section 87A tax rebate work in the New Tax Regime?',
              a: 'Under the New Tax Regime, resident individuals with total taxable income up to ₹12,00,000 receive a 100% tax rebate under Section 87A (rebate up to ₹60,000). Combined with the ₹75,000 standard deduction, salaried employees earning gross income up to ₹12,75,000 pay zero income tax, with marginal relief protecting against tax cliffs for income slightly exceeding ₹12 Lakh.',
            },
            {
              q: 'Can I claim deductions like 80C, 80D, and HRA in the New Tax Regime?',
              a: 'No. Chapter VI-A deductions such as Section 80C (EPF, PPF, ELSS), Section 80D (health insurance), Section 24(b) (home loan interest on self-occupied property), and HRA exemptions are only available under the Old Tax Regime.',
            },
            {
              q: 'When is the Old Tax Regime still better than the New Regime?',
              a: 'The Old Tax Regime can be advantageous for taxpayers who claim substantial deductions exceeding ₹3.75 lakh to ₹4.25 lakh, such as the ₹1.5L 80C cap, ₹2L home loan interest, ₹50k-₹1L health insurance, and large HRA exemptions.',
            },
            {
              q: 'Is the 4% Health and Education Cess applicable to both tax regimes?',
              a: 'Yes. A mandatory 4% Health and Education Cess is calculated on the aggregate of income tax after applying the Section 87A rebate under both the New and Old Tax Regimes.',
            },
            {
              q: 'Can salaried individuals switch between Old and New Tax Regimes every year?',
              a: 'Yes. Individuals with salaried income (no business or professional income) can choose the more advantageous regime every financial year while filing their ITR on the Income Tax e-filing portal.',
            },
          ].map((item) => (
            <details class="border border-border rounded-card overflow-hidden bg-surface">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-semibold text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">
                {item.q}
              </summary>
              <div class="px-5 pb-4 pt-1 text-xs sm:text-sm text-text-muted leading-relaxed">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- 5. Related Calculators -->
      <section aria-labelledby="it-related" class="mb-10">
        <h2 id="it-related" class="text-xl sm:text-2xl font-bold text-text-primary mb-4">Related taxation & salary calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((tool) => (
            <a
              href={tool.path}
              class="group block bg-surface border border-border rounded-card p-4 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
            >
              <span class="text-[11px] font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed line-clamp-2">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- 6. Authoritative Footer Review -->
      <div class="border-t border-border pt-6 pb-2 flex flex-col sm:flex-row items-center justify-between text-xs text-text-muted gap-2">
        <div>
          <span>Last updated: <strong>September 2026</strong></span>
          <span class="mx-2">·</span>
          <span>Verified against Income Tax Act statutory provisions (FY 2026-27 / AY 2027-28)</span>
        </div>
        <div>
          <a href="/methodology" class="hover:text-accent underline transition-standard">View formula methodology</a>
        </div>
      </div>

    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcIncomeTax } from '../../lib/calculators/income-tax';
  import { setResult } from '../../lib/result-bus';
  import { validate } from '../../lib/validate';
  import { formatIndian, formatIndianCompact } from '../../lib/formatters';

  function fmtVal(n: number) {
    return '₹' + new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtCompact(n: number) {
    return formatIndianCompact(n, '₹');
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(num);
  }

  function initITCalc() {
    const grossInput = document.getElementById('it-gross') as HTMLInputElement | null;
    const grossSlider = document.getElementById('it-gross-slider') as HTMLInputElement | null;
    const c80Input = document.getElementById('it-80c') as HTMLInputElement | null;
    const c80Slider = document.getElementById('it-80c-slider') as HTMLInputElement | null;
    const d80Input = document.getElementById('it-80d') as HTMLInputElement | null;
    const d80Slider = document.getElementById('it-80d-slider') as HTMLInputElement | null;
    const otherInput = document.getElementById('it-other') as HTMLInputElement | null;
    const otherSlider = document.getElementById('it-other-slider') as HTMLInputElement | null;

    const resRec = document.getElementById('it-result-rec');
    const resNewTaxCompact = document.getElementById('it-result-newtax-compact');
    const resNewTax = document.getElementById('it-result-newtax');
    const resOldTaxCompact = document.getElementById('it-result-oldtax-compact');
    const resOldTax = document.getElementById('it-result-oldtax');
    const resOldDeductions = document.getElementById('it-result-old-deductions');
    const resNewTakeHome = document.getElementById('it-result-newtakehome');
    const resOldTakeHome = document.getElementById('it-result-oldtakehome');

    const errAlert = document.getElementById('it-error-alert');
    const errMsg = document.getElementById('it-error-msg');
    const snippetAnswer = document.getElementById('it-snippet-answer');
    const whatsappBtn = document.getElementById('it-whatsapp-btn') as HTMLAnchorElement | null;
    const copyBtn = document.getElementById('it-copy-btn');
    const shareBtn = document.getElementById('it-share-btn');
    const resetBtn = document.getElementById('it-reset');

    if (!grossInput) return;

    const DEFAULTS = { gross: 1500000, c80: 150000, d80: 25000, other: 50000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function hideError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const vG = validate(grossInput!.value.replace(/[^0-9.]/g, ''), { required: true, min: 10000, label: 'Gross Annual Income' });
      const vC = validate(c80Input ? c80Input.value.replace(/[^0-9.]/g, '') : '0', { required: false, min: 0, max: 150000, label: 'Section 80C' });
      const vD = validate(d80Input ? d80Input.value.replace(/[^0-9.]/g, '') : '0', { required: false, min: 0, max: 100000, label: 'Section 80D' });
      const vO = validate(otherInput ? otherInput.value.replace(/[^0-9.]/g, '') : '0', { required: false, min: 0, max: 1000000, label: 'Other Deductions' });

      if (!vG.valid) { showError(vG.error!.message); return; }
      if (!vC.valid) { showError(vC.error!.message); return; }
      if (!vD.valid) { showError(vD.error!.message); return; }
      if (!vO.valid) { showError(vO.error!.message); return; }
      hideError();

      const gross = vG.value!;
      const c80 = vC.value || 0;
      const d80 = vD.value || 0;
      const other = vO.value || 0;

      const res = calcIncomeTax(gross, c80, d80, other);

      const compNewTax = fmtCompact(res.newRegime.totalTax);
      const compOldTax = fmtCompact(res.oldRegime.totalTax);
      const compSavings = fmtCompact(res.taxSavings);

      if (resRec) {
        resRec.textContent = res.recommendedRegime === 'Equal'
          ? 'Both Regimes Equal'
          : `${res.recommendedRegime} (Save ${compSavings})`;
      }

      if (resNewTaxCompact) resNewTaxCompact.textContent = compNewTax;
      if (resNewTax) resNewTax.textContent = `(${fmtVal(res.newRegime.totalTax)})`;
      if (resOldTaxCompact) resOldTaxCompact.textContent = compOldTax;
      if (resOldTax) resOldTax.textContent = `(${fmtVal(res.oldRegime.totalTax)})`;
      if (resOldDeductions) resOldDeductions.textContent = fmtVal(res.oldRegime.totalDeductions);
      if (resNewTakeHome) resNewTakeHome.textContent = fmtVal(res.newRegime.takeHomeIncome);
      if (resOldTakeHome) resOldTakeHome.textContent = fmtVal(res.oldRegime.takeHomeIncome);

      // Composition bar
      const wrapper = document.getElementById('it-composition-wrapper');
      if (wrapper && gross > 0) {
        const takeHomeFrac = res.newRegime.takeHomeIncome / gross;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(takeHomeFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.newRegime.takeHomeIncome);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.newRegime.totalTax);
      }

      if (snippetAnswer) {
        const recText = res.recommendedRegime === 'Equal'
          ? 'both regimes result in equal tax liability'
          : `the <strong>${res.recommendedRegime}</strong> is more beneficial, saving you <strong>${compSavings}</strong> annually`;
        snippetAnswer.innerHTML = `For a gross income of <strong>${fmtVal(gross)}</strong>, ${recText}. New Regime Tax: <strong>${compNewTax}</strong> (${fmtVal(res.newRegime.totalTax)}) vs Old Regime Tax: <strong>${compOldTax}</strong> (${fmtVal(res.oldRegime.totalTax)}).`;
      }

      if (whatsappBtn) {
        const shareMsg = encodeURIComponent(
          `Income Tax Comparison (FY 2025-26 & 2026-27):\nGross Income: ${fmtVal(gross)}\nNew Regime Tax: ${compNewTax}\nOld Regime Tax: ${compOldTax}\nRecommended: ${res.recommendedRegime} (Save ${compSavings})\nCalculate on Calcumetrics: ${location.href}`
        );
        whatsappBtn.href = `https://api.whatsapp.com/send?text=${shareMsg}`;
      }

      const canonicalResult = {
        heroValue: compNewTax,
        heroLabel: 'New Regime Tax',
        rows: [
          { label: 'Recommended', value: `${res.recommendedRegime} (Save ${compSavings})` },
          { label: 'Old Regime Tax', value: compOldTax },
          { label: 'Annual Take-Home', value: fmtVal(res.newRegime.takeHomeIncome) },
        ],
        fields: {
          'it-result-newtax': fmtVal(res.newRegime.totalTax),
          'it-result-oldtax': fmtVal(res.oldRegime.totalTax),
        },
      };

      setResult(canonicalResult);
      if ((window as any).__cmResultStore) {
        (window as any).__cmResultStore.setResult(canonicalResult);
      }
      window.dispatchEvent(new CustomEvent('cm:result', { detail: canonicalResult }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 60);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement | null, maxVal: number) {
      if (!slider || !input) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const min = parseFloat(slider.min) || 0;
        const max = parseFloat(slider.max) || maxVal;
        slider.style.setProperty('--slider-pct', `${((parseFloat(slider.value) - min) / (max - min)) * 100}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const min = parseFloat(slider.min) || 0;
          const max = parseFloat(slider.max) || maxVal;
          slider.style.setProperty('--slider-pct', `${((num - min) / (max - min)) * 100}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(grossSlider, grossInput, 10000000);
    sync(c80Slider, c80Input, 150000);
    sync(d80Slider, d80Input, 100000);
    sync(otherSlider, otherInput, 500000);

    // ── Preset Chips ─────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('[data-chip-gross]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-gross');
        if (val) {
          grossInput.value = fmtLiveInput(val);
          if (grossSlider) {
            grossSlider.value = val;
            const min = parseFloat(grossSlider.min), max = parseFloat(grossSlider.max);
            grossSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min)) * 100}%`);
          }
          debounce();
        }
      });
    });

    // ── Reset ────────────────────────────────────────────────────────────────
    resetBtn?.addEventListener('click', () => {
      grossInput.value = fmtLiveInput(String(DEFAULTS.gross));
      if (c80Input) c80Input.value = fmtLiveInput(String(DEFAULTS.c80));
      if (d80Input) d80Input.value = fmtLiveInput(String(DEFAULTS.d80));
      if (otherInput) otherInput.value = fmtLiveInput(String(DEFAULTS.other));

      if (grossSlider) {
        grossSlider.value = String(DEFAULTS.gross);
        grossSlider.style.setProperty('--slider-pct', `${((DEFAULTS.gross - 300000) / (10000000 - 300000)) * 100}%`);
      }
      if (c80Slider) {
        c80Slider.value = String(DEFAULTS.c80);
        c80Slider.style.setProperty('--slider-pct', `${(DEFAULTS.c80 / 150000) * 100}%`);
      }
      if (d80Slider) {
        d80Slider.value = String(DEFAULTS.d80);
        d80Slider.style.setProperty('--slider-pct', `${(DEFAULTS.d80 / 100000) * 100}%`);
      }
      if (otherSlider) {
        otherSlider.value = String(DEFAULTS.other);
        otherSlider.style.setProperty('--slider-pct', `${(DEFAULTS.other / 500000) * 100}%`);
      }

      hideError();
      recalc();
      grossInput.focus();
    });

    // ── Copy & Share ─────────────────────────────────────────────────────────
    copyBtn?.addEventListener('click', async () => {
      const vG = validate(grossInput.value.replace(/[^0-9.]/g, ''), { required: true, min: 10000, label: 'Gross Annual Income' });
      if (!vG.valid) return;
      const gross = vG.value!;
      const c80 = parseFloat(c80Input?.value.replace(/[^0-9.]/g, '') || '0') || 0;
      const d80 = parseFloat(d80Input?.value.replace(/[^0-9.]/g, '') || '0') || 0;
      const other = parseFloat(otherInput?.value.replace(/[^0-9.]/g, '') || '0') || 0;
      const res = calcIncomeTax(gross, c80, d80, other);
      const text = `Income Tax Comparison (FY 2025-26 & 2026-27): Gross ${fmtVal(gross)} => New Regime: ${fmtVal(res.newRegime.totalTax)}, Old Regime: ${fmtVal(res.oldRegime.totalTax)}. Recommended: ${res.recommendedRegime} (Save ${fmtVal(res.taxSavings)}). Calculated on Calcumetrics: ${location.href}`;
      await navigator.clipboard.writeText(text);
      if (copyBtn) {
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => (copyBtn.textContent = orig), 2000);
      }
    });

    shareBtn?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      if (shareBtn) {
        const orig = shareBtn.textContent;
        shareBtn.textContent = 'Copied Link!';
        setTimeout(() => (shareBtn.textContent = orig), 2000);
      }
    });

    recalc();
  }

  initITCalc();
  document.addEventListener('astro:page-load', initITCalc);
</script>
