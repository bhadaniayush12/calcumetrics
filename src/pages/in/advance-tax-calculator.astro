---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcAdvanceTax } from '../../lib/tax/india';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT_TAX = 100000;
const initialResult = calcAdvanceTax(DEFAULT_TAX);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Taxes' && t.slug !== 'advance-tax-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/in/advance-tax-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Advance Tax Calculator India',
      url: canonicalUrl,
      description: 'Free advance tax calculator India to compute quarterly advance income tax liability and statutory due dates under Section 208/211.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'Advance Tax Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Who is required to pay advance tax in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under Section 208 of the Income-tax Act, 1961, every individual, professional, freelancer, and corporate taxpayer whose estimated total tax liability for the financial year (after deducting TDS and TCS) is ₹10,000 or more is required to pay advance tax.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are senior citizens exempt from paying advance tax?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Under Section 207(2), a resident senior citizen (aged 60 years or above) who does not have any income chargeable under the head "Profits and gains of business or profession" is fully exempt from paying advance tax.',
          },
        },
        {
          '@type': 'Question',
          name: 'What interest penalty is levied for missing advance tax deadlines?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Failure to pay installments or paying less than statutory percentages attracts simple interest at 1% per month under Section 234C. If less than 90% of assessed tax is paid by 31st March, interest at 1% per month is also charged under Section 234B from 1st April of the assessment year until full payment.',
          },
        },
        {
          '@type': 'Question',
          name: 'What are the four advance tax due dates for individual taxpayers?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The statutory due dates are: 15% on or before 15 June; 45% cumulative on or before 15 September; 75% cumulative on or before 15 December; and 100% on or before 15 March.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do salaried employees pay advance tax?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Salaried employees whose employer deducts TDS on salary generally do not need to pay advance tax unless they have substantial additional income (such as capital gains, rental income, or dividend income) that was not reported to the employer on Form 12BB.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Advance Tax Calculator India (FY 2026-27) | Calcumetrics"
  description="Free advance tax calculator India. Use this advance income tax calculator to compute quarterly installment schedules and due dates under Section 208/211."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Advance Tax Calculator"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={initialResult.required ? fmt(initialResult.annualTaxLiability) : '₹0 (Exempt)'}
    heroLabel="Estimated Advance Tax Due"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">Advance Tax Calculator: FY 2026-27 / AY 2027-28</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory source: <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Income Tax Department (CBDT)</a> · Sections 208, 209, 211.
      </p>

      <!-- Surcharge Disclaimer (§18) -->
      <div class="mb-5 p-3 rounded-card bg-amber-500/10 border border-amber-500/20 text-xs text-text-muted leading-relaxed">
        <strong class="text-amber-700 dark:text-amber-400 font-semibold block mb-0.5">⚠️ Surcharge Disclaimer:</strong>
        Computations calculate statutory quarterly payment schedules (15%, 45%, 75%, 100%) on base estimated tax. <strong>Surcharge on taxable income exceeding ₹50 Lakh (10% to 25%) is not modeled.</strong> Taxpayers with high net worth should consult a CA.
      </div>

      <!-- Error alert -->
      <div id="at-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="at-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Annual Tax Liability -->
      <div class="mb-6">
        <Input
          id="at-tax"
          label="Estimated Annual Tax Liability"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total income tax payable for the financial year after deducting TDS/TCS"
          inputmode="decimal"
          aria-describedby="at-error-msg"
        />
        <div class="mt-2">
          <Slider id="at-tax-slider" min={5000} max={2000000} step={5000} value={100000} ariaLabel="Tax liability slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="at-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="at-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Advance Tax Status</span>
        <div id="at-result-hero" class="text-[36px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {initialResult.required ? fmt(initialResult.annualTaxLiability) : 'Exempt (&lt; ₹10,000)'}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-dark-muted mb-3">Quarterly Instalment Breakdown</div>
        
        {initialResult.instalments.map((inst, idx) => (
          <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
            <div>
              <span class="text-xs font-medium text-dark-text block">{inst.dueDate}</span>
              <span class="text-[11px] text-dark-muted">Cumulative: {inst.cumulativePct}%</span>
            </div>
            <span id={`at-inst-${idx}`} class="text-sm font-semibold tabular-nums text-dark-text">
              {fmt(inst.instalment)}
            </span>
          </div>
        ))}
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="at-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Schedule
        </button>
        <button type="button" id="at-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Threshold: Required only when net tax liability exceeds ₹10,000. Non-business resident senior citizens (60+) are exempt.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="at-calculator-how">
        <h2 id="at-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Advance Tax Works in India (Pay-As-You-Earn Scheme)</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Advance tax, governed by Sections 207 to 219 of the Income-tax Act, 1961, is India's "pay-as-you-earn" direct taxation mechanism. Under this scheme, taxpayers must discharge their income tax liability in periodic quarterly installments throughout the financial year in which income is earned, rather than deferring the entire tax payment until the annual return filing date.
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed font-mono">
            <strong>1. Mandatory Payment Condition (Section 208):</strong><br />
            Advance Tax is Required IF: Estimated Annual Tax Payable &minus; (TDS + TCS + Tax Credits) &ge; ₹10,000<br /><br />
            <strong>2. Statutory Quarterly Installment Schedule (Section 211):</strong><br />
            &bull; Installment 1 (On or before 15 June): 15% of estimated total tax liability<br />
            &bull; Installment 2 (On or before 15 September): 45% cumulative &minus; amount previously paid (incremental 30%)<br />
            &bull; Installment 3 (On or before 15 December): 75% cumulative &minus; amounts previously paid (incremental 30%)<br />
            &bull; Installment 4 (On or before 15 March): 100% cumulative &minus; amounts previously paid (incremental 25%)<br /><br />
            <strong>3. Presumptive Taxation Exception (Sec 44AD / 44ADA):</strong><br />
            Eligible businesses and professionals opting for presumptive taxation pay 100% of advance tax in a single installment on or before 15 March.<br /><br />
            <strong>4. Statutory Interest Penalties for Delay or Shortfall:</strong><br />
            &bull; Section 234C: 1% simple interest per month for 3 months on quarterly installment shortfalls.<br />
            &bull; Section 234B: 1% simple interest per month from 1 April if cumulative advance tax paid is &lt;90% of assessed tax.
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-Step Worked Example (Default Scenario)</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an individual consultant, freelancer, or taxpayer with an estimated net annual income tax liability of <strong>₹1,00,000</strong> after deducting all TDS and TCS credits:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-surface border-b border-border text-text-primary font-semibold">
                <th class="py-2.5 px-4">Instalment Due Date</th>
                <th class="py-2.5 px-4">Statutory Cumulative %</th>
                <th class="py-2.5 px-4">Cumulative Target (₹)</th>
                <th class="py-2.5 px-4">Quarterly Payment Due</th>
                <th class="py-2.5 px-4">Safe-Harbor Threshold</th>
                <th class="py-2.5 px-4">Section 234C Consequence</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">15 June (Q1)</td>
                <td class="py-2.5 px-4 font-mono">15% Cumulative</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹15,000</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹15,000</td>
                <td class="py-2.5 px-4 font-mono">12% (₹12,000)</td>
                <td class="py-2.5 px-4">1% / month for 3 months on shortfall if cumulative &lt;12%.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">15 September (Q2)</td>
                <td class="py-2.5 px-4 font-mono">45% Cumulative</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹45,000</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹30,000</td>
                <td class="py-2.5 px-4 font-mono">36% (₹36,000)</td>
                <td class="py-2.5 px-4">1% / month for 3 months on shortfall if cumulative &lt;36%.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">15 December (Q3)</td>
                <td class="py-2.5 px-4 font-mono">75% Cumulative</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹75,000</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹30,000</td>
                <td class="py-2.5 px-4 font-mono">75% (₹75,000)</td>
                <td class="py-2.5 px-4">1% / month for 3 months on shortfall from ₹75,000.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">15 March (Q4)</td>
                <td class="py-2.5 px-4 font-mono">100% Cumulative</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹1,00,000</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹25,000</td>
                <td class="py-2.5 px-4 font-mono">100% (₹1,00,000)</td>
                <td class="py-2.5 px-4">1% / month for 1 month on shortfall from ₹1,00,000.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">Full Financial Year Total</td>
                <td class="py-3 px-4 font-mono">100% Discharged</td>
                <td class="py-3 px-4 font-mono">₹1,00,000</td>
                <td class="py-3 px-4 font-mono font-bold text-text-primary">₹1,00,000 (100%)</td>
                <td class="py-3 px-4 font-mono">&ge;90% by 31 March</td>
                <td class="py-3 px-4">Zero interest penalty under Section 234B and Section 234C.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Statutory Exemptions &amp; Special Rules</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Senior Citizens Exemption (Sec 207(2)):</strong> Resident individuals aged <strong>60 years or older</strong> who do not have any income from business or profession are entirely exempt from advance tax.</li>
              <li><strong>Salaried Employees:</strong> If salary is the sole income source and the employer appropriately deducts TDS under Section 192, standalone advance tax payment is unnecessary. However, non-salary income (rent, capital gains, interest) exceeding TDS deductions triggers advance tax obligations.</li>
              <li><strong>Capital Gains &amp; Dividend Influx:</strong> Since capital gains and dividend income cannot be accurately forecasted, the proviso to Section 234C waives interest penalties provided the tax is deposited in remaining installments after the date of realization.</li>
              <li><strong>Payment Mechanism:</strong> Advance tax is deposited online through the Income Tax e-filing portal via <strong>Challan 280 / e-Pay Tax</strong> selecting "Advance Tax (100)" as the type of payment.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Penal Interest Mechanics (Sections 234B &amp; 234C)</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              The Income-tax Act enforces strict compliance through compounding interest charges on late or inadequate payments:
            </p>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Section 234C (Deferment Interest):</strong> Charged at <strong>1% simple interest per month</strong> for 3 months each on shortfalls at the June 15, Sept 15, and Dec 15 gates (1 month for March 15).</li>
              <li><strong>Safe-Harbor Gateways:</strong> Taxpayers are protected from 234C interest if they pay at least <strong>12%</strong> by 15 June and at least <strong>36%</strong> by 15 September.</li>
              <li><strong>Section 234B (Shortfall at Year-End):</strong> If cumulative advance tax paid by 31 March is less than <strong>90%</strong> of the final assessed tax liability, interest at <strong>1% per month</strong> runs from 1 April of the Assessment Year until the date of actual payment.</li>
            </ul>
          </div>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted space-y-3">
        <div>
          <strong class="text-text-primary text-sm block mb-1">Need help calculating quarterly installments and avoiding penal interest?</strong>
          Read our complete statutory walkthrough: <a href="/blog/advance-tax-guide" class="text-accent font-medium hover:underline">Advance Tax in India: The Quarterly Calendar and How to Avoid Section 234B &amp; 234C Penal Interest</a> for safe-harbor rules and presumptive taxation deadlines.
        </div>
        <div class="pt-2 border-t border-border">
          <strong class="text-text-primary block mb-0.5">Wondering how TDS credits offset your quarterly advance tax liability?</strong>
          Read our comparison on <a href="/blog/tds-vs-advance-tax-difference" class="text-accent font-medium hover:underline">TDS vs. Advance Tax: Key Differences, Payment Responsibilities, and Form 26AS Reconciliation</a>.
        </div>
        <div class="pt-2 border-t border-border">
          <strong class="text-text-primary block mb-0.5">Booked profits on stocks, mutual funds, or property?</strong>
          Learn how revised capital gains tax rules work and how Section 234C protects windfalls in our guide: <a href="/blog/capital-gains-tax-rules" class="text-accent font-medium hover:underline">Capital Gains Tax in India (Post-Budget 2024): Rates, Holding Periods, and the Real Estate Indexation Rule</a>.
        </div>
      </div>

      <section aria-labelledby="at-calculator-faq">
        <h2 id="at-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="at-calculator-related">
        <h2 id="at-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related tax calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/in/income-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Income Tax Calculator (India)</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Compare Old vs New Tax Regime tax liability per Finance Act 2024-25.</p>
          </a>
          <a href="/in/tds-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">TDS Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Calculate Tax Deducted at Source withholding amounts across commercial and professional sections.</p>
          </a>
          <a href="/in/capital-gains-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Capital Gains Tax Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Compute STCG and LTCG tax liabilities across equity, real estate, and gold under Budget 2024 rules.</p>
          </a>
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcAdvanceTax } from '../../lib/tax/india';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initAdvanceTaxCalc() {
    if ((window as any).__cmAdvTaxBound) return;
    (window as any).__cmAdvTaxBound = true;

    const taxInput = document.getElementById('at-tax') as HTMLInputElement | null;
    const taxSlider = document.getElementById('at-tax-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('at-result-hero');
    const instEls = [
      document.getElementById('at-inst-0'),
      document.getElementById('at-inst-1'),
      document.getElementById('at-inst-2'),
      document.getElementById('at-inst-3'),
    ];

    const errAlert = document.getElementById('at-error-alert');
    const errMsg = document.getElementById('at-error-msg');

    if (!taxInput) return;

    const DEFAULTS = { tax: 100000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawTax = taxInput!.value.replace(/[^0-9.]/g, '');
      const vTax = validate(rawTax, { required: true, min: 0, label: 'Tax Liability' });

      if (!vTax.valid) { showError(vTax.error!.message); return; }
      clearError();

      const tax = vTax.value!;
      const res = calcAdvanceTax(tax);

      setResult({
        heroValue: res.required ? fmtVal(res.annualTaxLiability) : 'Exempt (< ₹10k)',
        heroLabel: 'Estimated Advance Tax',
        rows: res.instalments.map((inst) => ({
          label: `${inst.dueDate} (${inst.cumulativePct}%)`,
          value: fmtVal(inst.instalment),
        })),
      });

      if (resHero) {
        resHero.textContent = res.required ? fmtVal(res.annualTaxLiability) : 'Exempt (< ₹10,000)';
      }

      res.instalments.forEach((inst, idx) => {
        if (instEls[idx]) instEls[idx]!.textContent = fmtVal(inst.instalment);
      });

      serializeHash({ tax });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    if (taxSlider) {
      taxSlider.addEventListener('input', () => {
        taxInput.value = fmtLiveInput(taxSlider.value);
        const pct = ((parseFloat(taxSlider.value) - parseFloat(taxSlider.min)) / (parseFloat(taxSlider.max) - parseFloat(taxSlider.min))) * 100;
        taxSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      taxInput.addEventListener('input', () => {
        const raw = taxInput.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(taxSlider.min) && num <= parseFloat(taxSlider.max)) {
          taxSlider.value = String(num);
          const pct = ((num - parseFloat(taxSlider.min)) / (parseFloat(taxSlider.max) - parseFloat(taxSlider.min))) * 100;
          taxSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        taxInput.value = fmtLiveInput(raw);
        debounce();
      });
    }

    document.getElementById('at-calculate')?.addEventListener('click', recalc);
    document.getElementById('at-reset')?.addEventListener('click', () => {
      taxInput.value = fmtLiveInput(String(DEFAULTS.tax));
      if (taxSlider) {
        taxSlider.value = String(DEFAULTS.tax);
        taxSlider.style.setProperty('--slider-pct', `${((DEFAULTS.tax - 5000) / (2000000 - 5000)) * 100}%`);
      }
      clearError();
      recalc();
      taxInput.focus();
    });

    taxInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') recalc();
    });

    document.getElementById('at-copy-btn')?.addEventListener('click', async () => {
      const rawTax = taxInput.value.replace(/[^0-9.]/g, '');
      const vTax = validate(rawTax, { required: true, min: 0, label: 'Tax' });
      if (!vTax.valid) return;
      const res = calcAdvanceTax(vTax.value!);
      const text = `Advance Tax Schedule (Total: ${fmtVal(res.annualTaxLiability)}): 15 June: ${fmtVal(res.instalments[0].instalment)}, 15 Sept: ${fmtVal(res.instalments[1].instalment)}, 15 Dec: ${fmtVal(res.instalments[2].instalment)}, 15 March: ${fmtVal(res.instalments[3].instalment)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('at-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('at-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('at-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      tax: { required: true, min: 0, label: 'tax' },
    });
    if (restored.valid && restored.values.tax !== undefined) {
      taxInput.value = fmtLiveInput(String(restored.values.tax));
      recalc();
    } else {
      recalc();
    }
  }

  initAdvanceTaxCalc();
  document.addEventListener('astro:page-load', initAdvanceTaxCalc);
</script>
