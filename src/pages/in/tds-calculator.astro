---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcTDS, TDS_RATES, type TDSSection } from '../../lib/tax/india';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT_AMOUNT = 100000;
const DEFAULT_SECTION: TDSSection = '194J';
const initialResult = calcTDS(DEFAULT_AMOUNT, DEFAULT_SECTION);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Taxes' && t.slug !== 'tds-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/in/tds-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'TDS Calculator India',
      url: canonicalUrl,
      description: 'Free TDS calculator India to compute Tax Deducted at Source, net receivable amount, and exemption threshold under the Income-tax Act.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'TDS Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What happens if the payment is below the TDS threshold?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If the aggregate or single payment does not exceed the statutory threshold specified under that section of the Income-tax Act, no TDS is deducted and the payee receives 100% of the gross invoice amount.',
          },
        },
        {
          '@type': 'Question',
          name: 'What TDS rate applies if the payee does not furnish a PAN?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under Section 206AA of the Income-tax Act, if the deductee fails to furnish a valid Permanent Account Number (PAN) to the deductor, TDS must be deducted at higher of the prescribed rate or 20%.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can TDS deducted be claimed back during income tax filing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. TDS is advance tax withheld on your behalf. When you file your annual Income Tax Return (ITR), the TDS reflected in your Form 26AS / Annual Information Statement (AIS) is adjusted against your final tax liability, and any excess is refunded directly to your bank account with interest.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between Section 194J for professional vs technical services?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under Section 194J, fees for professional services (such as legal, medical, engineering, accountancy) attract 10% TDS, whereas fees for purely technical services or call center operations attract a reduced rate of 2%, both sharing the ₹30,000 threshold.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do surcharge and Health & Education Cess apply to TDS on domestic payments?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No, for domestic resident individuals and entities, TDS on non-salary payments is deducted at the flat rate specified by the Finance Act without adding surcharge or the 4% Health and Education Cess.',
          },
        },
      ],
    },
  ],
};

const SECTION_OPTIONS = [
  { value: '194J', label: 'Section 194J — Professional Services (10%, threshold ₹30k)' },
  { value: '194C', label: 'Section 194C — Contractor / Sub-contractor (1%, threshold ₹30k)' },
  { value: '194I', label: 'Section 194I — Rent on Land / Building (10%, threshold ₹2.4L)' },
  { value: '194A', label: 'Section 194A — Interest on Bank FDs / Securities (10%, threshold ₹40k)' },
  { value: '194H', label: 'Section 194H — Commission / Brokerage (5%, threshold ₹15k)' },
  { value: '194',  label: 'Section 194 — Dividend from Domestic Company (10%, threshold ₹5k)' },
  { value: '194Q', label: 'Section 194Q — Purchase of Goods > ₹50 Lakh (0.1%, threshold ₹50L)' },
];
---

<Layout
  title="TDS Calculator India: Tax Deducted at Source | Calcumetrics"
  description="Free TDS calculator India. Calculate TDS deduction, net payment, and statutory Section 194 thresholds under the Indian Income-tax Act instantly."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="TDS Calculator"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(initialResult.tdsAmount)}
    heroLabel="Estimated TDS Deducted"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">TDS Calculator: FY 2026-27</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory source: <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Income Tax Department (CBDT)</a> · Chapter XVII-B.
      </p>

      <!-- Error alert -->
      <div id="tds-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="tds-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Payment Section -->
      <div class="mb-5">
        <Dropdown
          id="tds-section"
          label="TDS Section & Payment Nature"
          options={SECTION_OPTIONS}
          value="194J"
          helperText="Select the category of transaction under Income-tax Act"
        />
      </div>

      <!-- Gross Payment Amount -->
      <div class="mb-6">
        <Input
          id="tds-amount"
          label="Gross Payment / Bill Amount"
          prefix="₹"
          value="1,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total invoice or transaction value before tax"
          inputmode="decimal"
          aria-describedby="tds-error-msg"
        />
        <div class="mt-2">
          <Slider id="tds-amount-slider" min={5000} max={2000000} step={5000} value={100000} ariaLabel="Gross amount slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="tds-calculate" type="button">Calculate TDS Deduction</Button>
        <Button variant="ghost" id="tds-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">TDS Amount Withheld</span>
        <div id="tds-result-tds" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.tdsAmount)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Amount Payable / Receivable</span>
          <span id="tds-result-net" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.netAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Invoice Amount</span>
          <span id="tds-result-gross" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.grossAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">TDS Rate Applied</span>
          <span id="tds-result-rate" class="text-sm font-medium tabular-nums text-dark-text">{initialResult.ratePct}%</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Statutory Threshold</span>
          <span id="tds-result-threshold" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.threshold)}</span>
        </div>
      </div>

      <div class="mb-5" id="tds-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.netAmount / initialResult.grossAmount}
          gainFraction={initialResult.tdsAmount / initialResult.grossAmount}
          principalLabel="Net Payout"
          gainLabel="TDS Deducted"
          principalValue={fmt(initialResult.netAmount)}
          gainValue={fmt(initialResult.tdsAmount)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="tds-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="tds-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes resident deductee with PAN furnished. Higher rate of 20% applies under Sec 206AA if PAN is missing.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="tds-calculator-how">
        <h2 id="tds-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Tax Deducted at Source (TDS) works in India</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Tax Deducted at Source (TDS) is a direct taxation mechanism under the Indian Income-tax Act, 1961, designed to collect revenue at the very point of income generation. The paying entity (deductor) must withhold the prescribed percentage of tax before remitting the net proceeds to the recipient (deductee):
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed font-mono">
            <strong>1. Mandatory Withholding Condition:</strong> If Aggregate Payment &gt; Statutory Section Threshold<br /><br />
            <strong>2. TDS Deduction Formula:</strong> TDS Amount = [ Gross Base Payment &times; Section Withholding Rate (%) ] &divide; 100<br /><br />
            <strong>3. Below-Threshold Rule:</strong> If Aggregate Payment &le; Statutory Section Threshold &rarr; TDS = ₹0<br /><br />
            <strong>4. Net Receivable Payment:</strong> Net Payout = Gross Base Invoice &minus; TDS Amount<br /><br />
            <strong>5. Non-PAN Penalty (Sec 206AA):</strong> If Deductee Lacks Valid/Linked PAN &rarr; Rate = Higher of Prescribed Rate or 20%
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-Step Worked Example (Default Scenario)</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an independent professional or agency issuing an invoice of <strong>₹1,00,000</strong> for professional consulting services falling under <strong>Section 194J</strong> of the Income-tax Act:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-surface border-b border-border text-text-primary font-semibold">
                <th class="py-2.5 px-4">Statutory Step / Component</th>
                <th class="py-2.5 px-4">Legal Basis / Calculation</th>
                <th class="py-2.5 px-4">Computed Output</th>
                <th class="py-2.5 px-4">Tax Administration Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Gross Service Invoice Amount</td>
                <td class="py-2.5 px-4 font-mono">Contractual Fee for Services</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹1,00,000</td>
                <td class="py-2.5 px-4">Total gross revenue earned by the professional deductee.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Statutory Exemption Threshold</td>
                <td class="py-2.5 px-4 font-mono">Section 194J Annual Limit</td>
                <td class="py-2.5 px-4 font-mono">₹30,000 / Year</td>
                <td class="py-2.5 px-4">Since ₹1,00,000 exceeds ₹30,000, statutory withholding is mandatory.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Applicable TDS Withholding Rate</td>
                <td class="py-2.5 px-4 font-mono">Section 194J (Professional)</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">10.00%</td>
                <td class="py-2.5 px-4">Statutory rate for professional services (2% for purely technical services).</td>
              </tr>
              <tr class="bg-surface/50 font-semibold text-text-primary">
                <td class="py-2.5 px-4">Tax Deducted at Source (TDS)</td>
                <td class="py-2.5 px-4 font-mono">₹1,00,000 &times; 10.00%</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹10,000</td>
                <td class="py-2.5 px-4">Deposited by the client with Central Government via Challan ITNS 281.</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">Net Amount Disbursed to Payee</td>
                <td class="py-3 px-4 font-mono">₹1,00,000 &minus; ₹10,000</td>
                <td class="py-3 px-4 font-mono font-bold text-text-primary">₹90,000 (90.0%)</td>
                <td class="py-3 px-4">Actual bank transfer received into the professional's account.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Annual Tax Return Credit</td>
                <td class="py-2.5 px-4 font-mono">Form 26AS / AIS Credit</td>
                <td class="py-2.5 px-4 font-mono">₹10,000 Advance Credit</td>
                <td class="py-2.5 px-4">Credited against annual income tax liability; refundable if total tax &lt; TDS.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Common TDS Sections &amp; Statutory Thresholds</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Sec 194J (Professional / Technical):</strong> 10% for professional services; 2% for technical services. Annual threshold: <strong>₹30,000</strong>.</li>
              <li><strong>Sec 194C (Contractors / Freelance Work):</strong> 1% for Individuals/HUFs; 2% for Corporate entities. Threshold: <strong>₹30,000 single / ₹1,00,000 aggregate</strong>.</li>
              <li><strong>Sec 194I (Rent on Land &amp; Building):</strong> 10% for land/building (2% for plant/machinery). Annual threshold: <strong>₹2,40,000</strong>.</li>
              <li><strong>Sec 194A (Bank Interest &amp; FDs):</strong> 10% standard. Threshold: <strong>₹40,000</strong> for general citizens (<strong>₹50,000</strong> for senior citizens &ge;60 years).</li>
              <li><strong>Sec 194H (Commission &amp; Brokerage):</strong> Rationalized rate per Finance Act. Annual threshold: <strong>₹15,000</strong>.</li>
              <li><strong>Sec 194Q (Purchase of Goods):</strong> 0.1% on purchase value exceeding <strong>₹50,00,000</strong> in a financial year.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Section 206AA &amp; PAN Compliance Mandate</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              Furnishing a valid Permanent Account Number (PAN) is critical under Indian tax laws:
            </p>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>The 20% Non-PAN Penalty:</strong> Under Section 206AA, if the deductee fails to provide a valid PAN, the deductor must deduct TDS at the higher of the statutory rate or <strong>20.00%</strong>.</li>
              <li><strong>Inoperative PAN Trap:</strong> Failure to link PAN with Aadhaar renders the PAN legally "inoperative," automatically triggering the punitive 20% deduction rate.</li>
              <li><strong>Form 15G / 15H Exemption:</strong> Senior citizens (15H) and individuals with nil taxable income (15G) can submit self-declarations to receive interest without TDS deduction.</li>
            </ul>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions &amp; Regulatory Nuances</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Exclusion of Surcharge &amp; Cess:</strong> For domestic resident entities and individuals, TDS on commercial payments is deducted strictly at the flat rate prescribed by the Finance Act without adding surcharge or the 4% Health &amp; Education Cess.</li>
            <li><strong>GST Exclusion Rule:</strong> Per CBDT Circular No. 23/2017, when Goods and Services Tax (GST) is indicated separately on an invoice, TDS is deducted strictly on the basic value of services, excluding the GST component.</li>
            <li><strong>Form 16A Compliance:</strong> Deductors must deposit withheld tax by the 7th of the following month (30th April for March) and issue quarterly TDS certificates (Form 16A) to payees within 15 days of filing Form 26Q.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted space-y-3">
        <div>
          <strong class="text-text-primary text-sm block mb-1">TDS vs. Advance Tax: How Do They Interact?</strong>
          Read our in-depth comparison on <a href="/blog/tds-vs-advance-tax-difference" class="text-accent font-medium hover:underline">TDS vs. Advance Tax: Key Differences, Payment Responsibilities, and Form 26AS Reconciliation</a> to ensure your tax credits match before filing your annual return.
        </div>
        <div class="pt-2 border-t border-border">
          <strong class="text-text-primary block mb-0.5">Does TDS Cover Your Entire Annual Tax Liability?</strong>
          If tax deducted at source falls short of your total tax by ₹10,000 or more, you must pay quarterly advance tax to avoid 1% per month penal interest. Read our guide: <a href="/blog/advance-tax-guide" class="text-accent font-medium hover:underline">Advance Tax in India: The Quarterly Calendar and How to Avoid Section 234B &amp; 234C Penal Interest</a>.
        </div>
      </div>

      <section aria-labelledby="tds-calculator-faq">
        <h2 id="tds-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="tds-calculator-related">
        <h2 id="tds-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related tax calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/in/income-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Income Tax Calculator (India)</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Compare Old vs New Tax Regime tax liability per Finance Act 2024-25.</p>
          </a>
          <a href="/in/advance-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Advance Tax Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Calculate quarterly advance tax installments and Section 234B/234C interest liability.</p>
          </a>
          <a href="/in/salary-ctc-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Salary CTC Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Break down gross Cost-to-Company (CTC) into in-hand take-home salary, EPF, and taxes.</p>
          </a>
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcTDS, type TDSSection } from '../../lib/tax/india';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initTDSCalc() {
    if ((window as any).__cmTdsBound) return;
    (window as any).__cmTdsBound = true;

    const amtInput = document.getElementById('tds-amount') as HTMLInputElement | null;
    const secSelect = document.getElementById('tds-section') as HTMLSelectElement | null;
    const amtSlider = document.getElementById('tds-amount-slider') as HTMLInputElement | null;

    const resTds = document.getElementById('tds-result-tds');
    const resNet = document.getElementById('tds-result-net');
    const resGross = document.getElementById('tds-result-gross');
    const resRate = document.getElementById('tds-result-rate');
    const resThreshold = document.getElementById('tds-result-threshold');

    const errAlert = document.getElementById('tds-error-alert');
    const errMsg = document.getElementById('tds-error-msg');

    if (!amtInput || !secSelect) return;

    const DEFAULTS = { amount: 100000, section: '194J' as TDSSection };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawAmt = amtInput!.value.replace(/[^0-9.]/g, '');
      const section = secSelect!.value as TDSSection;

      const vAmt = validate(rawAmt, { required: true, min: 100, label: 'Payment Amount' });

      if (!vAmt.valid) { showError(vAmt.error!.message); return; }
      clearError();

      const amount = vAmt.value!;
      const res = calcTDS(amount, section);

      setResult({
        heroValue: fmtVal(res.tdsAmount),
        heroLabel: 'Estimated TDS Deducted',
        rows: [
          { label: 'Net Payable Amount', value: fmtVal(res.netAmount) },
          { label: 'Gross Invoice Amount', value: fmtVal(res.grossAmount) },
          { label: 'TDS Rate Applied', value: `${res.ratePct}%` },
          { label: 'Statutory Threshold', value: fmtVal(res.threshold) },
        ],
      });

      if (resTds) resTds.textContent = fmtVal(res.tdsAmount);
      if (resNet) resNet.textContent = fmtVal(res.netAmount);
      if (resGross) resGross.textContent = fmtVal(res.grossAmount);
      if (resRate) resRate.textContent = `${res.ratePct}%`;
      if (resThreshold) resThreshold.textContent = fmtVal(res.threshold);

      const wrapper = document.getElementById('tds-composition-wrapper');
      if (wrapper && res.grossAmount > 0) {
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${Math.min(100, (res.netAmount / res.grossAmount) * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.netAmount);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.tdsAmount);
      }

      serializeHash({ amt: amount, sec: section });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    if (amtSlider) {
      amtSlider.addEventListener('input', () => {
        amtInput.value = fmtLiveInput(amtSlider.value);
        const pct = ((parseFloat(amtSlider.value) - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
        amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      amtInput.addEventListener('input', () => {
        const raw = amtInput.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(amtSlider.min) && num <= parseFloat(amtSlider.max)) {
          amtSlider.value = String(num);
          const pct = ((num - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
          amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        amtInput.value = fmtLiveInput(raw);
        debounce();
      });
    }

    secSelect.addEventListener('change', recalc);

    document.getElementById('tds-calculate')?.addEventListener('click', recalc);
    document.getElementById('tds-reset')?.addEventListener('click', () => {
      amtInput.value = fmtLiveInput(String(DEFAULTS.amount));
      secSelect.value = DEFAULTS.section;
      if (amtSlider) {
        amtSlider.value = String(DEFAULTS.amount);
        amtSlider.style.setProperty('--slider-pct', `${((DEFAULTS.amount - 5000) / (2000000 - 5000)) * 100}%`);
      }
      clearError();
      recalc();
      amtInput.focus();
    });

    amtInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') recalc();
    });

    document.getElementById('tds-copy-btn')?.addEventListener('click', async () => {
      const rawAmt = amtInput.value.replace(/[^0-9.]/g, '');
      const sec = secSelect.value as TDSSection;
      const vAmt = validate(rawAmt, { required: true, min: 100, label: 'Amount' });
      if (!vAmt.valid) return;
      const res = calcTDS(vAmt.value!, sec);
      const text = `TDS Deducted: ${fmtVal(res.tdsAmount)} under Section ${res.section} on gross payment of ${fmtVal(res.grossAmount)} (Net Payout: ${fmtVal(res.netAmount)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('tds-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('tds-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('tds-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      amt: { required: true, min: 100, label: 'amt' },
    });
    if (restored.valid && restored.values.amt) {
      amtInput.value = fmtLiveInput(String(restored.values.amt));
      const hashParams = new URLSearchParams(readCurrentHash().replace(/^#/, ''));
      const sec = hashParams.get('sec');
      if (sec && ['194J', '194C', '194I', '194A', '194H', '194', '194Q'].includes(sec)) {
        secSelect.value = sec;
      }
      recalc();
    } else {
      recalc();
    }
  }

  initTDSCalc();
  document.addEventListener('astro:page-load', initTDSCalc);
</script>
