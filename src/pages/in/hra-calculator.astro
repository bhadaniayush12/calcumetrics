---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcHRA } from '../../lib/calculators/taxes';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = { basicSalary: 600000, hraReceived: 240000, rentPaid: 180000, isMetro: true };
const initialResult = calcHRA(DEFAULT.basicSalary, DEFAULT.hraReceived, DEFAULT.rentPaid, DEFAULT.isMetro);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Taxes' && t.slug !== 'hra-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/in/hra-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'HRA Calculator (India)',
      url: canonicalUrl,
      description: 'Calculate your HRA tax exemption amount under Section 10(13A) of the Income-tax Act, 1961.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'HRA Calculator (India)' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Which cities qualify for 50% basic salary HRA exemption?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under Indian income tax rules (Rule 2A), only four metropolitan cities qualify for the 50% ceiling: New Delhi, Mumbai, Kolkata, and Chennai. All other cities, including major IT hubs like Bengaluru, Hyderabad, and Pune, fall under the 40% non-metro category.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is landlord PAN mandatory to claim HRA tax exemption?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, per CBDT circulars, if annual rent paid exceeds ₹1,00,000 (more than ₹8,333 per month), it is mandatory to provide your landlord\'s Permanent Account Number (PAN) or declaration to your employer.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I claim HRA exemption under the New Tax Regime?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. HRA exemption under Section 10(13A) is available only under the Old Tax Regime. The default New Tax Regime (Section 115BAC) disallows HRA exemptions in exchange for lower personal income tax slab rates.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I pay rent to my parents and claim HRA exemption?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, you can claim HRA by paying rent to parents provided the property is owned by them, rent is paid through regular banking channels, rent receipts are maintained, and your parents declare this rental income in their respective Income Tax Returns.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is HRA exemption calculated if I own a house in another city?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'You can simultaneously claim both HRA exemption and home loan deductions (Section 24(b) and Section 80C) if your owned home is situated in a different city or you live in rented accommodation due to employment constraints.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="HRA Calculator India: Tax Exemption on House Rent Allowance | Calcumetrics"
  description="Calculate your HRA tax exemption amount under India's income tax rules. Minimum of three statutory limits determines the tax-free portion."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="HRA Calculator (India)"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(initialResult.exemption)}
    heroLabel="HRA Exemption Amount"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">HRA Calculator (India)</h1>
      <p class="text-sm text-text-muted mb-6">Calculate tax-exempt House Rent Allowance under Section 10(13A) of the Income Tax Act.</p>

      <!-- Error alert -->
      <div id="hra-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="hra-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Basic Salary -->
      <div class="mb-5">
        <Input
          id="hra-basic"
          label="Annual Basic Salary (+ DA)"
          prefix="₹"
          value="6,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Your annual basic pay + dearness allowance"
          inputmode="decimal"
          aria-describedby="hra-error-msg"
        />
        <div class="mt-2">
          <Slider id="hra-basic-slider" min={100000} max={5000000} step={25000} value={600000} ariaLabel="Basic salary slider" />
        </div>
      </div>

      <!-- HRA Received -->
      <div class="mb-5">
        <Input
          id="hra-received"
          label="Annual HRA Received"
          prefix="₹"
          value="2,40,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total HRA component provided by employer per year"
          inputmode="decimal"
          aria-describedby="hra-error-msg"
        />
        <div class="mt-2">
          <Slider id="hra-received-slider" min={20000} max={2500000} step={10000} value={240000} ariaLabel="HRA received slider" />
        </div>
      </div>

      <!-- Total Rent Paid -->
      <div class="mb-5">
        <Input
          id="hra-rent"
          label="Total Annual Rent Paid"
          prefix="₹"
          value="1,80,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Actual rent paid across the entire financial year"
          inputmode="decimal"
          aria-describedby="hra-error-msg"
        />
        <div class="mt-2">
          <Slider id="hra-rent-slider" min={20000} max={2500000} step={10000} value={180000} ariaLabel="Rent paid slider" />
        </div>
      </div>

      <!-- City Type -->
      <div class="mb-6">
        <Dropdown
          id="hra-city"
          label="City of Residence"
          options={[
            { value: 'metro', label: 'Metro (Delhi, Mumbai, Kolkata, Chennai) — 50% Basic' },
            { value: 'non-metro', label: 'Non-Metro (All other cities) — 40% Basic' },
          ]}
          value="metro"
          helperText="Select metro for Delhi/NCR, Mumbai, Kolkata, Chennai"
        />
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="hra-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="hra-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Exempt HRA Amount</span>
        <div id="hra-result-exemption" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.exemption)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Taxable HRA Amount</span>
          <span id="hra-result-taxable" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.taxableHRA)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Rule 1: Actual HRA Received</span>
          <span id="hra-rule-actual" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.actualHRA)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Rule 2: Rent Paid − 10% Basic</span>
          <span id="hra-rule-rentdiff" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.rentMinusTenPct)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Rule 3: Statutory Basic Cap</span>
          <span id="hra-rule-ceiling" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.metroLimit)}</span>
        </div>
      </div>

      <div class="mb-5" id="hra-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.actualHRA > 0 ? initialResult.exemption / initialResult.actualHRA : 1}
          gainFraction={initialResult.actualHRA > 0 ? initialResult.taxableHRA / initialResult.actualHRA : 0}
          principalLabel="Exempt HRA"
          gainLabel="Taxable HRA"
          principalValue={fmt(initialResult.exemption)}
          gainValue={fmt(initialResult.taxableHRA)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="hra-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="hra-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Jurisdiction: India (INR locked). HRA exemption is claimable under the Old Tax Regime only.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="hra-calculator-how">
        <h2 id="hra-calculator-how" class="text-xl font-bold text-text-primary mb-4">How HRA exemption is calculated</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-4">
          <p class="text-sm text-text-muted leading-relaxed mb-3">
            Under Section 10(13A) of the Income-tax Act, 1961, the tax-exempt portion of House Rent Allowance is the <strong>lowest</strong> of the following three limits:
          </p>
          <ol class="list-decimal pl-5 space-y-2 text-sm text-text-muted leading-relaxed">
            <li><strong>Actual HRA received</strong> from your employer during the financial year.</li>
            <li><strong>Actual rent paid minus 10% of basic salary</strong> (+ Dearness Allowance).</li>
            <li><strong>50% of basic salary</strong> for metro cities (Delhi, Mumbai, Kolkata, Chennai) or <strong>40% of basic salary</strong> for non-metro cities.</li>
          </ol>
        </div>
      </section>

      <section aria-labelledby="hra-calculator-faq">
        <h2 id="hra-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="hra-calculator-related">
        <h2 id="hra-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcHRA } from '../../lib/calculators/taxes';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initHRACalc() {
    if ((window as any).__cmHraBound) return;
    (window as any).__cmHraBound = true;

    const basicInput = document.getElementById('hra-basic') as HTMLInputElement | null;
    const hraInput = document.getElementById('hra-received') as HTMLInputElement | null;
    const rentInput = document.getElementById('hra-rent') as HTMLInputElement | null;
    const citySelect = document.getElementById('hra-city') as HTMLSelectElement | null;

    const basicSlider = document.getElementById('hra-basic-slider') as HTMLInputElement | null;
    const hraSlider = document.getElementById('hra-received-slider') as HTMLInputElement | null;
    const rentSlider = document.getElementById('hra-rent-slider') as HTMLInputElement | null;

    const resExemption = document.getElementById('hra-result-exemption');
    const resTaxable = document.getElementById('hra-result-taxable');
    const ruleActual = document.getElementById('hra-rule-actual');
    const ruleRentDiff = document.getElementById('hra-rule-rentdiff');
    const ruleCeiling = document.getElementById('hra-rule-ceiling');

    const errAlert = document.getElementById('hra-error-alert');
    const errMsg = document.getElementById('hra-error-msg');

    if (!basicInput || !hraInput || !rentInput) return;

    const DEFAULTS = { basic: 600000, hra: 240000, rent: 180000, city: 'metro' };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawBasic = basicInput!.value.replace(/[^0-9.]/g, '');
      const rawHra = hraInput!.value.replace(/[^0-9.]/g, '');
      const rawRent = rentInput!.value.replace(/[^0-9.]/g, '');
      const isMetro = citySelect ? citySelect.value === 'metro' : true;

      const vBasic = validate(rawBasic, { required: true, min: 10000, label: 'Basic Salary' });
      const vHra = validate(rawHra, { required: true, min: 0, label: 'HRA Received' });
      const vRent = validate(rawRent, { required: true, min: 0, label: 'Rent Paid' });

      if (!vBasic.valid) { showError(vBasic.error!.message); return; }
      if (!vHra.valid) { showError(vHra.error!.message); return; }
      if (!vRent.valid) { showError(vRent.error!.message); return; }
      clearError();

      const basic = vBasic.value!;
      const hra = vHra.value!;
      const rent = vRent.value!;

      const res = calcHRA(basic, hra, rent, isMetro);

      setResult({
        heroValue: fmtVal(res.exemption),
        heroLabel: 'HRA Exemption Amount',
        rows: [
          { label: 'Taxable HRA', value: fmtVal(res.taxableHRA) },
          { label: 'Actual HRA Received', value: fmtVal(res.actualHRA) },
          { label: 'Rent Paid − 10% Basic', value: fmtVal(res.rentMinusTenPct) },
          { label: 'Statutory Basic Cap', value: fmtVal(res.metroLimit) },
        ],
      });

      if (resExemption) resExemption.textContent = fmtVal(res.exemption);
      if (resTaxable) resTaxable.textContent = fmtVal(res.taxableHRA);
      if (ruleActual) ruleActual.textContent = fmtVal(res.actualHRA);
      if (ruleRentDiff) ruleRentDiff.textContent = fmtVal(res.rentMinusTenPct);
      if (ruleCeiling) ruleCeiling.textContent = fmtVal(res.metroLimit);

      const wrapper = document.getElementById('hra-composition-wrapper');
      if (wrapper && res.actualHRA > 0) {
        const exemptFrac = res.exemption / res.actualHRA;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(exemptFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.exemption);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.taxableHRA);
      }

      serializeHash({ b: basic, h: hra, r: rent, c: isMetro ? 'metro' : 'non-metro' });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(basicSlider, basicInput);
    sync(hraSlider, hraInput);
    sync(rentSlider, rentInput);
    citySelect?.addEventListener('change', recalc);

    document.getElementById('hra-calculate')?.addEventListener('click', recalc);
    document.getElementById('hra-reset')?.addEventListener('click', () => {
      basicInput.value = fmtLiveInput(String(DEFAULTS.basic));
      hraInput.value = fmtLiveInput(String(DEFAULTS.hra));
      rentInput.value = fmtLiveInput(String(DEFAULTS.rent));
      if (citySelect) citySelect.value = DEFAULTS.city;
      if (basicSlider) {
        basicSlider.value = String(DEFAULTS.basic);
        basicSlider.style.setProperty('--slider-pct', `${((DEFAULTS.basic - 100000) / (5000000 - 100000)) * 100}%`);
      }
      if (hraSlider) {
        hraSlider.value = String(DEFAULTS.hra);
        hraSlider.style.setProperty('--slider-pct', `${((DEFAULTS.hra - 20000) / (2500000 - 20000)) * 100}%`);
      }
      if (rentSlider) {
        rentSlider.value = String(DEFAULTS.rent);
        rentSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rent - 20000) / (2500000 - 20000)) * 100}%`);
      }
      clearError();
      recalc();
      basicInput.focus();
    });

    [basicInput, hraInput, rentInput].forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    document.getElementById('hra-copy-btn')?.addEventListener('click', async () => {
      const rawBasic = basicInput.value.replace(/[^0-9.]/g, '');
      const rawHra = hraInput.value.replace(/[^0-9.]/g, '');
      const rawRent = rentInput.value.replace(/[^0-9.]/g, '');
      const isMetro = citySelect ? citySelect.value === 'metro' : true;

      const vBasic = validate(rawBasic, { required: true, min: 10000, label: 'Basic' });
      const vHra = validate(rawHra, { required: true, min: 0, label: 'HRA' });
      const vRent = validate(rawRent, { required: true, min: 0, label: 'Rent' });

      if (!vBasic.valid || !vHra.valid || !vRent.valid) return;

      const res = calcHRA(vBasic.value!, vHra.value!, vRent.value!, isMetro);
      const text = `HRA Exemption: Basic ${fmtVal(vBasic.value!)}, HRA ${fmtVal(vHra.value!)}, Rent ${fmtVal(vRent.value!)} => Tax Exempt HRA = ${fmtVal(res.exemption)}, Taxable HRA = ${fmtVal(res.taxableHRA)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('hra-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('hra-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('hra-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      b: { required: true, min: 10000, label: 'b' },
      h: { required: true, min: 0, label: 'h' },
      r: { required: true, min: 0, label: 'r' },
    });
    if (restored.valid && restored.values.b && restored.values.h !== undefined && restored.values.r !== undefined) {
      basicInput.value = fmtLiveInput(String(restored.values.b));
      hraInput.value = fmtLiveInput(String(restored.values.h));
      rentInput.value = fmtLiveInput(String(restored.values.r));
      const hashParams = new URLSearchParams(readCurrentHash().replace(/^#/, ''));
      const c = hashParams.get('c');
      if (c && citySelect) citySelect.value = c;
      recalc();
    } else {
      recalc();
    }
  }

  initHRACalc();
  document.addEventListener('astro:page-load', initHRACalc);
</script>
