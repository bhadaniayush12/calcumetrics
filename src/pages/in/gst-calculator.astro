---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcGST } from '../../lib/calculators/taxes';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = { amount: 10000, slab: 18, isInterState: false, direction: 'add' as const };
const initialResult = calcGST(DEFAULT.amount, DEFAULT.slab, DEFAULT.isInterState, DEFAULT.direction);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Taxes' && t.slug !== 'gst-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/in/gst-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'GST Calculator (India)',
      url: canonicalUrl,
      description: 'Calculate GST amounts for any base price using India\'s current GST slabs (5%, 12%, 18%, 28%). Add or remove GST with intra-state and inter-state splits.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'GST Calculator (India)' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What are the current GST slabs in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'India\'s statutory GST slabs are 0% (exempt essential food grains, fresh produce), 5% (packaged food, economy transport), 12% (standard lower rate for processed items), 18% (standard rate on most manufactured goods and commercial services), and 28% (automobiles, luxury goods, aerated drinks).',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between CGST, SGST, and IGST?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For transactions within the same state (intra-state), GST is divided equally into CGST (Central GST) and SGST (State GST). For transactions across state borders (inter-state), IGST (Integrated GST) is charged at the full combined rate to the Central Government and credited to the destination state.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I remove GST from an inclusive price?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'To extract the original base price from a GST-inclusive invoice total: Base Price = (Total Gross Amount × 100) ÷ (100 + GST Rate). The GST Amount is the difference between the total gross amount and the computed base price.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the GST threshold turnover for mandatory business registration?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For supplier of goods, GST registration is mandatory if aggregate annual turnover exceeds ₹40 lakh (₹20 lakh for special category states). For service providers, the mandatory registration threshold is ₹20 lakh (₹10 lakh for special category states).',
          },
        },
        {
          '@type': 'Question',
          name: 'What is an Input Tax Credit (ITC)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Input Tax Credit allows registered businesses to claim credit for GST paid on business purchases and capital equipment against the GST liability collected on their outward sales, avoiding cascading taxation.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="GST Calculator India: Compute GST at Current Slabs | Calcumetrics"
  description="Calculate GST amounts for any base price using India's current GST slabs (5%, 12%, 18%, 28%). Add or remove GST with intra-state and inter-state splits."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="GST Calculator (India)"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(initialResult.gstAmount)}
    heroLabel="Estimated GST Amount"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">GST Calculator (India)</h1>
      <p class="text-sm text-text-muted mb-6">Calculate GST amounts, inclusive/exclusive pricing, and CGST/SGST/IGST breakdown.</p>

      <!-- Error alert -->
      <div id="gst-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="gst-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Amount -->
      <div class="mb-5">
        <Input
          id="gst-amount"
          label="Amount"
          prefix="₹"
          value="10,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Base price or total inclusive amount"
          inputmode="decimal"
          aria-describedby="gst-error-msg"
        />
        <div class="mt-2">
          <Slider id="gst-amount-slider" min={500} max={1000000} step={500} value={10000} ariaLabel="Amount slider" />
        </div>
      </div>

      <!-- GST Slab -->
      <div class="mb-5">
        <Dropdown
          id="gst-slab"
          label="GST Slab Rate"
          options={[
            { value: '0', label: '0% (Exempt)' },
            { value: '5', label: '5% (Essential Goods & Transport)' },
            { value: '12', label: '12% (Standard Lower Rate)' },
            { value: '18', label: '18% (Standard Rate - Most Services)' },
            { value: '28', label: '28% (Luxury & Sin Goods)' },
          ]}
          value="18"
          helperText="Applicable GST slab under Indian tax law"
        />
      </div>

      <!-- Direction -->
      <div class="mb-5">
        <Dropdown
          id="gst-direction"
          label="Calculation Mode"
          options={[
            { value: 'add', label: 'Add GST (Exclusive — amount does not include GST)' },
            { value: 'remove', label: 'Remove GST (Inclusive — amount already includes GST)' },
          ]}
          value="add"
          helperText="Exclusive adds tax to base price; Inclusive extracts tax from gross"
        />
      </div>

      <!-- Supply Type -->
      <div class="mb-6">
        <Dropdown
          id="gst-supply-type"
          label="Supply Nature"
          options={[
            { value: 'intra', label: 'Intra-State (Within same State: CGST + SGST)' },
            { value: 'inter', label: 'Inter-State (Between different States: IGST)' },
          ]}
          value="intra"
          helperText="Determines whether tax is split into CGST/SGST or paid as IGST"
        />
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="gst-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="gst-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Total GST Amount</span>
        <div id="gst-result-tax" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.gstAmount)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Base Amount</span>
          <span id="gst-result-base" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.baseAmount)}</span>
        </div>
        <div id="gst-row-cgst" class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">CGST (<span id="gst-cgst-pct">9</span>%)</span>
          <span id="gst-result-cgst" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.cgst)}</span>
        </div>
        <div id="gst-row-sgst" class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">SGST (<span id="gst-sgst-pct">9</span>%)</span>
          <span id="gst-result-sgst" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.sgst)}</span>
        </div>
        <div id="gst-row-igst" class="hidden flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">IGST (<span id="gst-igst-pct">18</span>%)</span>
          <span id="gst-result-igst" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.igst)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Gross Amount</span>
          <span id="gst-result-total" class="text-sm font-bold tabular-nums text-dark-text">{fmt(initialResult.totalAmount)}</span>
        </div>
      </div>

      <div class="mb-5" id="gst-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.totalAmount > 0 ? initialResult.baseAmount / initialResult.totalAmount : 1}
          gainFraction={initialResult.totalAmount > 0 ? initialResult.gstAmount / initialResult.totalAmount : 0}
          principalLabel="Base Price"
          gainLabel="GST Amount"
          principalValue={fmt(initialResult.baseAmount)}
          gainValue={fmt(initialResult.gstAmount)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="gst-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="gst-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Jurisdiction: India (INR locked). Compliant with CGST, SGST, and IGST statutory requirements.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="gst-calculator-how">
        <h2 id="gst-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Indian GST is computed</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Under the Goods and Services Tax (GST) regime in India, tax liability is computed differently based on whether the quoted price is tax-exclusive (base cost) or tax-inclusive (retail MRP):
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted mb-4">
          <div class="bg-surface border border-border rounded-card p-5 space-y-2">
            <h3 class="font-bold text-text-primary">1. Adding GST (Tax-Exclusive Base Price)</h3>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">GST Amount = (Base Price × Slab Rate) ÷ 100</p>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">Total Invoice Amount = Base Price + GST Amount</p>
            <p class="text-xs">Used for business-to-business (B2B) quotations, professional billing, and commercial procurement contracts.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-5 space-y-2">
            <h3 class="font-bold text-text-primary">2. Removing GST (Tax-Inclusive MRP)</h3>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">Base Price = (Gross Amount × 100) ÷ (100 + Slab Rate)</p>
            <p class="font-mono text-xs text-text-primary bg-canvas p-2 rounded">GST Amount = Gross Amount − Base Price</p>
            <p class="text-xs">Used to extract the embedded tax component and underlying pre-tax cost from consumer retail products and MRP tags.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="gst-worked-examples">
        <h2 id="gst-worked-examples" class="text-xl font-bold text-text-primary mb-4">Step-by-step worked examples (18% Slab)</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted mb-4">
          <div class="bg-surface border border-border rounded-card p-5 space-y-3">
            <h3 class="font-bold text-text-primary border-b border-border/50 pb-2">Example A: Exclusive Invoice (Add GST)</h3>
            <p class="text-xs">A software consultant bills a client within Karnataka for <strong>₹10,000</strong> net professional fees:</p>
            <div class="space-y-1.5 text-xs">
              <div class="flex justify-between"><span>Base Taxable Value:</span><strong class="font-mono text-text-primary">₹10,000</strong></div>
              <div class="flex justify-between"><span>CGST @ 9%:</span><strong class="font-mono text-text-primary">₹900</strong></div>
              <div class="flex justify-between"><span>SGST @ 9%:</span><strong class="font-mono text-text-primary">₹900</strong></div>
              <div class="flex justify-between border-t border-border/50 pt-1.5 font-bold"><span>Total Invoice Receivable:</span><strong class="font-mono text-accent">₹11,800</strong></div>
            </div>
            <p class="text-xs text-text-muted pt-1">If the client were in Maharashtra (inter-state), a single <strong>IGST of ₹1,800 (18%)</strong> would apply instead.</p>
          </div>

          <div class="bg-surface border border-border rounded-card p-5 space-y-3">
            <h3 class="font-bold text-text-primary border-b border-border/50 pb-2">Example B: Inclusive Retail MRP (Remove GST)</h3>
            <p class="text-xs">A customer purchases a smartphone accessory priced at <strong>₹10,000</strong> inclusive of 18% GST:</p>
            <div class="space-y-1.5 text-xs">
              <div class="flex justify-between"><span>Gross Retail Price (MRP):</span><strong class="font-mono text-text-primary">₹10,000</strong></div>
              <div class="flex justify-between"><span>Computed Base Price:</span><strong class="font-mono text-text-primary">₹8,475</strong></div>
              <div class="flex justify-between"><span>CGST Component (9%):</span><strong class="font-mono text-text-primary">₹762.50</strong></div>
              <div class="flex justify-between"><span>SGST Component (9%):</span><strong class="font-mono text-text-primary">₹762.50</strong></div>
              <div class="flex justify-between border-t border-border/50 pt-1.5 font-bold"><span>Total Embedded GST (18%):</span><strong class="font-mono text-accent">₹1,525</strong></div>
            </div>
            <p class="text-xs text-text-muted pt-1">The seller retains ₹8,475 as net product revenue and remits ₹1,525 to the government tax portal.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="gst-slabs-overview">
        <h2 id="gst-slabs-overview" class="text-xl font-bold text-text-primary mb-4">India statutory GST rate slabs & item coverage</h2>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="p-3">Slab Rate</th>
                <th class="p-3">Classification</th>
                <th class="p-3">Representative Goods & Services</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted text-xs">
              <tr>
                <td class="p-3 font-bold text-text-primary font-mono">0% (Exempt)</td>
                <td class="p-3">Essential Staples</td>
                <td class="p-3">Unpackaged fresh produce, milk, eggs, salt, curd, bread, municipal water.</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-primary font-mono">5%</td>
                <td class="p-3">Household Essentials</td>
                <td class="p-3">Packaged food, edible oils, sugar, tea, domestic LPG, economy transport, life-saving medicines.</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-primary font-mono">12%</td>
                <td class="p-3">Standard Lower Tier</td>
                <td class="p-3">Processed foods, fruit juices, dairy products (butter/ghee), non-AC hotel rooms, cellular phones.</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-primary font-mono">18%</td>
                <td class="p-3">Standard General Tier</td>
                <td class="p-3">IT services, software, telecom, banking & financial services, capital goods, restaurants, consumer goods.</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-text-primary font-mono">28%</td>
                <td class="p-3">Luxury & Demerit</td>
                <td class="p-3">Motor vehicles, luxury motorcycles (>350cc), air conditioners, aerated drinks, pan masala, online gaming.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="gst-compliance-notes">
        <h2 id="gst-compliance-notes" class="text-xl font-bold text-text-primary mb-4">Input Tax Credit (ITC) & compliance rules</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted">
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Input Tax Credit (ITC) Mechanism</h3>
            <p>GST-registered entities can offset GST paid on inbound raw materials and capital purchases against outbound tax obligations, preventing tax-on-tax cascading provided invoices match auto-populated GSTR-2B records.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">GST Compensation Cess Note</h3>
            <p>Specific demerit and luxury items (such as SUVs, tobacco, and aerated waters) attract an additional statutory GST Compensation Cess on top of the 28% peak slab, which must be verified against CBIC tariff schedules.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Mandatory Registration Thresholds</h3>
            <p>Suppliers of goods must register if aggregate turnover exceeds ₹40 Lakh (₹20 Lakh for special category states). Service providers must register above ₹20 Lakh (₹10 Lakh for special category states).</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Place of Supply Rules</h3>
            <p>Tax classification strictly follows the legal Place of Supply: Intra-state (supplier and recipient in the same state) splits 50:50 into CGST and SGST; Inter-state supplies remit 100% as IGST to the Union government.</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="gst-calculator-faq">
        <h2 id="gst-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="gst-calculator-related">
        <h2 id="gst-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcGST } from '../../lib/calculators/taxes';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initGSTCalc() {
    if ((window as any).__cmGstBound) return;
    (window as any).__cmGstBound = true;

    const amtInput = document.getElementById('gst-amount') as HTMLInputElement | null;
    const amtSlider = document.getElementById('gst-amount-slider') as HTMLInputElement | null;
    const slabSelect = document.getElementById('gst-slab') as HTMLSelectElement | null;
    const dirSelect = document.getElementById('gst-direction') as HTMLSelectElement | null;
    const supplySelect = document.getElementById('gst-supply-type') as HTMLSelectElement | null;

    const resTax = document.getElementById('gst-result-tax');
    const resBase = document.getElementById('gst-result-base');
    const resCgst = document.getElementById('gst-result-cgst');
    const resSgst = document.getElementById('gst-result-sgst');
    const resIgst = document.getElementById('gst-result-igst');
    const resTotal = document.getElementById('gst-result-total');
    const rowCgst = document.getElementById('gst-row-cgst');
    const rowSgst = document.getElementById('gst-row-sgst');
    const rowIgst = document.getElementById('gst-row-igst');
    const cgstPct = document.getElementById('gst-cgst-pct');
    const sgstPct = document.getElementById('gst-sgst-pct');
    const igstPct = document.getElementById('gst-igst-pct');

    const errAlert = document.getElementById('gst-error-alert');
    const errMsg = document.getElementById('gst-error-msg');

    if (!amtInput) return;

    const DEFAULTS = { amount: 10000, slab: 18, direction: 'add' as const, supply: 'intra' };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawAmt = amtInput!.value.replace(/[^0-9.]/g, '');
      const slab = parseFloat(slabSelect ? slabSelect.value : '18') || 0;
      const direction = (dirSelect ? dirSelect.value : 'add') as 'add' | 'remove';
      const isInter = supplySelect ? supplySelect.value === 'inter' : false;

      const vAmt = validate(rawAmt, { required: true, min: 1, label: 'Amount' });
      if (!vAmt.valid) { showError(vAmt.error!.message); return; }
      clearError();

      const amt = vAmt.value!;
      const res = calcGST(amt, slab, isInter, direction);

      setResult({
        heroValue: fmtVal(res.gstAmount),
        heroLabel: 'Estimated GST Amount',
        rows: [
          { label: 'Net Base Amount', value: fmtVal(res.baseAmount) },
          { label: isInter ? 'IGST Amount' : 'CGST / SGST Split', value: isInter ? fmtVal(res.igst) : `${fmtVal(res.cgst)} each` },
          { label: 'Gross Total Amount', value: fmtVal(res.totalAmount) },
        ],
      });

      if (resTax) resTax.textContent = fmtVal(res.gstAmount);
      if (resBase) resBase.textContent = fmtVal(res.baseAmount);
      if (resTotal) resTotal.textContent = fmtVal(res.totalAmount);

      if (isInter) {
        if (rowCgst) rowCgst.classList.add('hidden');
        if (rowSgst) rowSgst.classList.add('hidden');
        if (rowIgst) {
          rowIgst.classList.remove('hidden');
          if (resIgst) resIgst.textContent = fmtVal(res.igst);
          if (igstPct) igstPct.textContent = String(slab);
        }
      } else {
        if (rowIgst) rowIgst.classList.add('hidden');
        if (rowCgst) {
          rowCgst.classList.remove('hidden');
          if (resCgst) resCgst.textContent = fmtVal(res.cgst);
          if (cgstPct) cgstPct.textContent = String(slab / 2);
        }
        if (rowSgst) {
          rowSgst.classList.remove('hidden');
          if (resSgst) resSgst.textContent = fmtVal(res.sgst);
          if (sgstPct) sgstPct.textContent = String(slab / 2);
        }
      }

      const wrapper = document.getElementById('gst-composition-wrapper');
      if (wrapper && res.totalAmount > 0) {
        const baseFrac = res.baseAmount / res.totalAmount;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(baseFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.baseAmount);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.gstAmount);
      }

      serializeHash({ a: amt, s: slab, d: direction, sup: isInter ? 'inter' : 'intra' });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    if (amtSlider) {
      amtSlider.addEventListener('input', () => {
        amtInput.value = fmtLiveInput(amtSlider.value);
        const pct = ((parseFloat(amtSlider.value) - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
        amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
    }
    amtInput.addEventListener('input', () => {
      const raw = amtInput.value.replace(/[^0-9.]/g, '');
      const num = parseFloat(raw);
      if (amtSlider && !isNaN(num) && num >= parseFloat(amtSlider.min) && num <= parseFloat(amtSlider.max)) {
        amtSlider.value = String(num);
        const pct = ((num - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
        amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
      }
      amtInput.value = fmtLiveInput(raw);
      debounce();
    });

    slabSelect?.addEventListener('change', recalc);
    dirSelect?.addEventListener('change', recalc);
    supplySelect?.addEventListener('change', recalc);

    document.getElementById('gst-calculate')?.addEventListener('click', recalc);
    document.getElementById('gst-reset')?.addEventListener('click', () => {
      amtInput.value = fmtLiveInput(String(DEFAULTS.amount));
      if (slabSelect) slabSelect.value = String(DEFAULTS.slab);
      if (dirSelect) dirSelect.value = DEFAULTS.direction;
      if (supplySelect) supplySelect.value = DEFAULTS.supply;
      if (amtSlider) {
        amtSlider.value = String(DEFAULTS.amount);
        amtSlider.style.setProperty('--slider-pct', `${((DEFAULTS.amount - 500) / (1000000 - 500)) * 100}%`);
      }
      clearError();
      recalc();
      amtInput.focus();
    });

    amtInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') recalc();
    });

    // Copy & Share
    document.getElementById('gst-copy-btn')?.addEventListener('click', async () => {
      const rawAmt = amtInput.value.replace(/[^0-9.]/g, '');
      const slab = parseFloat(slabSelect ? slabSelect.value : '18') || 0;
      const dir = (dirSelect ? dirSelect.value : 'add') as 'add' | 'remove';
      const isInter = supplySelect ? supplySelect.value === 'inter' : false;

      const vAmt = validate(rawAmt, { required: true, min: 1, label: 'Amount' });
      if (!vAmt.valid) return;

      const res = calcGST(vAmt.value!, slab, isInter, dir);
      const text = `GST Calculation: Amount ${fmtVal(vAmt.value!)} at ${slab}% (${dir}) = GST ${fmtVal(res.gstAmount)}, Total ${fmtVal(res.totalAmount)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('gst-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('gst-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('gst-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      a: { required: true, min: 1, label: 'a' },
    });
    if (restored.valid && restored.values.a) {
      amtInput.value = fmtLiveInput(String(restored.values.a));
      const hashParams = new URLSearchParams(readCurrentHash().replace(/^#/, ''));
      const s = hashParams.get('s');
      const d = hashParams.get('d');
      const sup = hashParams.get('sup');
      if (s && slabSelect) slabSelect.value = s;
      if (d && dirSelect) dirSelect.value = d;
      if (sup && supplySelect) supplySelect.value = sup;
      recalc();
    } else {
      recalc();
    }
  }

  initGSTCalc();
  document.addEventListener('astro:page-load', initGSTCalc);
</script>
