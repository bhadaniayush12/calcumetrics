---
/**
 * GST Calculator (India) — /in/gst-calculator
 * Master SEO & UX Gold Standard Template
 * Live reactive calculations, preset chips, compact Indian numbers, WhatsApp sharing,
 * featured snippet answer, CGST/SGST/IGST breakdown, statutory slabs, and real FAQs.
 */

import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcGST } from '../../lib/calculators/taxes';
import { formatIndian, formatIndianCompact, parseSmartInput } from '../../lib/formatters';
import { TOOLS } from '../../config/site';
import { getFreshness } from '../../data/page-freshness';

const freshness = getFreshness('/in/gst-calculator')!;

const DEFAULT = { amount: 10000, slab: 18, isInterState: false, direction: 'add' as const };
const initialResult = calcGST(DEFAULT.amount, DEFAULT.slab, DEFAULT.isInterState, DEFAULT.direction);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));
const heroExact = fmt(initialResult.gstAmount);
const heroCompact = formatIndianCompact(initialResult.gstAmount, '₹');
const baseExact = fmt(initialResult.baseAmount);
const baseCompact = formatIndianCompact(initialResult.baseAmount, '₹');
const totalExact = fmt(initialResult.totalAmount);
const totalCompact = formatIndianCompact(initialResult.totalAmount, '₹');

const RELATED_SLUGS = ['upi-mdr-calculator', 'profit-margin-calculator', 'income-tax-calculator'];
const related = RELATED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean);

const reverseExample = calcGST(initialResult.totalAmount, DEFAULT.slab, false, 'remove');
const interStateExample = calcGST(DEFAULT.amount, DEFAULT.slab, true, 'add');

const canonicalUrl = 'https://calcumetrics.com/in/gst-calculator';
const pageTitle = 'GST Calculator: Add or Remove GST & Check Tax Split';
const pageDesc = 'Add GST to a price or remove it from an inclusive total. See CGST, SGST and IGST splits, reverse GST examples and the formula for checking an invoice.';

const faqs = [
  { question: "How do I calculate GST on a price?", answer: "For a price before GST, multiply the taxable base by the GST percentage divided by 100. Add that tax amount to the base to get the invoice total. Select Add GST in the calculator." },
  { question: "How do I remove GST from an inclusive amount?", answer: "Divide the GST-inclusive total by 1 plus the GST rate divided by 100. The result is the taxable base; subtract it from the total to find the included GST. Select Remove GST rather than applying the percentage directly to the inclusive total." },
  { question: "How do I calculate 18% GST?", answer: `At an assumed 18% rate, a base of ${fmt(DEFAULT.amount)} gives GST of ${fmt(initialResult.gstAmount)} and a total of ${fmt(initialResult.totalAmount)}. Removing 18% from that inclusive total returns a base of ${fmt(reverseExample.baseAmount)}. Use 18% only where it is the applicable invoice rate.` },
  { question: "What is the difference between CGST, SGST and IGST?", answer: "For an ordinary taxable intra-state supply, GST is split into central and state components. An inter-state supply generally attracts IGST at the combined rate. The supplier’s location and legal place of supply determine this; imports, SEZ supplies and union territories need their applicable rules." },
  { question: "Is reverse GST calculation the same as reverse charge?", answer: "No. Reverse GST calculation extracts tax from a total that already includes it. Reverse charge is a legal rule about who must pay the tax. This tool performs arithmetic and does not decide whether reverse charge applies." },
  { question: "Can I use this GST calculator for an invoice?", answer: "Use it to check the taxable base, GST and total for one rate at a time. Confirm the item’s rate and place of supply first. It does not determine input tax credit, registration eligibility, cess or net tax payable on a return, and the displayed amounts are rounded to whole rupees." }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'GST Calculator (India)',
      url: canonicalUrl,
      description: pageDesc,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en-IN',
      dateModified: freshness.lastReviewed,
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'GST Calculator (India)', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <CalculatorLayout
    toolName="GST Calculator (India)"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={heroExact}
    heroLabel="GST Tax Amount"
  >
    <!-- ── INPUT CARD ─────────────────────────────────────────────────────────── -->
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          GST Calculator India
        </h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Reviewed: 19 Oct 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Choose the rate applicable to your invoice. <a href="https://gstcouncil.gov.in/sites/default/files/2025-09/press_release_press_information_bureau_0.pdf" class="text-accent font-medium hover:underline">GST Council rate-reform guidance</a> is a starting point; the item’s classification, notification and supply date determine its treatment.
      </p>

      <!-- Amount Input + Presets -->
      <div class="mb-6">
        <Input
          id="gst-amount"
          label="Amount"
          prefix="₹"
          value="10,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Base price or total inclusive amount"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="gst-amount-slider" min={500} max={1000000} step={500} value={10000} ariaLabel="Amount slider" />
        </div>
        <!-- Preset chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="Amount presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Presets:</span>
          {[
            { val: 1000, label: '₹1k' },
            { val: 5000, label: '₹5k' },
            { val: 10000, label: '₹10k' },
            { val: 50000, label: '₹50k' },
            { val: 100000, label: '₹1L' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-amount={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- GST Slab Dropdown + Chips -->
      <div class="mb-6">
        <Dropdown
          id="gst-slab"
          label="GST Slab Rate"
          options={[
            { value: '0', label: '0% (Nil / Exempt)' },
            { value: '5', label: '5%' },
            { value: '18', label: '18%' },
            { value: '40', label: '40%' },
            { value: '12', label: '12%' },
            { value: '28', label: '28%' },
          ]}
          value="18"
          helperText="Use the applicable rate from the invoice and relevant tax notification"
        />
        <!-- Slab quick chips -->
        <div class="flex items-center gap-1.5 mt-2 flex-wrap" aria-label="GST slab presets">
          <span class="text-[11px] font-medium text-text-muted mr-1">Quick Slabs:</span>
          {[
            { val: 0, label: '0%' },
            { val: 5, label: '5%' },
            { val: 18, label: '18%' },
            { val: 40, label: '40%' },
            { val: 12, label: '12%' },
            { val: 28, label: '28%' },
          ].map((chip) => (
            <button
              type="button"
              data-chip-slab={chip.val}
              class="px-2 py-0.5 rounded text-xs font-medium border border-border bg-surface hover:bg-canvas hover:border-accent text-text-primary hover:text-accent transition-standard cursor-pointer"
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Calculation Mode (Add vs Remove) -->
      <div class="mb-5">
        <Dropdown
          id="gst-direction"
          label="Calculation Mode"
          options={[
            { value: 'add', label: 'Add GST (Exclusive — Amount excludes tax)' },
            { value: 'remove', label: 'Remove GST (Inclusive — Amount includes tax)' },
          ]}
          value="add"
          helperText="Exclusive adds tax to base; Inclusive extracts tax from gross"
        />
      </div>

      <!-- Supply Nature -->
      <div class="mb-5">
        <Dropdown
          id="gst-supply-type"
          label="Supply Nature"
          options={[
            { value: 'intra', label: 'Intra-State (Within same State: CGST + SGST split)' },
            { value: 'inter', label: 'Inter-State (Across State borders: IGST)' },
          ]}
          value="intra"
          helperText="Determines whether tax is split into CGST/SGST or paid as IGST"
        />
      </div>

      <!-- Error alert -->
      <div id="gst-error-alert" class="hidden mb-4" role="alert">
        <Alert variant="error" title="Input Error">
          <span id="gst-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <div class="flex justify-end pt-2">
        <button
          type="button"
          id="gst-reset"
          class="text-xs text-text-muted hover:text-accent font-medium py-1 px-2 rounded hover:bg-surface transition-standard cursor-pointer"
        >
          Reset to defaults
        </button>
      </div>
    </Fragment>

    <!-- ── OUTPUT PANEL ────────────────────────────────────────────────────────── -->
    <Fragment slot="outputs">
      <!-- GST Tax Amount Hero -->
      <div class="mb-5">
        <span class="text-xs font-semibold uppercase tracking-wider text-dark-muted block mb-1">
          GST Tax Amount
        </span>
        <div class="flex items-baseline gap-2 flex-wrap">
          <div
            id="gst-result-tax-compact"
            class="text-3xl sm:text-4xl font-extrabold tabular-nums text-dark-accent tracking-tight"
            aria-live="polite"
            aria-atomic="true"
          >
            {heroCompact}
          </div>
          <span id="gst-result-tax" class="text-xs sm:text-sm text-dark-muted font-mono tabular-nums">
            ({heroExact})
          </span>
        </div>
      </div>

      <!-- Breakdown metrics -->
      <div class="space-y-0 border-t border-dark-border pt-4 mb-4">
        <div class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Net Base Amount</span>
          <div class="text-right">
            <span id="gst-result-base-compact" class="text-sm font-semibold tabular-nums text-dark-text mr-1.5">{baseCompact}</span>
            <span id="gst-result-base" class="text-xs text-dark-muted tabular-nums font-mono">({baseExact})</span>
          </div>
        </div>

        <!-- Intra-State CGST / SGST rows -->
        <div id="gst-row-cgst" class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">CGST (<span id="gst-cgst-pct">9</span>%)</span>
          <span id="gst-result-cgst" class="text-xs font-semibold tabular-nums text-dark-accent">₹900</span>
        </div>
        <div id="gst-row-sgst" class="flex items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">SGST (<span id="gst-sgst-pct">9</span>%)</span>
          <span id="gst-result-sgst" class="text-xs font-semibold tabular-nums text-dark-accent">₹900</span>
        </div>

        <!-- Inter-State IGST row -->
        <div id="gst-row-igst" class="hidden items-center justify-between py-2 border-b border-dark-border">
          <span class="text-xs text-dark-muted">IGST (<span id="gst-igst-pct">18</span>%)</span>
          <span id="gst-result-igst" class="text-xs font-semibold tabular-nums text-dark-accent">₹1,800</span>
        </div>

        <div class="flex items-center justify-between py-2">
          <span class="text-xs text-dark-muted font-medium">Gross Total Amount</span>
          <div class="text-right">
            <span id="gst-result-total-compact" class="text-sm font-bold tabular-nums text-dark-text mr-1.5">{totalCompact}</span>
            <span id="gst-result-total" class="text-xs text-dark-muted tabular-nums font-mono">({totalExact})</span>
          </div>
        </div>
      </div>

      <!-- Composition bar -->
      <div class="mb-4" id="gst-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.baseAmount / initialResult.totalAmount}
          gainFraction={initialResult.gstAmount / initialResult.totalAmount}
          principalLabel="Base Price"
          gainLabel="GST Tax"
          principalValue={baseExact}
          gainValue={heroExact}
        />
      </div>

      <!-- Share Actions -->
      <div class="space-y-2">
        <a
          id="gst-whatsapp-btn"
          href="https://api.whatsapp.com/send?text=Check%20out%20my%20GST%20calculation:%20Base%20%E2%82%B910,000%20+%2018%25%20GST%20(%E2%82%B91,800)%20=%20Total%20%E2%82%B911,800%20on%20Calcumetrics:%20https://calcumetrics.com/in/gst-calculator"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full h-10 text-xs font-semibold rounded-control bg-[#25D366] text-white hover:opacity-90 transition-standard focus-visible:outline-2 focus-visible:outline-white cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.782 2.791.782 3.183 0 5.769-2.587 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0 10.362c-.896 0-1.637-.247-2.366-.679l-.17-.1-1.758.461.469-1.714-.111-.177c-.476-.757-.727-1.466-.726-2.392.001-2.483 2.022-4.503 4.506-4.503 2.481 0 4.502 2.021 4.503 4.503-.001 2.483-2.023 4.503-4.507 4.503zm2.593-3.374c-.142-.071-.84-.415-.97-.462-.13-.047-.225-.071-.32.071-.095.142-.367.462-.45.557-.083.095-.166.107-.308.036s-.601-.222-1.145-.707c-.424-.378-.71-.845-.793-.987-.083-.142-.009-.219.062-.29.064-.064.142-.166.213-.249.071-.083.095-.142.142-.237.047-.095.024-.178-.012-.249s-.32-.771-.439-1.055c-.116-.277-.234-.239-.32-.243-.083-.004-.178-.005-.273-.005s-.249.036-.379.178c-.13.142-.498.486-.498 1.185s.51 1.375.581 1.47c.071.095 1.004 1.533 2.433 2.15.34.147.606.235.813.301.341.109.652.093.898.056.274-.041.84-.344.959-.676.119-.332.119-.617.083-.676-.035-.06-.13-.095-.272-.166z"/>
          </svg>
          Share on WhatsApp
        </a>
        <div class="flex gap-2">
          <button
            type="button"
            id="gst-copy-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Copy Result
          </button>
          <button
            type="button"
            id="gst-share-btn"
            class="flex-1 h-9 text-xs font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-dark-accent cursor-pointer"
          >
            Share Link
          </button>
        </div>
      </div>
    </Fragment>

    <!-- ── BELOW THE FOLD (SEO CONTENT) ───────────────────────────────────────── -->
    <Fragment slot="below">
      <p class="text-sm text-text-muted leading-relaxed mb-4">A GST calculator adds tax to a price before GST or extracts tax from a GST-inclusive total. Enter the amount and applicable rate, then choose the supply type to see a CGST/SGST or IGST split. It checks the arithmetic; you must establish the correct rate and place of supply for the invoice.</p>
        <div class="p-5 bg-surface border-l-4 border-accent rounded-r-card mb-8 shadow-sm">
          <p class="text-sm text-text-primary leading-relaxed" id="gst-snippet-answer">Adding {DEFAULT.slab}% GST to {baseExact} gives {heroExact} in tax and an invoice total of {totalExact}. The intra-state split is CGST {fmt(initialResult.cgst ?? 0)} and SGST {fmt(initialResult.sgst ?? 0)}.</p>
        </div>

      <section aria-labelledby="gst-how">
        <h2 id="gst-how" class="text-xl font-bold text-text-primary mb-4">GST calculation formula: inclusive and exclusive prices</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Choose the calculation mode to match the price you entered</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Price you have</th><th scope="col" class="text-left py-2.5 px-3">Calculation</th></tr></thead>
          <tbody><tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Before GST (exclusive)</td><td class="py-2.5 px-3 text-text-primary">GST = Base × Rate / 100; Total = Base + GST</td></tr>
            <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Including GST (inclusive)</td><td class="py-2.5 px-3 text-text-primary">Base = Total × 100 / (100 + Rate); GST = Total − Base</td></tr></tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">When removing GST, the percentage applies to the underlying base. Subtracting the rate directly from the inclusive total gives a different result because that total already contains tax.</p>
      </section>

      <section aria-labelledby="gst-worked-example">
        <h2 id="gst-worked-example" class="text-xl font-bold text-text-primary mb-4">Worked example: add 18% GST and reverse it</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Assume {DEFAULT.slab}% is the applicable rate for a taxable base of {fmt(DEFAULT.amount)}. The figures below use an ordinary intra-state supply for the split; this example does not establish the rate for any particular product.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Step 1: multiply {fmt(DEFAULT.amount)} by {DEFAULT.slab} / 100 to get {fmt(initialResult.gstAmount)} of GST. Step 2: add it to the base to get {fmt(initialResult.totalAmount)}. To reverse the calculation, enter that total, choose Remove GST and divide by 1 + {DEFAULT.slab} / 100: the base is {fmt(reverseExample.baseAmount)} and included tax is {fmt(reverseExample.gstAmount)}.</p>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">The same transaction viewed from its exclusive and inclusive amounts</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Scenario</th><th scope="col" class="text-left py-2.5 px-3">Taxable base</th><th scope="col" class="text-left py-2.5 px-3">GST</th><th scope="col" class="text-left py-2.5 px-3">Invoice total</th></tr></thead>
          <tbody><tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Add GST</td><td class="py-2.5 px-3 text-text-primary">{fmt(initialResult.baseAmount)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(initialResult.gstAmount)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(initialResult.totalAmount)}</td></tr>
            <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Remove GST from that total</td><td class="py-2.5 px-3 text-text-primary">{fmt(reverseExample.baseAmount)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(reverseExample.gstAmount)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(reverseExample.totalAmount)}</td></tr></tbody>
        </table></div>
      </section>

      <section aria-labelledby="gst-supply-split">
        <h2 id="gst-supply-split" class="text-xl font-bold text-text-primary mb-4">CGST and SGST versus IGST</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Same taxable base and combined GST rate</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Supply in the example</th><th scope="col" class="text-left py-2.5 px-3">CGST</th><th scope="col" class="text-left py-2.5 px-3">SGST</th><th scope="col" class="text-left py-2.5 px-3">IGST</th></tr></thead>
          <tbody><tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Intra-state</td><td class="py-2.5 px-3 text-text-primary">{fmt(initialResult.cgst ?? 0)}</td><td class="py-2.5 px-3 text-text-primary">{fmt(initialResult.sgst ?? 0)}</td><td class="py-2.5 px-3 text-text-primary">—</td></tr>
            <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Inter-state</td><td class="py-2.5 px-3 text-text-primary">—</td><td class="py-2.5 px-3 text-text-primary">—</td><td class="py-2.5 px-3 text-text-primary">{fmt(interStateExample.igst ?? 0)}</td></tr></tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">For ordinary taxable supplies, compare the supplier’s location with the legal place of supply. The <a href="https://cbic-gst.gov.in/hindi/IGST-bill-e.html" class="text-accent font-medium hover:underline">IGST Act, sections 7 and 8</a> defines inter-state and intra-state supplies and lists exceptions, including SEZ supplies. A buyer’s address alone is not enough for every case. The calculator does not separately label UTGST.</p>
      </section>

      <section aria-labelledby="gst-slabs">
        <h2 id="gst-slabs" class="text-xl font-bold text-text-primary mb-4">Choose the GST rate for the invoice</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The <a href="https://gstcouncil.gov.in/sites/default/files/2025-09/press_release_press_information_bureau_0.pdf" class="text-accent font-medium hover:underline">56th GST Council recommendations, dated 3 September 2025</a> describe a broad 5% merit rate, 18% standard rate and a special 40% rate for selected supplies, alongside exemptions. This is not an exhaustive item-by-item rate list. Check the relevant notification and HSN/SAC classification for the date of supply.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The preset percentages are calculation options, not a classification service. Do not assume every former 28% item moved to 40%, or that an insurance exemption covers every policy. This calculator does not calculate compensation cess or input tax credit.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">For invoice checks, use one rate at a time and compare the calculation with the supplier’s breakdown. <a href="https://cleartax.in/s/gst-calculator" class="text-accent font-medium hover:underline">ClearTax’s GST calculation guide</a> also distinguishes inclusive and exclusive prices.</p>
      </section>

      <section aria-labelledby="gst-faq">
        <h2 id="gst-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.question}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{faq.answer}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="gst-related" class="mb-10">
        <h2 id="gst-related" class="text-xl sm:text-2xl font-bold text-text-primary mb-4">Related taxation calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((tool) => (
            <a
              href={tool.path}
              class="group block bg-surface border border-border rounded-card p-4 hover:border-accent hover:shadow-sm transition-standard focus-visible:outline-accent"
            >
              <span class="text-[11px] font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed line-clamp-2">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- 6. Authoritative Footer Review -->
      <div class="border-t border-border pt-6 pb-2 flex flex-col sm:flex-row items-center justify-between text-xs text-text-muted gap-2">
        <div>
          <span>Content reviewed: <strong>19 October 2026</strong></span>
          <span class="mx-2">·</span>
          <span>Sources and calculation assumptions are linked above</span>
        </div>
        <div>
          <a href="/methodology" class="hover:text-accent underline transition-standard">View formula methodology</a>
        </div>
      </div>

    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcGST } from '../../lib/calculators/taxes';
  import { setResult } from '../../lib/result-bus';
  import { validate } from '../../lib/validate';
  import { formatIndian, formatIndianCompact, parseSmartInput } from '../../lib/formatters';

  function fmtVal(n: number) {
    return '₹' + new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtCompact(n: number) {
    return formatIndianCompact(n, '₹');
  }
  function fmtLiveInput(raw: string | number) {
    const num = parseSmartInput(raw);
    return num === null || isNaN(num) ? '' : new Intl.NumberFormat('en-IN', { maximumFractionDigits: 2 }).format(num);
  }

  function initGSTCalc() {
    const amtInput = document.getElementById('gst-amount') as HTMLInputElement | null;
    const amtSlider = document.getElementById('gst-amount-slider') as HTMLInputElement | null;
    const slabSelect = document.getElementById('gst-slab') as HTMLSelectElement | null;
    const dirSelect = document.getElementById('gst-direction') as HTMLSelectElement | null;
    const supplySelect = document.getElementById('gst-supply-type') as HTMLSelectElement | null;

    const resTaxCompact = document.getElementById('gst-result-tax-compact');
    const resTax = document.getElementById('gst-result-tax');
    const resBaseCompact = document.getElementById('gst-result-base-compact');
    const resBase = document.getElementById('gst-result-base');
    const resTotalCompact = document.getElementById('gst-result-total-compact');
    const resTotal = document.getElementById('gst-result-total');

    const resCgst = document.getElementById('gst-result-cgst');
    const resSgst = document.getElementById('gst-result-sgst');
    const resIgst = document.getElementById('gst-result-igst');
    const rowCgst = document.getElementById('gst-row-cgst');
    const rowSgst = document.getElementById('gst-row-sgst');
    const rowIgst = document.getElementById('gst-row-igst');
    const cgstPct = document.getElementById('gst-cgst-pct');
    const sgstPct = document.getElementById('gst-sgst-pct');
    const igstPct = document.getElementById('gst-igst-pct');

    const errAlert = document.getElementById('gst-error-alert');
    const errMsg = document.getElementById('gst-error-msg');
    const whatsappBtn = document.getElementById('gst-whatsapp-btn') as HTMLAnchorElement | null;
    const copyBtn = document.getElementById('gst-copy-btn');
    const shareBtn = document.getElementById('gst-share-btn');
    const resetBtn = document.getElementById('gst-reset');
    const snippetAnswer = document.getElementById('gst-snippet-answer');

    if (!amtInput) return;

    function applyHash() {
      try {
        const hash = window.location.hash;
        if (hash) {
          const amtMatch = hash.match(/(?:amount|a|p)=([0-9]+)/i);
          if (amtMatch) {
            const val = parseInt(amtMatch[1], 10);
            if (!isNaN(val) && val >= 1) {
              amtInput.value = fmtLiveInput(val);
              if (amtSlider) {
                amtSlider.value = String(val);
                const min = parseFloat(amtSlider.min), max = parseFloat(amtSlider.max);
                amtSlider.style.setProperty('--slider-pct', `${((val - min) / (max - min)) * 100}%`);
              }
            }
          }
          const slabMatch = hash.match(/(?:slab|rate|s|r)=([0-9.]+)/i);
          if (slabMatch && slabSelect) {
            // Only apply recognised slabs: assigning an unknown value empties the
            // <select>, which recalc() would read as 0%. Normalise "18.0" → "18".
            const slabVal = String(parseFloat(slabMatch[1]));
            if (Array.from(slabSelect.options).some((o) => o.value === slabVal)) {
              slabSelect.value = slabVal;
            }
          }
          const modeMatch = hash.match(/(?:mode|direction|type|d)=(add|remove|exclusive|inclusive)/i);
          if (modeMatch && dirSelect) {
            const m = modeMatch[1].toLowerCase();
            dirSelect.value = m === 'exclusive' ? 'add' : m === 'inclusive' ? 'remove' : m;
          }
          const supplyMatch = hash.match(/(?:supply|nature)=(intra|inter)/i);
          if (supplyMatch && supplySelect) {
            supplySelect.value = supplyMatch[1].toLowerCase();
          }
        }
      } catch {}
    }

    if (amtInput.dataset.bound === 'true') {
      applyHash();
      recalc();
      return;
    }
    amtInput.dataset.bound = 'true';
    window.addEventListener('hashchange', () => {
      applyHash();
      recalc();
    });

    const DEFAULTS = { amount: 10000, slab: 18, direction: 'add' as const, supply: 'intra' };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const numAmt = parseSmartInput(amtInput!.value);
      const slab = parseFloat(slabSelect ? slabSelect.value : '18') || 0;
      const direction = (dirSelect ? dirSelect.value : 'add') as 'add' | 'remove';
      const isInter = supplySelect ? supplySelect.value === 'inter' : false;

      const vAmt = validate(numAmt ?? amtInput!.value, { required: true, min: 1, label: 'Amount' });
      if (!vAmt.valid) { showError(vAmt.error!.message); return; }
      clearError();

      const amt = vAmt.value!;
      const res = calcGST(amt, slab, isInter, direction);

      const compTax = fmtCompact(res.gstAmount);
      const compBase = fmtCompact(res.baseAmount);
      const compTotal = fmtCompact(res.totalAmount);

      if (resTaxCompact) resTaxCompact.textContent = compTax;
      if (resTax) resTax.textContent = `(${fmtVal(res.gstAmount)})`;
      if (resBaseCompact) resBaseCompact.textContent = compBase;
      if (resBase) resBase.textContent = `(${fmtVal(res.baseAmount)})`;
      if (resTotalCompact) resTotalCompact.textContent = compTotal;
      if (resTotal) resTotal.textContent = `(${fmtVal(res.totalAmount)})`;

      if (isInter) {
        if (rowCgst) rowCgst.classList.add('hidden');
        if (rowSgst) rowSgst.classList.add('hidden');
        if (rowIgst) {
          rowIgst.classList.remove('hidden');
          rowIgst.classList.add('flex');
          if (resIgst) resIgst.textContent = fmtVal(res.igst);
          if (igstPct) igstPct.textContent = String(slab);
        }
      } else {
        if (rowIgst) {
          rowIgst.classList.add('hidden');
          rowIgst.classList.remove('flex');
        }
        if (rowCgst) {
          rowCgst.classList.remove('hidden');
          if (resCgst) resCgst.textContent = fmtVal(res.cgst);
          if (cgstPct) cgstPct.textContent = String(slab / 2);
        }
        if (rowSgst) {
          rowSgst.classList.remove('hidden');
          if (resSgst) resSgst.textContent = fmtVal(res.sgst);
          if (sgstPct) sgstPct.textContent = String(slab / 2);
        }
      }

      const wrapper = document.getElementById('gst-composition-wrapper');
      if (wrapper && res.totalAmount > 0) {
        const baseFrac = res.baseAmount / res.totalAmount;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(baseFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.baseAmount);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.gstAmount);
      }

      if (snippetAnswer) {
        const modeLabel = direction === 'add' ? 'Exclusive' : 'Inclusive';
        const splitText = isInter
          ? `<strong>IGST ${fmtVal(res.igst)} (${slab}%)</strong>`
          : `<strong>CGST ${fmtVal(res.cgst)} (${slab / 2}%)</strong> and <strong>SGST ${fmtVal(res.sgst)} (${slab / 2}%)</strong>`;
        snippetAnswer.innerHTML = `For an entered amount of <strong>${fmtVal(amt)}</strong> with <strong>${slab}% GST (${modeLabel})</strong>, the calculated net base is <strong>${compBase}</strong> (${fmtVal(res.baseAmount)}) and GST tax is <strong>${compTax}</strong> (${fmtVal(res.gstAmount)}), totaling <strong>${compTotal}</strong> (${fmtVal(res.totalAmount)}). Tax split: ${splitText}.`;
      }

      if (whatsappBtn) {
        const shareMsg = encodeURIComponent(
          `GST Calculation:\nBase: ${compBase}\nGST (${slab}%): ${compTax}\nGross Total: ${compTotal}\nCheck on Calcumetrics: ${location.href}`
        );
        whatsappBtn.href = `https://api.whatsapp.com/send?text=${shareMsg}`;
      }

      const canonicalResult = {
        heroValue: compTax,
        heroLabel: 'GST Tax Amount',
        rows: [
          { label: 'Net Base Amount', value: compBase },
          { label: isInter ? 'IGST Amount' : 'CGST / SGST Split', value: isInter ? fmtVal(res.igst) : `${fmtVal(res.cgst)} each` },
          { label: 'Gross Total Amount', value: compTotal },
        ],
        fields: {
          'gst-result-tax': fmtVal(res.gstAmount),
          'gst-result-base': fmtVal(res.baseAmount),
          'gst-result-total': fmtVal(res.totalAmount),
        },
      };

      setResult(canonicalResult);
      if ((window as any).__cmResultStore) {
        (window as any).__cmResultStore.setResult(canonicalResult);
      }
      window.dispatchEvent(new CustomEvent('cm:result', { detail: canonicalResult }));
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 60);
    }

    if (amtSlider) {
      amtSlider.addEventListener('input', () => {
        amtInput.value = fmtLiveInput(amtSlider.value);
        const pct = ((parseFloat(amtSlider.value) - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
        amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
    }
    amtInput.addEventListener('input', () => {
      const num = parseSmartInput(amtInput.value);
      if (amtSlider && num !== null && !isNaN(num) && num >= parseFloat(amtSlider.min) && num <= parseFloat(amtSlider.max)) {
        amtSlider.value = String(num);
        const pct = ((num - parseFloat(amtSlider.min)) / (parseFloat(amtSlider.max) - parseFloat(amtSlider.min))) * 100;
        amtSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
      }
      debounce();
    });
    amtInput.addEventListener('blur', () => {
      const num = parseSmartInput(amtInput.value);
      if (num !== null && !isNaN(num)) {
        amtInput.value = fmtLiveInput(num);
        recalc();
      }
    });

    slabSelect?.addEventListener('change', recalc);
    dirSelect?.addEventListener('change', recalc);
    supplySelect?.addEventListener('change', recalc);

    // ── Preset Chips ─────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('[data-chip-amount]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-amount');
        if (val) {
          amtInput.value = fmtLiveInput(val);
          if (amtSlider) {
            amtSlider.value = val;
            const min = parseFloat(amtSlider.min), max = parseFloat(amtSlider.max);
            amtSlider.style.setProperty('--slider-pct', `${((parseFloat(val) - min) / (max - min)) * 100}%`);
          }
          debounce();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chip-slab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-chip-slab');
        if (val && slabSelect) {
          slabSelect.value = val;
          recalc();
        }
      });
    });

    // ── Reset ────────────────────────────────────────────────────────────────
    resetBtn?.addEventListener('click', () => {
      amtInput.value = fmtLiveInput(DEFAULTS.amount);
      if (slabSelect) slabSelect.value = String(DEFAULTS.slab);
      if (dirSelect) dirSelect.value = DEFAULTS.direction;
      if (supplySelect) supplySelect.value = DEFAULTS.supply;
      if (amtSlider) {
        amtSlider.value = String(DEFAULTS.amount);
        amtSlider.style.setProperty('--slider-pct', `${((DEFAULTS.amount - 500) / (1000000 - 500)) * 100}%`);
      }
      clearError();
      recalc();
      amtInput.focus();
    });

    // ── Copy & Share ─────────────────────────────────────────────────────────
    copyBtn?.addEventListener('click', async () => {
      const rawAmt = String(parseSmartInput(amtInput.value) ?? '');
      const slab = parseFloat(slabSelect ? slabSelect.value : '18') || 0;
      const dir = (dirSelect ? dirSelect.value : 'add') as 'add' | 'remove';
      const isInter = supplySelect ? supplySelect.value === 'inter' : false;

      const vAmt = validate(rawAmt, { required: true, min: 1, label: 'Amount' });
      if (!vAmt.valid) return;

      const res = calcGST(vAmt.value!, slab, isInter, dir);
      const text = `GST Calculation: Amount ${fmtVal(vAmt.value!)} at ${slab}% (${dir}) = GST ${fmtVal(res.gstAmount)}, Total ${fmtVal(res.totalAmount)}. Calculated on Calcumetrics: ${location.href}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (copyBtn) {
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => (copyBtn.textContent = orig), 2000);
      }
    });

    shareBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = location.href;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (shareBtn) {
        const orig = shareBtn.textContent;
        shareBtn.textContent = 'Copied Link!';
        setTimeout(() => (shareBtn.textContent = orig), 2000);
      }
    });

    applyHash();
    recalc();
  }

  initGSTCalc();
  document.addEventListener('astro:page-load', initGSTCalc);
</script>
