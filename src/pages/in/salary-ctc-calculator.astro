---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcSalaryCTC } from '../../lib/tax/india';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT_CTC = 1200000;
const initialResult = calcSalaryCTC(DEFAULT_CTC);

const fmt = (n: number) => '₹' + formatIndian(n);

const related = TOOLS.filter(
  (t) => t.category === 'Taxes' && t.slug !== 'salary-ctc-calculator' && t.status === 'published'
).slice(0, 3);

const canonicalUrl = 'https://calcumetrics.com/in/salary-ctc-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Salary / CTC Calculator India',
      url: canonicalUrl,
      description: 'Convert annual Cost to Company (CTC) into monthly in-hand take-home salary, EPF, HRA, and gross pay components.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Taxes', item: 'https://calcumetrics.com/taxes' },
        { '@type': 'ListItem', position: 3, name: 'Salary / CTC Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the difference between CTC and take-home salary?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Cost to Company (CTC) is the total annual amount an employer spends on an employee, including employer EPF contributions, gratuity provisions, insurance, and perks. Take-home (net in-hand) salary is what is credited to your bank account each month after deducting employee EPF, professional tax, and income tax (TDS).',
          },
        },
        {
          '@type': 'Question',
          name: 'How is Employee Provident Fund (EPF) calculated on CTC?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Under the EPF Act, mandatory contribution is 12% of Basic Salary. While the statutory wage ceiling is ₹15,000/month (yielding a mandatory contribution of ₹1,800/month each for employer and employee), many private employers contribute 12% on full basic salary unless capped.',
          },
        },
        {
          '@type': 'Question',
          name: 'Why does Basic Salary typically equal 40% to 50% of CTC?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Companies benchmark Basic Salary at 40% (non-metro) or 50% (metro) to optimize employee tax savings through HRA exemptions while maintaining reasonable statutory retirement liability for EPF and gratuity.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is Special Allowance in a salary slip?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Special Allowance is a residual balancing component used by HR to match the agreed gross CTC after allocating specific components like Basic Pay, HRA, and statutory retirals. It is fully taxable under Indian income tax laws.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is Gratuity included in monthly in-hand salary?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. While gratuity is often included in annual CTC figures by companies as a statutory retention benefit (4.81% of basic), it is only payable to an employee upon separation after completing 5 continuous years of service.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="Salary CTC to In-Hand Calculator India | Calcumetrics"
  description="Break down annual Cost to Company (CTC) into monthly take-home salary, Basic, HRA, Special Allowance, and EPF contributions. Free & instant."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Salary / CTC Calculator"
    category="Taxes"
    categoryHref="/taxes"
    heroValue={fmt(initialResult.netMonthlySalary)}
    heroLabel="Estimated Monthly In-Hand Salary"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">Salary / CTC Calculator: FY 2026-27</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Last verified: 24 Sept 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-4">
        Statutory baseline: <a href="https://www.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent-hover font-medium">Income Tax Department (CBDT)</a> · New Tax Regime with ₹75,000 standard deduction.
      </p>

      <!-- Surcharge Disclaimer (§18) -->
      <div class="mb-5 p-3 rounded-card bg-amber-500/10 border border-amber-500/20 text-xs text-text-muted leading-relaxed">
        <strong class="text-amber-700 dark:text-amber-400 font-semibold block mb-0.5">⚠️ Surcharge Disclaimer:</strong>
        Computations calculate base New Regime tax, ₹75k standard deduction, and 4% Cess. <strong>Surcharge on taxable income exceeding ₹50 Lakh (10% to 25%) is not modeled.</strong>
      </div>

      <!-- Error alert -->
      <div id="ctc-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="ctc-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Annual CTC -->
      <div class="mb-6">
        <Input
          id="ctc-amount"
          label="Annual Cost to Company (CTC)"
          prefix="₹"
          value="12,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total annual package offered by your employer"
          inputmode="decimal"
          aria-describedby="ctc-error-msg"
        />
        <div class="mt-2">
          <Slider id="ctc-amount-slider" min={300000} max={10000000} step={25000} value={1200000} ariaLabel="Annual CTC slider" />
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="ctc-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="ctc-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Estimated In-Hand Salary (Monthly)</span>
        <div id="ctc-result-takehome" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.netMonthlySalary)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Gross Monthly Salary</span>
          <span id="ctc-result-gross-monthly" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.grossMonthlySalary)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Annual Basic Salary (40%)</span>
          <span id="ctc-result-basic" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.basic)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">House Rent Allowance (HRA)</span>
          <span id="ctc-result-hra" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.hra)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Special Allowance (Annual)</span>
          <span id="ctc-result-special" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.specialAllowance)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Employer EPF (Annual)</span>
          <span id="ctc-result-employer-epf" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.employerEPF)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Employee EPF Deduction (Monthly)</span>
          <span id="ctc-result-employee-epf" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.employeeEPF / 12)}</span>
        </div>
      </div>

      <div class="mb-5" id="ctc-composition-wrapper">
        <CompositionBar
          principalFraction={(initialResult.netMonthlySalary * 12) / initialResult.ctc}
          gainFraction={1 - ((initialResult.netMonthlySalary * 12) / initialResult.ctc)}
          principalLabel="Annual Take-Home"
          gainLabel="Deductions & Retirals"
          principalValue={fmt(initialResult.netMonthlySalary * 12)}
          gainValue={fmt(initialResult.ctc - (initialResult.netMonthlySalary * 12))}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="ctc-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Breakdown
        </button>
        <button type="button" id="ctc-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Assumes standard 40% Basic, 40% HRA, and statutory ₹15,000 EPF ceiling. Net take-home excludes voluntary deductions and income tax TDS.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="ctc-calculator-how">
        <h2 id="ctc-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Cost to Company (CTC) Translates into In-Hand Salary</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Cost to Company (CTC) is the total cumulative expenditure an employer budgets to employ an individual annually in India. It encompasses not only the take-home cash deposited into the employee's bank account, but also statutory retirement benefits, allowances, and statutory payroll deductions:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed font-mono">
            <strong>1. Basic Salary Structure:</strong> Basic Pay = 40.00% &times; Annual CTC (Industry benchmark for non-metros; 50% in metros)<br /><br />
            <strong>2. House Rent Allowance (HRA):</strong> HRA = 40.00% &times; Basic Salary (Eligible for partial tax exemption under Section 10(13A))<br /><br />
            <strong>3. Statutory Retiral Allocation (EPF):</strong><br />
            &bull; Statutory Wage Ceiling: ₹15,000 / month (₹1,80,000 / year)<br />
            &bull; Employer EPF Contribution = 12% &times; min(Basic, ₹1,80,000) = ₹21,600 / year (deducted from CTC to derive Gross Salary)<br />
            &bull; Employee EPF Deduction = 12% &times; min(Basic, ₹1,80,000) = ₹21,600 / year (deducted from Gross Salary)<br /><br />
            <strong>4. Balancing Special Allowance:</strong> Special Allowance = Annual Gross Salary &minus; (Basic Salary + HRA)<br /><br />
            <strong>5. Gross Monthly Salary:</strong> Gross Monthly = (Annual CTC &minus; Employer EPF) &divide; 12<br /><br />
            <strong>6. Net Monthly Take-Home Pay:</strong> In-Hand Cash = Gross Monthly &minus; (Employee EPF &divide; 12) &minus; Professional Tax &minus; TDS
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-Step Worked Example (Default Scenario)</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-3">
          Consider an executive or software engineer offered an annual CTC package of <strong>₹12,00,000</strong> (₹1,00,000 monthly CTC budget) under standard Indian corporate payroll rules:
        </p>

        <div class="overflow-x-auto border border-border rounded-card mb-6">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-surface border-b border-border text-text-primary font-semibold">
                <th class="py-2.5 px-4">Compensation Component</th>
                <th class="py-2.5 px-4">Formula / Statutory Baseline</th>
                <th class="py-2.5 px-4">Annual Value (₹)</th>
                <th class="py-2.5 px-4">Monthly Value (₹)</th>
                <th class="py-2.5 px-4">Payroll Role / Nature</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Total Cost to Company (CTC)</td>
                <td class="py-2.5 px-4 font-mono">Agreed Employer Package</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹12,00,000</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-text-primary">₹1,00,000</td>
                <td class="py-2.5 px-4">Gross corporate employment budget.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Employer EPF Contribution</td>
                <td class="py-2.5 px-4 font-mono">12% on ₹15,000 Wage Ceiling</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">&minus;₹21,600</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">&minus;₹1,800</td>
                <td class="py-2.5 px-4">Employer retiral share deposited with EPFO (not part of Gross Pay).</td>
              </tr>
              <tr class="bg-surface/50 font-semibold text-text-primary">
                <td class="py-2.5 px-4">Annual Gross Salary</td>
                <td class="py-2.5 px-4 font-mono">CTC &minus; Employer EPF</td>
                <td class="py-2.5 px-4 font-mono font-bold text-text-primary">₹11,78,400</td>
                <td class="py-2.5 px-4 font-mono font-bold text-text-primary">₹98,200</td>
                <td class="py-2.5 px-4">Total gross salary appearing on the monthly payslip earnings column.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">&bull; Basic Salary (40%)</td>
                <td class="py-2.5 px-4 font-mono">40% of Annual CTC</td>
                <td class="py-2.5 px-4 font-mono">₹4,80,000</td>
                <td class="py-2.5 px-4 font-mono">₹40,000</td>
                <td class="py-2.5 px-4">Core fixed pay; forms statutory baseline for PF, Gratuity, and HRA.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">&bull; House Rent Allowance (HRA)</td>
                <td class="py-2.5 px-4 font-mono">40% of Basic Salary</td>
                <td class="py-2.5 px-4 font-mono">₹1,92,000</td>
                <td class="py-2.5 px-4 font-mono">₹16,000</td>
                <td class="py-2.5 px-4">Non-metro HRA rate; eligible for rent exemption under Section 10(13A).</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">&bull; Special Allowance</td>
                <td class="py-2.5 px-4 font-mono">Gross Pay &minus; (Basic + HRA)</td>
                <td class="py-2.5 px-4 font-mono">₹5,06,400</td>
                <td class="py-2.5 px-4 font-mono">₹42,200</td>
                <td class="py-2.5 px-4">Residual balancing allowance; 100% taxable under income tax slabs.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Employee EPF Deduction</td>
                <td class="py-2.5 px-4 font-mono">12% on ₹15,000 Wage Ceiling</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">&minus;₹21,600</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">&minus;₹1,800</td>
                <td class="py-2.5 px-4">Statutory employee deduction to EPF account (Section 80C eligible).</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">Net Monthly In-Hand (Take-Home)</td>
                <td class="py-3 px-4 font-mono">Gross Monthly &minus; Employee EPF</td>
                <td class="py-3 px-4 font-mono font-bold text-text-primary">₹11,56,800 (96.4%)</td>
                <td class="py-3 px-4 font-mono font-bold text-text-primary text-base">₹96,400 / mo</td>
                <td class="py-3 px-4">Actual net bank transfer received (before state PT and annual ITR TDS).</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Salary Structuring &amp; Tax Implications</h3>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Basic Pay Optimization:</strong> A higher basic salary (&ge;50%) raises mandatory EPF contributions and increases the statutory HRA exemption ceiling, but decreases immediate net monthly cash in hand.</li>
              <li><strong>Gratuity Inclusion:</strong> Under the Payment of Gratuity Act, 1972, many employers budget gratuity at <strong>4.81% of Basic</strong> inside annual CTC. Gratuity is only disbursed upon resignation or retirement after 5 years of continuous service.</li>
              <li><strong>Professional Tax (PT):</strong> State-level tax levied in Maharashtra, Karnataka, Telangana, West Bengal, and other states, capped statutorily at <strong>₹2,500 per year</strong> (typically ₹200/month, with ₹300 in February).</li>
              <li><strong>Income Tax TDS (Section 192):</strong> Monthly in-hand pay is subject to tax withholding by the employer based on the employee's regime choice (New vs Old) and Form 12BB investment declarations.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">EPF Capping: Statutory vs Actual Basic</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-3">
              Understanding how your employer administers the Employees' Provident Fund (EPF) is critical:
            </p>
            <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
              <li><strong>Statutory Capped EPF (Default Model):</strong> Contributions are capped at 12% of the statutory wage limit of <strong>₹15,000/month</strong>, totaling <strong>₹1,800/month</strong> each for employer and employee. This maximizes immediate monthly take-home cash.</li>
              <li><strong>Uncapped EPF (MNC / Corporate Practice):</strong> Many multinational corporations calculate 12% EPF on the <em>actual</em> basic pay (e.g., 12% on ₹40,000 = ₹4,800/month). While this builds a significantly larger retirement nest egg, it reduces monthly take-home pay by ₹3,000.</li>
            </ul>
          </div>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Evaluating a job offer or annual appraisal?</strong>
        Read our complete breakdown on <a href="/blog/ctc-vs-in-hand-salary" class="text-accent font-medium hover:underline">CTC vs. In-Hand Salary: Why Your Take-Home Pay Is 20% to 35% Lower Than Your Offer Letter</a> to understand employer EPF, gratuity withholding, professional tax, and payroll tax deductions.
      </div>

      <section aria-labelledby="ctc-calculator-faq">
        <h2 id="ctc-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="ctc-calculator-related">
        <h2 id="ctc-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related tax calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/in/income-tax-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">Income Tax Calculator (India)</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Compare Old vs New Tax Regime tax liability per Finance Act 2024-25.</p>
          </a>
          <a href="/in/hra-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">HRA Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Calculate House Rent Allowance tax exemption under Section 10(13A) of the Income-tax Act.</p>
          </a>
          <a href="/in/tds-calculator" class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">Taxes</span>
            <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">TDS Calculator</h3>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Determine Tax Deducted at Source withholding amounts across commercial and professional sections.</p>
          </a>
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcSalaryCTC } from '../../lib/tax/india';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initSalaryCTCCalc() {
    if ((window as any).__cmCtcBound) return;
    (window as any).__cmCtcBound = true;

    const ctcInput = document.getElementById('ctc-amount') as HTMLInputElement | null;
    const ctcSlider = document.getElementById('ctc-amount-slider') as HTMLInputElement | null;

    const resTakeHome = document.getElementById('ctc-result-takehome');
    const resGrossMonthly = document.getElementById('ctc-result-gross-monthly');
    const resBasic = document.getElementById('ctc-result-basic');
    const resHra = document.getElementById('ctc-result-hra');
    const resSpecial = document.getElementById('ctc-result-special');
    const resEmployerEPF = document.getElementById('ctc-result-employer-epf');
    const resEmployeeEPF = document.getElementById('ctc-result-employee-epf');

    const errAlert = document.getElementById('ctc-error-alert');
    const errMsg = document.getElementById('ctc-error-msg');

    if (!ctcInput) return;

    const DEFAULTS = { ctc: 1200000 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawCTC = ctcInput!.value.replace(/[^0-9.]/g, '');
      const vCTC = validate(rawCTC, { required: true, min: 100000, label: 'Annual CTC' });

      if (!vCTC.valid) { showError(vCTC.error!.message); return; }
      clearError();

      const ctc = vCTC.value!;
      const res = calcSalaryCTC(ctc);

      setResult({
        heroValue: fmtVal(res.netMonthlySalary),
        heroLabel: 'Estimated Monthly In-Hand',
        rows: [
          { label: 'Gross Monthly Salary', value: fmtVal(res.grossMonthlySalary) },
          { label: 'Basic Salary (Annual)', value: fmtVal(res.basic) },
          { label: 'HRA (Annual)', value: fmtVal(res.hra) },
          { label: 'Special Allowance', value: fmtVal(res.specialAllowance) },
          { label: 'Employer EPF (Annual)', value: fmtVal(res.employerEPF) },
          { label: 'Employee EPF (Monthly)', value: fmtVal(res.employeeEPF / 12) },
        ],
      });

      if (resTakeHome) resTakeHome.textContent = fmtVal(res.netMonthlySalary);
      if (resGrossMonthly) resGrossMonthly.textContent = fmtVal(res.grossMonthlySalary);
      if (resBasic) resBasic.textContent = fmtVal(res.basic);
      if (resHra) resHra.textContent = fmtVal(res.hra);
      if (resSpecial) resSpecial.textContent = fmtVal(res.specialAllowance);
      if (resEmployerEPF) resEmployerEPF.textContent = fmtVal(res.employerEPF);
      if (resEmployeeEPF) resEmployeeEPF.textContent = fmtVal(res.employeeEPF / 12);

      const wrapper = document.getElementById('ctc-composition-wrapper');
      if (wrapper && res.ctc > 0) {
        const takehomeAnnual = res.netMonthlySalary * 12;
        const takehomePct = Math.min(100, (takehomeAnnual / res.ctc) * 100);
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${takehomePct.toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(takehomeAnnual);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.ctc - takehomeAnnual);
      }

      serializeHash({ ctc });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 120);
    }

    if (ctcSlider) {
      ctcSlider.addEventListener('input', () => {
        ctcInput.value = fmtLiveInput(ctcSlider.value);
        const pct = ((parseFloat(ctcSlider.value) - parseFloat(ctcSlider.min)) / (parseFloat(ctcSlider.max) - parseFloat(ctcSlider.min))) * 100;
        ctcSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      ctcInput.addEventListener('input', () => {
        const raw = ctcInput.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(ctcSlider.min) && num <= parseFloat(ctcSlider.max)) {
          ctcSlider.value = String(num);
          const pct = ((num - parseFloat(ctcSlider.min)) / (parseFloat(ctcSlider.max) - parseFloat(ctcSlider.min))) * 100;
          ctcSlider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        ctcInput.value = fmtLiveInput(raw);
        debounce();
      });
    }

    document.getElementById('ctc-calculate')?.addEventListener('click', recalc);
    document.getElementById('ctc-reset')?.addEventListener('click', () => {
      ctcInput.value = fmtLiveInput(String(DEFAULTS.ctc));
      if (ctcSlider) {
        ctcSlider.value = String(DEFAULTS.ctc);
        ctcSlider.style.setProperty('--slider-pct', `${((DEFAULTS.ctc - 300000) / (10000000 - 300000)) * 100}%`);
      }
      clearError();
      recalc();
      ctcInput.focus();
    });

    ctcInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') recalc();
    });

    document.getElementById('ctc-copy-btn')?.addEventListener('click', async () => {
      const rawCTC = ctcInput.value.replace(/[^0-9.]/g, '');
      const vCTC = validate(rawCTC, { required: true, min: 100000, label: 'CTC' });
      if (!vCTC.valid) return;
      const res = calcSalaryCTC(vCTC.value!);
      const text = `Salary Breakdown for ${fmtVal(res.ctc)} CTC: Net In-Hand: ${fmtVal(res.netMonthlySalary)}/mo (Gross: ${fmtVal(res.grossMonthlySalary)}/mo, Basic: ${fmtVal(res.basic)}). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('ctc-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('ctc-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('ctc-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      ctc: { required: true, min: 100000, label: 'ctc' },
    });
    if (restored.valid && restored.values.ctc) {
      ctcInput.value = fmtLiveInput(String(restored.values.ctc));
      recalc();
    } else {
      recalc();
    }
  }

  initSalaryCTCCalc();
  document.addEventListener('astro:page-load', initSalaryCTCCalc);
</script>
