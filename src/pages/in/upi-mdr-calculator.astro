---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcUPIMDR } from '../../lib/calculators/upi-mdr';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';
import { getFreshness } from '../../data/page-freshness';

const freshness = getFreshness('/in/upi-mdr-calculator')!;

const DEFAULT = {
  monthlyVolume: 500000,
  ticketSize: 2500,
  chargeableShare: 20,
  mdrRate: 1.1,
  gstRate: 18,
};

const initialResult = calcUPIMDR(
  DEFAULT.monthlyVolume,
  DEFAULT.ticketSize,
  DEFAULT.chargeableShare,
  DEFAULT.mdrRate,
  DEFAULT.gstRate
);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const RELATED_SLUGS = ['gst-calculator', 'profit-margin-calculator', 'break-even-calculator'];
const related = RELATED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean);
const canonicalUrl = 'https://calcumetrics.com/in/upi-mdr-calculator';
const faqs = [
  { question: "What is MDR in UPI?", answer: "MDR is a merchant payment-acceptance fee. Interchange is a payment between participants in the payment system; it is not automatically the same as the fee shown on a merchant invoice. Use the fee your bank or payment provider actually quotes." },
  { question: "Is normal bank-account UPI free?", answer: "NPCI’s bank-account UPI guidance distinguishes normal transfers from PPI wallet merchant transactions. The announced 2026 MDR rollout for select P2M payments was deferred until after Diwali. A payment gateway may still charge a separate platform fee; check its pricing and your agreement." },
  { question: "Do customers pay UPI MDR?", answer: "NPCI’s PPI guidance says the interchange charge is not charged to customers. MDR is a merchant-side fee. Do not interpret the calculator’s deductions as an extra amount the customer must pay." },
  { question: "How is GST calculated on a payment-processing fee?", answer: "Apply the GST percentage to the processing fee. The example uses 18%, consistent with Razorpay’s published explanation of GST on platform fees. Confirm the tax treatment on your own provider’s invoice." },
  { question: "When will the new UPI MDR charges start?", answer: "The 13 October 2026 announcement deferred the rollout until after Diwali. The reports checked for this review say the new implementation date will be notified separately. The proposed rate is not applied automatically by this calculator." },
  { question: "Does the ₹2,000 threshold apply to my whole month?", answer: "This model uses the average ticket size as a shortcut: at ₹2,000 or below it sets the chargeable volume to zero. A mixed month can still contain larger individual transactions. Reconcile transaction by transaction and check PPI, RuPay credit and merchant-category terms separately." }
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'UPI MDR Calculator',
      url: canonicalUrl,
      description: 'Estimate merchant fees, GST on fees and net settlement using an assumed chargeable payment share and rate.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: freshness.lastReviewed,
      publisher: {
        '@type': 'Organization',
        '@id': 'https://calcumetrics.com/#org',
        name: 'Calcumetrics',
        url: 'https://calcumetrics.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://calcumetrics.com/logo.svg',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'UPI MDR Calculator', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<Layout
  title="UPI MDR Calculator: Estimate Fees & Settlement"
  description="Estimate UPI merchant fees, GST on fees and net settlement from your payment mix. See a worked example and the limits of the monthly estimate."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="UPI MDR Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(initialResult.netSettlement)}
    heroLabel="Estimated Net Settlement"
  >
    <Fragment slot="inputs">
      <div class="flex items-center justify-between gap-2 flex-wrap mb-1">
        <h1 class="text-2xl font-bold tracking-tight text-text-primary">UPI MDR Calculator</h1>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-accent/10 text-accent border border-accent/20">
          Reviewed: 19 Oct 2026
        </span>
      </div>
      <p class="text-xs text-text-muted mb-3">
        Fee estimate for India. Check your acquiring bank or payment provider’s merchant agreement.
      </p>

      <!-- Proposed P2M MDR change: deferred, no new date notified -->
      <div class="mb-5 p-3.5 rounded-card bg-amber-500/10 border border-amber-500/30 text-xs text-text-primary">
        <strong class="font-bold flex items-center gap-1.5 text-amber-600 dark:text-amber-400 mb-1">
          Proposed NPCI change deferred (no new date yet)
        </strong>
        <p class="text-text-muted leading-relaxed">
          As of 19 October 2026, the announced MDR rollout on select P2M UPI payments has been deferred until after Diwali, with the implementation date to be notified separately. See <a href="https://newsonair.gov.in/upi-mdr-to-be-implemented-after-diwali/" class="text-accent font-medium hover:underline">Akashvani’s 13 October report</a> and <a href="https://timesofindia.indiatimes.com/business/india-business/proposed-fees-on-upi-merchant-transactions-above-rs-2k-postpone-to-after-festivals/articleshow/134912161.cms" class="text-accent font-medium hover:underline">the implementation-date report</a>. The calculator below estimates a percentage fee on an entered payment mix; it does not implement the deferred framework’s category rules or caps.
        </p>
      </div>

      <!-- Error alert -->
      <div id="mdr-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="mdr-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Monthly Volume -->
      <div class="mb-5">
        <Input
          id="mdr-volume"
          label="Total Monthly UPI Volume"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross value of UPI merchant transactions processed monthly"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-volume-slider" min={25000} max={5000000} step={25000} value={500000} ariaLabel="Monthly volume slider" />
        </div>
      </div>

      <!-- Average Ticket Size -->
      <div class="mb-5">
        <Input
          id="mdr-ticket"
          label="Average Ticket Size"
          prefix="₹"
          value="2,500"
          isNumeric={true}
          localeFormat="indian"
          helperText="Model assumption: an average ticket of ₹2,000 or less sets the estimated fee to zero; see limitations below"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
      </div>

      <!-- Chargeable Share % -->
      <div class="mb-5">
        <Input
          id="mdr-share"
          label="Chargeable Share (PPI / RuPay Credit %)"
          suffix="%"
          value="20"
          isNumeric={true}
          helperText="Enter the percentage of volume that your provider actually charges"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-share-slider" min={0} max={100} step={1} value={20} ariaLabel="Chargeable share slider" />
        </div>
      </div>

      <!-- MDR Rate % -->
      <div class="mb-5">
        <Input
          id="mdr-rate"
          label="MDR / Interchange Fee Rate"
          suffix="%"
          value="1.1"
          isNumeric={true}
          helperText="Use your provider’s applicable merchant fee; 1.1% is an illustrative input"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-rate-slider" min={0.5} max={2.5} step={0.05} value={1.1} ariaLabel="MDR rate slider" />
        </div>
      </div>

      <!-- GST Rate -->
      <div class="mb-6">
        <Input
          id="mdr-gst"
          label="GST on MDR Fee"
          suffix="%"
          value="18"
          isNumeric={true}
          helperText="GST rate on the provider’s fee invoice; 18% is the example input"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="mdr-calculate" type="button">Calculate Merchant Fees</Button>
        <Button variant="ghost" id="mdr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Net Monthly Settlement</span>
        <div id="mdr-result-settlement" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.netSettlement)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Fee Deductions</span>
          <span id="mdr-result-deductions" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.totalDeductions)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Base MDR Fee</span>
          <span id="mdr-result-basefee" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.baseMdrFee)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">GST (18% on MDR)</span>
          <span id="mdr-result-gstamt" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.gstAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Effective Processing Cost</span>
          <span id="mdr-result-effective" class="text-sm font-bold tabular-nums text-dark-text">{initialResult.effectiveRatePct.toFixed(3)}%</span>
        </div>
      </div>

      <div class="mb-5" id="mdr-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.monthlyVolume > 0 ? initialResult.netSettlement / initialResult.monthlyVolume : 1}
          gainFraction={initialResult.monthlyVolume > 0 ? initialResult.totalDeductions / initialResult.monthlyVolume : 0}
          principalLabel="Settlement"
          gainLabel="MDR + GST"
          principalValue={fmt(initialResult.netSettlement)}
          gainValue={fmt(initialResult.totalDeductions)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="mdr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="mdr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">India estimate in INR. Actual settlement depends on transaction-level charges and your provider’s agreement.</p>
    </Fragment>

    <Fragment slot="below">
      <p class="text-sm text-text-muted leading-relaxed mb-4">A UPI MDR calculator estimates merchant fees by applying your provider’s rate to the chargeable part of your UPI collections. It then adds GST on that fee and subtracts both amounts to estimate net settlement. Use the applicable rate and payment mix from your merchant statement; the result is a planning estimate.</p><section aria-labelledby="mdr-calculator-how">
        <h2 id="mdr-calculator-how" class="text-xl font-bold text-text-primary mb-4">UPI MDR formula: fee, GST and net settlement</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Let V be monthly collections, s the chargeable percentage, m the fee percentage and g the GST percentage. This calculator uses the following model when the average ticket exceeds ₹2,000:</p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 space-y-3 text-sm font-mono text-text-primary">
          <p>Chargeable volume = V × s / 100</p>
        <p>Merchant fee = Chargeable volume × m / 100</p>
        <p>GST on fee = Merchant fee × g / 100</p>
        <p>Net settlement = V − Merchant fee − GST on fee</p>
        </div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">At an average ticket of ₹2,000 or less, the existing model sets chargeable volume to zero. This shortcut cannot identify individual payments above the threshold or distinguish all RuPay credit, PPI and merchant-category rules. It excludes fixed platform subscriptions, refunds and other adjustments.</p>
      </section>

      <section aria-labelledby="mdr-worked-example">
        <h2 id="mdr-worked-example" class="text-xl font-bold text-text-primary mb-4">Worked example: monthly merchant collections</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Suppose monthly collections are {fmt(DEFAULT.monthlyVolume)}, the average ticket is {fmt(DEFAULT.ticketSize)}, and {DEFAULT.chargeableShare}% of collections attracts an assumed {DEFAULT.mdrRate}% fee. Using {DEFAULT.gstRate}% GST on that fee gives the following estimate. These are illustrative inputs, not a tariff promised by NPCI or a provider.</p>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Illustration using the calculator’s default inputs; amounts rounded to whole rupees</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Item</th><th scope="col" class="text-left py-2.5 px-3">Amount</th></tr></thead>
          <tbody>{[
          ['Monthly UPI collections', initialResult.monthlyVolume],
          ['Chargeable volume', initialResult.chargeableVolume],
          ['Volume outside the assumed fee', initialResult.exemptVolume],
          ['Merchant fee', initialResult.baseMdrFee],
          ['GST on the fee', initialResult.gstAmount],
          ['Total deductions', initialResult.totalDeductions],
          ['Estimated settlement', initialResult.netSettlement],
        ].map(([label, value]) => (<tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">{label}</td><td class="py-2.5 px-3 text-text-primary">{fmt(Number(value))}</td></tr>))}</tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">The effective deduction is {initialResult.effectiveRatePct.toFixed(3)}% of monthly collections. GST is applied to the fee amount, not to the entire sale: <a href="https://razorpay.com/blog/razorpay-payment-gateway-pricing-explained" class="text-accent font-medium hover:underline">Razorpay explains this treatment for its platform fees</a>.</p>
      </section>

      <section aria-labelledby="mdr-regulatory-rules">
        <h2 id="mdr-regulatory-rules" class="text-xl font-bold text-text-primary mb-4">Bank UPI, wallet interchange and gateway fees</h2>
        <div class="overflow-x-auto bg-surface border border-border rounded-card"><table class="w-full text-xs sm:text-sm border-collapse"><caption class="text-left p-3 text-text-muted">Different charges can appear on the same merchant statement</caption><thead><tr class="border-b border-border text-text-muted"><th scope="col" class="text-left py-2.5 px-3">Payment or charge</th><th scope="col" class="text-left py-2.5 px-3">What to check</th></tr></thead>
          <tbody><tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Bank-account UPI</td><td class="py-2.5 px-3 text-text-primary">NPCI’s guidance says normal bank-to-bank UPI is free; the 2026 P2M rollout is deferred.</td></tr>
            <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">PPI wallet / RuPay credit on UPI</td><td class="py-2.5 px-3 text-text-primary">Check instrument, merchant category and provider terms separately. A single percentage is only an estimate.</td></tr>
            <tr class="border-b border-border/50"><td class="py-2.5 px-3 text-text-primary">Gateway, QR or POS service</td><td class="py-2.5 px-3 text-text-primary">Platform, device and subscription costs depend on the contract and are not all included here.</td></tr></tbody>
        </table></div>
        <p class="text-sm text-text-muted leading-relaxed mb-4">Sources: <a href="https://www.npci.org.in/PDF/npci/press-releases/2023/UPI-is-free-fast-secure-and-seamless-Every-month-over-8-billion-transactions-are-processed-free-for-customers-and-merchants-using-bank-accounts.pdf" class="text-accent font-medium hover:underline">NPCI’s bank-account and PPI clarification (29 March 2023)</a>; <a href="https://newsonair.gov.in/upi-mdr-to-be-implemented-after-diwali/" class="text-accent font-medium hover:underline">Akashvani’s deferred-rollout report (13 October 2026)</a>; <a href="https://razorpay.com/pricing/" class="text-accent font-medium hover:underline">Razorpay’s separate platform-fee explanation</a>.</p>
        <p class="text-sm text-text-muted leading-relaxed mb-4">To compare a POS terminal with a QR service, add any device rental or subscription from each quote to its transaction fees. There is no single verified POS percentage that represents every merchant.</p>
      </section>

      <section aria-labelledby="mdr-calculator-faq">
        <h2 id="mdr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.question}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">{faq.answer}</div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="mdr-calculator-related">
        <h2 id="mdr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { parseSmartInput } from '../../lib/formatters';
  import { calcUPIMDR } from '../../lib/calculators/upi-mdr';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  let currentHashState: Record<string, any> = {};

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseSmartInput(raw, currLocale === 'de-DE' ? 'EUR' : undefined);
    return num === null || isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(num));
  }

  function initMDRCalc() {
    const volInput = document.getElementById('mdr-volume') as HTMLInputElement | null;
    const shareInput = document.getElementById('mdr-share') as HTMLInputElement | null;
    const ticketInput = document.getElementById('mdr-ticket') as HTMLInputElement | null;
    const rateInput = document.getElementById('mdr-rate') as HTMLInputElement | null;
    const gstInput = document.getElementById('mdr-gst') as HTMLInputElement | null;

    const volSlider = document.getElementById('mdr-volume-slider') as HTMLInputElement | null;
    const shareSlider = document.getElementById('mdr-share-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('mdr-rate-slider') as HTMLInputElement | null;

    const resSettlement = document.getElementById('mdr-result-settlement');
    const resDeductions = document.getElementById('mdr-result-deductions');
    const resBaseFee = document.getElementById('mdr-result-basefee');
    const resGstAmt = document.getElementById('mdr-result-gstamt');
    const resEffRate = document.getElementById('mdr-result-effective');

    const errAlert = document.getElementById('mdr-error-alert');
    const errMsg = document.getElementById('mdr-error-msg');

    if (!volInput || !shareInput) return;

    if (volInput.dataset.bound === 'true') {
      recalc();
      return;
    }
    volInput.dataset.bound = 'true';

    const DEFAULTS = { vol: 500000, ticket: 2500, share: 20, rate: 1.1, gst: 18 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const numVol = parseSmartInput(volInput!.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numShare = parseSmartInput(shareInput!.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numTicket = ticketInput ? parseSmartInput(ticketInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) : DEFAULTS.ticket;
      const rawRate = rateInput ? String(parseSmartInput(rateInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) ?? '') : '1.1';
      const rawGst = gstInput ? String(parseSmartInput(gstInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) ?? '') : '18';

      const vVol = validate(numVol ?? '', { required: true, min: 1000, label: 'Monthly Volume' });
      const vShare = validate(numShare ?? '', { required: true, min: 0, max: 100, decimal: true, label: 'Chargeable Share' });
      const vTicket = validate(numTicket ?? '', { required: true, min: 1, decimal: true, label: 'Average Ticket Size' });
      const vRate = validate(rawRate ?? '', { required: true, min: 0.1, max: 5, decimal: true, label: 'MDR Rate' });
      const vGst = validate(rawGst ?? '', { required: true, min: 0, max: 28, decimal: true, label: 'GST Rate' });

      if (!vVol.valid) { showError(vVol.error!.message); return; }
      if (!vTicket.valid) { showError(vTicket.error!.message); return; }
      if (!vShare.valid) { showError(vShare.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      if (!vGst.valid) { showError(vGst.error!.message); return; }
      clearError();

      const vol = vVol.value!;
      const ticket = vTicket.value!;
      const share = vShare.value!;
      const rate = vRate.value!;
      const gst = vGst.value!;

      const res = calcUPIMDR(vol, ticket, share, rate, gst);

      setResult({
        heroValue: fmtVal(res.netSettlement),
        heroLabel: 'Estimated Net Settlement',
        rows: [
          { label: 'Total Fee Deductions', value: fmtVal(res.totalDeductions) },
          { label: 'Base MDR Fee', value: fmtVal(res.baseMdrFee) },
          { label: 'GST on MDR', value: fmtVal(res.gstAmount) },
          { label: 'Effective MDR Rate', value: `${res.effectiveRatePct.toFixed(3)}%` },
        ],
      });

      if (resSettlement) resSettlement.textContent = fmtVal(res.netSettlement);
      if (resDeductions) resDeductions.textContent = fmtVal(res.totalDeductions);
      if (resBaseFee) resBaseFee.textContent = fmtVal(res.baseMdrFee);
      if (resGstAmt) resGstAmt.textContent = fmtVal(res.gstAmount);
      if (resEffRate) resEffRate.textContent = `${res.effectiveRatePct.toFixed(3)}%`;

      const wrapper = document.getElementById('mdr-composition-wrapper');
      if (wrapper && vol > 0) {
        const setFrac = res.netSettlement / vol;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(setFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.netSettlement);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalDeductions);
      }

      currentHashState = { v: vol, t: ticket, s: share, r: rate, g: gst };
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        debounce();
      });
      input.addEventListener('blur', () => {
        const isEur = currLocale === 'de-DE';
        const num = parseSmartInput(input.value, isEur ? 'EUR' : undefined);
        if (num !== null && !isNaN(num)) {
          input.value = isFormatted ? fmtLiveInput(String(num)) : String(num);
          recalc();
        }
      });
    }

    sync(volSlider, volInput, true);
    sync(shareSlider, shareInput, false);
    sync(rateSlider, rateInput!, false);

    ticketInput?.addEventListener('input', debounce);
    ticketInput?.addEventListener('blur', () => {
      const num = parseSmartInput(ticketInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      if (num !== null && !isNaN(num)) ticketInput.value = fmtLiveInput(String(num));
    });

    document.getElementById('mdr-calculate')?.addEventListener('click', recalc);
    document.getElementById('mdr-reset')?.addEventListener('click', () => {
      volInput.value = fmtLiveInput(String(DEFAULTS.vol));
      if (ticketInput) ticketInput.value = fmtLiveInput(String(DEFAULTS.ticket));
      shareInput.value = String(DEFAULTS.share);
      if (rateInput) rateInput.value = String(DEFAULTS.rate);
      if (gstInput) gstInput.value = String(DEFAULTS.gst);

      if (volSlider) {
        volSlider.value = String(DEFAULTS.vol);
        volSlider.style.setProperty('--slider-pct', `${((DEFAULTS.vol - 25000) / (5000000 - 25000)) * 100}%`);
      }
      if (shareSlider) {
        shareSlider.value = String(DEFAULTS.share);
        shareSlider.style.setProperty('--slider-pct', `${DEFAULTS.share}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 0.5) / (2.5 - 0.5)) * 100}%`);
      }

      clearError();
      recalc();
      volInput.focus();
    });

    [volInput, ticketInput, shareInput, rateInput, gstInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('mdr-copy-btn')?.addEventListener('click', async () => {
      const numVol = parseSmartInput(volInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const numShare = parseSmartInput(shareInput.value, currLocale === 'de-DE' ? 'EUR' : undefined);
      const rawRate = rateInput ? String(parseSmartInput(rateInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) ?? '') : '1.1';
      const rawGst = gstInput ? String(parseSmartInput(gstInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) ?? '') : '18';

      const vVol = validate(numVol ?? '', { required: true, min: 1000, label: 'Volume' });
      const vShare = validate(numShare ?? '', { required: true, min: 0, max: 100, label: 'Share' });
      const numTicket = ticketInput ? parseSmartInput(ticketInput.value, currLocale === 'de-DE' ? 'EUR' : undefined) : DEFAULTS.ticket;
      const vTicket = validate(numTicket ?? '', { required: true, min: 1, label: 'Ticket' });
      const vRate = validate(rawRate ?? '', { required: true, min: 0.1, label: 'Rate' });
      const vGst = validate(rawGst ?? '', { required: true, min: 0, label: 'GST' });

      if (!vVol.valid || !vTicket.valid || !vShare.valid || !vRate.valid || !vGst.valid) return;

      const res = calcUPIMDR(vVol.value!, vTicket.value!, vShare.value!, vRate.value!, vGst.value!);
      const text = `UPI MDR: Volume ${fmtVal(vVol.value!)} (${vShare.value}% chargeable at ${vRate.value}%) => Fee+GST: ${fmtVal(res.totalDeductions)}, Net Settlement: ${fmtVal(res.netSettlement)}. ${location.href.split('#')[0]}`;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('mdr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('mdr-share-btn')?.addEventListener('click', async () => {
      const shareUrl = `${location.href.split('#')[0]}${serializeHash(currentHashState)}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = shareUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const btn = document.getElementById('mdr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    function applyHashParams() {
      const restored = restoreFromHash(readCurrentHash(), {
        v: { required: true, min: 1000, label: 'v' },
        s: { required: true, min: 0, max: 100, decimal: true, label: 's' },
        r: { required: true, min: 0.1, max: 5, decimal: true, label: 'r' },
        g: { required: true, min: 0, max: 28, decimal: true, label: 'g' },
      });
      if (restored.valid && restored.values.v && restored.values.s !== undefined && restored.values.r !== undefined && restored.values.g !== undefined) {
        volInput.value = fmtLiveInput(String(restored.values.v));
        shareInput.value = String(restored.values.s);
        const t = Number(new URLSearchParams(readCurrentHash().replace(/^#/, '')).get('t'));
        if (ticketInput && Number.isFinite(t) && t > 0) ticketInput.value = fmtLiveInput(String(t));
        if (rateInput) rateInput.value = String(restored.values.r);
        if (gstInput) gstInput.value = String(restored.values.g);
      }
      recalc();
    }

    applyHashParams();
    window.addEventListener('hashchange', applyHashParams);
  }

  initMDRCalc();
  document.addEventListener('astro:page-load', initMDRCalc);
</script>
