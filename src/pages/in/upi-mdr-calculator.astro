---
import Layout from '../../layouts/Layout.astro';
import CalculatorLayout from '../../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../../components/calculator/CompositionBar.astro';
import Slider from '../../components/calculator/Slider.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Alert from '../../components/ui/Alert.astro';
import { calcUPIMDR } from '../../lib/calculators/upi-mdr';
import { formatIndian } from '../../lib/formatters';
import { TOOLS } from '../../config/site';

const DEFAULT = {
  monthlyVolume: 500000,
  ticketSize: 1500,
  chargeableShare: 20,
  mdrRate: 1.1,
  gstRate: 18,
};

const initialResult = calcUPIMDR(
  DEFAULT.monthlyVolume,
  DEFAULT.ticketSize,
  DEFAULT.chargeableShare,
  DEFAULT.mdrRate,
  DEFAULT.gstRate
);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const related = TOOLS.filter((t) => t.category === 'Business' && t.slug !== 'upi-mdr-calculator' && t.status === 'published').slice(0, 3);
const canonicalUrl = 'https://calcumetrics.com/in/upi-mdr-calculator';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'UPI MDR Calculator',
      url: canonicalUrl,
      description: 'Calculate UPI merchant fees, interchange rates on PPI wallets and RuPay credit cards on UPI, GST deductions, and net bank settlement.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      inLanguage: 'en',
      dateModified: '2026-09-22',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'UPI MDR Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Does a consumer ever pay MDR on UPI transactions in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Per NPCI regulations, customers are never charged any fee or surcharge for paying via UPI, RuPay credit cards on UPI, or prepaid digital wallets. The MDR fee is strictly borne by the receiving merchant.',
          },
        },
        {
          '@type': 'Question',
          name: 'What UPI transactions are subject to MDR in India?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Normal peer-to-peer (P2P) and person-to-merchant (P2M) bank-to-bank UPI transfers carry zero MDR. Interchange fees apply to merchant transactions over ₹2,000 made via Prepaid Payment Instruments (wallets like Paytm/PhonePe Wallet) or RuPay Credit Cards linked to UPI.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can businesses claim Input Tax Credit (ITC) on the 18% GST charged on MDR?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. If your business has an active GST registration, you can claim the 18% GST charged by your payment aggregator on MDR fees as Input Tax Credit (ITC) in your monthly GSTR-3B filings.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the standard interchange rate for PPI wallet merchant transactions?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'NPCI guidelines prescribe an interchange fee of up to 1.1% on PPI merchant transactions above ₹2,000, depending on the merchant category code (MCC), with lower tiered rates for essential sectors like utilities, fuel, and education.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does ticket size impact merchant interchange costs?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Small transactions of ₹2,000 or less have zero interchange fee for merchants under PPI wallet guidelines. Businesses with high-volume, low-ticket sales (like tea stalls or convenience stores) face effectively zero MDR costs.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="UPI MDR Calculator: Merchant Discount Rates & GST Settlement | Calcumetrics"
  description="Calculate UPI merchant fees, interchange rates on PPI wallets and RuPay credit cards on UPI, GST deductions, and net bank settlement."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="UPI MDR Calculator"
    category="Business"
    categoryHref="/business"
    heroValue={fmt(initialResult.netSettlement)}
    heroLabel="Estimated Net Settlement"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">UPI MDR Calculator</h1>
      <p class="text-sm text-text-muted mb-6">Calculate interchange fees, 18% GST, and net merchant payouts on UPI and RuPay credit transactions.</p>

      <!-- Error alert -->
      <div id="mdr-error-alert" class="hidden mb-5" role="alert" aria-live="assertive">
        <Alert variant="error" title="Input Error">
          <span id="mdr-error-msg">Please check your inputs.</span>
        </Alert>
      </div>

      <!-- Monthly Volume -->
      <div class="mb-5">
        <Input
          id="mdr-volume"
          label="Total Monthly UPI Volume"
          prefix="₹"
          value="5,00,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Gross value of UPI merchant transactions processed monthly"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-volume-slider" min={25000} max={5000000} step={25000} value={500000} ariaLabel="Monthly volume slider" />
        </div>
      </div>

      <!-- Chargeable Share % -->
      <div class="mb-5">
        <Input
          id="mdr-share"
          label="Chargeable Share (PPI / RuPay Credit %)"
          suffix="%"
          value="20"
          isNumeric={true}
          helperText="Percentage of volume from interchange-eligible methods (> ₹2,000)"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-share-slider" min={0} max={100} step={1} value={20} ariaLabel="Chargeable share slider" />
        </div>
      </div>

      <!-- MDR Rate % -->
      <div class="mb-5">
        <Input
          id="mdr-rate"
          label="MDR / Interchange Fee Rate"
          suffix="%"
          value="1.1"
          isNumeric={true}
          helperText="Standard interchange fee rate (typically 0.9% to 1.1%)"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
        <div class="mt-2">
          <Slider id="mdr-rate-slider" min={0.5} max={2.5} step={0.05} value={1.1} ariaLabel="MDR rate slider" />
        </div>
      </div>

      <!-- GST Rate -->
      <div class="mb-6">
        <Input
          id="mdr-gst"
          label="GST on MDR Fee"
          suffix="%"
          value="18"
          isNumeric={true}
          helperText="Standard statutory GST levied on payment processing services"
          inputmode="decimal"
          aria-describedby="mdr-error-msg"
        />
      </div>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="mdr-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="mdr-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Net Monthly Settlement</span>
        <div id="mdr-result-settlement" class="text-[40px] leading-none font-semibold tabular-nums text-dark-accent" aria-live="polite">
          {fmt(initialResult.netSettlement)}
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Total Fee Deductions</span>
          <span id="mdr-result-deductions" class="text-sm font-semibold tabular-nums text-dark-text">{fmt(initialResult.totalDeductions)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Base MDR Fee</span>
          <span id="mdr-result-basefee" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.baseMdrFee)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">GST (18% on MDR)</span>
          <span id="mdr-result-gstamt" class="text-sm font-medium tabular-nums text-dark-text">{fmt(initialResult.gstAmount)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Effective Processing Cost</span>
          <span id="mdr-result-effective" class="text-sm font-bold tabular-nums text-dark-text">{initialResult.effectiveRatePct.toFixed(3)}%</span>
        </div>
      </div>

      <div class="mb-5" id="mdr-composition-wrapper">
        <CompositionBar
          principalFraction={initialResult.monthlyVolume > 0 ? initialResult.netSettlement / initialResult.monthlyVolume : 1}
          gainFraction={initialResult.monthlyVolume > 0 ? initialResult.totalDeductions / initialResult.monthlyVolume : 0}
          principalLabel="Settlement"
          gainLabel="MDR + GST"
          principalValue={fmt(initialResult.netSettlement)}
          gainValue={fmt(initialResult.totalDeductions)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="mdr-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="mdr-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Jurisdiction: India (INR locked). Compliant with NPCI circulars; zero surcharge can be passed onto consumers.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="mdr-calculator-how">
        <h2 id="mdr-calculator-how" class="text-xl font-bold text-text-primary mb-4">How UPI MDR & interchange fees are calculated</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Under National Payments Corporation of India (NPCI) directives, standard peer-to-peer (P2P) and person-to-merchant (P2M) bank account transfers carry <strong>zero MDR</strong>. Interchange fees apply strictly when consumers pay merchants via Prepaid Payment Instruments (wallets like Paytm, PhonePe Wallet) or RuPay Credit Cards on UPI for transactions exceeding ₹2,000:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 space-y-3">
          <div class="space-y-1">
            <p class="font-bold text-text-primary text-sm">Step 1: Determine Chargeable Merchant Volume</p>
            <p class="text-xs text-text-muted font-mono bg-canvas p-2 rounded">Chargeable Volume = Total Monthly Volume × (Chargeable Share % ÷ 100)</p>
          </div>
          <div class="space-y-1 border-t border-border/50 pt-2">
            <p class="font-bold text-text-primary text-sm">Step 2: Compute Base Merchant Discount Rate (MDR)</p>
            <p class="text-xs text-text-muted font-mono bg-canvas p-2 rounded">Base MDR Fee = Chargeable Volume × (Interchange Rate % ÷ 100)</p>
          </div>
          <div class="space-y-1 border-t border-border/50 pt-2">
            <p class="font-bold text-text-primary text-sm">Step 3: Levy Statutory 18% GST on Financial Services</p>
            <p class="text-xs text-text-muted font-mono bg-canvas p-2 rounded">GST Amount = Base MDR Fee × 18%</p>
          </div>
          <div class="space-y-1 border-t border-border/50 pt-2">
            <p class="font-bold text-text-primary text-sm">Step 4: Net Payout Credited to Business Account</p>
            <p class="text-xs text-text-muted font-mono bg-canvas p-2 rounded">Net Bank Settlement = Total Monthly Volume − (Base MDR Fee + GST Amount)</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="mdr-worked-example">
        <h2 id="mdr-worked-example" class="text-xl font-bold text-text-primary mb-4">Step-by-step worked example: Retail Merchant</h2>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider a retail merchant in Pune processing <strong>₹5,00,000</strong> in total monthly digital collections through merchant QR codes. Customer payment analytics indicate that <strong>80%</strong> (₹4,00,000) are direct savings bank transfers (0% MDR), while <strong>20%</strong> (₹1,00,000) are paid using PPI wallets or RuPay credit cards on UPI at a standard <strong>1.1% interchange rate</strong>:
        </p>
        <div class="bg-surface border border-border rounded-card p-5 mb-4 space-y-3 text-sm text-text-muted">
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Total Monthly UPI Volume:</span>
            <strong class="text-text-primary font-mono">₹5,00,000</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Free Bank-to-Bank Volume (80%):</span>
            <strong class="text-text-primary font-mono">₹4,00,000 (₹0 fee)</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Chargeable Volume (20% via PPI / RuPay Credit):</span>
            <strong class="text-text-primary font-mono">₹1,00,000</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Base MDR Fee (₹1,00,000 × 1.1%):</span>
            <strong class="text-text-primary font-mono">₹1,100</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>GST on Processing Fee (18% × ₹1,100):</span>
            <strong class="text-text-primary font-mono">₹198</strong>
          </div>
          <div class="flex justify-between border-b border-border/50 pb-2">
            <span>Total Payment Processing Deductions:</span>
            <strong class="text-text-primary font-mono">₹1,298</strong>
          </div>
          <div class="flex justify-between pt-1">
            <span>Net Monthly Bank Settlement:</span>
            <strong class="text-accent font-mono font-bold">₹4,98,702</strong>
          </div>
          <p class="text-xs text-text-muted pt-1 border-t border-border/50">
            <strong>Effective Acceptance Cost:</strong> ₹1,298 ÷ ₹5,00,000 = <strong>0.260%</strong>. This represents substantial operational savings compared to traditional card POS machines (which average 1.75% to 2.50%).
          </p>
        </div>
      </section>

      <section aria-labelledby="mdr-regulatory-rules">
        <h2 id="mdr-regulatory-rules" class="text-xl font-bold text-text-primary mb-4">NPCI regulations, interchange tiers & tax rules</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-text-muted mb-4">
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Zero Surcharge on Consumers</h3>
            <p>NPCI guidelines explicitly mandate that merchants cannot pass interchange costs onto buyers as convenience fees or checkout surcharges. Payment via UPI must remain 100% free for consumers.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">₹2,000 Ticket Size Threshold</h3>
            <p>Wallet and prepaid instrument interchange fees apply exclusively to transactions strictly above ₹2,000. High-volume, low-ticket retail transactions remain completely exempt from MDR deductions.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Input Tax Credit (ITC) Recovery</h3>
            <p>GST-registered merchants can claim the 18% GST levied on payment aggregator MDR invoices as Input Tax Credit (ITC) in their monthly GSTR-3B filings, offsetting taxes on outward goods or services.</p>
          </div>
          <div class="bg-surface border border-border rounded-card p-4">
            <h3 class="font-bold text-text-primary mb-1">Category Code (MCC) Concessions</h3>
            <p>Merchants in government services, agriculture, utilities, fuel, and education enjoy capped or reduced interchange tiers (typically 0.5%–0.7%) compared to the standard 1.1% commercial cap.</p>
          </div>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card mb-8 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Managing commercial cash flow and working capital velocity?</strong>
        Read our corporate liquidity analysis on <a href="/blog/cash-conversion-cycle" class="text-accent font-medium hover:underline">Cash Conversion Cycle (CCC): Working Capital Efficiency &amp; Liquidity Management</a> to learn how merchant collection speeds affect business solvency.
      </div>

      <section aria-labelledby="mdr-calculator-faq">
        <h2 id="mdr-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {((jsonld['@graph'][2] as any)?.mainEntity || []).map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="mdr-calculator-related">
        <h2 id="mdr-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcUPIMDR } from '../../lib/calculators/upi-mdr';
  import { validate } from '../../lib/validate';
  import { setResult } from '../../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../../lib/url-state';

  const currSym = '₹';
  const currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initMDRCalc() {
    if ((window as any).__cmMdrBound) return;
    (window as any).__cmMdrBound = true;

    const volInput = document.getElementById('mdr-volume') as HTMLInputElement | null;
    const shareInput = document.getElementById('mdr-share') as HTMLInputElement | null;
    const rateInput = document.getElementById('mdr-rate') as HTMLInputElement | null;
    const gstInput = document.getElementById('mdr-gst') as HTMLInputElement | null;

    const volSlider = document.getElementById('mdr-volume-slider') as HTMLInputElement | null;
    const shareSlider = document.getElementById('mdr-share-slider') as HTMLInputElement | null;
    const rateSlider = document.getElementById('mdr-rate-slider') as HTMLInputElement | null;

    const resSettlement = document.getElementById('mdr-result-settlement');
    const resDeductions = document.getElementById('mdr-result-deductions');
    const resBaseFee = document.getElementById('mdr-result-basefee');
    const resGstAmt = document.getElementById('mdr-result-gstamt');
    const resEffRate = document.getElementById('mdr-result-effective');

    const errAlert = document.getElementById('mdr-error-alert');
    const errMsg = document.getElementById('mdr-error-msg');

    if (!volInput || !shareInput) return;

    const DEFAULTS = { vol: 500000, share: 20, rate: 1.1, gst: 18 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawVol = volInput!.value.replace(/[^0-9.]/g, '');
      const rawShare = shareInput!.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput ? rateInput.value.replace(/[^0-9.]/g, '') : '1.1';
      const rawGst = gstInput ? gstInput.value.replace(/[^0-9.]/g, '') : '18';

      const vVol = validate(rawVol, { required: true, min: 1000, label: 'Monthly Volume' });
      const vShare = validate(rawShare, { required: true, min: 0, max: 100, decimal: true, label: 'Chargeable Share' });
      const vRate = validate(rawRate, { required: true, min: 0.1, max: 5, decimal: true, label: 'MDR Rate' });
      const vGst = validate(rawGst, { required: true, min: 0, max: 28, decimal: true, label: 'GST Rate' });

      if (!vVol.valid) { showError(vVol.error!.message); return; }
      if (!vShare.valid) { showError(vShare.error!.message); return; }
      if (!vRate.valid) { showError(vRate.error!.message); return; }
      if (!vGst.valid) { showError(vGst.error!.message); return; }
      clearError();

      const vol = vVol.value!;
      const share = vShare.value!;
      const rate = vRate.value!;
      const gst = vGst.value!;

      const res = calcUPIMDR(vol, 1500, share, rate, gst);

      setResult({
        heroValue: fmtVal(res.netSettlement),
        heroLabel: 'Estimated Net Settlement',
        rows: [
          { label: 'Total Fee Deductions', value: fmtVal(res.totalDeductions) },
          { label: 'Base MDR Fee', value: fmtVal(res.baseMdrFee) },
          { label: 'GST on MDR', value: fmtVal(res.gstAmount) },
          { label: 'Effective MDR Rate', value: `${res.effectiveRatePct.toFixed(3)}%` },
        ],
      });

      if (resSettlement) resSettlement.textContent = fmtVal(res.netSettlement);
      if (resDeductions) resDeductions.textContent = fmtVal(res.totalDeductions);
      if (resBaseFee) resBaseFee.textContent = fmtVal(res.baseMdrFee);
      if (resGstAmt) resGstAmt.textContent = fmtVal(res.gstAmount);
      if (resEffRate) resEffRate.textContent = `${res.effectiveRatePct.toFixed(3)}%`;

      const wrapper = document.getElementById('mdr-composition-wrapper');
      if (wrapper && vol > 0) {
        const setFrac = res.netSettlement / vol;
        const bar = wrapper.querySelector<HTMLElement>('[class*="bg-dark-muted"]');
        if (bar) bar.style.width = `${(setFrac * 100).toFixed(1)}%`;
        const valEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (valEls[0]) valEls[0].textContent = fmtVal(res.netSettlement);
        if (valEls[1]) valEls[1].textContent = fmtVal(res.totalDeductions);
      }

      serializeHash({ v: vol, s: share, r: rate, g: gst });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement, isFormatted: boolean) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = isFormatted ? fmtLiveInput(slider.value) : slider.value;
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        if (isFormatted) input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(volSlider, volInput, true);
    sync(shareSlider, shareInput, false);
    sync(rateSlider, rateInput!, false);

    document.getElementById('mdr-calculate')?.addEventListener('click', recalc);
    document.getElementById('mdr-reset')?.addEventListener('click', () => {
      volInput.value = fmtLiveInput(String(DEFAULTS.vol));
      shareInput.value = String(DEFAULTS.share);
      if (rateInput) rateInput.value = String(DEFAULTS.rate);
      if (gstInput) gstInput.value = String(DEFAULTS.gst);

      if (volSlider) {
        volSlider.value = String(DEFAULTS.vol);
        volSlider.style.setProperty('--slider-pct', `${((DEFAULTS.vol - 25000) / (5000000 - 25000)) * 100}%`);
      }
      if (shareSlider) {
        shareSlider.value = String(DEFAULTS.share);
        shareSlider.style.setProperty('--slider-pct', `${DEFAULTS.share}%`);
      }
      if (rateSlider) {
        rateSlider.value = String(DEFAULTS.rate);
        rateSlider.style.setProperty('--slider-pct', `${((DEFAULTS.rate - 0.5) / (2.5 - 0.5)) * 100}%`);
      }

      clearError();
      recalc();
      volInput.focus();
    });

    [volInput, shareInput, rateInput, gstInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('mdr-copy-btn')?.addEventListener('click', async () => {
      const rawVol = volInput.value.replace(/[^0-9.]/g, '');
      const rawShare = shareInput.value.replace(/[^0-9.]/g, '');
      const rawRate = rateInput ? rateInput.value.replace(/[^0-9.]/g, '') : '1.1';
      const rawGst = gstInput ? gstInput.value.replace(/[^0-9.]/g, '') : '18';

      const vVol = validate(rawVol, { required: true, min: 1000, label: 'Volume' });
      const vShare = validate(rawShare, { required: true, min: 0, max: 100, label: 'Share' });
      const vRate = validate(rawRate, { required: true, min: 0.1, label: 'Rate' });
      const vGst = validate(rawGst, { required: true, min: 0, label: 'GST' });

      if (!vVol.valid || !vShare.valid || !vRate.valid || !vGst.valid) return;

      const res = calcUPIMDR(vVol.value!, 1500, vShare.value!, vRate.value!, vGst.value!);
      const text = `UPI MDR: Volume ${fmtVal(vVol.value!)} (${vShare.value}% chargeable at ${vRate.value}%) => Fee+GST: ${fmtVal(res.totalDeductions)}, Net Settlement: ${fmtVal(res.netSettlement)}. ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('mdr-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('mdr-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('mdr-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      v: { required: true, min: 1000, label: 'v' },
      s: { required: true, min: 0, max: 100, decimal: true, label: 's' },
      r: { required: true, min: 0.1, max: 5, decimal: true, label: 'r' },
      g: { required: true, min: 0, max: 28, decimal: true, label: 'g' },
    });
    if (restored.valid && restored.values.v && restored.values.s !== undefined && restored.values.r !== undefined && restored.values.g !== undefined) {
      volInput.value = fmtLiveInput(String(restored.values.v));
      shareInput.value = String(restored.values.s);
      if (rateInput) rateInput.value = String(restored.values.r);
      if (gstInput) gstInput.value = String(restored.values.g);
      recalc();
    } else {
      recalc();
    }
  }

  initMDRCalc();
  document.addEventListener('astro:page-load', initMDRCalc);
</script>
