---
import Layout from '../layouts/Layout.astro';
import CalculatorLayout from '../components/calculator/CalculatorLayout.astro';
import CompositionBar from '../components/calculator/CompositionBar.astro';
import Slider from '../components/calculator/Slider.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import Alert from '../components/ui/Alert.astro';
import { calcEOQ } from '../lib/calculators/eoq';
import { formatIndian } from '../lib/formatters';
import { TOOLS } from '../config/site';

const DEFAULT = { demand: 10000, orderingCost: 500, holdingCost: 25 };
const result = calcEOQ(DEFAULT.demand, DEFAULT.orderingCost, DEFAULT.holdingCost);

const fmt = (n: number) => '₹' + formatIndian(Math.round(n));

const relatedSlugs = ['inventory-turnover-calculator', 'cogs-calculator', 'working-capital-calculator'];
const related = TOOLS.filter((t) => relatedSlugs.includes(t.slug) && t.status === 'published');
const canonicalUrl = 'https://calcumetrics.com/eoq-calculator' as string;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Economic Order Quantity (EOQ) Calculator',
      url: canonicalUrl,
      description: 'Calculate the optimal inventory order quantity (EOQ) that minimizes combined ordering and holding costs with annual ordering schedule.',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: 'en',
      dateModified: '2026-09-20',
      publisher: { '@id': 'https://calcumetrics.com/#org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://calcumetrics.com/' },
        { '@type': 'ListItem', position: 2, name: 'Business', item: 'https://calcumetrics.com/business' },
        { '@type': 'ListItem', position: 3, name: 'EOQ Calculator' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What assumptions does the EOQ model make?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The classic Wilson EOQ model assumes: (1) demand is known and constant throughout the year, (2) replenishment lead time is instantaneous or zero, (3) unit purchase price is constant (no quantity tier discounts), and (4) stockouts never happen.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is typically included in holding cost per unit?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Holding costs typically include warehouse rent, electricity, insurance, security, physical breakage/theft (shrinkage), obsolescence, and the opportunity cost of capital locked up in inventory (often 15%–25% of unit value annually).',
          },
        },
        {
          '@type': 'Question',
          name: 'What is included in ordering or setup cost?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Ordering costs include clerical costs of preparing purchase orders, invoice processing, receiving inspection, vendor communication, and fixed freight/shipping handling charges per shipment.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do quantity discounts affect the standard EOQ calculation?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'When suppliers offer volume discounts, the optimal order quantity may be larger than the standard EOQ if annual purchase price savings exceed the additional carrying costs of the larger inventory batch.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if actual demand differs from estimated demand?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Because EOQ uses a square root function, total costs are relatively flat near the optimal point. A 20% forecasting error in annual demand changes total inventory costs by only about 2%.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title="EOQ Calculator: Economic Order Quantity & Holding Costs | Calcumetrics"
  description="Calculate the optimal order size that minimizes annual holding and ordering costs with reorder schedules and cost minimization curves."
  canonical={canonicalUrl}
>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonld)} /></Fragment>

  <CalculatorLayout
    toolName="Economic Order Quantity (EOQ)"
    category="Business"
    categoryHref="/business"
    heroValue={new Intl.NumberFormat('en-IN').format(result.eoqRounded) + ' Units'}
    heroLabel="Optimal Order Batch Size"
  >
    <Fragment slot="inputs">
      <h1 class="text-2xl font-bold tracking-tight text-text-primary mb-1">Economic Order Quantity (EOQ)</h1>
      <p class="text-sm text-text-muted mb-6">Find the sweet spot between order placement fees and inventory warehousing carrying costs.</p>

      <!-- Error alert -->
      <div id="eoq-error-alert" class="hidden mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-control text-sm text-red-400" role="alert">
        <span id="eoq-error-msg"></span>
      </div>

      <!-- Annual Demand -->
      <div class="mb-5">
        <Input
          id="eoq-demand"
          label="Annual Demand (Units)"
          suffix="Units/Yr"
          value="10,000"
          isNumeric={true}
          localeFormat="indian"
          helperText="Total units required or sold during the year"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="eoq-demand-slider" min={500} max={100000} step={500} value={10000} ariaLabel="Annual demand slider" />
        </div>
      </div>

      <!-- Order Cost -->
      <div class="mb-5">
        <Input
          id="eoq-order-cost"
          label="Ordering / Setup Cost (per Order)"
          prefix="₹"
          value="500"
          isNumeric={true}
          localeFormat="indian"
          helperText="Fixed administrative, shipping, and handling charge per purchase order"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="eoq-order-cost-slider" min={25} max={10000} step={25} value={500} ariaLabel="Order cost slider" />
        </div>
      </div>

      <!-- Holding Cost -->
      <div class="mb-6">
        <Input
          id="eoq-holding-cost"
          label="Annual Holding Cost (per Unit / Year)"
          prefix="₹"
          value="25"
          isNumeric={true}
          localeFormat="indian"
          helperText="Warehouse storage, shrinkage, obsolescence, and working capital interest"
          inputmode="decimal"
        />
        <div class="mt-2">
          <Slider id="eoq-holding-cost-slider" min={1} max={500} step={1} value={25} ariaLabel="Holding cost slider" />
        </div>
      </div>

      <Alert variant="info" title="The EOQ Principle">
        At the Economic Order Quantity, total annual ordering costs exactly equal total annual holding costs, minimizing total carrying expense.
      </Alert>

      <div class="flex gap-3 mt-6">
        <Button variant="primary" id="eoq-calculate" type="button">Calculate</Button>
        <Button variant="ghost" id="eoq-reset" type="button">Reset</Button>
      </div>
    </Fragment>

    <Fragment slot="outputs">
      <div class="mb-5">
        <span class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">Optimal Order Batch Size</span>
        <div id="eoq-result-hero" class="text-[40px] leading-none font-semibold tabular-nums text-dark-text" aria-live="polite">
          {new Intl.NumberFormat('en-IN').format(result.eoqRounded)} Units
        </div>
      </div>

      <div class="space-y-0 border-t border-dark-border pt-4 mb-5">
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Orders Required per Year</span>
          <span id="eoq-result-orders" class="text-sm font-semibold tabular-nums text-dark-accent">{result.ordersPerYear.toFixed(1)} Orders</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Days Between Orders</span>
          <span id="eoq-result-days" class="text-sm font-medium tabular-nums text-dark-text">{Math.round(result.daysBetweenOrders)} Days</span>
        </div>
        <div class="flex items-center justify-between py-2.5 border-b border-dark-border">
          <span class="text-xs text-dark-muted">Annual Ordering Costs</span>
          <span id="eoq-result-ordercost" class="text-sm font-medium tabular-nums text-dark-text">{fmt(result.annualOrderingCost)}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-xs text-dark-muted">Total Minimized Inventory Cost</span>
          <span id="eoq-result-totalcost" class="text-sm font-bold tabular-nums text-dark-text">{fmt(result.totalInventoryCost)}</span>
        </div>
      </div>

      <div class="mb-5" id="eoq-composition-wrapper">
        <CompositionBar
          principalFraction={0.5}
          gainFraction={0.5}
          principalLabel="Ordering Cost"
          gainLabel="Holding Cost"
          principalValue={fmt(result.annualOrderingCost)}
          gainValue={fmt(result.annualHoldingCost)}
        />
      </div>

      <div class="flex gap-2 mt-4">
        <button type="button" id="eoq-copy-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Copy Result
        </button>
        <button type="button" id="eoq-share-btn" class="flex-1 h-10 text-sm font-medium rounded-control border border-dark-border text-dark-text hover:bg-dark-border transition-standard cursor-pointer">
          Share Link
        </button>
      </div>

      <p class="text-xs text-dark-muted mt-4 leading-relaxed">Ford W. Harris mathematical inventory optimization model.</p>
    </Fragment>

    <Fragment slot="below">
      <section aria-labelledby="eoq-calculator-how">
        <h2 id="eoq-calculator-how" class="text-xl font-bold text-text-primary mb-4">How Economic Order Quantity is calculated</h2>
        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            The Economic Order Quantity (EOQ) formula, formulated by Ford W. Harris in 1913, identifies the exact purchase order size that <strong>minimizes total annual inventory costs</strong> by balancing fixed purchase order setup fees against ongoing storage carrying costs.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono mb-4">
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Optimal Batch Size (EOQ)</span>
              <span class="text-accent font-semibold text-sm">EOQ = √ [ (2 × D × S) ÷ H ]</span><br />
              <span class="text-text-muted mt-1 block">D = Annual demand in units<br />S = Fixed setup/ordering fee per order<br />H = Annual carrying cost per unit</span>
            </div>
            <div class="bg-canvas border border-border rounded p-3">
              <span class="font-bold text-text-primary block mb-1">Inventory Cost Equations</span>
              <span class="text-text-muted">Orders / Year (N) = D ÷ EOQ</span><br />
              <span class="text-text-muted">Annual Ordering Cost = N × S</span><br />
              <span class="text-text-muted">Annual Holding Cost = (EOQ ÷ 2) × H</span><br />
              <span class="text-accent font-semibold">Total Cost = Ordering Cost + Holding Cost</span>
            </div>
          </div>
          <p class="text-xs text-text-muted leading-relaxed">
            <strong>The Equilibrium Principle:</strong> At the mathematical minimum of the total cost curve, <em>Annual Ordering Cost exactly equals Annual Holding Cost</em>.
          </p>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Step-by-step worked example</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Consider a distribution facility operating with the default baseline parameters: an annual demand of <strong>10,000 units</strong>, a fixed procurement cost of <strong>₹500 per purchase order</strong>, and an annual holding cost of <strong>₹25 per unit per year</strong>:
        </p>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="py-3 px-4">Calculation Step</th>
                <th class="py-3 px-4">Formula</th>
                <th class="py-3 px-4">Substitution & Computation</th>
                <th class="py-3 px-4">Verified Result</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">1. Numerator (2 × D × S)</td>
                <td class="py-2.5 px-4 font-mono">2 × Annual Demand × Order Cost</td>
                <td class="py-2.5 px-4 font-mono">2 × 10,000 × ₹500</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">₹1,00,00,000</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">2. Cost Ratio</td>
                <td class="py-2.5 px-4 font-mono">(2 × D × S) ÷ H</td>
                <td class="py-2.5 px-4 font-mono">₹1,00,00,000 ÷ 25</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">400,000</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-text-primary">3. Optimal EOQ</td>
                <td class="py-2.5 px-4 font-mono">√400,000</td>
                <td class="py-2.5 px-4 font-mono">Exact square root</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">632.46 Units (632 Units)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">4. Order Frequency</td>
                <td class="py-2.5 px-4 font-mono">D ÷ EOQ</td>
                <td class="py-2.5 px-4 font-mono">10,000 ÷ 632.46</td>
                <td class="py-2.5 px-4 font-mono text-accent font-semibold">15.81 Orders / Year</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">5. Cycle Time (Days)</td>
                <td class="py-2.5 px-4 font-mono">365 ÷ Orders / Year</td>
                <td class="py-2.5 px-4 font-mono">365 ÷ 15.81</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">23.08 Days (~23 Days)</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">6. Annual Ordering Cost</td>
                <td class="py-2.5 px-4 font-mono">15.81 × ₹500</td>
                <td class="py-2.5 px-4 font-mono">15.81139 × 500</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">₹7,906</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">7. Annual Holding Cost</td>
                <td class="py-2.5 px-4 font-mono">(632.46 ÷ 2) × ₹25</td>
                <td class="py-2.5 px-4 font-mono">316.23 × 25</td>
                <td class="py-2.5 px-4 font-mono text-text-primary">₹7,906</td>
              </tr>
              <tr class="bg-surface font-semibold text-text-primary border-t-2 border-border">
                <td class="py-3 px-4">8. Minimized Total Cost</td>
                <td class="py-3 px-4 font-mono">Ordering + Holding</td>
                <td class="py-3 px-4 font-mono">₹7,906 + ₹7,906</td>
                <td class="py-3 px-4 font-mono text-accent font-bold">₹15,811 / Year</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="text-lg font-bold text-text-primary mb-3">Cost Trade-off Matrix: Batch Size Sensitivity</h3>
        <p class="text-sm text-text-muted leading-relaxed mb-4">
          Ordering too little wastes money on repetitive purchase orders and delivery charges; ordering too much clogs warehouse capacity and burns working capital in carrying charges:
        </p>

        <div class="overflow-x-auto mb-6">
          <table class="w-full text-sm text-left border border-border rounded-card overflow-hidden">
            <thead class="bg-surface text-text-primary font-semibold border-b border-border">
              <tr>
                <th class="py-3 px-4">Batch Policy</th>
                <th class="py-3 px-4">Order Size</th>
                <th class="py-3 px-4">Orders / Year</th>
                <th class="py-3 px-4">Annual Ordering</th>
                <th class="py-3 px-4">Annual Holding</th>
                <th class="py-3 px-4">Total Inventory Cost</th>
                <th class="py-3 px-4">Operational Trade-off</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-text-muted">
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Under-ordering</td>
                <td class="py-2.5 px-4 font-mono">200 Units</td>
                <td class="py-2.5 px-4 font-mono">50.0</td>
                <td class="py-2.5 px-4 font-mono text-error">₹25,000</td>
                <td class="py-2.5 px-4 font-mono">₹2,500</td>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">₹27,500</td>
                <td class="py-2.5 px-4">Excessive purchase order paperwork and inbound inspection overhead.</td>
              </tr>
              <tr class="bg-surface/50 font-medium">
                <td class="py-2.5 px-4 text-accent font-semibold">Optimal (EOQ)</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">632 Units</td>
                <td class="py-2.5 px-4 font-mono text-accent">15.8</td>
                <td class="py-2.5 px-4 font-mono text-accent">₹7,906</td>
                <td class="py-2.5 px-4 font-mono text-accent">₹7,906</td>
                <td class="py-2.5 px-4 font-mono text-accent font-bold">₹15,811</td>
                <td class="py-2.5 px-4 text-text-primary">Perfect balance point; total inventory overhead minimized.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Moderate Bulk</td>
                <td class="py-2.5 px-4 font-mono">2,000 Units</td>
                <td class="py-2.5 px-4 font-mono">5.0</td>
                <td class="py-2.5 px-4 font-mono">₹2,500</td>
                <td class="py-2.5 px-4 font-mono text-error">₹25,000</td>
                <td class="py-2.5 px-4 font-mono font-medium text-text-primary">₹27,500</td>
                <td class="py-2.5 px-4">Warehousing congestion and bloated working capital debt carrying costs.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-4 font-medium text-text-primary">Extreme Bulk</td>
                <td class="py-2.5 px-4 font-mono">5,000 Units</td>
                <td class="py-2.5 px-4 font-mono">2.0</td>
                <td class="py-2.5 px-4 font-mono">₹1,000</td>
                <td class="py-2.5 px-4 font-mono text-error">₹62,500</td>
                <td class="py-2.5 px-4 font-mono font-bold text-error">₹63,500</td>
                <td class="py-2.5 px-4">Severe cash lockup; 4× higher carrying expense than optimal EOQ.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">Anatomy of Holding vs. Ordering Costs</h3>
            <ul class="text-xs text-text-muted space-y-1.5 list-disc pl-4 leading-relaxed">
              <li><strong>Holding Costs (H):</strong> Warehouse lease per sq ft, climate control, insurance policies, security personnel, product shrinkage/theft, damage, obsolescence, and the opportunity cost of working capital (typically 15%–25% of unit purchase value).</li>
              <li><strong>Ordering Costs (S):</strong> Procurement staff salary time to generate POs, vendor negotiation, shipping freight handling charges per delivery, pallet unloading, and quality assurance inspection fees.</li>
            </ul>
          </div>

          <div class="bg-surface border border-border rounded-card p-5">
            <h3 class="text-base font-bold text-text-primary mb-2">When Suppliers Offer Volume Discounts</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-2">
              If a vendor offers a price break at a higher order threshold (e.g., 5% discount for orders &ge; 1,000 units), you should evaluate:
            </p>
            <p class="text-xs font-mono text-text-primary bg-canvas border border-border rounded p-2">
              Net Savings = Annual Price Discount − Increase in Total Carrying & Ordering Costs
            </p>
            <p class="text-xs text-text-muted mt-2">
              If annual purchase discount exceeds the added inventory holding cost, ordering above the standard EOQ is financially advantageous.
            </p>
          </div>
        </div>

        <div class="bg-surface border border-border rounded-card p-5 mb-6">
          <h3 class="text-base font-bold text-text-primary mb-2">Assumptions & Supply Chain Limitations</h3>
          <ul class="text-xs text-text-muted space-y-2 list-disc pl-4 leading-relaxed">
            <li><strong>Uniform Steady Demand:</strong> Assumes consumption is flat and predictable throughout 365 days. Highly seasonal items (apparel, holiday goods) require dynamic safety stock models.</li>
            <li><strong>Instantaneous Replenishment:</strong> Assumes delivery lead time is zero. In practice, procurement managers establish a Reorder Point (ROP = Lead Time Demand + Safety Stock) to avoid stockouts.</li>
            <li><strong>Unlimited Storage & Working Capital:</strong> Assumes the business has unrestricted warehouse footprint and available liquidity to finance any batch size calculated.</li>
          </ul>
        </div>
      </section>

      <div class="p-4 bg-surface border border-accent/30 rounded-card my-6 text-xs text-text-muted">
        <strong class="text-text-primary text-sm block mb-1">Looking to minimize total procurement and carrying costs?</strong>
        Read our supply chain guide on <a href="/blog/economic-order-quantity-eoq-guide" class="text-accent font-medium hover:underline">Economic Order Quantity (EOQ): Balancing Ordering vs. Carrying Costs Without Running Out of Stock</a> to master holding cost components, reorder point buffers, and bulk quantity discount trade-offs.
      </div>

      <section aria-labelledby="eoq-calculator-faq">
        <h2 id="eoq-calculator-faq" class="text-xl font-bold text-text-primary mb-4">Frequently asked questions</h2>
        <div class="space-y-3">
          {jsonld['@graph'][2].mainEntity.map((faq: any) => (
            <details class="border border-border rounded-card overflow-hidden">
              <summary class="px-5 py-3.5 cursor-pointer text-sm font-medium text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent">{faq.name}</summary>
              <div class="px-5 pb-4 pt-2 text-sm text-text-muted leading-relaxed">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="eoq-calculator-related">
        <h2 id="eoq-calculator-related" class="text-xl font-bold text-text-primary mb-4">Related calculators</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((tool) => (
            <a href={tool.path} class="group block bg-surface border border-border rounded-card p-4 hover:border-accent transition-standard focus-visible:outline-accent">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-1">{tool.category}</span>
              <h3 class="font-bold text-sm text-text-primary group-hover:text-accent transition-standard">{tool.name}</h3>
              <p class="text-xs text-text-muted mt-1 leading-relaxed">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  </CalculatorLayout>
</Layout>

<script>
  import { calcEOQ } from '../lib/calculators/eoq';
  import { validate } from '../lib/validate';
  import { setResult } from '../lib/result-bus';
  import { serializeHash, restoreFromHash, readCurrentHash } from '../lib/url-state';

  let currSym = '₹';
  let currLocale = 'en-IN';
  function fmtVal(n: number) {
    return currSym + new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n));
  }
  function fmtUnits(n: number) {
    return new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(Math.round(n)) + ' Units';
  }
  function fmtLiveInput(raw: string) {
    const num = parseInt(raw.replace(/[^0-9]/g, ''), 10);
    return isNaN(num) ? '' : new Intl.NumberFormat(currLocale, { maximumFractionDigits: 0 }).format(num);
  }

  function initEOQCalc() {
    if ((window as any).__cmEoqBound) return;
    (window as any).__cmEoqBound = true;

    const dInput = document.getElementById('eoq-demand') as HTMLInputElement | null;
    const sInput = document.getElementById('eoq-order-cost') as HTMLInputElement | null;
    const hInput = document.getElementById('eoq-holding-cost') as HTMLInputElement | null;

    const dSlider = document.getElementById('eoq-demand-slider') as HTMLInputElement | null;
    const sSlider = document.getElementById('eoq-order-cost-slider') as HTMLInputElement | null;
    const hSlider = document.getElementById('eoq-holding-cost-slider') as HTMLInputElement | null;

    const resHero = document.getElementById('eoq-result-hero');
    const resOrders = document.getElementById('eoq-result-orders');
    const resDays = document.getElementById('eoq-result-days');
    const resOrderCost = document.getElementById('eoq-result-ordercost');
    const resTotalCost = document.getElementById('eoq-result-totalcost');

    const errAlert = document.getElementById('eoq-error-alert');
    const errMsg = document.getElementById('eoq-error-msg');

    if (!dInput || !sInput || !hInput) return;

    const DEFAULTS = { d: 10000, s: 500, h: 25 };
    let timer: ReturnType<typeof setTimeout>;

    function showError(msg: string) {
      if (errAlert) errAlert.classList.remove('hidden');
      if (errMsg) errMsg.textContent = msg;
    }
    function clearError() {
      if (errAlert) errAlert.classList.add('hidden');
    }

    function recalc() {
      const rawD = dInput!.value.replace(/[^0-9.]/g, '');
      const rawS = sInput!.value.replace(/[^0-9.]/g, '');
      const rawH = hInput!.value.replace(/[^0-9.]/g, '');

      const vD = validate(rawD, { required: true, min: 1, label: 'Annual Demand' });
      const vS = validate(rawS, { required: true, min: 0.01, label: 'Order Cost' });
      const vH = validate(rawH, { required: true, min: 0.01, label: 'Holding Cost' });

      if (!vD.valid) { showError(vD.error!.message); return; }
      if (!vS.valid) { showError(vS.error!.message); return; }
      if (!vH.valid) { showError(vH.error!.message); return; }
      clearError();

      const d = vD.value!;
      const s = vS.value!;
      const h = vH.value!;

      const res = calcEOQ(d, s, h);

      setResult({
        heroValue: fmtUnits(res.eoqRounded),
        heroLabel: 'Optimal Order Batch Size',
        rows: [
          { label: 'Orders Required per Year', value: `${res.ordersPerYear.toFixed(1)} Orders` },
          { label: 'Days Between Orders', value: `${Math.round(res.daysBetweenOrders)} Days` },
          { label: 'Annual Ordering Costs', value: fmtVal(res.annualOrderingCost) },
          { label: 'Total Minimized Inventory Cost', value: fmtVal(res.totalInventoryCost) },
        ],
      });

      if (resHero) resHero.textContent = fmtUnits(res.eoqRounded);
      if (resOrders) resOrders.textContent = `${res.ordersPerYear.toFixed(1)} Orders`;
      if (resDays) resDays.textContent = `${Math.round(res.daysBetweenOrders)} Days`;
      if (resOrderCost) resOrderCost.textContent = fmtVal(res.annualOrderingCost);
      if (resTotalCost) resTotalCost.textContent = fmtVal(res.totalInventoryCost);

      const wrapper = document.getElementById('eoq-composition-wrapper');
      if (wrapper && res.totalInventoryCost > 0) {
        const legendEls = wrapper.querySelectorAll<HTMLElement>('.tabular-nums');
        if (legendEls[0]) legendEls[0].textContent = fmtVal(res.annualOrderingCost);
        if (legendEls[1]) legendEls[1].textContent = fmtVal(res.annualHoldingCost);
      }

      serializeHash({ d, s, h });
    }

    function debounce() {
      clearTimeout(timer);
      timer = setTimeout(recalc, 100);
    }

    function sync(slider: HTMLInputElement | null, input: HTMLInputElement) {
      if (!slider) return;
      slider.addEventListener('input', () => {
        input.value = fmtLiveInput(slider.value);
        const pct = ((parseFloat(slider.value) - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
        slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        debounce();
      });
      input.addEventListener('input', () => {
        const raw = input.value.replace(/[^0-9.]/g, '');
        const num = parseFloat(raw);
        if (!isNaN(num) && num >= parseFloat(slider.min) && num <= parseFloat(slider.max)) {
          slider.value = String(num);
          const pct = ((num - parseFloat(slider.min)) / (parseFloat(slider.max) - parseFloat(slider.min))) * 100;
          slider.style.setProperty('--slider-pct', `${pct.toFixed(2)}%`);
        }
        input.value = fmtLiveInput(raw);
        debounce();
      });
    }

    sync(dSlider, dInput);
    sync(sSlider, sInput);
    sync(hSlider, hInput);

    document.getElementById('eoq-calculate')?.addEventListener('click', recalc);
    document.getElementById('eoq-reset')?.addEventListener('click', () => {
      dInput.value = fmtLiveInput(String(DEFAULTS.d));
      sInput.value = fmtLiveInput(String(DEFAULTS.s));
      hInput.value = fmtLiveInput(String(DEFAULTS.h));

      if (dSlider) {
        dSlider.value = String(DEFAULTS.d);
        dSlider.style.setProperty('--slider-pct', `${((DEFAULTS.d - 500) / (100000 - 500)) * 100}%`);
      }
      if (sSlider) {
        sSlider.value = String(DEFAULTS.s);
        sSlider.style.setProperty('--slider-pct', `${((DEFAULTS.s - 25) / (10000 - 25)) * 100}%`);
      }
      if (hSlider) {
        hSlider.value = String(DEFAULTS.h);
        hSlider.style.setProperty('--slider-pct', `${((DEFAULTS.h - 1) / (500 - 1)) * 100}%`);
      }

      clearError();
      recalc();
      dInput.focus();
    });

    [dInput, sInput, hInput].forEach((el) => {
      el?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') recalc();
      });
    });

    // Copy & Share
    document.getElementById('eoq-copy-btn')?.addEventListener('click', async () => {
      const rawD = dInput.value.replace(/[^0-9.]/g, '');
      const rawS = sInput.value.replace(/[^0-9.]/g, '');
      const rawH = hInput.value.replace(/[^0-9.]/g, '');
      const vD = validate(rawD, { required: true, min: 1, label: 'Demand' });
      const vS = validate(rawS, { required: true, min: 0.01, label: 'Order Cost' });
      const vH = validate(rawH, { required: true, min: 0.01, label: 'Holding Cost' });
      if (!vD.valid || !vS.valid || !vH.valid) return;

      const d = vD.value!;
      const s = vS.value!;
      const h = vH.value!;
      const res = calcEOQ(d, s, h);
      const text = `EOQ Result: Demand ${d} units, Setup Cost ${fmtVal(s)}, Holding Cost ${fmtVal(h)} => Optimal Order Quantity: ${fmtUnits(res.eoqRounded)} (${res.ordersPerYear.toFixed(1)} orders/yr). ${location.href.split('#')[0]}`;
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('eoq-copy-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    document.getElementById('eoq-share-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const btn = document.getElementById('eoq-share-btn');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = 'Copied Link!';
        setTimeout(() => (btn.textContent = orig), 2000);
      }
    });

    // Restore from hash
    const restored = restoreFromHash(readCurrentHash(), {
      d: { required: true, min: 1, label: 'd' },
      s: { required: true, min: 0.01, label: 's' },
      h: { required: true, min: 0.01, label: 'h' },
    });
    if (restored.valid && restored.values.d && restored.values.s && restored.values.h) {
      dInput.value = fmtLiveInput(String(restored.values.d));
      sInput.value = fmtLiveInput(String(restored.values.s));
      hInput.value = fmtLiveInput(String(restored.values.h));
      recalc();
    } else {
      recalc();
    }

    window.addEventListener('cm:currency-change', (e: any) => {
      if (e.detail?.symbol) {
        currSym = e.detail.symbol;
        currLocale = e.detail.code === 'USD' ? 'en-US' : e.detail.code === 'EUR' ? 'de-DE' : e.detail.code === 'GBP' ? 'en-GB' : 'en-IN';
        recalc();
      }
    });
    try {
      const saved = localStorage.getItem('cm_currency');
      if (saved) {
        currSym = saved.includes('$') ? '$' : saved.includes('€') ? '€' : saved.includes('£') ? '£' : '₹';
        currLocale = saved.includes('USD') ? 'en-US' : saved.includes('EUR') ? 'de-DE' : saved.includes('GBP') ? 'en-GB' : 'en-IN';
      }
    } catch (e) {}
  }

  initEOQCalc();
  document.addEventListener('astro:page-load', initEOQCalc);
</script>
