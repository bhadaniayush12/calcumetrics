---
interface Props {
  variant?: 'input' | 'dark-output' | 'stat' | 'directory' | 'empty-state' | 'skeleton-light' | 'skeleton-dark';
  href?: string;
  class?: string;
  id?: string;
}

const {
  variant = 'input',
  href,
  class: className = '',
  id,
  ...rest
} = Astro.props;

// Section 5 & 2: Cards 12px radius (rounded-card). 1px solid border ONLY. No box-shadow. No hover-lift.
const variantClasses = {
  input: 'bg-surface border border-border p-6',
  'dark-output': 'bg-dark-bg border border-dark-border p-6 text-dark-text dark-surface',
  stat: 'bg-surface border border-border p-4',
  directory: 'bg-surface border border-border p-5 transition-standard hover:border-accent cursor-pointer',
  'empty-state': 'bg-canvas border border-border p-8 text-center',
  'skeleton-light': 'bg-surface border border-border p-6',
  'skeleton-dark': 'bg-dark-bg border border-dark-border p-6 text-dark-text dark-surface',
};

const baseClasses = 'rounded-card relative';
const combinedClasses = `${baseClasses} ${variantClasses[variant]} ${className}`.trim();
---

{
  variant === 'directory' && href ? (
    <a href={href} class={combinedClasses} id={id} {...rest}>
      <slot />
    </a>
  ) : variant === 'skeleton-light' ? (
    <div class={combinedClasses} id={id} aria-busy="true" aria-live="polite" {...rest}>
      <div class="space-y-4 animate-skeleton">
        <div class="h-4 bg-disabled-bg rounded w-1/3"></div>
        <div class="h-10 bg-disabled-bg rounded w-full"></div>
        <div class="space-y-2 pt-2">
          <div class="h-3 bg-disabled-bg rounded w-3/4"></div>
          <div class="h-3 bg-disabled-bg rounded w-1/2"></div>
        </div>
      </div>
    </div>
  ) : variant === 'skeleton-dark' ? (
    <div class={combinedClasses} id={id} aria-busy="true" aria-live="polite" {...rest}>
      <div class="space-y-4 animate-skeleton">
        <div class="h-4 bg-dark-border rounded w-1/4"></div>
        <div class="h-10 bg-dark-border rounded w-2/3"></div>
        <div class="space-y-2 pt-4 border-t border-dark-border">
          <div class="h-3 bg-dark-border rounded w-full"></div>
          <div class="h-3 bg-dark-border rounded w-5/6"></div>
        </div>
      </div>
    </div>
  ) : (
    <div class={combinedClasses} id={id} {...rest}>
      <slot />
    </div>
  )
}
