---
// src/components/ui/MobileDock.astro
// macOS-Style Floating Mobile Dock Navigation
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isHome = currentPath === '/';
const isTools = currentPath.startsWith('/calculators') || currentPath.startsWith('/investments') || currentPath.startsWith('/loans') || currentPath.startsWith('/taxes') || currentPath.startsWith('/business') || currentPath.startsWith('/corporate-finance');
const isBlog = currentPath.startsWith('/blog');
---

<nav
  id="mac-mobile-dock"
  aria-label="Mobile Navigation Dock"
  class="fixed bottom-3 inset-x-0 mx-auto z-40 lg:hidden flex justify-center pointer-events-none px-4"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="pointer-events-auto flex items-center justify-between gap-1 px-3 py-2 bg-surface/90 dark:bg-surface/90 backdrop-blur-lg border border-border/90 rounded-2xl shadow-mac w-full max-w-[360px]">
    <!-- Home -->
    <a
      href="/"
      class:list={[
        'flex flex-col items-center justify-center flex-1 min-h-[44px] py-1 px-1.5 rounded-xl transition-standard text-center group cursor-pointer select-none',
        isHome ? 'text-accent font-semibold bg-canvas' : 'text-text-muted hover:text-text-primary'
      ]}
    >
      <svg class="w-5 h-5 mb-0.5 stroke-current fill-none transition-standard group-hover:scale-110" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        <polyline points="9 22 9 12 15 12 15 22" />
      </svg>
      <span class="text-[10px] leading-tight tracking-tight">Home</span>
    </a>

    <!-- Tools -->
    <a
      href="/calculators"
      class:list={[
        'flex flex-col items-center justify-center flex-1 min-h-[44px] py-1 px-1.5 rounded-xl transition-standard text-center group cursor-pointer select-none',
        isTools ? 'text-accent font-semibold bg-canvas' : 'text-text-muted hover:text-text-primary'
      ]}
    >
      <svg class="w-5 h-5 mb-0.5 stroke-current fill-none transition-standard group-hover:scale-110" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2" width="16" height="20" rx="2" />
        <line x1="8" y1="6" x2="16" y2="6" />
        <line x1="16" y1="14" x2="16" y2="18" />
        <path d="M8 10h.01" />
        <path d="M12 10h.01" />
        <path d="M16 10h.01" />
        <path d="M8 14h.01" />
        <path d="M12 14h.01" />
        <path d="M8 18h.01" />
        <path d="M12 18h.01" />
      </svg>
      <span class="text-[10px] leading-tight tracking-tight">Tools</span>
    </a>

    <!-- Search (Triggers Spotlight) -->
    <button
      type="button"
      id="dock-search-btn"
      aria-label="Search calculators"
      class="flex flex-col items-center justify-center flex-1 min-h-[44px] py-1 px-1.5 rounded-xl transition-standard text-center text-text-muted hover:text-accent group cursor-pointer select-none"
    >
      <div class="w-7 h-7 rounded-full bg-accent/15 text-accent flex items-center justify-center mb-0.5 group-hover:scale-110 transition-standard">
        <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </div>
      <span class="text-[10px] leading-tight tracking-tight font-medium text-accent">Search</span>
    </button>

    <!-- Blog -->
    <a
      href="/blog"
      class:list={[
        'flex flex-col items-center justify-center flex-1 min-h-[44px] py-1 px-1.5 rounded-xl transition-standard text-center group cursor-pointer select-none',
        isBlog ? 'text-accent font-semibold bg-canvas' : 'text-text-muted hover:text-text-primary'
      ]}
    >
      <svg class="w-5 h-5 mb-0.5 stroke-current fill-none transition-standard group-hover:scale-110" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
      </svg>
      <span class="text-[10px] leading-tight tracking-tight">Blog</span>
    </a>

    <!-- About -->
    <a
      href="/about"
      class:list={[
        'flex flex-col items-center justify-center flex-1 min-h-[44px] py-1 px-1.5 rounded-xl transition-standard text-center group cursor-pointer select-none',
        currentPath.startsWith('/about') ? 'text-accent font-semibold bg-canvas' : 'text-text-muted hover:text-text-primary'
      ]}
    >
      <svg class="w-5 h-5 mb-0.5 stroke-current fill-none transition-standard group-hover:scale-110" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4" />
        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
      </svg>
      <span class="text-[10px] leading-tight tracking-tight">About</span>
    </a>
  </div>
</nav>

<script>
  function initMobileDock() {
    const dock = document.getElementById('mac-mobile-dock');
    // If a calculator page has a dedicated sticky result bar (#calc-mobile-bar), yield to it so results are unobstructed
    if (document.getElementById('calc-mobile-bar')) {
      if (dock) dock.style.display = 'none';
      return;
    } else if (dock) {
      dock.style.display = '';
    }

    const searchBtn = document.getElementById('dock-search-btn');

    searchBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('cm:open-search'));
    });
  }

  initMobileDock();
  document.addEventListener('astro:page-load', initMobileDock);
</script>
