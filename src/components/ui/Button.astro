---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'destructive';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  disabled?: boolean;
  isCopyButton?: boolean;
  copyText?: string;
  class?: string;
  id?: string;
  'aria-label'?: string;
  'aria-pressed'?: boolean | 'true' | 'false';
  'aria-expanded'?: boolean | 'true' | 'false';
  'aria-controls'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  href,
  disabled = false,
  isCopyButton = false,
  copyText,
  class: className = '',
  id,
  'aria-label': ariaLabel,
  'aria-pressed': ariaPressed,
  'aria-expanded': ariaExpanded,
  'aria-controls': ariaControls,
  ...rest
} = Astro.props;

// Section 5: Heights 32/40/48px. Radius 8px (controls).
const sizeClasses = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-5 text-[15px]',
};

// Section 5:
// Primary: #176B5B, white text, hover #135A4D, pressed #0E443A
// Secondary: white, 1px border #D8DDD9, text #171A18, hover bg #F7F7F4
// Ghost: no border, accent text #176B5B, hover bg #EEF0EE
// Destructive-subtle: #FEF3F2 / #B42318, border #FECDCA, hover #FEE4E2
const variantClasses = {
  primary: 'bg-accent text-surface border border-accent hover:bg-accent-hover active:bg-accent-pressed disabled:bg-disabled-bg disabled:text-disabled-text disabled:border-border',
  secondary: 'bg-surface text-text-primary border border-border hover:bg-canvas active:bg-disabled-bg disabled:bg-disabled-bg disabled:text-disabled-text disabled:border-border',
  ghost: 'bg-transparent text-accent border border-transparent hover:bg-disabled-bg active:bg-canvas disabled:text-disabled-text disabled:bg-transparent',
  destructive: 'bg-error-bg text-error-text border border-error-border hover:bg-error-hover active:bg-error-border disabled:bg-disabled-bg disabled:text-disabled-text disabled:border-border',
};

// Section 3 & 4: Focus = outline only: 2px solid #176B5B, offset 2px, on :focus-visible. No box-shadow. 120ms transition.
const baseClasses = 'inline-flex items-center justify-center font-medium rounded-control select-none cursor-pointer transition-standard disabled:cursor-not-allowed text-center';

const combinedClasses = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`.trim();
---

{
  href && !disabled ? (
    <a
      href={href}
      class={combinedClasses}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={combinedClasses}
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-pressed={ariaPressed}
      aria-expanded={ariaExpanded}
      aria-controls={ariaControls}
      data-copy-button={isCopyButton ? 'true' : undefined}
      data-copy-text={copyText}
      {...rest}
    >
      <span class="btn-label inline-flex items-center gap-2">
        <slot />
      </span>
      {isCopyButton && (
        <span class="btn-copied-label hidden items-center gap-1.5 text-accent font-semibold" aria-hidden="true">
          <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Copied!
        </span>
      )}
    </button>
  )
}

{isCopyButton && (
  <script>
    document.querySelectorAll('button[data-copy-button="true"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-copy-text') || btn.innerText;
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(textToCopy);
          }
          const label = btn.querySelector('.btn-label');
          const copied = btn.querySelector('.btn-copied-label');
          if (label && copied) {
            label.classList.add('hidden');
            copied.classList.remove('hidden');
            copied.classList.add('inline-flex');
            setTimeout(() => {
              label.classList.remove('hidden');
              copied.classList.add('hidden');
              copied.classList.remove('inline-flex');
            }, 2000);
          }
        } catch (e) {
          console.error('Failed to copy', e);
        }
      });
    });
  </script>
)}
