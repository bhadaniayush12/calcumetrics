---
// src/components/ui/SearchModal.astro
// Global Command Palette / Search Modal (Section 26.4 & 26.6)
import { getPublishedTools } from '../../config/site';

const tools = getPublishedTools();
const categories = ['All', 'Investments', 'Loans', 'Taxes', 'Business', 'Corporate Finance'] as const;
---

<div
  id="search-palette-backdrop"
  class="fixed inset-0 bg-black/60 z-[100] items-start justify-center p-3 sm:p-6 md:pt-20 overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Search Calculators"
>
  <div
    id="search-palette-container"
    class="bg-surface border border-border rounded-card w-full max-w-xl overflow-hidden my-auto sm:my-0 transition-standard"
  >
    <!-- Search Input Bar -->
    <div class="p-3.5 border-b border-border flex items-center gap-3">
      <!-- Search Icon -->
      <svg class="w-5 h-5 text-text-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>

      <input
        type="search"
        id="search-palette-input"
        placeholder="Search 24+ calculators (e.g. SIP, EMI, GST, NPV)..."
        autocomplete="off"
        spellcheck="false"
        class="w-full bg-transparent border-none text-[15px] text-text-primary placeholder:text-text-muted focus:outline-none"
        aria-label="Search all calculators"
      />

      <!-- Clear Query Button (hidden by default) -->
      <button
        type="button"
        id="search-palette-clear"
        class="hidden text-text-muted hover:text-text-primary p-1 rounded transition-standard cursor-pointer"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>

      <!-- ESC pill -->
      <kbd class="hidden sm:inline-block text-[11px] font-medium text-text-muted bg-canvas border border-border px-1.5 py-0.5 rounded select-none">
        ESC
      </kbd>

      <!-- Mobile Close Button -->
      <button
        type="button"
        id="search-palette-close-btn"
        class="sm:hidden text-text-muted hover:text-text-primary p-1 rounded transition-standard cursor-pointer"
        aria-label="Close search modal"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Category filter chips strip -->
    <div class="px-3 py-2 border-b border-border bg-canvas flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar">
      {categories.map((cat) => (
        <button
          type="button"
          data-filter-category={cat}
          class:list={[
            'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer',
            cat === 'All'
              ? 'bg-accent text-surface'
              : 'text-text-muted hover:text-text-primary hover:bg-surface border border-transparent',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Results List -->
    <div
      id="search-palette-results"
      role="listbox"
      aria-label="Calculators search results"
      class="max-h-[380px] overflow-y-auto divide-y divide-border p-1"
    >
      {tools.map((tool, idx) => (
        <a
          href={tool.path}
          role="option"
          data-search-item
          data-tool-name={tool.name.toLowerCase()}
          data-tool-category={tool.category}
          data-tool-desc={tool.description.toLowerCase()}
          data-tool-slug={tool.slug.toLowerCase()}
          data-tool-region={tool.region}
          class:list={[
            'search-result-item flex items-start justify-between gap-3 p-3 rounded-control text-text-primary hover:bg-canvas transition-standard group focus-visible:outline-accent cursor-pointer',
            idx === 0 ? 'bg-canvas' : '',
          ]}
        >
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <span class="font-semibold text-sm group-hover:text-accent transition-standard">
                {tool.name}
              </span>
              <span class="text-[11px] font-medium px-1.5 py-0.5 rounded-chip bg-surface border border-border text-text-muted">
                {tool.category}
              </span>
              {tool.region !== 'Global' && (
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-chip bg-disabled-bg text-text-muted">
                  {tool.region}
                </span>
              )}
            </div>
            <p class="text-xs text-text-muted line-clamp-1">
              {tool.description}
            </p>
          </div>

          <svg class="w-4 h-4 text-text-muted group-hover:text-accent group-hover:translate-x-0.5 transition-standard shrink-0 mt-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 12L10 8L6 4" />
          </svg>
        </a>
      ))}

      <!-- Empty State Container -->
      <div id="search-palette-empty" class="hidden p-8 text-center flex-col items-center justify-center">
        <svg class="w-8 h-8 text-text-muted mb-2 stroke-current fill-none opacity-50" viewBox="0 0 24 24" stroke-width="1.5">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <p class="text-sm font-semibold text-text-primary mb-1">No matching calculators</p>
        <p class="text-xs text-text-muted max-w-xs">
          Try searching for general terms like <button type="button" class="underline hover:text-accent" data-quick-fill="loan">loan</button>, <button type="button" class="underline hover:text-accent" data-quick-fill="tax">tax</button>, <button type="button" class="underline hover:text-accent" data-quick-fill="investment">investment</button>, or <button type="button" class="underline hover:text-accent" data-quick-fill="SIP">SIP</button>.
        </p>
      </div>
    </div>

    <!-- Modal Footer with Keyboard Navigation hints -->
    <div class="px-4 py-2.5 bg-canvas border-t border-border flex items-center justify-between text-[11px] text-text-muted select-none">
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex items-center gap-1">
          <kbd class="px-1 py-0.5 rounded border border-border bg-surface font-mono">↑</kbd>
          <kbd class="px-1 py-0.5 rounded border border-border bg-surface font-mono">↓</kbd>
          Navigate
        </span>
        <span class="hidden sm:inline-flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded border border-border bg-surface font-mono">↵</kbd>
          Select
        </span>
        <span class="sm:hidden">Tap any tool to open</span>
      </div>
      <div id="search-palette-count" class="font-medium text-text-primary">
        {tools.length} calculators
      </div>
    </div>
  </div>
</div>

<script>
  function initSearchPalette() {
    const backdrop = document.getElementById('search-palette-backdrop');
    const container = document.getElementById('search-palette-container');
    const input = document.getElementById('search-palette-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-palette-clear');
    const closeBtn = document.getElementById('search-palette-close-btn');
    const emptyState = document.getElementById('search-palette-empty');
    const countEl = document.getElementById('search-palette-count');
    const resultsContainer = document.getElementById('search-palette-results');
    const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-search-item]'));
    const categoryBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-category]'));
    const quickFills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-fill]'));

    if (!backdrop || !input) return;

    let activeCategory = 'All';
    let selectedIndex = 0;
    let lastActiveElement: HTMLElement | null = null;

    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement | null;
      backdrop?.classList.remove('hidden');
      backdrop?.classList.add('flex');
      document.body.style.overflow = 'hidden';
      input?.focus();
      if (input) input.value = '';
      clearBtn?.classList.add('hidden');
      activeCategory = 'All';
      updateCategoryButtons();
      filterResults();
    }

    function closeModal() {
      backdrop?.classList.add('hidden');
      backdrop?.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    function updateCategoryButtons() {
      categoryBtns.forEach((btn) => {
        const cat = btn.getAttribute('data-filter-category');
        if (cat === activeCategory) {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer bg-accent text-surface';
        } else {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer text-text-muted hover:text-text-primary hover:bg-surface border border-transparent';
        }
      });
    }

    function getVisibleItems(): HTMLAnchorElement[] {
      return items.filter((el) => !el.classList.contains('hidden'));
    }

    function highlightSelected(visible: HTMLAnchorElement[]) {
      visible.forEach((el, i) => {
        if (i === selectedIndex) {
          el.classList.add('bg-canvas');
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-canvas');
          el.removeAttribute('aria-selected');
        }
      });
    }

    function filterResults() {
      const q = (input?.value || '').toLowerCase().trim();
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', q.length === 0);
      }

      let visibleCount = 0;

      items.forEach((item) => {
        const name = item.getAttribute('data-tool-name') || '';
        const cat = item.getAttribute('data-tool-category') || '';
        const desc = item.getAttribute('data-tool-desc') || '';
        const slug = item.getAttribute('data-tool-slug') || '';
        const region = item.getAttribute('data-tool-region') || '';

        const matchesCat = activeCategory === 'All' || cat.toLowerCase() === activeCategory.toLowerCase();
        const matchesQuery =
          !q ||
          name.includes(q) ||
          cat.toLowerCase().includes(q) ||
          desc.includes(q) ||
          slug.includes(q) ||
          region.toLowerCase().includes(q);

        if (matchesCat && matchesQuery) {
          item.classList.remove('hidden');
          item.classList.add('flex');
          visibleCount++;
        } else {
          item.classList.add('hidden');
          item.classList.remove('flex');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
        emptyState.classList.toggle('flex', visibleCount === 0);
      }

      if (countEl) {
        countEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'calculator' : 'calculators'}`;
      }

      const visible = getVisibleItems();
      selectedIndex = 0;
      highlightSelected(visible);
    }

    // Event listeners
    input.addEventListener('input', filterResults);

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
        filterResults();
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    quickFills.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-quick-fill') || '';
        if (input) {
          input.value = val;
          input.focus();
          filterResults();
        }
      });
    });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-filter-category') || 'All';
        updateCategoryButtons();
        filterResults();
        input?.focus();
      });
    });

    // Keyboard navigation inside modal
    input.addEventListener('keydown', (e) => {
      const visible = getVisibleItems();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (visible.length > 0) {
          selectedIndex = (selectedIndex + 1) % visible.length;
          highlightSelected(visible);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (visible.length > 0) {
          selectedIndex = (selectedIndex - 1 + visible.length) % visible.length;
          highlightSelected(visible);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (visible[selectedIndex]) {
          visible[selectedIndex].click();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    // Click outside container to close
    backdrop.addEventListener('click', (e) => {
      if (container && !container.contains(e.target as Node)) {
        closeModal();
      }
    });

    // Global keyboard shortcut: '/' or 'Cmd+K' / 'Ctrl+K'
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const isInput =
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable;

      if ((e.key === '/' && !isInput) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        openModal();
      } else if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Custom window events to open from anywhere
    window.addEventListener('cm:open-search', openModal);
    window.addEventListener('open-search-modal', openModal);
  }

  initSearchPalette();
  document.addEventListener('astro:page-load', initSearchPalette);
</script>
