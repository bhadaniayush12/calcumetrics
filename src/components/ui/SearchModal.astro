---
// src/components/ui/SearchModal.astro
// macOS-Style Spotlight Search Modal (⌘K / Ctrl+K)
import { getPublishedTools } from '../../config/site';

const tools = getPublishedTools();
const categories = ['All', 'Investments', 'Loans', 'Taxes', 'Business', 'Corporate Finance'] as const;

const popularSearches = [
  'SIP Calculator',
  'GST Calculator',
  'Income Tax Calculator',
  'NPV Calculator',
  'WACC Calculator',
  'Break-Even Calculator',
] as const;
---

<!-- macOS Spotlight Center Overlay -->
<div
  id="search-palette-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden items-start justify-center pt-[8vh] sm:pt-[12vh] px-3 sm:px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Spotlight Search"
>
  <!-- Floating Spotlight Window -->
  <div
    id="search-palette-container"
    class="w-full max-w-[640px] bg-surface border border-border rounded-card shadow-mac flex flex-col max-h-[80vh] overflow-hidden animate-in fade-in zoom-in-95 duration-150"
  >
    <!-- Spotlight Search Bar -->
    <div class="px-4 py-3.5 border-b border-border flex items-center gap-3 bg-surface">
      <!-- Search Icon -->
      <svg
        class="w-5 h-5 text-accent shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>

      <input
        type="search"
        id="search-palette-input"
        placeholder={`Search ${tools.length} calculators (e.g. SIP, EMI, GST, NPV)...`}
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent border-none text-[17px] text-text-primary placeholder:text-text-muted focus:outline-none min-w-0"
        aria-label="Search all calculators"
      />

      <!-- Clear Query Button (hidden by default) -->
      <button
        type="button"
        id="search-palette-clear"
        class="hidden text-text-muted hover:text-text-primary p-1 rounded-control transition-standard cursor-pointer shrink-0"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>

      <!-- macOS Shortcut Badge -->
      <div class="hidden sm:flex items-center gap-1 text-[11px] font-medium text-text-muted bg-canvas border border-border px-1.5 py-0.5 rounded-chip select-none shrink-0">
        <kbd>ESC</kbd>
      </div>

      <!-- Mobile Close Button -->
      <button
        type="button"
        id="search-palette-close-btn"
        class="sm:hidden text-text-muted hover:text-text-primary p-1 rounded-control transition-standard cursor-pointer shrink-0"
        aria-label="Close search"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Category filter chips strip -->
    <div class="px-3 py-2 border-b border-border bg-canvas/60 flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs">
      {categories.map((cat) => (
        <button
          type="button"
          data-filter-category={cat}
          class:list={[
            'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer',
            cat === 'All'
              ? 'bg-accent text-surface'
              : 'text-text-muted hover:text-text-primary hover:bg-surface border border-transparent',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Scrollable results panel -->
    <div class="flex-1 overflow-y-auto divide-y divide-border">
      <!-- Recent Searches (rendered from localStorage) -->
      <div id="search-palette-recent-wrapper" class="hidden divide-y divide-border bg-surface">
        <div class="px-4 pt-3 pb-1 flex items-center justify-between">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-text-muted select-none flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            Recently Used
          </span>
          <button
            type="button"
            id="clear-recent-tools-btn"
            class="text-[11px] text-text-muted hover:text-accent font-medium cursor-pointer transition-standard"
          >
            Clear
          </button>
        </div>
        <div id="search-palette-recent-list" class="divide-y divide-border"></div>
      </div>

      <!-- Popular Searches (shown when input is empty) -->
      <div
        id="search-palette-popular"
        role="listbox"
        aria-label="Popular searches"
        class="divide-y divide-border"
      >
        <div class="px-4 pt-3 pb-1">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-text-muted select-none">
            Popular Calculations
          </span>
        </div>
        {popularSearches.map((name) => (
          <button
            type="button"
            data-popular-search={name}
            class="popular-search-item w-full flex items-center gap-3 px-4 py-2.5 text-text-primary hover:bg-canvas transition-standard cursor-pointer focus-visible:outline-accent text-left"
          >
            <svg
              class="w-4 h-4 text-text-muted shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span class="flex-1 text-sm font-medium">{name}</span>
            <svg
              class="w-3.5 h-3.5 text-text-muted shrink-0"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 12L10 8L6 4" />
            </svg>
          </button>
        ))}
      </div>

      <!-- Results List -->
      <div
        id="search-palette-results"
        role="listbox"
        aria-label="Calculators search results"
        class="hidden divide-y divide-border"
      >
        {tools.map((tool) => (
          <a
            href={tool.path}
            role="option"
            data-search-item
            data-tool-name={tool.name.toLowerCase()}
            data-tool-category={tool.category}
            data-tool-desc={tool.description.toLowerCase()}
            data-tool-slug={tool.slug}
            data-tool-region={tool.region}
            class="search-result-item flex items-center justify-between px-4 py-3 text-text-primary hover:bg-canvas transition-standard focus-visible:outline-accent cursor-pointer group"
          >
            <div class="flex-1 min-w-0 pr-4">
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-text-primary group-hover:text-accent transition-standard">
                  {tool.name}
                </span>
                <span class="text-[11px] font-normal text-text-muted bg-canvas border border-border px-1.5 py-0.5 rounded-chip shrink-0">
                  {tool.category}
                </span>
                {tool.region === 'IN' && (
                  <span class="text-[11px] text-amber-700 dark:text-amber-400 font-medium">🇮🇳</span>
                )}
                {tool.region === 'US' && (
                  <span class="text-[11px] text-sky-700 dark:text-sky-400 font-medium">🇺🇸</span>
                )}
              </div>
              <p class="text-xs text-text-muted truncate mt-0.5">
                {tool.description}
              </p>
            </div>
            <div class="text-text-muted group-hover:text-accent shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 12L10 8L6 4" />
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div
        id="search-palette-empty"
        class="hidden flex-col items-center justify-center p-8 text-center"
      >
        <div class="w-10 h-10 rounded-full bg-canvas flex items-center justify-center text-text-muted mb-2">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-text-primary">No calculators match your search</p>
        <p class="text-xs text-text-muted mt-1 max-w-xs">
          Try searching for a related term like "loan", "tax", "SIP", or browse categories above.
        </p>
        <div class="flex items-center gap-2 mt-4 flex-wrap justify-center">
          <button
            type="button"
            data-quick-fill="SIP"
            class="search-quick-fill text-xs bg-canvas hover:bg-surface border border-border px-2.5 py-1 rounded-chip text-text-muted hover:text-accent transition-standard cursor-pointer"
          >
            Try "SIP"
          </button>
          <button
            type="button"
            data-quick-fill="EMI"
            class="search-quick-fill text-xs bg-canvas hover:bg-surface border border-border px-2.5 py-1 rounded-chip text-text-muted hover:text-accent transition-standard cursor-pointer"
          >
            Try "EMI"
          </button>
          <button
            type="button"
            data-quick-fill="GST"
            class="search-quick-fill text-xs bg-canvas hover:bg-surface border border-border px-2.5 py-1 rounded-chip text-text-muted hover:text-accent transition-standard cursor-pointer"
          >
            Try "GST"
          </button>
        </div>
      </div>
    </div>

    <!-- Spotlight Footer (Keyboard shortcuts & Results count) -->
    <div class="px-4 py-2 bg-canvas/80 border-t border-border flex items-center justify-between text-[11px] text-text-muted select-none">
      <div class="hidden sm:flex items-center gap-3">
        <span class="flex items-center gap-1">
          <kbd class="px-1 py-0.5 bg-surface border border-border rounded text-[10px]">↑</kbd>
          <kbd class="px-1 py-0.5 bg-surface border border-border rounded text-[10px]">↓</kbd>
          Navigate
        </span>
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 bg-surface border border-border rounded text-[10px]">↵</kbd>
          Open
        </span>
        <span class="flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 bg-surface border border-border rounded text-[10px]">ESC</kbd>
          Dismiss
        </span>
      </div>
      <div id="search-palette-count" class="font-medium">
        {tools.length} calculators
      </div>
    </div>
  </div>
</div>

<script>
  function initSearchPalette() {
    const backdrop = document.getElementById('search-palette-backdrop');
    if (!backdrop) return;

    const input = document.getElementById('search-palette-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-palette-clear');
    const closeBtn = document.getElementById('search-palette-close-btn');
    const popularContainer = document.getElementById('search-palette-popular');
    const resultsContainer = document.getElementById('search-palette-results');
    const emptyState = document.getElementById('search-palette-empty');
    const countEl = document.getElementById('search-palette-count');
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.search-category-btn');
    const popularBtns = document.querySelectorAll<HTMLButtonElement>('.popular-search-item');
    const quickFills = document.querySelectorAll<HTMLButtonElement>('.search-quick-fill');
    const recentWrapper = document.getElementById('search-palette-recent-wrapper');
    const recentList = document.getElementById('search-palette-recent-list');
    const clearRecentBtn = document.getElementById('clear-recent-tools-btn');

    const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-search-item]'));

    let activeCategory = 'All';
    let selectedIndex = 0;
    let lastActiveElement: HTMLElement | null = null;

    function renderRecentTools() {
      if (!recentWrapper || !recentList) return;
      try {
        const raw = localStorage.getItem('cm_recent_tools');
        const recents: Array<{ name: string; path: string; category?: string }> = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(recents) || recents.length === 0) {
          recentWrapper.classList.add('hidden');
          recentList.innerHTML = '';
          return;
        }

        recentWrapper.classList.remove('hidden');
        recentList.innerHTML = recents.slice(0, 4).map((tool) => `
          <a
            href="${tool.path}"
            class="flex items-center justify-between px-4 py-2.5 text-text-primary hover:bg-canvas transition-standard cursor-pointer group"
          >
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span class="text-sm font-medium group-hover:text-accent">${tool.name}</span>
              ${tool.category ? `<span class="text-[10px] text-text-muted bg-canvas border border-border px-1 py-0.5 rounded">${tool.category}</span>` : ''}
            </div>
            <span class="text-xs text-accent font-medium">Open &rarr;</span>
          </a>
        `).join('');
      } catch (e) {
        recentWrapper.classList.add('hidden');
      }
    }

    clearRecentBtn?.addEventListener('click', () => {
      try {
        localStorage.removeItem('cm_recent_tools');
      } catch (e) {}
      renderRecentTools();
    });

    function openModal() {
      lastActiveElement = document.activeElement as HTMLElement | null;
      backdrop?.classList.remove('hidden');
      backdrop?.classList.add('flex');
      document.body.style.overflow = 'hidden';
      renderRecentTools();
      if (input) {
        input.value = '';
        input.focus();
      }
      filterResults();
    }

    function closeModal() {
      backdrop?.classList.add('hidden');
      backdrop?.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    function showPopular() {
      if (popularContainer) {
        popularContainer.classList.remove('hidden');
      }
      if (recentWrapper) {
        renderRecentTools();
      }
      if (resultsContainer) {
        resultsContainer.classList.add('hidden');
      }
      if (countEl) {
        countEl.textContent = `${items.length} calculators`;
      }
    }

    function showResults() {
      if (popularContainer) {
        popularContainer.classList.add('hidden');
      }
      if (recentWrapper) {
        recentWrapper.classList.add('hidden');
      }
      if (resultsContainer) {
        resultsContainer.classList.remove('hidden');
      }
    }

    function updateCategoryButtons() {
      categoryBtns.forEach((btn) => {
        const cat = btn.getAttribute('data-filter-category');
        if (cat === activeCategory) {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer bg-accent text-surface';
        } else {
          btn.className = 'search-category-btn px-2.5 py-1 rounded-chip font-medium whitespace-nowrap transition-standard cursor-pointer text-text-muted hover:text-text-primary hover:bg-surface border border-transparent';
        }
      });
    }

    function getVisibleItems(): HTMLAnchorElement[] {
      return items.filter((el) => !el.classList.contains('hidden'));
    }

    function highlightSelected(visible: HTMLAnchorElement[]) {
      visible.forEach((el, i) => {
        if (i === selectedIndex) {
          el.classList.add('bg-canvas');
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-canvas');
          el.removeAttribute('aria-selected');
        }
      });
    }

    function filterResults() {
      const q = (input?.value || '').toLowerCase().trim();
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', q.length === 0);
      }

      if (q.length === 0) {
        showPopular();
        return;
      }

      showResults();

      let visibleCount = 0;

      items.forEach((item) => {
        const name = item.getAttribute('data-tool-name') || '';
        const cat = item.getAttribute('data-tool-category') || '';
        const desc = item.getAttribute('data-tool-desc') || '';
        const slug = item.getAttribute('data-tool-slug') || '';
        const region = item.getAttribute('data-tool-region') || '';

        const matchesCat = activeCategory === 'All' || cat.toLowerCase() === activeCategory.toLowerCase();
        const matchesQuery =
          !q ||
          name.includes(q) ||
          cat.toLowerCase().includes(q) ||
          desc.includes(q) ||
          slug.includes(q) ||
          region.toLowerCase().includes(q);

        if (matchesCat && matchesQuery) {
          item.classList.remove('hidden');
          item.classList.add('flex');
          visibleCount++;
        } else {
          item.classList.add('hidden');
          item.classList.remove('flex');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
        emptyState.classList.toggle('flex', visibleCount === 0);
      }

      if (countEl) {
        countEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'calculator' : 'calculators'}`;
      }

      const visible = getVisibleItems();
      selectedIndex = 0;
      highlightSelected(visible);
    }

    input?.addEventListener('input', filterResults);

    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
        filterResults();
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    popularBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-popular-search') || '';
        if (input) {
          input.value = val;
          input.focus();
          filterResults();
        }
      });
    });

    quickFills.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-quick-fill') || '';
        if (input) {
          input.value = val;
          input.focus();
          filterResults();
        }
      });
    });

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-filter-category') || 'All';
        updateCategoryButtons();
        filterResults();
        input?.focus();
      });
    });

    input?.addEventListener('keydown', (e) => {
      const visible = getVisibleItems();
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (visible.length > 0) {
          selectedIndex = (selectedIndex + 1) % visible.length;
          highlightSelected(visible);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (visible.length > 0) {
          selectedIndex = (selectedIndex - 1 + visible.length) % visible.length;
          highlightSelected(visible);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (visible[selectedIndex]) {
          visible[selectedIndex].click();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      }
    });

    backdrop.addEventListener('click', (e) => {
      const container = document.getElementById('search-palette-container');
      if (container && !container.contains(e.target as Node)) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const isInput =
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable;

      if ((e.key === '/' && !isInput) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        openModal();
      } else if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });

    window.addEventListener('cm:open-search', openModal);
    window.addEventListener('open-search-modal', openModal);
  }

  initSearchPalette();
  document.addEventListener('astro:page-load', initSearchPalette);
</script>
