---
/**
 * AdSlot.astro — Section 9 & 21 (Handoff v2)
 *
 * Reserved ad container.
 * - Always reserves the correct height so CLS stays at 0 when ads load/unload.
 * - Shows the "Advertisement" label per Google AdSense placement policy §2.
 * - Renders the actual <ins> tag only when ADS_ENABLED=true AND an adSlotId is provided.
 * - When ADS_ENABLED=false, the slot is visually invisible (no borders/labels shown)
 *   but the reserved space is still maintained to avoid CLS when ads go live.
 * - NEVER adjacent to Calculate, login, or navigation elements (enforced by callers).
 * - Mobile format: 250px tall rectangle. Desktop: 90px leaderboard.
 * - Min 24px gap from any input/button — enforced in calling layout/page.
 *
 * Usage:
 *   <AdSlot format="leaderboard" adSlotId="1234567890" />      ← desktop above-fold
 *   <AdSlot format="rectangle"   adSlotId="0987654321" />      ← mobile / below-fold
 *
 * AdSlotId = the 10-digit data-ad-slot value from the AdSense dashboard.
 * Leave adSlotId empty (or omit) during development / before approval.
 */

import { ADS_ENABLED } from '../../config/site';

interface Props {
  /** 'leaderboard' = 728×90 (desktop) / 320×50-100 (mobile); 'rectangle' = 300×250; 'mobile-banner' = 320×50 */
  format?: 'leaderboard' | 'rectangle' | 'mobile-banner';
  /** AdSense data-ad-slot ID — required to show a live ad */
  adSlotId?: string;
  /** Extra wrapper classes if needed for spacing */
  class?: string;
}

const {
  format = 'leaderboard',
  adSlotId,
  class: extraClass = '',
} = Astro.props;

// Strictly reserved dimensions to prevent any Cumulative Layout Shift (CLS = 0)
const minHeight = format === 'rectangle' ? '250px' : format === 'mobile-banner' ? '50px' : '90px';
const maxWidth = format === 'rectangle' ? '336px' : '728px';
const shouldShowAd = ADS_ENABLED && !!adSlotId;
---

{shouldShowAd ? (
  <div
    class={`ad-slot-wrapper relative w-full mx-auto my-6 overflow-hidden ${extraClass}`}
    style={`min-height: ${minHeight}; max-width: ${maxWidth}; contain: layout size;`}
    data-ad-format={format}
  >
    {/* Standard Google AdSense "Advertisement" compliance label */}
    <div class="flex items-center justify-center gap-1.5 mb-1.5 select-none" aria-hidden="true">
      <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
      <p class="text-[10px] font-semibold text-text-muted uppercase tracking-wider text-center">
        Advertisement
      </p>
      <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
    </div>

    {/* Strict zero-shift container */}
    <div
      class="w-full bg-canvas border border-border/70 rounded-card flex items-center justify-center relative overflow-hidden transition-standard"
      style={`height: calc(${minHeight} - 20px); min-height: calc(${minHeight} - 20px);`}
    >
      {/* Skeleton shimmer layer while ad asset finishes painting */}
      <div class="absolute inset-0 skeleton-shimmer opacity-40 pointer-events-none" aria-hidden="true"></div>
      <ins
        class="adsbygoogle relative z-10"
        style="display:block; width:100%; height:100%;"
        data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
        data-ad-slot={adSlotId}
        data-ad-format={format === 'leaderboard' ? 'horizontal' : 'rectangle'}
        data-full-width-responsive="true"
      ></ins>
    </div>
  </div>
) : (
  /* When ads are disabled: invisible reserved space (no borders, no labels, no shimmer)
     The height is preserved to guarantee CLS = 0 when AdSense goes live in the future. */
  <div
    class={`ad-slot-reserved ${extraClass}`}
    style={`min-height: ${minHeight}; max-width: ${maxWidth}; width: 100%; margin: 0 auto; display: block; visibility: hidden; pointer-events: none; aria-hidden: true;`}
    aria-hidden="true"
    data-ad-format={format}
    data-ad-pending="true"
  ></div>
)}

{shouldShowAd && (
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
)}
