---
import { getPublishedTools, getToolCount, SHOW_BLOG_NAV, SHOW_LANGUAGE } from '../config/site';
import SearchModal from './ui/SearchModal.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Dynamic category links — counts come from the published tool registry
const allTools = getPublishedTools();
const toolCategories = [
  { label: 'Investments', href: '/investments', count: String(allTools.filter(t => t.category === 'Investments').length) },
  { label: 'Loans', href: '/loans', count: String(allTools.filter(t => t.category === 'Loans').length) },
  { label: 'Taxes', href: '/taxes', count: String(allTools.filter(t => t.category === 'Taxes').length) },
  { label: 'Business', href: '/business', count: String(allTools.filter(t => t.category === 'Business').length) },
  { label: 'Corporate Finance', href: '/corporate-finance', count: String(allTools.filter(t => t.category === 'Corporate Finance').length) },
];

const totalToolsCount = getToolCount();
---

<header class="w-full bg-canvas border-b border-border sticky top-0 z-50 select-none">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Block 1: BrandIdentity (Left) -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 group focus-visible:outline-accent rounded-control py-1">
        <img
          src="/logo.svg"
          alt="Calcumetrics Logo"
          width="32"
          height="32"
          class="w-8 h-8 rounded-control shrink-0 transition-standard"
        />
        <span class="text-[17px] font-bold tracking-[-0.015em] text-text-primary group-hover:text-accent transition-standard">
          Calcumetrics
        </span>
      </a>
    </div>

    <!-- Block 2: Center-left nav (Home | Tools dropdown | Blog | About) -->
    <nav class="hidden lg:flex items-center gap-1 sm:gap-2 md:gap-6 text-[14px] font-medium text-text-primary" aria-label="Main Navigation">
      <!-- Home -->
      <a
        href="/"
        class:list={[
          'px-2.5 py-1.5 rounded-control transition-standard focus-visible:outline-accent',
          currentPath === '/' ? 'text-accent font-semibold' : 'hover:text-accent',
        ]}
      >
        <span data-i18n="nav-home">Home</span>
      </a>

      <!-- Tools with dropdown chevron -->
      <div class="relative" data-nav-dropdown>
        <button
          type="button"
          id="tools-menu-button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="tools-menu-dropdown"
          class="group px-2.5 py-1.5 rounded-control flex items-center gap-1.5 text-text-primary hover:text-accent transition-standard focus-visible:outline-accent cursor-pointer"
        >
          <span data-i18n="nav-tools">Tools</span>
          <!-- 1.5px stroke chevron -->
          <svg
            class="w-3.5 h-3.5 text-text-muted group-hover:text-accent transition-standard"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6L8 10L12 6" />
          </svg>
        </button>

        <!-- Tools Dropdown Menu (Strictly flat, 1px border, 8px radius, no shadow, no blur) -->
        <div
          id="tools-menu-dropdown"
          role="menu"
          aria-labelledby="tools-menu-button"
          class="hidden absolute left-0 top-full mt-1.5 w-60 bg-surface border border-border rounded-control p-1.5 z-50 flex-col transition-standard"
        >
          {toolCategories.map((cat) => (
            <a
              href={cat.href}
              role="menuitem"
              class="flex items-center justify-between px-3 py-2 text-[13px] rounded font-medium text-text-primary hover:bg-canvas hover:text-accent transition-standard focus-visible:outline-accent"
            >
              <span>{cat.label}</span>
              <span class="text-xs text-text-muted">{cat.count}</span>
            </a>
          ))}
          <div class="border-t border-border my-1"></div>
          <a
            href="/calculators"
            role="menuitem"
            class="flex items-center justify-between px-3 py-2 text-[13px] rounded font-semibold text-accent hover:bg-canvas transition-standard focus-visible:outline-accent"
          >
            <span data-i18n="nav-view-all">View All {totalToolsCount} Calculators</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Blog (rendered only when posts are published) -->
      {SHOW_BLOG_NAV && (
        <a
          href="/blog"
          class:list={[
            'px-2.5 py-1.5 rounded-control transition-standard focus-visible:outline-accent',
            currentPath.startsWith('/blog') ? 'text-accent font-semibold' : 'hover:text-accent',
          ]}
        >
          <span data-i18n="nav-blog">Blog</span>
        </a>
      )}

      <!-- About -->
      <a
        href="/about"
        class:list={[
          'px-2.5 py-1.5 rounded-control transition-standard focus-visible:outline-accent',
          currentPath.startsWith('/about') ? 'text-accent font-semibold' : 'hover:text-accent',
        ]}
      >
        <span data-i18n="nav-about">About</span>
      </a>
    </nav>

    <!-- Block 3: Right cluster (Search | ₹ INR | EN | Dark mode toggle) -->
    <div class="hidden lg:flex items-center gap-3 text-[13px] text-text-muted">
      <!-- Search Icon Button with keyboard shortcut hint -->
      <button
        type="button"
        id="header-search-btn"
        aria-label="Search calculators (press / or Ctrl+K)"
        title="Search (/ or ⌘K)"
        class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-control text-text-primary hover:text-accent hover:bg-surface border border-transparent transition-standard focus-visible:outline-accent cursor-pointer"
      >
        <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span class="text-[11px] text-text-muted font-mono hidden xl:inline">/</span>
      </button>

      <!-- Divider line subtle -->
      <div class="h-3.5 w-[1px] bg-border" aria-hidden="true"></div>

      <!-- Currency Selector: '₹ INR' -->
      <div class="relative" data-currency-dropdown>
        <button
          type="button"
          id="header-currency-btn"
          aria-label="Select display currency"
          aria-expanded="false"
          aria-haspopup="true"
          class="group flex items-center gap-1 text-text-primary hover:text-accent px-2 py-1.5 rounded-control transition-standard focus-visible:outline-accent font-medium text-[13px] cursor-pointer"
        >
          <span id="current-currency-label">₹ INR</span>
          <svg class="w-3 h-3 text-text-muted group-hover:text-accent transition-standard" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4.5L6 7.5L9 4.5" />
          </svg>
        </button>

        <div
          id="header-currency-menu"
          role="menu"
          aria-label="Display currency options"
          class="hidden absolute right-0 top-full mt-1 w-36 bg-surface border border-border rounded-control p-1 z-50 flex-col text-xs"
        >
          <button type="button" role="menuitem" data-currency-val="₹ INR" class="w-full text-left px-2.5 py-1.5 rounded bg-canvas text-accent font-semibold transition-standard flex items-center justify-between cursor-pointer">
            <span>₹ INR (India)</span>
            <span data-currency-check="₹ INR" class="text-accent font-bold">✓</span>
          </button>
          <button type="button" role="menuitem" data-currency-val="$ USD" class="w-full text-left px-2.5 py-1.5 rounded hover:bg-canvas hover:text-accent transition-standard text-text-primary font-medium flex items-center justify-between cursor-pointer">
            <span>$ USD (US)</span>
            <span data-currency-check="$ USD" class="text-accent font-bold hidden">✓</span>
          </button>
          <button type="button" role="menuitem" data-currency-val="€ EUR" class="w-full text-left px-2.5 py-1.5 rounded hover:bg-canvas hover:text-accent transition-standard text-text-primary font-medium flex items-center justify-between cursor-pointer">
            <span>€ EUR (Europe)</span>
            <span data-currency-check="€ EUR" class="text-accent font-bold hidden">✓</span>
          </button>
          <button type="button" role="menuitem" data-currency-val="£ GBP" class="w-full text-left px-2.5 py-1.5 rounded hover:bg-canvas hover:text-accent transition-standard text-text-primary font-medium flex items-center justify-between cursor-pointer">
            <span>£ GBP (UK)</span>
            <span data-currency-check="£ GBP" class="text-accent font-bold hidden">✓</span>
          </button>
        </div>
      </div>

      {SHOW_LANGUAGE && (
        <>
          <div class="relative" data-lang-dropdown>
            <button
              type="button"
              id="header-lang-btn"
              aria-label="Select Language"
              aria-expanded="false"
              aria-haspopup="true"
              class="group flex items-center gap-1 text-text-primary hover:text-accent px-2 py-1.5 rounded-control transition-standard focus-visible:outline-accent font-medium text-[13px] cursor-pointer"
            >
              <span id="current-lang-label">EN</span>
              <svg class="w-3 h-3 text-text-muted group-hover:text-accent transition-standard" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 4.5L6 7.5L9 4.5" />
              </svg>
            </button>

            <div
              id="header-lang-menu"
              class="hidden absolute right-0 top-full mt-1 w-36 bg-surface border border-border rounded-control p-1 z-50 flex-col text-xs"
            >
              <button type="button" data-lang-val="EN" class="w-full text-left px-2.5 py-1.5 rounded bg-canvas text-accent font-semibold flex items-center justify-between cursor-pointer">
                <span>EN (English)</span>
                <span data-lang-check="EN" class="text-accent font-bold">✓</span>
              </button>
              <button type="button" data-lang-val="HI" class="w-full text-left px-2.5 py-1.5 rounded hover:bg-canvas hover:text-accent transition-standard text-text-primary flex items-center justify-between cursor-pointer">
                <span>HI (हिन्दी)</span>
                <span data-lang-check="HI" class="text-accent font-bold hidden">✓</span>
              </button>
            </div>
          </div>
          <div class="h-3.5 w-[1px] bg-border" aria-hidden="true"></div>
        </>
      )}

      <!-- Divider line subtle (when no language selector) -->
      {!SHOW_LANGUAGE && (
        <div class="h-3.5 w-[1px] bg-border" aria-hidden="true"></div>
      )}

      <!-- Dark Mode Toggle -->
      <button
        type="button"
        id="theme-toggle-button"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="p-2 rounded-control text-text-primary hover:text-accent hover:bg-surface border border-transparent transition-standard focus-visible:outline-accent cursor-pointer"
      >
        <!-- Moon icon (for light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>

        <!-- Sun icon (for dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 stroke-current fill-none hidden" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
    </div>

    <!-- Mobile Header Right: Compact cluster + Menu Button -->
    <div class="flex lg:hidden items-center gap-1">
      <!-- Mobile Search Button -->
      <button
        type="button"
        id="mobile-search-btn"
        aria-label="Search calculators"
        class="w-10 h-10 flex items-center justify-center rounded-control text-text-primary hover:text-accent hover:bg-surface border border-transparent transition-standard focus-visible:outline-accent cursor-pointer"
      >
        <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>

      <!-- Dark mode toggle on mobile -->
      <button
        type="button"
        id="mobile-theme-toggle"
        aria-label="Toggle dark mode"
        class="w-10 h-10 flex items-center justify-center rounded-control text-text-primary hover:text-accent hover:bg-surface border border-transparent transition-standard focus-visible:outline-accent cursor-pointer"
      >
        <!-- Moon icon -->
        <svg id="mobile-theme-icon-moon" class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <!-- Sun icon -->
        <svg id="mobile-theme-icon-sun" class="w-4 h-4 stroke-current fill-none hidden" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>

      <!-- Mobile Menu Button: >=44px touch target -->
      <button
        type="button"
        id="mobile-menu-button"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Toggle navigation menu"
        class="w-11 h-11 flex items-center justify-center rounded-control text-text-primary hover:text-accent hover:bg-surface border border-transparent focus-visible:outline-accent transition-standard cursor-pointer"
      >
        <svg
          id="menu-icon-bars"
          class="w-5 h-5 stroke-current fill-none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>

        <svg
          id="menu-icon-close"
          class="w-5 h-5 stroke-current fill-none hidden"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Nav: Flat full-width panel (#FFFFFF bg, 1px #D8DDD9 border, 48px rows, no shadow, no blur) -->
  <div
    id="mobile-nav-panel"
    class="hidden w-full bg-surface border-b border-border flex-col transition-standard"
    aria-label="Mobile Navigation"
  >
    <div class="max-w-[1440px] mx-auto w-full">
      <a href="/" class="h-12 flex items-center px-6 text-[15px] font-medium border-b border-border text-text-primary hover:text-accent hover:bg-canvas transition-standard">
        <span data-i18n="nav-home">Home</span>
      </a>

      <!-- Tools accordion section in mobile -->
      <div class="border-b border-border">
        <button
          type="button"
          id="mobile-tools-toggle"
          aria-expanded="false"
          class="w-full h-12 flex items-center justify-between px-6 text-[15px] font-medium text-text-primary hover:text-accent hover:bg-canvas transition-standard cursor-pointer"
        >
          <span data-i18n="nav-tools">Tools</span>
          <svg id="mobile-tools-chevron" class="w-4 h-4 text-text-muted transition-standard" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6L8 10L12 6" />
          </svg>
        </button>

        <div id="mobile-tools-subpanel" class="hidden bg-canvas border-t border-border flex-col">
          {toolCategories.map((cat) => (
            <a href={cat.href} class="h-11 flex items-center justify-between px-8 text-sm text-text-primary hover:text-accent border-b border-border last:border-b-0 transition-standard">
              <span>{cat.label}</span>
              <span class="text-xs text-text-muted">{cat.count}</span>
            </a>
          ))}
          <a href="/calculators" class="h-11 flex items-center px-8 text-sm font-semibold text-accent hover:underline">
            <span data-i18n="nav-view-all">View All {totalToolsCount} Calculators &rarr;</span>
          </a>
        </div>
      </div>

      {SHOW_BLOG_NAV && (
        <a href="/blog" class="h-12 flex items-center px-6 text-[15px] font-medium border-b border-border text-text-primary hover:text-accent hover:bg-canvas transition-standard">
          <span data-i18n="nav-blog">Blog</span>
        </a>
      )}

      <a href="/about" class="h-12 flex items-center px-6 text-[15px] font-medium border-b border-border text-text-primary hover:text-accent hover:bg-canvas transition-standard">
        <span data-i18n="nav-about">About</span>
      </a>

      <!-- Mobile utility row: Currency & Language -->
      <div class="p-4 flex items-center justify-between text-xs text-text-muted bg-canvas">
        <div class="flex items-center gap-2">
          <span class="font-medium text-text-primary" data-i18n="nav-currency">Currency:</span>
          <select id="mobile-currency-select" aria-label="Select display currency" class="h-8 rounded border border-border bg-surface px-2 text-xs text-text-primary focus:outline-accent">
            <option value="₹ INR" selected>₹ INR</option>
            <option value="$ USD">$ USD</option>
            <option value="€ EUR">€ EUR</option>
            <option value="£ GBP">£ GBP</option>
          </select>
        </div>

        {SHOW_LANGUAGE && (
          <div class="flex items-center gap-2">
            <span class="font-medium text-text-primary" data-i18n="nav-lang">Lang:</span>
            <select id="mobile-lang-select" class="h-8 rounded border border-border bg-surface px-2 text-xs text-text-primary focus:outline-accent">
              <option value="EN" selected>EN</option>
              <option value="HI">HI</option>
            </select>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Command Palette / Search Modal Component -->
  <SearchModal />
</header>

<script>
  import { CURRENCY_CONFIG, normalizeCurrency } from '../lib/currency';

  function initHeaderScripts() {
    // ── 1. Desktop Tools dropdown ───────────────────────────────────────────
    const toolsBtn = document.getElementById('tools-menu-button');
    const toolsDropdown = document.getElementById('tools-menu-dropdown');

    if (toolsBtn && toolsDropdown && !toolsBtn.dataset.toolsBound) {
      toolsBtn.dataset.toolsBound = 'true';
      const toggleTools = (show?: boolean) => {
        const isShown = !toolsDropdown.classList.contains('hidden');
        const nextState = typeof show === 'boolean' ? show : !isShown;
        if (nextState) {
          toolsDropdown.classList.remove('hidden');
          toolsDropdown.classList.add('flex');
          toolsBtn.setAttribute('aria-expanded', 'true');
        } else {
          toolsDropdown.classList.add('hidden');
          toolsDropdown.classList.remove('flex');
          toolsBtn.setAttribute('aria-expanded', 'false');
        }
      };

      toolsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleTools();
      });

      document.addEventListener('click', (e) => {
        if (!toolsDropdown.contains(e.target as Node) && !toolsBtn.contains(e.target as Node)) {
          toggleTools(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !toolsDropdown.classList.contains('hidden')) {
          toggleTools(false);
          toolsBtn.focus();
        }
      });
    }

    // ── 2. Search Buttons (Desktop & Mobile) ─────────────────────────────────
    const searchBtn = document.getElementById('header-search-btn');
    const mobileSearchBtn = document.getElementById('mobile-search-btn');

    const triggerSearch = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      window.dispatchEvent(new CustomEvent('cm:open-search'));
    };

    if (searchBtn && !searchBtn.dataset.searchBound) {
      searchBtn.dataset.searchBound = 'true';
      searchBtn.addEventListener('click', triggerSearch);
    }
    if (mobileSearchBtn && !mobileSearchBtn.dataset.searchBound) {
      mobileSearchBtn.dataset.searchBound = 'true';
      mobileSearchBtn.addEventListener('click', triggerSearch);
    }

    // ── 3. Currency Selector with Persistence & Event Dispatch ──────────────
    const currencyBtn = document.getElementById('header-currency-btn');
    const currencyMenu = document.getElementById('header-currency-menu');
    const currencyLabel = document.getElementById('current-currency-label');
    const mobileCurrencySelect = document.getElementById('mobile-currency-select') as HTMLSelectElement | null;

    function applyCurrency(val: string, broadcast = true) {
      const code = normalizeCurrency(val);
      const config = CURRENCY_CONFIG[code];
      const normalizedLabel = config.label;

      if (currencyLabel) currencyLabel.textContent = normalizedLabel;
      if (mobileCurrencySelect) mobileCurrencySelect.value = normalizedLabel;

      currencyMenu?.querySelectorAll<HTMLElement>('[data-currency-check]').forEach((el) => {
        const checkVal = el.getAttribute('data-currency-check');
        el.classList.toggle('hidden', checkVal !== normalizedLabel);
      });

      currencyMenu?.querySelectorAll<HTMLElement>('[data-currency-val]').forEach((btn) => {
        const btnVal = btn.getAttribute('data-currency-val');
        if (btnVal === normalizedLabel) {
          btn.classList.add('bg-canvas', 'text-accent', 'font-semibold');
          btn.classList.remove('text-text-primary');
        } else {
          btn.classList.remove('bg-canvas', 'text-accent', 'font-semibold');
          btn.classList.add('text-text-primary');
        }
      });

      try {
        localStorage.setItem('cm_currency', normalizedLabel);
      } catch (e) {}

      if (broadcast) {
        const detail = { label: normalizedLabel, code: config.code, symbol: config.symbol, format: config.grouping };
        window.dispatchEvent(new CustomEvent('cm:currency-change', { detail }));
      }
    }

    // Restore saved currency safely with canonical fallback
    try {
      const savedCur = localStorage.getItem('cm_currency');
      if (savedCur) {
        const normalized = normalizeCurrency(savedCur);
        applyCurrency(CURRENCY_CONFIG[normalized].label, false);
      }
    } catch (e) {}

    if (currencyBtn && currencyMenu) {
      if (!currencyBtn.dataset.currencyBound) {
        currencyBtn.dataset.currencyBound = 'true';

        currencyBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpening = currencyMenu.classList.contains('hidden');
          currencyMenu.classList.toggle('hidden');
          currencyMenu.classList.toggle('flex');
          currencyBtn.setAttribute('aria-expanded', isOpening ? 'true' : 'false');
        });

        currencyMenu.querySelectorAll('[data-currency-val]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const val = btn.getAttribute('data-currency-val') || '₹ INR';
            applyCurrency(val, true);
            currencyMenu.classList.add('hidden');
            currencyMenu.classList.remove('flex');
            currencyBtn.setAttribute('aria-expanded', 'false');
            currencyBtn.focus();
          });
        });

        document.addEventListener('click', (e) => {
          if (!currencyMenu.contains(e.target as Node) && !currencyBtn.contains(e.target as Node)) {
            currencyMenu.classList.add('hidden');
            currencyMenu.classList.remove('flex');
            currencyBtn.setAttribute('aria-expanded', 'false');
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && currencyMenu.classList.contains('flex')) {
            currencyMenu.classList.add('hidden');
            currencyMenu.classList.remove('flex');
            currencyBtn.setAttribute('aria-expanded', 'false');
            currencyBtn.focus();
          }
        });
      }
    }

    if (mobileCurrencySelect && !mobileCurrencySelect.dataset.currencyBound) {
      mobileCurrencySelect.dataset.currencyBound = 'true';
      mobileCurrencySelect.addEventListener('change', () => {
        applyCurrency(mobileCurrencySelect.value, true);
      });
    }

    // ── 4. Language Selector with Persistence & Feedback ────────────────────
    const langBtn = document.getElementById('header-lang-btn');
    const langMenu = document.getElementById('header-lang-menu');
    const langLabel = document.getElementById('current-lang-label');
    const mobileLangSelect = document.getElementById('mobile-lang-select') as HTMLSelectElement | null;

    const I18N_TEXTS: Record<string, Record<string, string>> = {
      EN: {
        'nav-home': 'Home',
        'nav-tools': 'Tools',
        'nav-blog': 'Blog',
        'nav-about': 'About',
        'nav-currency': 'Currency:',
        'nav-lang': 'Lang:',
      },
      HI: {
        'nav-home': 'होम',
        'nav-tools': 'कैलकुलेटर',
        'nav-blog': 'ब्लॉग',
        'nav-about': 'परिचय',
        'nav-currency': 'मुद्रा:',
        'nav-lang': 'भाषा:',
      },
    };

    function showToast(message: string) {
      let toast = document.getElementById('cm-global-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'cm-global-toast';
        toast.className = 'fixed bottom-5 right-5 z-[150] bg-surface border border-border text-text-primary px-4 py-2.5 rounded-control text-xs font-medium transition-standard pointer-events-none opacity-0 translate-y-2';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast?.classList.remove('opacity-100', 'translate-y-0');
        toast?.classList.add('opacity-0', 'translate-y-2');
      }, 2200);
    }

    function applyLanguage(lang: string, broadcast = true) {
      if (lang !== 'HI' && lang !== 'EN') lang = 'EN';
      if (langLabel) langLabel.textContent = lang;
      if (mobileLangSelect) mobileLangSelect.value = lang;

      langMenu?.querySelectorAll<HTMLElement>('[data-lang-check]').forEach((el) => {
        const checkLang = el.getAttribute('data-lang-check');
        el.classList.toggle('hidden', checkLang !== lang);
      });

      langMenu?.querySelectorAll<HTMLElement>('[data-lang-val]').forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang-val');
        if (btnLang === lang) {
          btn.classList.add('bg-canvas', 'text-accent', 'font-semibold');
          btn.classList.remove('text-text-primary');
        } else {
          btn.classList.remove('bg-canvas', 'text-accent', 'font-semibold');
          btn.classList.add('text-text-primary');
        }
      });

      try {
        localStorage.setItem('cm_lang', lang);
      } catch (e) {}

      // Update translated UI text
      const texts = I18N_TEXTS[lang];
      if (texts) {
        Object.entries(texts).forEach(([key, val]) => {
          document.querySelectorAll(`[data-i18n="${key}"]`).forEach((el) => {
            el.textContent = val;
          });
        });
      }

      if (broadcast) {
        window.dispatchEvent(new CustomEvent('cm:lang-change', { detail: { lang } }));
        showToast(lang === 'HI' ? 'भाषा: हिन्दी सेट की गई' : 'Language set to English');
      }
    }

    // Restore saved language
    try {
      const savedLang = localStorage.getItem('cm_lang');
      if (savedLang === 'HI' || savedLang === 'EN') {
        applyLanguage(savedLang, false);
      }
    } catch (e) {}

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        langMenu.classList.toggle('hidden');
        langMenu.classList.toggle('flex');
        langBtn.setAttribute('aria-expanded', langMenu.classList.contains('flex') ? 'true' : 'false');
      });

      langMenu.querySelectorAll('[data-lang-val]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-lang-val') || 'EN';
          applyLanguage(lang, true);
          langMenu.classList.add('hidden');
          langMenu.classList.remove('flex');
          langBtn.setAttribute('aria-expanded', 'false');
        });
      });

      document.addEventListener('click', (e) => {
        if (!langMenu.contains(e.target as Node) && !langBtn.contains(e.target as Node)) {
          langMenu.classList.add('hidden');
          langMenu.classList.remove('flex');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    mobileLangSelect?.addEventListener('change', () => {
      applyLanguage(mobileLangSelect.value, true);
    });

    // ── 5. Dark Mode Toggle (Desktop & Mobile Sync) ──────────────────────────
    const themeBtn = document.getElementById('theme-toggle-button');
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
    const iconMoon = document.getElementById('theme-icon-moon');
    const iconSun = document.getElementById('theme-icon-sun');
    const mobileIconMoon = document.getElementById('mobile-theme-icon-moon');
    const mobileIconSun = document.getElementById('mobile-theme-icon-sun');
    const metaTheme = document.getElementById('meta-theme-color');

    function syncThemeUI(isDark: boolean) {
      if (iconMoon) iconMoon.classList.toggle('hidden', isDark);
      if (iconSun) iconSun.classList.toggle('hidden', !isDark);
      if (mobileIconMoon) mobileIconMoon.classList.toggle('hidden', isDark);
      if (mobileIconSun) mobileIconSun.classList.toggle('hidden', !isDark);
      if (metaTheme) metaTheme.setAttribute('content', isDark ? '#0F1211' : '#F7F7F4');
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
      try {
        localStorage.setItem('cm_theme', isDark ? 'dark' : 'light');
      } catch (e) {}
      syncThemeUI(isDark);
    }

    // Sync icons with initial class on <html>
    const isCurrentlyDark = document.documentElement.classList.contains('dark');
    syncThemeUI(isCurrentlyDark);

    if (themeBtn && !themeBtn.dataset.themeBound) {
      themeBtn.dataset.themeBound = 'true';
      themeBtn.addEventListener('click', toggleTheme);
    }
    if (mobileThemeBtn && !mobileThemeBtn.dataset.themeBound) {
      mobileThemeBtn.dataset.themeBound = 'true';
      mobileThemeBtn.addEventListener('click', toggleTheme);
    }

    // ── 6. Mobile Navigation ────────────────────────────────────────────────
    const mobileMenuBtn = document.getElementById('mobile-menu-button');
    const mobileNavPanel = document.getElementById('mobile-nav-panel');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (mobileMenuBtn && mobileNavPanel && iconBars && iconClose && !mobileMenuBtn.dataset.menuBound) {
      mobileMenuBtn.dataset.menuBound = 'true';
      const toggleMobileMenu = (open?: boolean) => {
        const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
        const shouldOpen = typeof open === 'boolean' ? open : !isExpanded;

        mobileMenuBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        if (shouldOpen) {
          mobileNavPanel.classList.remove('hidden');
          mobileNavPanel.classList.add('flex');
          iconBars.classList.add('hidden');
          iconClose.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          mobileNavPanel.classList.add('hidden');
          mobileNavPanel.classList.remove('flex');
          iconBars.classList.remove('hidden');
          iconClose.classList.add('hidden');
          document.body.style.overflow = '';
        }
      };

      mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenuBtn.getAttribute('aria-expanded') === 'true') {
          toggleMobileMenu(false);
          mobileMenuBtn.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (
          mobileMenuBtn.getAttribute('aria-expanded') === 'true' &&
          !mobileNavPanel.contains(e.target as Node) &&
          !mobileMenuBtn.contains(e.target as Node)
        ) {
          toggleMobileMenu(false);
        }
      });
    }

    // ── 7. Mobile Tools Accordion ───────────────────────────────────────────
    const mobileToolsToggle = document.getElementById('mobile-tools-toggle');
    const mobileToolsSubpanel = document.getElementById('mobile-tools-subpanel');
    const mobileToolsChevron = document.getElementById('mobile-tools-chevron');

    if (mobileToolsToggle && mobileToolsSubpanel && mobileToolsChevron && !mobileToolsToggle.dataset.accordionBound) {
      mobileToolsToggle.dataset.accordionBound = 'true';
      mobileToolsToggle.addEventListener('click', () => {
        const isOpen = !mobileToolsSubpanel.classList.contains('hidden');
        if (isOpen) {
          mobileToolsSubpanel.classList.add('hidden');
          mobileToolsSubpanel.classList.remove('flex');
          mobileToolsChevron.classList.remove('rotate-180');
          mobileToolsToggle.setAttribute('aria-expanded', 'false');
        } else {
          mobileToolsSubpanel.classList.remove('hidden');
          mobileToolsSubpanel.classList.add('flex');
          mobileToolsChevron.classList.add('rotate-180');
          mobileToolsToggle.setAttribute('aria-expanded', 'true');
        }
      });
    }
  }

  initHeaderScripts();
  document.addEventListener('astro:page-load', initHeaderScripts);
</script>
