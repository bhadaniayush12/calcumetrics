---
/**
 * WindowFrame.astro — Section 26.2
 * MacBook/Safari-style frame using CSS only.
 * - Container: 1px #D8DDD9, radius 12px, no shadow, no blur
 * - Title bar: 40px, #EEF0EE (light) or #2B302D (dark), three 12px dots
 * - Three dot colours (#FF5F56, #FFBD2E, #27C93F) are the ONLY colours outside the token list
 *   and ONLY inside this component.
 */

interface Props {
  variant?: 'light' | 'dark';
  urlPill?: string;    // e.g. 'calcumetrics.com/sip-calculator'
  class?: string;
}

const { variant = 'light', urlPill, class: cls = '' } = Astro.props;

const isDark = variant === 'dark';
---

<div
  class:list={[
    'rounded-card border border-border overflow-hidden',
    cls,
  ]}
>
  <!-- Title bar -->
  <div
    class:list={[
      'h-10 flex items-center px-3 gap-3 flex-shrink-0',
      isDark ? 'bg-dark-border' : 'bg-disabled-bg',
    ]}
    aria-hidden="true"
  >
    <!-- Three dots (only allowed non-token colours, per Section 26.2) -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <span class="w-3 h-3 rounded-full" style="background: #FF5F56;"></span>
      <span class="w-3 h-3 rounded-full" style="background: #FFBD2E;"></span>
      <span class="w-3 h-3 rounded-full" style="background: #27C93F;"></span>
    </div>

    <!-- Optional URL pill -->
    {urlPill && (
      <div
        class:list={[
          'flex-1 flex justify-center',
        ]}
      >
        <span
          class:list={[
            'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-control border border-border text-[12px] max-w-[240px] truncate',
            isDark ? 'bg-dark-bg text-dark-muted' : 'bg-surface text-text-muted',
          ]}
        >
          <!-- Lock icon -->
          <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="7" width="10" height="7" rx="1.5" />
            <path d="M5 7V5a3 3 0 0 1 6 0v2" />
          </svg>
          <span class="truncate">{urlPill}</span>
        </span>
      </div>
    )}
  </div>

  <!-- Body slot -->
  <div
    class:list={[
      isDark ? 'bg-dark-bg' : 'bg-surface',
    ]}
  >
    <slot />
  </div>
</div>
