---
/**
 * CalculatorLayout.astro — Section 6 master template.
 *
 * Desktop (≥1024px): max-width 1200px, 12-col grid.
 *   Left 7 cols = input card (white, 1px border)
 *   Right 5 cols = dark output panel, position: sticky; top: 24px
 *   IMPORTANT: no ancestor has overflow:hidden (it breaks sticky).
 *
 * Mobile (<1024px): single column inputs.
 *   Output panel replaced by a fixed bottom bar (#171A18, 1px top border #2B302D)
 *   with hero value + "Details" button (≥44px).
 *   "Details" opens a full-height flat bottom sheet.
 *
 * Usage:
 *   <CalculatorLayout ...>
 *     <Fragment slot="inputs"> … </Fragment>
 *     <Fragment slot="outputs"> … </Fragment>
 *     <Fragment slot="below"> … </Fragment>   ← formula, FAQ, related
 *   </CalculatorLayout>
 */

import type { HTMLAttributes } from 'astro/types';
import AdSlot from '../ui/AdSlot.astro';
import IndiaTaxSourceNotice from './IndiaTaxSourceNotice.astro';
import { getCalculatorType } from '../../lib/analytics';

interface Props {
  toolName: string;
  category: string;
  categoryHref: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  /** Pre-rendered hero value for mobile bottom bar (SSR) */
  heroValue: string;
  heroLabel?: string;
  /**
   * Declares the calculator archetype for tooling and future logic.
   * Use values from `CalculatorType` in `src/lib/calculator-types.ts`.
   * Optional — omit for legacy calculators; stamped as `data-calc-type` when set.
   */
  calcType?: string;
}

const {
  toolName,
  category,
  categoryHref,
  breadcrumbs = [],
  heroValue,
  heroLabel = 'Estimated Maturity',
  calcType,
} = Astro.props;

const calculatorType = getCalculatorType(Astro.url.pathname);
---

<!-- Breadcrumb & Inspector Bar: Home › Category › Tool | [Get Info ⌘I] -->
<div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2 flex items-center justify-between gap-3 flex-wrap">
  <nav aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-xs text-text-muted flex-wrap" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="hover:text-accent transition-standard focus-visible:outline-accent" itemprop="item">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>
      <li aria-hidden="true"><span class="text-border">›</span></li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href={categoryHref} class="hover:text-accent transition-standard focus-visible:outline-accent" itemprop="item">
          <span itemprop="name">{category}</span>
        </a>
        <meta itemprop="position" content="2" />
      </li>
      <li aria-hidden="true"><span class="text-border">›</span></li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="text-text-primary font-medium" aria-current="page">
        <span itemprop="name">{toolName}</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </nav>

  <!-- macOS Get Info Inspector Button -->
  <button
    type="button"
    id="get-info-btn"
    aria-label="Get Info (⌘I)"
    title="Get Info (⌘I)"
    class="flex items-center gap-1.5 px-2.5 py-1 rounded-control bg-surface border border-border text-xs text-text-muted hover:text-accent hover:border-accent transition-standard cursor-pointer shadow-mac-subtle select-none"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="16" x2="12" y2="12" />
      <line x1="12" y1="8" x2="12.01" y2="8" />
    </svg>
    <span class="font-medium">Get Info</span>
    <kbd class="text-[10px] text-text-muted font-mono bg-canvas border border-border px-1 py-0.2 rounded hidden sm:inline">⌘I</kbd>
  </button>
</div>

<!-- macOS Get Info Inspector Modal (⌘I) -->
<div
  id="calc-get-info-modal"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[110] hidden items-center justify-center p-4 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Calculator Information Inspector"
>
  <div class="bg-surface border border-border rounded-card shadow-mac max-w-md w-full p-6 animate-in fade-in zoom-in-95 duration-150 relative">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-border pb-3 mb-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center text-sm font-bold">
          ℹ️
        </div>
        <div>
          <p class="text-sm font-bold text-text-primary">{toolName}</p>
          <p class="text-[11px] text-text-muted">Inspector · Mathematical Specifications</p>
        </div>
      </div>
      <button
        type="button"
        id="get-info-close"
        class="text-text-muted hover:text-text-primary p-1 rounded-control transition-standard cursor-pointer"
        aria-label="Close inspector"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Inspector Specifications -->
    <div class="space-y-3.5 text-xs">
      <div class="p-3 bg-canvas border border-border rounded-control space-y-1">
        <span class="text-[10px] font-bold uppercase tracking-wider text-text-muted block">Mathematical Model</span>
        <p class="text-text-primary font-medium leading-relaxed">
          Standardized statutory &amp; financial equations verified with automated unit test fixtures.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-2 text-[11px]">
        <div class="p-2.5 bg-canvas border border-border rounded-control">
          <span class="text-text-muted block text-[10px] uppercase font-bold">Category</span>
          <span class="text-text-primary font-semibold">{category}</span>
        </div>
        <div class="p-2.5 bg-canvas border border-border rounded-control">
          <span class="text-text-muted block text-[10px] uppercase font-bold">Rates Verified</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-semibold">Sep 2026 (Quarterly)</span>
        </div>
        <div class="p-2.5 bg-canvas border border-border rounded-control">
          <span class="text-text-muted block text-[10px] uppercase font-bold">Execution</span>
          <span class="text-text-primary font-semibold">100% Client-Side</span>
        </div>
        <div class="p-2.5 bg-canvas border border-border rounded-control">
          <span class="text-text-muted block text-[10px] uppercase font-bold">Privacy</span>
          <span class="text-accent font-semibold">0 Server Storage</span>
        </div>
      </div>

      <div class="text-[11px] text-text-muted leading-relaxed">
        Inputs are reactive and recalculated continuously in your browser memory without network latency or data transmission.
      </div>

      <div class="pt-2 border-t border-border flex items-center justify-between">
        <a href="/methodology" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
          <span>How is this calculated? Read Methodology &amp; Proofs</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-border flex justify-end">
      <button
        type="button"
        id="get-info-dismiss"
        class="px-3.5 py-1.5 rounded-control text-xs font-semibold bg-accent text-white hover:opacity-90 transition-standard cursor-pointer"
      >
        Done (ESC)
      </button>
    </div>
  </div>
</div>

<!-- Main calculator split (no overflow:hidden on ancestors) -->
<div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-8" data-calc-type={calcType} data-calculator-type={calculatorType}>

  <!-- Desktop: 12-col grid split -->
  <div class="lg:grid lg:grid-cols-12 lg:gap-6">

    <!-- Left: Input card (7 cols) -->
    <div class="lg:col-span-7">
      <div class="bg-surface border border-border rounded-card p-6">
        <slot name="inputs" />
      </div>
    </div>

    <!-- Right: Dark output panel (5 cols), sticky on desktop, becomes full-screen sheet on mobile when opened -->
    <div class="lg:col-span-5 lg:self-stretch">
      <div
        id="calc-bottom-sheet"
        class="bg-dark-bg lg:border lg:border-dark-border lg:rounded-card lg:p-6 lg:sticky lg:top-6"
        aria-label="Calculation results"
      >
        <!-- Mobile sheet header (hidden on desktop) -->
        <div class="lg:hidden flex items-center justify-between px-4 pt-4 pb-3 border-b border-dark-border flex-shrink-0">
          <h2 class="text-base font-semibold text-dark-text">Results</h2>
          <button
            type="button"
            id="calc-sheet-close"
            aria-label="Close results panel"
            class="w-11 h-11 flex items-center justify-center rounded-control text-dark-muted hover:text-dark-text transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2 cursor-pointer"
          >
            <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <!-- Sheet body (scrollable on mobile, natural on desktop) -->
        <div class="p-4 lg:p-0 flex-1 overflow-y-auto lg:overflow-visible">
          <slot name="outputs">
            <!-- Generic layout-owned result presentation (Option A fallback) -->
            <div id="calc-generic-outputs" class="space-y-5">
              <div>
                <span id="calc-desktop-hero-label" class="text-xs font-medium uppercase tracking-wider text-dark-muted block mb-1">
                  {heroLabel}
                </span>
                <div
                  id="calc-desktop-hero"
                  class="text-[40px] leading-none font-semibold tabular-nums text-dark-text"
                  aria-live="polite"
                  aria-atomic="true"
                >
                  {heroValue}
                </div>
              </div>
              <div id="calc-generic-metrics" class="space-y-0 border-t border-dark-border pt-4 empty:hidden"></div>
            </div>
          </slot>
        </div>
      </div>
    </div>
  </div>

  <!-- Below the fold: formula, example, FAQ, related (full width) -->
  <div class="mt-10 space-y-10">
    <slot name="below" />
    <IndiaTaxSourceNotice />
  </div>

  <!-- Reserved ad slot (§9 & §21): ≥24px below content, ≥24px from any button.
       Desktop leaderboard 90px min-height. Renders live ad only when ADS_ENABLED=true.
       Per AdSense policy: NO ads on homepage, 404, legal pages, Contact, About. -->
  <div class="mt-10 pt-6 border-t border-border">
    <AdSlot format="leaderboard" />
  </div>
</div>

<!-- Mobile: Fixed bottom bar (hidden on desktop) -->
<div
  id="calc-mobile-bar"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-dark-bg border-t border-dark-border flex items-center justify-between px-4 py-2 gap-3"
  style="padding-bottom: max(env(safe-area-inset-bottom), 8px);"
  aria-label="Calculator result"
>
  <div class="py-1 min-w-0 flex-1">
    <p id="calc-mobile-hero-label" class="text-[11px] text-dark-muted font-medium leading-none mb-1 truncate">{heroLabel}</p>
    <p
      id="calc-mobile-hero"
      class="text-xl sm:text-2xl font-bold text-dark-text tabular-nums truncate tracking-tight"
      aria-live="polite"
    >
      {heroValue}
    </p>
  </div>
  <button
    type="button"
    id="calc-details-btn"
    aria-haspopup="dialog"
    aria-controls="calc-bottom-sheet"
    aria-expanded="false"
    class="flex-shrink-0 min-h-[44px] h-11 px-4 rounded-control border border-dark-border text-sm font-semibold text-dark-text hover:bg-dark-border transition-standard focus-visible:outline-2 focus-visible:outline-dark-accent focus-visible:outline-offset-2 cursor-pointer inline-flex items-center justify-center gap-1.5"
  >
    <span>Details</span>
    <svg class="w-3.5 h-3.5 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15" />
    </svg>
  </button>
</div>

<!-- Reserve bottom padding so fixed bar doesn't cover content -->
<div class="lg:hidden h-20" aria-hidden="true"></div>

<style>
  /* Mobile bottom sheet state (<1024px) */
  @media (max-width: 1023px) {
    #calc-bottom-sheet {
      display: none;
    }
    #calc-bottom-sheet[data-open="true"] {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0;
      z-index: 50;
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
</style>

<script>
  import {
    isJurisdictionLocked,
    getJurisdictionCurrency,
    getCurrencyConfig,
    normalizeCurrency,
  } from '../../lib/currency';
  import { animateValue } from '../../lib/animate-number';
  import { trackCalculatorCompletion, getCalculatorType } from '../../lib/analytics';

  /**
   * Phase 4.2 — Canonical result store bootstrapped on window.__cmResultStore.
   *
   * Single Source of Truth Architecture:
   *
   *   recalc()
   *       ↓
   *   ONE canonical result state (_store._state)
   *       ↓
   *   desktop presentation (layout-owned hero / render adapter / fields)
   *   mobile presentation (#calc-mobile-hero)
   *
   * API:
   *   window.__cmResultStore.setResult({ heroValue, heroLabel?, rows?, fields?, meta? })
   *   window.__cmResultStore.getResult()              → CalcResult | null
   *   window.__cmResultStore.subscribeResult(fn)      → unsubscribe()
   *   window.__cmResultStore.registerRenderAdapter(fn)→ unsubscribe()
   *   window.__cmResultStore.resetResult()
   *
   * Legacy bridge:
   *   window.dispatchEvent(new CustomEvent('cm:result', { detail: { heroValue } }))
   *   is intercepted and routed through setResult() automatically.
   */
  type ResultRow = {
    label: string;
    value: string;
    subValue?: string;
    variant?: 'primary' | 'secondary' | 'accent' | 'muted';
  };

  type CalcResult = {
    heroValue: string;
    heroLabel?: string;
    rows?: ResultRow[];
    fields?: Record<string, string>;
    meta?: Record<string, unknown>;
  };

  type ResultHandler = (r: CalcResult) => void;

  interface CmResultStore {
    _state: CalcResult | null;
    _subs: Set<ResultHandler>;
    setResult(r: CalcResult): void;
    getResult(): CalcResult | null;
    subscribeResult(fn: ResultHandler): () => void;
    registerRenderAdapter(fn: ResultHandler): () => void;
    resetResult(): void;
  }

  // Augment window type locally for this script
  const _win = window as unknown as {
    __cmResultStore?: CmResultStore;
    __calcShellGlobalBound?: boolean;
  };

  // Bootstrap store once — persists across astro:page-load re-inits
  if (!_win.__cmResultStore) {
    _win.__cmResultStore = {
      _state: null,
      _subs: new Set<ResultHandler>(),
      setResult(r: CalcResult) {
        this._state = r;
        this._subs.forEach((fn) => { try { fn(r); } catch {} });
      },
      getResult() { return this._state; },
      subscribeResult(fn: ResultHandler) {
        this._subs.add(fn);
        return () => this._subs.delete(fn);
      },
      registerRenderAdapter(fn: ResultHandler) {
        const unsub = this.subscribeResult(fn);
        if (this._state) {
          try { fn(this._state); } catch {}
        }
        return unsub;
      },
      resetResult() { this._state = null; },
    };
  }
  const _store = _win.__cmResultStore;

  // ──────────────────────────────────────────────────────────────────────────

  function initCalculatorShell() {
    const detailsBtn = document.getElementById('calc-details-btn');
    const sheet = document.getElementById('calc-bottom-sheet');
    const closeBtn = document.getElementById('calc-sheet-close');

    // Ensure body scroll is unlocked on page load or client transition
    document.body.style.overflow = '';

    if (!detailsBtn || !sheet || !closeBtn) return;
    if (detailsBtn.dataset.shellBound === 'true') return;
    detailsBtn.dataset.shellBound = 'true';

    const openSheet = () => {
      sheet.dataset.open = 'true';
      sheet.setAttribute('role', 'dialog');
      sheet.setAttribute('aria-modal', 'true');
      detailsBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const closeSheet = () => {
      sheet.dataset.open = 'false';
      sheet.removeAttribute('role');
      sheet.removeAttribute('aria-modal');
      detailsBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      detailsBtn.focus();
    };

    detailsBtn.addEventListener('click', openSheet);
    closeBtn.addEventListener('click', closeSheet);

    // Focus trap within sheet
    sheet.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = Array.from(
        sheet.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.hasAttribute('disabled'));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Helper to render/update DOM from canonical result state with smooth count-up animation
    const applyCanonicalResult = (result: CalcResult) => {
      // Expose animateValue globally for page scripts
      (window as any).__cmAnimateNumber = animateValue;

      // 1. Mobile presentation
      const mobileHero = document.getElementById('calc-mobile-hero');
      if (mobileHero) animateValue(mobileHero, result.heroValue);
      const mobileLabel = document.getElementById('calc-mobile-hero-label');
      if (mobileLabel && result.heroLabel) mobileLabel.textContent = result.heroLabel;

      // 2. Desktop presentation (where layout owns generic presentation)
      const desktopHero = document.getElementById('calc-desktop-hero');
      if (desktopHero) animateValue(desktopHero, result.heroValue);
      const desktopLabel = document.getElementById('calc-desktop-hero-label');
      if (desktopLabel && result.heroLabel) desktopLabel.textContent = result.heroLabel;

      // Generic metrics/rows rendering (if generic container exists)
      const metricsContainer = document.getElementById('calc-generic-metrics');
      if (metricsContainer && result.rows) {
        metricsContainer.innerHTML = '';
        result.rows.forEach((row) => {
          const rowDiv = document.createElement('div');
          rowDiv.className = 'flex items-center justify-between py-2.5 border-b border-dark-border last:border-b-0';
          const labelSpan = document.createElement('span');
          labelSpan.className = 'text-xs text-dark-muted';
          labelSpan.textContent = row.label;
          const valueSpan = document.createElement('span');
          const colorClass = row.variant === 'accent' ? 'text-dark-accent font-semibold' : 'text-dark-text font-medium';
          valueSpan.className = `text-sm tabular-nums ${colorClass}`;
          valueSpan.textContent = row.value;
          rowDiv.appendChild(labelSpan);
          rowDiv.appendChild(valueSpan);
          metricsContainer.appendChild(rowDiv);
        });
      }

      // 3. Declarative field updates (render adapter pattern)
      if (result.fields) {
        for (const [id, val] of Object.entries(result.fields)) {
          const el = document.getElementById(id);
          if (el) el.textContent = val;
        }
      }

      // 4. Declarative data-attribute bindings: [data-cm-result]
      document.querySelectorAll<HTMLElement>('[data-cm-result]').forEach((el) => {
        const key = el.dataset.cmResult;
        if (key === 'heroValue') el.textContent = result.heroValue;
        else if (key === 'heroLabel' && result.heroLabel) el.textContent = result.heroLabel;
        else if (key && result.fields && key in result.fields) el.textContent = result.fields[key];
      });
    };

    // ── GA4 Calculator Completion Tracking (Consent Mode v2 Compliant) ─────
    const rootCalcEl = document.querySelector<HTMLElement>('[data-calculator-type]');
    const resolvedCalcType = rootCalcEl?.dataset.calculatorType || getCalculatorType(window.location.pathname);

    let userHasInteracted = false;
    let completionDebounceTimer: ReturnType<typeof setTimeout> | null = null;

    const fireCompletionEvent = () => {
      if (completionDebounceTimer) {
        clearTimeout(completionDebounceTimer);
        completionDebounceTimer = null;
      }
      trackCalculatorCompletion(resolvedCalcType);
    };

    // 1. Explicit calculate button click (immediate completion event)
    const calculateBtn = document.querySelector<HTMLButtonElement>('button[id$="-calculate"]');
    if (calculateBtn && calculateBtn.dataset.analyticsBound !== 'true') {
      calculateBtn.dataset.analyticsBound = 'true';
      calculateBtn.addEventListener('click', () => {
        userHasInteracted = true;
        fireCompletionEvent();
      });
    }

    // 2. Track user input interactions (inputs, sliders, preset chips, selects)
    const inputsArea = rootCalcEl?.querySelector('.lg\\:col-span-7') || rootCalcEl;
    if (inputsArea && (inputsArea as HTMLElement).dataset.analyticsInteractionsBound !== 'true') {
      (inputsArea as HTMLElement).dataset.analyticsInteractionsBound = 'true';
      const markInteracted = () => {
        userHasInteracted = true;
      };
      inputsArea.addEventListener('input', markInteracted, { passive: true });
      inputsArea.addEventListener('change', markInteracted, { passive: true });
      inputsArea.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && (target.closest('button, [data-chip], [data-chip-monthly], [data-chip-principal], [data-chip-rate], [data-chip-years], [data-chip-gross]') || target.tagName === 'INPUT' || target.tagName === 'SELECT')) {
          markInteracted();
        }
      }, { passive: true });
    }

    // 3. Reset button handling (resets interaction flag to avoid firing on reset)
    const resetBtn = document.querySelector<HTMLButtonElement>('button[id$="-reset"]');
    if (resetBtn && resetBtn.dataset.analyticsResetBound !== 'true') {
      resetBtn.dataset.analyticsResetBound = 'true';
      resetBtn.addEventListener('click', () => {
        userHasInteracted = false;
        if (completionDebounceTimer) {
          clearTimeout(completionDebounceTimer);
          completionDebounceTimer = null;
        }
      });
    }

    // 4. Trigger on completed calculation result after user interaction
    if ((detailsBtn as any)._analyticsUnsub) {
      (detailsBtn as any)._analyticsUnsub();
    }
    (detailsBtn as any)._analyticsUnsub = _store.subscribeResult(() => {
      if (!userHasInteracted) return;
      if (completionDebounceTimer) clearTimeout(completionDebounceTimer);
      completionDebounceTimer = setTimeout(() => {
        fireCompletionEvent();
      }, 750);
    });

    // Global listeners — registered only once across app lifetime
    if (!_win.__calcShellGlobalBound) {
      _win.__calcShellGlobalBound = true;

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const currentSheet = document.getElementById('calc-bottom-sheet');
          if (currentSheet && currentSheet.dataset.open === 'true') {
            const currentDetailsBtn = document.getElementById('calc-details-btn');
            currentSheet.dataset.open = 'false';
            currentSheet.removeAttribute('role');
            currentSheet.removeAttribute('aria-modal');
            currentDetailsBtn?.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            currentDetailsBtn?.focus();
          }
        }
      });

      // Generic currency prefix updater — registered only once (bypassed for region-locked tools)
      window.addEventListener('cm:currency-change', (e: any) => {
        if (isJurisdictionLocked(window.location.pathname)) return;
        if (e.detail?.symbol) {
          document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
            el.textContent = e.detail.symbol;
          });
        }
      });

      // ── Phase 4.2 Canonical Result Architecture ──────────────────────────
      //
      // 1. Legacy bridge: existing calcs dispatch raw cm:result CustomEvent.
      //    Feed into canonical store → triggers all subscribers.
      window.addEventListener('cm:result', (e: any) => {
        if (e.detail?.heroValue) {
          _store.setResult(e.detail);
        }
      });

      // 2. Canonical result subscriber: drives both desktop and mobile presentations.
      _store.subscribeResult(applyCanonicalResult);

      // 3. Catch-up: apply any result already in store before this guard ran.
      const existing = _store.getResult();
      if (existing) {
        applyCanonicalResult(existing);
      }
    } else {
      // On repeated page visits (e.g. astro:page-load), sync freshly rendered DOM
      // with the current store state if one exists.
      const existing = _store.getResult();
      if (existing) {
        applyCanonicalResult(existing);
      }
    }

    // ── Get Info Inspector Panel (⌘I) ──────────────────────────────────
    const getInfoBtn = document.getElementById('get-info-btn');
    const getInfoModal = document.getElementById('calc-get-info-modal');
    const getInfoClose = document.getElementById('get-info-close');
    const getInfoDismiss = document.getElementById('get-info-dismiss');

    function toggleGetInfo(force?: boolean) {
      if (!getInfoModal) return;
      const isOpen = !getInfoModal.classList.contains('hidden');
      const shouldOpen = typeof force === 'boolean' ? force : !isOpen;

      if (shouldOpen) {
        getInfoModal.classList.remove('hidden');
        getInfoModal.classList.add('flex');
      } else {
        getInfoModal.classList.add('hidden');
        getInfoModal.classList.remove('flex');
      }
    }

    getInfoBtn?.addEventListener('click', () => toggleGetInfo(true));
    getInfoClose?.addEventListener('click', () => toggleGetInfo(false));
    getInfoDismiss?.addEventListener('click', () => toggleGetInfo(false));

    getInfoModal?.addEventListener('click', (e) => {
      if (e.target === getInfoModal) toggleGetInfo(false);
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'i') {
        e.preventDefault();
        toggleGetInfo();
      } else if (e.key === 'Escape' && getInfoModal && !getInfoModal.classList.contains('hidden')) {
        toggleGetInfo(false);
      }
    });

    // ── Auto-track Recently Used Tools ────────────────────────────────
    try {
      const pageTitle = document.title.split(':')[0].split('|')[0].trim();
      const currentPath = window.location.pathname;
      if (currentPath && currentPath !== '/' && !currentPath.startsWith('/blog') && !currentPath.startsWith('/about')) {
        const raw = localStorage.getItem('cm_recent_tools');
        let recents: Array<{ name: string; path: string }> = raw ? JSON.parse(raw) : [];
        recents = recents.filter((t) => t.path !== currentPath);
        recents.unshift({ name: pageTitle, path: currentPath });
        localStorage.setItem('cm_recent_tools', JSON.stringify(recents.slice(0, 6)));
      }
    } catch (e) {}
  }

  // Sync currency prefix from localStorage or jurisdiction lock on current page DOM
  function syncCurrencyFromStorage() {
    const lockedCode = getJurisdictionCurrency(window.location.pathname);
    if (lockedCode) {
      const config = getCurrencyConfig(lockedCode);
      document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
        el.textContent = config.symbol;
      });
      return;
    }

    try {
      const saved = localStorage.getItem('cm_currency');
      const normalized = normalizeCurrency(saved);
      const config = getCurrencyConfig(normalized);
      document.querySelectorAll('[data-currency-prefix]').forEach((el) => {
        el.textContent = config.symbol;
      });
    } catch (e) {}
  }

  initCalculatorShell();
  syncCurrencyFromStorage();

  document.addEventListener('astro:page-load', () => {
    initCalculatorShell();
    syncCurrencyFromStorage();
  });

  // Reset canonical store on View Transitions navigation — prevents stale state
  // from a previous calculator page bleeding into the next page's hero value.
  document.addEventListener('astro:before-preparation', () => _store.resetResult());
</script>
