---
/**
 * IndiaTaxSourceNotice.astro — Section 12 & 13 authoritative tax source disclosure.
 *
 * Sourced dynamically from versioned tax-data metadata in src/data/tax/india/.
 * Keeping this in the shared CalculatorLayout shell allows the Phase 5 Income Tax
 * page and engine to remain byte-for-byte untouched (Constraint C3 & C6).
 */
import { resolveTaxRecordForRoute } from '../../lib/tax/schema';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const record = resolveTaxRecordForRoute(pathname);

const periodLabel = record
  ? record.assessmentYear
    ? `${record.financialYear ? record.financialYear + ' (' + record.assessmentYear + ')' : record.assessmentYear}`
    : record.taxYear
    ? record.taxYear
    : record.financialYear
    ? record.financialYear
    : `In force since ${record.effectiveFrom}`
  : '';
---

{record && (
  <section
    id="tax-source-verification"
    aria-labelledby="tax-source-verification-heading"
    class="border border-border rounded-card bg-surface p-5 space-y-3"
  >
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <h2 id="tax-source-verification-heading" class="text-base font-bold text-text-primary">
        Tax source & regulatory provenance
      </h2>
      <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-muted text-text-muted border border-border">
        Verified {record.verifiedOn}
      </span>
    </div>

    <dl class="space-y-1.5 text-sm text-text-muted leading-relaxed">
      <div>
        <dt class="font-semibold text-text-primary inline">Authoritative source: </dt>
        <dd class="inline">
          <a
            href={record.sourceUrl}
            class="text-accent underline underline-offset-2 hover:text-accent-hover"
            rel="noopener noreferrer"
            target="_blank"
          >
            {record.sourceTitle}
          </a>
          <span class="text-xs text-text-muted"> ({record.source})</span>
        </dd>
      </div>

      <div>
        <dt class="font-semibold text-text-primary inline">Governing framework: </dt>
        <dd class="inline">{record.governingFramework}</dd>
      </div>

      <div>
        <dt class="font-semibold text-text-primary inline">Applicable period: </dt>
        <dd class="inline">{periodLabel}</dd>
      </div>
    </dl>

    <div class="pt-2 border-t border-border/60 text-xs text-text-muted space-y-1">
      <p class="font-medium text-text-primary">
        This calculator uses the rules/data published by {record.source} for {periodLabel}. Estimated result based on the inputs and assumptions provided.
      </p>
      {record.notes && (
        <p class="leading-relaxed">
          {record.notes}
        </p>
      )}
    </div>
  </section>
)}
